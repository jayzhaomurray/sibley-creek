---
/*
 * Lane N - Periodic Table.
 * The family-color legend. Sits to the right of the title block at the top
 * of the page, in the manner of a chemistry-textbook key. Each row: a small
 * colored square + family name + a tiny serif gloss describing what the
 * family contains.
 */

export interface FamilyEntry {
  name: string;
  color: string;
  gloss: string;
  /** Number of elements in this family — printed as a small Roman. */
  count: number;
}

interface Props {
  families: FamilyEntry[];
}

const { families } = Astro.props as Props;
---
<aside class="pt-legend" aria-label="Family color legend">
  <header class="pt-legend__head">
    <p class="pt-legend__kicker">Family key</p>
    <h2 class="pt-legend__title"><em>The seven families</em></h2>
  </header>
  <ul class="pt-legend__list" role="list">
    {families.map((f) => (
      <li class="pt-legend__row">
        <span
          class="pt-legend__swatch"
          style={`background:${f.color}`}
          aria-hidden="true"
        ></span>
        <span class="pt-legend__name">{f.name}</span>
        <span class="pt-legend__count" aria-hidden="true">n={f.count}</span>
        <span class="pt-legend__gloss"><em>{f.gloss}</em></span>
      </li>
    ))}
  </ul>
</aside>

<style>
  .pt-legend {
    border: 1px solid var(--pt-ink, #171717);
    background: var(--pt-paper-bright, #FCFAF3);
    padding: 14px 16px 16px 16px;
    position: relative;
  }
  .pt-legend::before {
    content: "";
    position: absolute;
    top: -1px;
    left: -1px;
    right: -1px;
    height: 4px;
    background: var(--pt-ink, #171717);
  }

  .pt-legend__head {
    margin: 0 0 10px 0;
    border-bottom: 1px solid var(--pt-rule, #C9C2B0);
    padding-bottom: 8px;
  }
  .pt-legend__kicker {
    margin: 0 0 2px 0;
    font-family: var(--pt-mono, "IBM Plex Sans Condensed"), sans-serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--pt-ink-faint, #6B6B6B);
  }
  .pt-legend__title {
    margin: 0;
    font-family: var(--pt-serif-display, "Cormorant Garamond"), serif;
    font-style: italic;
    font-weight: 500;
    font-size: 22px;
    line-height: 1.1;
    color: var(--pt-ink, #171717);
  }
  .pt-legend__title em {
    font-style: italic;
  }

  .pt-legend__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 5px;
  }

  .pt-legend__row {
    display: grid;
    grid-template-columns: 14px auto auto 1fr;
    align-items: baseline;
    gap: 8px;
    font-family: var(--pt-serif-body, "Source Serif 4"), serif;
    font-size: 12.5px;
    line-height: 1.35;
    color: var(--pt-ink, #171717);
  }
  .pt-legend__swatch {
    display: inline-block;
    width: 12px;
    height: 12px;
    border: 1px solid var(--pt-ink, #171717);
    align-self: center;
  }
  .pt-legend__name {
    font-family: var(--pt-mono, "IBM Plex Sans Condensed"), sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--pt-ink, #171717);
  }
  .pt-legend__count {
    font-family: var(--pt-mono, "IBM Plex Sans Condensed"), sans-serif;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--pt-ink-faint, #6B6B6B);
    font-variant-numeric: tabular-nums;
  }
  .pt-legend__gloss {
    font-size: 11.5px;
    color: var(--pt-ink-faint, #555555);
    line-height: 1.3;
  }
  .pt-legend__gloss em {
    font-style: italic;
  }
</style>
