---
/*
 * Lane R - Status Page: micro-sparkline for status rows.
 *
 * Single-color, low-chrome polyline. Renders into a fixed 120x28 box so all
 * rows line up perfectly (the page reads like a service dashboard, every row
 * must terminate at the same x-position).
 *
 * Self-contained; no external chart code. Stroke color is the parent's
 * `currentColor` so the row can tint the line to match its operational
 * state (green / amber / red / blue).
 */

interface Props {
  values: number[];
  width?: number;
  height?: number;
  label?: string;
}

const { values, width = 120, height = 28, label = "trend" } = Astro.props;

const w = width;
const h = height;
const pad = 2;

let pathD = "";
let lastDot = { x: w - pad, y: h / 2 };

if (values.length >= 2) {
  const min = Math.min(...values);
  const max = Math.max(...values);
  const range = max - min || 1;
  const step = (w - pad * 2) / (values.length - 1);
  const points = values.map((v, i) => {
    const x = pad + i * step;
    const y = pad + (1 - (v - min) / range) * (h - pad * 2);
    return { x, y };
  });
  pathD = points
    .map((p, i) => `${i === 0 ? "M" : "L"}${p.x.toFixed(2)},${p.y.toFixed(2)}`)
    .join(" ");
  lastDot = points[points.length - 1];
}
---
<svg
  class="st-spark"
  viewBox={`0 0 ${w} ${h}`}
  width={w}
  height={h}
  role="img"
  aria-label={label}
  preserveAspectRatio="none"
>
  <path
    d={pathD}
    fill="none"
    stroke="currentColor"
    stroke-width="1.4"
    stroke-linecap="round"
    stroke-linejoin="round"
    vector-effect="non-scaling-stroke"
  />
  <circle
    cx={lastDot.x}
    cy={lastDot.y}
    r="1.8"
    fill="currentColor"
  />
</svg>

<style>
  .st-spark {
    display: block;
    overflow: visible;
  }
</style>
