---
/*
 * LogStrip - bottom ATC log: recent events ticker (static, scannable).
 *
 * Not a marquee. A scrollable strip of timestamped contact logs. Each
 * entry: zulu timestamp + call-sign + verb + delta. Imitates an ATC tape
 * of recent contacts/events.
 */

interface LogEntry {
  zulu: string;
  callsign: string;
  verb: string;
  body: string;
  state: "pos" | "neg" | "neutral" | "alert";
}

interface Props {
  entries: LogEntry[];
}

const { entries } = Astro.props;
---

<section class="rd-log" aria-labelledby="rd-log-title">
  <div class="rd-log__head">
    <p class="rd-log__kicker">CONTACT LOG</p>
    <h2 id="rd-log-title" class="rd-log__title">RECENT TRANSMISSIONS</h2>
    <span class="rd-log__count">{entries.length} ENTRIES</span>
  </div>
  <ol class="rd-log__list" role="list">
    {entries.map((e) => (
      <li class={`rd-log__row rd-log__row--${e.state}`}>
        <span class="rd-log__zulu">{e.zulu}</span>
        <span class="rd-log__callsign">{e.callsign}</span>
        <span class="rd-log__verb">{e.verb}</span>
        <span class="rd-log__body">{e.body}</span>
      </li>
    ))}
  </ol>
</section>

<style>
  .rd-log {
    border-top: 1px solid var(--rd-rule);
    border-bottom: 1px solid var(--rd-rule);
    background:
      linear-gradient(180deg, rgba(11, 16, 13, 0.7), rgba(11, 16, 13, 0.4));
    padding: 12px 16px;
  }
  .rd-log__head {
    display: flex;
    align-items: baseline;
    gap: 14px;
    flex-wrap: wrap;
    padding-bottom: 8px;
    margin-bottom: 10px;
    border-bottom: 1px dashed var(--rd-rule);
  }
  .rd-log__kicker {
    margin: 0;
    font-family: var(--rd-font-mono);
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--rd-green-dim);
  }
  .rd-log__title {
    margin: 0;
    font-family: var(--rd-font-mono);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--rd-green);
  }
  .rd-log__count {
    margin-left: auto;
    font-family: var(--rd-font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--rd-ink-muted);
  }
  .rd-log__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .rd-log__row {
    display: grid;
    grid-template-columns: 84px 70px 78px 1fr;
    gap: 10px;
    align-items: baseline;
    font-family: var(--rd-font-mono);
    font-size: 12.5px;
    line-height: 1.45;
    padding: 3px 0;
    border-bottom: 1px dotted rgba(59, 210, 90, 0.08);
  }
  .rd-log__row:last-child {
    border-bottom: none;
  }
  .rd-log__zulu {
    color: var(--rd-ink-muted);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
  }
  .rd-log__callsign {
    color: var(--rd-green);
    font-weight: 600;
    letter-spacing: 0.08em;
  }
  .rd-log__verb {
    text-transform: uppercase;
    font-weight: 600;
    letter-spacing: 0.1em;
    font-size: 11.5px;
  }
  .rd-log__body {
    color: var(--rd-ink);
  }
  .rd-log__row--pos .rd-log__verb { color: var(--rd-green); }
  .rd-log__row--neg .rd-log__verb { color: var(--rd-red); }
  .rd-log__row--neutral .rd-log__verb { color: var(--rd-cyan); }
  .rd-log__row--alert .rd-log__verb { color: var(--rd-red); }

  @media (max-width: 720px) {
    .rd-log__row {
      grid-template-columns: 72px 64px 1fr;
    }
    .rd-log__row .rd-log__verb {
      grid-column: 2;
    }
    .rd-log__row .rd-log__body {
      grid-column: 1 / -1;
      padding-left: 84px;
      color: var(--rd-ink-muted);
    }
  }
</style>
