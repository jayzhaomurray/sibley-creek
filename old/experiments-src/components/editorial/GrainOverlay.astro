---
/*
 * GrainOverlay - SVG fractal-noise paper-grain texture for the editorial
 * splash. Pure decoration, aria-hidden, fixed-position, pointer-events:none.
 * Self-contained: this component is owned by the editorial splash only.
 */
---
<div class="ed-grain" aria-hidden="true">
  <svg width="100%" height="100%" preserveAspectRatio="none">
    <filter id="ed-grain-filter">
      <feTurbulence
        type="fractalNoise"
        baseFrequency="0.85"
        numOctaves="2"
        stitchTiles="stitch"
      />
      <feColorMatrix
        type="matrix"
        values="0 0 0 0 0.36
                0 0 0 0 0.06
                0 0 0 0 0.08
                0 0 0 0.55 0"
      />
    </filter>
    <rect width="100%" height="100%" filter="url(#ed-grain-filter)" />
  </svg>
</div>

<style>
  .ed-grain {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    mix-blend-mode: multiply;
    opacity: 0.18;
  }
  .ed-grain svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  @media (prefers-reduced-motion: reduce) {
    .ed-grain { opacity: 0.12; }
  }
</style>
