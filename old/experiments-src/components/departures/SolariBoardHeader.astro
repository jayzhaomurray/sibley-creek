---
/*
 * Lane J - Solari Departures Board.
 *
 * Board header strip. Sits above the rows and labels the columns:
 *
 *   CODE / SECTION / INDICATOR / VALUE / DELTA / AS OF / NEXT
 *
 * Uses the same grid as SolariRow.astro so columns align. Treated as a
 * "row label" - small caps, muted amber.
 *
 * Props:
 *   columns - column labels in order. Optional override (defaults to the
 *             canonical 7-column board).
 */

interface Props {
  columns?: [string, string, string, string, string, string, string];
}

const {
  columns = ["CODE", "SECTION", "INDICATOR", "VALUE", "DELTA", "AS OF", "NEXT"],
} = Astro.props;
---
<div class="sol-bh" role="row" aria-label="Departures board column legend">
  <span class="sol-bh__cell sol-bh__cell--code" role="columnheader">{columns[0]}</span>
  <span class="sol-bh__cell sol-bh__cell--section" role="columnheader">{columns[1]}</span>
  <span class="sol-bh__cell sol-bh__cell--indicator" role="columnheader">{columns[2]}</span>
  <span class="sol-bh__cell sol-bh__cell--value" role="columnheader">{columns[3]}</span>
  <span class="sol-bh__cell sol-bh__cell--delta" role="columnheader">{columns[4]}</span>
  <span class="sol-bh__cell sol-bh__cell--asof" role="columnheader">{columns[5]}</span>
  <span class="sol-bh__cell sol-bh__cell--next" role="columnheader">{columns[6]}</span>
</div>

<style>
  .sol-bh {
    display: grid;
    grid-template-columns:
      72px            /* CODE */
      150px           /* SECTION */
      minmax(0, 1fr)  /* INDICATOR */
      120px           /* VALUE */
      120px           /* DELTA */
      120px           /* AS OF */
      minmax(120px, 220px); /* NEXT */
    column-gap: clamp(10px, 1.6vw, 20px);
    align-items: baseline;
    padding: 12px clamp(16px, 3vw, 32px);
    border-top: 1px solid var(--sol-frame);
    border-bottom: 1px solid var(--sol-frame);
    background: linear-gradient(
      180deg,
      rgba(31, 31, 35, 0.55) 0%,
      rgba(14, 14, 16, 0.55) 100%
    );
    font-family: var(--sol-mono);
    font-size: 10px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--sol-amber-faded);
  }

  .sol-bh__cell--value,
  .sol-bh__cell--delta,
  .sol-bh__cell--asof,
  .sol-bh__cell--next {
    text-align: right;
  }

  @media (max-width: 980px) {
    .sol-bh {
      grid-template-columns:
        56px
        120px
        minmax(0, 1fr)
        100px
        100px;
      column-gap: 12px;
    }
    .sol-bh__cell--asof,
    .sol-bh__cell--next { display: none; }
  }

  @media (max-width: 640px) {
    .sol-bh {
      grid-template-columns: 56px minmax(0,1fr) 90px;
      column-gap: 10px;
    }
    .sol-bh__cell--section,
    .sol-bh__cell--delta { display: none; }
  }
</style>
