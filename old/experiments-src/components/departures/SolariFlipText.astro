---
/*
 * Lane J - Solari Departures Board.
 *
 * Split-flap "flip" text. Each character is rendered in its own span so a
 * staggered CSS animation can rotate them in on page load, in the manner
 * of a mechanical Solari di Udine departures board. The animation uses a
 * 3D rotateX on a perspective parent; characters with `data-flap="false"`
 * (e.g. whitespace) are exempt and render immediately.
 *
 * Honors prefers-reduced-motion - characters appear without rotation.
 *
 * Props:
 *   text     - the string to render. Required.
 *   tone     - "active" (amber), "muted" (faded amber), "pos" (green),
 *              "neg" (red). Default "active".
 *   weight   - "regular" or "bold". Default "regular".
 *   ariaHidden - if true the whole element is aria-hidden. The visible
 *                text is also exposed plainly as an attribute on the
 *                wrapper so screen readers using the visible text are
 *                served the full string in one piece.
 *   delay    - optional starting delay (ms) for the flip stagger.
 *   stagger  - per-character stagger (ms). Default 30ms.
 */

interface Props {
  text: string;
  tone?: "active" | "muted" | "pos" | "neg";
  weight?: "regular" | "bold";
  ariaHidden?: boolean;
  delay?: number;
  stagger?: number;
}

const {
  text,
  tone = "active",
  weight = "regular",
  ariaHidden = false,
  delay = 0,
  stagger = 30,
} = Astro.props;

// Split into characters. Preserve whitespace, mark it non-flapping so the
// animation doesn't rotate empty boxes.
const chars = Array.from(text);
---
<span
  class:list={[
    "sol-flip",
    `sol-flip--${tone}`,
    `sol-flip--${weight}`,
  ]}
  aria-hidden={ariaHidden ? "true" : undefined}
  aria-label={ariaHidden ? undefined : text}
>
  {chars.map((ch, i) => {
    const isSpace = ch === " " || ch === " ";
    const style = `--i:${i};--d:${delay}ms;--s:${stagger}ms`;
    return (
      <span
        class:list={["sol-flip__c", isSpace && "sol-flip__c--space"]}
        style={style}
        aria-hidden="true"
      >{isSpace ? " " : ch}</span>
    );
  })}
</span>

<style>
  .sol-flip {
    display: inline-block;
    perspective: 220px;
    perspective-origin: 50% 50%;
    font-variant-numeric: tabular-nums lining-nums;
    letter-spacing: 0.06em;
    white-space: pre;
  }
  .sol-flip--regular { font-weight: 400; }
  .sol-flip--bold    { font-weight: 700; }

  .sol-flip--active { color: var(--sol-amber); }
  .sol-flip--muted  { color: var(--sol-amber-faded); }
  .sol-flip--pos    { color: var(--sol-green); }
  .sol-flip--neg    { color: var(--sol-red); }

  .sol-flip__c {
    display: inline-block;
    transform-origin: 50% 50%;
    backface-visibility: hidden;
    will-change: transform, opacity;
    animation: sol-flap 380ms cubic-bezier(0.2, 0.7, 0.3, 1) both;
    animation-delay: calc(var(--d) + var(--i) * var(--s));
  }

  .sol-flip__c--space {
    animation: none;
  }

  @keyframes sol-flap {
    0%   { transform: rotateX(-90deg); opacity: 0; }
    55%  { transform: rotateX(15deg);  opacity: 1; }
    80%  { transform: rotateX(-6deg); }
    100% { transform: rotateX(0deg);   opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sol-flip__c {
      animation: none;
      transform: none;
      opacity: 1;
    }
  }
</style>
