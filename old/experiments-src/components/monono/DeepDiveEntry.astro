---
/*
 * Mono no aware DeepDiveEntry.
 *
 * Each deep dive set as a small editorial card: pillar code top-left, the
 * status as a discreet right-set kicker, a Mincho title, then an italic
 * deck. Spaced generously. No backgrounds, no borders other than the
 * shared hairline rule above.
 */

import type { DeepDive } from "../../../data/sections";

interface Props {
  item: DeepDive;
  num: string;
}

const { item, num } = Astro.props;

const statusLabel =
  item.status === "research" ? "In research" :
  item.status === "drafted" ? "Drafted" :
  "Shipped";
---
<article class="mn-dd" aria-labelledby={`mn-dd-${num}-h`}>
  <header class="mn-dd__head">
    <p class="mn-dd__pillar">
      <span class="mn-dd__pillar-key">Pillar</span>
      <span class="mn-dd__pillar-code">{item.pillar}</span>
    </p>
    <p class="mn-dd__status" data-status={item.status}>
      <span class="mn-dd__status-dot" aria-hidden="true"></span>
      <span>{statusLabel}</span>
    </p>
  </header>

  <h3 id={`mn-dd-${num}-h`} class="mn-dd__title">
    {item.title}
  </h3>

  <p class="mn-dd__deck">{item.deck}</p>

  <p class="mn-dd__stamp">
    <span class="mn-dd__section">{item.section}</span>
    <span class="mn-dd__sep" aria-hidden="true">.</span>
    <span class="mn-dd__updated">Updated {item.lastUpdated}</span>
  </p>
</article>

<style>
  .mn-dd {
    padding-block: clamp(28px, 5vh, 48px);
    border-top: 1px solid var(--mn-rule);
    max-width: 520px;
  }

  .mn-dd__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin: 0 0 20px;
    font-family: var(--mn-display);
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--mn-ink-faint);
  }
  .mn-dd__pillar {
    margin: 0;
    display: inline-flex;
    gap: 10px;
    align-items: baseline;
  }
  .mn-dd__pillar-key {
    color: var(--mn-ink-faint);
  }
  .mn-dd__pillar-code {
    color: var(--mn-ink);
    font-weight: 500;
  }

  .mn-dd__status {
    margin: 0;
    display: inline-flex;
    gap: 8px;
    align-items: center;
  }
  .mn-dd__status-dot {
    display: inline-block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--mn-ink-faint);
  }
  .mn-dd__status[data-status="shipped"] .mn-dd__status-dot {
    background: var(--mn-accent);
  }
  .mn-dd__status[data-status="drafted"] .mn-dd__status-dot {
    background: var(--mn-ink);
  }

  .mn-dd__title {
    margin: 0;
    font-family: var(--mn-display);
    font-weight: 500;
    font-size: clamp(22px, 2.4vw, 30px);
    line-height: 1.3;
    letter-spacing: -0.005em;
    color: var(--mn-ink);
    max-width: 22ch;
  }

  .mn-dd__deck {
    margin: 16px 0 0;
    font-family: var(--mn-body);
    font-style: italic;
    font-weight: 400;
    font-size: 15px;
    line-height: 1.6;
    color: var(--mn-ink);
    max-width: 52ch;
  }

  .mn-dd__stamp {
    margin: 24px 0 0;
    font-family: var(--mn-display);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--mn-ink-faint);
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
  }
  .mn-dd__section { color: var(--mn-ink); }
  .mn-dd__sep { opacity: 0.55; }
</style>
