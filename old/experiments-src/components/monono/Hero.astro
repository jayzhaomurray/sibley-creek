---
/*
 * Mono no aware Hero.
 *
 * The freshest section presented as a single quiet plate. Section name in
 * small caps with a single calligraphic stroke beneath. Headline question
 * set in serif italic. One value — the primary print — in large but
 * weightless Mincho. Date and prior delta below as a single mono-spaced
 * stamp.
 *
 * The hero is small in absolute terms but commands the page through space.
 */

import type { Section } from "../../../data/sections";

interface Props {
  section: Section;
}

const { section } = Astro.props;

const lb = section.chartSeriesKey
  ? section.prints.find((p) => p.key === section.chartSeriesKey) ?? section.prints[0]
  : section.prints[0];
---
<section
  class="mn-hero"
  aria-labelledby={`mn-hero-${section.slug}-h`}
>
  <div class="mn-hero__shell">
    {/* Section name as a small label, drawn with a calligraphic underline */}
    <div class="mn-hero__heading">
      <p class="mn-hero__eyebrow">
        <span class="mn-hero__eyebrow-dot" aria-hidden="true"></span>
        <span class="mn-hero__eyebrow-text">The current question</span>
      </p>
      <h2 id={`mn-hero-${section.slug}-h`} class="mn-hero__section">
        <a href={`/${section.slug}/`} class="mn-hero__section-link">
          {section.label}
        </a>
      </h2>
      <svg
        class="mn-hero__stroke"
        viewBox="0 0 160 8"
        width="160"
        height="8"
        aria-hidden="true"
        focusable="false"
      >
        <path
          d="M 2 4 C 28 2, 60 7, 96 3 C 124 1, 144 6, 158 4"
          fill="none"
          stroke="var(--mn-ink)"
          stroke-width="1.4"
          stroke-linecap="round"
          class="mn-hero__stroke-path"
        />
      </svg>
    </div>

    <p class="mn-hero__question">
      {section.headlineQuestion}
    </p>

    <div class="mn-hero__plate">
      <p class="mn-hero__indicator">{lb.indicator}</p>
      <p class="mn-hero__value">
        <span class="mn-hero__value-num">{lb.value}</span>
      </p>
      <p class="mn-hero__stamp">
        <span class="mn-hero__delta" data-dir={lb.deltaDir}>
          {lb.delta}
        </span>
        <span class="mn-hero__stamp-sep" aria-hidden="true">.</span>
        <span class="mn-hero__asof">{lb.asOf}</span>
      </p>
    </div>

    {section.blurb.body && (
      <p class="mn-hero__blurb">
        {section.blurb.date && (
          <span class="mn-hero__blurb-date">{section.blurb.date}.</span>
        )}{" "}
        {section.blurb.body}
      </p>
    )}
  </div>
</section>

<style>
  .mn-hero {
    position: relative;
    padding-left: clamp(24px, 18vw, 280px);
    padding-right: clamp(24px, 6vw, 96px);
    padding-block: clamp(48px, 10vh, 120px);
  }

  .mn-hero__shell {
    max-width: 640px;
    margin-left: auto;
  }

  .mn-hero__heading {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }
  .mn-hero__eyebrow {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--mn-display);
    font-size: 11px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--mn-ink-faint);
  }
  .mn-hero__eyebrow-dot {
    width: 6px;
    height: 6px;
    background: var(--mn-accent);
    display: inline-block;
    border-radius: 50%;
  }
  .mn-hero__section {
    margin: 0;
    font-family: var(--mn-display);
    font-weight: 500;
    font-size: clamp(32px, 4.2vw, 56px);
    letter-spacing: 0.04em;
    line-height: 1;
    color: var(--mn-ink);
    text-transform: uppercase;
  }
  .mn-hero__section-link {
    color: inherit;
    text-decoration: none;
    transition: color 200ms ease;
  }
  .mn-hero__section-link:hover {
    color: var(--mn-accent);
  }
  .mn-hero__section-link:focus-visible {
    outline: 1px solid var(--mn-accent);
    outline-offset: 6px;
  }
  .mn-hero__stroke {
    margin-top: 4px;
    color: var(--mn-ink);
  }
  .mn-hero__stroke-path {
    stroke-dasharray: 180;
    stroke-dashoffset: 180;
    animation: mn-hero-stroke 700ms cubic-bezier(0.22, 0.61, 0.36, 1) 400ms forwards;
  }
  @keyframes mn-hero-stroke {
    to { stroke-dashoffset: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mn-hero__stroke-path {
      animation: none;
      stroke-dashoffset: 0;
    }
  }

  .mn-hero__question {
    margin: clamp(28px, 5vh, 48px) 0 0;
    font-family: var(--mn-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(20px, 2.4vw, 28px);
    line-height: 1.5;
    color: var(--mn-ink);
    letter-spacing: 0.005em;
    max-width: 28ch;
  }

  .mn-hero__plate {
    margin-top: clamp(48px, 8vh, 96px);
  }
  .mn-hero__indicator {
    margin: 0 0 12px;
    font-family: var(--mn-display);
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--mn-ink-faint);
  }
  .mn-hero__value {
    margin: 0;
    line-height: 1;
  }
  .mn-hero__value-num {
    font-family: var(--mn-display);
    font-weight: 400;
    font-size: clamp(64px, 9vw, 128px);
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--mn-ink);
    font-variant-numeric: tabular-nums lining-nums;
  }
  .mn-hero__stamp {
    margin: 16px 0 0;
    font-family: var(--mn-display);
    font-size: 13px;
    letter-spacing: 0.06em;
    color: var(--mn-ink-faint);
    display: inline-flex;
    align-items: baseline;
    gap: 12px;
    font-variant-numeric: tabular-nums;
  }
  .mn-hero__delta[data-dir="pos"] { color: var(--mn-accent); }
  .mn-hero__delta[data-dir="neg"] { color: var(--mn-ink); }
  .mn-hero__delta[data-dir="neutral"] { color: var(--mn-ink-faint); }
  .mn-hero__stamp-sep {
    color: var(--mn-ink-faint);
    opacity: 0.6;
  }
  .mn-hero__asof {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 11px;
  }

  .mn-hero__blurb {
    margin: clamp(40px, 7vh, 72px) 0 0;
    font-family: var(--mn-body);
    font-weight: 400;
    font-size: 16px;
    line-height: 1.7;
    color: var(--mn-ink);
    max-width: 56ch;
  }
  .mn-hero__blurb-date {
    color: var(--mn-ink-faint);
    font-style: italic;
    margin-right: 4px;
  }
</style>
