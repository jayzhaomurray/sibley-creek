---
/*
 * GDPNow TitleStatement — academic-paper title block.
 *
 * Sets the brief title in modest serif ("Canadian Macro Overview, May 11,
 * 2026"), an abstract line beneath, and a small set of three masthead
 * tracking numbers (latest CPI, BoC rate, U-rate) presented as the
 * staff-page summary stamp.
 */

import type { Section } from "../../../data/sections";

interface Props {
  dateLine: string;
  abstract: string;
  sections: Section[];
}

const { dateLine, abstract, sections } = Astro.props;

// Pull three anchor headline numbers across the dashboard for the
// summary stamp. These mirror what a Fed staff page would put on its top.
const stamp = [
  {
    label: "Headline CPI, y/y",
    section: "inflation",
  },
  {
    label: "BoC overnight rate",
    section: "monetary",
  },
  {
    label: "Unemployment rate",
    section: "labour",
  },
].map((row) => {
  const s = sections.find((x) => x.slug === row.section);
  const p = s?.prints.find((x) => x.indicator === row.label) ?? s?.prints[0];
  return {
    label: row.label,
    value: p?.value ?? "",
    asOf: p?.asOf ?? "",
  };
});
---
<section class="gdp-title" aria-labelledby="gdp-title-h">
  <p class="gdp-title__eyebrow">Research note · Canadian macro · Independent</p>
  <h1 id="gdp-title-h" class="gdp-title__h">
    Canadian Macro Overview, <span class="gdp-title__date">{dateLine}</span>
  </h1>
  <p class="gdp-title__abs">{abstract}</p>

  <dl class="gdp-title__stamp" aria-label="Headline numbers at a glance">
    {stamp.map((row) => (
      <div class="gdp-title__stamp-row">
        <dt class="gdp-title__stamp-k">{row.label}</dt>
        <dd class="gdp-title__stamp-v">
          <span class="gdp-title__stamp-num">{row.value}</span>
          <span class="gdp-title__stamp-asof">{row.asOf}</span>
        </dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .gdp-title {
    padding-block: 28px 24px;
    border-bottom: 0.5px solid var(--gdp-rule);
  }
  .gdp-title__eyebrow {
    margin: 0 0 10px;
    font-family: var(--gdp-mono);
    font-size: 10px;
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gdp-gray);
  }
  .gdp-title__h {
    margin: 0;
    font-family: var(--gdp-display);
    font-weight: 500;
    font-size: clamp(26px, 3.4vw, 36px);
    line-height: 1.15;
    letter-spacing: 0;
    color: var(--gdp-ink);
    max-width: 36ch;
  }
  .gdp-title__date {
    color: var(--gdp-navy);
    font-style: italic;
    font-weight: 500;
  }
  .gdp-title__abs {
    margin: 12px 0 0;
    font-family: var(--gdp-body);
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--gdp-ink);
    max-width: 64ch;
  }

  .gdp-title__stamp {
    margin: 20px 0 0;
    display: grid;
    grid-template-columns: 1fr;
    border-top: 0.5px solid var(--gdp-rule);
    border-bottom: 0.5px solid var(--gdp-rule);
  }
  @media (min-width: 720px) {
    .gdp-title__stamp {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .gdp-title__stamp-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    padding: 10px 14px;
    border-bottom: 0.5px dashed var(--gdp-rule);
  }
  @media (min-width: 720px) {
    .gdp-title__stamp-row {
      border-bottom: 0;
      border-right: 0.5px solid var(--gdp-rule);
      flex-direction: column;
      align-items: flex-start;
      padding: 12px 16px;
    }
    .gdp-title__stamp-row:last-child {
      border-right: 0;
    }
    .gdp-title__stamp-row:first-child {
      padding-left: 0;
    }
  }
  .gdp-title__stamp-row:last-child {
    border-bottom: 0;
  }
  .gdp-title__stamp-k {
    margin: 0;
    font-family: var(--gdp-body);
    font-size: 12px;
    line-height: 1.2;
    color: var(--gdp-gray);
    font-style: italic;
  }
  .gdp-title__stamp-v {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  @media (min-width: 720px) {
    .gdp-title__stamp-v {
      margin-top: 4px;
    }
  }
  .gdp-title__stamp-num {
    font-family: var(--gdp-mono);
    font-size: 18px;
    line-height: 1;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--gdp-ink);
    font-variant-numeric: tabular-nums;
  }
  .gdp-title__stamp-asof {
    font-family: var(--gdp-mono);
    font-size: 10px;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gdp-gray);
  }
</style>
