---
/*
 * AtlasPatterns - inline SVG <defs> with all reusable scientific-atlas
 * fills and ornaments. Rendered once at the top of the page; referenced
 * across the plates by id.
 *
 * Patterns:
 *   #at-hatch-navy        diagonal cross-hatching, navy on cream
 *   #at-hatch-sepia       diagonal cross-hatching, sepia on cream
 *   #at-hatch-dense       tighter navy hatch for chart "fill" regions
 *   #at-stipple-navy      dot-stipple, navy on cream (relief-shading)
 *   #at-grid-fine         fine lat/lon graticule
 *   #at-grid-coarse       coarse lat/lon graticule for backgrounds
 *
 * The compass rose and the fleuron sit as <symbol> nodes referenced by
 * <use> elsewhere; they live with the patterns to keep the SVG vocab
 * in one place.
 *
 * The <svg> root carries width=0/height=0 + aria-hidden so it does not
 * contribute to layout or to the accessibility tree. Pattern definitions
 * are picked up by url(#id) from the rest of the document.
 */
---
<svg
  class="at-defs"
  width="0"
  height="0"
  aria-hidden="true"
  focusable="false"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <!-- Cross-hatching, navy 45deg + 135deg, on cream. -->
    <pattern id="at-hatch-navy" patternUnits="userSpaceOnUse" width="6" height="6">
      <rect width="6" height="6" fill="transparent" />
      <path d="M 0,6 L 6,0" stroke="#1B2F4B" stroke-width="0.5" stroke-opacity="0.55" />
      <path d="M 0,0 L 6,6" stroke="#1B2F4B" stroke-width="0.5" stroke-opacity="0.25" />
    </pattern>

    <!-- Cross-hatching, sepia ochre, gentler. -->
    <pattern id="at-hatch-sepia" patternUnits="userSpaceOnUse" width="6" height="6">
      <rect width="6" height="6" fill="transparent" />
      <path d="M 0,6 L 6,0" stroke="#A6794F" stroke-width="0.5" stroke-opacity="0.55" />
      <path d="M 0,0 L 6,6" stroke="#A6794F" stroke-width="0.5" stroke-opacity="0.30" />
    </pattern>

    <!-- Denser hatch for "fill" of chart regions on hero plate. -->
    <pattern id="at-hatch-dense" patternUnits="userSpaceOnUse" width="4" height="4">
      <rect width="4" height="4" fill="transparent" />
      <path d="M 0,4 L 4,0" stroke="#1B2F4B" stroke-width="0.7" stroke-opacity="0.75" />
    </pattern>

    <!-- Dotted stipple for "relief shading" backgrounds. -->
    <pattern id="at-stipple-navy" patternUnits="userSpaceOnUse" width="5" height="5">
      <rect width="5" height="5" fill="transparent" />
      <circle cx="1" cy="1" r="0.45" fill="#1B2F4B" fill-opacity="0.55" />
      <circle cx="3.5" cy="3" r="0.35" fill="#1B2F4B" fill-opacity="0.35" />
    </pattern>

    <!-- Coarse hatch in sepia for plate-number medallions. -->
    <pattern id="at-hatch-sepia-coarse" patternUnits="userSpaceOnUse" width="10" height="10">
      <rect width="10" height="10" fill="transparent" />
      <path d="M 0,10 L 10,0" stroke="#A6794F" stroke-width="0.6" stroke-opacity="0.65" />
    </pattern>

    <!-- Fine page-border graticule (lat/lon grid). -->
    <pattern id="at-grid-fine" patternUnits="userSpaceOnUse" width="24" height="24">
      <rect width="24" height="24" fill="transparent" />
      <path d="M 24,0 L 0,0 0,24" fill="transparent" stroke="#7A6549" stroke-width="0.4" stroke-opacity="0.45" />
    </pattern>

    <pattern id="at-grid-coarse" patternUnits="userSpaceOnUse" width="96" height="96">
      <rect width="96" height="96" fill="transparent" />
      <path d="M 96,0 L 0,0 0,96" fill="transparent" stroke="#7A6549" stroke-width="0.6" stroke-opacity="0.55" />
    </pattern>

    <!-- Compass rose, sized to a 120x120 viewBox; consumer scales. -->
    <symbol id="at-compass" viewBox="0 0 120 120">
      <g fill="none" stroke="#1B2F4B" stroke-width="0.9">
        <circle cx="60" cy="60" r="56" stroke-opacity="0.9" />
        <circle cx="60" cy="60" r="44" stroke-opacity="0.55" />
        <circle cx="60" cy="60" r="3" fill="#1B2F4B" stroke="none" />
      </g>
      <!-- Cardinal star -->
      <g fill="#1B2F4B" stroke="#1B2F4B" stroke-width="0.6">
        <polygon points="60,4 56,60 60,46 64,60" fill-opacity="1" />
        <polygon points="60,116 56,60 60,74 64,60" fill-opacity="0.85" />
        <polygon points="4,60 60,56 46,60 60,64" fill-opacity="0.55" />
        <polygon points="116,60 60,56 74,60 60,64" fill-opacity="0.55" />
      </g>
      <!-- Diagonal half-tones -->
      <g fill="#A6794F" stroke="none" fill-opacity="0.85">
        <polygon points="60,60 22,22 56,56" />
        <polygon points="60,60 98,22 64,56" />
        <polygon points="60,60 22,98 56,64" />
        <polygon points="60,60 98,98 64,64" />
      </g>
      <!-- Tick marks at the bezel -->
      <g stroke="#1B2F4B" stroke-width="0.6">
        <line x1="60" y1="8" x2="60" y2="14" />
        <line x1="60" y1="106" x2="60" y2="112" />
        <line x1="8" y1="60" x2="14" y2="60" />
        <line x1="106" y1="60" x2="112" y2="60" />
        <line x1="22" y1="22" x2="26" y2="26" stroke-opacity="0.7" />
        <line x1="98" y1="22" x2="94" y2="26" stroke-opacity="0.7" />
        <line x1="22" y1="98" x2="26" y2="94" stroke-opacity="0.7" />
        <line x1="98" y1="98" x2="94" y2="94" stroke-opacity="0.7" />
      </g>
      <!-- Cardinal letters -->
      <g
        font-family="Cormorant Garamond, serif"
        font-style="italic"
        font-size="11"
        fill="#1B2F4B"
        text-anchor="middle"
      >
        <text x="60" y="4" dy="0.9em">N</text>
        <text x="60" y="111" dy="0.7em">S</text>
        <text x="6" y="60" dy="0.35em">W</text>
        <text x="114" y="60" dy="0.35em">E</text>
      </g>
    </symbol>

    <!-- Engraving-style fleuron / pinwheel ornament for inter-section breaks. -->
    <symbol id="at-fleuron" viewBox="0 0 40 40">
      <g stroke="#1B2F4B" stroke-width="0.7" fill="none">
        <circle cx="20" cy="20" r="1.6" fill="#1B2F4B" />
        <circle cx="20" cy="20" r="6" stroke-opacity="0.6" />
      </g>
      <g stroke="#1B2F4B" stroke-width="0.6" fill="none">
        <path d="M 20,2 C 22,10 22,12 20,18 C 18,12 18,10 20,2 Z" fill="#A6794F" fill-opacity="0.7" />
        <path d="M 20,38 C 22,30 22,28 20,22 C 18,28 18,30 20,38 Z" fill="#A6794F" fill-opacity="0.7" />
        <path d="M 2,20 C 10,18 12,18 18,20 C 12,22 10,22 2,20 Z" fill="#A6794F" fill-opacity="0.7" />
        <path d="M 38,20 C 30,18 28,18 22,20 C 28,22 30,22 38,20 Z" fill="#A6794F" fill-opacity="0.7" />
      </g>
      <g stroke="#1B2F4B" stroke-width="0.5" stroke-opacity="0.6" fill="none">
        <line x1="6" y1="6" x2="14" y2="14" />
        <line x1="34" y1="6" x2="26" y2="14" />
        <line x1="6" y1="34" x2="14" y2="26" />
        <line x1="34" y1="34" x2="26" y2="26" />
      </g>
    </symbol>

    <!-- A small "site of interest" map pin, used singularly per the brief. -->
    <symbol id="at-pin" viewBox="0 0 20 28">
      <path d="M 10,2 C 14.4,2 18,5.6 18,10 C 18,16 10,26 10,26 C 10,26 2,16 2,10 C 2,5.6 5.6,2 10,2 Z"
        fill="#923225" stroke="#1B2F4B" stroke-width="0.7" />
      <circle cx="10" cy="10" r="2.4" fill="#EEE6D2" stroke="#1B2F4B" stroke-width="0.6" />
    </symbol>
  </defs>
</svg>

<style>
  .at-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
</style>
