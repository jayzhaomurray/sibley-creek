---
/*
 * AtlasColophon - back-of-the-atlas plate: bibliographic details,
 * next-release stamp, projection notice, decorative fleuron and a
 * second small compass rose. Italic small-caps section labels.
 */

interface Props {
  publication: string;
  shortName: string;
  description: string;
  url: string;
  locale: string;
  produced: string;
  nextLabel: string;
  nextDate: string;
  nextAgency: string;
}

const {
  publication,
  shortName,
  description,
  url,
  locale,
  produced,
  nextLabel,
  nextDate,
  nextAgency,
} = Astro.props;
---
<footer class="at-col" aria-labelledby="at-col-h">
  <div class="at-col__ornament" aria-hidden="true">
    <svg viewBox="0 0 40 40" class="at-col__fleuron">
      <use href="#at-fleuron" />
    </svg>
  </div>

  <hr class="at-col__rule at-col__rule--heavy" aria-hidden="true" />
  <hr class="at-col__rule at-col__rule--hair" aria-hidden="true" />

  <div class="at-col__grid">
    <section class="at-col__cell">
      <h2 id="at-col-h" class="at-col__cell-h">Colophon</h2>
      <p class="at-col__body">
        <em>{publication}</em> ({shortName}) is a reading-first atlas of
        Canadian macroeconomic data, set in Cormorant Garamond and Crimson
        Pro with coordinate labels in IBM Plex Mono. Plate engravings are
        rendered in two-colour discipline on cream stock.
      </p>
      <p class="at-col__meta">
        <span class="at-col__meta-key">Locale</span>
        <span class="at-col__meta-val">{locale}</span>
        <span class="at-col__meta-sep" aria-hidden="true">&#xb7;</span>
        <span class="at-col__meta-key">Origin</span>
        <span class="at-col__meta-val">{url}</span>
      </p>
    </section>

    <section class="at-col__cell">
      <h2 class="at-col__cell-h">Methodology</h2>
      <p class="at-col__body">
        <em>{description}</em>
      </p>
      <p class="at-col__meta">
        <span class="at-col__meta-key">Projection</span>
        <span class="at-col__meta-val">Lambert Conformal</span>
        <span class="at-col__meta-sep" aria-hidden="true">&#xb7;</span>
        <span class="at-col__meta-key">Datum</span>
        <span class="at-col__meta-val">official agencies</span>
      </p>
    </section>

    <section class="at-col__cell at-col__cell--next">
      <h2 class="at-col__cell-h">Next plate</h2>
      <p class="at-col__next">
        <span class="at-col__next-label">{nextLabel}</span>
        <span class="at-col__next-date">{nextDate}</span>
        <span class="at-col__next-agency">{nextAgency}</span>
      </p>
      <svg viewBox="0 0 120 120" class="at-col__compass" aria-hidden="true">
        <use href="#at-compass" />
      </svg>
    </section>
  </div>

  <hr class="at-col__rule at-col__rule--hair" aria-hidden="true" />
  <hr class="at-col__rule at-col__rule--heavy" aria-hidden="true" />

  <p class="at-col__signoff">
    <span class="at-col__signoff-key">Engraved</span>
    <span class="at-col__signoff-val">{produced}</span>
    <span class="at-col__signoff-sep" aria-hidden="true">&#xb7;</span>
    <span class="at-col__signoff-key">Edition Lane F</span>
    <span class="at-col__signoff-val">Cartographic Atlas</span>
    <span class="at-col__signoff-sep" aria-hidden="true">&#xb7;</span>
    <a class="at-col__signoff-back" href="/">Return to production homepage</a>
  </p>
</footer>

<style>
  .at-col {
    position: relative;
    padding-block: 56px 28px;
  }
  .at-col__ornament {
    display: flex;
    justify-content: center;
    padding-bottom: 24px;
  }
  .at-col__fleuron {
    width: 40px;
    height: 40px;
    display: block;
  }
  .at-col__rule {
    border: 0;
    margin: 0;
    height: 0;
  }
  .at-col__rule--heavy { border-top: 1px solid var(--at-ink); }
  .at-col__rule--hair {
    border-top: 0.5px solid var(--at-ink);
    margin-top: 3px;
  }

  .at-col__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    padding-block: 28px 28px;
  }
  @media (min-width: 800px) {
    .at-col__grid {
      grid-template-columns: 5fr 5fr 4fr;
      gap: 36px;
    }
  }

  .at-col__cell {
    min-width: 0;
    position: relative;
  }
  .at-col__cell + .at-col__cell {
    padding-top: 0;
  }
  @media (min-width: 800px) {
    .at-col__cell + .at-col__cell {
      border-left: 0.5px solid var(--at-rule);
      padding-left: 28px;
    }
  }

  .at-col__cell-h {
    margin: 0 0 10px;
    font-family: var(--at-display);
    font-weight: 500;
    font-size: 18px;
    letter-spacing: 0.06em;
    color: var(--at-ink);
    font-variant: small-caps;
    text-transform: lowercase;
  }

  .at-col__body {
    margin: 0 0 12px;
    font-family: var(--at-body);
    font-size: 14px;
    line-height: 1.6;
    color: var(--at-ink);
    max-width: 48ch;
  }
  .at-col__body em { font-style: italic; }

  .at-col__meta {
    margin: 0;
    font-family: var(--at-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--at-ink-mute);
    display: flex;
    flex-wrap: wrap;
    gap: 4px 8px;
  }
  .at-col__meta-key { color: var(--at-ink-faint); }
  .at-col__meta-val { color: var(--at-ink); }
  .at-col__meta-sep { color: var(--at-ink-faint); }

  .at-col__cell--next {
    position: relative;
  }
  .at-col__next {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .at-col__next-label {
    font-family: var(--at-display);
    font-weight: 600;
    font-size: 22px;
    color: var(--at-ink);
    font-variant: small-caps;
    text-transform: lowercase;
    letter-spacing: 0.01em;
  }
  .at-col__next-date {
    font-family: var(--at-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--at-ink);
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
  }
  .at-col__next-agency {
    font-family: var(--at-body);
    font-size: 13px;
    font-style: italic;
    color: var(--at-ink-mute);
  }
  .at-col__compass {
    position: absolute;
    right: 0;
    top: -8px;
    width: 64px;
    height: 64px;
    opacity: 0.6;
  }

  .at-col__signoff {
    margin: 18px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    align-items: baseline;
    font-family: var(--at-mono);
    font-size: 10.5px;
    line-height: 1.4;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--at-ink-mute);
  }
  .at-col__signoff-key { color: var(--at-ink-faint); }
  .at-col__signoff-val { color: var(--at-ink); }
  .at-col__signoff-sep { color: var(--at-ink-faint); }
  .at-col__signoff-back {
    color: var(--at-ink);
    text-decoration: none;
    border-bottom: 0.5px solid var(--at-ink);
    padding-bottom: 1px;
    margin-left: auto;
  }
  .at-col__signoff-back:hover {
    color: var(--at-crimson);
    border-bottom-color: var(--at-crimson);
  }
  .at-col__signoff-back:focus-visible {
    outline: 2px solid var(--at-crimson);
    outline-offset: 3px;
  }
</style>
