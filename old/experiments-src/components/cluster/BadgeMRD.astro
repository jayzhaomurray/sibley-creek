---
/*
 * BadgeMRD - the steering-wheel-style brand mark at the top center of
 * the Instrument Cluster splash. Brushed-metal disc with a recessed
 * inner ring and the "MRD" letters embossed in warm ivory. A faint
 * amber halo behind the disc to suggest ambient cabin lighting.
 *
 * SVG, 120x120, scales via CSS.
 */
---

<div class="cl-badge">
  <svg viewBox="0 0 120 120" class="cl-badge__svg" role="img" aria-label="MRD - Macro Research Department">
    <defs>
      <radialGradient id="cl-badge-disc" cx="40%" cy="30%" r="80%">
        <stop offset="0%" stop-color="#D5DAE3" />
        <stop offset="50%" stop-color="#9099A8" />
        <stop offset="100%" stop-color="#2A2E36" />
      </radialGradient>
      <radialGradient id="cl-badge-inner" cx="50%" cy="50%" r="55%">
        <stop offset="0%" stop-color="#1A1D23" />
        <stop offset="80%" stop-color="#0F0F12" />
        <stop offset="100%" stop-color="#22262E" />
      </radialGradient>
      <radialGradient id="cl-badge-halo" cx="50%" cy="55%" r="55%">
        <stop offset="0%" stop-color="rgba(212,131,26,0.30)" />
        <stop offset="70%" stop-color="rgba(212,131,26,0.06)" />
        <stop offset="100%" stop-color="rgba(212,131,26,0)" />
      </radialGradient>
    </defs>
    {/* Amber halo */}
    <circle cx="60" cy="60" r="58" fill="url(#cl-badge-halo)" />
    {/* Outer brushed disc */}
    <circle cx="60" cy="60" r="46" fill="url(#cl-badge-disc)" />
    <circle cx="60" cy="60" r="45" fill="none" stroke="rgba(255,255,255,0.10)" stroke-width="0.6" />
    {/* Inner recess */}
    <circle cx="60" cy="60" r="38" fill="url(#cl-badge-inner)" />
    <circle cx="60" cy="60" r="37" fill="none" stroke="rgba(212,131,26,0.25)" stroke-width="0.5" />
    {/* Letters */}
    <text
      x="60"
      y="62"
      text-anchor="middle"
      dominant-baseline="central"
      class="cl-badge__letters"
    >MRD</text>
    {/* Tagline arc - tiny letters around bottom */}
    <text
      x="60"
      y="86"
      text-anchor="middle"
      dominant-baseline="central"
      class="cl-badge__tag"
    >EST · CAN · MMXXVI</text>
  </svg>
</div>

<style>
  .cl-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: clamp(80px, 9vw, 120px);
    height: auto;
    filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.6));
  }
  .cl-badge__svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .cl-badge__letters {
    fill: #F4ECCE;
    font-family: "Russo One", "Saira Condensed", sans-serif;
    font-weight: 400;
    font-size: 22px;
    letter-spacing: 0.10em;
  }
  .cl-badge__tag {
    fill: #9099A8;
    font-family: "Saira Condensed", sans-serif;
    font-weight: 500;
    font-size: 5px;
    letter-spacing: 0.30em;
  }
</style>
