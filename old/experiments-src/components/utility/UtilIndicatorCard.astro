---
/*
 * UtilIndicatorCard - one indicator card in the weather-hub grid.
 *
 * Layout, top to bottom:
 *   - Section name (large, all-caps "INFLATION" rail)
 *   - Advisory pill (color-coded "ALERT" / "ADVISORY" / "WATCH" /
 *     "NORMAL") + as-of date stamp, right-aligned
 *   - Current state: value (display sans, semibold) + delta
 *   - Mini spark icon (96x32, civic-blue or advisory-amber stroke)
 *   - Nowcast: one-sentence machine-readable note
 *   - "More info" link to /<slug>/
 *
 * Visual conventions: flat panel, 1px slate rule, no shadows, no
 * gradients. The advisory pill is the only place color saturates.
 */

import type { Section, SectionPrint } from "../../../data/sections";
import UtilSparkIcon from "./UtilSparkIcon.astro";

export type AdvisoryLevel = "normal" | "watch" | "advisory" | "alert";

interface Props {
  section: Section;
  level: AdvisoryLevel;
  nowcast: string;
}

const { section, level, nowcast } = Astro.props;

const loadBearing: SectionPrint =
  (section.chartSeriesKey
    ? section.prints.find((p) => p.key === section.chartSeriesKey)
    : undefined) ?? section.prints[0];

const deltaClass =
  loadBearing.deltaDir === "pos"
    ? "util-card__delta--pos"
    : loadBearing.deltaDir === "neg"
      ? "util-card__delta--neg"
      : "util-card__delta--neutral";

// Pill label per advisory level. Mirrors NOAA / Environment Canada
// vocabulary: NORMAL is benign, WATCH is "monitor", ADVISORY is
// "elevated, expect impacts", ALERT is "active condition outside the
// normal envelope".
const pillCopy: Record<AdvisoryLevel, string> = {
  normal: "NORMAL",
  watch: "WATCH",
  advisory: "ADVISORY",
  alert: "ALERT",
};

const pillClass = `util-card__pill--${level}`;
const sparkVariant: AdvisoryLevel = level;
---
<article class="util-card" aria-labelledby={`util-card-${section.slug}-h`}>
  <div class="util-card__head">
    <h2 id={`util-card-${section.slug}-h`} class="util-card__name">
      {section.label}
    </h2>
    <div class="util-card__statusrow">
      <span class:list={["util-card__pill", pillClass]}>
        <span class="util-card__pill-dot" aria-hidden="true"></span>
        <span class="util-card__pill-text">{pillCopy[level]}</span>
      </span>
      <span class="util-card__asof">
        <span class="util-card__asof-k">AS OF</span>
        <span class="util-card__asof-v">{loadBearing.asOf}</span>
      </span>
    </div>
  </div>

  <p class="util-card__indicator">{loadBearing.indicator}</p>

  <div class="util-card__statline">
    <span class="util-card__value">{loadBearing.value}</span>
    <span class:list={["util-card__delta", deltaClass]}>{loadBearing.delta}</span>
    <UtilSparkIcon data={loadBearing.spark ?? []} variant={sparkVariant} />
  </div>

  <p class="util-card__nowcast">{nowcast}</p>

  <p class="util-card__more">
    <a class="util-card__link" href={`/${section.slug}/`}>
      More info
      <span class="util-card__arrow" aria-hidden="true">&rarr;</span>
    </a>
  </p>
</article>

<style>
  .util-card {
    background: var(--util-paper);
    border: 1px solid var(--util-rule);
    border-top: 3px solid var(--util-slate);
    padding: 16px 18px 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
    height: 100%;
  }

  .util-card__head {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .util-card__name {
    margin: 0;
    font-family: var(--util-sans);
    font-weight: 700;
    font-size: 19px;
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--util-slate);
  }

  .util-card__statusrow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* Advisory pill - the only saturated color on the card */
  .util-card__pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px 4px 8px;
    font-family: var(--util-sans);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border: 1px solid currentColor;
    border-radius: 2px;
    background: var(--util-paper);
  }
  .util-card__pill-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: currentColor;
    flex-shrink: 0;
  }
  .util-card__pill-text {
    color: var(--util-slate);
  }

  .util-card__pill--normal {
    color: var(--util-green);
  }
  .util-card__pill--normal .util-card__pill-text {
    color: var(--util-slate);
  }

  .util-card__pill--watch {
    color: var(--util-blue);
  }
  .util-card__pill--watch .util-card__pill-text {
    color: var(--util-blue);
  }

  .util-card__pill--advisory {
    color: var(--util-amber);
    background: #FBF1DF;
  }
  .util-card__pill--advisory .util-card__pill-text {
    color: #7E4807;
  }

  .util-card__pill--alert {
    color: var(--util-paper);
    background: var(--util-red);
    border-color: var(--util-red);
  }
  .util-card__pill--alert .util-card__pill-dot {
    background: var(--util-paper);
  }
  .util-card__pill--alert .util-card__pill-text {
    color: var(--util-paper);
  }

  .util-card__asof {
    font-family: var(--util-sans);
    display: inline-flex;
    align-items: baseline;
    gap: 5px;
    font-size: 11px;
    color: var(--util-faint);
    font-variant-numeric: tabular-nums;
  }
  .util-card__asof-k {
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 10px;
  }
  .util-card__asof-v {
    font-weight: 500;
    color: var(--util-slate);
  }

  .util-card__indicator {
    margin: 0;
    font-family: var(--util-sans);
    font-weight: 500;
    font-size: 13px;
    line-height: 1.3;
    color: var(--util-faint);
    letter-spacing: 0.01em;
  }

  .util-card__statline {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 6px 0 4px;
    border-bottom: 1px solid var(--util-rule);
    flex-wrap: wrap;
  }
  .util-card__value {
    font-family: var(--util-sans);
    font-weight: 700;
    font-size: 32px;
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--util-slate);
    font-variant-numeric: tabular-nums;
  }
  .util-card__delta {
    font-family: var(--util-sans);
    font-weight: 600;
    font-size: 13px;
    line-height: 1.1;
    letter-spacing: 0.01em;
    font-variant-numeric: tabular-nums;
  }
  .util-card__delta--pos { color: var(--util-green); }
  .util-card__delta--neg { color: var(--util-red); }
  .util-card__delta--neutral { color: var(--util-faint); }

  .util-card__statline :global(.util-spark) {
    margin-left: auto;
    align-self: center;
  }

  .util-card__nowcast {
    margin: 0;
    font-family: var(--util-sans);
    font-weight: 400;
    font-size: 14px;
    line-height: 1.45;
    color: var(--util-slate);
    flex: 1 0 auto;
  }

  .util-card__more {
    margin: 0;
    padding-top: 6px;
    border-top: 1px solid var(--util-rule);
  }
  .util-card__link {
    font-family: var(--util-sans);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.02em;
    color: var(--util-blue);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .util-card__link:hover {
    text-decoration-thickness: 2px;
  }
  .util-card__arrow {
    display: inline-block;
    margin-left: 2px;
    font-variant-numeric: tabular-nums;
  }
</style>
