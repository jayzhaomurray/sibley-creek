---
/*
 * UtilHeader - Government-style agency banner for Lane O.
 *
 * Visual reference: Environment Canada / weather.gov / canada.ca top
 * banner. A flat slate header with a small geometric maple-leaf mark,
 * the agency wordmark on the left, and an issuance stamp on the right.
 *
 * Directly below: a Canadian-flag-style accent stripe (red / white /
 * red) which doubles as wayfinding. Below that, a thin status bar with
 * locale, classification, and last-updated stamp. No drop shadows, no
 * gradients. Calm and civic.
 */

interface Props {
  shortName: string;
  fullName: string;
  sub: string;
  issuedStamp: string;
  classification: string;
}

// `shortName` is reserved for a future compact-banner variant; intentionally
// destructured but not used in v1.
const { fullName, sub, issuedStamp, classification } = Astro.props;
---
<header class="util-header" role="banner">
  <div class="util-header__bar">
    <div class="util-header__inner">
      <a class="util-header__brand" href="/">
        <span class="util-header__mark" aria-hidden="true">
          {/*
           * Minimalist 11-point maple leaf, geometric. Drawn flat so it
           * reads as a government mark rather than a logo.
           */}
          <svg viewBox="0 0 32 32" width="28" height="28" focusable="false" aria-hidden="true">
            <path
              fill="currentColor"
              d="M16 2 L17.6 6.4 L21.2 4.6 L20.6 8.6 L25.4 8.0 L23.2 11.6 L27.8 13.2 L24.0 15.4 L26.6 18.6 L21.8 19.0 L22.4 22.6 L18.0 21.0 L17.0 26.0 L16.0 24.4 L15.0 26.0 L14.0 21.0 L9.6 22.6 L10.2 19.0 L5.4 18.6 L8.0 15.4 L4.2 13.2 L8.8 11.6 L6.6 8.0 L11.4 8.6 L10.8 4.6 L14.4 6.4 Z"
            />
          </svg>
        </span>
        <span class="util-header__words">
          <span class="util-header__agency">{fullName}</span>
          <span class="util-header__sub">{sub}</span>
        </span>
      </a>
      <div class="util-header__meta" aria-label="Issuance">
        <span class="util-header__meta-row">
          <span class="util-header__meta-k">ISSUED</span>
          <span class="util-header__meta-v">{issuedStamp}</span>
        </span>
        <span class="util-header__meta-row">
          <span class="util-header__meta-k">CLASS</span>
          <span class="util-header__meta-v">{classification}</span>
        </span>
      </div>
    </div>
  </div>

  {/* Provincial / national accent stripe: red / white / red. Reads as
      a flag rail across the top of the page. Decorative; aria-hidden. */}
  <div class="util-header__stripe" aria-hidden="true">
    <span class="util-header__stripe-red"></span>
    <span class="util-header__stripe-white"></span>
    <span class="util-header__stripe-red"></span>
  </div>

  {/* Service rail: locale, format, last updated. The civic-service
      muscle memory — every government dashboard has a strip like this. */}
  <div class="util-header__service" role="navigation" aria-label="Service rail">
    <ul class="util-header__service-list">
      <li><span class="util-header__service-k">LOCALE</span> <span class="util-header__service-v">CA / EN</span></li>
      <li><span class="util-header__service-k">REGION</span> <span class="util-header__service-v">CANADA (NATIONAL)</span></li>
      <li><span class="util-header__service-k">SERVICE</span> <span class="util-header__service-v">CURRENT CONDITIONS &amp; FORECAST</span></li>
      <li class="util-header__service-li--end">
        <span class="util-header__service-k">REFRESH</span>
        <span class="util-header__service-v">AS RELEASES LAND</span>
      </li>
    </ul>
  </div>
</header>

<style>
  .util-header {
    background: var(--util-paper);
  }

  /* Top dark bar - agency identification */
  .util-header__bar {
    background: var(--util-slate);
    color: var(--util-paper);
  }
  .util-header__inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 18px clamp(16px, 3vw, 40px);
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
  }
  @media (min-width: 760px) {
    .util-header__inner {
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 24px;
    }
  }

  .util-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    color: var(--util-paper);
    text-decoration: none;
  }
  .util-header__brand:hover .util-header__agency,
  .util-header__brand:focus-visible .util-header__agency {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .util-header__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: var(--util-paper);
    color: var(--util-blue);
    border: 1px solid var(--util-paper);
    flex-shrink: 0;
  }

  .util-header__words {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .util-header__agency {
    font-family: var(--util-sans);
    font-weight: 700;
    font-size: 17px;
    letter-spacing: 0.02em;
    line-height: 1.1;
    text-transform: uppercase;
  }
  .util-header__sub {
    font-family: var(--util-sans);
    font-weight: 400;
    font-size: 13px;
    line-height: 1.3;
    color: var(--util-paper);
    opacity: 0.78;
    letter-spacing: 0.01em;
  }

  .util-header__meta {
    display: flex;
    gap: 18px;
    align-items: center;
    font-family: var(--util-sans);
    font-size: 12px;
    line-height: 1.2;
  }
  .util-header__meta-row {
    display: inline-flex;
    flex-direction: column;
    gap: 2px;
  }
  .util-header__meta-k {
    font-weight: 700;
    font-size: 10px;
    letter-spacing: 0.14em;
    opacity: 0.65;
    text-transform: uppercase;
  }
  .util-header__meta-v {
    font-weight: 600;
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.01em;
  }

  /* Flag-style accent stripe under the header */
  .util-header__stripe {
    display: grid;
    grid-template-columns: 1fr 2fr 1fr;
    height: 6px;
  }
  .util-header__stripe-red {
    background: var(--util-red);
  }
  .util-header__stripe-white {
    background: var(--util-paper);
    border-bottom: 1px solid var(--util-rule);
  }

  /* Service rail - civic dashboard convention */
  .util-header__service {
    background: var(--util-paper);
    border-bottom: 1px solid var(--util-rule);
  }
  .util-header__service-list {
    list-style: none;
    margin: 0;
    max-width: 1400px;
    margin: 0 auto;
    padding: 8px clamp(16px, 3vw, 40px);
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    font-family: var(--util-sans);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--util-slate);
  }
  .util-header__service-k {
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--util-faint);
    margin-right: 6px;
    font-size: 10px;
  }
  .util-header__service-v {
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 0.06em;
  }
  .util-header__service-li--end {
    margin-left: auto;
  }
</style>
