---
/*
 * Academic-textbook SectionPanel - mid-century journal plate, one per
 * section.
 *
 * Layout matches Lane I cell for cell:
 *   header strip  - PLATE [roman] index, section name in display small-caps,
 *                   cadence stamp on the right.
 *   primary       - SVG chart on the left (olive forest line, brick last
 *                   point), readout column on the right.
 *   small table   - indicator | value | change | as-of. Hairline rules.
 *
 * Static SVG, no JS. Chart strokes use the textbook olive/forest accent;
 * last-observation marker is a muted brick.
 */

import type { Section } from "../../../data/sections";

interface Props {
  section: Section;
  figureNum: string;
  plate: string;
}

const { section, figureNum, plate } = Astro.props;

const loadBearing = section.chartSeriesKey
  ? section.prints.find((p) => p.key === section.chartSeriesKey) ?? section.prints[0]
  : section.prints[0];

const series = loadBearing.spark ?? [0, 0.2, 0.3, 0.4];

const W = 320;
const H = 110;
const PAD_L = 30;
const PAD_R = 8;
const PAD_T = 10;
const PAD_B = 20;

const plotW = W - PAD_L - PAD_R;
const plotH = H - PAD_T - PAD_B;

const minV = Math.min(...series);
const maxV = Math.max(...series);
const rangeRaw = maxV - minV || 1;
const yMin = minV - rangeRaw * 0.12;
const yMax = maxV + rangeRaw * 0.12;
const yRange = yMax - yMin || 1;

function xOf(i: number): number {
  return PAD_L + (i / (series.length - 1)) * plotW;
}
function yOf(v: number): number {
  return PAD_T + (1 - (v - yMin) / yRange) * plotH;
}

const pts = series.map((v, i) => `${xOf(i).toFixed(2)},${yOf(v).toFixed(2)}`);
const linePath = "M " + pts.join(" L ");

function fmtTick(v: number): string {
  const a = Math.abs(v);
  if (a >= 100) return v.toFixed(0);
  if (a >= 10) return v.toFixed(1);
  return v.toFixed(2);
}
const ticks = [yMin, (yMin + yMax) / 2, yMax].map((v) => ({
  v,
  y: yOf(v),
  label: fmtTick(v),
}));

const lastX = xOf(series.length - 1);
const lastY = yOf(series[series.length - 1] as number);

const zeroInRange = yMin < 0 && yMax > 0;
const zeroY = zeroInRange ? yOf(0) : null;

const deltaClass = (d: "pos" | "neg" | "neutral") =>
  d === "pos" ? "atx-panel__delta--pos"
  : d === "neg" ? "atx-panel__delta--neg"
  : "atx-panel__delta--neutral";

const allPrints = section.prints;
---
<article
  class="atx-panel"
  id={`panel-${section.slug}`}
  aria-labelledby={`panel-${section.slug}-h`}
>
  <header class="atx-panel__head">
    <div class="atx-panel__head-left">
      <p class="atx-panel__plate">
        <span class="atx-panel__plate-word">Plate</span>
        <span class="atx-panel__plate-num">{plate}</span>
      </p>
      <h2 id={`panel-${section.slug}-h`} class="atx-panel__h">
        <a class="atx-panel__h-link" href={`/${section.slug}/`}>{section.label}</a>
      </h2>
    </div>
    <p class="atx-panel__cadence">{section.cadence}</p>
  </header>

  <p class="atx-panel__question">{section.headlineQuestion}</p>

  <div class="atx-panel__body">
    <figure class="atx-panel__fig-wrap">
      <svg
        class="atx-panel__svg"
        viewBox={`0 0 ${W} ${H}`}
        role="img"
        aria-label={`${loadBearing.indicator}. Latest: ${loadBearing.value} (${loadBearing.asOf}). Change: ${loadBearing.delta}.`}
      >
        <rect
          x={PAD_L}
          y={PAD_T}
          width={plotW}
          height={plotH}
          fill="#FBF7EC"
          stroke="#C9C0A8"
          stroke-width="0.5"
        />
        {ticks.map((t) => (
          <>
            <line
              x1={PAD_L}
              x2={PAD_L + plotW}
              y1={t.y}
              y2={t.y}
              stroke="#C9C0A8"
              stroke-width="0.4"
              stroke-dasharray="1.5 2.5"
            />
            <text
              x={PAD_L - 4}
              y={t.y}
              text-anchor="end"
              dominant-baseline="middle"
              font-family="Cutive Mono, ui-monospace, monospace"
              font-size="8"
              fill="#6B5F3E"
            >
              {t.label}
            </text>
          </>
        ))}
        {zeroY !== null && (
          <line
            x1={PAD_L}
            x2={PAD_L + plotW}
            y1={zeroY}
            y2={zeroY}
            stroke="#6B5F3E"
            stroke-width="0.5"
          />
        )}
        <path
          d={linePath}
          fill="none"
          stroke="#3C4D2A"
          stroke-width="1.5"
          stroke-linejoin="round"
          stroke-linecap="round"
        />
        <circle cx={lastX} cy={lastY} r="2.6" fill="#A6493F" stroke="#F8F4E8" stroke-width="0.7" />
        <line
          x1={PAD_L}
          x2={PAD_L + plotW}
          y1={PAD_T + plotH}
          y2={PAD_T + plotH}
          stroke="#1A1612"
          stroke-width="0.6"
        />
        <text
          x={PAD_L}
          y={H - 5}
          text-anchor="start"
          font-family="Cutive Mono, ui-monospace, monospace"
          font-size="8"
          fill="#6B5F3E"
        >
          earliest
        </text>
        <text
          x={PAD_L + plotW}
          y={H - 5}
          text-anchor="end"
          font-family="Cutive Mono, ui-monospace, monospace"
          font-size="8"
          fill="#6B5F3E"
        >
          {loadBearing.asOf}
        </text>
      </svg>
      <figcaption class="atx-panel__cap">
        <span class="atx-panel__cap-mark">Fig. {figureNum}.</span>
        {loadBearing.indicator}, recent history.
        Last observation marked.
      </figcaption>
    </figure>

    <aside class="atx-panel__readout" aria-label="Headline reading">
      <p class="atx-panel__readout-k">{loadBearing.indicator}</p>
      <p class="atx-panel__readout-v">
        <span class="atx-panel__readout-num">{loadBearing.value}</span>
      </p>
      <p class="atx-panel__readout-meta">
        <span class:list={["atx-panel__delta", deltaClass(loadBearing.deltaDir)]}>{loadBearing.delta}</span>
        <span class="atx-panel__readout-asof">{loadBearing.asOf}</span>
      </p>
      {section.blurb.body && (
        <p class="atx-panel__note">
          {section.blurb.body}
        </p>
      )}
    </aside>
  </div>

  <table class="atx-panel__table" aria-label={`${section.label} indicators table`}>
    <thead>
      <tr>
        <th scope="col" class="atx-panel__th atx-panel__th--ind">Indicator</th>
        <th scope="col" class="atx-panel__th atx-panel__th--val">Value</th>
        <th scope="col" class="atx-panel__th atx-panel__th--delta">Change</th>
        <th scope="col" class="atx-panel__th atx-panel__th--asof">As of</th>
      </tr>
    </thead>
    <tbody>
      {allPrints.map((p) => (
        <tr class={p === loadBearing ? "atx-panel__tr atx-panel__tr--primary" : "atx-panel__tr"}>
          <td class="atx-panel__td atx-panel__td--ind">{p.indicator}</td>
          <td class="atx-panel__td atx-panel__td--val">{p.value}</td>
          <td class:list={["atx-panel__td", "atx-panel__td--delta", deltaClass(p.deltaDir)]}>{p.delta}</td>
          <td class="atx-panel__td atx-panel__td--asof">{p.asOf}</td>
        </tr>
      ))}
    </tbody>
  </table>
</article>

<style>
  .atx-panel {
    background: var(--atx-panel);
    border: 0.5px solid var(--atx-rule);
    border-top: 2px solid var(--atx-forest);
    padding: 16px 20px 14px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-height: 100%;
    position: relative;
    z-index: 2;
  }

  .atx-panel__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    border-bottom: 0.5px solid var(--atx-rule);
    padding-bottom: 9px;
  }
  .atx-panel__head-left { min-width: 0; }
  .atx-panel__plate {
    margin: 0;
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    font-family: var(--atx-mono);
    font-size: 10px;
    line-height: 1;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--atx-ink-soft);
  }
  .atx-panel__plate-word {
    color: var(--atx-ink-soft);
  }
  .atx-panel__plate-num {
    color: var(--atx-brick);
    font-weight: 500;
    letter-spacing: 0.12em;
  }
  .atx-panel__h {
    margin: 6px 0 0;
    font-family: var(--atx-display);
    font-weight: 700;
    font-size: 22px;
    line-height: 1.05;
    letter-spacing: 0.04em;
    color: var(--atx-ink);
    font-variant: small-caps;
    text-transform: lowercase;
  }
  .atx-panel__h-link {
    color: inherit;
    text-decoration: none;
    border-bottom: 0.5px solid transparent;
    transition: color 100ms linear, border-color 100ms linear;
  }
  .atx-panel__h-link:hover {
    color: var(--atx-forest);
    border-bottom-color: var(--atx-forest);
  }
  .atx-panel__h-link:focus-visible {
    outline: 2px solid var(--atx-ochre);
    outline-offset: 3px;
  }
  .atx-panel__cadence {
    margin: 0;
    font-family: var(--atx-mono);
    font-size: 10px;
    line-height: 1;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--atx-ink-soft);
    white-space: nowrap;
  }

  .atx-panel__question {
    margin: 0;
    font-family: var(--atx-display);
    font-style: italic;
    font-weight: 500;
    font-size: 14px;
    line-height: 1.4;
    color: var(--atx-ink);
    max-width: 56ch;
  }

  .atx-panel__body {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
  }
  @media (min-width: 600px) {
    .atx-panel__body {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: 18px;
      align-items: start;
    }
  }

  .atx-panel__fig-wrap {
    margin: 0;
    min-width: 0;
  }
  .atx-panel__svg {
    width: 100%;
    height: auto;
    display: block;
  }
  .atx-panel__cap {
    margin: 5px 0 0;
    font-family: var(--atx-body);
    font-weight: 300;
    font-size: 11px;
    line-height: 1.45;
    color: var(--atx-ink-soft);
  }
  .atx-panel__cap-mark {
    font-style: italic;
    font-family: var(--atx-display);
    font-weight: 600;
    color: var(--atx-ink);
    margin-right: 3px;
  }

  .atx-panel__readout {
    min-width: 0;
    padding-left: 0;
  }
  @media (min-width: 600px) {
    .atx-panel__readout {
      border-left: 0.5px solid var(--atx-rule);
      padding-left: 14px;
    }
  }
  .atx-panel__readout-k {
    margin: 0;
    font-family: var(--atx-display);
    font-style: italic;
    font-weight: 500;
    font-size: 12.5px;
    line-height: 1.2;
    color: var(--atx-ink-soft);
  }
  .atx-panel__readout-v {
    margin: 5px 0 0;
    line-height: 1;
  }
  .atx-panel__readout-num {
    font-family: var(--atx-mono);
    font-weight: 500;
    font-size: 30px;
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--atx-forest);
    font-variant-numeric: tabular-nums;
  }
  .atx-panel__readout-meta {
    margin: 7px 0 0;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    font-family: var(--atx-mono);
    font-size: 11px;
    line-height: 1;
    letter-spacing: 0.02em;
  }
  .atx-panel__readout-asof {
    color: var(--atx-ink-soft);
    text-transform: uppercase;
    font-size: 10px;
    letter-spacing: 0.1em;
  }
  .atx-panel__note {
    margin: 12px 0 0;
    font-family: var(--atx-body);
    font-weight: 400;
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--atx-ink);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    max-width: 44ch;
  }

  .atx-panel__delta {
    font-variant-numeric: tabular-nums;
    font-weight: 500;
  }
  .atx-panel__delta--pos { color: var(--atx-forest); }
  .atx-panel__delta--neg { color: var(--atx-brick); }
  .atx-panel__delta--neutral { color: var(--atx-ink-soft); }

  .atx-panel__table {
    width: 100%;
    border-collapse: collapse;
    margin: 0;
    font-family: var(--atx-mono);
    font-size: 11px;
    line-height: 1.4;
    font-variant-numeric: tabular-nums;
    color: var(--atx-ink);
    border-top: 1px solid var(--atx-forest);
  }
  .atx-panel__th {
    text-align: left;
    font-weight: 500;
    font-size: 9.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--atx-ink-soft);
    padding: 6px 6px 5px 0;
    border-bottom: 0.5px solid var(--atx-rule);
  }
  .atx-panel__th--val,
  .atx-panel__th--delta,
  .atx-panel__th--asof {
    text-align: right;
    padding-right: 0;
    padding-left: 6px;
  }
  .atx-panel__td {
    padding: 5px 6px 5px 0;
    border-bottom: 0.3px dotted var(--atx-rule);
  }
  .atx-panel__tr:last-child .atx-panel__td {
    border-bottom: 0;
  }
  .atx-panel__td--ind {
    font-family: var(--atx-body);
    font-weight: 400;
    color: var(--atx-ink);
  }
  .atx-panel__td--val,
  .atx-panel__td--delta,
  .atx-panel__td--asof {
    text-align: right;
    padding-right: 0;
    padding-left: 6px;
  }
  .atx-panel__td--asof {
    color: var(--atx-ink-soft);
    text-transform: uppercase;
    font-size: 9.5px;
    letter-spacing: 0.08em;
  }
  .atx-panel__tr--primary .atx-panel__td--ind {
    color: var(--atx-forest);
    font-weight: 600;
  }
  .atx-panel__tr--primary .atx-panel__td--val {
    font-weight: 500;
    color: var(--atx-ink);
  }
</style>
