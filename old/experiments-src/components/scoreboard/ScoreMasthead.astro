---
/*
 * ScoreMasthead - Lane K (Stadium Scoreboard).
 *
 * The top "ARENA" frame: HOME / AWAY-style team rail above an LED
 * readout title block. Centre Bell, ACC, and Wrigley scoreboard energy
 * reinterpreted as a research-publication masthead. The LIVE PERIOD
 * clock counts toward the next release; the away "team" is the figure
 * Canada's macro is up against this week (consensus, target, prior).
 */

interface Props {
  /** Today's date stamp, all-caps. */
  editionDate: string;
  /** Period banner label, e.g. "PERIOD 2 - MID-MONTH". */
  periodBanner: string;
  /** Period sub-label, smaller, e.g. "May 2026 release window". */
  periodSubLabel: string;
  /** Game-clock string toward next release, e.g. "10 D : 14 H : 22 M". */
  clockText: string;
  /** Next release label, e.g. "CPI APR 2026". */
  nextLabel: string;
}

const {
  editionDate,
  periodBanner,
  periodSubLabel,
  clockText,
  nextLabel,
} = Astro.props;
---
<header class="sb-mast" role="banner">

  {/* Team rail: HOME = Canadian Macro, AWAY = This week's benchmark. */}
  <div class="sb-mast__teams" aria-label="Scoreboard teams">
    <div class="sb-mast__team sb-mast__team--home">
      <span class="sb-mast__team-side">HOME</span>
      <span class="sb-mast__team-name">CANADIAN MACRO</span>
      <span class="sb-mast__team-loc">/ STATS CAN / BANK OF CANADA</span>
    </div>
    <div class="sb-mast__vs" aria-hidden="true">VS</div>
    <div class="sb-mast__team sb-mast__team--away">
      <span class="sb-mast__team-side">AWAY</span>
      <span class="sb-mast__team-name">CONSENSUS &amp; TARGET</span>
      <span class="sb-mast__team-loc">/ STREET / 2.0% TARGET</span>
    </div>
  </div>

  {/* The LED-style wordmark + LIVE light. */}
  <div class="sb-mast__board">
    <div class="sb-mast__title-row">
      <h1 class="sb-mast__title">
        <span class="sb-mast__title-line sb-mast__title-line--lg">MACRO RESEARCH DEPARTMENT</span>
        <span class="sb-mast__title-line sb-mast__title-line--sm">CANADIAN ECONOMY <span class="sb-mast__title-pulse">LIVE</span></span>
      </h1>
      <div class="sb-mast__live" aria-label="Live broadcast indicator">
        <span class="sb-mast__live-dot" aria-hidden="true"></span>
        <span class="sb-mast__live-text">ON AIR</span>
      </div>
    </div>

    {/* Bottom strip: PERIOD banner left, GAME CLOCK right. */}
    <div class="sb-mast__strip">
      <div class="sb-mast__period">
        <span class="sb-mast__period-k">PERIOD</span>
        <span class="sb-mast__period-v">{periodBanner}</span>
        <span class="sb-mast__period-sub">{periodSubLabel}</span>
      </div>
      <div class="sb-mast__clock" aria-label={`Game clock toward ${nextLabel}`}>
        <span class="sb-mast__clock-k">TIME TO NEXT WHISTLE</span>
        <span class="sb-mast__clock-v">{clockText}</span>
        <span class="sb-mast__clock-sub">/ {nextLabel}</span>
      </div>
    </div>

    {/* Edition stamp - small, like a broadcast lower-third. */}
    <div class="sb-mast__edition">
      <span class="sb-mast__edition-k">BROADCAST</span>
      <span class="sb-mast__edition-v">{editionDate}</span>
      <span class="sb-mast__edition-sep" aria-hidden="true">|</span>
      <span class="sb-mast__edition-k">CHANNEL</span>
      <span class="sb-mast__edition-v">MRD-7</span>
      <span class="sb-mast__edition-sep" aria-hidden="true">|</span>
      <span class="sb-mast__edition-k">LANE</span>
      <span class="sb-mast__edition-v">K / SCOREBOARD</span>
    </div>
  </div>
</header>

<style>
  .sb-mast {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  /* ---- Team rail ---- */
  .sb-mast__teams {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 14px 20px;
    padding: 12px 18px;
    background: var(--sb-panel);
    border: 1px solid var(--sb-bezel);
    border-radius: 4px;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.04),
      inset 0 -1px 0 rgba(0, 0, 0, 0.5);
  }

  .sb-mast__team {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: 6px 14px;
    min-width: 0;
  }
  .sb-mast__team--away {
    grid-template-columns: auto 1fr auto;
    text-align: right;
  }
  .sb-mast__team--away .sb-mast__team-side {
    order: 3;
  }
  .sb-mast__team--away .sb-mast__team-name {
    order: 1;
    text-align: right;
  }
  .sb-mast__team--away .sb-mast__team-loc {
    order: 2;
    text-align: right;
  }

  .sb-mast__team-side {
    font-family: var(--sb-font-label);
    font-size: 14px;
    letter-spacing: 0.14em;
    color: var(--sb-amber);
    text-shadow: 0 0 6px rgba(244, 180, 0, 0.35);
  }
  .sb-mast__team--away .sb-mast__team-side { color: var(--sb-red); text-shadow: 0 0 6px rgba(224, 22, 43, 0.4); }

  .sb-mast__team-name {
    font-family: var(--sb-font-label);
    font-size: clamp(18px, 2.4vw, 26px);
    letter-spacing: 0.10em;
    color: var(--sb-white);
    text-shadow: 0 0 6px rgba(245, 248, 255, 0.25);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sb-mast__team-loc {
    font-family: var(--sb-font-mono);
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--sb-ink-faint);
  }

  .sb-mast__vs {
    font-family: var(--sb-font-display);
    font-size: clamp(22px, 3vw, 32px);
    color: var(--sb-red);
    letter-spacing: 0.06em;
    padding: 0 6px;
    text-shadow:
      0 0 10px rgba(224, 22, 43, 0.55),
      0 0 22px rgba(224, 22, 43, 0.35);
  }

  /* ---- Board frame ---- */
  .sb-mast__board {
    position: relative;
    border: 1px solid var(--sb-bezel);
    background:
      linear-gradient(180deg, rgba(245, 248, 255, 0.02) 0%, transparent 30%),
      var(--sb-panel-2);
    border-radius: 4px;
    padding: clamp(16px, 2.4vw, 26px) clamp(18px, 2.6vw, 32px);
    box-shadow:
      inset 0 0 0 1px rgba(63, 191, 232, 0.08),
      inset 0 0 60px rgba(8, 21, 42, 0.6),
      0 0 0 1px rgba(0, 0, 0, 0.4);
  }

  /* Light bulbs around the bezel - decorative. */
  .sb-mast__board::before,
  .sb-mast__board::after {
    content: "";
    position: absolute;
    left: 14px;
    right: 14px;
    height: 6px;
    background-image: radial-gradient(circle, var(--sb-amber) 0 1.6px, transparent 2px);
    background-size: 22px 6px;
    background-repeat: repeat-x;
    opacity: 0.45;
    pointer-events: none;
  }
  .sb-mast__board::before { top: 7px; }
  .sb-mast__board::after  { bottom: 7px; }

  .sb-mast__title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px 26px;
    flex-wrap: wrap;
  }

  .sb-mast__title {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-family: var(--sb-font-display);
    font-weight: 400;
    line-height: 0.95;
    color: var(--sb-led-amber);
  }

  .sb-mast__title-line {
    display: block;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .sb-mast__title-line--lg {
    font-size: clamp(28px, 4.6vw, 54px);
    color: var(--sb-led-amber);
    text-shadow:
      0 0 4px rgba(244, 180, 0, 0.55),
      0 0 14px rgba(244, 180, 0, 0.35),
      0 0 30px rgba(244, 180, 0, 0.18);
    animation: sb-flicker 5.4s steps(40) infinite;
  }

  .sb-mast__title-line--sm {
    font-family: var(--sb-font-label);
    font-size: clamp(14px, 1.4vw, 18px);
    letter-spacing: 0.22em;
    color: var(--sb-ink-muted);
  }

  .sb-mast__title-pulse {
    color: var(--sb-red);
    text-shadow:
      0 0 6px rgba(224, 22, 43, 0.6),
      0 0 18px rgba(224, 22, 43, 0.35);
    animation: sb-pulse 1.8s ease-in-out infinite;
  }

  .sb-mast__live {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 9px 14px;
    border: 1px solid var(--sb-red);
    background: rgba(224, 22, 43, 0.10);
    font-family: var(--sb-font-label);
    font-size: 15px;
    letter-spacing: 0.20em;
    color: var(--sb-red);
    text-transform: uppercase;
    text-shadow: 0 0 8px rgba(224, 22, 43, 0.55);
    box-shadow:
      0 0 10px rgba(224, 22, 43, 0.3),
      inset 0 0 14px rgba(224, 22, 43, 0.18);
    animation: sb-onair 2.4s ease-in-out infinite;
  }

  .sb-mast__live-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--sb-red);
    box-shadow:
      0 0 8px var(--sb-red),
      0 0 16px rgba(224, 22, 43, 0.55);
  }

  /* ---- PERIOD + CLOCK strip ---- */
  .sb-mast__strip {
    margin-top: 22px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px 22px;
    align-items: end;
    padding-top: 18px;
    border-top: 1px dashed rgba(63, 191, 232, 0.22);
  }
  @media (max-width: 720px) {
    .sb-mast__strip { grid-template-columns: 1fr; }
  }

  .sb-mast__period,
  .sb-mast__clock {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .sb-mast__clock { text-align: right; align-items: flex-end; }
  @media (max-width: 720px) {
    .sb-mast__clock { text-align: left; align-items: flex-start; }
  }

  .sb-mast__period-k,
  .sb-mast__clock-k {
    font-family: var(--sb-font-label);
    font-size: 12px;
    letter-spacing: 0.22em;
    color: var(--sb-ice);
    text-shadow: 0 0 6px rgba(63, 191, 232, 0.35);
  }

  .sb-mast__period-v {
    font-family: var(--sb-font-display);
    font-size: clamp(26px, 3.4vw, 40px);
    color: var(--sb-led-amber);
    letter-spacing: 0.04em;
    text-shadow:
      0 0 4px rgba(244, 180, 0, 0.55),
      0 0 14px rgba(244, 180, 0, 0.32);
  }

  .sb-mast__period-sub {
    font-family: var(--sb-font-mono);
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--sb-ink-faint);
  }

  .sb-mast__clock-v {
    font-family: var(--sb-font-display);
    font-size: clamp(26px, 3.4vw, 40px);
    color: var(--sb-led-green);
    letter-spacing: 0.04em;
    font-feature-settings: "tnum", "lnum";
    text-shadow:
      0 0 4px rgba(59, 191, 101, 0.55),
      0 0 14px rgba(59, 191, 101, 0.32);
    animation: sb-flicker 6.2s steps(40) infinite 0.7s;
  }

  .sb-mast__clock-sub {
    font-family: var(--sb-font-mono);
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--sb-ink-faint);
  }

  /* ---- Edition strip ---- */
  .sb-mast__edition {
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid rgba(63, 191, 232, 0.14);
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    align-items: baseline;
    font-family: var(--sb-font-mono);
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--sb-ink-muted);
  }
  .sb-mast__edition-k {
    color: var(--sb-ice);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-size: 11px;
    text-shadow: 0 0 5px rgba(63, 191, 232, 0.3);
  }
  .sb-mast__edition-v {
    color: var(--sb-white);
    font-feature-settings: "tnum", "lnum";
  }
  .sb-mast__edition-sep {
    color: var(--sb-ink-faint);
  }

  /* ---- Animations ---- */
  @keyframes sb-flicker {
    0%, 100% { opacity: 1; }
    3%       { opacity: 0.86; }
    6%       { opacity: 1; }
    42%      { opacity: 0.94; }
    44%      { opacity: 1; }
    70%      { opacity: 0.9; }
    72%      { opacity: 1; }
  }
  @keyframes sb-pulse {
    0%, 100% { opacity: 1; text-shadow: 0 0 6px rgba(224, 22, 43, 0.6), 0 0 18px rgba(224, 22, 43, 0.35); }
    50%      { opacity: 0.7; text-shadow: 0 0 4px rgba(224, 22, 43, 0.35); }
  }
  @keyframes sb-onair {
    0%, 100% { box-shadow: 0 0 10px rgba(224, 22, 43, 0.3), inset 0 0 14px rgba(224, 22, 43, 0.18); }
    50%      { box-shadow: 0 0 22px rgba(224, 22, 43, 0.6), inset 0 0 20px rgba(224, 22, 43, 0.32); }
  }

  @media (prefers-reduced-motion: reduce) {
    .sb-mast__title-line--lg,
    .sb-mast__clock-v,
    .sb-mast__title-pulse,
    .sb-mast__live { animation: none; }
  }

  @media (max-width: 720px) {
    .sb-mast__teams {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .sb-mast__vs { display: none; }
    .sb-mast__team--away { text-align: left; }
    .sb-mast__team--away .sb-mast__team-name,
    .sb-mast__team--away .sb-mast__team-loc { text-align: left; }
  }
</style>
