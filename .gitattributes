# Normalize line endings across the repo. Files committed as LF, checked
# out in the platform's native style. Kills CRLF warnings on Windows
# without breaking POSIX tooling.
* text=auto eol=lf

# Binary file types — never apply EOL conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg text eol=lf
*.ico binary
*.zip binary
*.pdf binary
*.woff binary
*.woff2 binary

# Lockfiles + JSON snapshots: explicit LF so cross-platform diffs stay clean.
package-lock.json text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# CSV data — LF for reproducible diffs across the pipeline.
*.csv text eol=lf
