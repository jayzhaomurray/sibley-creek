# ---------- Node / Astro ----------
node_modules/
dist/
.astro/
.output/
.vercel/
.netlify/
.cache/

# Astro env
.env
.env.local
.env.*.local

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/
build/
.tox/

# ---------- Data ----------
# Track processed (small) outputs but ignore the raw cache by default.
# If raw files are small and reproducible, the team can selectively `git add -f`.
data/raw/*
!data/raw/.gitkeep

# Pipeline cache and logs
pipeline/.cache/
pipeline/logs/
*.log

# ---------- OS ----------
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
.AppleDouble
.LSOverride

# ---------- Editors ----------
.vscode/
.idea/
*.swp
*.swo
*~
.history/

# ---------- Visual regression (Playwright) ----------
# Baselines under tests/visual/__snapshots__/ ARE committed (binary, gated
# by .gitattributes). Everything else Playwright writes is ephemeral.
tests/visual/.test-results/
tests/visual/.playwright-report/
# Fixture-overlay rollback copy. Lives OUTSIDE .test-results/ so Playwright's
# outputDir sweep doesn't wipe it before tests start (see fixture-utils.mjs).
tests/visual/.fixture-backup/
playwright-report/
test-results/

# ---------- Misc ----------
*.tmp
*.bak
*.orig
