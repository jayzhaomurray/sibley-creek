{
  "name": "macro-research-department",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check_sections_slug_alignment.mjs && node scripts/check_raw_tracked.mjs && node scripts/check_panel_data_integrity.mjs && node scripts/check_panel_data_wired.mjs && node scripts/test_prose_renderer.mjs && node scripts/check_mechanical_tilelines.mjs && node scripts/check_chart_tooltips.mjs && node scripts/check_prose_vintage.mjs --strict && node scripts/source_audit.mjs && node scripts/orphan_cleanup.mjs && node scripts/check_citation_coverage.mjs && astro check && astro build && node scripts/strip_dev_routes.mjs && node scripts/check_tk_in_dist.mjs && node scripts/check_reader_copy_leakage.mjs",
    "audit:integrity": "node scripts/check_panel_data_integrity.mjs",
    "audit:prose-vintage": "node scripts/check_prose_vintage.mjs",
    "audit:tilelines": "node scripts/check_mechanical_tilelines.mjs",
    "audit:chart-tooltips": "node scripts/check_chart_tooltips.mjs",
    "test:prose": "node scripts/test_prose_renderer.mjs",
    "render:prose": "node scripts/render_prose.mjs",
    "audit:wired": "node scripts/check_panel_data_wired.mjs",
    "audit:raw-tracked": "node scripts/check_raw_tracked.mjs",
    "audit:orphans": "node scripts/check_orphan_panels.mjs",
    "approve-claim": "node scripts/approve_claim.mjs",
    "reject-claim": "node scripts/reject_claim.mjs",
    "build:fast": "astro build",
    "build:full": "python -m pipeline.build && astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "test:visual": "node tests/visual/run-visual.mjs",
    "test:visual:update": "node tests/visual/run-visual.mjs --update-snapshots",
    "test:visual:debug": "node tests/visual/run-visual.mjs --ui",
    "test:visual:freeze": "node tests/visual/fixture-utils.mjs freeze",
    "test:visual:restore": "node tests/visual/fixture-utils.mjs restore",
    "audit": "node scripts/audit_pass.mjs",
    "audit-diff": "node scripts/audit_diff.mjs",
    "cross-audit": "node scripts/cross_audit.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.2",
    "astro": "^6.3.1",
    "rss-parser": "^3.13.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@playwright/test": "^1.49.0",
    "typescript": "^6.0.3"
  }
