{
  "name": "macro-research-department",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/source_audit.mjs && node scripts/orphan_cleanup.mjs && node scripts/check_citation_coverage.mjs && astro check && astro build",
    "approve-claim": "node scripts/approve_claim.mjs",
    "reject-claim": "node scripts/reject_claim.mjs",
    "build:fast": "astro build",
    "build:full": "python -m pipeline.build && astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "test:visual": "node tests/visual/run-visual.mjs",
    "test:visual:update": "node tests/visual/run-visual.mjs --update-snapshots",
    "test:visual:debug": "node tests/visual/run-visual.mjs --ui",
    "test:visual:freeze": "node tests/visual/fixture-utils.mjs freeze",
    "test:visual:restore": "node tests/visual/fixture-utils.mjs restore"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.2",
    "astro": "^6.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@playwright/test": "^1.49.0",
    "typescript": "^6.0.3"
  }
}
