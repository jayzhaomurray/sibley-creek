---
/*
 * HeroTile - the Layout-B homepage hero.
 *
 * Renders the section with the most-recent updatedAt timestamp as a wide
 * card that anchors the page. Carries the only editorial prose on the
 * homepage (blurb body + full headline question); the compact tiles in the
 * 6-grid below are stripped to dashboard cells (see CompactTile).
 *
 * Per art-director fixes F4(a) + F5 + F6 + F10 (2026-05-11) plus
 * re-eval item 3 (2026-05-11):
 *
 *   Re-eval 3. The hero eyebrow rail used to read
 *       "{SECTION} | MOST RECENT UPDATE". "MOST RECENT UPDATE" is refresh-
 *       light metadata, not content. Replaced with a content-noun pattern
 *       "{SECTION} | {HERO KICKER}" where heroKicker names the specific
 *       release or event in view (e.g. APRIL CPI, APRIL RATE DECISION).
 *       Source string lives on the Section record (data-driven; backend
 *       can keep it current as new prints land).
 *
 *
 *   F4 option (a). Section accents are removed from homepage tile chrome.
 *       The top rule is a 1px `rule` line (was a 3px accent bar), the
 *       eyebrow section label is `ink-muted` (was the section accent), the
 *       big section-name heading is `ink` (was the accent). The publication
 *       no longer hands the visitor seven different colors at first read.
 *       Per-section pages still use the accent for wayfinding. The hover
 *       affordance pinned to the name now uses `ink-muted` so we keep the
 *       link feedback without re-introducing the accent.
 *
 *   F5 (hierarchy fix). The section name used to be the visual anchor
 *       (display-lg serif in accent). It was a category label, not a
 *       headline -- pretending it was a headline made the headline question
 *       look like a subhead. Reversed: the headline question is now the
 *       anchor at display-md italic serif (the editorial line the reader is
 *       actually being asked to consider), and the section name drops to
 *       display-sm.
 *
 *   F6 (numerics to Inter). The big-number callout used to be set in serif
 *       at display-md. Switched to sans (Inter) at display-sm weight 600
 *       with tabular figures. Reasoning: serif numerics fight chart
 *       numerics, and the callout is a data point, not editorial. The
 *       compact tiles below match (see CompactTile).
 *
 *   F10. Because F4 option (a) drops accents entirely, F10 (only-one-accent
 *       -treatment-per-tile) falls out -- there are no accents on the tile
 *       to count.
 *
 * Props:
 *   section  - the Section record (already selected as the hero by the
 *              page; this component does not pick).
 *
 * Layout discipline (unchanged from R1):
 *   - The hero is a CSS container (container-type: inline-size).
 *   - At <480px the hero stacks single-column.
 *   - At 480-720px the editorial header spans, with callout+chart below.
 *   - At >=720px the chart pins right and editorial fills the left column.
 */

import type { Section, SectionPrint } from "../data/sections";
import HeroChart from "./charts/HeroChart.astro";

interface Props {
  section: Section;
}

const { section } = Astro.props;

const tileLabel = section.tileLabel ?? section.label;
const href = `/${section.slug}/`;

// Pick the load-bearing print. `chartSeriesKey` matches a print's `key`;
// fall back to prints[0] so v1 data without keys still renders.
const heroPrint =
  section.prints.find((p: SectionPrint) => p.key && p.key === section.chartSeriesKey)
    ?? section.prints[0];

const blurb = section.blurb;
const showBlurb = blurb.kind !== "none" && blurb.body;
const isFresh = blurb.kind === "fresh";

// Art-director re-eval (2026-05-11) item 3: hero eyebrow now reads
// "SECTION | KICKER" where the kicker names a specific release / event,
// not refresh-light metadata. Falls back to the section's cadence string
// if a section has no heroKicker (defensive; v1 sets it on every section).
// CSS uppercases on render so the source string can be sentence-case for
// future bilingual variants.
const heroKicker = section.heroKicker ?? section.cadence;
---
<a
  class="hero"
  href={href}
  aria-label={`Hero: ${tileLabel} section`}
>
  <div class="hero__top-rule" aria-hidden="true"></div>

  <div class="hero__grid">
    {/* Editorial header. Path C reversal (2026-05-11): the italic-serif
     * `headlineQuestion` paragraph is dropped from the hero per user
     * direction. The hero is now eyebrow + callout + event note + chart.
     * Path C cut 1 already removed the big serif section-name h2 (the
     * eyebrow carries that). With the question gone too, the hero's
     * editorial weight shifts entirely to the callout + event note pair.
     * The headline question continues to live on the section page; the
     * homepage no longer asks the question, it just shows the print.
     *
     * Height impact: dropping the display-md italic question removes
     * roughly 80-120px from the hero column; combined with the tile
     * trims (editorial line + surprise verb gone) the two columns now
     * land much closer in natural height, so `align-items: stretch` on
     * `.home__compose` ends with minimal residual air. */}
    <div class="hero__head">
      <p class="hero__eyebrow">
        <span class="hero__eyebrow-label">{tileLabel}</span>
        <span class="hero__eyebrow-sep" aria-hidden="true">|</span>
        <span class="hero__eyebrow-kicker">{heroKicker}</span>
      </p>
    </div>

    {/* Left editorial column: big-number callout + event-note blurb. */}
    <div class="hero__editorial">
      {heroPrint && (
        <div class="hero__callout">
          <p class="hero__callout-value">{heroPrint.value}</p>
          <p class="hero__callout-unit">
            <span class="hero__callout-indicator">{heroPrint.indicator}</span>
            <span class="hero__callout-sep" aria-hidden="true">.</span>
            <span class="hero__callout-asof">{heroPrint.asOf}</span>
            <span class:list={["hero__callout-delta", `hero__callout-delta--${heroPrint.deltaDir}`]}>
              {heroPrint.delta}
            </span>
          </p>
        </div>
      )}

      {showBlurb && (
        <div class:list={["hero__note", { "hero__note--fresh": isFresh, "hero__note--last": !isFresh }]}>
          <p class="hero__note-kicker">
            {isFresh ? "Event note" : "Last event note"}
            {blurb.date ? ` - ${blurb.date}` : ""}
          </p>
          <p class="hero__note-body">{blurb.body}</p>
        </div>
      )}
    </div>

    {/*
     * Chart slot. 280x140 floor from the Layout-B mockup; chart-builder
     * hydrates the HeroChart.astro slot.
     */}
    <div class="hero__chart-col">
      <div class="hero__chart" data-chart-key={section.chartSeriesKey ?? ""}>
        <HeroChart section={section} />
      </div>
    </div>
  </div>
</a>

<style>
  .hero {
    display: block;
    position: relative;
    background-color: var(--surface);
    border: 1px solid var(--rule);
    border-top: none; /* the top-rule replaces the card top border */
    border-radius: var(--radius-card);
    padding: var(--s-5) var(--s-6) var(--s-5);
    color: var(--ink);
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease-out);
    height: 100%;
    container-type: inline-size;
    container-name: hero;
  }

  .hero:hover {
    border-color: var(--ink-muted);
  }

  .hero:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  /* F4(a): top rule is a 1px `rule` line, monochrome. Was a 3px accent bar
   * on R1; the homepage no longer signals section identity through color. */
  .hero__top-rule {
    position: absolute;
    inset: -1px -1px auto -1px;
    height: 1px;
    background-color: var(--rule);
    border-top-left-radius: var(--radius-card);
    border-top-right-radius: var(--radius-card);
  }

  /* Internal layout uses named grid areas so we can flip the composition
   * by container width without restating the markup. */
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      "head"
      "editorial"
      "chart";
    gap: var(--s-4);
    margin-top: var(--s-3);
  }

  .hero__head     { grid-area: head; min-width: 0; }
  .hero__editorial { grid-area: editorial; min-width: 0;
                     display: flex; flex-direction: column; }
  .hero__chart-col { grid-area: chart; }

  @container hero (min-width: 480px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(220px, 300px);
      grid-template-areas:
        "head      head"
        "editorial chart";
      column-gap: var(--s-5);
      row-gap: var(--s-4);
    }
  }

  @container hero (min-width: 720px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(280px, 380px);
      grid-template-areas:
        "head      chart"
        "editorial chart";
      column-gap: var(--s-6);
      row-gap: var(--s-4);
    }
  }

  /* Eyebrow: section name + "Most recent update" rail. F4(a) drops the
   * accent color on the label; the whole rail reads in ink-muted / ink-faint
   * so the eyebrow is unmistakably a wayfinding label, not a brand bar. */
  .hero__eyebrow {
    font-family: var(--font-sans);
    font-size: var(--fs-label);
    line-height: var(--lh-label);
    font-weight: var(--fw-medium);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 var(--s-2);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-2);
  }

  .hero__eyebrow-label {
    color: var(--ink-muted);
    font-weight: var(--fw-semibold);
  }

  .hero__eyebrow-sep {
    color: var(--ink-faint);
  }

  /* Art-director re-eval (2026-05-11) item 3: was `.hero__eyebrow-most-recent`
   * — renamed to a content-noun class. The kicker now names a specific
   * release / event sourced from `section.heroKicker`. Visual treatment
   * unchanged: ink-faint micro-caps, paired with the section-name label
   * via a separator pipe. */
  .hero__eyebrow-kicker {
    color: var(--ink-faint);
  }

  /* Path C cut 1 (2026-05-11): `.hero__name` (the big serif section-name
   * h2) was dropped from the template — the eyebrow above already carries
   * the section name. Selectors and the hover affordance that targeted
   * `.hero__name` are removed.
   *
   * Path C reversal (2026-05-11): the italic-serif `.hero__question`
   * paragraph was also dropped from the template — the homepage hero no
   * longer carries the section's headline question (that voice now lives
   * exclusively on the section page). The related selector and its
   * `em` child rule are removed; nothing on the homepage renders an
   * italic-serif paragraph anymore. */

  /* Big-number callout. F6: serif -> sans (Inter) tabular at display-sm
   * weight 600. Echoes the compact tile values so the dashboard cells and
   * the hero callout speak the same numeric voice.
   *
   * Path C reversal (2026-05-11): with the headline-question paragraph
   * removed from the head block, the callout sits directly under the
   * eyebrow inside the editorial column. The `--s-3` top margin remains
   * adequate (eyebrow already supplies a `--s-2` bottom margin and the
   * grid row-gap separates head from editorial). */
  .hero__callout {
    margin-top: 0;
  }

  .hero__callout-value {
    font-family: var(--font-sans);
    font-size: var(--fs-display-sm);
    line-height: 1.05;
    font-weight: var(--fw-semibold);
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    font-feature-settings: "tnum";
    margin: 0;
  }

  .hero__callout-unit {
    font-family: var(--font-sans);
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body-sm);
    color: var(--ink-muted);
    margin: var(--s-1) 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-2);
  }

  .hero__callout-indicator {
    color: var(--ink);
    font-weight: var(--fw-medium);
  }

  .hero__callout-sep {
    color: var(--ink-faint);
  }

  .hero__callout-asof {
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }

  .hero__callout-delta {
    font-family: var(--font-mono);
    font-size: var(--fs-mono-xs);
    line-height: var(--lh-mono-xs);
    font-variant-numeric: tabular-nums;
    margin-left: auto;
  }

  .hero__callout-delta--pos { color: var(--pos); }
  .hero__callout-delta--neg { color: var(--neg); }
  .hero__callout-delta--neutral { color: var(--neutral); }

  /* Event note: stays. The hero is the only place editorial prose lives on
   * the homepage (compact tiles had their blurb body stripped, F3).
   *
   * Path C cuts 2 + 4 (2026-05-11): tightened both the gap above the note
   * (callout-to-event-note) and the internal top padding from --s-4 to
   * --s-3. Trims ~8px of vertical air without crowding the rule. */
  .hero__note {
    margin-top: var(--s-3);
    padding-top: var(--s-3);
    border-top: 1px solid var(--rule-faint);
  }

  .hero__note-kicker {
    font-family: var(--font-sans);
    font-size: var(--fs-label);
    line-height: var(--lh-label);
    font-weight: var(--fw-medium);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0;
  }

  /* F4(a): kicker no longer renders in the section accent. Fresh notes are
   * promoted to `ink` (still distinct from the muted last-note kicker) but
   * the color is now neutral. */
  .hero__note--fresh .hero__note-kicker {
    color: var(--ink);
  }

  .hero__note--last .hero__note-kicker {
    color: var(--ink-faint);
  }

  .hero__note-body {
    font-family: var(--font-sans);
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body-sm);
    font-weight: var(--fw-regular);
    margin: var(--s-2) 0 0;
  }

  .hero__note--fresh .hero__note-body {
    color: var(--ink);
  }

  .hero__note--last .hero__note-body {
    color: var(--ink-muted);
  }

  /* Chart column: reserved aspect-ratio at narrow widths; capped height
   * in the wide-hero layout.
   *
   * Path C cut 3 (2026-05-11): the hero chart used to stretch to fill the
   * column height (`height: 100%` at >=720px), which made the hero balloon
   * to ~820-880px tall on desktop. We now cap the chart at 240px on
   * wide layouts. The hero column lands ~720-740px tall, the tiles column
   * lands ~620-660px, and the residual ~80px gap at the bottom is the
   * acceptable cost of giving the chart a fixed editorial size rather
   * than a stretching one. */
  .hero__chart-col {
    display: flex;
    align-items: flex-start;
    min-width: 0;
  }

  .hero__chart {
    width: 100%;
    min-height: 140px;
    aspect-ratio: 2 / 1;
    background-color: var(--surface);
    display: flex;
    align-items: stretch;
    justify-content: stretch;
  }

  @container hero (min-width: 720px) {
    .hero__chart {
      /* Path C cut 3: fixed cap at 240px, was `height: 100%`. Aspect-ratio
       * still applies; the cap clamps tall-column overflow. */
      aspect-ratio: auto;
      height: 240px;
      max-height: 240px;
    }
  }

  /* Path C cut 1 (2026-05-11): the previous hover affordance underlined
   * `.hero__name` on tile hover. With the section-name h2 dropped from the
   * template, the hover signal is now carried by the card border darkening
   * to ink-muted (`.hero:hover` rule above) plus the focus-visible outline.
   * The headline question is the visual anchor; underlining a question
   * paragraph on hover would read as broken-link affordance. */
</style>
