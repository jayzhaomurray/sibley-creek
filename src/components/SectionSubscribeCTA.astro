---
/*
 * SectionSubscribeCTA — inline subscribe prompt for section pages and /overview/.
 *
 * Placed below the chartbook plate stack (SectionLayout) or below the
 * panel grid (overview.astro). Captures email with a minimal inline form,
 * source-tagged so the origin is traceable in formsubmit.co inbound.
 *
 * Visual register: quiet separator + restrained copy. Same form mechanics
 * as the splash inline form. Does NOT add friction beyond email — the
 * dedicated /subscribe/ page carries the fuller field set.
 *
 * Source tag: source=section_cta on all placements. The parent page can
 * pass a `source` prop to differentiate overview vs section pages if
 * finer tracking is needed later.
 */

interface Props {
  /** formsubmit.co source tag. Defaults to "section_cta". */
  source?: string;
}

const { source = "section_cta" } = Astro.props;
---

<section class="sec-sub" aria-label="Subscribe to Sibley Creek">
  <div class="sec-sub__inner">
    <p class="sec-sub__copy">Get Sibley Creek delivered weekly. Free.</p>
    <form
      class="sec-sub__form"
      action="https://formsubmit.co/ajax/jay@sibleycreek.ca"
      method="POST"
      data-formsubmit-ajax
      data-success-msg="Subscribed. Thanks — first issue lands when it lands."
    >
      <input type="hidden" name="_subject" value="Sibley subscriber (section CTA)" />
      <input type="hidden" name="source" value={source} />
      <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />
      <label for={`sec-sub-email-${source}`} class="sec-sub__label">Email address</label>
      <div class="sec-sub__row">
        <input
          id={`sec-sub-email-${source}`}
          name="email"
          class="sec-sub__input"
          type="email"
          placeholder="you@firm.ca"
          autocomplete="email"
          required
        />
        <button class="sec-sub__btn" type="submit">Subscribe &rarr;</button>
      </div>
    </form>
  </div>
</section>

<style>
  .sec-sub {
    border-top: 1px solid var(--ink);
    padding: 32px 0 40px;
    margin-top: 0;
  }

  .sec-sub__inner {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  @media (min-width: 640px) {
    .sec-sub__inner {
      flex-direction: row;
      align-items: center;
      gap: 32px;
    }
  }

  .sec-sub__copy {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--ink);
    margin: 0;
    white-space: nowrap;
    flex: 0 0 auto;
  }

  .sec-sub__form {
    flex: 1 1 auto;
    min-width: 0;
  }

  .sec-sub__label {
    /* Visually hidden; accessible to screen readers */
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .sec-sub__row {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  @media (min-width: 400px) {
    .sec-sub__row {
      flex-direction: row;
    }
  }

  .sec-sub__input {
    flex: 1;
    padding: 11px 13px;
    border: 1px solid var(--ink);
    font-family: var(--font-sans);
    font-size: 14px;
    background: var(--paper);
    color: var(--ink);
    min-width: 0;
  }
  .sec-sub__input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .sec-sub__btn {
    padding: 11px 22px;
    background: var(--ink);
    color: var(--paper);
    border: 1px solid var(--ink);
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
    white-space: nowrap;
    transition: background 80ms linear, color 80ms linear;
    flex: 0 0 auto;
  }
  .sec-sub__btn:hover {
    background: var(--paper);
    color: var(--ink);
  }
  .sec-sub__btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>
