---
/*
 * Panel6RecessionState - horizontal Gantt timeline of cycle states.
 *
 * Implements charts/gdp_basics/panel-6-recession-state.md (spec v0.1).
 *
 * Visual: single ~24px-tall horizontal track spanning ~20 years.
 * Recession periods rendered as rgba(21,23,26,0.12) rectangles (heavier
 * than the standard 6% chart-background tint, because here the band IS
 * the data). Expansion periods unfilled. Current expansion's right edge
 * is a 2px solid series-1 vertical bar + 4px dot. Date labels above each
 * recession band; "Expansion since 2020Q3" call-out above the current
 * marker.
 *
 * Spec calls for D3 + custom SVG. We hand-roll the SVG (no D3 dep).
 * Tractable: one time-scale, fixed y, rects and text.
 *
 * Data: hardcoded cycles for v0.1 (BCC has not yet been wired through
 * data/derived/cdhowe_bcc_cycles.json; backend builds that file).
 */

interface Cycle {
  state: "recession" | "expansion";
  start: string;        // ISO yyyy-mm-dd
  end: string | null;   // null = ongoing
  label?: string;
  current?: boolean;
}

interface Props {
  cycles?: Cycle[];
  /** "Today" anchor for current-state marker. ISO yyyy-mm-dd. */
  asOf?: string;
  /** BCC communique annotation. Owned by writer. */
  communiqueAnnotation?: string;
  ariaLabel?: string;
}

// Hardcoded BCC cycles per spec example (placeholder until JSON wires).
const DEFAULT_CYCLES: Cycle[] = [
  { state: "expansion",  start: "2003-04-01", end: "2008-09-30" },
  { state: "recession",  start: "2008-10-01", end: "2009-06-30", label: "2008-09" },
  { state: "expansion",  start: "2009-07-01", end: "2020-02-29" },
  { state: "recession",  start: "2020-03-01", end: "2020-06-30", label: "2020Q1-Q2" },
  { state: "expansion",  start: "2020-07-01", end: null, current: true },
];

const {
  cycles = DEFAULT_CYCLES,
  asOf = "2026-05-11",
  communiqueAnnotation = "C.D. Howe BCC, Mar 14, 2026: classification unchanged; expansion continues from 2020Q3.",
  ariaLabel = "Canadian business cycle state, 2005 to present, C.D. Howe BCC dating",
} = Astro.props;

// ---- Geometry --------------------------------------------------------------
const VB_W = 720;
const VB_H = 405; // 16:9 per spec
const M_L = 32;
const M_R = 32;
const M_T = 80; // room for recession labels above track
const M_B = 80; // room for axis + communique annotation
const PLOT_X0 = M_L;
const PLOT_W = VB_W - M_L - M_R;
const PLOT_X1 = PLOT_X0 + PLOT_W;

const TRACK_H = 24;
const TRACK_Y = M_T + (VB_H - M_T - M_B - TRACK_H) / 2;
const TRACK_Y_BOTTOM = TRACK_Y + TRACK_H;
const AXIS_Y = TRACK_Y_BOTTOM;

// ---- Time scale: 2005-01-01 to (asOf + ~6 months padding) -----------------
function parseDate(s: string): number {
  // Return decimal year
  const [yy, mm, dd] = s.split("-").map(Number);
  // Approximate day-of-year via 30-day months (good enough for plot scale)
  return yy + (mm - 1 + (dd - 1) / 30) / 12;
}
const xMin = 2005.0;
const asOfDec = parseDate(asOf);
const xMax = asOfDec + 0.5; // ~6 months padding

function xScale(decY: number): number {
  return PLOT_X0 + ((decY - xMin) / (xMax - xMin)) * PLOT_W;
}

// ---- Cycle rects ----------------------------------------------------------
const renderedCycles = cycles
  .map((c) => {
    const start = parseDate(c.start);
    const end = c.end ? parseDate(c.end) : asOfDec;
    if (end < xMin || start > xMax) return null;
    const x0 = xScale(Math.max(start, xMin));
    const x1 = xScale(Math.min(end, xMax));
    return { ...c, start, end, x0, x1, width: Math.max(1, x1 - x0) };
  })
  .filter((c): c is NonNullable<typeof c> => c !== null);

// ---- Year ticks: every January from 2005 to xMax floor() ------------------
const yearTicks: Array<{ x: number; label: string | null; major: boolean }> = [];
const startYear = 2005;
const endYear = Math.floor(xMax);
for (let y = startYear; y <= endYear; y++) {
  const x = xScale(y);
  if (x < PLOT_X0 - 1 || x > PLOT_X1 + 1) continue;
  const isLabel = y % 5 === 0;
  yearTicks.push({ x, label: isLabel ? String(y) : null, major: isLabel });
}

// ---- Current marker -------------------------------------------------------
const currentCycle = renderedCycles.find((c) => c.current);
const currentX = currentCycle ? xScale(asOfDec) : null;

// ---- Recession label collision avoidance ----------------------------------
// Place each recession label centered above the band by default.
// If two band centers are too close (< 80px), nudge one up.
type RecLabel = { x: number; y: number; text: string; band: typeof renderedCycles[number] };
const recLabels: RecLabel[] = [];
const recCycles = renderedCycles.filter((c) => c.state === "recession" && c.label);
const labelBaseY = TRACK_Y - 10;
let prevCenterX = -Infinity;
let layerOffset = 0;
for (const rc of recCycles) {
  const cx = (rc.x0 + rc.x1) / 2;
  let labelY = labelBaseY;
  if (cx - prevCenterX < 80) {
    layerOffset = layerOffset === 0 ? 16 : 0;
    labelY = labelBaseY - layerOffset;
  } else {
    layerOffset = 0;
  }
  recLabels.push({ x: cx, y: labelY, text: rc.label as string, band: rc });
  prevCenterX = cx;
}
---
<div class="gdp-panel-chart" data-panel="6">
  <svg
    class="gdp-panel-chart__svg"
    viewBox={`0 0 ${VB_W} ${VB_H}`}
    preserveAspectRatio="xMidYMid meet"
    role="img"
    aria-label={ariaLabel}
  >
    {/* Track outline: a single hairline rule along the bottom so the eye
        finds the timeline even where there are no bands */}
    <line
      class="gdp-panel-chart__axis"
      x1={PLOT_X0.toFixed(2)}
      y1={AXIS_Y.toFixed(2)}
      x2={PLOT_X1.toFixed(2)}
      y2={AXIS_Y.toFixed(2)}
    />

    {/* Recession bands */}
    {renderedCycles.filter((c) => c.state === "recession").map((c) => (
      <rect
        class="gdp-panel-chart__recession-band"
        x={c.x0.toFixed(2)}
        y={TRACK_Y.toFixed(2)}
        width={c.width.toFixed(2)}
        height={TRACK_H}
      >
        <title>{`Recession${c.label ? " " + c.label : ""}: ${c.start.toFixed(2)} to ${c.end.toFixed(2)}`}</title>
      </rect>
    ))}

    {/* Recession date labels */}
    {recLabels.map((rl) => (
      <g>
        <text
          class="gdp-panel-chart__rec-label"
          x={rl.x.toFixed(2)}
          y={rl.y.toFixed(2)}
          text-anchor="middle"
        >{rl.text}</text>
      </g>
    ))}

    {/* X ticks */}
    {yearTicks.map((t) => (
      <g>
        <line
          class:list={["gdp-panel-chart__xtick", { "gdp-panel-chart__xtick--major": t.major }]}
          x1={t.x.toFixed(2)}
          y1={AXIS_Y.toFixed(2)}
          x2={t.x.toFixed(2)}
          y2={(AXIS_Y + (t.major ? 5 : 3)).toFixed(2)}
        />
        {t.label && (
          <text
            class="gdp-panel-chart__xtick-label"
            x={t.x.toFixed(2)}
            y={(AXIS_Y + 18).toFixed(2)}
            text-anchor="middle"
          >{t.label}</text>
        )}
      </g>
    ))}

    {/* Current-state right-edge marker */}
    {currentX !== null && (
      <g>
        {/* Vertical bar */}
        <line
          class="gdp-panel-chart__current-bar"
          x1={currentX.toFixed(2)}
          y1={(TRACK_Y - 6).toFixed(2)}
          x2={currentX.toFixed(2)}
          y2={(TRACK_Y_BOTTOM + 6).toFixed(2)}
        />
        {/* Dot at top */}
        <circle
          class="gdp-panel-chart__current-dot"
          cx={currentX.toFixed(2)}
          cy={(TRACK_Y - 6).toFixed(2)}
          r="3"
        />
        {/* Label */}
        <text
          class="gdp-panel-chart__current-label"
          x={currentX.toFixed(2)}
          y={(TRACK_Y - 22).toFixed(2)}
          text-anchor="end"
        >Expansion since 2020Q3</text>
      </g>
    )}

    {/* Communique annotation at bottom */}
    {communiqueAnnotation && (
      <text
        class="gdp-panel-chart__communique"
        x={PLOT_X1.toFixed(2)}
        y={(VB_H - 12).toFixed(2)}
        text-anchor="end"
      >{communiqueAnnotation}</text>
    )}
  </svg>
</div>

<style>
  .gdp-panel-chart {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: var(--surface);
    overflow: visible;
  }
  .gdp-panel-chart__svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    font-family: var(--font-sans);
  }
  .gdp-panel-chart__recession-band {
    fill: rgba(21, 23, 26, 0.12);
  }
  .gdp-panel-chart__rec-label {
    fill: var(--ink-faint);
    font-size: 11px;
    font-weight: var(--fw-regular);
    font-variant-numeric: tabular-nums;
  }
  .gdp-panel-chart__axis {
    stroke: var(--rule);
    stroke-width: 1;
    shape-rendering: crispEdges;
  }
  .gdp-panel-chart__xtick {
    stroke: var(--ink-faint);
    stroke-width: 1;
    shape-rendering: crispEdges;
    opacity: 0.5;
  }
  .gdp-panel-chart__xtick--major {
    opacity: 1;
  }
  .gdp-panel-chart__xtick-label {
    fill: var(--ink-faint);
    font-size: 11px;
    font-weight: var(--fw-medium);
    font-variant-numeric: tabular-nums;
  }
  .gdp-panel-chart__current-bar {
    stroke: var(--series-1);
    stroke-width: 2;
    shape-rendering: crispEdges;
  }
  .gdp-panel-chart__current-dot {
    fill: var(--series-1);
  }
  .gdp-panel-chart__current-label {
    fill: var(--ink);
    font-size: 13px;
    font-weight: var(--fw-medium);
  }
  .gdp-panel-chart__communique {
    fill: var(--ink-muted);
    font-size: 13px;
    font-weight: var(--fw-regular);
  }
</style>
