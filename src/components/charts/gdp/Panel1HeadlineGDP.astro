---
/*
 * Panel1HeadlineGDP - dual-frequency view of headline real GDP.
 *
 * Vignelli v1.0 canon-compliant rebuild (2026-05-11). Anchors to
 * src/components/charts/_canon_reference/PanelCanonReference.astro and
 * design/canon_reference_panel.md (Redline 1).
 *
 * Editorial argument: pure ink m/m bars (the trace), pure ink dashed Q/Q
 * SAAR line on top, single MTA red dot on the latest quarterly print.
 * One direct "Monthly m/m" label upper-left; one direct "Quarterly Q/Q
 * SAAR" label at the line terminus. 1px ink hairline plot frame,
 * gridlines at 0.18 opacity, Plex Mono y-ticks, Manrope x-ticks, no
 * unit caption (topmost y-tick carries the unit).
 *
 * Data contract preserved: { date, mom_pct, qq_saar_pct,
 * mom_pct_prior_vintage }. Backend wires data/derived/gdp_basics/
 * panel-1.csv at a later one-line page change.
 */

interface MonthlyPoint {
  date: string;        // "YYYY-MM"
  mom_pct: number | null;
  qq_saar_pct: number | null;
  mom_pct_prior_vintage?: number | null;
}

interface Props {
  data?: MonthlyPoint[];
  /** Annotation text on most recent print. Owned by writer. Anchor word in **bold**. */
  recentAnnotation?: string;
  /** ARIA label for the SVG. */
  ariaLabel?: string;
}

// ---- Placeholder data: last 60 months ending Mar 2026 ---------------------
function makePlaceholder(): MonthlyPoint[] {
  const out: MonthlyPoint[] = [];
  const startY = 2021;
  const startM = 4;
  let y = startY;
  let m = startM;
  const seedMom = [
    -0.3, 0.2, 0.6, 0.4, 0.1, -0.1, 0.3, 0.2, 0.4, 0.1, -0.2, 0.0,
     0.3, 0.5, 0.2, 0.0, 0.1, 0.3, 0.4, 0.2, -0.1, 0.0, 0.2, 0.3,
     0.1, 0.0, 0.2, 0.4, 0.3, 0.1, -0.1, 0.0, 0.2, 0.3, 0.4, 0.1,
     0.0, 0.2, 0.1, 0.3, 0.4, 0.2, 0.1, 0.0, 0.2, 0.3, 0.1, 0.0,
     0.2, 0.3, 0.4, 0.1, 0.0, 0.2, 0.1, 0.3, 0.2, 0.0, 0.1, 0.2,
  ];
  const seedSaar = [
    null, null,  2.4, null, null,  1.6, null, null,  3.1, null, null,  2.2,
    null, null,  2.8, null, null,  2.0, null, null,  2.6, null, null,  1.9,
    null, null,  1.4, null, null,  1.8, null, null,  2.1, null, null,  1.6,
    null, null,  1.9, null, null,  2.3, null, null,  1.7, null, null,  1.2,
    null, null,  1.6, null, null,  2.0, null, null,  1.8, null, null,  1.4,
  ];
  for (let i = 0; i < 60; i++) {
    out.push({
      date: `${y}-${String(m).padStart(2, "0")}`,
      mom_pct: seedMom[i] ?? null,
      qq_saar_pct: seedSaar[i] ?? null,
      mom_pct_prior_vintage: i === 59 ? 0.1 : null,
    });
    m += 1;
    if (m > 12) { m = 1; y += 1; }
  }
  return out;
}

const {
  data = makePlaceholder(),
  recentAnnotation = "**Mar** print held above zero; quarterly SAAR settled near 1.4%.",
  ariaLabel = "Headline real GDP: monthly m/m % and quarterly Q/Q SAAR, last 5 years. Latest print is the most recent month.",
} = Astro.props;

// ---- Geometry --------------------------------------------------------------
const VB_W = 720;
const VB_H = 405;
const M_L = 56;   // Plex Mono y-tick gutter
const M_R = 88;   // right gutter for direct label
const M_T = 44;
const M_B = 40;
const PLOT_X0 = M_L;
const PLOT_Y0 = M_T;
const PLOT_W = VB_W - M_L - M_R;
const PLOT_H = VB_H - M_T - M_B;
const PLOT_X1 = PLOT_X0 + PLOT_W;
const PLOT_Y1 = PLOT_Y0 + PLOT_H;

// ---- Scales ---------------------------------------------------------------
const n = data.length;
function decYearOf(d: string): number {
  const [yy, mm] = d.split("-").map(Number);
  return yy + (mm - 0.5) / 12;
}
const xs = data.map((d) => decYearOf(d.date));
const xMin = xs[0];
const xMax = xs[xs.length - 1];

// Single y-axis in percent. Rescale Q/Q SAAR by /4 to read against m/m on
// the shared axis (a "compare frequency, not magnitude" visual).
const momVals = data.filter((d) => d.mom_pct !== null).map((d) => d.mom_pct as number);
const saarVals = data.filter((d) => d.qq_saar_pct !== null).map((d) => (d.qq_saar_pct as number) / 4);
const absMax = Math.max(...momVals.map(Math.abs), ...saarVals.map(Math.abs), 1.0);
const yMax = Math.ceil(absMax * 1.2 * 2) / 2;
const yMin = -yMax;
const crossesZero = yMin < 0 && yMax > 0;

function xScale(decY: number): number {
  if (xMax === xMin) return PLOT_X0 + PLOT_W / 2;
  return PLOT_X0 + ((decY - xMin) / (xMax - xMin)) * PLOT_W;
}
function yScale(v: number): number {
  return PLOT_Y0 + PLOT_H - ((v - yMin) / (yMax - yMin)) * PLOT_H;
}

// ---- Bars (monthly m/m) ---------------------------------------------------
const slotW = PLOT_W / Math.max(1, n);
const barW = Math.max(2, slotW * 0.5);
const barBaselineY = yScale(0);

// ---- Quarterly line + markers --------------------------------------------
const quarterlyPoints = data
  .map((d, i) => (d.qq_saar_pct !== null
    ? { i, x: xScale(xs[i]), y: yScale((d.qq_saar_pct as number) / 4), v: d.qq_saar_pct as number }
    : null))
  .filter((p): p is { i: number; x: number; y: number; v: number } => p !== null);
const linePath = quarterlyPoints
  .map((p, i) => `${i === 0 ? "M" : "L"}${p.x.toFixed(2)} ${p.y.toFixed(2)}`)
  .join(" ");
const lastQ = quarterlyPoints[quarterlyPoints.length - 1];

// ---- Y ticks: pick stride so 3-5 ticks land ------------------------------
function pickGridStride(lo: number, hi: number): number {
  const span = hi - lo;
  const candidates = [0.25, 0.5, 1, 2, 2.5, 5];
  for (const s of candidates) {
    const n = Math.round(span / s);
    if (n >= 3 && n <= 5) return s;
  }
  return Math.max(0.5, Math.round(span / 4));
}
const gridStride = pickGridStride(yMin, yMax);
const yTicks: number[] = [];
for (let v = yMin; v <= yMax + 1e-9; v += gridStride) {
  yTicks.push(Number(v.toFixed(2)));
}

// ---- X ticks: ~5 evenly spaced year anchors -------------------------------
const yearStart = Math.ceil(xMin);
const yearEnd = Math.floor(xMax);
const allYearTicks: Array<{ x: number; label: string }> = [];
for (let yr = yearStart; yr <= yearEnd; yr++) {
  const decY = yr + (1 - 0.5) / 12;
  if (decY < xMin || decY > xMax) continue;
  allYearTicks.push({ x: xScale(decY), label: String(yr) });
}
const xTickStride = Math.max(1, Math.ceil(allYearTicks.length / 5));
const xTicks = allYearTicks.filter((_, i) => i % xTickStride === 0);

// ---- Recession band -------------------------------------------------------
const recStart = 2020 + (2 - 0.5) / 12;
const recEnd = 2020 + (4 - 0.5) / 12;
const recVisible = recEnd >= xMin && recStart <= xMax;
const recX0 = recVisible ? xScale(Math.max(recStart, xMin)) : 0;
const recX1 = recVisible ? xScale(Math.min(recEnd, xMax)) : 0;

// ---- Latest print + revision marker --------------------------------------
const latest = data[n - 1];
const priorVintageY = latest.mom_pct_prior_vintage !== null && latest.mom_pct_prior_vintage !== undefined
  ? yScale(latest.mom_pct_prior_vintage)
  : null;
const showRevision = priorVintageY !== null
  && latest.mom_pct !== null
  && Math.abs((latest.mom_pct as number) - (latest.mom_pct_prior_vintage as number)) > 0.05;
const latestMomX = xScale(xs[n - 1]);

// ---- Direct label positions ----------------------------------------------
const monthlyLabelX = PLOT_X0 + 12;
const monthlyLabelY = PLOT_Y0 + 16;
const quarterlyLabelX = lastQ ? lastQ.x + 10 : PLOT_X1 + 8;
const quarterlyLabelY = lastQ ? lastQ.y + 4 : PLOT_Y0 + PLOT_H / 2;

// ---- Annotation: parse **anchor** word, place in white space -------------
function parseAnchor(s: string): Array<{ text: string; bold: boolean }> {
  const parts: Array<{ text: string; bold: boolean }> = [];
  const re = /\*\*([^*]+)\*\*/g;
  let last = 0;
  let m: RegExpExecArray | null;
  while ((m = re.exec(s)) !== null) {
    if (m.index > last) parts.push({ text: s.slice(last, m.index), bold: false });
    parts.push({ text: m[1], bold: true });
    last = m.index + m[0].length;
  }
  if (last < s.length) parts.push({ text: s.slice(last), bold: false });
  return parts;
}
const annoParts = recentAnnotation ? parseAnchor(recentAnnotation) : [];
const annoX0 = PLOT_X0 + 18;
const annoY0 = PLOT_Y0 + 22;
const annoMaxWidth = PLOT_W * 0.46;
const leaderStartX = annoX0 + Math.min(annoMaxWidth, 220);
const leaderStartY = annoY0 - 4;
const anchorX = lastQ ? lastQ.x : latestMomX;
const anchorY = lastQ ? lastQ.y : barBaselineY;
const leaderEndX = anchorX - 7;
const leaderEndY = anchorY;
---
<div class="canon-chart" data-panel="gdp-1">
  <svg
    class="canon-chart__svg"
    viewBox={`0 0 ${VB_W} ${VB_H}`}
    preserveAspectRatio="xMidYMid meet"
    role="img"
    aria-label={ariaLabel}
  >
    {/* 1. Recession band (behind everything) */}
    {recVisible && (
      <g class="canon-chart__recession-group">
        <rect
          class="canon-chart__recession"
          x={recX0.toFixed(2)}
          y={PLOT_Y0}
          width={Math.max(1, recX1 - recX0).toFixed(2)}
          height={PLOT_H}
        />
        <text
          class="canon-chart__recession-label"
          x={((recX0 + recX1) / 2).toFixed(2)}
          y={(PLOT_Y0 + 12).toFixed(2)}
          text-anchor="middle"
        >RECESSION (2020Q1-Q2)</text>
      </g>
    )}

    {/* 2. Horizontal gridlines - pure ink at 0.18 opacity. Skip the zero
           line; drawn separately at full opacity. */}
    {yTicks.map((v) => {
      const y = yScale(v);
      const isZero = crossesZero && Math.abs(v) < 1e-9;
      if (isZero) return null;
      return (
        <line
          class="canon-chart__gridline"
          x1={PLOT_X0}
          y1={y.toFixed(2)}
          x2={PLOT_X1}
          y2={y.toFixed(2)}
        />
      );
    })}

    {/* 3. Zero line at full opacity */}
    {crossesZero && (
      <line
        class="canon-chart__zero-line"
        x1={PLOT_X0}
        y1={barBaselineY.toFixed(2)}
        x2={PLOT_X1}
        y2={barBaselineY.toFixed(2)}
      />
    )}

    {/* 4. Monthly bars - pure ink fill */}
    {data.map((d, i) => {
      if (d.mom_pct === null) return null;
      const cx = xScale(xs[i]);
      const yTop = yScale(d.mom_pct);
      const top = Math.min(yTop, barBaselineY);
      const h = Math.max(1, Math.abs(barBaselineY - yTop));
      return (
        <rect
          class="canon-chart__bar"
          x={(cx - barW / 2).toFixed(2)}
          y={top.toFixed(2)}
          width={barW.toFixed(2)}
          height={h.toFixed(2)}
        >
          <title>{`${d.date}: ${d.mom_pct.toFixed(2)}% m/m`}</title>
        </rect>
      );
    })}

    {/* 5. Revision dashed hairline at prior vintage on latest bar */}
    {showRevision && priorVintageY !== null && (
      <line
        class="canon-chart__revision"
        x1={(latestMomX - barW / 2 - 1).toFixed(2)}
        y1={priorVintageY.toFixed(2)}
        x2={(latestMomX + barW / 2 + 1).toFixed(2)}
        y2={priorVintageY.toFixed(2)}
      />
    )}

    {/* 6. Quarterly SAAR line - pure ink dashed 4 2 (secondary series) */}
    {linePath && (
      <path class="canon-chart__line-secondary" d={linePath} fill="none" />
    )}

    {/* 7. Invisible hit-areas with native SVG <title> for quarterly points */}
    {quarterlyPoints.map((p) => (
      <circle
        class="canon-chart__hit"
        cx={p.x.toFixed(2)}
        cy={p.y.toFixed(2)}
        r="4"
      >
        <title>{`${data[p.i].date}: ${p.v.toFixed(1)}% Q/Q SAAR`}</title>
      </circle>
    ))}

    {/* 8. Latest-quarter dot - MTA red */}
    {lastQ && (
      <circle
        class="canon-chart__latest-dot"
        cx={lastQ.x.toFixed(2)}
        cy={lastQ.y.toFixed(2)}
        r="4"
      >
        <title>{`Latest: ${data[lastQ.i].date}: ${lastQ.v.toFixed(1)}% Q/Q SAAR`}</title>
      </circle>
    )}

    {/* 9. Plot frame - 1px pure ink hairline rectangle */}
    <rect
      class="canon-chart__frame"
      x={PLOT_X0}
      y={PLOT_Y0}
      width={PLOT_W}
      height={PLOT_H}
    />

    {/* 10. X-axis tick marks + Manrope micro labels */}
    {xTicks.map((t) => (
      <g>
        <line
          class="canon-chart__xtick"
          x1={t.x.toFixed(2)}
          y1={PLOT_Y1.toFixed(2)}
          x2={t.x.toFixed(2)}
          y2={(PLOT_Y1 + 4).toFixed(2)}
        />
        <text
          class="canon-chart__xtick-label"
          x={t.x.toFixed(2)}
          y={(PLOT_Y1 + 18).toFixed(2)}
          text-anchor="middle"
        >{t.label}</text>
      </g>
    ))}

    {/* 11. Y-axis tick labels - Plex Mono, pure ink, right-aligned. Topmost
           tick carries the unit. */}
    {yTicks.map((v, i) => {
      const y = yScale(v);
      const isTop = i === yTicks.length - 1;
      const sign = v > 0 ? "+" : v < 0 ? "" : "";
      const num = `${sign}${v.toFixed(1)}`;
      const txt = isTop ? `${num}%` : num;
      return (
        <text
          class="canon-chart__ytick-label"
          x={(PLOT_X0 - 8).toFixed(2)}
          y={(y + 4).toFixed(2)}
          text-anchor="end"
        >{txt}</text>
      );
    })}

    {/* 12. Direct labels - pure ink Manrope 600. No legend. */}
    <text
      class="canon-chart__direct-label"
      x={monthlyLabelX.toFixed(2)}
      y={monthlyLabelY.toFixed(2)}
      text-anchor="start"
    >Monthly m/m</text>

    {lastQ && (
      <text
        class="canon-chart__direct-label"
        x={quarterlyLabelX.toFixed(2)}
        y={quarterlyLabelY.toFixed(2)}
        text-anchor="start"
      >Quarterly Q/Q SAAR</text>
    )}

    {/* 13. Hand-tuned annotation with single-segment ink leader, anchor word in 600 */}
    {recentAnnotation && (
      <g class="canon-chart__annotation">
        <line
          class="canon-chart__anno-leader"
          x1={leaderStartX.toFixed(2)}
          y1={leaderStartY.toFixed(2)}
          x2={leaderEndX.toFixed(2)}
          y2={leaderEndY.toFixed(2)}
        />
        <foreignObject
          x={annoX0.toFixed(2)}
          y={(annoY0 - 18).toFixed(2)}
          width={annoMaxWidth.toFixed(2)}
          height="44"
        >
          <p
           
            class="canon-chart__anno-text"
          >
            {annoParts.map((part) =>
              part.bold
                ? <strong class="canon-chart__anno-anchor">{part.text}</strong>
                : <span>{part.text}</span>
            )}
          </p>
        </foreignObject>
      </g>
    )}
  </svg>
</div>

<style>
  .canon-chart {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: var(--paper);
    overflow: visible;
  }
  .canon-chart__svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    font-family: var(--font-sans);
  }
  .canon-chart__recession { fill: rgba(21, 23, 26, 0.06); }
  .canon-chart__recession-label {
    fill: var(--ink);
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.18em;
  }
  .canon-chart__gridline {
    stroke: var(--ink);
    stroke-width: 1;
    stroke-opacity: 0.18;
    shape-rendering: crispEdges;
  }
  .canon-chart__zero-line {
    stroke: var(--ink);
    stroke-width: 1;
    stroke-opacity: 1;
    shape-rendering: crispEdges;
  }
  .canon-chart__bar {
    fill: var(--ink);
  }
  .canon-chart__line-secondary {
    stroke: var(--ink);
    stroke-width: 1;
    stroke-dasharray: 4 2;
    stroke-linejoin: round;
    stroke-linecap: butt;
    fill: none;
    vector-effect: non-scaling-stroke;
  }
  .canon-chart__revision {
    stroke: var(--ink);
    stroke-width: 1;
    stroke-dasharray: 2 2;
    shape-rendering: crispEdges;
  }
  .canon-chart__hit {
    fill: transparent;
    pointer-events: all;
  }
  .canon-chart__latest-dot {
    fill: var(--accent);
    stroke: none;
  }
  .canon-chart__frame {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1;
    shape-rendering: crispEdges;
  }
  .canon-chart__xtick {
    stroke: var(--ink);
    stroke-width: 1;
    shape-rendering: crispEdges;
  }
  .canon-chart__xtick-label {
    fill: var(--ink);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: var(--fw-regular);
    font-variant-numeric: tabular-nums;
  }
  .canon-chart__ytick-label {
    fill: var(--ink);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: var(--fw-regular);
    font-variant-numeric: tabular-nums;
  }
  .canon-chart__direct-label {
    fill: var(--ink);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: var(--fw-semibold);
    letter-spacing: 0;
  }
  .canon-chart__anno-leader {
    stroke: var(--ink);
    stroke-width: 1;
    shape-rendering: crispEdges;
    fill: none;
  }
  .canon-chart__anno-text {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: var(--fw-regular);
    line-height: 1.30;
    letter-spacing: 0;
  }
  .canon-chart__anno-anchor {
    font-weight: var(--fw-semibold);
  }
</style>
