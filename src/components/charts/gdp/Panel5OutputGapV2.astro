---
/*
 * Panel5OutputGapV2 - label-vs-data audit 2026-05-11 item #7.
 *
 * Original wrapper passes data.primary unchanged with direct-label
 * "GDP, quarterly" - a stale label from when the panel-5 primary was
 * raw quarterly real GDP (CAD chained level). The pipeline now emits
 * `output_gap_mpr` (BoC MPR output gap, % of potential, quarterly) as
 * primary and `capacity_util_total` (%, quarterly) as secondary. Both
 * lines render correctly under the units-match guard; only the
 * direct-labels and aria copy were lying.
 *
 * V2 keeps the same data wiring and corrects the editorial surface:
 *   - primaryLabel: "Output gap" (was "GDP, quarterly")
 *   - secondaryLabel: "Cap. util." (unchanged)
 *   - ariaLabel: honest about the two % slack-measure series
 *
 * No data swap. No derivation. Quick-win label fix.
 */

import type { PanelData } from "../_shared/panelData";
import PanelLiveChart from "../_shared/PanelLiveChart.astro";
import PanelEmpty from "../_shared/PanelEmpty.astro";

interface Props {
  data?: PanelData | null;
}

const { data = null } = Astro.props;
---
{data && data.primary ? (
  <PanelLiveChart
    primary={data.primary}
    secondary={data.secondary}
    primaryLabel="Output gap"
    secondaryLabel="Cap. util."
    dataPanelAttr="gdp-5-v2"
    ariaLabel="BoC MPR output gap, % of potential, and total capacity utilization."
  />
) : (
  <PanelEmpty reason="Output-gap series not yet emitted." />
)}
