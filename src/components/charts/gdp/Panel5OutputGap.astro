---
/*
 * Panel5OutputGap - output gap vs BoC potential.
 *
 * Pipeline emits quarterly GDP plus capacity-utilization total; the
 * BoC potential and the output-gap derivation are not on disk. We
 * render the raw quarterly GDP plus capacity-util as a stand-in until
 * the gap-vs-potential series lands.
 *
 * Wave 5 methodology resolution (EDR C.1): the canonical primary
 * series becomes BoC MPR `INDINF_OUTGAPMPR_Q` once backend wires it
 * (EDR backend brief item 4). HP-filter is explicitly rejected as
 * the Sibley methodology. When the BoC series lands, this wrapper
 * picks it up via the standard `data.primary` route.
 *
 * Wave 5 fold (EDR brief Section 3): capacity utilization (total +
 * manufacturing) becomes the secondary slack-measure toggle view.
 * Capacity-util shares the "% utilization" frame, distinct from the
 * output-gap "% of potential" frame; the toggle is a true view-switch
 * and is deferred until the centralized toggle pattern lands. Both
 * capacity-util series (`capacity_util_total.csv`,
 * `capacity_util_mfg.csv`) are on disk per EDR brief.
 *
 * Synthetic-data fallback removed.
 */

import type { PanelData } from "../_shared/panelData";
import PanelLiveChart from "../_shared/PanelLiveChart.astro";
import PanelEmpty from "../_shared/PanelEmpty.astro";

interface Props {
  data?: PanelData | null;
}

const { data = null } = Astro.props;
---
{data && data.primary ? (
  <PanelLiveChart
    primary={data.primary}
    secondary={data.secondary}
    primaryLabel="GDP, quarterly"
    secondaryLabel="Cap. util."
    dataPanelAttr="gdp-5"
    ariaLabel="Quarterly real GDP and total capacity utilization."
  />
) : (
  <PanelEmpty reason="Output-gap-vs-potential series not yet emitted." />
)}
