---
/*
 * Panel3Contributions - 6-bar GFCF + components diverging horizontal bars.
 *
 * Implements charts/gdp_basics/panel-3-contributions.md (spec v0.1).
 *
 * Visual: 7 horizontal bars (6 components + total at top) diverging from
 * a vertical zero axis. Categorical color per component (series-1..6),
 * ink for total. Value label at terminus in tabular mono. Prior-quarter
 * hollow square markers per bar. Aspect ratio 4:3 per spec.
 *
 * Plot vs SVG: spec calls for Observable Plot. We hold to hand-rolled
 * SVG for zero-JS Astro defaults. Total geometry: 7 rects, 7 labels, 7
 * value labels, 7 prior-quarter markers, 1 zero rule. Trivial in SVG.
 *
 * Data: placeholder series. Backend supplies
 * data/derived/gdp_basics/panel-3.csv: component, contribution_pp,
 * q_minus_1_pp.
 */

interface Contribution {
  component: string;
  contribution_pp: number;
  q_minus_1_pp: number;
}

interface Props {
  data?: Contribution[];
  totalPp?: number;
  ariaLabel?: string;
}

// EDR-locked order
const DEFAULT_DATA: Contribution[] = [
  { component: "Consumption",   contribution_pp:  0.7, q_minus_1_pp:  0.5 },
  { component: "Government",    contribution_pp:  0.2, q_minus_1_pp:  0.3 },
  { component: "GFCF",          contribution_pp:  0.3, q_minus_1_pp:  0.1 },
  { component: "Inventories",   contribution_pp: -0.1, q_minus_1_pp:  0.2 },
  { component: "Exports",       contribution_pp:  0.6, q_minus_1_pp:  0.3 },
  { component: "Less imports",  contribution_pp: -0.3, q_minus_1_pp: -0.4 },
];

const {
  data = DEFAULT_DATA,
  totalPp = DEFAULT_DATA.reduce((s, d) => s + d.contribution_pp, 0),
  ariaLabel = "Contributions to quarterly Q/Q SAAR growth by component, percentage points",
} = Astro.props;

// Series colors per row (EDR order)
const COMPONENT_COLORS = [
  "var(--series-1)",
  "var(--series-2)",
  "var(--series-3)",
  "var(--series-4)",
  "var(--series-5)",
  "var(--series-6)",
];

// ---- Geometry --------------------------------------------------------------
// 4:3 aspect ratio per spec
const VB_W = 720;
const VB_H = 540;
const M_L = 112; // category labels on left
const M_R = 64;  // value labels on right
const M_T = 32;
const M_B = 32;
const PLOT_X0 = M_L;
const PLOT_Y0 = M_T;
const PLOT_W = VB_W - M_L - M_R;
const PLOT_H = VB_H - M_T - M_B;
const PLOT_X1 = PLOT_X0 + PLOT_W;
const PLOT_Y1 = PLOT_Y0 + PLOT_H;

// ---- Scale ----------------------------------------------------------------
const allVals = [
  ...data.map((d) => d.contribution_pp),
  ...data.map((d) => d.q_minus_1_pp),
  totalPp,
];
const absMax = Math.max(...allVals.map(Math.abs), 0.5);
// Round to nearest 0.5, pad 20%
const xExtent = Math.ceil(absMax * 1.2 * 2) / 2;
const xMin = -xExtent;
const xMax = xExtent;

function xScale(v: number): number {
  return PLOT_X0 + ((v - xMin) / (xMax - xMin)) * PLOT_W;
}
const x0 = xScale(0);

// ---- Row layout -----------------------------------------------------------
// 6 component rows + divider gap + 1 total row
const COMP_BAR_H = 8;
const TOTAL_BAR_H = 10;
const ROW_GAP = 16;
const DIVIDER_GAP = 14;

// Calculate total y-extent and center it within plot area
const compRowsH = data.length * COMP_BAR_H + (data.length - 1) * ROW_GAP;
const totalContentH = TOTAL_BAR_H + DIVIDER_GAP + compRowsH;
const yStart = PLOT_Y0 + (PLOT_H - totalContentH) / 2;

// Total row at top
const totalRowY = yStart + TOTAL_BAR_H / 2;
const dividerY = totalRowY + TOTAL_BAR_H / 2 + DIVIDER_GAP / 2;
const firstCompRowY = dividerY + DIVIDER_GAP / 2 + COMP_BAR_H / 2;

function compRowY(i: number): number {
  return firstCompRowY + i * (COMP_BAR_H + ROW_GAP);
}

// ---- X gridlines: every 0.5 pp -------------------------------------------
const gridTicks: number[] = [];
for (let v = Math.ceil(xMin / 0.5) * 0.5; v <= xMax + 1e-9; v += 0.5) {
  gridTicks.push(Number(v.toFixed(2)));
}
---
<div class="gdp-panel-chart" data-panel="3">
  <svg
    class="gdp-panel-chart__svg"
    viewBox={`0 0 ${VB_W} ${VB_H}`}
    preserveAspectRatio="xMidYMid meet"
    role="img"
    aria-label={ariaLabel}
  >
    {/* Vertical gridlines (per spec: x has minor ticks for orientation) */}
    {gridTicks.map((v) => {
      const x = xScale(v);
      const isZero = Math.abs(v) < 1e-9;
      if (isZero) return null;
      return (
        <line
          class="gdp-panel-chart__gridline"
          x1={x.toFixed(2)}
          y1={PLOT_Y0}
          x2={x.toFixed(2)}
          y2={PLOT_Y1}
        />
      );
    })}

    {/* Divider rule between total and components */}
    <line
      class="gdp-panel-chart__divider"
      x1={(M_L - 8).toFixed(2)}
      y1={dividerY.toFixed(2)}
      x2={(PLOT_X1).toFixed(2)}
      y2={dividerY.toFixed(2)}
    />

    {/* Total bar (top row) */}
    {(() => {
      const v = totalPp;
      const cx = xScale(v);
      const left = Math.min(x0, cx);
      const w = Math.abs(cx - x0);
      return (
        <g>
          <text
            class="gdp-panel-chart__cat-label gdp-panel-chart__cat-label--total"
            x={(M_L - 12).toFixed(2)}
            y={(totalRowY + 4).toFixed(2)}
            text-anchor="end"
          >Total Q/Q SAAR</text>
          <rect
            class="gdp-panel-chart__bar-total"
            x={left.toFixed(2)}
            y={(totalRowY - TOTAL_BAR_H / 2).toFixed(2)}
            width={Math.max(1, w).toFixed(2)}
            height={TOTAL_BAR_H}
          >
            <title>{`Total Q/Q SAAR: ${v >= 0 ? "+" : ""}${v.toFixed(1)} pp`}</title>
          </rect>
          <text
            class="gdp-panel-chart__value-label gdp-panel-chart__value-label--total"
            x={(v >= 0 ? cx + 8 : cx - 8).toFixed(2)}
            y={(totalRowY + 4).toFixed(2)}
            text-anchor={v >= 0 ? "start" : "end"}
          >{`${v >= 0 ? "+" : ""}${v.toFixed(1)} pp`}</text>
        </g>
      );
    })()}

    {/* Component bars */}
    {data.map((d, i) => {
      const y = compRowY(i);
      const cx = xScale(d.contribution_pp);
      const left = Math.min(x0, cx);
      const w = Math.abs(cx - x0);
      const priorX = xScale(d.q_minus_1_pp);
      const color = COMPONENT_COLORS[i] ?? "var(--series-1)";
      return (
        <g>
          <text
            class="gdp-panel-chart__cat-label"
            x={(M_L - 12).toFixed(2)}
            y={(y + 4).toFixed(2)}
            text-anchor="end"
            style={`fill: ${color};`}
          >{d.component}</text>
          <rect
            class="gdp-panel-chart__bar"
            x={left.toFixed(2)}
            y={(y - COMP_BAR_H / 2).toFixed(2)}
            width={Math.max(1, w).toFixed(2)}
            height={COMP_BAR_H}
            style={`fill: ${color};`}
          >
            <title>{`${d.component}: ${d.contribution_pp >= 0 ? "+" : ""}${d.contribution_pp.toFixed(1)} pp (Q-1: ${d.q_minus_1_pp >= 0 ? "+" : ""}${d.q_minus_1_pp.toFixed(1)} pp)`}</title>
          </rect>
          {/* Prior-quarter hollow square marker */}
          <rect
            class="gdp-panel-chart__prior-marker"
            x={(priorX - 2.5).toFixed(2)}
            y={(y - 2.5).toFixed(2)}
            width="5"
            height="5"
            style={`stroke: ${color};`}
          />
          <text
            class="gdp-panel-chart__value-label"
            x={(d.contribution_pp >= 0 ? cx + 6 : cx - 6).toFixed(2)}
            y={(y + 4).toFixed(2)}
            text-anchor={d.contribution_pp >= 0 ? "start" : "end"}
          >{`${d.contribution_pp >= 0 ? "+" : ""}${d.contribution_pp.toFixed(1)} pp`}</text>
        </g>
      );
    })}

    {/* Zero line (vertical, full plot height) */}
    <line
      class="gdp-panel-chart__zero"
      x1={x0.toFixed(2)}
      y1={PLOT_Y0}
      x2={x0.toFixed(2)}
      y2={PLOT_Y1}
    />

    {/* Unit annotation at right end of zero line top */}
    <text
      class="gdp-panel-chart__unit"
      x={(PLOT_X1 + 4).toFixed(2)}
      y={(PLOT_Y0 - 6).toFixed(2)}
      text-anchor="end"
    >pp contribution</text>
  </svg>
</div>

<style>
  .gdp-panel-chart {
    width: 100%;
    aspect-ratio: 4 / 3;
    background-color: var(--surface);
    overflow: visible;
  }
  .gdp-panel-chart__svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    font-family: var(--font-sans);
  }
  .gdp-panel-chart__gridline {
    stroke: var(--rule-faint);
    stroke-width: 1;
    shape-rendering: crispEdges;
  }
  .gdp-panel-chart__zero {
    stroke: var(--ink-muted);
    stroke-width: 1;
    shape-rendering: crispEdges;
  }
  .gdp-panel-chart__divider {
    stroke: var(--rule);
    stroke-width: 1;
    shape-rendering: crispEdges;
  }
  .gdp-panel-chart__bar-total {
    fill: var(--ink);
  }
  .gdp-panel-chart__cat-label {
    font-size: 13px;
    font-weight: var(--fw-medium);
    fill: var(--ink);
  }
  .gdp-panel-chart__cat-label--total {
    fill: var(--ink);
    font-weight: var(--fw-semibold);
  }
  .gdp-panel-chart__value-label {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: var(--fw-regular);
    fill: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .gdp-panel-chart__value-label--total {
    font-weight: var(--fw-semibold);
    font-size: 13px;
  }
  .gdp-panel-chart__prior-marker {
    fill: transparent;
    stroke-width: 1;
  }
  .gdp-panel-chart__unit {
    fill: var(--ink-faint);
    font-size: 11px;
    font-weight: var(--fw-medium);
    letter-spacing: 0.02em;
  }
</style>
