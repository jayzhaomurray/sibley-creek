---
/*
 * Panel4PerCapita - aggregate vs per-capita real GDP Y/Y.
 *
 * Vignelli v1.0 canon-compliant rebuild (2026-05-11). Anchors to
 * src/components/charts/_canon_reference/PanelCanonReference.astro.
 *
 * Multi-series treatment: primary = per-capita (pure ink 1.5px solid, MTA
 * red latest dot, Manrope 600 "Per-capita" direct label). Secondary =
 * aggregate (pure ink 1px dashed `4 2`, no dot, Manrope 400 "Aggregate"
 * direct label). Editorial argument: per-capita is the story.
 *
 * Data contract preserved: { date, aggregate_yoy_pct, per_capita_yoy_pct }.
 */

interface QuarterPoint {
  date: string;
  aggregate_yoy_pct: number;
  per_capita_yoy_pct: number;
}

interface Props {
  data?: QuarterPoint[];
  streakAnnotation?: string;
  ariaLabel?: string;
}

function makePlaceholder(): QuarterPoint[] {
  const out: QuarterPoint[] = [];
  for (let i = 0; i < 33; i++) {
    const y = 2018 + Math.floor(i / 4);
    const q = (i % 4) + 1;
    let agg: number;
    if (i < 8) agg = 1.8 + Math.sin(i * 0.6) * 0.4;
    else if (i === 8) agg = -1.0;
    else if (i === 9) agg = -8.2;
    else if (i === 10) agg = -3.0;
    else if (i === 11) agg = -1.5;
    else if (i === 12) agg = 0.5;
    else if (i === 13) agg = 5.5;
    else if (i < 20) agg = 3.5 - (i - 13) * 0.2;
    else agg = 1.6 + Math.sin(i * 0.4) * 0.4;
    let popGrowth: number;
    if (i < 18) popGrowth = 1.3;
    else if (i < 24) popGrowth = 2.4;
    else popGrowth = 3.0;
    const pc = agg - popGrowth;
    out.push({
      date: `${y}-Q${q}`,
      aggregate_yoy_pct: Number(agg.toFixed(2)),
      per_capita_yoy_pct: Number(pc.toFixed(2)),
    });
  }
  return out;
}

const {
  data = makePlaceholder(),
  streakAnnotation = "Per-capita has run **negative** for the better part of two years.",
  ariaLabel = "Aggregate vs per-capita real GDP, year-over-year, last 8 years. Latest print is the most recent quarter.",
} = Astro.props;

// ---- Geometry --------------------------------------------------------------
const VB_W = 720;
const VB_H = 405;
const M_L = 56;
const M_R = 96;
const M_T = 44;
const M_B = 40;
const PLOT_X0 = M_L;
const PLOT_Y0 = M_T;
const PLOT_W = VB_W - M_L - M_R;
const PLOT_H = VB_H - M_T - M_B;
const PLOT_X1 = PLOT_X0 + PLOT_W;
const PLOT_Y1 = PLOT_Y0 + PLOT_H;

const n = data.length;
function decYearOf(d: string): number {
  const [yy, q] = d.split("-Q").map(Number);
  return yy + (q * 3 - 1.5) / 12;
}
const xs = data.map((d) => decYearOf(d.date));
const xMin = xs[0];
const xMax = xs[xs.length - 1];

const allVals = data.flatMap((d) => [d.aggregate_yoy_pct, d.per_capita_yoy_pct]);
const rawMin = Math.min(...allVals);
const rawMax = Math.max(...allVals);
let yLo = Math.floor(rawMin - 1);
let yHi = Math.ceil(rawMax + 1);
yLo = Math.floor(yLo / 2) * 2;
yHi = Math.ceil(yHi / 2) * 2;
const crossesZero = yLo < 0 && yHi > 0;

function xScale(decY: number): number {
  return PLOT_X0 + ((decY - xMin) / (xMax - xMin)) * PLOT_W;
}
function yScale(v: number): number {
  return PLOT_Y0 + PLOT_H - ((v - yLo) / (yHi - yLo)) * PLOT_H;
}

function buildLine(pickV: (d: QuarterPoint) => number): string {
  return data
    .map((d, i) => {
      const x = xScale(xs[i]);
      const y = yScale(pickV(d));
      return `${i === 0 ? "M" : "L"}${x.toFixed(2)} ${y.toFixed(2)}`;
    })
    .join(" ");
}
const aggPath = buildLine((d) => d.aggregate_yoy_pct);
const pcPath = buildLine((d) => d.per_capita_yoy_pct);

// ---- Gridlines + ticks ----------------------------------------------------
const yTicks: number[] = [];
function pickStride(lo: number, hi: number): number {
  const span = hi - lo;
  for (const s of [1, 2, 2.5, 5]) {
    const n = Math.round(span / s);
    if (n >= 3 && n <= 5) return s;
  }
  return Math.max(1, Math.round(span / 4));
}
const yStride = pickStride(yLo, yHi);
for (let v = yLo; v <= yHi + 1e-9; v += yStride) yTicks.push(v);

const yearStart = Math.ceil(xMin);
const yearEnd = Math.floor(xMax);
const allYearTicks: Array<{ x: number; label: string }> = [];
for (let yr = yearStart; yr <= yearEnd; yr++) {
  const decY = yr + (1 - 0.5) / 12;
  if (decY < xMin || decY > xMax) continue;
  allYearTicks.push({ x: xScale(decY), label: String(yr) });
}
const xTickStride = Math.max(1, Math.ceil(allYearTicks.length / 5));
const xTicks = allYearTicks.filter((_, i) => i % xTickStride === 0);

// ---- Recession band -------------------------------------------------------
const recStart = 2020 + (2 - 0.5) / 12;
const recEnd = 2020 + (4 - 0.5) / 12;
const recVisible = recEnd >= xMin && recStart <= xMax;
const recX0 = recVisible ? xScale(Math.max(recStart, xMin)) : 0;
const recX1 = recVisible ? xScale(Math.min(recEnd, xMax)) : 0;

// ---- Latest points -------------------------------------------------------
const latestIdx = n - 1;
const latest = data[latestIdx];
const lastAggX = xScale(xs[latestIdx]);
const lastAggY = yScale(latest.aggregate_yoy_pct);
const lastPcX = lastAggX;
const lastPcY = yScale(latest.per_capita_yoy_pct);

// ---- Annotation ----------------------------------------------------------
function parseAnchor(s: string): Array<{ text: string; bold: boolean }> {
  const parts: Array<{ text: string; bold: boolean }> = [];
  const re = /\*\*([^*]+)\*\*/g;
  let last = 0;
  let m: RegExpExecArray | null;
  while ((m = re.exec(s)) !== null) {
    if (m.index > last) parts.push({ text: s.slice(last, m.index), bold: false });
    parts.push({ text: m[1], bold: true });
    last = m.index + m[0].length;
  }
  if (last < s.length) parts.push({ text: s.slice(last), bold: false });
  return parts;
}
const annoParts = streakAnnotation ? parseAnchor(streakAnnotation) : [];

// Per-capita is below zero -> place annotation in upper-left whitespace, leader to dot
const annoX0 = PLOT_X0 + 18;
const annoY0 = PLOT_Y0 + 22;
const annoMaxWidth = PLOT_W * 0.46;
const leaderStartX = annoX0 + Math.min(annoMaxWidth, 220);
const leaderStartY = annoY0 - 4;
const leaderEndX = lastPcX - 7;
const leaderEndY = lastPcY;
---
<div class="canon-chart" data-panel="gdp-4">
  <svg
    class="canon-chart__svg"
    viewBox={`0 0 ${VB_W} ${VB_H}`}
    preserveAspectRatio="xMidYMid meet"
    role="img"
    aria-label={ariaLabel}
  >
    {recVisible && (
      <g>
        <rect class="canon-chart__recession" x={recX0.toFixed(2)} y={PLOT_Y0}
          width={Math.max(1, recX1 - recX0).toFixed(2)} height={PLOT_H} />
        <text class="canon-chart__recession-label"
          x={((recX0 + recX1) / 2).toFixed(2)} y={(PLOT_Y0 + 12).toFixed(2)}
          text-anchor="middle">RECESSION (2020Q1-Q2)</text>
      </g>
    )}

    {yTicks.map((v) => {
      const y = yScale(v);
      if (crossesZero && Math.abs(v) < 1e-9) return null;
      return (
        <line class="canon-chart__gridline"
          x1={PLOT_X0} y1={y.toFixed(2)} x2={PLOT_X1} y2={y.toFixed(2)} />
      );
    })}

    {crossesZero && (
      <line class="canon-chart__zero-line"
        x1={PLOT_X0} y1={yScale(0).toFixed(2)} x2={PLOT_X1} y2={yScale(0).toFixed(2)} />
    )}

    {/* Secondary: aggregate, dashed */}
    <path class="canon-chart__line-secondary" d={aggPath} fill="none" />

    {/* Primary: per-capita, solid pure ink */}
    <path class="canon-chart__line" d={pcPath} fill="none" />

    {/* Hit areas */}
    {data.map((d, i) => {
      const x = xScale(xs[i]);
      return (
        <g>
          <circle class="canon-chart__hit" cx={x.toFixed(2)} cy={yScale(d.per_capita_yoy_pct).toFixed(2)} r="4">
            <title>{`${d.date}: ${d.per_capita_yoy_pct.toFixed(1)}% per-capita Y/Y`}</title>
          </circle>
          <circle class="canon-chart__hit" cx={x.toFixed(2)} cy={yScale(d.aggregate_yoy_pct).toFixed(2)} r="4">
            <title>{`${d.date}: ${d.aggregate_yoy_pct.toFixed(1)}% aggregate Y/Y`}</title>
          </circle>
        </g>
      );
    })}

    {/* MTA red latest-print dot on the primary (per-capita) */}
    <circle class="canon-chart__latest-dot" cx={lastPcX.toFixed(2)} cy={lastPcY.toFixed(2)} r="4">
      <title>{`Latest: ${latest.date}: ${latest.per_capita_yoy_pct.toFixed(1)}% per-capita Y/Y`}</title>
    </circle>

    <rect class="canon-chart__frame" x={PLOT_X0} y={PLOT_Y0} width={PLOT_W} height={PLOT_H} />

    {xTicks.map((t) => (
      <g>
        <line class="canon-chart__xtick" x1={t.x.toFixed(2)} y1={PLOT_Y1.toFixed(2)}
          x2={t.x.toFixed(2)} y2={(PLOT_Y1 + 4).toFixed(2)} />
        <text class="canon-chart__xtick-label" x={t.x.toFixed(2)} y={(PLOT_Y1 + 18).toFixed(2)}
          text-anchor="middle">{t.label}</text>
      </g>
    ))}

    {yTicks.map((v, i) => {
      const y = yScale(v);
      const isTop = i === yTicks.length - 1;
      const sign = v > 0 ? "+" : "";
      const num = `${sign}${v.toFixed(0)}`;
      const txt = isTop ? `${num}%` : num;
      return (
        <text class="canon-chart__ytick-label" x={(PLOT_X0 - 8).toFixed(2)} y={(y + 4).toFixed(2)}
          text-anchor="end">{txt}</text>
      );
    })}

    {/* Direct labels */}
    <text class="canon-chart__direct-label" x={(lastPcX + 10).toFixed(2)} y={(lastPcY + 4).toFixed(2)}
      text-anchor="start">Per-capita</text>
    <text class="canon-chart__direct-label-secondary" x={(lastAggX + 10).toFixed(2)} y={(lastAggY + 4).toFixed(2)}
      text-anchor="start">Aggregate</text>

    {streakAnnotation && (
      <g class="canon-chart__annotation">
        <line class="canon-chart__anno-leader"
          x1={leaderStartX.toFixed(2)} y1={leaderStartY.toFixed(2)}
          x2={leaderEndX.toFixed(2)} y2={leaderEndY.toFixed(2)} />
        <foreignObject x={annoX0.toFixed(2)} y={(annoY0 - 18).toFixed(2)}
          width={annoMaxWidth.toFixed(2)} height="44">
          <p class="canon-chart__anno-text">
            {annoParts.map((part) =>
              part.bold
                ? <strong class="canon-chart__anno-anchor">{part.text}</strong>
                : <span>{part.text}</span>
            )}
          </p>
        </foreignObject>
      </g>
    )}
  </svg>
</div>

<style>
  .canon-chart { width: 100%; aspect-ratio: 16 / 9; background-color: var(--paper); overflow: visible; }
  .canon-chart__svg { display: block; width: 100%; height: 100%; overflow: visible; font-family: var(--font-sans); }
  .canon-chart__recession { fill: rgba(21, 23, 26, 0.06); }
  .canon-chart__recession-label {
    fill: var(--ink); font-family: var(--font-sans);
    font-size: 11px; font-weight: var(--fw-semibold); letter-spacing: 0.18em;
  }
  .canon-chart__gridline { stroke: var(--ink); stroke-width: 1; stroke-opacity: 0.18; shape-rendering: crispEdges; }
  .canon-chart__zero-line { stroke: var(--ink); stroke-width: 1; stroke-opacity: 1; shape-rendering: crispEdges; }
  .canon-chart__line {
    stroke: var(--ink); stroke-width: 1.5; stroke-linejoin: round; stroke-linecap: round;
    fill: none; vector-effect: non-scaling-stroke;
  }
  .canon-chart__line-secondary {
    stroke: var(--ink); stroke-width: 1; stroke-dasharray: 4 2;
    stroke-linejoin: round; stroke-linecap: butt; fill: none; vector-effect: non-scaling-stroke;
  }
  .canon-chart__hit { fill: transparent; pointer-events: all; }
  .canon-chart__latest-dot { fill: var(--accent); stroke: none; }
  .canon-chart__frame { fill: none; stroke: var(--ink); stroke-width: 1; shape-rendering: crispEdges; }
  .canon-chart__xtick { stroke: var(--ink); stroke-width: 1; shape-rendering: crispEdges; }
  .canon-chart__xtick-label {
    fill: var(--ink); font-family: var(--font-sans);
    font-size: 12px; font-weight: var(--fw-regular); font-variant-numeric: tabular-nums;
  }
  .canon-chart__ytick-label {
    fill: var(--ink); font-family: var(--font-mono);
    font-size: 12px; font-weight: var(--fw-regular); font-variant-numeric: tabular-nums;
  }
  .canon-chart__direct-label {
    fill: var(--ink); font-family: var(--font-sans);
    font-size: 13px; font-weight: var(--fw-semibold);
  }
  .canon-chart__direct-label-secondary {
    fill: var(--ink); font-family: var(--font-sans);
    font-size: 13px; font-weight: var(--fw-regular);
  }
  .canon-chart__anno-leader { stroke: var(--ink); stroke-width: 1; shape-rendering: crispEdges; fill: none; }
  .canon-chart__anno-text {
    margin: 0; color: var(--ink); font-family: var(--font-sans);
    font-size: 15px; font-weight: var(--fw-regular); line-height: 1.30;
  }
  .canon-chart__anno-anchor { font-weight: var(--fw-semibold); }
</style>
