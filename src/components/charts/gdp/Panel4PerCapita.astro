---
/*
 * Panel4PerCapita - aggregate Y/Y vs per-capita Y/Y, two-line time series.
 *
 * Implements charts/gdp_basics/panel-4-per-capita.md (spec v0.1).
 *
 * Visual: two 1.5px solid lines on a single %Y/Y axis. Per-capita in
 * series-1 (focus, the story). Aggregate in series-7 (slate, context).
 * Quarter markers as 3px filled circles; latest as 4px with surface ring.
 * Recession band 2020Q1-Q2. Zero line in ink-muted (per-capita spends
 * time negative). 8-year window.
 *
 * Plot vs SVG: spec defaults to Observable Plot. We hold to hand-rolled
 * SVG (zero JS, matches Sparkline/HeroChart precedent). Two lines, two
 * marker series, one zero line, one recession band: ~40 lines geometry.
 */

interface QuarterPoint {
  date: string;        // "YYYY-Qn"
  aggregate_yoy_pct: number;
  per_capita_yoy_pct: number;
}

interface Props {
  data?: QuarterPoint[];
  /** Annotation text near latest per-capita point. Owned by writer. */
  streakAnnotation?: string;
  ariaLabel?: string;
}

function makePlaceholder(): QuarterPoint[] {
  // 8 years quarterly: 2018Q1 through 2026Q1 = 33 quarters
  // Aggregate Y/Y: pre-2020 around 2%, dive in 2020, recovery 5%+, back to 1.5%
  // Per-capita: tracks aggregate minus ~1.5pp pop growth; recent regime negative
  const out: QuarterPoint[] = [];
  for (let i = 0; i < 33; i++) {
    const y = 2018 + Math.floor(i / 4);
    const q = (i % 4) + 1;
    let agg: number;
    if (i < 8) agg = 1.8 + Math.sin(i * 0.6) * 0.4;        // 2018-2019: ~2%
    else if (i === 8) agg = -1.0;                          // 2020Q1
    else if (i === 9) agg = -8.2;                          // 2020Q2 trough
    else if (i === 10) agg = -3.0;                         // 2020Q3
    else if (i === 11) agg = -1.5;
    else if (i === 12) agg = 0.5;                          // 2021Q1
    else if (i === 13) agg = 5.5;                          // base effect peak
    else if (i < 20) agg = 3.5 - (i - 13) * 0.2;
    else agg = 1.6 + Math.sin(i * 0.4) * 0.4;
    // Per-capita: roughly aggregate minus pop growth (1.5pp typical, higher post-2022)
    let popGrowth: number;
    if (i < 18) popGrowth = 1.3;
    else if (i < 24) popGrowth = 2.4; // immigration ramp
    else popGrowth = 3.0;
    const pc = agg - popGrowth;
    out.push({
      date: `${y}-Q${q}`,
      aggregate_yoy_pct: Number(agg.toFixed(2)),
      per_capita_yoy_pct: Number(pc.toFixed(2)),
    });
  }
  return out;
}

const {
  data = makePlaceholder(),
  streakAnnotation = "7 consecutive quarters of per-capita contraction",
  ariaLabel = "Aggregate vs per-capita real GDP, year-over-year, 8 years",
} = Astro.props;

// ---- Geometry --------------------------------------------------------------
const VB_W = 720;
const VB_H = 405;
const M_L = 44;
const M_R = 96;
const M_T = 36;
const M_B = 36;
const PLOT_X0 = M_L;
const PLOT_Y0 = M_T;
const PLOT_W = VB_W - M_L - M_R;
const PLOT_H = VB_H - M_T - M_B;
const PLOT_X1 = PLOT_X0 + PLOT_W;
const PLOT_Y1 = PLOT_Y0 + PLOT_H;

const n = data.length;
function decYearOf(d: string): number {
  const [yy, q] = d.split("-Q").map(Number);
  return yy + (q * 3 - 1.5) / 12;
}
const xs = data.map((d) => decYearOf(d.date));
const xMin = xs[0];
const xMax = xs[xs.length - 1];

const allVals = data.flatMap((d) => [d.aggregate_yoy_pct, d.per_capita_yoy_pct]);
const rawMin = Math.min(...allVals);
const rawMax = Math.max(...allVals);
// Minimum range [-3, +5]
let yLo = Math.min(-3, Math.floor(rawMin - 1));
let yHi = Math.max(5, Math.ceil(rawMax + 1));
// Snap to even integers
yLo = Math.floor(yLo / 2) * 2;
yHi = Math.ceil(yHi / 2) * 2;

function xScale(decY: number): number {
  return PLOT_X0 + ((decY - xMin) / (xMax - xMin)) * PLOT_W;
}
function yScale(v: number): number {
  return PLOT_Y0 + PLOT_H - ((v - yLo) / (yHi - yLo)) * PLOT_H;
}

// ---- Lines ----------------------------------------------------------------
function buildLine(pickV: (d: QuarterPoint) => number): string {
  return data
    .map((d, i) => {
      const x = xScale(xs[i]);
      const y = yScale(pickV(d));
      return `${i === 0 ? "M" : "L"}${x.toFixed(2)} ${y.toFixed(2)}`;
    })
    .join(" ");
}
const aggPath = buildLine((d) => d.aggregate_yoy_pct);
const pcPath = buildLine((d) => d.per_capita_yoy_pct);

// ---- Gridlines + ticks ----------------------------------------------------
const yTicks: number[] = [];
const yStep = (yHi - yLo) > 12 ? 2 : 1;
for (let v = yLo; v <= yHi + 1e-9; v += yStep) {
  yTicks.push(v);
}

const yearStart = Math.ceil(xMin);
const yearEnd = Math.floor(xMax);
const yearTicks: Array<{ x: number; label: string }> = [];
for (let y = yearStart; y <= yearEnd; y++) {
  const decY = y + (1 - 0.5) / 12;
  if (decY < xMin || decY > xMax) continue;
  yearTicks.push({ x: xScale(decY), label: String(y) });
}

// ---- Recession band -------------------------------------------------------
const recStart = 2020 + (2 - 0.5) / 12;
const recEnd = 2020 + (4 - 0.5) / 12;
const recVisible = recEnd >= xMin && recStart <= xMax;
const recX0 = recVisible ? xScale(Math.max(recStart, xMin)) : 0;
const recX1 = recVisible ? xScale(Math.min(recEnd, xMax)) : 0;

// ---- Latest points -------------------------------------------------------
const latestIdx = n - 1;
const latest = data[latestIdx];
const lastAggX = xScale(xs[latestIdx]);
const lastAggY = yScale(latest.aggregate_yoy_pct);
const lastPcX = lastAggX;
const lastPcY = yScale(latest.per_capita_yoy_pct);

// ---- Annotation placement -----------------------------------------------
// Per-capita is currently negative -> place annotation in lower-right whitespace
const annoX = Math.min(lastPcX - 90, PLOT_X1 - 200);
const annoY = latest.per_capita_yoy_pct < 0
  ? Math.min(PLOT_Y1 - 24, lastPcY + 36)
  : Math.max(PLOT_Y0 + 24, lastPcY - 36);
const annoAnchorX = lastPcX;
const annoAnchorY = latest.per_capita_yoy_pct < 0 ? lastPcY + 4 : lastPcY - 4;
---
<div class="gdp-panel-chart" data-panel="4">
  <svg
    class="gdp-panel-chart__svg"
    viewBox={`0 0 ${VB_W} ${VB_H}`}
    preserveAspectRatio="xMidYMid meet"
    role="img"
    aria-label={ariaLabel}
  >
    {/* Recession band */}
    {recVisible && (
      <g>
        <rect
          class="gdp-panel-chart__recession"
          x={recX0.toFixed(2)}
          y={PLOT_Y0}
          width={Math.max(1, recX1 - recX0).toFixed(2)}
          height={PLOT_H}
        />
        <text
          class="gdp-panel-chart__recession-label"
          x={((recX0 + recX1) / 2).toFixed(2)}
          y={(PLOT_Y0 - 6).toFixed(2)}
          text-anchor="middle"
        >Recession (2020Q1-Q2)</text>
      </g>
    )}

    {/* Y gridlines */}
    {yTicks.map((v) => {
      const y = yScale(v);
      const isZero = Math.abs(v) < 1e-9;
      return (
        <line
          class:list={["gdp-panel-chart__gridline", { "gdp-panel-chart__gridline--zero": isZero }]}
          x1={PLOT_X0}
          y1={y.toFixed(2)}
          x2={PLOT_X1}
          y2={y.toFixed(2)}
        />
      );
    })}

    {/* Aggregate line (context, behind) */}
    <path class="gdp-panel-chart__line-aggregate" d={aggPath} fill="none" />

    {/* Per-capita line (focus) */}
    <path class="gdp-panel-chart__line-pc" d={pcPath} fill="none" />

    {/* Aggregate markers */}
    {data.map((d, i) => {
      const x = xScale(xs[i]);
      const y = yScale(d.aggregate_yoy_pct);
      const isLast = i === latestIdx;
      return (
        <circle
          class:list={["gdp-panel-chart__marker-agg", { "gdp-panel-chart__marker-latest-agg": isLast }]}
          cx={x.toFixed(2)}
          cy={y.toFixed(2)}
          r={isLast ? "4" : "3"}
        >
          <title>{`${d.date}: ${d.aggregate_yoy_pct.toFixed(1)}% aggregate Y/Y`}</title>
        </circle>
      );
    })}

    {/* Per-capita markers */}
    {data.map((d, i) => {
      const x = xScale(xs[i]);
      const y = yScale(d.per_capita_yoy_pct);
      const isLast = i === latestIdx;
      return (
        <circle
          class:list={["gdp-panel-chart__marker-pc", { "gdp-panel-chart__marker-latest-pc": isLast }]}
          cx={x.toFixed(2)}
          cy={y.toFixed(2)}
          r={isLast ? "4" : "3"}
        >
          <title>{`${d.date}: ${d.per_capita_yoy_pct.toFixed(1)}% per-capita Y/Y`}</title>
        </circle>
      );
    })}

    {/* X-axis */}
    <line
      class="gdp-panel-chart__xaxis"
      x1={PLOT_X0}
      y1={PLOT_Y1.toFixed(2)}
      x2={PLOT_X1}
      y2={PLOT_Y1.toFixed(2)}
    />
    {yearTicks.map((t) => (
      <g>
        <line
          class="gdp-panel-chart__xtick"
          x1={t.x.toFixed(2)}
          y1={PLOT_Y1.toFixed(2)}
          x2={t.x.toFixed(2)}
          y2={(PLOT_Y1 + 4).toFixed(2)}
        />
        <text
          class="gdp-panel-chart__xtick-label"
          x={t.x.toFixed(2)}
          y={(PLOT_Y1 + 16).toFixed(2)}
          text-anchor="middle"
        >{t.label}</text>
      </g>
    ))}

    {/* Y-axis labels */}
    {yTicks.map((v, i) => {
      const y = yScale(v);
      const isTop = i === yTicks.length - 1;
      const text = `${v > 0 ? "+" : ""}${v.toFixed(0)}${isTop ? "%" : ""}`;
      return (
        <text
          class="gdp-panel-chart__ytick-label"
          x={(PLOT_X0 - 6).toFixed(2)}
          y={(y + 3.5).toFixed(2)}
          text-anchor="end"
        >{text}</text>
      );
    })}

    {/* Unit */}
    <text
      class="gdp-panel-chart__unit"
      x={PLOT_X0.toFixed(2)}
      y={(PLOT_Y0 - 18).toFixed(2)}
      text-anchor="start"
    >% Y/Y</text>

    {/* Direct labels */}
    <text
      class="gdp-panel-chart__direct-label gdp-panel-chart__direct-label--agg"
      x={(lastAggX + 8).toFixed(2)}
      y={(lastAggY + 4).toFixed(2)}
      text-anchor="start"
    >Aggregate</text>
    <text
      class="gdp-panel-chart__direct-label gdp-panel-chart__direct-label--pc"
      x={(lastPcX + 8).toFixed(2)}
      y={(lastPcY + 4).toFixed(2)}
      text-anchor="start"
    >Per-capita</text>

    {/* Streak annotation */}
    {streakAnnotation && (
      <g>
        <line
          class="gdp-panel-chart__anno-leader"
          x1={(annoX + 4).toFixed(2)}
          y1={annoY.toFixed(2)}
          x2={annoAnchorX.toFixed(2)}
          y2={annoY.toFixed(2)}
        />
        <line
          class="gdp-panel-chart__anno-leader"
          x1={annoAnchorX.toFixed(2)}
          y1={annoY.toFixed(2)}
          x2={annoAnchorX.toFixed(2)}
          y2={annoAnchorY.toFixed(2)}
        />
        <text
          class="gdp-panel-chart__anno-text"
          x={annoX.toFixed(2)}
          y={(annoY + 4).toFixed(2)}
          text-anchor="end"
        >{streakAnnotation}</text>
      </g>
    )}
  </svg>
</div>

<style>
  .gdp-panel-chart {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: var(--surface);
    overflow: visible;
  }
  .gdp-panel-chart__svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    font-family: var(--font-sans);
  }
  .gdp-panel-chart__recession { fill: rgba(21, 23, 26, 0.06); }
  .gdp-panel-chart__recession-label {
    fill: var(--ink-faint);
    font-size: 11px;
    font-weight: var(--fw-medium);
  }
  .gdp-panel-chart__gridline {
    stroke: var(--rule-faint);
    stroke-width: 1;
    shape-rendering: crispEdges;
  }
  .gdp-panel-chart__gridline--zero {
    stroke: var(--ink-muted);
  }
  .gdp-panel-chart__line-aggregate {
    stroke: var(--series-7);
    stroke-width: 1.5;
    stroke-linejoin: round;
    stroke-linecap: round;
    fill: none;
  }
  .gdp-panel-chart__line-pc {
    stroke: var(--series-1);
    stroke-width: 1.5;
    stroke-linejoin: round;
    stroke-linecap: round;
    fill: none;
  }
  .gdp-panel-chart__marker-agg { fill: var(--series-7); }
  .gdp-panel-chart__marker-latest-agg {
    fill: var(--series-7);
    stroke: var(--surface);
    stroke-width: 1;
  }
  .gdp-panel-chart__marker-pc { fill: var(--series-1); }
  .gdp-panel-chart__marker-latest-pc {
    fill: var(--series-1);
    stroke: var(--surface);
    stroke-width: 1;
  }
  .gdp-panel-chart__xaxis {
    stroke: var(--rule);
    stroke-width: 1;
    shape-rendering: crispEdges;
  }
  .gdp-panel-chart__xtick {
    stroke: var(--ink-faint);
    stroke-width: 1;
    shape-rendering: crispEdges;
  }
  .gdp-panel-chart__ytick-label,
  .gdp-panel-chart__xtick-label {
    fill: var(--ink-faint);
    font-size: 11px;
    font-weight: var(--fw-medium);
    font-variant-numeric: tabular-nums;
  }
  .gdp-panel-chart__unit {
    fill: var(--ink-faint);
    font-size: 11px;
    font-weight: var(--fw-medium);
  }
  .gdp-panel-chart__direct-label {
    font-size: 13px;
    font-weight: var(--fw-medium);
  }
  .gdp-panel-chart__direct-label--agg { fill: var(--series-7); }
  .gdp-panel-chart__direct-label--pc { fill: var(--series-1); }
  .gdp-panel-chart__anno-leader {
    stroke: var(--ink-muted);
    stroke-width: 1;
    shape-rendering: crispEdges;
  }
  .gdp-panel-chart__anno-text {
    fill: var(--ink);
    font-size: 13px;
    font-weight: var(--fw-medium);
    font-variant-numeric: tabular-nums;
  }
</style>
