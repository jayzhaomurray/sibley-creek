---
/*
 * Panel2PerCapita - per-capita employment and hours.
 *
 * Pipeline emits `unemployment_level` (millions of persons) and
 * `aggregate_hours`. Per-capita derivation is not on disk; we render
 * the raw level series.
 *
 * Wave 5 fold (EDR brief Section 3): prime-age and youth triplets
 * (participation + employment + unemployment) added as secondary
 * toggle views (denominator-adjusted slack). Backend has all six
 * series per EDR brief; full toggle UI is deferred until the
 * centralized toggle pattern lands.
 *
 * Synthetic-data fallback removed.
 */

import type { PanelData } from "../_shared/panelData";
import PanelLiveChart from "../_shared/PanelLiveChart.astro";
import PanelEmpty from "../_shared/PanelEmpty.astro";

interface Props {
  data?: PanelData | null;
}

const { data = null } = Astro.props;
---
{data && data.primary ? (
  <PanelLiveChart
    primary={data.primary}
    secondary={data.secondary}
    primaryLabel="Unrate (M)"
    secondaryLabel="Hours"
    dataPanelAttr="labour-2"
    ariaLabel="Unemployment level and aggregate hours."
  />
) : (
  <PanelEmpty reason="Per-capita derivation not yet emitted." />
)}
