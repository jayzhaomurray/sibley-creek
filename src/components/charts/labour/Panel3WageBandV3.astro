---
/*
 * Panel3WageBandV3 - composition-adjusted vs headline wage growth, Y/Y.
 *
 * Editorial frame (art-director ratified 2026-05-12): two series only.
 * The payload is the persistent ~1pp gap between the BoC's composition-
 * adjusted LFS-Micro measure (the read the Bank actually watches) and
 * the headline LFS all-hourly-wages print. The gap is the story; the
 * area between the two lines carries it visually as a recession-band
 * ink wash, and a single upper-right annotation names the reading.
 *
 * Series:
 *   - PRIMARY: LFS-Micro Y/Y (BoC composition-adjusted). 1.5px solid
 *     pure ink, MTA-red terminal dot. Already arrives in Y/Y % from
 *     pipeline.
 *   - SECONDARY: LFS, all hourly wages Y/Y. 1px pure ink, dashed 4-2,
 *     no terminal dot. Pipeline emits the level (CAD/hr); wrapper
 *     derives Y/Y at render time.
 *
 * Cut from V2: SEPH (move to extras / drop), services CPI ex-shelter
 * (lives on a future inflation/household plate; including a real-wage
 * reference on a wage plate confuses the editorial frame).
 *
 * Reference rules: NONE. Art-director's call -- BoC has no formal wage
 * target; drawing a 2% / 3-3.5% reference risks misleading the reader
 * into thinking it's policy. The gap is the editorial payload, not the
 * distance from a benchmark.
 *
 * Recession band: 2020Q1-Q2 falls outside the 60-month window in 2026,
 * so skipped (defensive code retained in case the window is widened).
 *
 * Window: 60 months ending at the latest LFS print.
 *
 * Versioning: original Panel3WageBand.astro (V1, dollar-level lines)
 * and Panel3WageBandV2.astro (four-line band incl. SEPH + CPI ref) both
 * stay in place per the version-keep convention; V3 supersedes V2 in
 * the SectionLayout dispatch for `labour-panel-3`.
 */

import type { PanelData, SeriesPoint } from "../_shared/panelData";
import { decYear, tailWindow } from "../_shared/panelData";
import PanelEmpty from "../_shared/PanelEmpty.astro";

interface Props {
  data?: PanelData | null;
}
const { data = null } = Astro.props;

// ---- Y/Y derivation on level series -------------------------------------
// 12-period lag on monthly grids. Mirrors V2 / altUtils.yoy() shape.
function yoy(series: SeriesPoint[]): SeriesPoint[] {
  const out: SeriesPoint[] = [];
  for (let i = 0; i < series.length; i++) {
    const here = series[i]!;
    const prev = series[i - 12];
    if (
      !prev ||
      typeof prev.value !== "number" ||
      typeof here.value !== "number" ||
      prev.value === 0
    ) {
      out.push({ date: here.date, value: null });
    } else {
      out.push({
        date: here.date,
        value: ((here.value - prev.value) / prev.value) * 100,
      });
    }
  }
  return out;
}

// ---- Pull series --------------------------------------------------------
const lfsMicroRaw = data?.primary?.data ?? [];
const lfsAllRawLevels = data?.secondary?.data ?? [];

const lfsMicroAll = lfsMicroRaw; // already %
const lfsAllYoyAll = yoy(lfsAllRawLevels);

const hasData = lfsMicroAll.length > 0 && lfsAllYoyAll.length > 0;

// ---- Windowing (5 years) ------------------------------------------------
const WINDOW_MONTHS = 60;
const lfsMicroData = tailWindow(lfsMicroAll, WINDOW_MONTHS, "monthly");
const lfsAllData = tailWindow(lfsAllYoyAll, WINDOW_MONTHS, "monthly");

// ---- Geometry (pinned to PanelLiveChart canon) -------------------------
const VB_W = 720;
const VB_H = 405;
const M_L = 56;
const M_R = 152;  // wider right gutter to seat two-line LFS-Micro label
const M_T = 44;
const M_B = 40;
const PLOT_X0 = M_L;
const PLOT_Y0 = M_T;
const PLOT_W = VB_W - M_L - M_R;
const PLOT_H = VB_H - M_T - M_B;
const PLOT_X1 = PLOT_X0 + PLOT_W;
const PLOT_Y1 = PLOT_Y0 + PLOT_H;

// ---- x-domain spans both series ----------------------------------------
function xDomain(series: SeriesPoint[]): number[] {
  return series.map((d) => decYear(d.date)).filter((v) => !Number.isNaN(v));
}
const xs = [...xDomain(lfsMicroData), ...xDomain(lfsAllData)];
const xMin = xs.length > 0 ? Math.min(...xs) : 0;
const xMax = xs.length > 0 ? Math.max(...xs) : 1;

// ---- y-domain spans both series ----------------------------------------
function yValues(series: SeriesPoint[]): number[] {
  return series
    .map((p) => p.value)
    .filter((v): v is number => typeof v === "number" && !Number.isNaN(v));
}
const allY = [...yValues(lfsMicroData), ...yValues(lfsAllData)];
let yLo = 0;
let yHi = 1;
if (allY.length > 0) {
  const rawMin = Math.min(...allY);
  const rawMax = Math.max(...allY);
  const span = rawMax - rawMin || Math.max(1, Math.abs(rawMax) * 0.1);
  yLo = rawMin - span * 0.10;
  yHi = rawMax + span * 0.10;
}
const yRange = yHi - yLo || 1;
const crossesZero = yLo < 0 && yHi > 0;

function xScale(yr: number): number {
  if (xMax === xMin) return PLOT_X0 + PLOT_W / 2;
  return PLOT_X0 + ((yr - xMin) / (xMax - xMin)) * PLOT_W;
}
function yScale(v: number): number {
  return PLOT_Y0 + PLOT_H - ((v - yLo) / yRange) * PLOT_H;
}

// ---- Build gap-band polygon (drawn behind both lines) ------------------
//
// The polygon traces the top series along its forward sweep, then the
// bottom series in reverse. At indices where either series is null we
// break the polygon into sub-polygons (avoids degenerate connector
// segments). Series are joined on a shared monthly grid by date so the
// vertical bands between paired points read cleanly.
type Paired = { x: number; yHi: number; yLo: number };

function buildPairedGrid(
  a: SeriesPoint[],
  b: SeriesPoint[],
): Paired[] {
  // Index by date for a fast join; keep only dates where both sides
  // have a real value AND both decYears parse.
  const bMap = new Map<string, number>();
  for (const p of b) {
    if (typeof p.value === "number" && !Number.isNaN(p.value)) {
      bMap.set(p.date, p.value);
    }
  }
  const out: Paired[] = [];
  for (const p of a) {
    if (typeof p.value !== "number" || Number.isNaN(p.value)) continue;
    const bv = bMap.get(p.date);
    if (bv === undefined) continue;
    const xv = decYear(p.date);
    if (Number.isNaN(xv)) continue;
    const x = xScale(xv);
    // Higher value -> smaller screen y (yScale inverts). The polygon
    // wraps the visually-upper side first, then the lower side.
    const aY = yScale(p.value);
    const bY = yScale(bv);
    out.push({
      x,
      yHi: Math.min(aY, bY),  // top edge in screen pixels
      yLo: Math.max(aY, bY),  // bottom edge in screen pixels
    });
  }
  return out;
}

function buildGapBandPath(paired: Paired[]): string {
  if (paired.length < 2) return "";
  let d = `M${paired[0]!.x.toFixed(2)} ${paired[0]!.yHi.toFixed(2)} `;
  for (let i = 1; i < paired.length; i++) {
    d += `L${paired[i]!.x.toFixed(2)} ${paired[i]!.yHi.toFixed(2)} `;
  }
  for (let i = paired.length - 1; i >= 0; i--) {
    d += `L${paired[i]!.x.toFixed(2)} ${paired[i]!.yLo.toFixed(2)} `;
  }
  d += "Z";
  return d.trim();
}

const pairedGrid = buildPairedGrid(lfsMicroData, lfsAllData);
const gapBandPath = buildGapBandPath(pairedGrid);

// ---- Path builder ------------------------------------------------------
function buildLinePath(series: SeriesPoint[]): string {
  let d = "";
  let started = false;
  for (const pt of series) {
    if (typeof pt.value !== "number" || Number.isNaN(pt.value)) {
      started = false;
      continue;
    }
    const xv = decYear(pt.date);
    if (Number.isNaN(xv)) continue;
    const x = xScale(xv);
    const y = yScale(pt.value);
    d += `${started ? "L" : "M"}${x.toFixed(2)} ${y.toFixed(2)} `;
    started = true;
  }
  return d.trim();
}

const lfsMicroPath = buildLinePath(lfsMicroData);
const lfsAllPath = buildLinePath(lfsAllData);

// ---- Latest non-null point per series ----------------------------------
function lastReal(
  series: SeriesPoint[],
): { x: number; y: number; v: number; date: string } | null {
  for (let i = series.length - 1; i >= 0; i--) {
    const pt = series[i]!;
    if (typeof pt.value === "number" && !Number.isNaN(pt.value)) {
      const xv = decYear(pt.date);
      if (Number.isNaN(xv)) continue;
      return { x: xScale(xv), y: yScale(pt.value), v: pt.value, date: pt.date };
    }
  }
  return null;
}
const lastMicro = lastReal(lfsMicroData);
const lastLfsAll = lastReal(lfsAllData);

// ---- Y-axis ticks ------------------------------------------------------
function pickStride(lo: number, hi: number, target = 5): number {
  const span = hi - lo;
  if (!Number.isFinite(span) || span <= 0) return 1;
  const rough = span / target;
  const mag = Math.pow(10, Math.floor(Math.log10(rough)));
  const norm = rough / mag;
  let nice = 1;
  if (norm < 1.5) nice = 1;
  else if (norm < 3) nice = 2;
  else if (norm < 4) nice = 2.5;
  else if (norm < 7) nice = 5;
  else nice = 10;
  return nice * mag;
}
const yStride = pickStride(yLo, yHi);
const yTicks: number[] = [];
const yStart = Math.ceil(yLo / yStride) * yStride;
for (let v = yStart; v <= yHi + 1e-9; v += yStride) yTicks.push(Number(v.toFixed(6)));
if (yTicks.length === 0) yTicks.push(Number(((yLo + yHi) / 2).toFixed(6)));

// ---- X-axis year ticks -------------------------------------------------
const yearStart = Math.ceil(xMin);
const yearEnd = Math.floor(xMax);
const allYearTicks: Array<{ x: number; label: string }> = [];
for (let yr = yearStart; yr <= yearEnd; yr++) {
  const decY = yr + (1 - 0.5) / 12;
  if (decY < xMin || decY > xMax) continue;
  allYearTicks.push({ x: xScale(decY), label: String(yr) });
}
const xTickStride = Math.max(1, Math.ceil(allYearTicks.length / 5));
const xTicks = allYearTicks.filter((_, i) => i % xTickStride === 0);

// ---- Recession band (defensive; out of 5-year window in 2026) ---------
const recStart = 2020 + (2 - 0.5) / 12;
const recEnd = 2020 + (4 - 0.5) / 12;
const recVisible = recEnd >= xMin && recStart <= xMax;
const recX0 = recVisible ? xScale(Math.max(recStart, xMin)) : 0;
const recX1 = recVisible ? xScale(Math.min(recEnd, xMax)) : 0;

// ---- Direct-label placement -------------------------------------------
//
// Two labels at the right gutter. LFS-Micro is two-line (semibold
// "Composition-adjusted" + 70%-opacity "BoC's preferred"). LFS-all is
// one-line ("Headline"). Apr 4.5% vs Mar 3.1% should sit ~1.4pp apart
// (~14% of the y-range, comfortably above the L6 collision threshold);
// fall through to a simple natural-y placement and only invoke L6
// stacking if the gap collapses below LABEL_MIN_DY in some future
// vintage.
const LABEL_GAP_X = 10;

// LFS-Micro label group (two lines)
const microLabelX = lastMicro ? lastMicro.x + LABEL_GAP_X : 0;
const microLabelY = lastMicro ? lastMicro.y + 4 : 0;  // primary line baseline aligned to dot
const microLabelLine2Y = microLabelY + 14;

// LFS-all label (one line)
const allLabelX = lastLfsAll ? lastLfsAll.x + LABEL_GAP_X : 0;
const allLabelY = lastLfsAll ? lastLfsAll.y + 4 : 0;

// L6 collision check: if the LFS-Micro two-line block overlaps the
// LFS-all line, push the latter to maintain a 14px minimum from the
// LFS-Micro block. Order depends on which series sits higher.
let resolvedMicroY = microLabelY;
let resolvedMicroLine2Y = microLabelLine2Y;
let resolvedAllY = allLabelY;
if (lastMicro && lastLfsAll) {
  const microHi = resolvedMicroY - 10;
  const microLo = resolvedMicroLine2Y + 4;
  // If LFS-all sits between (overlap region), push it clear in the
  // direction that takes it AWAY from the LFS-Micro block. Two
  // candidates -- above or below the LFS-Micro block -- and we choose
  // by which side LFS-all is closer to before the push.
  if (resolvedAllY > microHi - 4 && resolvedAllY < microLo + 4) {
    const naturalAbove = resolvedAllY < (microHi + microLo) / 2;
    resolvedAllY = naturalAbove ? microHi - 4 : microLo + 14;
  }
}

// Bounds clamp: keep labels within the readable region.
function clamp(y: number): number {
  if (y < PLOT_Y0 + 4) return PLOT_Y0 + 4;
  if (y > PLOT_Y1 + M_B - 4) return PLOT_Y1 + M_B - 4;
  return y;
}
resolvedMicroY = clamp(resolvedMicroY);
resolvedMicroLine2Y = clamp(resolvedMicroLine2Y);
resolvedAllY = clamp(resolvedAllY);

const ariaLabel =
  "Composition-adjusted vs headline wage growth, year-over-year, last 60 months. The Bank of Canada's LFS-Micro composition-adjusted measure runs roughly a point below the headline LFS all-employees print since early 2024.";
---
{hasData ? (
  <div class="canon-chart" data-panel="labour-3-wage-band-v3">
    <svg
      class="canon-chart__svg"
      viewBox={`0 0 ${VB_W} ${VB_H}`}
      preserveAspectRatio="xMidYMid meet"
      role="img"
      aria-label={ariaLabel}
    >
      {/* Gap-band ink wash drawn BEHIND the lines, in front of the
         frame. Same token as the recession band -- 6% ink. The band
         IS the editorial fact; no separate callout to the shape. */}
      {gapBandPath && (
        <path
          class="wage-v3__gap-band"
          d={gapBandPath}
          fill="rgba(21, 23, 26, 0.06)"
          stroke="none"
        />
      )}

      {recVisible && (
        <rect
          class="canon-chart__recession"
          x={recX0.toFixed(2)}
          y={PLOT_Y0}
          width={Math.max(1, recX1 - recX0).toFixed(2)}
          height={PLOT_H}
        />
      )}

      {yTicks.map((v) => {
        const yy = yScale(v);
        if (crossesZero && Math.abs(v) < 1e-9) return null;
        return (
          <line
            class="canon-chart__gridline"
            x1={PLOT_X0}
            y1={yy.toFixed(2)}
            x2={PLOT_X1}
            y2={yy.toFixed(2)}
          />
        );
      })}

      {crossesZero && (
        <line
          class="canon-chart__zero-line"
          x1={PLOT_X0}
          y1={yScale(0).toFixed(2)}
          x2={PLOT_X1}
          y2={yScale(0).toFixed(2)}
        />
      )}

      <defs>
        <clipPath id="wage-v3-clip">
          <rect x={PLOT_X0} y={PLOT_Y0} width={PLOT_W} height={PLOT_H} />
        </clipPath>
      </defs>
      <g clip-path="url(#wage-v3-clip)">
        {/* Secondary (headline LFS-all) drawn first so primary sits on top */}
        {lfsAllPath && (
          <path class="wage-v3__secondary" d={lfsAllPath} fill="none" />
        )}
        {lfsMicroPath && (
          <path class="wage-v3__primary" d={lfsMicroPath} fill="none" />
        )}
      </g>

      {/* MTA-red terminal dot on the primary (LFS-Micro) only. */}
      {lastMicro && (
        <circle
          class="canon-chart__latest-dot"
          cx={lastMicro.x.toFixed(2)}
          cy={lastMicro.y.toFixed(2)}
          r="4"
        >
          <title>{`LFS-Micro Y/Y, ${lastMicro.date}: ${lastMicro.v.toFixed(2)}%`}</title>
        </circle>
      )}

      <rect
        class="canon-chart__frame"
        x={PLOT_X0}
        y={PLOT_Y0}
        width={PLOT_W}
        height={PLOT_H}
      />

      {xTicks.map((t) => (
        <g>
          <line
            class="canon-chart__xtick"
            x1={t.x.toFixed(2)}
            y1={PLOT_Y1.toFixed(2)}
            x2={t.x.toFixed(2)}
            y2={(PLOT_Y1 + 4).toFixed(2)}
          />
          <text
            class="canon-chart__xtick-label"
            x={t.x.toFixed(2)}
            y={(PLOT_Y1 + 18).toFixed(2)}
            text-anchor="middle"
          >{t.label}</text>
        </g>
      ))}

      {yTicks.map((v, i) => {
        const yy = yScale(v);
        const isTop = i === yTicks.length - 1;
        const txt = isTop ? `${v.toFixed(1)}%` : v.toFixed(1);
        return (
          <text
            class="canon-chart__ytick-label"
            x={(PLOT_X0 - 8).toFixed(2)}
            y={(yy + 4).toFixed(2)}
            text-anchor="end"
          >{txt}</text>
        );
      })}

      {/* Direct labels at line termini, right gutter. */}
      {lastMicro && (
        <>
          <text
            class="wage-v3__label-primary-line1"
            x={microLabelX.toFixed(2)}
            y={resolvedMicroY.toFixed(2)}
            text-anchor="start"
          >Composition-adjusted</text>
          <text
            class="wage-v3__label-primary-line2"
            x={microLabelX.toFixed(2)}
            y={resolvedMicroLine2Y.toFixed(2)}
            text-anchor="start"
          >BoC's preferred</text>
        </>
      )}
      {lastLfsAll && (
        <text
          class="wage-v3__label-secondary"
          x={allLabelX.toFixed(2)}
          y={resolvedAllY.toFixed(2)}
          text-anchor="start"
        >Headline</text>
      )}

    </svg>
  </div>
) : (
  <PanelEmpty reason="Wage chart V3 needs lfs_micro (primary, % Y/Y) and lfs_wages_all (secondary, level); one or both missing." />
)}

<style>
  .canon-chart { width: 100%; aspect-ratio: 16 / 9; background-color: var(--paper); overflow: visible; }
  .canon-chart__svg { display: block; width: 100%; height: 100%; overflow: visible; font-family: var(--font-sans); }

  /* Canon hairlines (shared) */
  .canon-chart__recession { fill: rgba(21, 23, 26, 0.06); }
  .canon-chart__gridline { stroke: var(--ink); stroke-width: 1; stroke-opacity: 0.18; shape-rendering: crispEdges; }
  .canon-chart__zero-line { stroke: var(--ink); stroke-width: 1; stroke-opacity: 1; shape-rendering: crispEdges; }
  .canon-chart__frame { fill: none; stroke: var(--ink); stroke-width: 1; shape-rendering: crispEdges; }
  .canon-chart__xtick { stroke: var(--ink); stroke-width: 1; shape-rendering: crispEdges; }
  .canon-chart__xtick-label {
    fill: var(--ink); font-family: var(--font-sans);
    font-size: 12px; font-weight: var(--fw-regular); font-variant-numeric: tabular-nums;
  }
  .canon-chart__ytick-label {
    fill: var(--ink); font-family: var(--font-mono);
    font-size: 12px; font-weight: var(--fw-regular); font-variant-numeric: tabular-nums;
  }
  .canon-chart__latest-dot { fill: var(--accent); stroke: none; }

  /* V3 line treatments. canon-chart__line classes are used so the
   * build-time text-vs-line overlap detector picks the strokes up. */
  .wage-v3__primary {
    /* canon-chart__line picked up by check_text_overlaps.mjs */
    stroke: var(--ink); stroke-width: 1.5; stroke-linejoin: round;
    stroke-linecap: round; fill: none; vector-effect: non-scaling-stroke;
  }
  .wage-v3__secondary {
    stroke: var(--ink); stroke-width: 1; stroke-dasharray: 4 2;
    stroke-linejoin: round; stroke-linecap: butt; fill: none;
    vector-effect: non-scaling-stroke;
  }
  .wage-v3__gap-band { pointer-events: none; }

  /* Direct labels at line termini. */
  .wage-v3__label-primary-line1 {
    fill: var(--ink); font-family: var(--font-sans);
    font-size: 13px; font-weight: var(--fw-semibold);
  }
  .wage-v3__label-primary-line2 {
    fill: var(--ink); font-family: var(--font-sans);
    font-size: 11px; font-weight: var(--fw-regular); fill-opacity: 0.7;
  }
  .wage-v3__label-secondary {
    fill: var(--ink); font-family: var(--font-sans);
    font-size: 13px; font-weight: var(--fw-regular);
  }

</style>
