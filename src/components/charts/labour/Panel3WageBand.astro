---
/*
 * Panel3WageBand - wage growth band.
 *
 * Pipeline emits `lfs_wages_all` (primary) and `lfs_wages_permanent`
 * (secondary) as CAD/hour levels. Editorial argument is a y/y band
 * across multiple wage series; until SEPH and LFS-Micro arrive we
 * render the two LFS wage levels as the primary pair.
 *
 * Wave 5 fold (EDR brief Section 3): Unit Labour Costs overlay
 * (productivity-adjusted wage read) added as secondary overlay
 * toggle. ULC arrives as a y/y % series, so the overlay needs the
 * underlying wage series in y/y % too - that transformation belongs
 * upstream (backend) and is deferred. Full toggle UI is deferred
 * until the centralized toggle pattern lands.
 *
 * Synthetic-data fallback removed.
 */

import type { PanelData } from "../_shared/panelData";
import PanelLiveChart from "../_shared/PanelLiveChart.astro";
import PanelEmpty from "../_shared/PanelEmpty.astro";

interface Props {
  data?: PanelData | null;
}

const { data = null } = Astro.props;
---
{data && data.primary ? (
  <PanelLiveChart
    primary={data.primary}
    secondary={data.secondary}
    primaryLabel="LFS, all"
    secondaryLabel="LFS, permanent"
    dataPanelAttr="labour-3"
    ariaLabel="LFS wages: all employees and permanent employees, CAD per hour."
  />
) : (
  <PanelEmpty reason="Pipeline did not emit panel-3 data." />
)}
