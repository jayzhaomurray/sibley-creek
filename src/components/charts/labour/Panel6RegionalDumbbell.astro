---
/*
 * Panel6RegionalDumbbell - regional dispersion.
 *
 * Editorial argument is a four-province dumbbell (ON / QC / AB / BC vs
 * Canada); pipeline currently emits ON and QC unemployment rates only.
 * We render the two available provincial series; full dumbbell defers.
 *
 * Synthetic-data fallback removed.
 */

import type { PanelData } from "../_shared/panelData";
import PanelLiveChart from "../_shared/PanelLiveChart.astro";
import PanelEmpty from "../_shared/PanelEmpty.astro";

interface Props {
  data?: PanelData | null;
}

const { data = null } = Astro.props;
---
{data && data.primary ? (
  <PanelLiveChart
    primary={data.primary}
    secondary={data.secondary}
    primaryLabel="Ontario u-rate"
    secondaryLabel="Quebec u-rate"
    dataPanelAttr="labour-6"
    ariaLabel="Provincial unemployment rates: Ontario and Quebec."
  />
) : (
  <PanelEmpty reason="Four-province dumbbell not yet emitted." />
)}
