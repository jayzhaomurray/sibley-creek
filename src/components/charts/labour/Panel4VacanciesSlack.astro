---
/*
 * Panel4VacanciesSlack - composite V/U time series + Beveridge curve scatter.
 *
 * Implements design/basics-layer-template.md Section 9.B Panel 4 +
 * research/wave2_labour_methodology.md Sections 2 and 3.
 *
 * Composite layout (one SVG, two sub-views stacked):
 *   A (top, ~60%): V/U ratio 3M-MA, 2015-present. Historical-anchor bands
 *     as background fills (NOT current-state classifier).
 *   B (bottom, ~40%): Beveridge-curve scatter. x = u-rate SA 3M-MA;
 *     y = vacancy rate NSA 3M-MA. 12-month trail in series-3, background
 *     points color-coded by year (sequential series-1 ramp).
 *
 * Bands per W2 Sec 2.3:
 *   < 0.30 slack | 0.30-0.45 below balance | 0.45-0.60 approaching |
 *   0.60-0.80 tight | >=0.80 exceptionally tight
 *
 * Plot vs SVG: hand-rolled SVG (zero JS).
 */

interface VuRow {
  date: string;        // "YYYY-MM"
  vu_ma3: number;      // V/U ratio, 3M MA
}
interface BeveridgePoint {
  date: string;
  year: number;
  u_ma3: number;       // %, SA, 3M MA
  v_ma3: number;       // %, NSA, 3M MA
}

interface Props {
  vu?: VuRow[];
  bev?: BeveridgePoint[];
  /** Annotation on latest V/U (sub-view A). */
  vuRecentAnnotation?: string;
  /** Annotation on Beveridge-curve direction-of-motion. */
  bevAnnotation?: string;
  /** Permanent annotation: post-COVID outward shift. */
  shiftAnnotation?: string;
  ariaLabel?: string;
}

function makeVu(): VuRow[] {
  // 2015-04 through 2026-04 = 133 months. 3M-MA smoothed pattern:
  // 0.25 (2015) -> dip during 2020 gap (April-Sept 2020 we just stop emitting)
  //  -> rise to 0.96 (Aug 2022) -> ease to ~0.47 (Apr 2026)
  const out: VuRow[] = [];
  let y = 2015;
  let m = 4;
  for (let i = 0; i < 133; i++) {
    // Skip Apr-Sep 2020 (structural gap)
    const inGap = (y === 2020 && m >= 4 && m <= 9);
    if (!inGap) {
      let v: number;
      if (i < 24) v = 0.25 + 0.05 * Math.sin(i * 0.4);
      else if (i < 60) v = 0.30 + (0.45 - 0.30) * ((i - 24) / 36);
      else if (i < 72) v = 0.45 + 0.1 * Math.sin(i * 0.4); // pre-COVID
      else if (i < 78) v = 0.35 - 0.05 * (i - 72); // COVID slump (around gap)
      else if (i < 90) v = 0.40 + (0.96 - 0.40) * ((i - 78) / 12); // ramp to 0.96
      else if (i < 102) v = 0.96 - (0.96 - 0.65) * ((i - 90) / 12);
      else if (i < 120) v = 0.65 - (0.65 - 0.52) * ((i - 102) / 18);
      else v = 0.52 - (0.52 - 0.47) * ((i - 120) / 13);
      out.push({
        date: `${y}-${String(m).padStart(2, "0")}`,
        vu_ma3: Number(Math.max(0, v).toFixed(3)),
      });
    }
    m += 1;
    if (m > 12) { m = 1; y += 1; }
  }
  return out;
}

function makeBev(): BeveridgePoint[] {
  // Same date span as V/U. Build u and v jointly.
  const out: BeveridgePoint[] = [];
  let y = 2015;
  let m = 4;
  for (let i = 0; i < 133; i++) {
    const inGap = (y === 2020 && m >= 4 && m <= 9);
    if (!inGap) {
      let u: number;
      let v: number;
      // Pre-pandemic: u ~ 7.0 -> 5.5; v ~ 2.0 -> 2.6
      if (i < 60) {
        u = 7.0 - 1.5 * (i / 60) + 0.2 * Math.sin(i * 0.4);
        v = 2.0 + 0.6 * (i / 60) + 0.1 * Math.cos(i * 0.3);
      } else if (i < 72) {
        // 2020 pandemic (around gap)
        u = 5.5 + 2.0 * Math.sin((i - 60) * 0.5);
        v = 2.6 - 0.3 * Math.sin((i - 60) * 0.5);
      } else if (i < 96) {
        // Post-COVID ramp into 2022 peak
        u = 5.5 - (5.5 - 4.9) * ((i - 72) / 24);
        v = 2.6 + (5.8 - 2.6) * ((i - 72) / 24);
      } else if (i < 120) {
        // 2024 normalization
        u = 4.9 + (6.0 - 4.9) * ((i - 96) / 24);
        v = 5.8 - (5.8 - 3.2) * ((i - 96) / 24);
      } else {
        // Recent: u rising, v easing further
        u = 6.0 + 0.05 * (i - 120);
        v = 3.2 - 0.08 * (i - 120);
      }
      out.push({
        date: `${y}-${String(m).padStart(2, "0")}`,
        year: y,
        u_ma3: Number(u.toFixed(2)),
        v_ma3: Number(v.toFixed(2)),
      });
    }
    m += 1;
    if (m > 12) { m = 1; y += 1; }
  }
  return out;
}

const {
  vu = makeVu(),
  bev = makeBev(),
  vuRecentAnnotation = "TK",
  bevAnnotation = "Loosening toward 2018-2019 territory",
  shiftAnnotation = "Post-COVID outward shift",
  ariaLabel = "V/U ratio and Beveridge curve, 2015-present (3M MA)",
} = Astro.props;

// ---- Geometry --------------------------------------------------------------
const VB_W = 720;
const VB_H = 540; // taller, to fit two stacked sub-views
const M_L = 44;
const M_R = 100;
const M_T = 36;
const M_B = 32;
const A_HEIGHT = 230;   // sub-view A (V/U)
const STRIP_GAP = 32;
const B_HEIGHT = VB_H - M_T - M_B - A_HEIGHT - STRIP_GAP;

// A (V/U)
const A_X0 = M_L;
const A_Y0 = M_T;
const A_W = VB_W - M_L - M_R;
const A_X1 = A_X0 + A_W;
const A_Y1 = A_Y0 + A_HEIGHT;

// B (Beveridge)
const B_X0 = M_L;
const B_Y0 = A_Y1 + STRIP_GAP;
const B_W = VB_W - M_L - M_R;
const B_X1 = B_X0 + B_W;
const B_Y1 = B_Y0 + B_HEIGHT;

// ---- Sub-view A: V/U time series ------------------------------------------
function decYearOf(d: string): number {
  const [yy, mm] = d.split("-").map(Number);
  return yy + (mm - 0.5) / 12;
}
const xsVu = vu.map((d) => decYearOf(d.date));
const xMinA = xsVu[0];
const xMaxA = xsVu[xsVu.length - 1];
const yMaxA = 1.0; // ceiling at 1.0 V/U
const yMinA = 0;

function xScaleA(decY: number): number {
  return A_X0 + ((decY - xMinA) / (xMaxA - xMinA)) * A_W;
}
function yScaleA(v: number): number {
  return A_Y0 + A_HEIGHT - ((v - yMinA) / (yMaxA - yMinA)) * A_HEIGHT;
}

// V/U line path — break the line at structural gap.
function buildVuPath(): string {
  let d = "";
  let lastDecY = -Infinity;
  vu.forEach((row, i) => {
    const decY = xsVu[i];
    const x = xScaleA(decY);
    const y = yScaleA(row.vu_ma3);
    // If gap > 0.2 year (3 months), start a new segment.
    const cmd = (i === 0 || decY - lastDecY > 0.2) ? "M" : "L";
    d += `${cmd}${x.toFixed(2)} ${y.toFixed(2)} `;
    lastDecY = decY;
  });
  return d;
}
const vuPath = buildVuPath();

// Historical-anchor bands. NOT current-state classifier.
interface AnchorBand { lo: number; hi: number; label: string; opacity: number; }
const anchorBands: AnchorBand[] = [
  { lo: 0.00, hi: 0.30, label: "Slack",                opacity: 0.04 },
  { lo: 0.30, hi: 0.45, label: "Below balance",        opacity: 0.06 },
  { lo: 0.45, hi: 0.60, label: "Approaching balance",  opacity: 0.08 },
  { lo: 0.60, hi: 0.80, label: "Tight",                opacity: 0.11 },
  { lo: 0.80, hi: 1.00, label: "Exceptionally tight",  opacity: 0.15 },
];

// V/U latest point.
const latestVu = vu[vu.length - 1];
const latestVuX = xScaleA(xsVu[xsVu.length - 1]);
const latestVuY = yScaleA(latestVu.vu_ma3);

// X ticks (A): every year
const yearStartA = Math.ceil(xMinA);
const yearEndA = Math.floor(xMaxA);
const yearTicksA: Array<{ x: number; label: string }> = [];
for (let yy = yearStartA; yy <= yearEndA; yy += 1) {
  const decY = yy + (1 - 0.5) / 12;
  if (decY < xMinA || decY > xMaxA) continue;
  yearTicksA.push({ x: xScaleA(decY), label: String(yy).slice(-2) });
}

// Y ticks (A): every 0.2
const yTicksA: number[] = [];
for (let v = 0; v <= 1.001; v += 0.2) yTicksA.push(Number(v.toFixed(1)));

// ---- Sub-view B: Beveridge curve ------------------------------------------
const uValsB = bev.map((p) => p.u_ma3);
const vValsB = bev.map((p) => p.v_ma3);
const uMinB = Math.floor(Math.min(...uValsB) - 0.5);
const uMaxB = Math.ceil(Math.max(...uValsB) + 0.5);
const vMinB = 0;
const vMaxB = Math.ceil(Math.max(...vValsB) + 0.5);

function xScaleB(u: number): number {
  return B_X0 + ((u - uMinB) / (uMaxB - uMinB)) * B_W;
}
function yScaleB(v: number): number {
  return B_Y0 + B_HEIGHT - ((v - vMinB) / (vMaxB - vMinB)) * B_HEIGHT;
}

// Background points: all but the most recent 12 months.
const trailLen = 12;
const trail = bev.slice(-trailLen);
const background = bev.slice(0, Math.max(0, bev.length - trailLen));

// Year color mapping: faded sequential ramp (proxy via opacity on series-1)
const yearMinBg = background.length > 0 ? background[0].year : 2015;
const yearMaxBg = background.length > 0 ? background[background.length - 1].year : 2025;
function bgYearOpacity(year: number): number {
  if (yearMaxBg === yearMinBg) return 0.4;
  const t = (year - yearMinBg) / (yearMaxBg - yearMinBg);
  return 0.15 + 0.45 * t; // 0.15 (oldest pale) to 0.6 (recent darker)
}

// Trail line path.
function buildTrailPath(): string {
  return trail
    .map((p, i) => {
      const x = xScaleB(p.u_ma3);
      const y = yScaleB(p.v_ma3);
      return `${i === 0 ? "M" : "L"}${x.toFixed(2)} ${y.toFixed(2)}`;
    })
    .join(" ");
}
const trailPath = buildTrailPath();

const latestBev = trail[trail.length - 1];
const latestBevX = xScaleB(latestBev.u_ma3);
const latestBevY = yScaleB(latestBev.v_ma3);

// X / Y ticks (B)
const xTicksB: number[] = [];
for (let v = uMinB; v <= uMaxB + 1e-9; v += 1) xTicksB.push(v);
const yTicksB: number[] = [];
for (let v = vMinB; v <= vMaxB + 1e-9; v += 1) yTicksB.push(v);

// ---- Annotation placement for V/U ----
const annoVuX = Math.min(latestVuX - 100, A_X1 - 220);
const annoVuY = Math.max(A_Y0 + 24, latestVuY - 40);
const annoVuAnchorX = latestVuX;
const annoVuAnchorY = latestVuY - 4;
---
<div class="labour-panel-chart" data-panel="4">
  <svg
    class="labour-panel-chart__svg"
    viewBox={`0 0 ${VB_W} ${VB_H}`}
    preserveAspectRatio="xMidYMid meet"
    role="img"
    aria-label={ariaLabel}
  >
    {/* =================== Sub-view A: V/U time series =================== */}
    <g>
      {/* Historical-anchor bands as horizontal background regions */}
      {anchorBands.map((b) => {
        const yTop = yScaleA(b.hi);
        const yBot = yScaleA(b.lo);
        return (
          <rect
            class="labour-panel-chart__anchor-band"
            x={A_X0.toFixed(2)}
            y={yTop.toFixed(2)}
            width={A_W.toFixed(2)}
            height={(yBot - yTop).toFixed(2)}
            style={`fill-opacity:${b.opacity}`}
          />
        );
      })}

      {/* Y gridlines */}
      {yTicksA.map((v) => {
        const y = yScaleA(v);
        return (
          <line
            class="labour-panel-chart__gridline"
            x1={A_X0}
            y1={y.toFixed(2)}
            x2={A_X1}
            y2={y.toFixed(2)}
          />
        );
      })}

      {/* V/U line */}
      <path class="labour-panel-chart__vu-line" d={vuPath} fill="none" />

      {/* Latest V/U marker */}
      <circle
        class="labour-panel-chart__vu-marker"
        cx={latestVuX.toFixed(2)}
        cy={latestVuY.toFixed(2)}
        r="4"
      >
        <title>{`${latestVu.date}: V/U = ${latestVu.vu_ma3.toFixed(2)}`}</title>
      </circle>

      {/* X axis (A) */}
      <line
        class="labour-panel-chart__xaxis"
        x1={A_X0}
        y1={A_Y1.toFixed(2)}
        x2={A_X1}
        y2={A_Y1.toFixed(2)}
      />
      {yearTicksA.map((t) => (
        <g>
          <line
            class="labour-panel-chart__xtick"
            x1={t.x.toFixed(2)}
            y1={A_Y1.toFixed(2)}
            x2={t.x.toFixed(2)}
            y2={(A_Y1 + 4).toFixed(2)}
          />
          <text
            class="labour-panel-chart__xtick-label"
            x={t.x.toFixed(2)}
            y={(A_Y1 + 16).toFixed(2)}
            text-anchor="middle"
          >{`'${t.label}`}</text>
        </g>
      ))}

      {/* Y axis labels (A) */}
      {yTicksA.map((v, i) => {
        const y = yScaleA(v);
        const isTop = i === yTicksA.length - 1;
        return (
          <text
            class="labour-panel-chart__ytick-label"
            x={(A_X0 - 6).toFixed(2)}
            y={(y + 3.5).toFixed(2)}
            text-anchor="end"
          >{`${v.toFixed(1)}${isTop ? " V/U" : ""}`}</text>
        );
      })}

      {/* Band labels at right rail */}
      {anchorBands.map((b) => {
        const yMid = (yScaleA(b.hi) + yScaleA(b.lo)) / 2;
        return (
          <text
            class="labour-panel-chart__band-label"
            x={(A_X1 + 6).toFixed(2)}
            y={(yMid + 3).toFixed(2)}
            text-anchor="start"
          >{b.label}</text>
        );
      })}

      {/* Sub-view title */}
      <text
        class="labour-panel-chart__subview-title"
        x={A_X0.toFixed(2)}
        y={(A_Y0 - 18).toFixed(2)}
        text-anchor="start"
      >V/U ratio (3M MA)</text>

      {/* Annotation: latest V/U */}
      {vuRecentAnnotation && (
        <g>
          <line
            class="labour-panel-chart__anno-leader"
            x1={(annoVuX + 4).toFixed(2)}
            y1={annoVuY.toFixed(2)}
            x2={annoVuAnchorX.toFixed(2)}
            y2={annoVuY.toFixed(2)}
          />
          <line
            class="labour-panel-chart__anno-leader"
            x1={annoVuAnchorX.toFixed(2)}
            y1={annoVuY.toFixed(2)}
            x2={annoVuAnchorX.toFixed(2)}
            y2={annoVuAnchorY.toFixed(2)}
          />
          <text
            class="labour-panel-chart__anno-text"
            x={annoVuX.toFixed(2)}
            y={(annoVuY + 4).toFixed(2)}
            text-anchor="end"
          >{vuRecentAnnotation}</text>
        </g>
      )}
    </g>

    {/* =================== Sub-view B: Beveridge curve =================== */}
    <g>
      {/* Background grid */}
      {xTicksB.map((v) => (
        <line
          class="labour-panel-chart__gridline"
          x1={xScaleB(v).toFixed(2)}
          y1={B_Y0}
          x2={xScaleB(v).toFixed(2)}
          y2={B_Y1.toFixed(2)}
        />
      ))}
      {yTicksB.map((v) => (
        <line
          class="labour-panel-chart__gridline"
          x1={B_X0}
          y1={yScaleB(v).toFixed(2)}
          x2={B_X1}
          y2={yScaleB(v).toFixed(2)}
        />
      ))}

      {/* Background points (history) */}
      {background.map((p) => (
        <circle
          class="labour-panel-chart__bev-bg"
          cx={xScaleB(p.u_ma3).toFixed(2)}
          cy={yScaleB(p.v_ma3).toFixed(2)}
          r="2.5"
          style={`fill-opacity:${bgYearOpacity(p.year)}`}
        >
          <title>{`${p.date}: u=${p.u_ma3.toFixed(1)}%, v=${p.v_ma3.toFixed(1)}%`}</title>
        </circle>
      ))}

      {/* Trail (12-month connected path) */}
      <path class="labour-panel-chart__bev-trail" d={trailPath} fill="none" />
      {trail.map((p, i) => {
        const isLast = i === trail.length - 1;
        return (
          <circle
            class:list={["labour-panel-chart__bev-trail-pt", { "labour-panel-chart__bev-trail-pt--latest": isLast }]}
            cx={xScaleB(p.u_ma3).toFixed(2)}
            cy={yScaleB(p.v_ma3).toFixed(2)}
            r={isLast ? "5" : "3"}
          >
            <title>{`${p.date}: u=${p.u_ma3.toFixed(1)}%, v=${p.v_ma3.toFixed(1)}%`}</title>
          </circle>
        );
      })}

      {/* X axis (B) */}
      <line
        class="labour-panel-chart__xaxis"
        x1={B_X0}
        y1={B_Y1.toFixed(2)}
        x2={B_X1}
        y2={B_Y1.toFixed(2)}
      />
      {xTicksB.map((v) => (
        <text
          class="labour-panel-chart__xtick-label"
          x={xScaleB(v).toFixed(2)}
          y={(B_Y1 + 14).toFixed(2)}
          text-anchor="middle"
        >{`${v}%`}</text>
      ))}
      {yTicksB.map((v, i) => {
        const isTop = i === yTicksB.length - 1;
        return (
          <text
            class="labour-panel-chart__ytick-label"
            x={(B_X0 - 6).toFixed(2)}
            y={(yScaleB(v) + 3.5).toFixed(2)}
            text-anchor="end"
          >{`${v}${isTop ? "%" : ""}`}</text>
        );
      })}

      {/* Axis labels for Beveridge */}
      <text
        class="labour-panel-chart__axis-title"
        x={(B_X0 + B_W / 2).toFixed(2)}
        y={(B_Y1 + 28).toFixed(2)}
        text-anchor="middle"
      >Unemployment rate (SA, 3M MA)</text>
      <text
        class="labour-panel-chart__axis-title"
        x={(B_X0 - 32).toFixed(2)}
        y={(B_Y0 + B_HEIGHT / 2).toFixed(2)}
        text-anchor="middle"
        transform={`rotate(-90 ${(B_X0 - 32).toFixed(2)} ${(B_Y0 + B_HEIGHT / 2).toFixed(2)})`}
      >Vacancy rate (NSA, 3M MA)</text>

      {/* Sub-view title */}
      <text
        class="labour-panel-chart__subview-title"
        x={B_X0.toFixed(2)}
        y={(B_Y0 - 18).toFixed(2)}
        text-anchor="start"
      >Beveridge curve (12-month trail)</text>

      {/* Direction-of-motion annotation near latest point */}
      {bevAnnotation && (
        <text
          class="labour-panel-chart__bev-anno"
          x={(latestBevX + 10).toFixed(2)}
          y={(latestBevY - 6).toFixed(2)}
          text-anchor="start"
        >{`${latestBev.date}: ${bevAnnotation}`}</text>
      )}

      {/* Permanent outward-shift annotation in whitespace */}
      {shiftAnnotation && (
        <text
          class="labour-panel-chart__bev-shift"
          x={(B_X1 - 6).toFixed(2)}
          y={(B_Y0 + 14).toFixed(2)}
          text-anchor="end"
        >{shiftAnnotation}</text>
      )}
    </g>

    {/* Chart-foot NSA/SA disclosure (template Sec 9.B) */}
    <text
      class="labour-panel-chart__foot-disclosure"
      x={M_L.toFixed(2)}
      y={(VB_H - 4).toFixed(2)}
      text-anchor="start"
    >Vacancy: NSA, 3M MA (JVWS, structural gap Apr-Sep 2020). Unemployment: SA, 3M MA (LFS).</text>
  </svg>
</div>

<style>
  /* Vignelli v1.0 canon-compliant restyle (2026-05-11). Composite: V/U
     time series (top) + Beveridge curve (bottom). All series in pure ink;
     anchor bands and history points are ink at various low opacities.
     MTA red latest dot on V/U latest and on Beveridge curve latest. */
  .labour-panel-chart { width: 100%; aspect-ratio: 720 / 540; background-color: var(--paper); overflow: visible; }
  .labour-panel-chart__svg { display: block; width: 100%; height: 100%; overflow: visible; font-family: var(--font-sans); }
  .labour-panel-chart__gridline {
    stroke: var(--ink); stroke-width: 1; stroke-opacity: 0.18; shape-rendering: crispEdges;
  }
  .labour-panel-chart__anchor-band { fill: var(--ink); stroke: none; }
  .labour-panel-chart__vu-line {
    stroke: var(--ink); stroke-width: 1.5; stroke-linejoin: round; stroke-linecap: round;
    fill: none; vector-effect: non-scaling-stroke;
  }
  .labour-panel-chart__vu-marker { fill: var(--accent); stroke: none; }
  .labour-panel-chart__bev-bg { fill: var(--ink); stroke: none; }
  .labour-panel-chart__bev-trail {
    stroke: var(--ink); stroke-width: 1.5; stroke-linejoin: round; stroke-linecap: round;
    fill: none; vector-effect: non-scaling-stroke;
  }
  .labour-panel-chart__bev-trail-pt { fill: var(--ink); fill-opacity: 0.65; }
  .labour-panel-chart__bev-trail-pt--latest { fill: var(--accent); fill-opacity: 1; stroke: none; }
  .labour-panel-chart__xaxis { stroke: var(--ink); stroke-width: 1; shape-rendering: crispEdges; }
  .labour-panel-chart__xtick { stroke: var(--ink); stroke-width: 1; shape-rendering: crispEdges; }
  .labour-panel-chart__xtick-label {
    fill: var(--ink); font-family: var(--font-sans);
    font-size: 12px; font-weight: var(--fw-regular); font-variant-numeric: tabular-nums;
  }
  .labour-panel-chart__ytick-label {
    fill: var(--ink); font-family: var(--font-mono);
    font-size: 12px; font-weight: var(--fw-regular); font-variant-numeric: tabular-nums;
  }
  .labour-panel-chart__band-label {
    fill: var(--ink); font-family: var(--font-sans);
    font-size: 11px; font-weight: var(--fw-semibold); letter-spacing: 0.02em;
  }
  .labour-panel-chart__axis-title {
    fill: var(--ink); font-family: var(--font-sans);
    font-size: 12px; font-weight: var(--fw-regular);
  }
  .labour-panel-chart__subview-title {
    fill: var(--ink); font-family: var(--font-sans);
    font-size: 11px; font-weight: var(--fw-semibold); letter-spacing: 0.18em;
  }
