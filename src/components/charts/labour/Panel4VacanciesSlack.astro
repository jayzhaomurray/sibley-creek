---
/*
 * Panel4VacanciesSlack - vacancies and slack.
 *
 * Pipeline emits `job_vacancy_rate` (primary, %) and
 * `job_vacancy_level` (secondary). Editorial argument is V/U ratio +
 * Beveridge scatter; the composite derivation is not on disk. We
 * render the vacancy rate as the primary single series.
 *
 * Synthetic-data fallback removed.
 */

import type { PanelData } from "../_shared/panelData";
import PanelLiveChart from "../_shared/PanelLiveChart.astro";
import PanelEmpty from "../_shared/PanelEmpty.astro";

interface Props {
  data?: PanelData | null;
}

const { data = null } = Astro.props;
---
{data && data.primary ? (
  <PanelLiveChart
    primary={data.primary}
    secondary={data.secondary}
    primaryLabel="Vacancy rate"
    secondaryLabel="Vacancy level"
    dataPanelAttr="labour-4"
    ariaLabel="Job vacancy rate, percent."
  />
) : (
  <PanelEmpty reason="V/U ratio and Beveridge scatter not yet emitted." />
)}
