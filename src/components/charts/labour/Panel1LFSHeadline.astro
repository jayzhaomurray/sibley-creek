---
/*
 * Panel1LFSHeadline - LFS headline: unemployment rate, employment rate, participation.
 *
 * Vignelli v1.0 canon-compliant rebuild (2026-05-11). Anchors to
 * src/components/charts/_canon_reference/PanelCanonReference.astro and
 * design/canon_reference_panel.md (Redline 2 - the multi-series stress test).
 *
 * Tri-series treatment with dual axis (justified per canon: u-rate at ~6%
 * and participation at ~65% genuinely diverge in scale):
 *   - Unemployment (primary)  : pure ink 1.5px solid, MTA red latest dot,
 *                               Manrope 600 "Unemployment" direct label.
 *   - Employment rate (secondary): pure ink 1px dashed `4 2`, no dot,
 *                                  Manrope 400 "Emp. rate" direct label.
 *   - Participation (tertiary, R-axis): pure ink 1px dashed `2 3`, no
 *                                       dot, Manrope 400 "Participation (R)"
 *                                       smaller direct label.
 *
 * Hue is never recruited; weight + dash + axis-side do the work.
 * Y-axis ticks: Plex Mono on both left and right axes.
 *
 * Data contract preserved: { date, unrate, emprate, partrate }.
 */

interface MonthlyPoint {
  date: string;
  unrate: number;
  emprate: number;
  partrate: number;
}

interface Props {
  data?: MonthlyPoint[];
  recentAnnotation?: string;
  ariaLabel?: string;
}

function makePlaceholder(): MonthlyPoint[] {
  const out: MonthlyPoint[] = [];
  let y = 2021;
  let m = 5;
  for (let i = 0; i < 60; i++) {
    let u: number;
    if (i < 9) u = 7.5 - (7.5 - 5.2) * (i / 9);
    else if (i < 30) u = 5.2 + 0.1 * Math.sin(i * 0.5);
    else if (i < 50) u = 5.2 + (6.2 - 5.2) * ((i - 30) / 20);
    else u = 6.2 + (i - 50) * 0.02;
    const er = 62.5 - 0.04 * (i - 12) + 0.3 * Math.sin(i * 0.4);
    let pr: number;
    if (i < 18) pr = 65.4 + 0.2 * Math.sin(i * 0.3);
    else pr = 65.4 - 0.025 * (i - 18) + 0.15 * Math.cos(i * 0.5);
    out.push({
      date: `${y}-${String(m).padStart(2, "0")}`,
      unrate: Number(u.toFixed(2)),
      emprate: Number(er.toFixed(2)),
      partrate: Number(pr.toFixed(2)),
    });
    m += 1;
    if (m > 12) { m = 1; y += 1; }
  }
  out[out.length - 4].unrate = 6.0;
  out[out.length - 3].unrate = 6.1;
  out[out.length - 2].unrate = 6.1;
  out[out.length - 1].unrate = 6.1;
  return out;
}

const {
  data = makePlaceholder(),
  recentAnnotation = "**Apr** unemployment at 6.1%; participation has slipped four straight months.",
  ariaLabel = "LFS headline: unemployment rate, employment rate, participation rate, last 5 years. Latest print is the most recent month.",
} = Astro.props;

// ---- Geometry --------------------------------------------------------------
const VB_W = 720;
const VB_H = 405;
const M_L = 56;
const M_R = 100; // right gutter for secondary axis labels + direct labels
const M_T = 44;
const M_B = 40;
const PLOT_X0 = M_L;
const PLOT_Y0 = M_T;
const PLOT_W = VB_W - M_L - M_R;
const PLOT_H = VB_H - M_T - M_B;
const PLOT_X1 = PLOT_X0 + PLOT_W;
const PLOT_Y1 = PLOT_Y0 + PLOT_H;

const n = data.length;
function decYearOf(d: string): number {
  const [yy, mm] = d.split("-").map(Number);
  return yy + (mm - 0.5) / 12;
}
const xs = data.map((d) => decYearOf(d.date));
const xMin = xs[0];
const xMax = xs[xs.length - 1];

// Primary axis: unrate (4-9%) and emprate (59-63%) share a percent axis.
const primaryVals = data.flatMap((d) => [d.unrate, d.emprate]);
const pLo = Math.floor(Math.min(...primaryVals)) - 1;
const pHi = Math.ceil(Math.max(...primaryVals)) + 1;

// Secondary axis: partrate, tighter range.
const sLo = 62;
const sHi = 68;

function xScale(decY: number): number {
  return PLOT_X0 + ((decY - xMin) / (xMax - xMin)) * PLOT_W;
}
function yScalePrimary(v: number): number {
  return PLOT_Y0 + PLOT_H - ((v - pLo) / (pHi - pLo)) * PLOT_H;
}
function yScaleSecondary(v: number): number {
  return PLOT_Y0 + PLOT_H - ((v - sLo) / (sHi - sLo)) * PLOT_H;
}

function buildLine(pickV: (d: MonthlyPoint) => number, scaleFn: (v: number) => number): string {
  return data
    .map((d, i) => {
      const x = xScale(xs[i]);
      const y = scaleFn(pickV(d));
      return `${i === 0 ? "M" : "L"}${x.toFixed(2)} ${y.toFixed(2)}`;
    })
    .join(" ");
}
const unratePath = buildLine((d) => d.unrate, yScalePrimary);
const empratePath = buildLine((d) => d.emprate, yScalePrimary);
const partratePath = buildLine((d) => d.partrate, yScaleSecondary);

// ---- Y ticks (primary) ----------------------------------------------------
function pickStride(lo: number, hi: number): number {
  const span = hi - lo;
  for (const s of [1, 2, 2.5, 5]) {
    const n = Math.round(span / s);
    if (n >= 3 && n <= 5) return s;
  }
  return Math.max(1, Math.round(span / 4));
}
const pStride = pickStride(pLo, pHi);
const yTicksPrimary: number[] = [];
for (let v = pLo; v <= pHi + 1e-9; v += pStride) yTicksPrimary.push(v);

const yTicksSecondary: number[] = [];
for (let v = sLo; v <= sHi + 1e-9; v += 2) yTicksSecondary.push(v);

// X ticks
const yearStart = Math.ceil(xMin);
const yearEnd = Math.floor(xMax);
const allYearTicks: Array<{ x: number; label: string }> = [];
for (let yy = yearStart; yy <= yearEnd; yy++) {
  const decY = yy + (1 - 0.5) / 12;
  if (decY < xMin || decY > xMax) continue;
  allYearTicks.push({ x: xScale(decY), label: String(yy) });
}
const xTickStride = Math.max(1, Math.ceil(allYearTicks.length / 5));
const xTicks = allYearTicks.filter((_, i) => i % xTickStride === 0);

// ---- Latest --------------------------------------------------------------
const latest = data[n - 1];
const latestX = xScale(xs[n - 1]);
const latestUY = yScalePrimary(latest.unrate);
const latestEY = yScalePrimary(latest.emprate);
const latestPY = yScaleSecondary(latest.partrate);

// ---- Annotation ----------------------------------------------------------
function parseAnchor(s: string): Array<{ text: string; bold: boolean }> {
  const parts: Array<{ text: string; bold: boolean }> = [];
  const re = /\*\*([^*]+)\*\*/g;
  let last = 0;
  let m: RegExpExecArray | null;
  while ((m = re.exec(s)) !== null) {
    if (m.index > last) parts.push({ text: s.slice(last, m.index), bold: false });
    parts.push({ text: m[1], bold: true });
    last = m.index + m[0].length;
  }
  if (last < s.length) parts.push({ text: s.slice(last), bold: false });
  return parts;
}
const annoParts = recentAnnotation ? parseAnchor(recentAnnotation) : [];
const annoX0 = PLOT_X0 + 18;
const annoY0 = PLOT_Y0 + 22;
const annoMaxWidth = PLOT_W * 0.46;
const leaderStartX = annoX0 + Math.min(annoMaxWidth, 220);
const leaderStartY = annoY0 - 4;
const leaderEndX = latestX - 7;
const leaderEndY = latestUY;
---
<div class="canon-chart" data-panel="labour-1">
  <svg
    class="canon-chart__svg"
    viewBox={`0 0 ${VB_W} ${VB_H}`}
    preserveAspectRatio="xMidYMid meet"
    role="img"
    aria-label={ariaLabel}
  >
    {yTicksPrimary.map((v) => (
      <line class="canon-chart__gridline"
        x1={PLOT_X0} y1={yScalePrimary(v).toFixed(2)}
        x2={PLOT_X1} y2={yScalePrimary(v).toFixed(2)} />
    ))}

    {/* Tertiary: participation (right axis, sparse dash 2 3) */}
    <path class="canon-chart__line-tertiary" d={partratePath} fill="none" />

    {/* Secondary: employment rate (dashed 4 2) */}
    <path class="canon-chart__line-secondary" d={empratePath} fill="none" />

    {/* Primary: unemployment rate (solid pure ink) */}
    <path class="canon-chart__line" d={unratePath} fill="none" />

    {/* Hit areas - primary u-rate only, native title tooltips */}
    {data.map((d, i) => {
      const x = xScale(xs[i]);
      return (
        <circle class="canon-chart__hit" cx={x.toFixed(2)} cy={yScalePrimary(d.unrate).toFixed(2)} r="4">
          <title>{`${d.date}: u-rate ${d.unrate.toFixed(1)}%, emp ${d.emprate.toFixed(1)}%, part ${d.partrate.toFixed(1)}%`}</title>
        </circle>
      );
    })}

    {/* MTA red latest dot on the primary u-rate */}
    <circle class="canon-chart__latest-dot" cx={latestX.toFixed(2)} cy={latestUY.toFixed(2)} r="4">
      <title>{`Latest: ${latest.date}: ${latest.unrate.toFixed(1)}% unemployment`}</title>
    </circle>

    <rect class="canon-chart__frame" x={PLOT_X0} y={PLOT_Y0} width={PLOT_W} height={PLOT_H} />

    {xTicks.map((t) => (
      <g>
        <line class="canon-chart__xtick" x1={t.x.toFixed(2)} y1={PLOT_Y1.toFixed(2)}
          x2={t.x.toFixed(2)} y2={(PLOT_Y1 + 4).toFixed(2)} />
        <text class="canon-chart__xtick-label" x={t.x.toFixed(2)} y={(PLOT_Y1 + 18).toFixed(2)}
          text-anchor="middle">{t.label}</text>
      </g>
    ))}

    {/* Primary (left) y-axis labels - Plex Mono */}
    {yTicksPrimary.map((v, i) => {
      const y = yScalePrimary(v);
      const isTop = i === yTicksPrimary.length - 1;
      const txt = isTop ? `${v.toFixed(0)}%` : `${v.toFixed(0)}`;
      return <text class="canon-chart__ytick-label" x={(PLOT_X0 - 8).toFixed(2)} y={(y + 4).toFixed(2)}
        text-anchor="end">{txt}</text>;
    })}

    {/* Secondary (right) y-axis labels - Plex Mono */}
    {yTicksSecondary.map((v, i) => {
      const y = yScaleSecondary(v);
      const isTop = i === yTicksSecondary.length - 1;
      const txt = isTop ? `${v.toFixed(0)}%` : `${v.toFixed(0)}`;
      return <text class="canon-chart__ytick-label" x={(PLOT_X1 + 8).toFixed(2)} y={(y + 4).toFixed(2)}
        text-anchor="start">{txt}</text>;
    })}

    {/* Direct labels - weight contrast does hierarchy work */}
    <text class="canon-chart__direct-label" x={(latestX + 10).toFixed(2)} y={(latestUY + 4).toFixed(2)}
      text-anchor="start">Unemployment</text>
    <text class="canon-chart__direct-label-secondary" x={(latestX + 10).toFixed(2)} y={(latestEY + 4).toFixed(2)}
      text-anchor="start">Emp. rate</text>
    <text class="canon-chart__direct-label-tertiary" x={(latestX + 10).toFixed(2)} y={(latestPY + 4).toFixed(2)}
      text-anchor="start">Participation (R)</text>

    {recentAnnotation && (
      <g class="canon-chart__annotation">
        <line class="canon-chart__anno-leader"
          x1={leaderStartX.toFixed(2)} y1={leaderStartY.toFixed(2)}
          x2={leaderEndX.toFixed(2)} y2={leaderEndY.toFixed(2)} />
        <foreignObject x={annoX0.toFixed(2)} y={(annoY0 - 18).toFixed(2)}
          width={annoMaxWidth.toFixed(2)} height="44">
          <p class="canon-chart__anno-text">
            {annoParts.map((part) =>
              part.bold
                ? <strong class="canon-chart__anno-anchor">{part.text}</strong>
                : <span>{part.text}</span>
            )}
          </p>
        </foreignObject>
      </g>
    )}
  </svg>
</div>

<style>
  .canon-chart { width: 100%; aspect-ratio: 16 / 9; background-color: var(--paper); overflow: visible; }
  .canon-chart__svg { display: block; width: 100%; height: 100%; overflow: visible; font-family: var(--font-sans); }
  .canon-chart__gridline { stroke: var(--ink); stroke-width: 1; stroke-opacity: 0.18; shape-rendering: crispEdges; }
  .canon-chart__line {
    stroke: var(--ink); stroke-width: 1.5; stroke-linejoin: round; stroke-linecap: round;
    fill: none; vector-effect: non-scaling-stroke;
  }
  .canon-chart__line-secondary {
    stroke: var(--ink); stroke-width: 1; stroke-dasharray: 4 2;
    stroke-linejoin: round; fill: none; vector-effect: non-scaling-stroke;
  }
  .canon-chart__line-tertiary {
    stroke: var(--ink); stroke-width: 1; stroke-dasharray: 2 3;
    stroke-linejoin: round; fill: none; vector-effect: non-scaling-stroke;
  }
  .canon-chart__hit { fill: transparent; pointer-events: all; }
  .canon-chart__latest-dot { fill: var(--accent); stroke: none; }
  .canon-chart__frame { fill: none; stroke: var(--ink); stroke-width: 1; shape-rendering: crispEdges; }
  .canon-chart__xtick { stroke: var(--ink); stroke-width: 1; shape-rendering: crispEdges; }
  .canon-chart__xtick-label {
    fill: var(--ink); font-family: var(--font-sans);
    font-size: 12px; font-weight: var(--fw-regular); font-variant-numeric: tabular-nums;
  }
  .canon-chart__ytick-label {
    fill: var(--ink); font-family: var(--font-mono);
    font-size: 12px; font-weight: var(--fw-regular); font-variant-numeric: tabular-nums;
  }
  .canon-chart__direct-label {
    fill: var(--ink); font-family: var(--font-sans);
    font-size: 13px; font-weight: var(--fw-semibold);
  }
  .canon-chart__direct-label-secondary {
    fill: var(--ink); font-family: var(--font-sans);
    font-size: 13px; font-weight: var(--fw-regular);
  }
  .canon-chart__direct-label-tertiary {
    fill: var(--ink); font-family: var(--font-sans);
    font-size: 12px; font-weight: var(--fw-regular);
  }
  .canon-chart__anno-leader { stroke: var(--ink); stroke-width: 1; shape-rendering: crispEdges; fill: none; }
  .canon-chart__anno-text {
    margin: 0; color: var(--ink); font-family: var(--font-sans);
    font-size: 15px; font-weight: var(--fw-regular); line-height: 1.30;
  }
  .canon-chart__anno-anchor { font-weight: var(--fw-semibold); }
</style>
