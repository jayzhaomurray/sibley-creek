---
/*
 * Panel1LFSHeadline - LFS headline: unemployment and employment rates.
 *
 * Pipeline emits `unemployment_rate` (primary) and `employment_rate`
 * (secondary) as percent series. Both share units and render directly.
 *
 * Wave 5 fold (EDR brief Section 3): youth (15-24) and prime-age
 * (25-54) unemployment rates added as secondary toggle views. Same
 * units (%) as the headline so the eventual toggle can live on the
 * same axis. Deferred until the centralized toggle pattern lands.
 *
 * Synthetic-data fallback removed.
 */

import type { PanelData } from "../_shared/panelData";
import PanelLiveChart from "../_shared/PanelLiveChart.astro";
import PanelEmpty from "../_shared/PanelEmpty.astro";

interface Props {
  data?: PanelData | null;
}

const { data = null } = Astro.props;
---
{data && data.primary ? (
  <PanelLiveChart
    primary={data.primary}
    secondary={data.secondary}
    primaryLabel="Unrate"
    secondaryLabel="Emp. rate"
    dataPanelAttr="labour-1"
    ariaLabel="Unemployment rate and employment rate."
  />
) : (
  <PanelEmpty reason="Pipeline did not emit panel-1 data." />
)}
