---
/*
 * Panel6RegionalSmallMultiples - provincial unemployment as 4-up small
 * multiples, each panel anchored against the Canadian national rate.
 *
 * Diagnosis (editorial/chart-diagnosis/labour.md P5): five lines on one
 * panel is the classic spaghetti problem; the eye cannot track each
 * province. Fix: one small multiple per major province (BC / ON / QC /
 * AB) with Canada as a faint reference line in each. The four-way split
 * the title names becomes the visual structure.
 *
 * Reading order west to east: BC, AB, ON, QC. This is the geographic
 * scan a Canadian reader walks (left coast across the prairies to
 * central Canada) and also lines up with the federal political map.
 *
 * Color decision pending art-director note (chart-diagnosis P5):
 * monochrome version first - Canada as a 1px dashed reference line,
 * province as the 1.5px solid primary stroke. If art-director rules
 * that a second color helps, swap the dashed line for a faint hue.
 *
 * Pipeline shape: panel-6 emits ON (primary), QC (secondary), AB
 * (tertiary), and BC + CA in `extras`. This wrapper pulls all five.
 *
 * Custom SVG. Pattern cribbed from Panel1HeadlineGDPV3's small-multiples
 * subPanel builder + Panel1LFSHeadlineSmallMultiples (sibling file).
 */

import type { PanelData, SeriesPoint } from "../_shared/panelData";
import { decYear, tailWindow } from "../_shared/panelData";
import PanelEmpty from "../_shared/PanelEmpty.astro";

interface Props {
  data?: PanelData | null;
}
const { data = null } = Astro.props;

const WINDOW_MONTHS = 60;

function findExtra(key: string): SeriesPoint[] {
  if (!data || !Array.isArray((data as any).extras)) return [];
  const extras = (data as any).extras as Array<{ key: string; data: SeriesPoint[] }>;
  return extras.find((e) => e.key === key)?.data ?? [];
}

function lastReal(series: SeriesPoint[]): { date: string; value: number } | null {
  for (let i = series.length - 1; i >= 0; i--) {
    const pt = series[i]!;
    if (typeof pt.value === "number" && !Number.isNaN(pt.value)) {
      return { date: pt.date, value: pt.value };
    }
  }
  return null;
}

function pickStride(lo: number, hi: number, targetTicks = 3): number {
  const span = hi - lo;
  if (!Number.isFinite(span) || span <= 0) return 1;
  const rough = span / targetTicks;
  const mag = Math.pow(10, Math.floor(Math.log10(rough)));
  const norm = rough / mag;
  let nice: number;
  if (norm < 1.5) nice = 1;
  else if (norm < 3) nice = 2;
  else if (norm < 4) nice = 2.5;
  else if (norm < 7) nice = 5;
  else nice = 10;
  return nice * mag;
}

// Provincial pulls. Pipeline shape: primary=ON, secondary=QC, tertiary=AB.
const onSeries = data?.primary?.data ?? [];
const qcSeries = data?.secondary?.data ?? [];
const abSeries = data?.tertiary?.data ?? [];
const bcSeries = findExtra("lfs_bc_unemployment_rate");
const caSeries = findExtra("lfs_ca_unemployment_rate");

const onTail = tailWindow(onSeries, WINDOW_MONTHS, "monthly");
const qcTail = tailWindow(qcSeries, WINDOW_MONTHS, "monthly");
const abTail = tailWindow(abSeries, WINDOW_MONTHS, "monthly");
const bcTail = tailWindow(bcSeries, WINDOW_MONTHS, "monthly");
const caTail = tailWindow(caSeries, WINDOW_MONTHS, "monthly");

const hasData =
  onTail.length > 0 && qcTail.length > 0 &&
  abTail.length > 0 && bcTail.length > 0 && caTail.length > 0;

const provinces = hasData ? [
  { code: "BC", title: "BRITISH COLUMBIA", data: bcTail },
  { code: "AB", title: "ALBERTA", data: abTail },
  { code: "ON", title: "ONTARIO", data: onTail },
  { code: "QC", title: "QUEBEC", data: qcTail },
] : [];

// Shared x-domain.
const allDates = hasData ? [...onTail, ...qcTail, ...abTail, ...bcTail, ...caTail] : [];
const allX = allDates.map((d) => decYear(d.date)).filter((v) => !Number.isNaN(v));
const xMin = allX.length > 0 ? Math.min(...allX) : 0;
const xMax = allX.length > 0 ? Math.max(...allX) : 1;

// ---- Geometry: 2x2 grid -------------------------------------------------
const VB_W = 720;
const VB_H = 405;
const M_OUT = 8;
const GAP_X = 36;
const GAP_Y = 36;
const M_T = 28;
const M_B = 28;
const SUB_M_L = 36;
const SUB_M_R = 10;
const SUB_M_T = 22;
const SUB_M_B = 22;

const COL_W = (VB_W - 2 * M_OUT - GAP_X) / 2;
const ROW_H = (VB_H - M_T - M_B - GAP_Y) / 2;

function cellX0(col: number): number { return M_OUT + col * (COL_W + GAP_X); }
function cellY0(row: number): number { return M_T + row * (ROW_H + GAP_Y); }

interface SubGeom {
  plotX0: number; plotX1: number; plotW: number;
  plotY0: number; plotY1: number; plotH: number;
  yLo: number; yHi: number; yRange: number;
  yTicks: number[];
  xTicks: Array<{ x: number; label: string }>;
  provPath: string;
  caPath: string;
  lastX: number | null; lastY: number | null;
  lastValue: number | null; lastDate: string | null;
  cellX0: number; cellY0: number;
  cellW: number;
}

function buildSubPanel(
  col: number,
  row: number,
  provData: SeriesPoint[],
  caData: SeriesPoint[],
): SubGeom {
  const cx0 = cellX0(col);
  const cy0 = cellY0(row);
  const plotX0 = cx0 + SUB_M_L;
  const plotX1 = cx0 + COL_W - SUB_M_R;
  const plotY0 = cy0 + SUB_M_T;
  const plotY1 = cy0 + ROW_H - SUB_M_B;
  const plotW = plotX1 - plotX0;
  const plotH = plotY1 - plotY0;

  // y-domain spans BOTH the provincial series and the Canadian comparator
  // so the comparator never clips and the gap between them reads.
  const vals: number[] = [];
  for (const d of provData) {
    if (typeof d.value === "number" && !Number.isNaN(d.value)) vals.push(d.value);
  }
  for (const d of caData) {
    if (typeof d.value === "number" && !Number.isNaN(d.value)) vals.push(d.value);
  }
  let yLo = 0, yHi = 1;
  if (vals.length > 0) {
    const rawMin = Math.min(...vals);
    const rawMax = Math.max(...vals);
    const span = (rawMax - rawMin) || Math.max(0.5, Math.abs(rawMax) * 0.05);
    yLo = rawMin - span * 0.15;
    yHi = rawMax + span * 0.15;
  }
  const yRange = yHi - yLo || 1;

  const xScale = (yr: number) => {
    if (xMax === xMin) return plotX0 + plotW / 2;
    return plotX0 + ((yr - xMin) / (xMax - xMin)) * plotW;
  };
  const yScale = (v: number) => plotY0 + plotH - ((v - yLo) / yRange) * plotH;

  const stride = pickStride(yLo, yHi);
  const yTicks: number[] = [];
  const start = Math.ceil(yLo / stride) * stride;
  for (let v = start; v <= yHi + 1e-9; v += stride) {
    yTicks.push(Number(v.toFixed(6)));
  }
  if (yTicks.length === 0) yTicks.push(Number(((yLo + yHi) / 2).toFixed(6)));

  const yearStart = Math.ceil(xMin);
  const yearEnd = Math.floor(xMax);
  const allYearTicks: Array<{ x: number; label: string }> = [];
  for (let yr = yearStart; yr <= yearEnd; yr++) {
    const decY = yr + (1 - 0.5) / 12;
    if (decY < xMin || decY > xMax) continue;
    allYearTicks.push({ x: xScale(decY), label: String(yr) });
  }
  const xTickStride = Math.max(1, Math.ceil(allYearTicks.length / 3));
  const xTicks = allYearTicks.filter((_, i) => i % xTickStride === 0);

  function buildPath(s: SeriesPoint[]): string {
    let p = "";
    let started = false;
    for (const pt of s) {
      if (typeof pt.value !== "number" || Number.isNaN(pt.value)) continue;
      const xv = decYear(pt.date);
      if (Number.isNaN(xv)) continue;
      p += (started ? "L" : "M") + xScale(xv).toFixed(2) + " " + yScale(pt.value).toFixed(2) + " ";
      started = true;
    }
    return p.trim();
  }

  const provPath = buildPath(provData);
  const caPath = buildPath(caData);

  let lastX: number | null = null;
  let lastY: number | null = null;
  let lastValue: number | null = null;
  let lastDate: string | null = null;
  const last = lastReal(provData);
  if (last) {
    const xv = decYear(last.date);
    if (!Number.isNaN(xv)) {
      lastX = xScale(xv);
      lastY = yScale(last.value);
      lastValue = last.value;
      lastDate = last.date;
    }
  }

  return {
    plotX0, plotX1, plotW,
    plotY0, plotY1, plotH,
    yLo, yHi, yRange, yTicks, xTicks,
    provPath, caPath,
    lastX, lastY, lastValue, lastDate,
    cellX0: cx0, cellY0: cy0, cellW: COL_W,
  };
}

const cells = hasData ? provinces.map((p, i) => {
  const col = i % 2;
  const row = Math.floor(i / 2);
  return {
    title: p.title,
    code: p.code,
    geom: buildSubPanel(col, row, p.data, caTail),
  };
}) : [];

const ariaLabel = "Four-province unemployment rate small multiples (BC, AB, ON, QC) versus the Canadian national rate, last 60 months. Province in solid; Canada in dashed reference. Latest provincial print in red on each panel.";
---
{hasData ? (
  <div class="canon-chart canon-chart--quad" data-panel="labour-6-small-multiples">
    <svg
      class="canon-chart__svg"
      viewBox={`0 0 ${VB_W} ${VB_H}`}
      preserveAspectRatio="xMidYMid meet"
      role="img"
      aria-label={ariaLabel}
    >
      {cells.map((c) => {
        const g = c.geom;
        return (
          <g>
            <text
              class="canon-chart__subpanel-title"
              x={(g.cellX0 + g.cellW / 2).toFixed(2)}
              y={(g.cellY0 + 12).toFixed(2)}
              text-anchor="middle"
            >{c.title}</text>

            {g.yTicks.map((v) => {
              const yy = g.plotY0 + g.plotH - ((v - g.yLo) / g.yRange) * g.plotH;
              return (
                <line
                  class="canon-chart__gridline"
                  x1={g.plotX0.toFixed(2)}
                  y1={yy.toFixed(2)}
                  x2={g.plotX1.toFixed(2)}
                  y2={yy.toFixed(2)}
                />
              );
            })}

            {/* Canada comparator (dashed) drawn first so the province line sits on top */}
            <path class="canon-chart__line canon-chart__line--reference" d={g.caPath} fill="none" />
            <path class="canon-chart__line" d={g.provPath} fill="none" />

            <rect
              class="canon-chart__frame"
              x={g.plotX0}
              y={g.plotY0}
              width={g.plotW}
              height={g.plotH}
            />

            {g.xTicks.map((t) => (
              <g>
                <line
                  class="canon-chart__xtick"
                  x1={t.x.toFixed(2)}
                  y1={g.plotY1.toFixed(2)}
                  x2={t.x.toFixed(2)}
                  y2={(g.plotY1 + 3).toFixed(2)}
                />
                <text
                  class="canon-chart__xtick-label"
                  x={t.x.toFixed(2)}
                  y={(g.plotY1 + 14).toFixed(2)}
                  text-anchor="middle"
                >{t.label}</text>
              </g>
            ))}

            {g.yTicks.map((v, i) => {
              const yy = g.plotY0 + g.plotH - ((v - g.yLo) / g.yRange) * g.plotH;
              const isTop = i === g.yTicks.length - 1;
              const txt = `${v.toFixed(1)}${isTop ? "%" : ""}`;
              return (
                <text
                  class="canon-chart__ytick-label"
                  x={(g.plotX0 - 5).toFixed(2)}
                  y={(yy + 4).toFixed(2)}
                  text-anchor="end"
                >{txt}</text>
              );
            })}

            {g.lastX !== null && g.lastY !== null && (
              <circle
                class="canon-chart__latest-dot"
                cx={g.lastX.toFixed(2)}
                cy={g.lastY.toFixed(2)}
                r="3.5"
              >
                <title>{`${c.code} latest: ${g.lastDate}: ${g.lastValue!.toFixed(2)}%`}</title>
              </circle>
            )}
          </g>
        );
      })}
    </svg>
    <p class="canon-chart__legend">
      Solid line: provincial rate. Dashed line: Canada national rate.
    </p>
  </div>
) : (
  <PanelEmpty reason="Provincial unemployment series not all present (need BC, AB, ON, QC, and CA)." />
)}

<style>
  .canon-chart { width: 100%; aspect-ratio: 16 / 9; background-color: var(--paper); overflow: visible; }
  .canon-chart__svg { display: block; width: 100%; height: 100%; overflow: visible; font-family: var(--font-sans); }
  .canon-chart__subpanel-title {
    fill: var(--ink); font-family: var(--font-sans);
    font-size: 11px; font-weight: var(--fw-semibold); letter-spacing: 0.18em;
  }
  .canon-chart__gridline { stroke: var(--ink); stroke-width: 1; stroke-opacity: 0.18; shape-rendering: crispEdges; }
  .canon-chart__line {
    stroke: var(--ink); stroke-width: 1.5; stroke-linejoin: round; stroke-linecap: round;
    fill: none; vector-effect: non-scaling-stroke;
  }
  .canon-chart__line--reference {
    stroke: var(--ink); stroke-width: 1; stroke-opacity: 0.5;
    stroke-dasharray: 4 2;
  }
  .canon-chart__latest-dot { fill: var(--accent); stroke: none; }
  .canon-chart__frame { fill: none; stroke: var(--ink); stroke-width: 1; shape-rendering: crispEdges; }
  .canon-chart__xtick { stroke: var(--ink); stroke-width: 1; shape-rendering: crispEdges; }
  .canon-chart__xtick-label {
    fill: var(--ink); font-family: var(--font-sans);
    font-size: 11px; font-weight: var(--fw-regular); font-variant-numeric: tabular-nums;
  }
  .canon-chart__ytick-label {
    fill: var(--ink); font-family: var(--font-mono);
    font-size: 11px; font-weight: var(--fw-regular); font-variant-numeric: tabular-nums;
  }
  .canon-chart__legend {
    margin: 4px 0 0;
    font-family: var(--font-sans);
    font-size: 11px;
    color: var(--ink);
    opacity: 0.7;
  }
</style>
