---
/*
 * Panel1LFSHeadlineSmallMultiples - LFS headline as 3-up small multiples.
 *
 * Diagnosis (editorial/chart-diagnosis/labour.md P1): three rates on one
 * shared y-axis compresses the recent action because UR (~7%), employment
 * rate (~60%) and participation (~65%) sit at very different absolute
 * levels. Geometry: three columns side-by-side, each with its own y-axis
 * tuned to the rate's range. Shared 36-month x-window so the cyclical
 * action reads. Latest point on each panel in MTA red.
 *
 * Reads left-to-right in the order a Canadian macro reader naturally
 * walks: unemployment rate (the headline cyclical signal, eye lands
 * here first), employment rate (the slack proxy doing the softening
 * underneath), participation rate (the supply-side check).
 *
 * Pipeline shape: panel-1 emits unemployment_rate (primary),
 * employment_rate (secondary), participation_rate (tertiary). All three
 * are percent series; the y-domain is forced to a 2pp visual span
 * centered on the midpoint of (pre-pandemic mean, latest value) so
 * visual slope is comparable across panels (art-director sign-off
 * 2026-05-12).
 *
 * Custom SVG (not PanelLiveChart) because the three-panel small-multiples
 * idiom is outside PanelLiveChart's single-panel scope.
 *
 * Visual rules (art-director redesign 2026-05-12):
 *  - Reference label sits ON the dashed rule (canon-reference Rule 8 +
 *    canon Rule L4): "X.X% pre-pandemic avg", right-anchored inside the
 *    plot, baseline 5px above the rule.
 *  - Shaded gap between dashed rule and latest data segment, from last
 *    crossing date (or panel left edge if no crossing inside window) to
 *    the latest data point. Same ink wash as the recession band.
 *  - Panel titles in sentence case, left-aligned at plotX0, no "%" suffix.
 *  - Equalized 2pp y-span across all three panels.
 *  - "scale: 2pp" micro-stamp above the leftmost (unemployment) panel.
 *  - No plot frame per-panel (small-multiples adaptation, art-director
 *    blessed). Single 1px bottom rule under x-ticks.
 *  - Annotation callout on panel 1 only.
 */

import type { PanelData, SeriesPoint } from "../_shared/panelData";
import { decYear, tailWindow } from "../_shared/panelData";
import PanelEmpty from "../_shared/PanelEmpty.astro";

interface Props {
  data?: PanelData | null;
}
const { data = null } = Astro.props;

const WINDOW_MONTHS = 36;

function lastReal(series: SeriesPoint[]): { date: string; value: number } | null {
  for (let i = series.length - 1; i >= 0; i--) {
    const pt = series[i]!;
    if (typeof pt.value === "number" && !Number.isNaN(pt.value)) {
      return { date: pt.date, value: pt.value };
    }
  }
  return null;
}

function pickStride(lo: number, hi: number, targetTicks = 4): number {
  const span = hi - lo;
  if (!Number.isFinite(span) || span <= 0) return 1;
  const rough = span / targetTicks;
  const mag = Math.pow(10, Math.floor(Math.log10(rough)));
  const norm = rough / mag;
  let nice: number;
  if (norm < 1.5) nice = 1;
  else if (norm < 3) nice = 2;
  else if (norm < 4) nice = 2.5;
  else if (norm < 7) nice = 5;
  else nice = 10;
  return nice * mag;
}

// Pre-pandemic decade (2010-01 to 2019-12) is the cyclical-normal anchor:
// excludes the GFC and the pandemic, the two biggest distortions in the
// available history, leaving a clean post-recovery / pre-shock window.
// User-ratified 2026-05-12 over the 20-year-full-series default.
const PRE_PANDEMIC_START = "2010-01-01";
const PRE_PANDEMIC_END = "2019-12-31";

function prePandemicMean(series: SeriesPoint[] | undefined): number | null {
  if (!series) return null;
  let sum = 0;
  let n = 0;
  for (const pt of series) {
    if (pt.date < PRE_PANDEMIC_START || pt.date > PRE_PANDEMIC_END) continue;
    if (typeof pt.value === "number" && !Number.isNaN(pt.value)) {
      sum += pt.value;
      n++;
    }
  }
  return n > 0 ? sum / n : null;
}

const urFull = data?.primary?.data ?? [];
const erFull = data?.secondary?.data ?? [];
const prFull = data?.tertiary?.data ?? [];

const urMean = prePandemicMean(urFull);
const erMean = prePandemicMean(erFull);
const prMean = prePandemicMean(prFull);

const ur = urFull.length > 0 ? tailWindow(urFull, WINDOW_MONTHS, "monthly") : [];
const er = erFull.length > 0 ? tailWindow(erFull, WINDOW_MONTHS, "monthly") : [];
const pr = prFull.length > 0 ? tailWindow(prFull, WINDOW_MONTHS, "monthly") : [];

const hasData = ur.length > 0 && er.length > 0 && pr.length > 0;

// Shared x-domain across all three panels: union over all dates.
const allX = [...ur, ...er, ...pr]
  .map((d) => decYear(d.date))
  .filter((v) => !Number.isNaN(v));
const xMin = allX.length > 0 ? Math.min(...allX) : 0;
const xMax = allX.length > 0 ? Math.max(...allX) : 1;

// ---- Geometry -----------------------------------------------------------
const VB_W = 720;
const VB_H = 405;
const M_OUT = 8;
const GAP_X = 36;
const M_T = 60;        // bumped slightly for the scale-stamp + title row
const M_B = 36;
const SUB_M_L = 36;
const SUB_M_R = 8;

const SUB_W = (VB_W - 2 * M_OUT - 2 * GAP_X) / 3;
const COL_X0 = (i: number) => M_OUT + i * (SUB_W + GAP_X);
const COL_X1 = (i: number) => COL_X0(i) + SUB_W;

const PLOT_Y0 = M_T;
const PLOT_Y1 = VB_H - M_B;
const PLOT_H = PLOT_Y1 - PLOT_Y0;

// Forced y-span: 2.0 percentage points across all three panels so visual
// slope reads comparably. Centered on midpoint of (pre-pandemic mean,
// latest value). A "scale: 2pp" micro-stamp on the leftmost panel signals
// the equalization to the reader.
const Y_SPAN_PP = 2.0;

interface SubPanelGeom {
  plotX0: number;
  plotX1: number;
  plotW: number;
  yLo: number;
  yHi: number;
  yRange: number;
  yTicks: number[];
  xTicks: Array<{ x: number; label: string }>;
  path: string;
  lastX: number | null;
  lastY: number | null;
  lastValue: number | null;
  lastDate: string | null;
  meanY: number | null;
  meanValue: number | null;
  // Shaded-gap band geometry: rect from gapX0 to lastX, spanning the
  // vertical region between the dashed rule and the latest data point.
  gapX0: number | null;
  gapX1: number | null;
  gapY0: number | null;
  gapY1: number | null;
}

function buildSubPanel(
  colIdx: number,
  series: SeriesPoint[],
  meanValue: number | null,
): SubPanelGeom {
  const plotX0 = COL_X0(colIdx) + SUB_M_L;
  const plotX1 = COL_X1(colIdx) - SUB_M_R;
  const plotW = plotX1 - plotX0;

  const last = lastReal(series);

  // Forced 2pp visual span centered on midpoint of (mean, latest). When
  // either is missing, fall back to the data's natural range with a tight
  // pad so the small-multiples still read.
  let yLo = 0;
  let yHi = 1;
  if (meanValue !== null && last) {
    const mid = (meanValue + last.value) / 2;
    yLo = mid - Y_SPAN_PP / 2;
    yHi = mid + Y_SPAN_PP / 2;
  } else {
    const ys = series
      .map((d) => d.value)
      .filter((v): v is number => typeof v === "number" && !Number.isNaN(v));
    if (ys.length > 0) {
      const rawMin = Math.min(...ys);
      const rawMax = Math.max(...ys);
      const span = (rawMax - rawMin) || Math.max(0.5, Math.abs(rawMax) * 0.05);
      yLo = rawMin - span * 0.18;
      yHi = rawMax + span * 0.18;
    }
  }
  const yRange = yHi - yLo || 1;

  const xScale = (yr: number) => {
    if (xMax === xMin) return plotX0 + plotW / 2;
    return plotX0 + ((yr - xMin) / (xMax - xMin)) * plotW;
  };
  const yScale = (v: number) =>
    PLOT_Y0 + PLOT_H - ((v - yLo) / yRange) * PLOT_H;

  const stride = pickStride(yLo, yHi);
  const yTicks: number[] = [];
  const start = Math.ceil(yLo / stride) * stride;
  for (let v = start; v <= yHi + 1e-9; v += stride) {
    yTicks.push(Number(v.toFixed(6)));
  }
  if (yTicks.length === 0) yTicks.push(Number(((yLo + yHi) / 2).toFixed(6)));

  const yearStart = Math.ceil(xMin);
  const yearEnd = Math.floor(xMax);
  const allYearTicks: Array<{ x: number; label: string }> = [];
  for (let yr = yearStart; yr <= yearEnd; yr++) {
    const decY = yr + (1 - 0.5) / 12;
    if (decY < xMin || decY > xMax) continue;
    allYearTicks.push({ x: xScale(decY), label: String(yr) });
  }
  const xTickStride = Math.max(1, Math.ceil(allYearTicks.length / 3));
  const xTicks = allYearTicks.filter((_, i) => i % xTickStride === 0);

  // Build the path, clipped against [yLo, yHi]. The forced 2pp y-span can
  // push history data outside the visible range; an unclipped stroke would
  // (a) escape PLOT_Y0/PLOT_Y1 in the rendered chart and (b) cause the
  // text-overlap detector's getPointAtLength sampler to flag the title
  // and reference label as overlapping. Clipping the path data itself
  // (rather than via SVG <clipPath>) fixes both, because the path's
  // intrinsic geometry now stays inside the plot box.
  type PathPt = { x: number; v: number };
  const rawPts: PathPt[] = [];
  for (const pt of series) {
    if (typeof pt.value !== "number" || Number.isNaN(pt.value)) continue;
    const xv = decYear(pt.date);
    if (Number.isNaN(xv)) continue;
    rawPts.push({ x: xv, v: pt.value });
  }
  function inside(v: number): boolean {
    return v >= yLo && v <= yHi;
  }
  function interpAtBound(a: PathPt, b: PathPt, bound: number): PathPt {
    const t = (bound - a.v) / (b.v - a.v);
    return { x: a.x + t * (b.x - a.x), v: bound };
  }
  let path = "";
  let inSegment = false;
  for (let i = 0; i < rawPts.length; i++) {
    const curr = rawPts[i]!;
    const prev = i > 0 ? rawPts[i - 1]! : null;
    if (prev) {
      const aIn = inside(prev.v);
      const bIn = inside(curr.v);
      if (aIn && bIn) {
        // Whole segment inside; if we hadn't started yet, start at prev.
        if (!inSegment) {
          path += `M${xScale(prev.x).toFixed(2)} ${yScale(prev.v).toFixed(2)} `;
          inSegment = true;
        }
        path += `L${xScale(curr.x).toFixed(2)} ${yScale(curr.v).toFixed(2)} `;
      } else if (aIn && !bIn) {
        // Exit boundary - clip to the y-bound and close this sub-path.
        if (!inSegment) {
          path += `M${xScale(prev.x).toFixed(2)} ${yScale(prev.v).toFixed(2)} `;
          inSegment = true;
        }
        const bound = curr.v > yHi ? yHi : yLo;
        const pt = interpAtBound(prev, curr, bound);
        path += `L${xScale(pt.x).toFixed(2)} ${yScale(pt.v).toFixed(2)} `;
        inSegment = false;
      } else if (!aIn && bIn) {
        // Entry - start a new sub-path at the boundary.
        const bound = prev.v > yHi ? yHi : yLo;
        const pt = interpAtBound(prev, curr, bound);
        path += `M${xScale(pt.x).toFixed(2)} ${yScale(pt.v).toFixed(2)} `;
        path += `L${xScale(curr.x).toFixed(2)} ${yScale(curr.v).toFixed(2)} `;
        inSegment = true;
      } else {
        // Both outside: if they straddle the band, clip the crossing
        // sub-segment; otherwise skip.
        if ((prev.v < yLo && curr.v > yHi) || (prev.v > yHi && curr.v < yLo)) {
          const bound1 = prev.v < yLo ? yLo : yHi;
          const bound2 = curr.v < yLo ? yLo : yHi;
          const p1 = interpAtBound(prev, curr, bound1);
          const p2 = interpAtBound(prev, curr, bound2);
          path += `M${xScale(p1.x).toFixed(2)} ${yScale(p1.v).toFixed(2)} `;
          path += `L${xScale(p2.x).toFixed(2)} ${yScale(p2.v).toFixed(2)} `;
        }
        inSegment = false;
      }
    } else {
      // First point: if inside, start at it; otherwise wait.
      if (inside(curr.v)) {
        path += `M${xScale(curr.x).toFixed(2)} ${yScale(curr.v).toFixed(2)} `;
        inSegment = true;
      }
    }
  }
  path = path.trim();

  let lastX: number | null = null;
  let lastY: number | null = null;
  let lastValue: number | null = null;
  let lastDate: string | null = null;
  if (last) {
    const xv = decYear(last.date);
    if (!Number.isNaN(xv)) {
      lastX = xScale(xv);
      lastY = yScale(last.value);
      lastValue = last.value;
      lastDate = last.date;
    }
  }

  const meanY = meanValue !== null && meanValue >= yLo && meanValue <= yHi
    ? yScale(meanValue)
    : null;

  // Shaded-gap geometry. Walk the windowed series left-to-right; if the
  // series crosses the mean value, remember the most recent crossing's
  // x-coordinate (linearly interpolated between flanking samples). If no
  // crossing exists inside the 36-month window, the band spans the full
  // panel width.
  let gapX0: number | null = null;
  let gapX1: number | null = null;
  let gapY0: number | null = null;
  let gapY1: number | null = null;
  if (meanValue !== null && lastX !== null && lastY !== null && meanY !== null) {
    let crossXDataUnits: number | null = null;
    let prev: { x: number; v: number } | null = null;
    for (const pt of series) {
      if (typeof pt.value !== "number" || Number.isNaN(pt.value)) continue;
      const xv = decYear(pt.date);
      if (Number.isNaN(xv)) continue;
      const curr = { x: xv, v: pt.value };
      if (prev) {
        const a = prev.v - meanValue;
        const b = curr.v - meanValue;
        if ((a === 0 && b !== 0) || (a !== 0 && b === 0) || (a > 0 && b < 0) || (a < 0 && b > 0)) {
          // Linear interpolation for the exact crossing x in data units.
          const t = a / (a - b);
          crossXDataUnits = prev.x + t * (curr.x - prev.x);
        }
      }
      prev = curr;
    }
    gapX0 = crossXDataUnits !== null ? xScale(crossXDataUnits) : plotX0;
    gapX1 = lastX;
    gapY0 = Math.min(meanY, lastY);
    gapY1 = Math.max(meanY, lastY);
  }

  return {
    plotX0, plotX1, plotW,
    yLo, yHi, yRange,
    yTicks, xTicks,
    path, lastX, lastY, lastValue, lastDate,
    meanY, meanValue,
    gapX0, gapX1, gapY0, gapY1,
  };
}

// Mean-label placement side per panel: label sits 5px above the rule and
// competes for the upper portion of the plot. Place on the x-half with
// FEWER above-rule samples so it sits in clear whitespace. Ties default
// right.
function labelSideForPanel(
  series: SeriesPoint[],
  meanValue: number | null,
): "left" | "right" {
  if (meanValue === null) return "right";
  const xMid = (xMin + xMax) / 2;
  let aboveLeft = 0;
  let aboveRight = 0;
  for (const pt of series) {
    if (typeof pt.value !== "number" || Number.isNaN(pt.value)) continue;
    if (pt.value <= meanValue) continue;
    const xv = decYear(pt.date);
    if (Number.isNaN(xv)) continue;
    if (xv < xMid) aboveLeft++;
    else aboveRight++;
  }
  return aboveLeft < aboveRight ? "left" : "right";
}

const panels = hasData ? [
  {
    idx: 0,
    title: "Unemployment rate",
    geom: buildSubPanel(0, ur, urMean),
    labelSide: labelSideForPanel(ur, urMean),
  },
  {
    idx: 1,
    title: "Employment rate",
    geom: buildSubPanel(1, er, erMean),
    labelSide: labelSideForPanel(er, erMean),
  },
  {
    idx: 2,
    title: "Participation rate",
    geom: buildSubPanel(2, pr, prMean),
    labelSide: labelSideForPanel(pr, prMean),
  },
] : [];

// Panel-1 annotation geometry (upper-right whitespace of the unemployment
// panel; single straight leader ending 7px from the red-dot center per
// canon-reference Rule 11 / "Annotation leader endpoint" gap convention).
const panel1 = panels[0] ?? null;
const annoText = "Back at the pre-pandemic average — unemployment has done the visible loosening.";
function parseAnchor(s: string): Array<{ text: string; bold: boolean }> {
  const parts: Array<{ text: string; bold: boolean }> = [];
  const re = /\*\*([^*]+)\*\*/g;
  let last = 0;
  let m: RegExpExecArray | null;
  while ((m = re.exec(s)) !== null) {
    if (m.index > last) parts.push({ text: s.slice(last, m.index), bold: false });
    parts.push({ text: m[1], bold: true });
    last = m.index + m[0].length;
  }
  if (last < s.length) parts.push({ text: s.slice(last), bold: false });
  return parts;
}
const annoMarkup = "**Back at the pre-pandemic average** — unemployment has done the visible loosening.";
const annoParts = parseAnchor(annoMarkup);

// Place the annotation in the upper-right white space of panel 1, above
// the mean rule so the leader can descend into the gap toward the red dot.
let annoX0 = 0, annoY0 = 0, annoW = 0, annoH = 44;
let leaderX1 = 0, leaderY1 = 0, leaderX2 = 0, leaderY2 = 0;
let showAnno = false;
if (panel1 && panel1.geom.lastX !== null && panel1.geom.lastY !== null) {
  const g = panel1.geom;
  // Block sits in the upper-right quadrant of the panel, hugging the
  // right plot edge. Width about 58% of plot width to fit two short lines.
  annoW = Math.max(120, g.plotW * 0.62);
  annoX0 = g.plotX1 - annoW;
  annoY0 = PLOT_Y0 + 4;
  // Leader: from the bottom-center of the anno block down to 7px above
  // the dot center. Single straight segment, no elbow.
  leaderX1 = annoX0 + annoW * 0.18;     // hand-tuned anchor under "Back"
  leaderY1 = annoY0 + annoH - 2;
  leaderX2 = g.lastX!;
  leaderY2 = g.lastY! - 7;
  showAnno = true;
}

const ariaLabel = "Three-panel small multiples of LFS headline rates, last 36 months. Unemployment, employment and participation rates each on own y-axis with a forced 2pp visual span. Pre-pandemic average rule on each; latest print marked in red.";
---
{hasData ? (
  <div class="canon-chart canon-chart--triptych" data-panel="labour-1-small-multiples">
    <svg
      class="canon-chart__svg"
      viewBox={`0 0 ${VB_W} ${VB_H}`}
      preserveAspectRatio="xMidYMid meet"
      role="img"
      aria-label={ariaLabel}
    >
      <defs>
        {panels.map((p) => (
          <clipPath id={`labour-p1-clip-${p.idx}`}>
            <rect
              x={p.geom.plotX0.toFixed(2)}
              y={PLOT_Y0}
              width={p.geom.plotW.toFixed(2)}
              height={PLOT_H}
            />
          </clipPath>
        ))}
      </defs>
      {panels.map((p) => {
        const g = p.geom;
        const labelOnLeft = p.labelSide === "left";
        const meanLabelX = labelOnLeft
          ? g.plotX0 + 4
          : g.plotX1 - 4;
        const meanLabelAnchor = labelOnLeft ? "start" : "end";
        return (
          <g>
            {/* Scale stamp - leftmost panel only, sits in the top margin
                above the title. Signals to the reader that all three
                panels share the same vertical pp-span. */}
            {p.idx === 0 && (
              <text
                class="canon-chart__scale-stamp"
                x={g.plotX0.toFixed(2)}
                y={(M_T - 32).toFixed(2)}
              >SCALE: 2PP</text>
            )}

            <text
              class="canon-chart__subpanel-title"
              x={g.plotX0.toFixed(2)}
              y={(M_T - 16).toFixed(2)}
              text-anchor="start"
            >{p.title}</text>

            {/* Shaded-gap band - the "distance from pre-pandemic", the
                editorial payload. Same ink wash as the recession band.
                Drawn first so the dashed rule and the data line sit on
                top of it in z-order. */}
            {g.gapX0 !== null && g.gapX1 !== null && g.gapY0 !== null && g.gapY1 !== null && (
              <rect
                class="canon-chart__gap-band"
                x={g.gapX0.toFixed(2)}
                y={g.gapY0.toFixed(2)}
                width={Math.max(0, g.gapX1 - g.gapX0).toFixed(2)}
                height={Math.max(0, g.gapY1 - g.gapY0).toFixed(2)}
              />
            )}

            {g.yTicks.map((v) => {
              const yy = (PLOT_Y0 + PLOT_H) - ((v - g.yLo) / g.yRange) * PLOT_H;
              return (
                <line
                  class="canon-chart__gridline"
                  x1={g.plotX0.toFixed(2)}
                  y1={yy.toFixed(2)}
                  x2={g.plotX1.toFixed(2)}
                  y2={yy.toFixed(2)}
                />
              );
            })}

            {/* Pre-pandemic dashed reference rule + on-rule label. Label
                is anchored on the OPPOSITE side of the panel from the
                line's terminus relative to the rule, so the label sits
                in clear whitespace. */}
            {g.meanY !== null && g.meanValue !== null && (
              <g class="canon-chart__mean-group">
                <line
                  class="canon-chart__mean-rule"
                  x1={g.plotX0.toFixed(2)}
                  y1={g.meanY.toFixed(2)}
                  x2={g.plotX1.toFixed(2)}
                  y2={g.meanY.toFixed(2)}
                />
                <text
                  class="canon-chart__mean-label"
                  x={meanLabelX.toFixed(2)}
                  y={(g.meanY - 5).toFixed(2)}
                  text-anchor={meanLabelAnchor}
                >{`${g.meanValue.toFixed(1)}% pre-pandemic avg`}</text>
              </g>
            )}

            {/* Data line clipped to the plot rect: the forced 2pp y-span
                may push some history outside [yLo, yHi], and the clip
                stops the stroke from running over the title or the bottom
                rule. */}
            <path
              class="canon-chart__line"
              d={g.path}
              fill="none"
              clip-path={`url(#labour-p1-clip-${p.idx})`}
            />

            {/* Bottom rule under the x-tick row - the only piece of the
                old plot frame retained. Small-multiples adaptation
                blessed by art-director 2026-05-12. */}
            <line
              class="canon-chart__bottom-rule"
              x1={g.plotX0.toFixed(2)}
              y1={PLOT_Y1.toFixed(2)}
              x2={g.plotX1.toFixed(2)}
              y2={PLOT_Y1.toFixed(2)}
            />

            {g.xTicks.map((t) => (
              <g>
                <line
                  class="canon-chart__xtick"
                  x1={t.x.toFixed(2)}
                  y1={PLOT_Y1.toFixed(2)}
                  x2={t.x.toFixed(2)}
                  y2={(PLOT_Y1 + 4).toFixed(2)}
                />
                <text
                  class="canon-chart__xtick-label"
                  x={t.x.toFixed(2)}
                  y={(PLOT_Y1 + 18).toFixed(2)}
                  text-anchor="middle"
                >{t.label}</text>
              </g>
            ))}

            {g.yTicks.map((v, i) => {
              const yy = (PLOT_Y0 + PLOT_H) - ((v - g.yLo) / g.yRange) * PLOT_H;
              const isTop = i === g.yTicks.length - 1;
              const txt = `${v.toFixed(1)}${isTop ? "%" : ""}`;
              return (
                <text
                  class="canon-chart__ytick-label"
                  x={(g.plotX0 - 6).toFixed(2)}
                  y={(yy + 4).toFixed(2)}
                  text-anchor="end"
                >{txt}</text>
              );
            })}

            {g.lastX !== null && g.lastY !== null && (
              <circle
                class="canon-chart__latest-dot"
                cx={g.lastX.toFixed(2)}
                cy={g.lastY.toFixed(2)}
                r="4"
              >
                <title>{`Latest: ${g.lastDate}: ${g.lastValue!.toFixed(2)}%`}</title>
              </circle>
            )}
          </g>
        );
      })}

      {/* Panel-1 editorial annotation (unemployment). Single straight
          ink leader, foreignObject for inline weight contrast on the
          anchor phrase. Panels 2 and 3 carry no callout - their
          shaded-gap bands are the story. */}
      {showAnno && (
        <g class="canon-chart__annotation">
          <line
            class="canon-chart__anno-leader"
            x1={leaderX1.toFixed(2)}
            y1={leaderY1.toFixed(2)}
            x2={leaderX2.toFixed(2)}
            y2={leaderY2.toFixed(2)}
          />
          <foreignObject
            x={annoX0.toFixed(2)}
            y={annoY0.toFixed(2)}
            width={annoW.toFixed(2)}
            height={annoH.toFixed(2)}
          >
            <p class="canon-chart__anno-text">
              {annoParts.map((part) =>
                part.bold
                  ? <strong class="canon-chart__anno-anchor">{part.text}</strong>
                  : <span>{part.text}</span>
              )}
            </p>
          </foreignObject>
        </g>
      )}
    </svg>
  </div>
) : (
  <PanelEmpty reason="Pipeline did not emit unemployment / employment / participation rate triplet for panel-1." />
)}

