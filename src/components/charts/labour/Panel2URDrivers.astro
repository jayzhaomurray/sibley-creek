---
/*
 * Panel2URDrivers (V3, indexed-levels wedge) - the UR-drivers plate
 * rebuilt around cumulative indexed levels of employment and labour force.
 *
 * Editorial question this plate answers (user-codified 2026-05-12):
 *   "Is the unemployment rate rising because people are losing jobs, or
 *   because the labour force is growing faster than hiring?"
 *
 * Why V3 superseded V2 (growth-rate scissors). The scissors version
 * plotted 3-month annualized growth rates for both series. Both lines
 * hover near zero in ordinary months, so the editorial wedge only opens
 * in dramatic prints; in calm months the chart reads as two noisy lines
 * near the zero baseline. V3 indexes both levels to a base period and
 * plots cumulative index values. The wedge between the two lines widens
 * monotonically over the window as the UR drifts up, and the wedge in
 * index points approximately equals the UR change in pp over the same
 * window. One widening gap, one clear story, minimal mental load.
 *
 * The geometry-to-editorial-point map. Define
 *   Index_E[t]  = 100 * employment[t] / employment[base]
 *   Index_LF[t] = 100 * labourforce[t] / labourforce[base]
 * where labourforce[t] = employment[t] / (1 - UR[t]/100) by LFS identity.
 * Then
 *   Index_LF[t] - Index_E[t]
 *     ~= 100 * (LF[t]/LF[base] - E[t]/E[base])
 *     ~= 100 * (1/(1-UR[t]/100) / (1/(1-UR[base]/100)) - 1) * (E[t]/E[base])
 * For small UR levels this simplifies to approximately the UR change in
 * percentage points. Worked example with the April 2026 vintage below
 * confirms the approximation holds to within a tenth of a point.
 *
 * Base period. January 2024 = 100. Captures the recent UR drift up
 * (UR ~5.7% in Jan 2024 -> 6.9% in April 2026, a ~1.2pp rise) without
 * extending into the post-pandemic regime where the LFS identity and
 * the demographic mix are non-stationary.
 *
 * Window. Jan 2024 through the latest LFS print (April 2026 in this
 * vintage), approximately 28 months.
 *
 * Series:
 *   Employment:   1.5px solid pure ink, MTA-red terminal dot. (MAIN)
 *   Labour force: 1px dashed (4-2) pure ink, no terminal dot. (COMPARATOR)
 * Visual weights stay fixed across vintages -- when the story flips
 * (employment outgrowing LF, UR falling), the same chart renders the
 * opposite signal naturally without code changes.
 *
 * Light shaded gap-band between the two lines (same 6% ink token as the
 * recession band and Panel3WageBandV3). The band visually carries the
 * cumulative wedge.
 *
 * Direct labels at line termini, right gutter: "Employment" (semibold,
 * on the solid line) and "Labour force" (regular, on the dashed line).
 *
 * NO sentence annotations on canvas. NO methodology micro-note on canvas.
 * NO duplicate direct labels. Word-only direct labels at line termini.
 *
 * Data wiring. Pipeline panel-2 spec emits:
 *   primary   = employment_level   (StatCan v2062811, SA monthly, millions)
 *   secondary = unemployment_rate  (StatCan v2062815, SA monthly, %)
 * The chart derives the labour-force level at render time via the LFS
 * identity LF[t] = E[t] / (1 - UR[t]/100), then indexes both series to
 * the base-period (January 2024) level.
 *
 * Verified spot-check (April 2026 vintage, present data):
 *   Base (Jan 2024): emp = 20.5521M, UR = 5.7%, LF = 21.7944M
 *     -> Index_E = 100.00, Index_LF = 100.00 (by construction)
 *   Latest (Apr 2026): emp = 21.0337M, UR = 6.9%, LF = 22.5926M
 *     -> Index_E  = 100 * 21.0337 / 20.5521 = 102.34
 *     -> Index_LF = 100 * 22.5926 / 21.7944 = 103.66
 *     -> Wedge = 1.32 index points
 *   UR change Jan 2024 -> Apr 2026 = 6.9 - 5.7 = +1.2pp
 *   Wedge (1.32 idx pts) ~= UR change (1.2pp). Approximation confirmed.
 *
 * V2 (scissors) archived at
 *   _alternatives/labour/Alt_Panel2URDriversScissors.astro.
 * V1 (dual-panel scissors with signed-bar sub-panel) archived at
 *   _alternatives/labour/Alt_Panel2URDriversDualPanel.astro.
 */

import type { PanelData, SeriesPoint } from "../_shared/panelData";
import { decYear } from "../_shared/panelData";
import PanelEmpty from "../_shared/PanelEmpty.astro";

interface Props {
  data?: PanelData | null;
}
const { data = null } = Astro.props;

const BASE_DATE = "2024-01-01";

function pickStride(lo: number, hi: number, targetTicks = 5): number {
  const span = hi - lo;
  if (!Number.isFinite(span) || span <= 0) return 1;
  const rough = span / targetTicks;
  const mag = Math.pow(10, Math.floor(Math.log10(rough)));
  const norm = rough / mag;
  let nice: number;
  if (norm < 1.5) nice = 1;
  else if (norm < 3) nice = 2;
  else if (norm < 4) nice = 2.5;
  else if (norm < 7) nice = 5;
  else nice = 10;
  return nice * mag;
}

function lastReal(series: SeriesPoint[]): { date: string; value: number } | null {
  for (let i = series.length - 1; i >= 0; i--) {
    const pt = series[i]!;
    if (typeof pt.value === "number" && !Number.isNaN(pt.value)) {
      return { date: pt.date, value: pt.value };
    }
  }
  return null;
}

// ---- Source series + derivation ----------------------------------------
const empLevels = data?.primary?.data ?? [];
const urSeries = data?.secondary?.data ?? [];

// Derive labour-force level (millions) at every matched date via the LFS
// identity LF = E / (1 - UR/100). UR is in percent.
const urMap = new Map<string, number | null>(urSeries.map((p) => [p.date, p.value]));
const lfLevels: SeriesPoint[] = [];
for (const pt of empLevels) {
  const ur = urMap.get(pt.date);
  if (
    typeof pt.value === "number" && !Number.isNaN(pt.value) &&
    typeof ur === "number" && !Number.isNaN(ur)
  ) {
    const denom = 1 - ur / 100;
    if (denom > 0) {
      lfLevels.push({ date: pt.date, value: pt.value / denom });
      continue;
    }
  }
  lfLevels.push({ date: pt.date, value: null });
}

// Locate the base-period readings. Both series must have a real value at
// BASE_DATE; otherwise we cannot index.
function valueAt(series: SeriesPoint[], date: string): number | null {
  const hit = series.find((p) => p.date === date);
  if (!hit) return null;
  if (typeof hit.value !== "number" || Number.isNaN(hit.value)) return null;
  return hit.value;
}

const empBase = valueAt(empLevels, BASE_DATE);
const lfBase = valueAt(lfLevels, BASE_DATE);

// Index both series. Trim to >= BASE_DATE so the visible window starts at
// the base period exactly.
function indexFromBase(series: SeriesPoint[], base: number | null, fromDate: string): SeriesPoint[] {
  if (base === null || base === 0) return [];
  const out: SeriesPoint[] = [];
  for (const p of series) {
    if (p.date < fromDate) continue;
    if (typeof p.value !== "number" || Number.isNaN(p.value)) {
      out.push({ date: p.date, value: null });
      continue;
    }
    out.push({ date: p.date, value: (p.value / base) * 100 });
  }
  return out;
}

const empIndexed = indexFromBase(empLevels, empBase, BASE_DATE);
const lfIndexed = indexFromBase(lfLevels, lfBase, BASE_DATE);

const hasData = empIndexed.length > 1 && lfIndexed.length > 1 && empBase !== null && lfBase !== null;

// ---- Geometry (single panel; canon Tier-3 viewBox) ---------------------
const VB_W = 720;
const VB_H = 405;
const M_L = 56;
const M_R = 120;   // right gutter seats "Employment" / "Labour force" direct labels
const M_T = 32;
const M_B = 40;
const PLOT_X0 = M_L;
const PLOT_Y0 = M_T;
const PLOT_W = VB_W - M_L - M_R;
const PLOT_H = VB_H - M_T - M_B;
const PLOT_X1 = PLOT_X0 + PLOT_W;
const PLOT_Y1 = PLOT_Y0 + PLOT_H;

// ---- x-domain spans both series ----------------------------------------
const xs = [...empIndexed, ...lfIndexed]
  .map((d) => decYear(d.date))
  .filter((v) => !Number.isNaN(v));
const xMin = xs.length > 0 ? Math.min(...xs) : 0;
const xMax = xs.length > 0 ? Math.max(...xs) : 1;

// ---- y-domain spans both series with breathing room --------------------
//
// Anchor at 100 (the base period); pad above/below so the wedge has air.
const allY: number[] = [];
for (const d of empIndexed) if (typeof d.value === "number") allY.push(d.value);
for (const d of lfIndexed) if (typeof d.value === "number") allY.push(d.value);

let yLo = 99, yHi = 101;
if (allY.length > 0) {
  const rawMin = Math.min(...allY);
  const rawMax = Math.max(...allY);
  const span = (rawMax - rawMin) || 1;
  yLo = rawMin - span * 0.18;
  yHi = rawMax + span * 0.18;
  // Always include 100 (the base period) in the visible range.
  if (yLo > 100) yLo = 100 - span * 0.10;
  if (yHi < 100) yHi = 100 + span * 0.10;
}
const yRange = yHi - yLo || 1;

function xScale(yr: number): number {
  if (xMax === xMin) return PLOT_X0 + PLOT_W / 2;
  return PLOT_X0 + ((yr - xMin) / (xMax - xMin)) * PLOT_W;
}
function yScale(v: number): number {
  return PLOT_Y0 + PLOT_H - ((v - yLo) / yRange) * PLOT_H;
}

// ---- Gap-band polygon (drawn behind both lines) ------------------------
//
// Trace upper of the two series forward, then lower in reverse. Joined on
// a shared date grid so vertical bands between paired points read cleanly.
type Paired = { x: number; yHi: number; yLo: number };

function buildPairedGrid(a: SeriesPoint[], b: SeriesPoint[]): Paired[] {
  const bMap = new Map<string, number>();
  for (const p of b) {
    if (typeof p.value === "number" && !Number.isNaN(p.value)) {
      bMap.set(p.date, p.value);
    }
  }
  const out: Paired[] = [];
  for (const p of a) {
    if (typeof p.value !== "number" || Number.isNaN(p.value)) continue;
    const bv = bMap.get(p.date);
    if (bv === undefined) continue;
    const xv = decYear(p.date);
    if (Number.isNaN(xv)) continue;
    const x = xScale(xv);
    const aY = yScale(p.value);
    const bY = yScale(bv);
    out.push({
      x,
      yHi: Math.min(aY, bY),  // smaller screen y = visually upper
      yLo: Math.max(aY, bY),
    });
  }
  return out;
}

function buildGapBandPath(paired: Paired[]): string {
  if (paired.length < 2) return "";
  let d = `M${paired[0]!.x.toFixed(2)} ${paired[0]!.yHi.toFixed(2)} `;
  for (let i = 1; i < paired.length; i++) {
    d += `L${paired[i]!.x.toFixed(2)} ${paired[i]!.yHi.toFixed(2)} `;
  }
  for (let i = paired.length - 1; i >= 0; i--) {
    d += `L${paired[i]!.x.toFixed(2)} ${paired[i]!.yLo.toFixed(2)} `;
  }
  d += "Z";
  return d.trim();
}

const pairedGrid = buildPairedGrid(lfIndexed, empIndexed);
const gapBandPath = buildGapBandPath(pairedGrid);

// ---- Line paths --------------------------------------------------------
function buildLinePath(series: SeriesPoint[]): string {
  let p = "";
  let started = false;
  for (const pt of series) {
    if (typeof pt.value !== "number" || Number.isNaN(pt.value)) { started = false; continue; }
    const xv = decYear(pt.date);
    if (Number.isNaN(xv)) continue;
    p += (started ? "L" : "M") + xScale(xv).toFixed(2) + " " + yScale(pt.value).toFixed(2) + " ";
    started = true;
  }
  return p.trim();
}

const lfPath = buildLinePath(lfIndexed);
const empPath = buildLinePath(empIndexed);

const lastLF = lastReal(lfIndexed);
const lastLFxy = lastLF ? {
  x: xScale(decYear(lastLF.date)),
  y: yScale(lastLF.value),
  value: lastLF.value,
  date: lastLF.date,
} : null;
const lastEmp = lastReal(empIndexed);
const lastEmpXY = lastEmp ? {
  x: xScale(decYear(lastEmp.date)),
  y: yScale(lastEmp.value),
  value: lastEmp.value,
  date: lastEmp.date,
} : null;

// Wedge (LF index minus emp index at latest matched date) for hover.
const wedgeAtLatest: number | null =
  lastLF && lastEmp ? lastLF.value - lastEmp.value : null;

// ---- Y-axis ticks ------------------------------------------------------
const yStride = pickStride(yLo, yHi);
const yTicks: number[] = [];
const yStart = Math.ceil(yLo / yStride) * yStride;
for (let v = yStart; v <= yHi + 1e-9; v += yStride) yTicks.push(Number(v.toFixed(6)));
if (yTicks.length === 0) yTicks.push(Number(((yLo + yHi) / 2).toFixed(6)));

// ---- X-axis year ticks -------------------------------------------------
const yearStart = Math.ceil(xMin);
const yearEnd = Math.floor(xMax);
const allYearTicks: Array<{ x: number; label: string }> = [];
for (let yr = yearStart; yr <= yearEnd; yr++) {
  const decY = yr + (1 - 0.5) / 12;
  if (decY < xMin || decY > xMax) continue;
  allYearTicks.push({ x: xScale(decY), label: String(yr) });
}
// Ensure the base-period anchor reads at the left of the x-axis: always
// include 2024 if it sits inside the domain, regardless of stride.
const xTickStride = Math.max(1, Math.ceil(allYearTicks.length / 5));
const xTicks = allYearTicks.filter((_, i) => i % xTickStride === 0);

// ---- Direct-label placement (line termini, right gutter) ---------------
//
// Employment label anchors to the employment terminus; LF label anchors
// to the labour-force terminus. If the two would collide vertically,
// preserve employment's natural position (it's the MAIN line, MTA dot)
// and push labour force away.
const LABEL_GAP_X = 10;
const LABEL_MIN_DY = 14;

let empLabelY = lastEmpXY ? lastEmpXY.y + 4 : 0;
let lfLabelY = lastLFxy ? lastLFxy.y + 4 : 0;
if (lastEmpXY && lastLFxy) {
  if (Math.abs(empLabelY - lfLabelY) < LABEL_MIN_DY) {
    // Employment carries the MTA red dot and editorial weight; keep its
    // natural anchor. LF moves away by the lesser-displaced direction.
    if (lfLabelY >= empLabelY) lfLabelY = empLabelY + LABEL_MIN_DY;
    else lfLabelY = empLabelY - LABEL_MIN_DY;
  }
}

const ariaLabel =
  "Two lines on a single panel: employment and labour-force levels, each indexed to January 2024 = 100, from January 2024 to the latest LFS print. Employment line solid; labour-force line dashed. The shaded band between the two lines is the cumulative wedge -- when the labour-force line sits above the employment line, the unemployment rate has risen over the window; the wedge in index points approximately equals the unemployment-rate change in percentage points. Labour force at each date is derived from the LFS identity (employment level divided by one minus the unemployment rate). Source: Statistics Canada Table 14-10-0287-01.";
---
{hasData ? (
  <div class="canon-chart" data-panel="labour-panel-2-ur-drivers">
    <svg
      class="canon-chart__svg"
      viewBox={`0 0 ${VB_W} ${VB_H}`}
      preserveAspectRatio="xMidYMid meet"
      role="img"
      aria-label={ariaLabel}
    >
      {/* Gap-band ink wash drawn BEHIND the lines. Same 6% ink token as
         the recession band and Panel3WageBandV3. The wedge IS the
         editorial argument. */}
      {gapBandPath && (
        <path
          class="ur-drivers__gap-band"
          d={gapBandPath}
          fill="rgba(21, 23, 26, 0.06)"
          stroke="none"
        />
      )}

      {yTicks.map((v) => {
        const yy = yScale(v);
        // Suppress the base-100 gridline; we draw it explicitly below
        // as a slightly heavier reference rule so the eye anchors on it.
        if (Math.abs(v - 100) < 1e-9) return null;
        return (
          <line
            class="canon-chart__gridline"
            x1={PLOT_X0}
            y1={yy.toFixed(2)}
            x2={PLOT_X1}
            y2={yy.toFixed(2)}
          />
        );
      })}

      {/* Base-100 reference rule. Same treatment as the inflation 2%
         target rule in the canon reference: 1px pure ink solid, full
         opacity. The reader sees this is the anchor line. */}
      <line
        class="canon-chart__zero-line"
        x1={PLOT_X0}
        y1={yScale(100).toFixed(2)}
        x2={PLOT_X1}
        y2={yScale(100).toFixed(2)}
      />

      <defs>
        <clipPath id="ur-drivers-v3-clip">
          <rect x={PLOT_X0} y={PLOT_Y0} width={PLOT_W} height={PLOT_H} />
        </clipPath>
      </defs>
      <g clip-path="url(#ur-drivers-v3-clip)">
        {/* Labour force (comparator, dashed) drawn first so employment
           sits on top in z-order. */}
        {lfPath && (
          <path class="canon-chart__line canon-chart__line--secondary" d={lfPath} fill="none" />
        )}
        {empPath && (
          <path class="canon-chart__line" d={empPath} fill="none" />
        )}
      </g>

      <rect
        class="canon-chart__frame"
        x={PLOT_X0}
        y={PLOT_Y0}
        width={PLOT_W}
        height={PLOT_H}
      />

      {xTicks.map((t) => (
        <g>
          <line
            class="canon-chart__xtick"
            x1={t.x.toFixed(2)}
            y1={PLOT_Y1.toFixed(2)}
            x2={t.x.toFixed(2)}
            y2={(PLOT_Y1 + 4).toFixed(2)}
          />
          <text
            class="canon-chart__xtick-label"
            x={t.x.toFixed(2)}
            y={(PLOT_Y1 + 18).toFixed(2)}
            text-anchor="middle"
          >{t.label}</text>
        </g>
      ))}

      {yTicks.map((v, i) => {
        const yy = yScale(v);
        const isTop = i === yTicks.length - 1;
        // Topmost tick carries the unit per canon Section 5.3, but the
        // base-period framing ("Jan 2024 = 100") is too long to fit on
        // the right-anchored y-axis without bleeding past the viewBox
        // left edge. We keep the unit-on-topmost-tick contract with the
        // short glyph "idx" and place the base-period framing as a
        // small left-anchored unit caption above the plot.
        const txt = isTop ? `${v.toFixed(1)} idx` : v.toFixed(1);
        return (
          <text
            class="canon-chart__ytick-label"
            x={(PLOT_X0 - 8).toFixed(2)}
            y={(yy + 4).toFixed(2)}
            text-anchor="end"
          >{txt}</text>
        );
      })}

      {/* Base-period unit caption, top-left, in the top-margin band.
         Renders left-anchored at PLOT_X0 so it cannot bleed past the
         viewBox left edge. Pairs with the "idx" suffix on the topmost
         y-tick. */}
      <text
        class="ur-drivers__unit-caption"
        x={PLOT_X0.toFixed(2)}
        y="18"
        text-anchor="start"
      >Indexed: Jan 2024 = 100</text>

      {/* MTA-red terminal dot on the employment line (MAIN). */}
      {lastEmpXY && (
        <circle
          class="canon-chart__latest-dot"
          cx={lastEmpXY.x.toFixed(2)}
          cy={lastEmpXY.y.toFixed(2)}
          r="4"
        >
          <title>{`Employment, indexed Jan 2024 = 100, ${lastEmpXY.date}: ${lastEmpXY.value.toFixed(2)}${wedgeAtLatest !== null ? ` (wedge vs LF: ${wedgeAtLatest >= 0 ? "-" : "+"}${Math.abs(wedgeAtLatest).toFixed(2)} idx pts)` : ""}`}</title>
        </circle>
      )}

      {/* Direct labels at line termini, right gutter. Word-only per canon. */}
      {lastEmpXY && (
        <text
          class="ur-drivers__label-primary"
          x={(lastEmpXY.x + LABEL_GAP_X).toFixed(2)}
          y={empLabelY.toFixed(2)}
          text-anchor="start"
        >Employment</text>
      )}
      {lastLFxy && (
        <text
          class="ur-drivers__label-secondary"
          x={(lastLFxy.x + LABEL_GAP_X).toFixed(2)}
          y={lfLabelY.toFixed(2)}
          text-anchor="start"
        >
          <title>{`Labour force, indexed Jan 2024 = 100, ${lastLFxy.date}: ${lastLFxy.value.toFixed(2)}`}</title>
          Labour force
        </text>
      )}
    </svg>
  </div>
) : (
  <PanelEmpty reason="Employment level and unemployment rate series both required for the UR-drivers plate, including a January 2024 base-period reading." />
)}

<style>
  .canon-chart { width: 100%; aspect-ratio: 16 / 9; background-color: var(--paper); overflow: visible; }
  .canon-chart__svg { display: block; width: 100%; height: 100%; overflow: visible; font-family: var(--font-sans); }

  /* Canon hairlines (shared) */
  .canon-chart__gridline { stroke: var(--ink); stroke-width: 1; stroke-opacity: 0.18; shape-rendering: crispEdges; }
  .canon-chart__zero-line { stroke: var(--ink); stroke-width: 1; stroke-opacity: 1; shape-rendering: crispEdges; }
  .canon-chart__frame { fill: none; stroke: var(--ink); stroke-width: 1; shape-rendering: crispEdges; }
  .canon-chart__xtick { stroke: var(--ink); stroke-width: 1; shape-rendering: crispEdges; }
  .canon-chart__xtick-label {
    fill: var(--ink); font-family: var(--font-sans);
    font-size: 12px; font-weight: var(--fw-regular); font-variant-numeric: tabular-nums;
  }
  .canon-chart__ytick-label {
    fill: var(--ink); font-family: var(--font-mono);
    font-size: 12px; font-weight: var(--fw-regular); font-variant-numeric: tabular-nums;
  }
  .canon-chart__latest-dot { fill: var(--accent); stroke: none; }

  /* Lines: employment is primary (solid 1.5px ink, the MAIN line because
     readers care about employment); labour force is secondary (1px dashed
     ink, the COMPARATOR). Weights fixed across vintages -- the chart is
     about the wedge, not which line wins. */
  .canon-chart__line {
    stroke: var(--ink); stroke-width: 1.5; stroke-linejoin: round;
    stroke-linecap: round; fill: none; vector-effect: non-scaling-stroke;
  }
  .canon-chart__line--secondary {
    stroke: var(--ink); stroke-width: 1; stroke-opacity: 0.85;
    stroke-dasharray: 4 2;
  }

  .ur-drivers__gap-band { pointer-events: none; }

  /* Direct labels at line termini. */
  .ur-drivers__label-primary {
    fill: var(--ink); font-family: var(--font-sans);
    font-size: 13px; font-weight: var(--fw-semibold);
  }
  .ur-drivers__label-secondary {
    fill: var(--ink); font-family: var(--font-sans);
    font-size: 13px; font-weight: var(--fw-regular);
  }
  .ur-drivers__unit-caption {
    fill: var(--ink); font-family: var(--font-sans);
    font-size: 11px; font-weight: var(--fw-medium);
    fill-opacity: 0.75;
  }
</style>
