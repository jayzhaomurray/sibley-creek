---
/*
 * Panel6FCI - financial conditions index.
 *
 * Pipeline emits `yield_10yr` and `usdcad` as proxies, but the FCI
 * composite construction is not on disk. We fall back to PanelEmpty.
 *
 * Synthetic-data fallback removed.
 */

import type { PanelData } from "../_shared/panelData";
import PanelEmpty from "../_shared/PanelEmpty.astro";

interface Props {
  data?: PanelData | null;
}

const { data: _data = null } = Astro.props;
void _data;
---
<PanelEmpty reason="Financial-conditions composite not yet emitted." />
