---
/*
 * Panel6FCI - Markets plate 6.
 *
 * Spec: editorial canon 4.6.6. Financial conditions index (BoC FCI if
 * Valet key exists; otherwise the Chicago Fed NFCI as a US comparator).
 * Single-series time series; the data lives on a signed axis where 0 =
 * average conditions, positive = tighter than average, negative = easier.
 * The zero line is the load-bearing reference and gets full ink weight.
 *
 * Vignelli canon: 1.5px black line, MTA red latest-point dot, 1px
 * pure-black plot frame, 6% recession band on 2020 Q1-Q2, Plex Mono
 * tick labels. The signed-axis treatment - emphasizing the zero line -
 * matches the inflation Panel1 pattern.
 *
 * Plot vs SVG: hand-rolled SVG. One line, one recession band, one dot.
 *
 * Placeholder: 120-month series ending Apr 2026. Negative readings
 * (easy) through 2017-2019; 2020 spike positive; 2022 modest tightening
 * positive; 2024-2026 grinds back negative. Sign convention: positive =
 * tighter (NFCI convention).
 */

interface FCIRow {
  date: string;  // "YYYY-MM"
  fci: number;   // standardized index, 0 = average
}

interface Props {
  data?: FCIRow[];
  ariaLabel?: string;
  /** Series label, eg "Chicago Fed NFCI" or "BoC FCI". */
  seriesLabel?: string;
}

function makePlaceholder(): FCIRow[] {
  const out: FCIRow[] = [];
  let y = 2016;
  let m = 5;
  for (let i = 0; i < 120; i++) {
    // Drift: 2017-2019 easy (-0.5), 2020 spike (+2.5 then collapse to -0.7),
    // 2022 tightening (+0.4), 2024+ ease to -0.6.
    let v = -0.5 + 0.1 * Math.sin(i * 0.2);
    if (i >= 44 && i <= 50) v = -0.4 + 3.0 * Math.exp(-Math.pow((i - 47) / 1.5, 2));
    else if (i >= 51 && i <= 70) v = -0.8 + 0.2 * Math.sin(i * 0.3);
    else if (i >= 71 && i <= 88) v = 0.4 - 0.5 * ((i - 71) / 17) + 0.15 * Math.sin(i * 0.4);
    else if (i >= 89) v = -0.1 - 0.5 * ((i - 89) / 30) + 0.12 * Math.sin(i * 0.3);
    out.push({
      date: `${y}-${String(m).padStart(2, "0")}`,
      fci: Number(v.toFixed(3)),
    });
    m += 1;
    if (m > 12) { m = 1; y += 1; }
  }
  return out;
}

const {
  data = makePlaceholder(),
  seriesLabel = "Chicago Fed NFCI",
  ariaLabel = "Financial conditions index over the last 10 years; positive readings denote tighter-than-average conditions.",
} = Astro.props;

// ---- Geometry ----
const VB_W = 720;
const VB_H = 432;
const M_L = 48;
const M_R = 76;
const M_T = 30;
const M_B = 34;
const PLOT_X0 = M_L;
const PLOT_Y0 = M_T;
const PLOT_W = VB_W - M_L - M_R;
const PLOT_H = VB_H - M_T - M_B;
const PLOT_X1 = PLOT_X0 + PLOT_W;
const PLOT_Y1 = PLOT_Y0 + PLOT_H;

function decYearOf(d: string): number {
  const [yy, mm] = d.split("-").map(Number);
  return yy + (mm - 0.5) / 12;
}
const xs = data.map((d) => decYearOf(d.date));
const xMin = xs[0];
const xMax = xs[xs.length - 1];

const allVals = data.map((d) => d.fci);
const rawMax = Math.max(...allVals);
const rawMin = Math.min(...allVals);
const absMax = Math.max(Math.abs(rawMax), Math.abs(rawMin), 1);
const yHi = Math.ceil(absMax * 1.1 * 2) / 2;
const yLo = -yHi;
const yTicks: number[] = [];
for (let v = yLo; v <= yHi + 1e-9; v += 1) yTicks.push(Number(v.toFixed(1)));

function xScale(decY: number): number {
  return PLOT_X0 + ((decY - xMin) / (xMax - xMin)) * PLOT_W;
}
function yScale(v: number): number {
  return PLOT_Y0 + PLOT_H - ((v - yLo) / (yHi - yLo)) * PLOT_H;
}

const fciPath = data.map((d, i) => `${i === 0 ? "M" : "L"}${xScale(xs[i]).toFixed(2)} ${yScale(d.fci).toFixed(2)}`).join(" ");

const yearTicks: Array<{ x: number; label: string }> = [];
for (let yy = Math.ceil(xMin); yy <= Math.floor(xMax); yy++) {
  if (yy % 2 !== 0) continue;
  const decY = yy + (1 - 0.5) / 12;
  if (decY < xMin || decY > xMax) continue;
  yearTicks.push({ x: xScale(decY), label: `'${String(yy).slice(-2)}` });
}

const recStart = 2020 + (2 - 0.5) / 12;
const recEnd = 2020 + (4 - 0.5) / 12;
const recVisible = recEnd >= xMin && recStart <= xMax;
const recX0 = recVisible ? xScale(Math.max(recStart, xMin)) : 0;
const recX1 = recVisible ? xScale(Math.min(recEnd, xMax)) : 0;

const last = data[data.length - 1];
const lastX = xScale(xs[xs.length - 1]);
const lastY = yScale(last.fci);
const monthShort = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
const lastDate = `${monthShort[Number(last.date.split("-")[1]) - 1]} ${last.date.split("-")[0]}`;
---
<figure class="markets-panel-6" aria-label={ariaLabel}>
  <svg
    class="markets-panel-6__svg"
    viewBox={`0 0 ${VB_W} ${VB_H}`}
    preserveAspectRatio="xMidYMid meet"
    role="img"
  >
    {recVisible && (
      <rect
        class="markets-panel-6__recession"
        x={recX0.toFixed(2)}
        y={PLOT_Y0}
        width={Math.max(1, recX1 - recX0).toFixed(2)}
        height={PLOT_H}
      />
    )}

    {yTicks.map((v) => {
      const isZero = Math.abs(v) < 1e-9;
      return (
        <line
          class:list={["markets-panel-6__gridline", { "markets-panel-6__gridline--zero": isZero }]}
          x1={PLOT_X0}
          y1={yScale(v).toFixed(2)}
          x2={PLOT_X1}
          y2={yScale(v).toFixed(2)}
        />
      );
    })}

    <path class="markets-panel-6__line" d={fciPath} fill="none" />

    <circle
      class="markets-panel-6__marker"
      cx={lastX.toFixed(2)}
      cy={lastY.toFixed(2)}
      r="3.5"
    >
      <title>{`${lastDate}: ${seriesLabel} ${last.fci.toFixed(2)}`}</title>
    </circle>

    <rect
      class="markets-panel-6__frame"
      x={PLOT_X0}
      y={PLOT_Y0}
      width={PLOT_W}
      height={PLOT_H}
      fill="none"
    />

    {yearTicks.map((t) => (
      <text
        class="markets-panel-6__xtick-label"
        x={t.x.toFixed(2)}
        y={(PLOT_Y1 + 16).toFixed(2)}
        text-anchor="middle"
      >{t.label}</text>
    ))}

    {yTicks.map((v) => {
      const sign = v > 0 ? "+" : "";
      const txt = `${sign}${v.toFixed(1)}`;
      return (
        <text
          class="markets-panel-6__ytick-label"
          x={(PLOT_X0 - 6).toFixed(2)}
          y={(yScale(v) + 3.5).toFixed(2)}
          text-anchor="end"
        >{txt}</text>
      );
    })}

    {/* Direction labels on right axis */}
    <text
      class="markets-panel-6__axis-hint"
      x={(PLOT_X1 + 6).toFixed(2)}
      y={(yScale(yHi) + 12).toFixed(2)}
      text-anchor="start"
    >Tighter</text>
    <text
      class="markets-panel-6__axis-hint"
      x={(PLOT_X1 + 6).toFixed(2)}
      y={(yScale(yLo) - 6).toFixed(2)}
      text-anchor="start"
    >Easier</text>

    <text
      class="markets-panel-6__unit"
      x={PLOT_X0.toFixed(2)}
      y={(PLOT_Y0 - 12).toFixed(2)}
      text-anchor="start"
    >{`${seriesLabel}. 0 = long-run average; positive = tighter.`}</text>
  </svg>
</figure>

<style>
  .markets-panel-6 {
    width: 100%;
    margin: 0;
    background-color: var(--surface);
  }
  .markets-panel-6__svg {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--font-sans);
    overflow: visible;
  }
  .markets-panel-6__recession {
    fill: rgba(0, 0, 0, 0.06);
  }
  .markets-panel-6__gridline {
    stroke: var(--ink);
    stroke-opacity: 0.15;
    stroke-width: 1;
    shape-rendering: crispEdges;
  }
  .markets-panel-6__gridline--zero {
    stroke: var(--ink);
    stroke-opacity: 1;
  }
  .markets-panel-6__line {
    stroke: #000000;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .markets-panel-6__marker {
    fill: #E63946;
    stroke: var(--surface);
    stroke-width: 1.25;
  }
  .markets-panel-6__frame {
    stroke: #000000;
    stroke-width: 1;
    shape-rendering: crispEdges;
  }
  .markets-panel-6__xtick-label,
  .markets-panel-6__ytick-label {
    fill: var(--ink);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: var(--fw-regular);
    font-variant-numeric: tabular-nums;
  }
  .markets-panel-6__axis-hint {
    fill: var(--ink);
    font-size: 10px;
    font-weight: var(--fw-medium);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .markets-panel-6__unit {
    fill: var(--ink);
    font-size: 11px;
    font-weight: var(--fw-medium);
    letter-spacing: 0.02em;
  }
</style>
