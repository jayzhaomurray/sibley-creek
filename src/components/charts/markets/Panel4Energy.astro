---
/*
 * Panel4Energy - WTI only.
 *
 * Pipeline emits `wti` (primary, USD/barrel). Brent overlay removed
 * 2026-05-14: it duplicated the WTI signal and added clutter; WCS
 * lives in monthly data so a second daily line wasn't the right
 * companion.
 */

import type { PanelData } from "../_shared/panelData";
import PanelLiveChart from "../_shared/PanelLiveChart.astro";
import PanelEmpty from "../_shared/PanelEmpty.astro";

interface Props {
  data?: PanelData | null;
}

const { data = null } = Astro.props;
---
{data && data.primary ? (
  <PanelLiveChart
    primary={data.primary}
    primaryLabel="WTI"
    dataPanelAttr="markets-6"
    ariaLabel="WTI oil price, USD per barrel."
  />
) : (
  <PanelEmpty reason="Pipeline did not emit panel-4 data." />
)}
