---
/*
 * Panel4Energy - Markets plate 4.
 *
 * Spec: editorial canon 4.6.4. Crude (WTI + Brent + WCS) and natural-gas
 * (AECO). Different units (USD/bbl vs CAD/GJ) force a small-multiples
 * approach to avoid a dishonest dual-axis. The Vignelli small-multiples
 * discipline (Section 5.3 small multiples): identical x-axis, panel-
 * specific y-axis, 1px hairline separator. WTI is the load-bearing oil
 * print; AECO is the gas print. Brent and WCS sit as recessive
 * companions in the oil panel.
 *
 * Visual: top panel - WTI (solid 1.5px black) + Brent (dashed 1px) +
 * WCS (dashed 1px lighter). MTA red dot on WTI latest. Bottom panel -
 * AECO (solid 1.5px). MTA red dot on AECO latest. Both panels share
 * the same x-axis but render their own y-scale.
 *
 * Plot vs SVG: hand-rolled SVG. Two stacked plots; trivial layout math.
 *
 * Gasoline-channel CPI impulse: the spec mentions this as a downstream
 * read - the panel itself does not embed it (would crowd four crude
 * series + gas + a CPI overlay). The page wiring's interpretation prose
 * carries the gasoline-channel narrative.
 */

interface EnergyRow {
  date: string;  // "YYYY-MM"
  wti: number;   // USD/bbl
  brent: number; // USD/bbl
  wcs: number;   // USD/bbl (monthly)
  aeco: number;  // CAD/GJ
}

interface Props {
  data?: EnergyRow[];
  ariaLabel?: string;
}

function makePlaceholder(): EnergyRow[] {
  const out: EnergyRow[] = [];
  let y = 2021;
  let m = 5;
  for (let i = 0; i < 60; i++) {
    const t = i / 59;
    // WTI: $65 -> spike $115 (mid-2022) -> $75 -> recover to $80.
    let wti = 65 + 50 * Math.exp(-Math.pow((i - 14) / 6, 2));
    if (i > 20) wti = 65 - 5 * Math.sin((i - 20) * 0.3) + 10 * Math.sin(i * 0.15);
    if (i > 45) wti += 6 + 4 * Math.sin((i - 45) * 0.4);
    wti = Math.max(50, wti);
    // Brent: WTI + 3-5.
    const brent = wti + 3.5 + Math.sin(i * 0.4);
    // WCS: WTI - 15-22 differential, with widening in 2022 peak.
    const wcs = wti - (18 + 4 * Math.sin(i * 0.25));
    // AECO: CAD/GJ. 3 -> spike 6 (Aug 2022) -> drop 1.5 -> recover 2.5.
    let aeco = 3 + 3 * Math.exp(-Math.pow((i - 16) / 4, 2));
    if (i > 22) aeco = 2 - 0.5 * Math.sin((i - 22) * 0.3) + 0.4 * Math.sin(i * 0.2);
    if (i > 48) aeco += 0.5;
    aeco = Math.max(1.0, aeco);
    out.push({
      date: `${y}-${String(m).padStart(2, "0")}`,
      wti: Number(wti.toFixed(1)),
      brent: Number(brent.toFixed(1)),
      wcs: Number(wcs.toFixed(1)),
      aeco: Number(aeco.toFixed(2)),
    });
    m += 1;
    if (m > 12) { m = 1; y += 1; }
  }
  return out;
}

const {
  data = makePlaceholder(),
  ariaLabel = "Energy prices: WTI / Brent / WCS crude and AECO natural gas, last 5 years.",
} = Astro.props;

// ---- Geometry: stacked small multiples ----
const VB_W = 720;
const VB_H = 432;
const M_L = 48;
const M_R = 64;
const M_T = 28;
const M_B = 30;
const SEP = 28;              // gap between oil and gas panels
const PLOT_W = VB_W - M_L - M_R;
const PLOT_H_TOP = 230;      // oil
const PLOT_H_BOT = (VB_H - M_T - M_B - SEP) - PLOT_H_TOP; // gas
const TOP_Y0 = M_T;
const TOP_Y1 = TOP_Y0 + PLOT_H_TOP;
const BOT_Y0 = TOP_Y1 + SEP;
const BOT_Y1 = BOT_Y0 + PLOT_H_BOT;
const PLOT_X0 = M_L;
const PLOT_X1 = PLOT_X0 + PLOT_W;

function decYearOf(d: string): number {
  const [yy, mm] = d.split("-").map(Number);
  return yy + (mm - 0.5) / 12;
}
const xs = data.map((d) => decYearOf(d.date));
const xMin = xs[0];
const xMax = xs[xs.length - 1];

// Oil y range.
const oilVals = data.flatMap((d) => [d.wti, d.brent, d.wcs]);
const oilLo = Math.floor(Math.min(...oilVals) / 20) * 20;
const oilHi = Math.ceil(Math.max(...oilVals) / 20) * 20;
const oilTicks: number[] = [];
for (let v = oilLo; v <= oilHi + 1e-9; v += 40) oilTicks.push(v);

// Gas y range.
const gasMax = Math.max(...data.map((d) => d.aeco));
const gasLo = 0;
const gasHi = Math.ceil((gasMax + 1) * 2) / 2;
const gasTicks: number[] = [];
for (let v = 0; v <= gasHi + 1e-9; v += 2) gasTicks.push(v);

function xScale(decY: number): number {
  return PLOT_X0 + ((decY - xMin) / (xMax - xMin)) * PLOT_W;
}
function oilScale(v: number): number {
  return TOP_Y0 + PLOT_H_TOP - ((v - oilLo) / (oilHi - oilLo)) * PLOT_H_TOP;
}
function gasScale(v: number): number {
  return BOT_Y0 + PLOT_H_BOT - ((v - gasLo) / (gasHi - gasLo)) * PLOT_H_BOT;
}

const wtiPath = data.map((d, i) => `${i === 0 ? "M" : "L"}${xScale(xs[i]).toFixed(2)} ${oilScale(d.wti).toFixed(2)}`).join(" ");
const brentPath = data.map((d, i) => `${i === 0 ? "M" : "L"}${xScale(xs[i]).toFixed(2)} ${oilScale(d.brent).toFixed(2)}`).join(" ");
const wcsPath = data.map((d, i) => `${i === 0 ? "M" : "L"}${xScale(xs[i]).toFixed(2)} ${oilScale(d.wcs).toFixed(2)}`).join(" ");
const aecoPath = data.map((d, i) => `${i === 0 ? "M" : "L"}${xScale(xs[i]).toFixed(2)} ${gasScale(d.aeco).toFixed(2)}`).join(" ");

const yearTicks: Array<{ x: number; label: string }> = [];
for (let yy = Math.ceil(xMin); yy <= Math.floor(xMax); yy++) {
  const decY = yy + (1 - 0.5) / 12;
  if (decY < xMin || decY > xMax) continue;
  yearTicks.push({ x: xScale(decY), label: `'${String(yy).slice(-2)}` });
}

const last = data[data.length - 1];
const lastX = xScale(xs[xs.length - 1]);
const lastWtiY = oilScale(last.wti);
const lastBrentY = oilScale(last.brent);
const lastWcsY = oilScale(last.wcs);
const lastAecoY = gasScale(last.aeco);
const monthShort = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
const lastDate = `${monthShort[Number(last.date.split("-")[1]) - 1]} ${last.date.split("-")[0]}`;
---
<figure class="markets-panel-4" aria-label={ariaLabel}>
  <svg
    class="markets-panel-4__svg"
    viewBox={`0 0 ${VB_W} ${VB_H}`}
    preserveAspectRatio="xMidYMid meet"
    role="img"
  >
    {/* ============ TOP: OIL ============ */}
    {oilTicks.map((v) => (
      <line
        class="markets-panel-4__gridline"
        x1={PLOT_X0}
        y1={oilScale(v).toFixed(2)}
        x2={PLOT_X1}
        y2={oilScale(v).toFixed(2)}
      />
    ))}

    <path class="markets-panel-4__line markets-panel-4__line--brent" d={brentPath} fill="none" />
    <path class="markets-panel-4__line markets-panel-4__line--wcs" d={wcsPath} fill="none" />
    <path class="markets-panel-4__line markets-panel-4__line--wti" d={wtiPath} fill="none" />

    <circle
      class="markets-panel-4__marker"
      cx={lastX.toFixed(2)}
      cy={lastWtiY.toFixed(2)}
      r="3.5"
    >
      <title>{`${lastDate}: WTI $${last.wti.toFixed(2)}/bbl`}</title>
    </circle>

    <rect
      class="markets-panel-4__frame"
      x={PLOT_X0}
      y={TOP_Y0}
      width={PLOT_W}
      height={PLOT_H_TOP}
      fill="none"
    />

    {oilTicks.map((v, i) => (
      <text
        class="markets-panel-4__ytick-label"
        x={(PLOT_X0 - 6).toFixed(2)}
        y={(oilScale(v) + 3.5).toFixed(2)}
        text-anchor="end"
      >{i === oilTicks.length - 1 ? `$${v}` : `${v}`}</text>
    ))}

    {/* Direct labels at termini */}
    <text class="markets-panel-4__direct-label" x={(lastX + 6).toFixed(2)} y={(lastWtiY + 4).toFixed(2)}>WTI</text>
    <text class="markets-panel-4__direct-label markets-panel-4__direct-label--secondary" x={(lastX + 6).toFixed(2)} y={(lastBrentY + 4).toFixed(2)}>Brent</text>
    <text class="markets-panel-4__direct-label markets-panel-4__direct-label--secondary" x={(lastX + 6).toFixed(2)} y={(lastWcsY + 4).toFixed(2)}>WCS</text>

    <text
      class="markets-panel-4__panel-label"
      x={PLOT_X0.toFixed(2)}
      y={(TOP_Y0 - 12).toFixed(2)}
      text-anchor="start"
    >Crude, USD per barrel</text>

    {/* ============ BOTTOM: GAS ============ */}
    {gasTicks.map((v) => (
      <line
        class="markets-panel-4__gridline"
        x1={PLOT_X0}
        y1={gasScale(v).toFixed(2)}
        x2={PLOT_X1}
        y2={gasScale(v).toFixed(2)}
      />
    ))}

    <path class="markets-panel-4__line markets-panel-4__line--aeco" d={aecoPath} fill="none" />

    <circle
      class="markets-panel-4__marker"
      cx={lastX.toFixed(2)}
      cy={lastAecoY.toFixed(2)}
      r="3.5"
    >
      <title>{`${lastDate}: AECO CAD ${last.aeco.toFixed(2)}/GJ`}</title>
    </circle>

    <rect
      class="markets-panel-4__frame"
      x={PLOT_X0}
      y={BOT_Y0}
      width={PLOT_W}
      height={PLOT_H_BOT}
      fill="none"
    />

    {gasTicks.map((v, i) => (
      <text
        class="markets-panel-4__ytick-label"
        x={(PLOT_X0 - 6).toFixed(2)}
        y={(gasScale(v) + 3.5).toFixed(2)}
        text-anchor="end"
      >{i === gasTicks.length - 1 ? `${v}` : `${v}`}</text>
    ))}

    <text class="markets-panel-4__direct-label" x={(lastX + 6).toFixed(2)} y={(lastAecoY + 4).toFixed(2)}>AECO</text>

    <text
      class="markets-panel-4__panel-label"
      x={PLOT_X0.toFixed(2)}
      y={(BOT_Y0 - 8).toFixed(2)}
      text-anchor="start"
    >Natural gas (AECO), CAD per GJ</text>

    {/* Shared x-axis labels under bottom panel */}
    {yearTicks.map((t) => (
      <text
        class="markets-panel-4__xtick-label"
        x={t.x.toFixed(2)}
        y={(BOT_Y1 + 16).toFixed(2)}
        text-anchor="middle"
      >{t.label}</text>
    ))}
  </svg>
</figure>

<style>
  .markets-panel-4 {
    width: 100%;
    margin: 0;
    background-color: var(--surface);
  }
  .markets-panel-4__svg {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--font-sans);
    overflow: visible;
  }
  .markets-panel-4__gridline {
    stroke: var(--ink);
    stroke-opacity: 0.15;
    stroke-width: 1;
    shape-rendering: crispEdges;
  }
  .markets-panel-4__line--wti,
  .markets-panel-4__line--aeco {
    stroke: #000000;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    fill: none;
  }
  .markets-panel-4__line--brent {
    stroke: #000000;
    stroke-width: 1;
    stroke-dasharray: 4 2;
    opacity: 0.55;
  }
  .markets-panel-4__line--wcs {
    stroke: #000000;
    stroke-width: 1;
    stroke-dasharray: 2 2;
    opacity: 0.45;
  }
  .markets-panel-4__marker {
    fill: #E63946;
    stroke: var(--surface);
    stroke-width: 1.25;
  }
  .markets-panel-4__frame {
    stroke: #000000;
    stroke-width: 1;
    shape-rendering: crispEdges;
  }
  .markets-panel-4__xtick-label,
  .markets-panel-4__ytick-label {
    fill: var(--ink);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: var(--fw-regular);
    font-variant-numeric: tabular-nums;
  }
  .markets-panel-4__direct-label {
    font-size: 11px;
    font-weight: var(--fw-medium);
    font-variant-numeric: tabular-nums;
    fill: var(--ink);
  }
  .markets-panel-4__direct-label--secondary {
    opacity: 0.65;
  }
  .markets-panel-4__panel-label {
    fill: var(--ink);
    font-size: 11px;
    font-weight: var(--fw-medium);
    letter-spacing: 0.02em;
  }
</style>
