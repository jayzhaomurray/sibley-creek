---
/*
 * Panel2GoCCurve - GoC 2y vs 5y.
 *
 * Pipeline emits `yield_2yr` (primary) and `yield_5yr` (secondary).
 * Both %; rendered as overlay.
 *
 * Wave 5 fold (EDR brief Section 3, "if not present"): 2Y-10Y yield
 * curve spread as transform toggle. Already in scope per canon; the
 * spread is a derived series (10Y minus 2Y, %), so toggle is a
 * transform view-switch. Deferred until the centralized toggle
 * pattern lands.
 *
 * Synthetic-data fallback removed.
 */

import type { PanelData } from "../_shared/panelData";
import PanelLiveChart from "../_shared/PanelLiveChart.astro";
import PanelEmpty from "../_shared/PanelEmpty.astro";

interface Props {
  data?: PanelData | null;
}

const { data = null } = Astro.props;
---
{data && data.primary ? (
  <PanelLiveChart
    primary={data.primary}
    secondary={data.secondary}
    primaryLabel="2y GoC"
    secondaryLabel="5y GoC"
    dataPanelAttr="markets-2"
    ariaLabel="GoC 2-year and 5-year yields, daily."
  />
) : (
  <PanelEmpty reason="Pipeline did not emit panel-2 data." />
)}
