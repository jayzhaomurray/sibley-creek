---
/*
 * Panel3CreditSpreads - credit spreads.
 *
 * Editorial argument is US IG / HY OAS plus a Canadian-spread caveat.
 * Pipeline emits `yield_10yr` only; OAS series are not on disk. We
 * fall back to PanelEmpty.
 *
 * Synthetic-data fallback removed.
 */

import type { PanelData } from "../_shared/panelData";
import PanelEmpty from "../_shared/PanelEmpty.astro";

interface Props {
  data?: PanelData | null;
}

const { data: _data = null } = Astro.props;
void _data;
---
<PanelEmpty reason="US IG / HY OAS series not yet emitted by pipeline." />
