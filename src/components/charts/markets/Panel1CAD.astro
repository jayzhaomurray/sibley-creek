---
/*
 * Panel1CAD - USDCAD and CAD effective rate.
 *
 * Pipeline emits `usdcad` (primary) and `fxusdcad` (secondary) - both
 * the same series in different form; we render the primary.
 *
 * Synthetic-data fallback removed.
 */

import type { PanelData } from "../_shared/panelData";
import PanelLiveChart from "../_shared/PanelLiveChart.astro";
import PanelEmpty from "../_shared/PanelEmpty.astro";

interface Props {
  data?: PanelData | null;
}

const { data = null } = Astro.props;
---
{data && data.primary ? (
  <PanelLiveChart
    primary={data.primary}
    secondary={data.secondary}
    primaryLabel="USDCAD"
    secondaryLabel="USDCAD (BoC)"
    dataPanelAttr="markets-1"
    ariaLabel="USDCAD exchange rate, daily."
  />
) : (
  <PanelEmpty reason="Pipeline did not emit panel-1 data." />
)}
