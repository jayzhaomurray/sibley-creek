---
/*
 * Panel1CAD - Markets plate 1.
 *
 * Spec: editorial canon Section 4.6.1. USDCAD level (primary) with
 * horizontal hairline reference lines at the P50 / P80 / P95 / P99
 * percentiles of the post-1990 distribution. CEER (BoC effective
 * exchange rate index) sits as a secondary 1px dashed series on a
 * mapped right axis so the reader sees the broader-CAD comparator
 * without two axes competing.
 *
 * Vignelli canon (design-system.md v1.0 Section 5 Tier 3):
 *   - 1.5px pure black USDCAD line, 1px dashed black CEER line
 *   - MTA red (#E63946) latest-point dot - the only red mark
 *   - 1px hairline pure-black plot frame
 *   - 6% ink recession band, unlabeled at chartbook scale
 *   - Plex Mono tick labels in ink at 11px
 *   - Percentile lines: 1px hairline at 0.35 opacity, labeled at right
 *
 * Plot vs SVG: hand-rolled SVG. Two lines, four reference rules, one
 * dot. Plot would add a React island and ~100KB for no gain.
 *
 * Placeholder data: synthesized 13-year monthly series ending Apr 2026,
 * USDCAD oscillating between 1.20 and 1.42 with the CEER mirror.
 * Percentile values are hand-set against a rough 1990-2026 distribution
 * (P50 ~1.27, P80 ~1.36, P95 ~1.41, P99 ~1.46). Fact-checker sanitizes
 * visible numeric callouts on TK pass.
 */

interface CADRow {
  date: string;   // "YYYY-MM"
  usdcad: number; // spot
  ceer: number;   // BoC CEER index (Jan 2017 = 100)
}

interface Props {
  data?: CADRow[];
  ariaLabel?: string;
  /** Reference month label for the latest print. */
  asOf?: string;
}

function makePlaceholder(): CADRow[] {
  // 156 months ending Apr 2026 (13y window).
  const out: CADRow[] = [];
  let y = 2013;
  let m = 5;
  for (let i = 0; i < 156; i++) {
    const t = i / 155;
    // Slow uptrend from 1.02 to ~1.35 with overshoots in 2016, 2020, 2022.
    let usd = 1.02 + 0.30 * t
      + 0.045 * Math.sin(i * 0.18)
      + 0.025 * Math.sin(i * 0.07 + 1.2);
    // Stress spike at 2020 (i ~85): + 0.04 dip and recovery.
    if (i >= 80 && i <= 90) usd += 0.06 * Math.exp(-Math.pow((i - 84) / 2.5, 2));
    // Latest 6 months drift toward 1.38.
    if (i >= 150) usd += 0.02 * ((i - 150) / 6);
    // CEER moves inversely-ish (broader CAD); index ~115 falling to ~108.
    let ceer = 116 - 8 * t + 1.2 * Math.sin(i * 0.18) - 0.6 * Math.sin(i * 0.07);
    if (i >= 80 && i <= 90) ceer -= 2.5 * Math.exp(-Math.pow((i - 84) / 2.5, 2));
    out.push({
      date: `${y}-${String(m).padStart(2, "0")}`,
      usdcad: Number(usd.toFixed(4)),
      ceer: Number(ceer.toFixed(2)),
    });
    m += 1;
    if (m > 12) { m = 1; y += 1; }
  }
  return out;
}

const {
  data = makePlaceholder(),
  ariaLabel = "USDCAD and the BoC CEER, with post-1990 percentile reference lines.",
  asOf = "Apr 2026",
} = Astro.props;

// ---- Post-1990 percentile reference values (placeholder) ----
const PERCENTILES = [
  { p: 50, value: 1.27, label: "P50" },
  { p: 80, value: 1.36, label: "P80" },
  { p: 95, value: 1.41, label: "P95" },
  { p: 99, value: 1.46, label: "P99" },
];

// ---- Geometry ----
const VB_W = 720;
const VB_H = 432; // 5:3 chartbook ratio
const M_L = 48;
const M_R = 92;
const M_T = 30;
const M_B = 34;
const PLOT_X0 = M_L;
const PLOT_Y0 = M_T;
const PLOT_W = VB_W - M_L - M_R;
const PLOT_H = VB_H - M_T - M_B;
const PLOT_X1 = PLOT_X0 + PLOT_W;
const PLOT_Y1 = PLOT_Y0 + PLOT_H;

function decYearOf(d: string): number {
  const [yy, mm] = d.split("-").map(Number);
  return yy + (mm - 0.5) / 12;
}
const xs = data.map((d) => decYearOf(d.date));
const xMin = xs[0];
const xMax = xs[xs.length - 1];

// Y range (USDCAD): from 1.00 to the higher of P99 + buffer or data max.
const dataMax = Math.max(...data.map((d) => d.usdcad));
const yLo = 1.00;
const yHi = Math.max(1.50, dataMax + 0.04);
const yTicks: number[] = [];
for (let v = yLo; v <= yHi + 1e-9; v += 0.10) yTicks.push(Number(v.toFixed(2)));

// CEER secondary scale, mapped to plot height (right axis omitted; series
// is recessive). Compute CEER min/max in window for a sensible mapping.
const ceerMin = Math.min(...data.map((d) => d.ceer));
const ceerMax = Math.max(...data.map((d) => d.ceer));
const ceerLo = Math.floor((ceerMin - 1) * 2) / 2;
const ceerHi = Math.ceil((ceerMax + 1) * 2) / 2;

function xScale(decY: number): number {
  return PLOT_X0 + ((decY - xMin) / (xMax - xMin)) * PLOT_W;
}
function yScale(v: number): number {
  return PLOT_Y0 + PLOT_H - ((v - yLo) / (yHi - yLo)) * PLOT_H;
}
function ceerScale(v: number): number {
  // Map CEER to USDCAD y-axis space by inversion (CEER up = CAD strong = USDCAD down).
  return PLOT_Y0 + ((v - ceerLo) / (ceerHi - ceerLo)) * PLOT_H;
}

function buildPath(ys: number[]): string {
  return ys.map((y, i) => `${i === 0 ? "M" : "L"}${xScale(xs[i]).toFixed(2)} ${y.toFixed(2)}`).join(" ");
}
const usdPath = buildPath(data.map((d) => yScale(d.usdcad)));
const ceerPath = buildPath(data.map((d) => ceerScale(d.ceer)));

// Recession bands: 2020 Q1-Q2 (visible in 13y window).
const recBands = [
  { start: 2020 + (2 - 0.5) / 12, end: 2020 + (4 - 0.5) / 12 },
];

// X-axis: year ticks every 2 years.
const yearTicks: Array<{ x: number; label: string }> = [];
const startY = Math.ceil(xMin);
const endY = Math.floor(xMax);
for (let yy = startY; yy <= endY; yy++) {
  if (yy % 2 !== 0) continue;
  const decY = yy + (1 - 0.5) / 12;
  if (decY < xMin || decY > xMax) continue;
  yearTicks.push({ x: xScale(decY), label: `'${String(yy).slice(-2)}` });
}

// Latest print.
const last = data[data.length - 1];
const lastX = xScale(xs[xs.length - 1]);
const lastY = yScale(last.usdcad);
const monthShort = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
const lastDateLabel = `${monthShort[Number(last.date.split("-")[1]) - 1]} ${last.date.split("-")[0]}`;
---
<figure class="markets-panel-1" aria-label={ariaLabel}>
  <svg
    class="markets-panel-1__svg"
    viewBox={`0 0 ${VB_W} ${VB_H}`}
    preserveAspectRatio="xMidYMid meet"
    role="img"
  >
    {/* Recession bands - behind everything */}
    {recBands.map((b) => {
      if (b.end < xMin || b.start > xMax) return null;
      const x0 = xScale(Math.max(b.start, xMin));
      const x1 = xScale(Math.min(b.end, xMax));
      return (
        <rect
          class="markets-panel-1__recession"
          x={x0.toFixed(2)}
          y={PLOT_Y0}
          width={Math.max(1, x1 - x0).toFixed(2)}
          height={PLOT_H}
        />
      );
    })}

    {/* Y gridlines */}
    {yTicks.map((v) => (
      <line
        class="markets-panel-1__gridline"
        x1={PLOT_X0}
        y1={yScale(v).toFixed(2)}
        x2={PLOT_X1}
        y2={yScale(v).toFixed(2)}
      />
    ))}

    {/* Percentile reference lines */}
    {PERCENTILES.map((p) => {
      const y = yScale(p.value);
      if (y < PLOT_Y0 || y > PLOT_Y1) return null;
      return (
        <g class="markets-panel-1__percentile">
          <line
            class="markets-panel-1__percentile-rule"
            x1={PLOT_X0}
            y1={y.toFixed(2)}
            x2={PLOT_X1}
            y2={y.toFixed(2)}
          />
          <text
            class="markets-panel-1__percentile-label"
            x={(PLOT_X1 + 4).toFixed(2)}
            y={(y + 3.5).toFixed(2)}
            text-anchor="start"
          >{p.label}</text>
        </g>
      );
    })}

    {/* CEER comparator (1px dashed) */}
    <path
      class="markets-panel-1__line markets-panel-1__line--ceer"
      d={ceerPath}
      fill="none"
    />

    {/* USDCAD primary line */}
    <path
      class="markets-panel-1__line markets-panel-1__line--usd"
      d={usdPath}
      fill="none"
    />

    {/* Latest-point dot (MTA red, the only red mark) */}
    <circle
      class="markets-panel-1__marker"
      cx={lastX.toFixed(2)}
      cy={lastY.toFixed(2)}
      r="3.5"
    >
      <title>{`${lastDateLabel}: USDCAD ${last.usdcad.toFixed(4)}`}</title>
    </circle>

    {/* Plot frame */}
    <rect
      class="markets-panel-1__frame"
      x={PLOT_X0}
      y={PLOT_Y0}
      width={PLOT_W}
      height={PLOT_H}
      fill="none"
    />

    {/* X-axis ticks + labels */}
    {yearTicks.map((t) => (
      <text
        class="markets-panel-1__xtick-label"
        x={t.x.toFixed(2)}
        y={(PLOT_Y1 + 16).toFixed(2)}
        text-anchor="middle"
      >{t.label}</text>
    ))}

    {/* Y-axis tick labels */}
    {yTicks.map((v, i) => (
      <text
        class="markets-panel-1__ytick-label"
        x={(PLOT_X0 - 6).toFixed(2)}
        y={(yScale(v) + 3.5).toFixed(2)}
        text-anchor="end"
      >{i === yTicks.length - 1 ? v.toFixed(2) : v.toFixed(2)}</text>
    ))}

    {/* Direct labels at termini */}
    <text
      class="markets-panel-1__direct-label markets-panel-1__direct-label--primary"
      x={(lastX + 6).toFixed(2)}
      y={(lastY + 4).toFixed(2)}
      text-anchor="start"
    >USDCAD</text>

    {/* Unit annotation top-left */}
    <text
      class="markets-panel-1__unit"
      x={PLOT_X0.toFixed(2)}
      y={(PLOT_Y0 - 12).toFixed(2)}
      text-anchor="start"
    >USDCAD spot; CEER (dashed, inverted scale)</text>
  </svg>
</figure>

<style>
  .markets-panel-1 {
    width: 100%;
    margin: 0;
    background-color: var(--surface);
  }
  .markets-panel-1__svg {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--font-sans);
    overflow: visible;
  }
  .markets-panel-1__recession {
    fill: rgba(0, 0, 0, 0.06);
  }
  .markets-panel-1__gridline {
    stroke: var(--ink);
    stroke-opacity: 0.15;
    stroke-width: 1;
    shape-rendering: crispEdges;
  }
  .markets-panel-1__percentile-rule {
    stroke: var(--ink);
    stroke-opacity: 0.20;
    stroke-width: 1;
    shape-rendering: crispEdges;
  }
  .markets-panel-1__percentile-label {
    fill: var(--ink);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: var(--fw-regular);
    letter-spacing: 0.02em;
  }
  .markets-panel-1__line--usd {
    stroke: #000000;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .markets-panel-1__line--ceer {
    stroke: #000000;
    stroke-width: 1;
    stroke-dasharray: 3 2;
    opacity: 0.45;
    stroke-linecap: butt;
    stroke-linejoin: round;
  }
  .markets-panel-1__marker {
    fill: #E63946;
    stroke: var(--surface);
    stroke-width: 1.25;
  }
  .markets-panel-1__frame {
    stroke: #000000;
    stroke-width: 1;
    shape-rendering: crispEdges;
  }
  .markets-panel-1__xtick-label,
  .markets-panel-1__ytick-label {
    fill: var(--ink);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: var(--fw-regular);
    font-variant-numeric: tabular-nums;
  }
  .markets-panel-1__direct-label {
    font-size: 11px;
    font-weight: var(--fw-medium);
    font-variant-numeric: tabular-nums;
    fill: var(--ink);
  }
  .markets-panel-1__unit {
    fill: var(--ink);
    font-size: 11px;
    font-weight: var(--fw-medium);
    letter-spacing: 0.02em;
  }
</style>
