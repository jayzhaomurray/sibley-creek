---
/*
 * Plate4FederalDebtPctGDP â€” Federal debt (accumulated deficit) as % of GDP.
 *
 * EDITORIAL PURPOSE: The sustainability anchor. Long 40-year history showing
 * the 1990s debt-to-GDP climb (peak 66.6% FY1995-96), the sustained paydown
 * to a pre-GFC trough (28.2% FY2008-09), the COVID surge (47.2% FY2020-21),
 * and TWO forecast tracks past the dashed divider: DoF (SEU Apr 2026) and
 * PBO (EFO Jun 2026). The chart's job: stability is agreed; PBO sits ~1pp
 * persistently higher.
 *
 * DATA: fiscal.json panel-9
 *   primary   = frt_federal_debt_pct_gdp
 *     42 actual points (FY1983-84 to FY2024-25) + 6 forecast (FY2025-26 to FY2030-31).
 *     is_forecast: 0 = history, 1 = forecast.
 *   secondary = frt_federal_debt_pct_gdp_pbo
 *     7 rows FY2024-25 to FY2030-31, all is_forecast=1.
 *     40.7 | 41.3 | 41.6 | 42.4 | 42.6 | 42.6 | 42.5
 *     NOTE: PBO FY2024-25 (40.7) is a forecast that falls in the history
 *     zone on the x-axis. Per design spec, the PBO line is clipped to the
 *     forecast zone only (starts at FY2025-26 = 41.3), so the history zone
 *     remains a single line. The PBO[0] point (2024-25) is excluded from the
 *     drawn path but retained for hit-area coverage.
 *
 * VINTAGE DIFFERENCE (non-negotiable editorial constraint): DoF denominator =
 *   SEU 2026 GDP forecasts; PBO denominator = PBO's own macro projections.
 *   The ~1pp gap reflects higher PBO deficit projections AND different GDP
 *   denominators. Do NOT present as purely deficit-driven. See panel-9 notes.
 *
 * Federal-only basis (NOT general-government gross debt; IMF/OECD general-govt
 * figures ~91-107% are NOT comparable). Chart carries this in the aria-label.
 *
 * FORECAST CONVENTION (R2.1 â€” vertical dashed divider, not dotted trace):
 *   Primary trace = ONE consistent 1.5px solid-ink line across history + DoF forecast.
 *   PBO trace = 1.5px MID-tint (0.55 opacity) line, forecast zone only.
 *   Forecast signal: vertical dashed divider (ink 1px, dash 4 3, 0.40 opacity)
 *   + "Forecast" micro-caps label above the projection region.
 *   Red dot (canon R2): 4px MTA red on last ACTUAL data point (FY2024-25 = 40.7).
 *   Dot marks latest observed value, NOT a projection. One red dot per chart.
 *   Numeric label left-above the actual dot, inside frame.
 *
 * DIRECT LABELS (compact words, no sentences):
 *   "Ottawa (Apr 2026)" â€” Manrope 600 13px, full ink, anchored at DoF line terminus
 *     (FY2030-31), placed BELOW the terminus (+18px) to separate from PBO label.
 *   "PBO (Jun 2026)"   â€” Manrope 400 13px, 0.55 ink, anchored at PBO line terminus
 *     (FY2030-31), placed ABOVE the terminus (-10px).
 *   Both right-anchored at PLOT_X1 - 6 (inside frame, no gutter overflow).
 *   Vertical separation between labels: ~33px (>>16px anti-collision threshold).
 *   Dot/numeric sit at actual point left of divider â€” no overlap with labels.
 *
 * Y-DOMAIN (tight per R2.3):
 *   Actual range: 28.2%â€“66.6%. With forecasts: 41.1%â€“42.6%. Full range ~28%â€“67%.
 *   Tight axis: 20% to 70%, 10pp strides. 6 ticks, 4 interior gridlines.
 *   PBO max 42.6 well inside domain. Tick density unchanged.
 *
 * LONG HISTORY: FY1983-84 â†’ FY2030-31. x-ticks at decade end-years + 2031.
 *
 * CANON COMPLIANCE (Tier-3):
 *   1. Primary: single solid-ink 1.5px line. No dotted forecast line.
 *   2. PBO: solid MID (0.55) 1.5px line, forecast zone only.
 *   3. Forecast signal = vertical dashed divider + "Forecast" label (R2.1).
 *   4. Full 40-year history visible (1990s peak story is the point).
 *   5. MTA red dot on last ACTUAL data point (FY2024-25), one per chart (R2). No dot on PBO.
 *   6. Latest-actual numeric label left-above actual dot, inside frame.
 *   7. Reference annotations: 1990s peak, pre-GFC trough, COVID peak.
 *   8. Hairline frame 1px ink.
 *   9. 4 interior gridlines, 0.18 opacity.
 *  10. Plex Mono y-ticks; topmost "%".
 *  11. Manrope x-ticks every 5 years.
 *  12. Direct terminus labels (compact words, inside frame).
 *  13. viewBox 720x405.
 *  14. aria-label states federal-only basis and both forecast tracks.
 *  15. No source/caption/methodology inside SVG.
 *  16. No new visual vocabulary â€” grey-tint MID 0.55 matches Plate2OperatingDispute.
 */

import type { PanelData } from "../_shared/panelData";
import PanelEmpty from "../_shared/PanelEmpty.astro";

interface Props {
  data?: PanelData | null;
}

const { data = null } = Astro.props;

// ---- Data extraction -----------------------------------------------------------
type RawPt = { date: string; value: number | null; is_forecast?: number; fy_label?: string };

interface Pt {
  fyLabel: string;
  value: number;
  isForecast: boolean;
}

// Primary series (DoF history + forecast)
const pts: Pt[] = [];

if (data?.primary?.data && data.primary.data.length > 0) {
  for (const r of data.primary.data as RawPt[]) {
    if (r.value === null || r.value === undefined) continue;
    pts.push({
      fyLabel: r.fy_label ?? r.date.slice(0, 4),
      value: r.value,
      isForecast: r.is_forecast === 1,
    });
  }
}

const hasData = pts.length > 0;

// Secondary series (PBO forecast)
// PBO data: all is_forecast=1, FY2024-25 through FY2030-31.
// We draw the PBO line only in the forecast zone (FY2025-26+), so the history
// zone stays single-line. The FY2024-25 PBO point is excluded from the drawn
// path (it falls left of the forecast divider x-position).
interface PboPt {
  fyLabel: string;
  value: number;
}
const pboPts: PboPt[] = [];

if (data?.secondary?.data && (data.secondary.data as RawPt[]).length > 0) {
  for (const r of data.secondary.data as RawPt[]) {
    if (r.value === null || r.value === undefined) continue;
    const fy = r.fy_label ?? r.date.slice(0, 4);
    pboPts.push({ fyLabel: fy, value: r.value });
  }
}

// ---- Geometry ------------------------------------------------------------------
const VB_W = 720;
const VB_H = 405;
const M_L = 56;   // canon left margin
const M_R = 96;   // canon right gutter for direct terminus labels
const M_T = 44;   // canon top
const M_B = 40;   // canon bottom

const PLOT_X0 = M_L;
const PLOT_X1 = VB_W - M_R;
const PLOT_Y0 = M_T;
const PLOT_Y1 = VB_H - M_B;
const PLOT_W  = PLOT_X1 - PLOT_X0;
const PLOT_H  = PLOT_Y1 - PLOT_Y0;

// ---- Y domain: tight, covers 1990s peak (66.6%) and pre-GFC trough (28.2%) ----
// Range: ~28%â€“67% historical + ~41%â€“42.6% forecast. Tight axis: 20%â€“70%, 10pp strides.
// PBO max 42.6 is well inside domain. Tick density unchanged.
const Y_DOM_MIN = 20;
const Y_DOM_MAX = 70;
const Y_TICK_STEP = 10;
const ySpan = Y_DOM_MAX - Y_DOM_MIN;

const yScale = (v: number): number =>
  PLOT_Y0 + PLOT_H - ((v - Y_DOM_MIN) / ySpan) * PLOT_H;

// ---- X scale (uniform index spacing â€” annual fiscal years) ---------------------
const N = pts.length;
const xOfIndex = (i: number): number =>
  PLOT_X0 + (N > 1 ? (i / (N - 1)) * PLOT_W : PLOT_W / 2);

// ---- Y ticks -------------------------------------------------------------------
type YTick = { y: number; label: string };
const yTickVals: number[] = [];
for (let v = Y_DOM_MIN; v <= Y_DOM_MAX; v += Y_TICK_STEP) yTickVals.push(v);
const yTicks: YTick[] = yTickVals.map((v, i) => ({
  y: yScale(v),
  label: i === yTickVals.length - 1 ? `${v}%` : `${v}`,
}));
const gridlines = yTickVals.filter((v) => v > Y_DOM_MIN && v < Y_DOM_MAX);

// ---- X ticks -------------------------------------------------------------------
const fyEndYear = (fy: string): number => parseInt(fy.slice(0, 4), 10) + 1;
type XTick = { x: number; label: string };
const X_TARGET_ENDYEARS = [1990, 2000, 2010, 2020];
const seriesEndYear = pts.length > 0 ? fyEndYear(pts[pts.length - 1]!.fyLabel) : null;
const xTargetSet = new Set<number>(X_TARGET_ENDYEARS);
if (seriesEndYear !== null) xTargetSet.add(seriesEndYear);
const xTicks: XTick[] = pts
  .map((p, i) => ({ i, ey: fyEndYear(p.fyLabel) }))
  .filter(({ ey }) => xTargetSet.has(ey))
  .map(({ i, ey }) => ({ x: xOfIndex(i), label: String(ey) }));

// ---- Forecast boundary ---------------------------------------------------------
const firstForecastIdx = (() => {
  for (let i = 0; i < pts.length; i++) {
    if (pts[i]!.isForecast) return i;
  }
  return -1;
})();

// Divider x: midpoint between last actual and first forecast
const dividerX = firstForecastIdx > 0
  ? (xOfIndex(firstForecastIdx - 1) + xOfIndex(firstForecastIdx)) / 2
  : null;

// ---- Primary line path â€” single continuous line --------------------------------
const linePath = pts
  .map((p, i) => `${i === 0 ? "M" : "L"}${xOfIndex(i).toFixed(2)},${yScale(p.value).toFixed(2)}`)
  .join(" ");

// ---- PBO line path â€” forecast zone only ----------------------------------------
// Map each PBO point to the x-position of the matching primary series index
// (same fiscal year). Skip FY2024-25 (would fall left of/at the divider in the
// history zone). Draw only FY2025-26 â†’ FY2030-31.
//
// The PBO fiscal years are: 2024-25, 2025-26, 2026-27, 2027-28, 2028-29, 2029-30, 2030-31
// The forecast zone starts at FY2025-26 (primary index = firstForecastIdx).
// We map each PBO point to primary index by matching fyLabel.

interface PboPlotPt {
  x: number;
  y: number;
  fyLabel: string;
  value: number;
}

const pboPlotPts: PboPlotPt[] = [];
for (const pp of pboPts) {
  // Only draw in forecast zone: skip FY2024-25
  if (pp.fyLabel === "2024-25") continue;
  const primaryIdx = pts.findIndex((p) => p.fyLabel === pp.fyLabel);
  if (primaryIdx < 0) continue;
  pboPlotPts.push({
    x: xOfIndex(primaryIdx),
    y: yScale(pp.value),
    fyLabel: pp.fyLabel,
    value: pp.value,
  });
}

const pboLinePath = pboPlotPts.length > 1
  ? pboPlotPts.map((p, i) => `${i === 0 ? "M" : "L"}${p.x.toFixed(2)},${p.y.toFixed(2)}`).join(" ")
  : "";

// ---- Red dot: last ACTUAL data point (is_forecast === false) -------------------
// Canon R2: the latest-point dot marks the last OBSERVED value, not a projection.
// Stamping a forecast endpoint with the red dot misrepresents the convention.
// The last actual is the point immediately left of the forecast divider.
const dotIdx = firstForecastIdx > 0 ? firstForecastIdx - 1 : pts.length - 1;
const dotPt  = dotIdx >= 0 ? pts[dotIdx] : null;
const dotX   = dotIdx >= 0 ? xOfIndex(dotIdx) : 0;
const dotY   = dotPt ? yScale(dotPt.value) : 0;
// Numeric label shows the last actual value (e.g. "40.7%"), not the forecast endpoint.
const latestLabel = dotPt ? `${dotPt.value.toFixed(1)}%` : "";

// ---- PBO endpoint label coordinates --------------------------------------------
// Last PBO plot point = FY2030-31 at 42.5.
const pboLast = pboPlotPts.length > 0 ? pboPlotPts[pboPlotPts.length - 1] : null;

// ---- DoF forecast endpoint â€” used for "Ottawa" terminus label only --------------
// The red dot has moved to the actual point; the "Ottawa" label still anchors to
// the DoF line terminus (last primary point = FY2030-31, 41.6).
const dofEndIdx = pts.length - 1;
const dofEndPt  = dofEndIdx >= 0 ? pts[dofEndIdx] : null;
const dofEndY   = dofEndPt ? yScale(dofEndPt.value) : 0;

// ---- Anti-collision spread for two forecast terminus labels --------------------
// DoF line terminus: 41.6 â†’ yScale(41.6) â‰ˆ 226px
// PBO line terminus: 42.5 â†’ yScale(42.5) â‰ˆ 221px  (only ~5px apart)
// Required spread: â‰¥16px between label baselines.
// Solution: DoF label BELOW its line terminus (+18px); PBO label ABOVE its terminus (âˆ’10px).
// Separation = 18 + 10 + (yDoF - yPbo) â‰ˆ 28 + 5 = 33px >> 16px threshold.
//
// Both labels are inside the plot (text-anchor="end" at PLOT_X1 âˆ’ 6) â€” not in gutter.
// Dot/numeric sit at the actual point (left of the divider), no overlap with labels.
const LABEL_X = PLOT_X1 - 6;  // inside frame, text-anchor="end"

// Ottawa label drops to +34 (not +18): the latest-actual numeric now sits at
// dotY+18 â‰ˆ y247 centered on xâ‰ˆ551, and an Ottawa label at dofEndY+18 â‰ˆ y244
// (end-anchored at 618, spanning left past x530) would collide with it.
// Stack order topâ†’bottom: PBO label / lines / numeric / Ottawa label.
const dofLabelY  = dofEndPt ? dofEndY + 34 : 0;   // below DoF terminus, under the numeric row
const pboLabelY  = pboLast  ? pboLast.y - 10 : 0; // above PBO line terminus

// ---- Reference annotations (words only â€” canon) --------------------------------
interface AnnotDef { fyLabel: string; word: string; value: string; above: boolean }
const annotDefs: AnnotDef[] = [
  { fyLabel: "1995-96", word: "1996 peak", value: "66.6%", above: false },
  { fyLabel: "2008-09", word: "Pre-crisis low", value: "28.2%", above: false },
  { fyLabel: "2020-21", word: "Pandemic", value: "47.2%", above: true },
];

interface AnnotPt { x: number; y: number; word: string; value: string; above: boolean }
const annotPts: AnnotPt[] = [];
for (const def of annotDefs) {
  const idx = pts.findIndex((p) => p.fyLabel === def.fyLabel);
  if (idx >= 0 && pts[idx]) {
    annotPts.push({
      x: xOfIndex(idx),
      y: yScale(pts[idx]!.value),
      word: def.word,
      value: def.value,
      above: def.above,
    });
  }
}

// ---- Hit areas -----------------------------------------------------------------
type Hit = { cx: number; cy: number; title: string };
const hits: Hit[] = pts.map((p, i) => ({
  cx: xOfIndex(i),
  cy: yScale(p.value),
  title: `FY${p.fyLabel}: ${p.value.toFixed(1)}% of GDP (federal)${p.isForecast ? " (DoF SEU 2026 proj.)" : ""}`,
}));

const pboHits: Hit[] = pboPlotPts.map((p) => ({
  cx: p.x,
  cy: p.y,
  title: `FY${p.fyLabel}: ${p.value.toFixed(1)}% of GDP (PBO EFO Jun 2026 proj.)`,
}));

// ---- aria-label ----------------------------------------------------------------
const dofEndLabel = dofEndPt ? `${dofEndPt.value.toFixed(1)}%` : "";
const ariaLabel =
  `Federal debt as a percentage of GDP (federal government only, NOT general government), ` +
  `FY${pts[0]?.fyLabel ?? ""} to FY${pts[pts.length - 1]?.fyLabel ?? ""}. ` +
  `1990s peak: 66.6% FY1995-96. Pre-GFC trough: 28.2% FY2008-09. COVID peak: 47.2% FY2020-21. ` +
  `Last actual: ${latestLabel} (FY${dotPt?.fyLabel ?? ""}). ` +
  `Two forecast tracks past the dashed divider: ` +
  `DoF (SEU April 2026) ends at ${dofEndLabel} (FY${dofEndPt?.fyLabel ?? ""}, projected). ` +
  `PBO (EFO June 2026) ends at ${pboLast ? pboLast.value.toFixed(1) + "%" : "n/a"} (FY${pboLast?.fyLabel ?? ""}, projected). ` +
  `PBO sits persistently ~1 percentage point higher than DoF across the forecast horizon.`;
---

{!hasData ? (
  <PanelEmpty reason="DATA NOT YET WIRED â€” fiscal.json panel-9 frt_federal_debt_pct_gdp" />
) : (
  <div class="p4dbt-chart" data-panel="fiscal-plate-4" data-panel-status="live">
    <svg
      class="p4dbt-chart__svg"
      viewBox={`0 0 ${VB_W} ${VB_H}`}
      preserveAspectRatio="xMidYMid meet"
      role="img"
      aria-label={ariaLabel}
    >

      {/* Horizontal gridlines */}
      {gridlines.map((v) => (
        <line
          class="p4dbt-chart__gridline"
          x1={PLOT_X0.toFixed(2)} y1={yScale(v).toFixed(2)}
          x2={PLOT_X1.toFixed(2)} y2={yScale(v).toFixed(2)}
        />
      ))}

      {/* Primary line â€” single continuous solid-ink 1.5px line (history + DoF forecast) */}
      {linePath && <path class="p4dbt-chart__line" d={linePath} />}

      {/* PBO forecast line â€” MID tint (0.55), forecast zone only (FY2025-26 â†’ FY2030-31) */}
      {pboLinePath && <path class="p4dbt-chart__line-pbo" d={pboLinePath} />}

      {/* Primary series hit areas */}
      {hits.map((h) => (
        <circle class="p4dbt-chart__hit" cx={h.cx.toFixed(2)} cy={h.cy.toFixed(2)} r="5">
        </circle>
      ))}

      {/* PBO series hit areas */}
      {pboHits.map((h) => (
        <circle class="p4dbt-chart__hit" cx={h.cx.toFixed(2)} cy={h.cy.toFixed(2)} r="5">
        </circle>
      ))}

      {/* Reference annotations â€” words + values only.
          LEADER ROUTING: leader stub 7px short of the point, stopping short of text band. */}
      {annotPts.map((a) => {
        const wordY  = a.above ? a.y - 31 : a.y + 43;
        const valueY = a.above ? a.y - 18 : a.y + 30;
        const leaderNear = a.above ? a.y - 7  : a.y + 7;
        const leaderFar  = a.above ? a.y - 13 : a.y + 18;
        return (
          <g>
            <circle class="p4dbt-chart__annot-dot" cx={a.x.toFixed(2)} cy={a.y.toFixed(2)} r="2.5" />
            <line
              class="p4dbt-chart__annot-leader"
              x1={a.x.toFixed(2)} y1={leaderNear.toFixed(2)}
              x2={a.x.toFixed(2)} y2={leaderFar.toFixed(2)}
            />
            <text
              class="p4dbt-chart__annot-word"
              x={a.x.toFixed(2)} y={wordY.toFixed(2)}
              text-anchor="middle"
            >{a.word}</text>
            <text
              class="p4dbt-chart__annot-value"
              x={a.x.toFixed(2)} y={valueY.toFixed(2)}
              text-anchor="middle"
            >{a.value}</text>
          </g>
        );
      })}

      {/* Vertical forecast divider (R2.1) */}
      {dividerX !== null && (
        <line
          class="p4dbt-chart__divider"
          x1={dividerX.toFixed(2)} y1={PLOT_Y0.toFixed(2)}
          x2={dividerX.toFixed(2)} y2={PLOT_Y1.toFixed(2)}
        />
      )}

      {/* "Forecast" label above projection region (R2.1) */}
      {dividerX !== null && (
        <text
          class="p4dbt-chart__forecast-label"
          x={(dividerX + 6).toFixed(2)}
          y={(PLOT_Y0 - 6).toFixed(2)}
          text-anchor="start"
        >FORECAST</text>
      )}

      {/* MTA red dot â€” last ACTUAL data point (R2 canon: marks latest observed, not a projection) */}
      {dotPt && (
        <circle
          class="p4dbt-chart__latest-dot"
          cx={dotX.toFixed(2)}
          cy={dotY.toFixed(2)}
          r="4"
        >
        </circle>
      )}

      {/* Latest-point numeric label â€” BELOW the actual dot, centered. The space
          above the dot is occupied by the PBO forecast line + its label; below
          the ~41% line the plot is empty, so the numeric drops underneath. */}
      {dotPt && latestLabel && (
        <text
          class="p4dbt-chart__latest-label"
          x={dotX.toFixed(2)}
          y={(dotY + 18).toFixed(2)}
          text-anchor="middle"
        >{latestLabel}</text>
      )}

      {/* Hairline frame */}
      <rect
        class="p4dbt-chart__frame"
        x={PLOT_X0.toFixed(2)} y={PLOT_Y0.toFixed(2)}
        width={PLOT_W.toFixed(2)} height={PLOT_H.toFixed(2)}
      />

      {/* Y-axis tick labels */}
      {yTicks.map((t) => (
        <text
          class="p4dbt-chart__ytick-label"
          x={(PLOT_X0 - 8).toFixed(2)}
          y={(t.y + 4).toFixed(2)}
          text-anchor="end"
        >{t.label}</text>
      ))}

      {/* X-axis tick labels */}
      {xTicks.map((t) => (
        <g>
          <line
            class="p4dbt-chart__xtick"
            x1={t.x.toFixed(2)} y1={PLOT_Y1.toFixed(2)}
            x2={t.x.toFixed(2)} y2={(PLOT_Y1 + 5).toFixed(2)}
          />
          <text
            class="p4dbt-chart__xtick-label"
            x={t.x.toFixed(2)}
            y={(PLOT_Y1 + 18).toFixed(2)}
            text-anchor="middle"
          >{t.label}</text>
        </g>
      ))}

      {/* Direct terminus labels â€” compact words, inside plot, right-anchored.
          Anti-collision spread: DoF BELOW its endpoint (+18px), PBO ABOVE (âˆ’10px).
          Separation â‰ˆ 28px + endpoint pixel gap > 16px threshold.
          DoF (primary): 600 weight, full ink.
          PBO (secondary): 400 weight, 0.55 ink (MID tint, matches bar language). */}
      {dotPt && (
        <text
          class="p4dbt-chart__term-dof"
          x={LABEL_X.toFixed(2)}
          y={dofLabelY.toFixed(2)}
          text-anchor="end"
        >Ottawa (Apr 2026)</text>
      )}
      {pboLast && (
        <text
          class="p4dbt-chart__term-pbo"
          x={LABEL_X.toFixed(2)}
          y={pboLabelY.toFixed(2)}
          text-anchor="end"
        >PBO (Jun 2026)</text>
      )}

    </svg>
  </div>
)}

<style>
  /*
   * Plate4FederalDebtPctGDP â€” Tier-3 dual-forecast line chart.
   * Federal debt % of GDP, 40-year history + two forecast tracks (DoF + PBO).
   * R2.1-conformant: solid line throughout, vertical dashed divider for forecast signal.
   * Grey-tint vocabulary: primary = INK 1.00, secondary (PBO) = MID 0.55.
   * Matches Plate2OperatingDispute two-series tint convention.
   */
  .p4dbt-chart {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: var(--paper);
    overflow: visible;
  }
  .p4dbt-chart__svg {
    display: block;
    width: 100%;
    height: 100%;
    font-family: var(--font-sans);
    overflow: visible;
  }
  .p4dbt-chart__gridline {
    stroke: var(--ink);
    stroke-width: 1;
    stroke-opacity: 0.18;
    shape-rendering: crispEdges;
  }
  /* Primary line: INK 1.00 â€” single solid-ink trace (history + DoF forecast) */
  .p4dbt-chart__line {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
    stroke-opacity: 1;
    stroke-linejoin: round;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  /* PBO forecast line: MID 0.55 â€” grey-tint secondary series, forecast zone only.
     Matches Plate2OperatingDispute .p2od-chart__bar-pbo fill-opacity: 0.55. */
  .p4dbt-chart__line-pbo {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
    stroke-opacity: 0.55;
    stroke-linejoin: round;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .p4dbt-chart__hit {
    fill: transparent;
    stroke: none;
    cursor: default;
  }
  .p4dbt-chart__annot-dot {
    fill: var(--ink);
    stroke: none;
  }
  /* Annotation leader: 1px pure ink, ends 4px short */
  .p4dbt-chart__annot-leader {
    stroke: var(--ink);
    stroke-width: 1;
    shape-rendering: crispEdges;
  }
  /* Annotation word: 13px Manrope 400 full ink */
  .p4dbt-chart__annot-word {
