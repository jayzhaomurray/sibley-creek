---
/*
 * Plate2OperatingDispute — operating-balance comparison, grouped signed bars.
 *
 * CHART JOB: show that the as-presented Budget 2025 operating balance crosses
 *   zero by FY2028-29 while the PBO's recast of the same budget under a
 *   stricter capital standard never clears zero. Same vintage, two definitions.
 *
 * DATA: fiscal.json panel-11 ($B, all is_forecast=1)
 *   primary   = frt_operating_balance_b2025   Budget 2025, as presented
 *               FY2024-25 → FY2029-30
 *               -4.1 | -33.0 | -8.7 | -5.5 | +1.7 | +3.0
 *   secondary = frt_operating_balance_pbo     Same budget, PBO definition
 *               FY2024-25 → FY2029-30
 *               -10.5 | -45.8 | -25.3 | -23.3 | -18.1 | -17.6
 *
 * SAME-VINTAGE DESIGN: both series are drawn from PBO RP-2526-017-S (Nov 2025),
 *   Budget 2025 baseline. Year coverage is identical — every year renders exactly
 *   two uniform-width bars. The year-by-year gap is purely the capital-definition
 *   wedge; cumulative FY2024-25→2029-30 sums to ~$94B.
 *
 * FORM: Grouped signed bars — as-presented (INK 1.00, left bar) and PBO
 *   definition (MID 0.55, right bar) per fiscal year. Uniform BAR_W for every
 *   bar. Grey-tint differentiation, no hatch, no texture.
 *
 * FORECAST: entire chart is projection-space (all is_forecast=1). No forecast
 *   divider — vintage labels carry the era-signal.
 *
 * DIRECT LABELS (right-anchor, inside plot whitespace):
 *   "As presented"    — 600 weight, top-right above the zero line (y = PLOT_Y0+14)
 *   "PBO definition"  — 400 weight, lower-plot whitespace (y = yScale(-30))
 *   Vertical separation ~200px — far exceeds the 16px minimum.
 *
 * ANNOTATION: "$94B capital, reclassified" — compact callout, upper-left
 *   whitespace (early-year bars all below zero). Free-standing, no leader.
 *
 * ZERO LINE: 1px pure-ink full-opacity per canon.
 *
 * Y-DOMAIN: -50 to +10, step 10 ($B). Topmost tick: "+$10B".
 *   Data range -45.8 to +3.0 — domain still comfortable.
 *
 * X-AXIS: 'YY short-year labels per conformance audit.
 *
 * CANON COMPLIANCE (Tier-3, bespoke bar):
 *   viewBox 720x405 (16:9), preserveAspectRatio xMidYMid meet
 *   overflow:visible on wrapper + SVG
 *   M_L=56 M_R=96 M_T=44 M_B=40 (canon margins)
 *   y-tick x at PLOT_X0-8, x-tick y at PLOT_Y1+18 (conformance audit fix)
 *   1px full-opacity zero line
 *   gridlines 0.18 stroke-opacity
 *   1px hairline plot frame
 *   Plex Mono y-ticks, Manrope x-ticks (12px each)
 *   Direct series labels: Manrope 13px, 600/400 weight, pure ink
 *   No latest-point dot (bars — canon R2)
 *   No sentences inside SVG; no full source paragraphs
 *   All color tokens (var(--ink), var(--paper)), no hardcoded hex
 *
 * BEM scope: p2od-chart__* (plate-2-operating-dispute)
 */

import type { PanelData } from "../_shared/panelData";
import PanelEmpty from "../_shared/PanelEmpty.astro";

interface Props {
  data?: PanelData | null;
}

const { data = null } = Astro.props;

// ---- Data types ----------------------------------------------------------------
type RawPt = { date: string; value: number | null; is_forecast?: number; fy_label?: string };

interface BarPt {
  fyLabel: string;      // "2024-25"
  shortYear: string;    // "'25"
  endYear: number;      // 2025 (for sort/order)
  asPresented: number | null;
  pbo: number | null;
}

// Parse both series by fy_label key.
// Internal variable names use the semantic role (asPresented / pbo) not the
// old DoF-vintage names — same-vintage data, two definitions.
const asPresentedMap = new Map<string, number>();
const pboMap = new Map<string, number>();

function ingestSeries(series: { data?: RawPt[] } | undefined, target: Map<string, number>) {
  if (!series?.data) return;
  for (const r of series.data) {
    if (r.value === null || r.value === undefined) continue;
    const fy = r.fy_label ?? r.date.slice(0, 4);
    target.set(fy, r.value);
  }
}
ingestSeries(data?.primary as { data?: RawPt[] } | undefined, asPresentedMap);
ingestSeries(data?.secondary as { data?: RawPt[] } | undefined, pboMap);

// Union of all FYs with at least one value, chronologically by end-year.
// With same-vintage data every FY has both values; the union logic is
// harmless and handles any future edge-case gracefully.
const fyEndYear = (fy: string): number => parseInt(fy.slice(0, 4), 10) + 1;
const shortYear = (fy: string): string => `'${String(fyEndYear(fy)).slice(2)}`;

const allFYs = Array.from(new Set([...asPresentedMap.keys(), ...pboMap.keys()]))
  .sort((a, b) => fyEndYear(a) - fyEndYear(b));

const bars: BarPt[] = allFYs.map((fy) => ({
  fyLabel: fy,
  shortYear: shortYear(fy),
  endYear: fyEndYear(fy),
  asPresented: asPresentedMap.get(fy) ?? null,
  pbo: pboMap.get(fy) ?? null,
}));

const hasData = bars.length > 0;

// ---- Geometry ------------------------------------------------------------------
const VB_W = 720;
const VB_H = 405;
const M_L = 56;
const M_R = 96;   // right gutter: series labels live here
const M_T = 44;
const M_B = 40;

const PLOT_X0 = M_L;
const PLOT_X1 = VB_W - M_R;
const PLOT_Y0 = M_T;
const PLOT_Y1 = VB_H - M_B;
const PLOT_W  = PLOT_X1 - PLOT_X0;
const PLOT_H  = PLOT_Y1 - PLOT_Y0;

// ---- Y domain ------------------------------------------------------------------
// Data range: -45.8 to +3.0. Nice domain: -50 to +10, step 10 -> 7 ticks.
// Domain unchanged from original (confirmed still comfortable for data range).
const Y_DOM_MIN = -50;
const Y_DOM_MAX = 10;
const Y_TICK_STEP = 10;
const ySpan = Y_DOM_MAX - Y_DOM_MIN;

const yScale = (v: number): number =>
  PLOT_Y0 + PLOT_H - ((v - Y_DOM_MIN) / ySpan) * PLOT_H;

// ---- Y ticks -------------------------------------------------------------------
type YTick = { y: number; label: string };
const yTickVals: number[] = [];
for (let v = Y_DOM_MIN; v <= Y_DOM_MAX; v += Y_TICK_STEP) yTickVals.push(v);
const yTicks: YTick[] = yTickVals.map((v, i) => ({
  y: yScale(v),
  label:
    i === yTickVals.length - 1
      ? "+$10B"       // topmost tick carries unit suffix
      : v === 0
        ? "0"
        : v > 0
          ? `+${v}`
          : `${v}`,
}));
// Gridlines at all non-zero, non-bottom ticks
const gridlines = yTickVals.filter((v) => v !== 0 && v !== Y_DOM_MIN);

// ---- Bar geometry (grouped) ----------------------------------------------------
// N year-slots, each with exactly 2 bars (as-presented left, PBO right).
// Uniform BAR_W for every bar — same-vintage data means no sole-series years.
// The sole-series guard in barRects remains for defensive robustness.
const N = bars.length; // 6 years: FY2024-25 thru FY2029-30
const SLOT_W = PLOT_W / N;
const GAP_OUTER = SLOT_W * 0.10;
const GAP_INNER = Math.max(SLOT_W * 0.06, 1.5);
const PAIR_W = SLOT_W - 2 * GAP_OUTER;
const BAR_W = (PAIR_W - GAP_INNER) / 2; // uniform for both series

// x left-edge of each bar type within slot i (series-consistent positioning)
const slotX0 = (i: number): number => PLOT_X0 + i * SLOT_W;
const asPresentedBarX = (i: number): number => slotX0(i) + GAP_OUTER;
const pboBarX = (i: number): number => slotX0(i) + GAP_OUTER + BAR_W + GAP_INNER;
const slotCX  = (i: number): number => slotX0(i) + SLOT_W / 2;

interface BarRect {
  x: number;
  w: number;
  y: number;
  h: number;
  series: "asPresented" | "pbo";
  fyLabel: string;
  value: number;
}

const barRects: BarRect[] = [];
for (let i = 0; i < bars.length; i++) {
  const b = bars[i]!;
  const y0 = yScale(0);

  // As-presented always in left slot position.
  // FY2028-29 as-presented = +1.7: bar height ~9.1px — clears the 0.3 minimum.
  if (b.asPresented !== null) {
    const x = asPresentedBarX(i);
    const y1 = yScale(b.asPresented);
    const [ry, rh] = b.asPresented >= 0 ? [y1, y0 - y1] : [y0, y1 - y0];
    if (rh > 0.3) barRects.push({ x, w: BAR_W, y: ry, h: rh, series: "asPresented", fyLabel: b.fyLabel, value: b.asPresented });
  }
  // PBO definition always in right slot position.
  if (b.pbo !== null) {
    const x = pboBarX(i);
    const y1 = yScale(b.pbo);
    const [ry, rh] = b.pbo >= 0 ? [y1, y0 - y1] : [y0, y1 - y0];
    if (rh > 0.3) barRects.push({ x, w: BAR_W, y: ry, h: rh, series: "pbo", fyLabel: b.fyLabel, value: b.pbo });
  }
}

// ---- X-axis tick labels ('YY) --------------------------------------------------
type XTick = { x: number; label: string };
const xTicks: XTick[] = bars.map((b, i) => ({
  x: slotCX(i),
  label: b.shortYear,
}));

// ---- Series labels — inside plot, right-anchored ------------------------------
// Same-vintage pair: replace vintage-date labels with definition labels.
//
// "As presented" (primary, 600 weight):
//   top-right whitespace above zero line (y = PLOT_Y0 + 14 = 58).
//   Last as-presented bar top: yScale(+3.0) ≈ 81.5 — label at 58 is clear above.
//
// "PBO definition" (secondary, 400 weight):
//   lower-plot whitespace (y = yScale(-30) ≈ 258).
//   Vertical separation from top label ≈ 200px (>> 16px minimum).
//
// Both right-anchored at PLOT_X1 - 4 with text-anchor="end" — stays inside
// viewBox at any responsive scale.
const lastAsPresentedIdx = (() => { for (let i = bars.length - 1; i >= 0; i--) if (bars[i]!.asPresented !== null) return i; return -1; })();
const lastPboIdx = (() => { for (let i = bars.length - 1; i >= 0; i--) if (bars[i]!.pbo !== null) return i; return -1; })();

const SERIES_LABEL_X  = PLOT_X1 - 4;
const AS_PRES_LABEL_Y = PLOT_Y0 + 14;  // y=58: top-right above zero-line whitespace
const PBO_LABEL_Y     = yScale(-30);    // y≈258: lower-plot whitespace

// ---- $94B annotation -----------------------------------------------------------
// The $94B figure is the cumulative capital-definition wedge (same budget,
// two definitions): per-year gaps sum to ~94B over FY2024-25→FY2029-30.
// Free-standing compact callout (no leader) in upper-left plot interior —
// guaranteed whitespace (all early-year bars are below zero).
const fy2526Idx = bars.findIndex((b) => b.fyLabel === "2025-26");
const ANNO_X = PLOT_X0 + 10;   // left-anchored
const ANNO_Y = PLOT_Y0 + 22;   // y=66: clear of frame

// ---- aria-label ----------------------------------------------------------------
const firstFY = bars[0]?.fyLabel ?? "";
const lastFY  = bars[bars.length - 1]?.fyLabel ?? "";
const ariaLabel =
  `Federal operating balance under two definitions of capital, FY${firstFY} to FY${lastFY}. ` +
  `Same budget—Budget 2025—presented two ways. ` +
  `Grouped signed bars per fiscal year: as-presented (black, left bar) and PBO definition (grey, right bar). ` +
  `As presented: deficit narrows from minus $4.1 billion in FY2024-25, crossing to surplus of $1.7 billion in FY2028-29. ` +
  `PBO definition: deficit persists in every year, reaching minus $17.6 billion in FY2029-30. ` +
  `Cumulative gap approximately $94 billion over the six years — the capital-classification wedge.`;
---

{!hasData ? (
  <PanelEmpty reason="DATA NOT YET WIRED — fiscal.json panel-11 frt_operating_balance_b2025 / frt_operating_balance_pbo" />
) : (
  <div class="p2od-chart" data-panel="fiscal-plate-2-dispute" data-panel-status="live">
    <svg
      class="p2od-chart__svg"
      viewBox={`0 0 ${VB_W} ${VB_H}`}
      preserveAspectRatio="xMidYMid meet"
      role="img"
      aria-label={ariaLabel}
    >
      <title>The budget watchdog can't confirm the operating books balance—the capital definition is undisclosed.</title>

      {/* Horizontal gridlines (excluding zero and bottom tick) */}
      {gridlines.map((v) => (
        <line
          class="p2od-chart__gridline"
          x1={PLOT_X0.toFixed(2)} y1={yScale(v).toFixed(2)}
          x2={PLOT_X1.toFixed(2)} y2={yScale(v).toFixed(2)}
        />
      ))}

      {/* Zero line — 1px full-opacity, heavier than gridlines */}
      <line
        class="p2od-chart__zero-line"
        x1={PLOT_X0.toFixed(2)} y1={yScale(0).toFixed(2)}
        x2={PLOT_X1.toFixed(2)} y2={yScale(0).toFixed(2)}
      />

      {/* As-presented bars (INK 1.00 — Budget 2025 as filed) */}
      {barRects.filter((r) => r.series === "asPresented").map((r) => (
        <rect
          class="p2od-chart__bar-as-presented"
          x={r.x.toFixed(2)} y={r.y.toFixed(2)}
          width={r.w.toFixed(2)} height={r.h.toFixed(2)}
        >
          <title>{`FY${r.fyLabel} as presented: ${r.value >= 0 ? "+" : ""}${r.value.toFixed(1)}B`}</title>
        </rect>
      ))}

      {/* PBO-definition bars (MID 0.55 — same budget, stricter capital standard) */}
      {barRects.filter((r) => r.series === "pbo").map((r) => (
        <rect
          class="p2od-chart__bar-pbo"
          x={r.x.toFixed(2)} y={r.y.toFixed(2)}
          width={r.w.toFixed(2)} height={r.h.toFixed(2)}
        >
          <title>{`FY${r.fyLabel} PBO definition: ${r.value >= 0 ? "+" : ""}${r.value.toFixed(1)}B`}</title>
        </rect>
      ))}

      {/* Hairline plot frame */}
      <rect
        class="p2od-chart__frame"
        x={PLOT_X0.toFixed(2)} y={PLOT_Y0.toFixed(2)}
        width={PLOT_W.toFixed(2)} height={PLOT_H.toFixed(2)}
      />

      {/* Y-axis tick labels (Plex Mono, right-aligned at PLOT_X0-8) */}
      {yTicks.map((t) => (
        <text
          class="p2od-chart__ytick-label"
          x={(PLOT_X0 - 8).toFixed(2)}
          y={(t.y + 4).toFixed(2)}
          text-anchor="end"
        >{t.label}</text>
      ))}

      {/* X-axis ticks + 'YY labels (PLOT_Y1+18 per conformance audit) */}
      {xTicks.map((t) => (
        <g>
          <line
            class="p2od-chart__xtick"
            x1={t.x.toFixed(2)} y1={PLOT_Y1.toFixed(2)}
            x2={t.x.toFixed(2)} y2={(PLOT_Y1 + 5).toFixed(2)}
          />
          <text
            class="p2od-chart__xtick-label"
            x={t.x.toFixed(2)}
            y={(PLOT_Y1 + 18).toFixed(2)}
            text-anchor="middle"
          >{t.label}</text>
        </g>
      ))}

      {/* Series labels — inside plot, right-anchored (text-anchor="end").
          "As presented" in top-right whitespace above zero line (600 weight).
          "PBO definition" in lower-plot whitespace (400 weight).
          ~200px vertical separation — well clear of the 16px minimum. */}
      {lastAsPresentedIdx >= 0 && (
        <text
          class="p2od-chart__label-as-presented"
          x={SERIES_LABEL_X.toFixed(2)}
          y={AS_PRES_LABEL_Y.toFixed(2)}
          text-anchor="end"
        >As presented</text>
      )}
      {lastPboIdx >= 0 && (
        <text
          class="p2od-chart__label-pbo"
          x={SERIES_LABEL_X.toFixed(2)}
          y={PBO_LABEL_Y.toFixed(2)}
          text-anchor="end"
        >PBO definition</text>
      )}

      {/* $94B annotation: compact callout in upper-left plot interior.
          Cumulative capital-definition wedge over FY2024-25→FY2029-30.
          Free-standing (no leader). Early-year bars all below zero — whitespace
          above the zero line on the left is guaranteed clear. */}
      {fy2526Idx >= 0 && (
        <text
          class="p2od-chart__gap-label"
          x={ANNO_X.toFixed(2)}
          y={ANNO_Y.toFixed(2)}
          text-anchor="start"
        >$94B capital, reclassified</text>
      )}

    </svg>
  </div>
)}

<style>
  /*
   * Plate2OperatingDispute — Tier-3 grouped signed-bar chart.
   * As-presented (INK 1.00, left bar) vs PBO definition (MID 0.55, right bar).
   * Same vintage — Budget 2025 baseline (PBO RP-2526-017-S Nov 2025).
   * Grey-tint category differentiation per fiscal_bar_language.md §2 — no hatch,
   * no texture, no color. Full-ink chrome; data tint = category only.
   * Conforms to PanelLiveChart token set and conformance-audit deltas.
   */
  .p2od-chart {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: var(--paper);
    overflow: visible;
  }
  .p2od-chart__svg {
    display: block;
    width: 100%;
    height: 100%;
    font-family: var(--font-sans);
    overflow: visible;
  }
  .p2od-chart__gridline {
    stroke: var(--ink);
    stroke-width: 1;
    stroke-opacity: 0.18;
    shape-rendering: crispEdges;
  }
  /* Zero line: 1px pure ink, full opacity — distinguishable from gridlines
     by opacity alone (canon: heavier = full-opacity, not wider). */
  .p2od-chart__zero-line {
    stroke: var(--ink);
    stroke-width: 1;
    stroke-opacity: 1;
    shape-rendering: crispEdges;
  }
  /* As-presented bars: INK 1.00 (primary — the government's filed projection). */
  .p2od-chart__bar-as-presented {
    fill: var(--ink);
    fill-opacity: 1;
    stroke: none;
  }
  /* PBO-definition bars: MID grey 0.55 (same budget, stricter capital standard). */
  .p2od-chart__bar-pbo {
    fill: var(--ink);
    fill-opacity: 0.55;
    stroke: none;
  }
  .p2od-chart__frame {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1;
    shape-rendering: crispEdges;
  }
  /* Y-tick labels: Plex Mono 400 12px (data = measurement) */
  .p2od-chart__ytick-label {
    fill: var(--ink);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }
  .p2od-chart__xtick {
    stroke: var(--ink);
    stroke-width: 1;
    shape-rendering: crispEdges;
  }
  /* X-tick labels: Manrope 400 12px (dates = language, not measurements) */
  .p2od-chart__xtick-label {
    fill: var(--ink);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 400;
  }
  /* Series direct labels. As-presented (600 = primary weight). PBO (400 = secondary). */
  .p2od-chart__label-as-presented {
    fill: var(--ink);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
  }
  .p2od-chart__label-pbo {
    fill: var(--ink);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 400;
  }
  /* Gap annotation: Plex Mono (it's a measurement). Compact, no leader. */
  .p2od-chart__gap-label {
    fill: var(--ink);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }
</style>
