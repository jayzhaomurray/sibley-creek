---
/*
 * Panel2DebtServiceRatio — public debt charges as share of total revenues.
 *
 * NEW. Single-line ratio series with a 5-year trailing min/max band as
 * historical context, and a named PBO forecast endpoint anchor.
 *
 * Data shape expected from fiscal.json panel-2:
 *   primary: { key: "debt_service_ratio", unit: "%", data: [{date, value}] }
 *             Monthly ratio: public_debt_charges_ytd / revenues_ytd * 100
 *   secondary (optional): { key: "debt_service_ratio_band_lo", unit: "%", data: [...] }
 *             Lower edge of 5-year trailing min series (same month, prior 5 yrs)
 *   tertiary (optional): { key: "debt_service_ratio_band_hi", unit: "%", data: [...] }
 *             Upper edge of 5-year trailing max series (same month, prior 5 yrs)
 *
 * Visual decisions:
 *   - Primary: 1.5px solid black line. MTA red 4px dot at latest.
 *   - Band: SVG <path> filled with rgba(21,23,26,0.06) ink wash (same as
 *     recession band opacity). Band renders BELOW the data line in z-order.
 *   - PBO forecast endpoint (13.2% by 2030-31): 1px dashed black reference
 *     rule, labelled "PBO 2030-31" in Manrope 600 12px to the right.
 *   - Window: full available history (no artificial crop — ratio trend is
 *     the editorial story; showing the 2022-2026 rise is essential).
 *   - No legend. Direct end-of-line label: "Debt service / revenues".
 *
 * Source card: editorial/source_cards/_pending/fiscal/plate-2.yaml
 *   Tier A. DoF Fiscal Monitor Feb 2026: public debt charges $49.3bn YTD.
 *   PBO Main Estimates 2026-27 (May 7, 2026): ratio rises from 10.6% to
 *   13.2% of revenues by 2030-31.
 *
 * Canon compliance (Tier-3):
 *   1. Data line: var(--ink), 1.5px solid.
 *   2. Latest-print dot: var(--accent) MTA red, r=4, no stroke.
 *   3. 1px pure-ink hairline frame.
 *   4. 3-4 horizontal gridlines, stroke-opacity 0.18.
 *   5. Y-axis: Plex Mono 400, 12px, right-aligned in gutter. Topmost tick: "%".
 *   6. X-axis: Manrope 400, 12px, 3-5 ticks max.
 *   7. Zero line suppressed (ratio never near zero).
 *   8. Reference rule for PBO forecast: 1px dashed "4 2", Manrope 600 12px label.
 *   9. Native SVG <title> hit areas per data point. Zero client JS.
 *  10. viewBox 720x405, aspect-ratio 16/9.
 *  16. No section-accent on data marks.
 */

import type { PanelData } from "../_shared/panelData";
import { decYear } from "../_shared/panelData";
import PanelEmpty from "../_shared/PanelEmpty.astro";

interface Props {
  data?: PanelData | null;
}

const { data = null } = Astro.props;

const hasPrimary = !!(data && data.primary && data.primary.data.length > 0);

// ---- Geometry ---------------------------------------------------------------
const VB_W = 720;
const VB_H = 405;
const M_L  = 52;   // left gutter
const M_R  = 96;   // right margin (direct label + PBO ref label)
const M_T  = 24;   // top
const M_B  = 38;   // bottom (x-ticks)

const PLOT_X0 = M_L;
const PLOT_X1 = VB_W - M_R;
const PLOT_Y0 = M_T;
const PLOT_Y1 = VB_H - M_B;
const PLOT_W  = PLOT_X1 - PLOT_X0;
const PLOT_H  = PLOT_Y1 - PLOT_Y0;

// ---- PBO forecast anchor ----------------------------------------------------
// PBO Main Estimates 2026-27 (May 7, 2026): ratio reaches 13.2% by 2030-31.
// This is a fixed editorial constant, source-verified in plate-2.yaml.
const PBO_FORECAST_PCT  = 13.2;
const PBO_FORECAST_YEAR = 2030.5; // mid-FY 2030-31

// ---- Helpers ----------------------------------------------------------------
type SeriesPoint = { date: string; value: number | null };

function niceStep(range: number, target = 4): number {
  const rough = range / target;
  const mag   = Math.pow(10, Math.floor(Math.log10(rough || 1)));
  const norm  = rough / mag;
  if (norm < 1.5) return 1 * mag;
  if (norm < 3)   return 2 * mag;
  if (norm < 7)   return 5 * mag;
  return 10 * mag;
}

function fmtYTick(v: number, isTop: boolean): string {
  const s = v.toFixed(1);
  return isTop ? `${s}%` : s;
}

// ---- Computation (only runs when data present) -------------------------------
type YTick = { y: number; label: string };
type XTick = { x: number; label: string };

let linePath   = "";
let bandPath   = "";
let latestX    = 0;
let latestY    = 0;
let latestVal  = 0;
let labelY     = 0;
let yTicks: YTick[] = [];
let xTicks: XTick[] = [];
let showPboRef = false;
let pboRefY    = 0;
let pboLabelY  = 0;
let hitCircles: { cx: number; cy: number; title: string }[] = [];
let ariaLabel  = "Federal debt service as share of revenues, monthly, from Department of Finance Fiscal Monitor.";

if (hasPrimary) {
  const pts: SeriesPoint[] = data!.primary!.data.filter(
    (p: SeriesPoint) => typeof p.value === "number" && Number.isFinite(p.value)
  );

  // Secondary = band low edge; tertiary = band high edge (optional)
  const bandLo: SeriesPoint[] = data!.secondary?.data ?? [];
  const bandHi: SeriesPoint[] = (data as any)?.tertiary?.data ?? [];

  // ---- x-domain --------------------------------------------------------------
  const xVals = pts.map((p) => decYear(p.date)).filter((v) => !isNaN(v));
  const xMin  = Math.min(...xVals);
  const xMax  = Math.max(...xVals);
  // Also include PBO forecast year in x-domain so the ref point is visible
  const xDomMax = Math.max(xMax, PBO_FORECAST_YEAR);
  const xRange  = xDomMax - xMin || 1;

  // Extend slightly so lines don't crowd frame edges
  const xPad    = xRange * 0.01;
  const xDomMin = xMin - xPad;
  const xDomSpan = (xDomMax + xPad) - xDomMin;

  const xScale = (xv: number): number =>
    PLOT_X0 + ((xv - xDomMin) / xDomSpan) * PLOT_W;

  // ---- y-domain --------------------------------------------------------------
  const vals = pts.map((p) => p.value as number);
  const rawMin = Math.min(...vals);
  const rawMax = Math.max(...vals);
  // Include PBO forecast value in y domain
  const yDomMax = Math.max(rawMax, PBO_FORECAST_PCT) * 1.08;
  const yDomMin = Math.max(0, rawMin * 0.88);
  const yRange  = yDomMax - yDomMin || 1;

  const yScale = (v: number): number =>
    PLOT_Y0 + PLOT_H - ((v - yDomMin) / yRange) * PLOT_H;

  // ---- Y ticks ---------------------------------------------------------------
  const step = niceStep(yDomMax - yDomMin, 4);
  const tickStart = Math.ceil(yDomMin / step) * step;
  const rawTicks: number[] = [];
  for (let v = tickStart; v <= yDomMax + 1e-9; v += step) {
    rawTicks.push(Number(v.toFixed(6)));
  }
  yTicks = rawTicks
    .filter((v) => yScale(v) >= PLOT_Y0 - 2 && yScale(v) <= PLOT_Y1 + 2)
    .map((v, i, arr) => ({
      y: yScale(v),
      label: fmtYTick(v, i === arr.length - 1),
    }));

  // ---- X ticks (year labels, 4-5 max) ----------------------------------------
  const yearMin = Math.floor(xMin);
  const yearMax = Math.ceil(xDomMax);
  const yearCount = yearMax - yearMin;
  // Pick a stride so we get ~4-5 labels
  const yearStride = yearCount <= 6 ? 1 : yearCount <= 10 ? 2 : 5;
  const seenYears = new Set<number>();
  for (const pt of pts) {
    const m = pt.date.match(/^(\d{4})-(\d{2})/);
    if (!m) continue;
    const y = parseInt(m[1]!, 10);
    const mo = parseInt(m[2]!, 10);
    if (mo !== 1) continue; // January only
    if ((y - yearMin) % yearStride !== 0) continue;
    if (seenYears.has(y)) continue;
    seenYears.add(y);
    const xv = decYear(`${y}-01`);
    xTicks.push({ x: xScale(xv), label: String(y) });
  }

  // ---- Band path (if lo and hi series present) --------------------------------
  if (bandLo.length > 0 && bandHi.length > 0) {
    // Build the band as a closed polygon: lo forward, hi backward
    const loFiltered = bandLo.filter(
      (p) => typeof p.value === "number" && Number.isFinite(p.value)
    );
    const hiFiltered = bandHi.filter(
      (p) => typeof p.value === "number" && Number.isFinite(p.value)
    );
    if (loFiltered.length > 0 && hiFiltered.length > 0) {
      const forwardParts = loFiltered.map((p) => {
        const xv = decYear(p.date);
        return `${xScale(xv).toFixed(2)},${yScale(p.value as number).toFixed(2)}`;
      });
      const backwardParts = [...hiFiltered].reverse().map((p) => {
        const xv = decYear(p.date);
        return `${xScale(xv).toFixed(2)},${yScale(p.value as number).toFixed(2)}`;
      });
      bandPath = `M${forwardParts[0]} L${forwardParts.slice(1).join(" L")} L${backwardParts.join(" L")} Z`;
    }
  }

  // ---- Line path -------------------------------------------------------------
  const pathParts = pts.map((p, i) => {
    const xv = decYear(p.date);
    const x = xScale(xv);
    const y = yScale(p.value as number);
    return `${i === 0 ? "M" : "L"}${x.toFixed(2)},${y.toFixed(2)}`;
  });
  linePath = pathParts.join(" ");

  // ---- Latest dot ------------------------------------------------------------
  const lastPt = pts[pts.length - 1]!;
  latestX   = xScale(decYear(lastPt.date));
  latestY   = yScale(lastPt.value as number);
  latestVal = lastPt.value as number;
  // Direct label sits 10px right of the dot, vertically centered
  labelY    = latestY + 4;

  // ---- Hit circles -----------------------------------------------------------
  hitCircles = pts.map((p) => {
    const xv = decYear(p.date);
    return {
      cx: xScale(xv),
      cy: yScale(p.value as number),
      title: `${p.date}: ${(p.value as number).toFixed(1)}%`,
    };
  });

  // ---- PBO reference rule ----------------------------------------------------
  if (PBO_FORECAST_PCT >= yDomMin && PBO_FORECAST_PCT <= yDomMax) {
    showPboRef = true;
    pboRefY    = yScale(PBO_FORECAST_PCT);
    pboLabelY  = pboRefY - 5; // 5px above the rule
  }

  // ---- aria-label ------------------------------------------------------------
  ariaLabel = `Federal debt service as share of total revenues, monthly ratio, ${pts[0]!.date} to ${lastPt.date}. Latest: ${latestVal.toFixed(1)}%. PBO forecast: 13.2% by 2030-31.`;
}
---

{!hasPrimary ? (
  <PanelEmpty reason="Debt service ratio (fiscal panel-2) not yet emitted by pipeline." />
) : (
  <div class="p2dsr-chart" data-panel="fiscal-2">
    <svg
      class="p2dsr-chart__svg"
      viewBox={`0 0 ${VB_W} ${VB_H}`}
      preserveAspectRatio="xMidYMid meet"
      role="img"
      aria-label={ariaLabel}
    >
      {/* Gridlines */}
      {yTicks.map((t) => (
        <line
          class="p2dsr-chart__gridline"
          x1={PLOT_X0.toFixed(2)} y1={t.y.toFixed(2)}
          x2={PLOT_X1.toFixed(2)} y2={t.y.toFixed(2)}
        />
      ))}

      {/* 5-year trailing band */}
      {bandPath && (
        <path class="p2dsr-chart__band" d={bandPath} />
      )}

      {/* PBO forecast reference rule */}
      {showPboRef && (
        <>
          <line
            class="p2dsr-chart__ref-rule"
            x1={PLOT_X0.toFixed(2)} y1={pboRefY.toFixed(2)}
            x2={PLOT_X1.toFixed(2)} y2={pboRefY.toFixed(2)}
          />
          <text
            class="p2dsr-chart__ref-label"
            x={(PLOT_X1 - 4).toFixed(2)}
            y={pboLabelY.toFixed(2)}
            text-anchor="end"
          >PBO 2030-31</text>
        </>
      )}

      {/* Data line */}
      <path class="p2dsr-chart__line" d={linePath} />

      {/* Hit areas — native SVG title, zero JS */}
      {hitCircles.map((h) => (
        <circle
          class="p2dsr-chart__hit"
          cx={h.cx.toFixed(2)}
          cy={h.cy.toFixed(2)}
          r="5"
        >
          <title>{h.title}</title>
        </circle>
      ))}

      {/* Latest-print dot — MTA red, above line, below frame */}
      <circle
        class="p2dsr-chart__latest-dot"
        cx={latestX.toFixed(2)}
        cy={latestY.toFixed(2)}
        r="4"
      >
        <title>Latest: {latestVal.toFixed(1)}%</title>
      </circle>

      {/* Hairline frame — drawn after data so line ends are clipped */}
      <rect
        class="p2dsr-chart__frame"
        x={PLOT_X0.toFixed(2)} y={PLOT_Y0.toFixed(2)}
        width={PLOT_W.toFixed(2)} height={PLOT_H.toFixed(2)}
      />

      {/* Y-axis tick labels */}
      {yTicks.map((t) => (
        <text
          class="p2dsr-chart__ytick-label"
          x={(PLOT_X0 - 6).toFixed(2)}
          y={(t.y + 4).toFixed(2)}
          text-anchor="end"
        >{t.label}</text>
      ))}

      {/* X-axis ticks + labels */}
      {xTicks.map((t) => (
        <g>
          <line
            class="p2dsr-chart__xtick"
            x1={t.x.toFixed(2)} y1={PLOT_Y1.toFixed(2)}
            x2={t.x.toFixed(2)} y2={(PLOT_Y1 + 4).toFixed(2)}
          />
          <text
            class="p2dsr-chart__xtick-label"
            x={t.x.toFixed(2)}
            y={(PLOT_Y1 + 16).toFixed(2)}
            text-anchor="middle"
          >{t.label}</text>
        </g>
      ))}

      {/* Direct end-of-line label */}
      <text
        class="p2dsr-chart__direct-label"
        x={(latestX + 10).toFixed(2)}
        y={labelY.toFixed(2)}
        text-anchor="start"
      >Debt service</text>

    </svg>
  </div>
)}

<style>
  /* -------------------------------------------------------------------
     Panel2DebtServiceRatio — Tier-3 single-line ratio chart with band.
     Public debt charges / total revenues ratio (%), monthly.
     5-year trailing band as ink-wash context; PBO forecast anchor.
     ------------------------------------------------------------------- */
  .p2dsr-chart {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: var(--paper);
  }
  .p2dsr-chart__svg {
    display: block;
    width: 100%;
    height: 100%;
    font-family: var(--font-sans);
  }

  /* Gridlines */
  .p2dsr-chart__gridline {
    stroke: var(--ink);
    stroke-width: 1;
    stroke-opacity: 0.18;
    shape-rendering: crispEdges;
  }

  /* 5-year trailing min/max band — same opacity as recession band */
  .p2dsr-chart__band {
    fill: rgba(21, 23, 26, 0.06);
    stroke: none;
  }

  /* PBO forecast reference rule — 1px dashed "4 2" */
  .p2dsr-chart__ref-rule {
    stroke: var(--ink);
    stroke-width: 1;
    stroke-dasharray: 4 2;
    shape-rendering: crispEdges;
  }

  /* PBO reference label — Manrope 600 12px, right-aligned inside frame */
  .p2dsr-chart__ref-label {
    fill: var(--ink);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: var(--fw-semibold);
  }

  /* Primary data line — pure ink, 1.5px */
  .p2dsr-chart__line {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
    stroke-linejoin: round;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  /* Hit areas — transparent, only the <title> tooltip matters */
  .p2dsr-chart__hit {
    fill: transparent;
    stroke: none;
    cursor: default;
  }

  /* Latest-print dot — MTA red #E63946 */
  .p2dsr-chart__latest-dot {
    fill: var(--accent);
    stroke: none;
  }

  /* Hairline frame — 1px pure ink */
  .p2dsr-chart__frame {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1;
    shape-rendering: crispEdges;
  }

  /* Y-axis tick labels — IBM Plex Mono 400, 12px */
  .p2dsr-chart__ytick-label {
    fill: var(--ink);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }

  /* X-axis tick marks */
  .p2dsr-chart__xtick {
    stroke: var(--ink);
    stroke-width: 1;
    shape-rendering: crispEdges;
  }

  /* X-axis tick labels — Manrope 400, 12px */
  .p2dsr-chart__xtick-label {
    fill: var(--ink);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 400;
  }

  /* Direct end-of-line label — Manrope 600, 13px */
  .p2dsr-chart__direct-label {
    fill: var(--ink);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: var(--fw-semibold);
  }
</style>
