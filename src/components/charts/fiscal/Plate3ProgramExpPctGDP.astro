---
/*
 * Plate3ProgramExpPctGDP â€” Federal program expenses as % of GDP.
 *
 * EDITORIAL PURPOSE: Show the federal program-expense-to-GDP ratio over 40+ years.
 * The FY2020-21 COVID spike (28.1%) is the chart's most important honest feature
 * and must reach its true height un-clipped.
 *
 * Per R2.5: Plate2 is the merged revenue-vs-expenses chart (editorial primary).
 * This Plate3 is the standalone expenses detail view â€” tight independent axis,
 * full COVID spike visible.
 *
 * DATA: fiscal.json panel-8, key: frt_program_exp_pct_gdp
 *   42 actual points (FY1983-84 to FY2024-25) + 6 forecast (FY2025-26 to FY2030-31).
 *   is_forecast: 0 = history, 1 = forecast.
 *   FY2020-21 = 28.1% (COVID spike â€” real, not a basis break). Annotate.
 *
 * FORECAST CONVENTION (R2.1 â€” vertical dashed divider, not dotted trace):
 *   Data trace = ONE consistent 1.5px solid-ink line across history + forecast.
 *   Forecast signal: vertical dashed divider (ink 1px, dash 4 3, 0.40 opacity)
 *   + "Forecast" micro-caps label above the projection region.
 *   Red dot (canon R2): 4px MTA red on the last plotted observation (forecast
 *   endpoint FY2030-31), one per chart. Numeric label above the dot.
 *
 * Y-DOMAIN (tight, independent per R2.3):
 *   Expense range: ~11.8%â€“28.1% (COVID spike). Tight axis: 10%â€“30%, 5pp strides.
 *   COVID spike reaches 28.1% â€” fits with headroom to 30%.
 *
 * LONG HISTORY: FY1983-84 â†’ FY2030-31. x-ticks every 5 years.
 *
 * TITLE: [TITLE TK]
 * CAPTION: [CAPTION TK]
 *
 * CANON COMPLIANCE (Tier-3):
 *   1. Single trace, pure ink 1.5px solid. No dotted forecast line.
 *   2. Forecast signal = vertical dashed divider + "Forecast" label (R2.1).
 *   3. COVID spike (28.1%) fully visible â€” NOT clamped (v1 defect fixed).
 *   4. MTA red dot on last plotted observation (forecast endpoint), one per chart (R2).
 *   5. Latest-point numeric label above red dot.
 *   6. Hairline frame 1px ink.
 *   7. 4 interior gridlines, 0.18 opacity.
 *   8. Plex Mono y-ticks; topmost "%".
 *   9. Manrope x-ticks every 5 years.
 *  10. One direct terminus label.
 *  11. viewBox 720x405.
 *  12. aria-label. Native SVG <title> on hit areas.
 *  13. No source/caption/methodology inside SVG.
 */

import type { PanelData } from "../_shared/panelData";
import PanelEmpty from "../_shared/PanelEmpty.astro";

interface Props {
  data?: PanelData | null;
}

const { data = null } = Astro.props;

// ---- Data extraction -----------------------------------------------------------
type RawPt = { date: string; value: number | null; is_forecast?: number; fy_label?: string };

interface Pt {
  fyLabel: string;
  value: number;
  isForecast: boolean;
}

const pts: Pt[] = [];

if (data?.primary?.data && data.primary.data.length > 0) {
  for (const r of data.primary.data as RawPt[]) {
    if (r.value === null || r.value === undefined) continue;
    pts.push({
      fyLabel: r.fy_label ?? r.date.slice(0, 4),
      value: r.value,
      isForecast: r.is_forecast === 1,
    });
  }
}

const hasData = pts.length > 0;

// ---- Geometry ------------------------------------------------------------------
const VB_W = 720;
const VB_H = 405;
const M_L = 56;   // canon left margin
const M_R = 96;   // canon right gutter for the direct terminus label
const M_T = 44;   // canon top
const M_B = 40;   // canon bottom

const PLOT_X0 = M_L;
const PLOT_X1 = VB_W - M_R;
const PLOT_Y0 = M_T;
const PLOT_Y1 = VB_H - M_B;
const PLOT_W  = PLOT_X1 - PLOT_X0;
const PLOT_H  = PLOT_Y1 - PLOT_Y0;

// ---- Y domain: tight independent axis (R2.3), COVID spike un-clipped -----------
// Expense range: ~11.8% (FY1999-00) to 28.1% (FY2020-21 COVID)
// Tight axis: 10% to 30%, 5pp strides -> 5 ticks
const Y_DOM_MIN = 10;
const Y_DOM_MAX = 30;
const Y_TICK_STEP = 5;
const ySpan = Y_DOM_MAX - Y_DOM_MIN;

const yScale = (v: number): number =>
  PLOT_Y0 + PLOT_H - ((v - Y_DOM_MIN) / ySpan) * PLOT_H;
// NO clamping â€” the COVID spike at 28.1% must reach its true y position

// ---- X scale (uniform index spacing â€” annual fiscal years) ---------------------
const N = pts.length;
const xOfIndex = (i: number): number =>
  PLOT_X0 + (N > 1 ? (i / (N - 1)) * PLOT_W : PLOT_W / 2);

// ---- Y ticks -------------------------------------------------------------------
type YTick = { y: number; label: string };
const yTickVals: number[] = [];
for (let v = Y_DOM_MIN; v <= Y_DOM_MAX; v += Y_TICK_STEP) yTickVals.push(v);
const yTicks: YTick[] = yTickVals.map((v, i) => ({
  y: yScale(v),
  label: i === yTickVals.length - 1 ? `${v}%` : `${v}`,
}));
const gridlines = yTickVals.filter((v) => v > Y_DOM_MIN && v < Y_DOM_MAX);

// ---- X ticks: every 5 fiscal years (long span) ---------------------------------
type XTick = { x: number; label: string };
const xTicks: XTick[] = pts
  .map((p, i) => ({ p, i }))
  .filter(({ i }) => i % 5 === 0 || i === pts.length - 1)
  .map(({ p, i }) => ({
    x: xOfIndex(i),
    label: "'" + p.fyLabel.slice(-2),
  }));

// ---- Forecast boundary ---------------------------------------------------------
const firstForecastIdx = (() => {
  for (let i = 0; i < pts.length; i++) {
    if (pts[i]!.isForecast) return i;
  }
  return -1;
})();

// Divider x: midpoint between last actual and first forecast
const dividerX = firstForecastIdx > 0
  ? (xOfIndex(firstForecastIdx - 1) + xOfIndex(firstForecastIdx)) / 2
  : null;

// ---- SVG path â€” single continuous line across boundary -------------------------
const linePath = pts
  .map((p, i) => `${i === 0 ? "M" : "L"}${xOfIndex(i).toFixed(2)},${yScale(p.value).toFixed(2)}`)
  .join(" ");

// ---- Latest-point dot + numeric label (canon R2) -------------------------------
// The dot sits on the LAST PLOTTED OBSERVATION â€” the forecast endpoint, not the
// last actual. One dot per chart. Numeric value label moves with it.
const dotIdx = pts.length - 1;
const dotPt = dotIdx >= 0 ? pts[dotIdx] : null;
const dotX  = dotIdx >= 0 ? xOfIndex(dotIdx) : 0;
const dotY  = dotPt ? yScale(dotPt.value) : 0;
const latestLabel = dotPt ? `${dotPt.value.toFixed(1)}%` : "";

// ---- Terminus label (rightmost point) -----------------------------------------
const terminusPt = pts[pts.length - 1];
const terminusX  = xOfIndex(pts.length - 1);
const terminusY  = terminusPt ? yScale(terminusPt.value) : 0;

// ---- COVID spike annotation ----------------------------------------------------
const covidIdx = pts.findIndex((p) => p.fyLabel === "2020-21");
const covidPt = covidIdx >= 0 ? pts[covidIdx] : null;
const covidX  = covidIdx >= 0 ? xOfIndex(covidIdx) : 0;
const covidY  = covidPt ? yScale(covidPt.value) : 0;

// ---- Hit areas -----------------------------------------------------------------
type Hit = { cx: number; cy: number; title: string };
const hits: Hit[] = pts.map((p, i) => ({
  cx: xOfIndex(i),
  cy: yScale(p.value),
  title: `FY${p.fyLabel}: ${p.value.toFixed(1)}% of GDP${p.isForecast ? " (SEU 2026 proj.)" : ""}`,
}));

// ---- aria-label ----------------------------------------------------------------
const ariaLabel =
  `Federal program expenses as a percentage of GDP, FY${pts[0]?.fyLabel ?? ""} to FY${pts[pts.length - 1]?.fyLabel ?? ""}. ` +
  `Series ends at ${latestLabel} (FY${dotPt?.fyLabel ?? ""}, projected). ` +
  `FY2020-21 spike at 28.1% reflects COVID-19 emergency spending. ` +
  `DoF SEU 2026 projection over the forecast horizon.`;
---

{!hasData ? (
  <PanelEmpty reason="DATA NOT YET WIRED â€” fiscal.json panel-8 frt_program_exp_pct_gdp" />
) : (
  <div class="p3exp-chart" data-panel="fiscal-plate-3" data-panel-status="live">
    <svg
      class="p3exp-chart__svg"
      viewBox={`0 0 ${VB_W} ${VB_H}`}
      preserveAspectRatio="xMidYMid meet"
      role="img"
      aria-label={ariaLabel}
    >

      {/* Horizontal gridlines */}
      {gridlines.map((v) => (
        <line
          class="p3exp-chart__gridline"
          x1={PLOT_X0.toFixed(2)} y1={yScale(v).toFixed(2)}
          x2={PLOT_X1.toFixed(2)} y2={yScale(v).toFixed(2)}
        />
      ))}

      {/* Single continuous line: no dotted/solid split */}
      {linePath && <path class="p3exp-chart__line" d={linePath} />}

      {/* Hit areas */}
      {hits.map((h) => (
        <circle class="p3exp-chart__hit" cx={h.cx.toFixed(2)} cy={h.cy.toFixed(2)} r="5">
        </circle>
      ))}

      {/* COVID spike annotation â€” word + value only, anchored above the spike */}
      {covidPt && (
        <g>
          <line
            class="p3exp-chart__annot-leader"
            x1={covidX.toFixed(2)} y1={(covidY - 4).toFixed(2)}
            x2={covidX.toFixed(2)} y2={(covidY - 20).toFixed(2)}
          />
          <text
            class="p3exp-chart__annot-label p3exp-chart__annot-label--tk"
            x={(covidX).toFixed(2)}
            y={(covidY - 24).toFixed(2)}
            text-anchor="middle"
          >[ANNO TK]</text>
          <text
            class="p3exp-chart__annot-value"
            x={(covidX).toFixed(2)}
            y={(covidY - 11).toFixed(2)}
            text-anchor="middle"
          >{covidPt.value.toFixed(1)}%</text>
        </g>
      )}

      {/* Vertical forecast divider (R2.1) */}
      {dividerX !== null && (
        <line
          class="p3exp-chart__divider"
          x1={dividerX.toFixed(2)} y1={PLOT_Y0.toFixed(2)}
          x2={dividerX.toFixed(2)} y2={PLOT_Y1.toFixed(2)}
        />
      )}

      {/* "Forecast" label above projection region (R2.1) */}
      {dividerX !== null && (
        <text
          class="p3exp-chart__forecast-label"
          x={(dividerX + 6).toFixed(2)}
          y={(PLOT_Y0 - 6).toFixed(2)}
          text-anchor="start"
        >FORECAST</text>
      )}

      {/* MTA red dot â€” last plotted observation (forecast endpoint), one per chart (R2) */}
      {dotPt && (
        <circle
          class="p3exp-chart__latest-dot"
          cx={dotX.toFixed(2)}
          cy={dotY.toFixed(2)}
          r="4"
        >
        </circle>
      )}

      {/* Latest-point numeric label (R2.5) */}
      {dotPt && latestLabel && (
        <text
          class="p3exp-chart__latest-label"
          x={(dotX + 5).toFixed(2)}
          y={(dotY - 8).toFixed(2)}
          text-anchor="start"
        >{latestLabel}</text>
      )}

      {/* Hairline frame */}
      <rect
        class="p3exp-chart__frame"
        x={PLOT_X0.toFixed(2)} y={PLOT_Y0.toFixed(2)}
        width={PLOT_W.toFixed(2)} height={PLOT_H.toFixed(2)}
      />

      {/* Y-axis tick labels */}
      {yTicks.map((t) => (
        <text
          class="p3exp-chart__ytick-label"
          x={(PLOT_X0 - 6).toFixed(2)}
          y={(t.y + 4).toFixed(2)}
          text-anchor="end"
        >{t.label}</text>
      ))}

      {/* X-axis tick labels */}
      {xTicks.map((t) => (
        <g>
          <line
            class="p3exp-chart__xtick"
            x1={t.x.toFixed(2)} y1={PLOT_Y1.toFixed(2)}
            x2={t.x.toFixed(2)} y2={(PLOT_Y1 + 5).toFixed(2)}
          />
          <text
            class="p3exp-chart__xtick-label"
            x={t.x.toFixed(2)}
            y={(PLOT_Y1 + 17).toFixed(2)}
            text-anchor="middle"
          >{t.label}</text>
        </g>
      ))}

      {/* Direct terminus label */}
      {terminusPt && (
        <text
          class="p3exp-chart__term-label p3exp-chart__term-label--tk"
          x={(terminusX + 8).toFixed(2)}
          y={(terminusY + 4).toFixed(2)}
          text-anchor="start"
        >[CAPTION TK: Expenses]</text>
      )}

    </svg>
  </div>
)}

<style>
  /*
   * Plate3ProgramExpPctGDP â€” Tier-3 single-trace line chart.
   * Program expenses % of GDP, tight independent axis (R2.3).
   * COVID spike (28.1%) rendered un-clipped â€” v1 defect fixed.
   * Forecast signal: vertical dashed divider + "Forecast" label (R2.1).
   * Solid line across boundary (no dotted forecast).
   */
  .p3exp-chart {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: var(--paper);
  }
  .p3exp-chart__svg {
    display: block;
    width: 100%;
    height: 100%;
    font-family: var(--font-sans);
  }
  .p3exp-chart__gridline {
    stroke: var(--ink);
    stroke-width: 1;
    stroke-opacity: 0.18;
    shape-rendering: crispEdges;
  }
  /* Single continuous line: 1.5px solid ink */
  .p3exp-chart__line {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
    stroke-linejoin: round;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .p3exp-chart__hit {
    fill: transparent;
    stroke: none;
    cursor: default;
  }
  /* Annotation leader: full 1px pure ink (reference-rule strength), ends 4px short */
  .p3exp-chart__annot-leader {
    stroke: var(--ink);
    stroke-width: 1;
    shape-rendering: crispEdges;
  }
  /* Annotation label: 13px Manrope 400 full ink (placeholder ink while TK) */
  .p3exp-chart__annot-label {
    fill: var(--ink);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 400;
  }
  .p3exp-chart__annot-label--tk {
    fill: var(--ink-placeholder);
  }
  /* Annotation value: real data â€” Plex Mono 12px 600 (anchor emphasis), full ink */
  .p3exp-chart__annot-value {
    fill: var(--ink);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
  }
  /* Vertical dashed divider (R2.1): dash 4 2, opacity 0.40 (structural divider) */
  .p3exp-chart__divider {
    stroke: var(--ink);
    stroke-width: 1;
    stroke-dasharray: 4 2;
    stroke-opacity: 0.40;
    shape-rendering: crispEdges;
  }
  /* "FORECAST" label (R2.1): recession-label token â€” Manrope 600 11px, 0.18em, full ink */
  .p3exp-chart__forecast-label {
    fill: var(--ink);
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
  }
  .p3exp-chart__latest-dot {
    fill: var(--accent);
    stroke: none;
  }
  .p3exp-chart__latest-label {
    fill: var(--ink);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }
  .p3exp-chart__frame {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1;
    shape-rendering: crispEdges;
  }
  .p3exp-chart__ytick-label {
    fill: var(--ink);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }
  .p3exp-chart__xtick {
    stroke: var(--ink);
    stroke-width: 1;
    shape-rendering: crispEdges;
  }
  .p3exp-chart__xtick-label {
    fill: var(--ink);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 400;
  }
  /* Direct terminus label: canon direct-label â€” Manrope 600 13px, full ink */
  .p3exp-chart__term-label {
    fill: var(--ink);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
  }
  .p3exp-chart__term-label--tk {
    fill: var(--ink-placeholder);
  }
</style>
