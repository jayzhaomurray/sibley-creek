---
/*
 * Panel3Inventory - sales-to-new-listings and inventory.
 *
 * Pipeline emits `crea_snlr` (primary, %) and `crea_resales`
 * (secondary). SNLR carries the editorial argument directly.
 *
 * Synthetic-data fallback removed.
 */

import type { PanelData } from "../_shared/panelData";
import PanelLiveChart from "../_shared/PanelLiveChart.astro";
import PanelEmpty from "../_shared/PanelEmpty.astro";

interface Props {
  data?: PanelData | null;
}

const { data = null } = Astro.props;
---
{data && data.primary ? (
  <PanelLiveChart
    primary={data.primary}
    secondary={data.secondary}
    primaryLabel="SNLR"
    secondaryLabel="Resales"
    dataPanelAttr="housing-3"
    ariaLabel="Sales-to-new-listings ratio, CREA."
  />
) : (
  <PanelEmpty reason="Pipeline did not emit panel-3 data." />
)}
