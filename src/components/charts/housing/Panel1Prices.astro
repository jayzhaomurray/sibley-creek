---
/*
 * Panel1Prices - MLS HPI benchmark, national.
 *
 * Pipeline emits `crea_hpi_canada_yoy` as a Y/Y % series. Editorial
 * argument includes six-CMA cuts; those per-CMA series are not on disk
 * yet, so we render the national line alone.
 *
 * Synthetic-data fallback removed.
 */

import type { PanelData } from "../_shared/panelData";
import PanelLiveChart from "../_shared/PanelLiveChart.astro";
import PanelEmpty from "../_shared/PanelEmpty.astro";

interface Props {
  data?: PanelData | null;
}

const { data = null } = Astro.props;
---
{data && data.primary ? (
  <PanelLiveChart
    primary={data.primary}
    secondary={data.secondary}
    primaryLabel="MLS HPI"
    dataPanelAttr="housing-1"
    ariaLabel="MLS HPI benchmark, Canada, year-over-year."
  />
) : (
  <PanelEmpty reason="Pipeline did not emit panel-1 data." />
)}
