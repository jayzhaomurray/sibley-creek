---
/*
 * Panel1Prices â€” CREA MLS HPI index levels, six-CMA small-multiples.
 * Live plate-1, housing section.
 *
 * Promoted from _alternatives/housing/Alt5_HpiCmaLevels.astro on 2026-05-13.
 * The Y/Y small-multiples view (former plate-1) moved to
 * _alternatives/housing/Panel1Prices_YoY_SmallMults.astro.
 *
 * What this shows: index levels (Jan 2005 = 100) for six CMAs + Canada
 * national comparator. Window 180 months (~15 years, 2011â€“2026). Answers
 * the structural-state question: "how far have prices come from the base?"
 * Y/Y erases the cumulative run-up; levels carry it.
 *
 * Layout: 3 cols x 2 rows.
 *   Row 0: Toronto | Vancouver | Montreal
 *   Row 1: Calgary | Edmonton  | Ottawa
 *   (Ordered by CMA economic weight: largest three metros, then next tier.)
 *
 * Mode A unified y-axis: [100, 400], ticks at 100 / 200 / 300 / 400.
 * Y-tick labels appear on the leftmost column only (Mode A convention).
 * Per-panel direct end-of-line labels identify the CMA + Canada comparator.
 *
 * X-axis: 3 ticks â€” 2015, 2020, 2025 â€” clean cycle anchors across the
 * 15-year window. Bottom row only.
 *
 * Canon-compliance:
 *  #1  CMA line: 1.5px solid pure ink.
 *      Canada comparator: 1px dashed 4-2 pure ink, stroke-opacity 0.65.
 *  #2  MTA red terminal dot on CMA series only. No dot on Canada line.
 *  #3  1px pure-ink hairline plot frame per sub-panel.
 *  #4  Horizontal gridlines at 0.18 ink opacity.
 *  #5  Y-tick labels: IBM Plex Mono 400 10px, leftmost col only.
 *      No unit suffix on index levels (Jan 2005 = 100; source line carries it).
 *  #6  X-tick labels: Manrope 400 10px, bottom row only.
 *  #7  No zero line (index levels stay well above zero).
 *  #10 Word-only direct labels at line termini.
 *  #13 viewBox 720x405, preserveAspectRatio xMidYMid meet.
 *  #15 SVG role="img" aria-label.
 *  #17 No section-accent, no series-color tokens.
 *
 * Data: data/raw/crea_hpi_*.csv at build time via altUtils.readCsv.
 *   crea_hpi_canada.csv   â€” Canada composite (comparator)
 *   crea_hpi_toronto.csv  â€” Toronto CMA
 *   crea_hpi_vancouver.csv â€” Vancouver CMA
 *   crea_hpi_montreal.csv â€” Montreal CMA
 *   crea_hpi_calgary.csv  â€” Calgary CMA
 *   crea_hpi_edmonton.csv â€” Edmonton CMA
 *   crea_hpi_ottawa.csv   â€” Ottawa CMA
 * All files are tracked in git (force-added). Source: CREA MLS HPI bulk
 * file, April 2026 release. Index, Jan 2005 = 100.
 */

import { readCsv, decYear, tail, type AltPoint } from "../_alternatives/_shared/altUtils";

// --- Props (data ignored: this component reads from CSV at build time) --------
interface Props {
  data?: unknown;
}
const { data = null } = Astro.props;
void data;

// --- data load ---------------------------------------------------------------

const WINDOW = 180; // 15-year arc

const caRaw = readCsv("crea_hpi_canada.csv");
const caData = tail(caRaw, WINDOW);

// Panel order: TO | VAN | MTL (row 0), CAL | EDM | OTT (row 1)
const CMA_DEFS = [
  { label: "TORONTO",   file: "crea_hpi_toronto.csv" },
  { label: "VANCOUVER", file: "crea_hpi_vancouver.csv" },
  { label: "MONTREAL",  file: "crea_hpi_montreal.csv" },
  { label: "CALGARY",   file: "crea_hpi_calgary.csv" },
  { label: "EDMONTON",  file: "crea_hpi_edmonton.csv" },
  { label: "OTTAWA",    file: "crea_hpi_ottawa.csv" },
];

const panelSeries = CMA_DEFS.map((d) => ({
  ...d,
  data: tail(readCsv(d.file), WINDOW),
}));

// --- helpers -----------------------------------------------------------------

function lastReal(s: AltPoint[]): AltPoint | null {
  for (let i = s.length - 1; i >= 0; i--) {
    const p = s[i]!;
    if (typeof p.value === "number" && !Number.isNaN(p.value)) return p;
  }
  return null;
}

// --- shared x-domain ---------------------------------------------------------

const allX: number[] = [];
for (const p of caData) { const x = decYear(p.date); if (!Number.isNaN(x)) allX.push(x); }
for (const ps of panelSeries) for (const p of ps.data) { const x = decYear(p.date); if (!Number.isNaN(x)) allX.push(x); }
const xMin = allX.length > 0 ? Math.min(...allX) : 2011;
const xMax = allX.length > 0 ? Math.max(...allX) : 2026;

// --- Mode A unified y-domain -------------------------------------------------
// Fixed: [100, 400], 4 ticks every 100 index points.
// No unit suffix on tick labels â€” source line carries "Jan 2005 = 100".
const Y_LO = 100;
const Y_HI = 400;
const Y_TICKS = [100, 200, 300, 400];
const Y_RANGE = Y_HI - Y_LO; // 300

// --- layout constants --------------------------------------------------------

const VB_W = 720;
const VB_H = 405;
// M_OUT_L hosts y-tick labels so all three column plots share identical width.
// 28px fits 3-digit "400" at 10px mono + 5px gap.
const M_OUT_L = 28;
const M_OUT_R = 6;
const M_T = 10;
const M_B = 22;
const GAP_X = 16;
const GAP_Y = 28;
const COLS = 3;
const ROWS = 2;

const COL_W = (VB_W - M_OUT_L - M_OUT_R - GAP_X * (COLS - 1)) / COLS;
// COL_W = (720 - 28 - 6 - 32) / 3 = 654 / 3 = 218
const ROW_H = (VB_H - M_T - M_B - GAP_Y * (ROWS - 1)) / ROWS;
// ROW_H = (405 - 10 - 22 - 28) / 2 = 345 / 2 = 172.5

// Sub-panel inner margins (uniform across all columns).
// SUB_M_L: 4px passive gap; y-tick labels live in M_OUT_L gutter, not in-panel.
// SUB_M_R: 60px right gutter for direct labels "Vancouver\nCanada" (longest).
// SUB_M_T: subpanel heading height.
// SUB_M_B: x-tick space (bottom row) / passive gap (top row).
const SUB_M_L = 4;
const SUB_M_R = 60;
const SUB_M_T = 16;
const SUB_M_B = 18;

// --- X-ticks: exactly 3 anchors across the 15-year window -------------------
// 2015, 2020, 2025 â€” evenly spaced cycle anchors readable at any render size.
const X_TICK_YEARS = [2015, 2020, 2025];

// --- per-panel geometry builder ----------------------------------------------

interface SubGeom {
  col: number; row: number;
  cx0: number; cy0: number;
  plotX0: number; plotX1: number; plotW: number;
  plotY0: number; plotY1: number; plotH: number;
  xTicks: Array<{ x: number; label: string }>;
  cmaPath: string;
  caPath: string;
  lastX: number | null; lastY: number | null;
  lastValue: number | null; lastDate: string | null;
  caLastX: number | null; caLastY: number | null;
}

function buildSubPanel(
  col: number,
  row: number,
  cmaData: AltPoint[],
  caDataSeries: AltPoint[],
): SubGeom {
  const cx0 = M_OUT_L + col * (COL_W + GAP_X);
  const cy0 = M_T + row * (ROW_H + GAP_Y);
  const plotX0 = cx0 + SUB_M_L;
  const plotX1 = cx0 + COL_W - SUB_M_R;
  const plotY0 = cy0 + SUB_M_T;
  const plotY1 = cy0 + ROW_H - SUB_M_B;
  const plotW = plotX1 - plotX0;
  const plotH = plotY1 - plotY0;

  const xScale = (yr: number): number =>
    xMax === xMin ? plotX0 + plotW / 2 : plotX0 + ((yr - xMin) / (xMax - xMin)) * plotW;
  // Mode A: shared y-scale using Y_LO / Y_HI / Y_RANGE
  const yScale = (v: number): number =>
    plotY0 + plotH - ((v - Y_LO) / Y_RANGE) * plotH;

  // x-ticks: exactly the 3 specified years
  const xTicks: Array<{ x: number; label: string }> = [];
  for (const yr of X_TICK_YEARS) {
    const dy = yr + (1 - 0.5) / 12; // mid-January
    if (dy >= xMin && dy <= xMax) {
      xTicks.push({ x: xScale(dy), label: String(yr) });
    }
  }

  function buildPath(s: AltPoint[]): string {
    let p = "";
    let started = false;
    for (const pt of s) {
      if (typeof pt.value !== "number" || Number.isNaN(pt.value)) continue;
      const xv = decYear(pt.date);
      if (Number.isNaN(xv)) continue;
      p += (started ? "L" : "M") + xScale(xv).toFixed(2) + " " + yScale(pt.value).toFixed(2) + " ";
      started = true;
    }
    return p.trim();
  }

  const cmaPath = buildPath(cmaData);
  const caPath = buildPath(caDataSeries);

  // latest CMA point
  let lastX: number | null = null;
  let lastY: number | null = null;
  let lastValue: number | null = null;
  let lastDate: string | null = null;
  const lCma = lastReal(cmaData);
  if (lCma && typeof lCma.value === "number") {
    const xv = decYear(lCma.date);
    if (!Number.isNaN(xv)) {
      lastX = xScale(xv);
      lastY = yScale(lCma.value);
      lastValue = lCma.value;
      lastDate = lCma.date;
    }
  }

  // latest Canada point (for direct label position)
  let caLastX: number | null = null;
  let caLastY: number | null = null;
  const lCa = lastReal(caDataSeries);
  if (lCa && typeof lCa.value === "number") {
    const xv = decYear(lCa.date);
    if (!Number.isNaN(xv)) {
      caLastX = xScale(xv);
      caLastY = yScale(lCa.value);
    }
  }

  return {
    col, row,
    cx0, cy0,
    plotX0, plotX1, plotW,
    plotY0, plotY1, plotH,
    xTicks,
    cmaPath, caPath,
    lastX, lastY, lastValue, lastDate,
    caLastX, caLastY,
  };
}

const cells = panelSeries.map((p, i) => ({
  label: p.label,
  geom: buildSubPanel(i % COLS, Math.floor(i / COLS), p.data, caData),
}));

// direct-label y stacking: push apart if within 12px
function stackedLabelY(
  cmaY: number | null,
  caY: number | null,
  plotY0: number,
  plotY1: number,
): { cmaLabelY: number; caLabelY: number } {
  const MIN_GAP = 12;
  let cy = cmaY ?? 0;
  let ny = caY ?? 0;
  if (Math.abs(cy - ny) < MIN_GAP) {
    if (cy <= ny) ny = cy + MIN_GAP;
    else ny = cy - MIN_GAP;
    ny = Math.max(plotY0 + 4, Math.min(plotY1 - 4, ny));
  }
  return { cmaLabelY: cy, caLabelY: ny };
}

// aria-label string (best-effort)
const latest = cells.map((c) => {
  const v = c.geom.lastValue;
  const d = c.geom.lastDate;
  if (v === null || d === null) return `${c.label} n/a`;
  const mo = d.slice(0, 7).replace("-", " ");
  return `${c.label.charAt(0) + c.label.slice(1).toLowerCase()} ${mo}: ${v.toFixed(1)}`;
});
const caLast = lastReal(caData);
const caStr = caLast && typeof caLast.value === "number"
  ? `Canada ${caLast.date.slice(0, 7)}: ${caLast.value.toFixed(1)}`
  : "Canada n/a";

const ariaLabel =
  "Six-CMA small multiples: CREA MLS HPI index levels (Jan 2005 = 100). " +
  latest.join(", ") +
  ". " + caStr + ". Shared scale 100 to 400.";
---

<div class="p1-hpi-lvl" data-panel="housing-panel-1">
  <svg
    class="p1-hpi-lvl__svg"
    viewBox={`0 0 ${VB_W} ${VB_H}`}
    preserveAspectRatio="xMidYMid meet"
    role="img"
    aria-label={ariaLabel}
  >
    {cells.map((c) => {
      const g = c.geom;
      const isBottomRow = g.row === ROWS - 1;
      const isLeftmostCol = g.col === 0;
      const labelX = g.plotX1 + 5;
      const { cmaLabelY, caLabelY } = stackedLabelY(
        g.lastY, g.caLastY, g.plotY0, g.plotY1
      );

      return (
        <g>
          {/* subpanel heading: CMA name micro-caps, above plot area */}
          <text
            class="p1-hpi-lvl__subhead"
            x={(g.plotX0).toFixed(2)}
            y={(g.cy0 + 11).toFixed(2)}
            text-anchor="start"
          >{c.label}</text>

          {/* horizontal gridlines at every Y_TICK */}
          {Y_TICKS.map((v) => {
            const yy = g.plotY0 + g.plotH - ((v - Y_LO) / Y_RANGE) * g.plotH;
            return (
              <line
                class="p1-hpi-lvl__gridline"
                x1={g.plotX0.toFixed(2)} y1={yy.toFixed(2)}
                x2={g.plotX1.toFixed(2)} y2={yy.toFixed(2)}
              />
            );
          })}

          {/* Canada comparator: drawn first (behind CMA line) */}
          <path
            class="p1-hpi-lvl__line p1-hpi-lvl__line--canada"
            d={g.caPath}
            fill="none"
          />

          {/* CMA primary line */}
          <path
            class="p1-hpi-lvl__line"
            d={g.cmaPath}
            fill="none"
          />

          {/* plot frame: 1px hairline */}
          <rect
            class="p1-hpi-lvl__frame"
            x={g.plotX0} y={g.plotY0}
            width={g.plotW} height={g.plotH}
          />

          {/* x-ticks: bottom row only */}
          {isBottomRow && g.xTicks.map((t) => (
            <g>
              <line
                class="p1-hpi-lvl__xtick"
                x1={t.x.toFixed(2)} y1={g.plotY1.toFixed(2)}
                x2={t.x.toFixed(2)} y2={(g.plotY1 + 3).toFixed(2)}
              />
              <text
                class="p1-hpi-lvl__xtick-label"
                x={t.x.toFixed(2)}
                y={(g.plotY1 + 13).toFixed(2)}
                text-anchor="middle"
              >{t.label}</text>
            </g>
          ))}

          {/* y-tick labels: leftmost column only (Mode A shared scale).
              No unit suffix â€” index levels; source line carries "Jan 2005 = 100". */}
          {isLeftmostCol && Y_TICKS.map((v) => {
            const yy = g.plotY0 + g.plotH - ((v - Y_LO) / Y_RANGE) * g.plotH;
            return (
              <text
                class="p1-hpi-lvl__ytick-label"
                x={(g.plotX0 - 5).toFixed(2)}
                y={(yy + 4).toFixed(2)}
                text-anchor="end"
              >{v.toFixed(0)}</text>
            );
          })}

          {/* direct end-of-line labels: CMA name + Canada comparator */}
          <text
            class="p1-hpi-lvl__direct-label"
            x={labelX.toFixed(2)}
            y={(cmaLabelY + 4).toFixed(2)}
            text-anchor="start"
          >{c.label.charAt(0) + c.label.slice(1).toLowerCase()}</text>
          {g.caLastY !== null && (
            <text
              class="p1-hpi-lvl__direct-label p1-hpi-lvl__direct-label--canada"
              x={labelX.toFixed(2)}
              y={(caLabelY + 4).toFixed(2)}
              text-anchor="start"
            >Canada</text>
          )}

          {/* MTA red terminal dot on CMA series only */}
          {g.lastX !== null && g.lastY !== null && (
            <circle
              class="p1-hpi-lvl__latest-dot"
              cx={g.lastX.toFixed(2)}
              cy={g.lastY.toFixed(2)}
              r="3.5"
            >
            </circle>
          )}
        </g>
      );
    })}
  </svg>

  {/* source line */}
  <p class="p1-hpi-lvl__source">
    CREA MLS HPI national + six-CMA bulk file (April 2026 release). Index, Jan 2005 = 100.
  </p>
</div>

<style>
  .p1-hpi-lvl {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: var(--paper);
    overflow: visible;
  }
  .p1-hpi-lvl__svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    font-family: var(--font-sans);
  }

  /* subpanel heading: micro-caps Manrope 600 */
  .p1-hpi-lvl__subhead {
    fill: var(--ink);
    font-family: var(--font-sans);
    font-size: 9px;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  /* gridlines: 0.18 ink opacity */
  .p1-hpi-lvl__gridline {
    stroke: var(--ink);
    stroke-width: 1;
    stroke-opacity: 0.18;
    shape-rendering: crispEdges;
  }

  /* CMA primary line: 1.5px solid pure ink */
  .p1-hpi-lvl__line {
    stroke: var(--ink);
    stroke-width: 1.5;
    stroke-linejoin: round;
    stroke-linecap: round;
    fill: none;
    vector-effect: non-scaling-stroke;
  }

  /* Canada comparator: 1px dashed 4-2 pure ink, 0.65 opacity */
  .p1-hpi-lvl__line--canada {
    stroke: var(--ink);
    stroke-width: 1;
    stroke-dasharray: 4 2;
    stroke-opacity: 0.65;
    vector-effect: non-scaling-stroke;
  }

  /* MTA red terminal dot on CMA only */
  .p1-hpi-lvl__latest-dot {
    fill: var(--accent);
    stroke: none;
  }

  /* plot frame: 1px pure-ink hairline */
  .p1-hpi-lvl__frame {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1;
    shape-rendering: crispEdges;
  }

  /* x-tick marks */
  .p1-hpi-lvl__xtick {
    stroke: var(--ink);
    stroke-width: 1;
    shape-rendering: crispEdges;
  }

  /* x-tick labels: Manrope 400 10px */
  .p1-hpi-lvl__xtick-label {
    fill: var(--ink);
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: var(--fw-regular);
    font-variant-numeric: tabular-nums;
  }

  /* y-tick labels: IBM Plex Mono 400 10px */
  .p1-hpi-lvl__ytick-label {
    fill: var(--ink);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: var(--fw-regular);
    font-variant-numeric: tabular-nums;
  }

  /* direct CMA label: Manrope 600 10px */
  .p1-hpi-lvl__direct-label {
    fill: var(--ink);
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: var(--fw-semibold);
  }

  /* Canada comparator label: Manrope 400 9px (recedes vs CMA name) */
  .p1-hpi-lvl__direct-label--canada {
    font-weight: var(--fw-regular);
    font-size: 9px;
  }

  /* source line: IBM Plex Mono 9px ink-faint */
  .p1-hpi-lvl__source {
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 9px;
    color: var(--ink-faint, #999);
    line-height: 1.3;
  }
</style>
