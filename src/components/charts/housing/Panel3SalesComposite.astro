    stroke-opacity: 0.18;
    shape-rendering: crispEdges;
  }

  /* Main line: 1.5px solid pure ink */
  .p3sc__line--main {
    stroke: var(--ink);
    stroke-width: 1.5;
    stroke-linejoin: round;
    stroke-linecap: round;
    fill: none;
    vector-effect: non-scaling-stroke;
  }

  /* Raw monthly comparator: 1px dashed 4-2, 0.65 opacity */
  .p3sc__line--raw {
    stroke: var(--ink);
