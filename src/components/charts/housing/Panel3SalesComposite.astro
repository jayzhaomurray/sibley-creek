    stroke-dasharray: 4 2;
    stroke-opacity: 0.65;
    fill: none;
    vector-effect: non-scaling-stroke;
  }

  /* MTA red terminal dot */
  .p3sc__latest-dot {
    fill: var(--accent);
    stroke: none;
  }

  /* Balanced-market band (40-60): low-opacity ink fill */
  .p3sc__balance-band {
    fill: var(--ink);
    fill-opacity: 0.07;
    stroke: var(--ink);
    stroke-width: 0.5;
    stroke-opacity: 0.20;
  }

  /* Band label: Manrope 600 9px, ink-faint */
  .p3sc__band-label {
    fill: var(--ink);
    fill-opacity: 0.50;
    font-family: var(--font-sans);
    font-size: 9px;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.04em;
  }

  /* X-tick marks */
  .p3sc__xtick {
    stroke: var(--ink);
    stroke-width: 1;
    shape-rendering: crispEdges;
  }

  /* X-tick labels: Manrope 11px */
  .p3sc__xtick-label {
    fill: var(--ink);
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: var(--fw-regular);
    font-variant-numeric: tabular-nums;
  }

  /* Y-tick labels: IBM Plex Mono 11px, ink-faint */
  .p3sc__ytick-label {
    fill: var(--ink);
    fill-opacity: 0.65;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: var(--fw-regular);
    font-variant-numeric: tabular-nums;
  }

  /* Direct end-of-line labels */
  .p3sc__direct-label {
    fill: var(--ink);
