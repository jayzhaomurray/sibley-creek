---
/*
 * Panel2Activity - housing activity: starts and units under construction.
 *
 * Pipeline emits `housing_starts` (primary, SAAR units) and
 * `units_under_construction` (secondary). Both share units in spirit
 * but the magnitudes differ; PanelLiveChart suppresses the secondary
 * line when units don't match exactly to avoid a misleading overlay.
 *
 * Wave 5 fold (EDR brief Section 3): CMA-level resales (Toronto /
 * Vancouver / Calgary, 12M rolling) added as secondary toggle view.
 * Resales are a flow not a stock and not directly comparable to
 * starts - the toggle is a view-switch, not a single-axis overlay.
 * Deferred until the centralized toggle pattern lands; CSV inputs
 * (`crea_resales_*.csv`) are on disk per EDR brief.
 *
 * Synthetic-data fallback removed.
 */

import type { PanelData } from "../_shared/panelData";
import PanelLiveChart from "../_shared/PanelLiveChart.astro";
import PanelEmpty from "../_shared/PanelEmpty.astro";

interface Props {
  data?: PanelData | null;
}

const { data = null } = Astro.props;
---
{data && data.primary ? (
  <PanelLiveChart
    primary={data.primary}
    secondary={data.secondary}
    primaryLabel="Starts, SAAR"
    secondaryLabel="Under constr."
    dataPanelAttr="housing-2"
    ariaLabel="Housing starts SAAR."
  />
) : (
  <PanelEmpty reason="Pipeline did not emit panel-2 data." />
)}
