---
/*
 * Panel4Rent - rent: CPI rent sub-series.
 *
 * Pipeline emits `cpi_rent_yoy` (primary) and
 * `cpi_rented_accommodation_yoy` (secondary) as Y/Y % series. CMHC RMS
 * levels are not on disk; rendering the CPI velocity sub-series is
 * honest to the data we have.
 *
 * Synthetic-data fallback removed.
 */

import type { PanelData } from "../_shared/panelData";
import PanelLiveChart from "../_shared/PanelLiveChart.astro";
import PanelEmpty from "../_shared/PanelEmpty.astro";

interface Props {
  data?: PanelData | null;
}

const { data = null } = Astro.props;
---
{data && data.primary ? (
  <PanelLiveChart
    primary={data.primary}
    secondary={data.secondary}
    primaryLabel="Rent y/y"
    secondaryLabel="Rented y/y"
    dataPanelAttr="housing-4"
    ariaLabel="CPI rent and rented accommodation, year-over-year."
  />
) : (
  <PanelEmpty reason="Pipeline did not emit panel-4 data." />
)}
