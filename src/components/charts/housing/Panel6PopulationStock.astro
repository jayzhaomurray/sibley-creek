---
/*
 * Panel6PopulationStock - population vs housing stock proxies.
 *
 * Pipeline emits `pop_immigrants` (primary, persons) and
 * `housing_starts` (secondary, units). Units don't match for an
 * overlay so PanelLiveChart shows the primary alone; the page
 * interpretation copy carries the ratio reading.
 *
 * Synthetic-data fallback removed.
 */

import type { PanelData } from "../_shared/panelData";
import PanelLiveChart from "../_shared/PanelLiveChart.astro";
import PanelEmpty from "../_shared/PanelEmpty.astro";

interface Props {
  data?: PanelData | null;
}

const { data = null } = Astro.props;
---
{data && data.primary ? (
  <PanelLiveChart
    primary={data.primary}
    secondary={data.secondary}
    primaryLabel="PR inflows"
    dataPanelAttr="housing-6"
    ariaLabel="Immigrant inflows, persons."
  />
) : (
  <PanelEmpty reason="Population-to-stock ratio not yet emitted." />
)}
