---
/*
 * Panel6PopulationStock - Housing chartbook, plate 06.
 *
 * Editorial canon Section 4.4: population-to-housing-stock ratio by CMA.
 * Annual frequency. The story is dispersion - Toronto and Vancouver carry
 * the tightest ratios where supply has been slowest.
 *
 * Visual: horizontal dot plot. One row per CMA, plus a national-average
 * vertical reference. The dot shows the latest year; a 1px ink hairline
 * connector to a smaller open dot shows the 5-years-ago level, giving
 * the eye the direction-of-travel without a separate panel.
 *
 * Vignelli canon: pure black filled circles for latest, pure black open
 * circles for the prior reference, 1px ink connector. MTA red marker
 * only on the load-bearing row (Toronto, the tightest).
 *
 * Plot vs SVG: hand-rolled SVG. Single composition, no JS warranted.
 */

interface CmaRow {
  code: string;
  label: string;
  /** Latest year ratio: persons per housing unit. */
  ratio_now: number;
  /** Five-years-ago ratio for the same CMA. */
  ratio_prior: number;
}

interface Props {
  data?: CmaRow[];
  /** National-average ratio at the latest year. */
  nationalNow?: number;
  asOf?: string;
  ariaLabel?: string;
}

function defaultRows(): CmaRow[] {
  return [
    { code: "TOR", label: "Toronto",     ratio_now: 2.74, ratio_prior: 2.61 },
    { code: "VAN", label: "Vancouver",   ratio_now: 2.62, ratio_prior: 2.52 },
    { code: "MTL", label: "Montreal",    ratio_now: 2.32, ratio_prior: 2.26 },
    { code: "OTT", label: "Ottawa",      ratio_now: 2.41, ratio_prior: 2.35 },
    { code: "EDM", label: "Edmonton",    ratio_now: 2.45, ratio_prior: 2.40 },
    { code: "CGY", label: "Calgary",     ratio_now: 2.48, ratio_prior: 2.41 },
  ];
}

const {
  data = defaultRows(),
  nationalNow = 2.39,
  asOf = "2025",
  ariaLabel = `Population per housing unit by CMA, ${asOf}`,
} = Astro.props;

// Sort descending so tightest CMA at top.
const sorted = [...data].sort((a, b) => b.ratio_now - a.ratio_now);

// ---- Geometry --------------------------------------------------------------
const VB_W = 720;
const VB_H = 360;
const M_T = 36;
const M_B = 40;
const M_L = 140; // room for CMA names
const M_R = 80;
const PLOT_X0 = M_L;
const PLOT_X1 = VB_W - M_R;
const PLOT_W = PLOT_X1 - PLOT_X0;
const PLOT_Y0 = M_T;
const PLOT_Y1 = VB_H - M_B;
const PLOT_H = PLOT_Y1 - PLOT_Y0;

const allVals = sorted.flatMap((r) => [r.ratio_now, r.ratio_prior]);
allVals.push(nationalNow);
const xMin = Math.floor(Math.min(...allVals) * 10) / 10 - 0.05;
const xMax = Math.ceil(Math.max(...allVals) * 10) / 10 + 0.05;

function xScale(v: number): number {
  return PLOT_X0 + ((v - xMin) / (xMax - xMin)) * PLOT_W;
}

const ROW_H = PLOT_H / sorted.length;

const xTicks: number[] = [];
{
  const step = 0.1;
  for (let v = Math.ceil(xMin * 10) / 10; v <= xMax + 1e-9; v = Math.round((v + step) * 100) / 100) {
    xTicks.push(v);
  }
}

const nationalX = xScale(nationalNow);
---
<div class="housing-panel-6" aria-label={ariaLabel}>
  <svg
    class="housing-panel-6__svg"
    viewBox={`0 0 ${VB_W} ${VB_H}`}
    preserveAspectRatio="xMidYMid meet"
    role="img"
    aria-label={ariaLabel}
  >
    {/* Top stamp */}
    <text
      class="housing-panel-6__sub-title"
      x={PLOT_X0.toFixed(2)}
      y={(PLOT_Y0 - 14).toFixed(2)}
      text-anchor="start"
    >Persons per housing unit, by CMA</text>
    <text
      class="housing-panel-6__sub-asof"
      x={PLOT_X1.toFixed(2)}
      y={(PLOT_Y0 - 14).toFixed(2)}
      text-anchor="end"
    >{`Latest vs 5y ago | ${asOf}`}</text>

    {/* X-axis gridlines */}
    {xTicks.map((v) => (
      <line
        class="housing-panel-6__gridline"
        x1={xScale(v).toFixed(2)}
        y1={PLOT_Y0.toFixed(2)}
        x2={xScale(v).toFixed(2)}
        y2={PLOT_Y1.toFixed(2)}
      />
    ))}

    {/* National-average reference */}
    <line
      class="housing-panel-6__natline"
      x1={nationalX.toFixed(2)}
      y1={PLOT_Y0.toFixed(2)}
      x2={nationalX.toFixed(2)}
      y2={PLOT_Y1.toFixed(2)}
    />
    <text
      class="housing-panel-6__natlabel"
      x={(nationalX + 4).toFixed(2)}
      y={(PLOT_Y0 - 2).toFixed(2)}
      text-anchor="start"
    >{`Nat'l ${nationalNow.toFixed(2)}`}</text>

    {/* Frame */}
    <rect
      class="housing-panel-6__frame"
      x={PLOT_X0.toFixed(2)}
      y={PLOT_Y0.toFixed(2)}
      width={PLOT_W.toFixed(2)}
      height={PLOT_H.toFixed(2)}
      fill="none"
    />

    {sorted.map((r, i) => {
      const rowY = PLOT_Y0 + i * ROW_H + ROW_H / 2;
      const xNow = xScale(r.ratio_now);
      const xPrior = xScale(r.ratio_prior);
      const isLoadBearing = i === 0;
      return (
        <g>
          {/* Row label */}
          <text
            class="housing-panel-6__row-label"
            x={(PLOT_X0 - 8).toFixed(2)}
            y={(rowY + 3.5).toFixed(2)}
            text-anchor="end"
          >{r.label}</text>
          {/* Connector */}
          <line
            class="housing-panel-6__connector"
            x1={xPrior.toFixed(2)}
            y1={rowY.toFixed(2)}
            x2={xNow.toFixed(2)}
            y2={rowY.toFixed(2)}
          />
          {/* Prior dot (open) */}
          <circle
            class="housing-panel-6__dot-prior"
            cx={xPrior.toFixed(2)}
            cy={rowY.toFixed(2)}
            r="3.5"
          >
            <title>{`${r.label} 5y ago: ${r.ratio_prior.toFixed(2)}`}</title>
          </circle>
          {/* Latest dot (filled, black or accent) */}
          <circle
            class:list={["housing-panel-6__dot-now", { "housing-panel-6__dot-now--accent": isLoadBearing }]}
            cx={xNow.toFixed(2)}
            cy={rowY.toFixed(2)}
            r="4"
          >
            <title>{`${r.label} latest: ${r.ratio_now.toFixed(2)}`}</title>
          </circle>
          {/* Latest value to right */}
          <text
            class="housing-panel-6__row-val"
            x={(PLOT_X1 + 8).toFixed(2)}
            y={(rowY + 3.5).toFixed(2)}
            text-anchor="start"
          >{r.ratio_now.toFixed(2)}</text>
        </g>
      );
    })}

    {/* X-axis */}
    <line
      class="housing-panel-6__xaxis"
      x1={PLOT_X0.toFixed(2)}
      y1={PLOT_Y1.toFixed(2)}
      x2={PLOT_X1.toFixed(2)}
      y2={PLOT_Y1.toFixed(2)}
    />
    {xTicks.map((v) => (
      <text
        class="housing-panel-6__xtick-label"
        x={xScale(v).toFixed(2)}
        y={(PLOT_Y1 + 14).toFixed(2)}
        text-anchor="middle"
      >{v.toFixed(2)}</text>
    ))}
  </svg>
</div>

<style>
  .housing-panel-6 {
    width: 100%;
    aspect-ratio: 720 / 360;
    background-color: var(--surface);
  }
  .housing-panel-6__svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    font-family: var(--font-sans);
  }
  .housing-panel-6__sub-title {
    fill: var(--ink);
    font-size: 11px;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .housing-panel-6__sub-asof {
    fill: var(--ink);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: var(--fw-regular);
    opacity: 0.7;
  }
  .housing-panel-6__gridline {
    stroke: var(--rule);
    stroke-width: 1;
    stroke-opacity: 0.18;
    shape-rendering: crispEdges;
  }
  .housing-panel-6__natline {
    stroke: var(--ink);
    stroke-width: 1;
    stroke-dasharray: 3 2;
    shape-rendering: crispEdges;
  }
  .housing-panel-6__natlabel {
    fill: var(--ink);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: var(--fw-regular);
    font-variant-numeric: tabular-nums;
  }
  .housing-panel-6__frame {
    stroke: var(--ink);
    stroke-width: 1;
    shape-rendering: crispEdges;
  }
  .housing-panel-6__connector {
    stroke: var(--ink);
    stroke-width: 1;
    shape-rendering: crispEdges;
  }
  .housing-panel-6__dot-prior {
    fill: var(--surface);
    stroke: var(--ink);
    stroke-width: 1;
  }
  .housing-panel-6__dot-now {
    fill: var(--ink);
  }
  .housing-panel-6__dot-now--accent {
    fill: var(--accent);
  }
  .housing-panel-6__row-label {
    fill: var(--ink);
    font-size: 11px;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.10em;
    text-transform: uppercase;
  }
  .housing-panel-6__row-val,
  .housing-panel-6__xtick-label {
    fill: var(--ink);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: var(--fw-regular);
    font-variant-numeric: tabular-nums;
  }
  .housing-panel-6__xaxis {
    stroke: var(--ink);
    stroke-width: 1;
    shape-rendering: crispEdges;
  }
</style>
