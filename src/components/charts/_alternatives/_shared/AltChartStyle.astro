---
/*
 * AltChartStyle - shared SVG canon stylesheet for chart alternatives.
 *
 * Mirrors src/components/charts/_canon_reference/PanelCanonReference.astro
 * exactly. Imported via <AltChartStyle /> in each alternative so they all
 * share one set of canon class declarations.
 */
---
<style is:global>
  .alt-chart { width: 100%; aspect-ratio: 16 / 9; background-color: var(--paper); overflow: visible; }
  .alt-chart__svg { display: block; width: 100%; height: 100%; overflow: visible; font-family: var(--font-sans); }

  .alt-chart__recession { fill: rgba(21, 23, 26, 0.06); }
  .alt-chart__recession-label {
    fill: var(--ink); font-family: var(--font-sans);
    font-size: 11px; font-weight: var(--fw-semibold); letter-spacing: 0.18em;
  }

  .alt-chart__gridline { stroke: var(--ink); stroke-width: 1; stroke-opacity: 0.18; shape-rendering: crispEdges; }
  .alt-chart__zero-line { stroke: var(--ink); stroke-width: 1; stroke-opacity: 1; shape-rendering: crispEdges; }

  .alt-chart__reference-rule { stroke: var(--ink); stroke-width: 1; stroke-dasharray: 4 2; shape-rendering: crispEdges; }
  .alt-chart__reference-label {
    fill: var(--ink); font-family: var(--font-sans);
    font-size: 12px; font-weight: var(--fw-semibold); letter-spacing: 0.04em;
  }

  .alt-chart__line {
    stroke: var(--ink); stroke-width: 1.5; stroke-linejoin: round; stroke-linecap: round;
    fill: none; vector-effect: non-scaling-stroke;
  }
  .alt-chart__line-secondary {
    stroke: var(--ink); stroke-width: 1; stroke-dasharray: 4 2;
    stroke-linejoin: round; stroke-linecap: butt; fill: none; vector-effect: non-scaling-stroke;
  }
  .alt-chart__line-tertiary {
    stroke: var(--ink); stroke-width: 1; stroke-dasharray: 2 3;
    stroke-linejoin: round; stroke-linecap: butt; fill: none; vector-effect: non-scaling-stroke;
  }

  .alt-chart__bar { fill: var(--ink); }
  .alt-chart__bar-neg { fill: var(--ink); fill-opacity: 0.55; }

  .alt-chart__latest-dot { fill: var(--accent); stroke: none; }
  .alt-chart__dot { fill: var(--ink); stroke: none; }

  .alt-chart__frame { fill: none; stroke: var(--ink); stroke-width: 1; shape-rendering: crispEdges; }

  .alt-chart__xtick { stroke: var(--ink); stroke-width: 1; shape-rendering: crispEdges; }
  .alt-chart__xtick-label {
    fill: var(--ink); font-family: var(--font-sans);
    font-size: 12px; font-weight: var(--fw-regular); font-variant-numeric: tabular-nums;
  }
  .alt-chart__ytick-label {
    fill: var(--ink); font-family: var(--font-mono);
    font-size: 12px; font-weight: var(--fw-regular); font-variant-numeric: tabular-nums;
  }

  .alt-chart__direct-label {
    fill: var(--ink); font-family: var(--font-sans);
    font-size: 13px; font-weight: var(--fw-semibold);
  }
  .alt-chart__direct-label-secondary {
    fill: var(--ink); font-family: var(--font-sans);
    font-size: 13px; font-weight: var(--fw-regular);
  }
  .alt-chart__cat-label {
    fill: var(--ink); font-family: var(--font-sans);
    font-size: 12px; font-weight: var(--fw-regular);
  }
  .alt-chart__small-multiple-title {
    fill: var(--ink); font-family: var(--font-sans);
    font-size: 11px; font-weight: var(--fw-semibold); letter-spacing: 0.06em;
    text-transform: uppercase;
  }
</style>
