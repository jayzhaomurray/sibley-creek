---
/*
 * Alt1_BocFedSpread - BoC overnight rate minus Fed funds rate.
 *
 * What's different. Production Panel 1 plots BoC overnight alone. This
 * alternative is the policy-divergence chart: BoC minus Fed, with a zero
 * crossing line. The spread drives USDCAD and the front-end basis.
 *
 * Why it might be better. The spread is the read that matters for the
 * fixed-income desk. A level chart of BoC alone is monetary policy half-
 * told.
 *
 * Data. overnight_rate.csv, fed_funds.csv.
 */

import { readCsv, diff } from "../_shared/altUtils";
import AltChartStyle from "../_shared/AltChartStyle.astro";
import AltLineChart from "../_shared/AltLineChart.astro";

const boc = readCsv("overnight_rate.csv");
const fed = readCsv("fed_funds.csv");
const spread = diff(boc, fed);

const N = 84; // 7y
---

<div class="alt-chart" data-panel="alt-policy-1">
  <AltLineChart
    primary={spread.slice(-N)}
    primaryLabel="BoC-Fed"
    primaryStep={true}
    unitSuffix="pp"
    yDecimals={2}
    referenceValue={0}
    referenceLabel="Parity"
    ariaLabel="BoC overnight rate minus Fed funds rate, monthly, last seven years."
  />
</div>

<AltChartStyle />
