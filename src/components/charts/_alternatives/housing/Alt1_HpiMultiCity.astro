---
/*
 * Alt1_HpiMultiCity - MLS HPI Y/Y national vs Toronto vs Vancouver
 * vs Calgary, four lines.
 *
 * What's different. Production Panel 1 shows national HPI Y/Y alone. This
 * decomposes into national + the three biggest CMAs so regional
 * dispersion reads in one view.
 *
 * Why it might be better. National HPI averages over wildly different
 * regional cycles. The Calgary-Toronto divergence post-2022 is the most
 * editorially-relevant housing story of the past two years; it cannot
 * be seen without the per-CMA decomposition.
 *
 * Data. crea_hpi_canada.csv + crea_hpi_toronto.csv + crea_hpi_vancouver.csv + crea_hpi_calgary.csv.
 */

import { readCsv, yoy, decYear, VB, PLOT, pickStride, fmtTick, yearTicksFromX, type AltPoint } from "../_shared/altUtils";
import AltChartStyle from "../_shared/AltChartStyle.astro";

interface S { key: string; label: string; data: AltPoint[]; }

const N = 84;
const series: S[] = [
  { key: "can", label: "National", data: yoy(readCsv("crea_hpi_canada.csv")).slice(-N) },
  { key: "tor", label: "Toronto", data: yoy(readCsv("crea_hpi_toronto.csv")).slice(-N) },
  { key: "van", label: "Vancouver", data: yoy(readCsv("crea_hpi_vancouver.csv")).slice(-N) },
  { key: "cal", label: "Calgary", data: yoy(readCsv("crea_hpi_calgary.csv")).slice(-N) },
];

let yLo = Infinity, yHi = -Infinity;
for (const s of series) for (const p of s.data) if (typeof p.value === "number") { if (p.value < yLo) yLo = p.value; if (p.value > yHi) yHi = p.value; }
if (!Number.isFinite(yLo)) { yLo = -20; yHi = 40; }
const span = yHi - yLo || 1;
yLo -= span * 0.05; yHi += span * 0.05;

const allX: number[] = [];
for (const s of series) for (const p of s.data) { const x = decYear(p.date); if (!Number.isNaN(x)) allX.push(x); }
const xMin = Math.min(...allX), xMax = Math.max(...allX);

const xScale = (yr: number) => PLOT.X0 + ((yr - xMin) / (xMax - xMin || 1)) * PLOT.W;
const yScale = (v: number) => PLOT.Y0 + PLOT.H - ((v - yLo) / (yHi - yLo)) * PLOT.H;
const xTicks = yearTicksFromX(xMin, xMax, xScale);

const yStride = pickStride(yLo, yHi);
const yTicks: number[] = [];
const startY = Math.ceil(yLo / yStride) * yStride;
for (let v = startY; v <= yHi + 1e-9; v += yStride) yTicks.push(v);

function buildPath(s: AltPoint[]): string {
  let d = "", started = false;
  for (const p of s) {
    if (typeof p.value !== "number") { started = false; continue; }
    const xv = decYear(p.date);
    if (Number.isNaN(xv)) continue;
    d += `${started ? "L" : "M"}${xScale(xv).toFixed(2)} ${yScale(p.value).toFixed(2)} `;
    started = true;
  }
  return d.trim();
}

// Treatment: primary = National (solid 1.5px), Toronto (dashed 4 2),
// Vancouver (dashed 2 3 sparser), Calgary (dotted 1 3 sparsest). All
// pure ink.
const pathStyles: Record<string, string> = {
  can: "stroke:var(--ink);stroke-width:1.5;fill:none;stroke-linejoin:round",
  tor: "stroke:var(--ink);stroke-width:1;stroke-dasharray:4 2;fill:none",
  van: "stroke:var(--ink);stroke-width:1;stroke-dasharray:2 3;fill:none",
  cal: "stroke:var(--ink);stroke-width:1;stroke-dasharray:1 3;fill:none",
};

const crossesZero = yLo < 0 && yHi > 0;

// Latest dot only on national (primary)
const lastNat = [...series[0]!.data].reverse().find((p) => typeof p.value === "number");

// Direct labels: stack at right edge with national in 600 and the three
// CMAs in 400, vertically spread.
const labels: Array<{ x: number; y: number; text: string; bold: boolean }> = [];
const baseRight = PLOT.X1 + 8;
for (const s of series) {
  const last = [...s.data].reverse().find((p) => typeof p.value === "number");
  if (!last) continue;
  labels.push({ x: baseRight, y: yScale(last.value as number) + 4, text: s.label, bold: s.key === "can" });
}
// resolve overlaps by spacing 14px apart
labels.sort((a, b) => a.y - b.y);
for (let i = 1; i < labels.length; i++) {
  if (labels[i]!.y - labels[i - 1]!.y < 14) labels[i]!.y = labels[i - 1]!.y + 14;
}
---

<div class="alt-chart" data-panel="alt-housing-1">
  <svg
    class="alt-chart__svg"
    viewBox={`0 0 ${VB.W} ${VB.H}`}
    preserveAspectRatio="xMidYMid meet"
    role="img"
    aria-label="MLS HPI year-over-year change: national, Toronto, Vancouver, Calgary, monthly."
  >
    {yTicks.map((v) => {
      const yy = yScale(v);
      if (crossesZero && Math.abs(v) < 1e-9) return null;
      return <line class="alt-chart__gridline" x1={PLOT.X0} y1={yy.toFixed(2)} x2={PLOT.X1} y2={yy.toFixed(2)} />;
    })}
    {crossesZero && <line class="alt-chart__zero-line" x1={PLOT.X0} y1={yScale(0).toFixed(2)} x2={PLOT.X1} y2={yScale(0).toFixed(2)} />}

    {series.map((s) => <path d={buildPath(s.data)} style={pathStyles[s.key]} />)}

    {lastNat && <circle class="alt-chart__latest-dot" cx={xScale(decYear(lastNat.date)).toFixed(2)} cy={yScale(lastNat.value as number).toFixed(2)} r="4"><title>{`National HPI ${lastNat.date}: ${(lastNat.value as number).toFixed(1)}%`}</title></circle>}

    <rect class="alt-chart__frame" x={PLOT.X0} y={PLOT.Y0} width={PLOT.W} height={PLOT.H} />

    {xTicks.map((t) => (
      <g>
        <line class="alt-chart__xtick" x1={t.x.toFixed(2)} y1={PLOT.Y1.toFixed(2)} x2={t.x.toFixed(2)} y2={(PLOT.Y1 + 4).toFixed(2)} />
        <text class="alt-chart__xtick-label" x={t.x.toFixed(2)} y={(PLOT.Y1 + 18).toFixed(2)} text-anchor="middle">{t.label}</text>
      </g>
    ))}

    {yTicks.map((v, i) => {
      const isTop = i === yTicks.length - 1;
      const sign = v > 0 ? "+" : "";
      const num = fmtTick(v, 0);
      return <text class="alt-chart__ytick-label" x={(PLOT.X0 - 8).toFixed(2)} y={(yScale(v) + 4).toFixed(2)} text-anchor="end">{isTop ? `${sign}${num}%` : `${sign}${num}`}</text>;
    })}

    {labels.map((L) => (
      <text class={L.bold ? "alt-chart__direct-label" : "alt-chart__direct-label-secondary"} x={L.x.toFixed(2)} y={L.y.toFixed(2)} text-anchor="start">{L.text}</text>
    ))}
  </svg>
</div>

<AltChartStyle />
