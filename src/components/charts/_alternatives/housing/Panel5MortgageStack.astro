---
/*
 * Panel5MortgageStack - mortgage rate proxy.
 *
 * Pipeline emits `mortgage_rate_5yr` (primary, %). The full mortgage-
 * stack-by-vintage-and-term construction is deferred; we render the
 * 5y posted rate as the closest available proxy.
 *
 * Wave 5 fold (EDR brief Section 3): 5Y GoC + the 5Y mortgage-rate /
 * 5Y GoC spread added as secondary element (marginal-borrower
 * cost-of-borrowing). Both share units (%) with the primary so the
 * eventual overlay sits on the same axis. When backend lands the
 * paired series, the existing wrapper picks it up via `data.secondary`
 * with no further change here.
 *
 * Synthetic-data fallback removed.
 */

import type { PanelData } from "../../_shared/panelData";
import PanelLiveChart from "../../_shared/PanelLiveChart.astro";
import PanelEmpty from "../../_shared/PanelEmpty.astro";

interface Props {
  data?: PanelData | null;
}

const { data = null } = Astro.props;
---
{data && data.primary ? (
  <PanelLiveChart
    primary={data.primary}
    secondary={data.secondary}
    primaryLabel="5y mortgage"
    dataPanelAttr="housing-5"
    ariaLabel="5-year mortgage rate, posted."
  />
) : (
  <PanelEmpty reason="Pipeline did not emit panel-5 data." />
)}
