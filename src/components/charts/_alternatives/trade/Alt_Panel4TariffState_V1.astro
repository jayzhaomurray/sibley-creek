---
/*
 * Panel4TariffState — US tariff-state tracker (Option B: horizontal bar chart).
 *
 * Reads from panel-4.metadata.rows in trade.json (direct import).
 * Does not use PanelLiveChart — this is an editorially-maintained
 * tracker, not a time series. panel4Data is null from pickPanel().
 *
 * Chart: horizontal bars ranked descending by rate_pct.
 *   - in_force: solid black fill (MTA red on highest-rate row only)
 *   - under_review: 0.55 opacity + dashed stroke, no bar if rate_pct null
 *   - Rate label right of bar in IBM Plex Mono
 *   - Sector label left in Manrope
 *   - Mechanism + effective date micro-tag at far right
 *   - viewBox 720x405
 */

import type { PanelData } from "../../_shared/panelData";
import panelDataFile from "../../../../../data/site/panel_data/trade.json";

interface Props {
  data?: PanelData | null;
}
const { data: _data = null } = Astro.props;
void _data;

// ----- Data -----------------------------------------------------------------

type TariffRow = {
  id: string;
  label: string;
  rate_pct: number | null;
  rate_label: string;
  sector: string;
  mechanism: string;
  effective_date: string;
  status: "in_force" | "under_review";
};

const rawPanel4 = (panelDataFile as Record<string, any>)
  .panels?.["panel-4"] as Record<string, any> | undefined;
const rows: TariffRow[] = (rawPanel4?.metadata?.rows as TariffRow[]) ?? [];

// Sort: in_force first (descending rate), then under_review (rate_pct null last).
const sorted: TariffRow[] = [...rows].sort((a, b) => {
  if (a.status === "in_force" && b.status !== "in_force") return -1;
  if (a.status !== "in_force" && b.status === "in_force") return 1;
  const aV: number = a.rate_pct ?? -1;
  const bV: number = b.rate_pct ?? -1;
  return bV - aV;
});

const asOf: string =
  (rawPanel4?.metadata?.as_of as string | undefined) ?? "";

// ----- Geometry constants ---------------------------------------------------

const VW = 720;
const VH = 450;
const MT = 36;   // top margin (for tick headers)
const MB = 40;   // bottom margin (as-of + legend)
const ML = 192;  // left margin (sector label column)
const MR = 88;   // right margin (mechanism tag)

const chartW: number = VW - ML - MR;
const chartH: number = VH - MT - MB;
const N: number = sorted.length;
const GAP = 8;
const ROW_H: number = Math.floor((chartH - GAP * (N - 1)) / N);
const BAR_H: number = Math.max(ROW_H - 6, 12);
const BAR_OFFSET: number = Math.floor((ROW_H - BAR_H) / 2);

// Minimum bar width for placing rate label inside the bar (white, right-anchored).
const INSIDE_THRESHOLD = 80;

// Scale ceiling slightly above the max rate so bars don't bleed to edge.
const SCALE_MAX = 60;

// Find highest in_force rate for MTA red accent (first occurrence in sorted).
const maxRate: number = Math.max(
  ...sorted
    .filter((r) => r.status === "in_force" && r.rate_pct !== null)
    .map((r) => r.rate_pct as number),
  0,
);

// Month abbreviations for effective_date display.
const MONTHS = ["Jan","Feb","Mar","Apr","May","Jun",
                 "Jul","Aug","Sep","Oct","Nov","Dec"];
function fmtDate(d: string): string {
  if (!d) return "";
  const parts = d.split("-");
  if (parts.length < 2) return d;
  const mIdx = parseInt(parts[1]!, 10) - 1;
  return `${MONTHS[mIdx] ?? ""} ${parts[0]}`;
}

// Pre-compute per-row geometry into a plain object array so JSX is
// purely declarative (avoids Astro JSX multi-statement block parse issues).
// Abbreviate a rate_label string for SVG rendering without mutating data.
function abbrevRateLabel(s: string): string {
  // "10% lumber; 25% furniture/cabinets" -> "10% lumber; 25% furn./cabinets"
  return s.replace("furniture/cabinets", "furn./cabinets");
}

// Abbreviate a sector string for SVG rendering without mutating data.
function abbrevSector(s: string): string {
  // "All goods (USMCA non-compliant)" -> "All goods (non-USMCA)"  [~130px at 11px Manrope]
  return s.replace("All goods (USMCA non-compliant)", "All goods (non-USMCA)");
}

type RowGeo = {
  row: TariffRow;
  y: number;
  barX: number;
  barY: number;
  bw: number;
  barFill: string;
  barOpacity: number;
  strokeDash: string;
  isAccent: boolean;
  isUnderReview: boolean;
  rateLabelX: number;
  rateLabelAnchor: string;
  rateLabelFill: string;
  rateLabelWeight: string;
  displayRateLabel: string;
  displaySector: string;
  sectorLabelY: number;
  mechTagY: number;
  dateTagY: number;
  dated: string;
  sepY: number;
  isLast: boolean;
};

const geoRows: RowGeo[] = sorted.map((row, i) => {
  const y: number = MT + i * (ROW_H + GAP);
  const bw: number =
    row.rate_pct !== null && row.rate_pct > 0
      ? Math.round((row.rate_pct / SCALE_MAX) * chartW)
      : 0;
  const isAccent: boolean =
    row.status === "in_force" &&
    row.rate_pct === maxRate &&
    i === sorted.findIndex((r) => r.status === "in_force" && r.rate_pct === maxRate);
  const isUnderReview: boolean = row.status === "under_review";
  const barFill: string = isAccent ? "#E63946" : "#000";
  const barOpacity: number = isUnderReview ? 0.55 : 1;
  const strokeDash: string = isUnderReview ? "3 3" : "none";

  // Rate label: inside bar (white, right-anchored) when bar is wide enough;
  // outside bar (ink, left-anchored) for short or zero-width bars.
  const insideBar: boolean = bw >= INSIDE_THRESHOLD;
  const rateLabelX: number = insideBar
    ? ML + bw - 6
    : ML + (bw > 0 ? bw : Math.round(chartW * 0.18)) + 6;
  const rateLabelAnchor: string = insideBar ? "end" : "start";
  const rateLabelFill: string = insideBar
    ? (isAccent ? "#fff" : "#fff")
    : (isAccent ? "#E63946" : "#000");

  const midRow: number = Math.round(ROW_H / 2);
  return {
    row,
    y,
    barX: ML,
    barY: y + BAR_OFFSET,
    bw,
    barFill,
    barOpacity,
    strokeDash,
    isAccent,
    isUnderReview,
    rateLabelX,
    rateLabelAnchor,
    rateLabelFill,
    rateLabelWeight: isAccent ? "600" : "400",
    displayRateLabel: abbrevRateLabel(row.rate_label),
    displaySector: abbrevSector(row.sector),
    sectorLabelY: y + midRow + 4,
    mechTagY: y + Math.round(ROW_H * 0.35),
    dateTagY: y + Math.round(ROW_H * 0.60),
    dated: fmtDate(row.effective_date),
    sepY: y + ROW_H + Math.round(GAP / 2),
    isLast: i === N - 1,
  };
});

// Axis tick x positions.
const tick25x: number = ML + Math.round((25 / SCALE_MAX) * chartW);
const tick50x: number = ML + Math.round((50 / SCALE_MAX) * chartW);

// Placeholder bar width for under_review rows with no rate.
const placeholderBw: number = Math.round(chartW * 0.18);
---
<svg
  viewBox={`0 0 ${VW} ${VH}`}
  width="100%"
  aria-label="US tariff actions affecting Canada: horizontal bar chart ranked by rate."
  role="img"
  style="display:block;overflow:visible"
  font-family="'IBM Plex Mono', 'Courier New', monospace"
>
  {/* Column header */}
  <text
    x={ML}
    y={MT - 14}
    font-size="9"
    font-family="'Manrope', 'Helvetica Neue', sans-serif"
    font-weight="600"
    letter-spacing="0.12em"
    fill="#000"
    text-anchor="start"
    style="text-transform:uppercase"
  >RATE</text>

  {/* 25% reference line + tick */}
  <line x1={tick25x} y1={MT - 8} x2={tick25x} y2={VH - MB} stroke="#000" stroke-width="0.5" stroke-dasharray="2 3" opacity="0.18" />
  <text x={tick25x} y={MT - 14} font-size="9" fill="#888" text-anchor="middle">25%</text>

  {/* 50% reference line + tick */}
  <line x1={tick50x} y1={MT - 8} x2={tick50x} y2={VH - MB} stroke="#000" stroke-width="0.5" stroke-dasharray="2 3" opacity="0.18" />
  <text x={tick50x} y={MT - 14} font-size="9" fill="#888" text-anchor="middle">50%</text>

  {/* Zero baseline (left edge) */}
  <line x1={ML} y1={MT - 8} x2={ML} y2={VH - MB} stroke="#000" stroke-width="1" />

  {/* Bottom hairline */}
  <line x1={ML} y1={VH - MB} x2={VW - MR + 4} y2={VH - MB} stroke="#000" stroke-width="1" />

  {/* Data rows */}
  {geoRows.map((g) => (
    <g>
      {/* Sector label */}
      <text
        x={ML - 8}
        y={g.sectorLabelY}
        font-size="11"
        font-family="'Manrope', 'Helvetica Neue', sans-serif"
        font-weight="400"
        fill="#000"
        text-anchor="end"
      >{g.displaySector}</text>

      {/* Bar — in_force with rate */}
      {g.bw > 0 && (
        <rect
          x={g.barX}
          y={g.barY}
          width={g.bw}
          height={BAR_H}
          fill={g.barFill}
          opacity={g.barOpacity}
          stroke="#000"
          stroke-width="1"
          stroke-dasharray={g.strokeDash}
        />
      )}

      {/* Placeholder bar — under_review with no rate */}
      {g.bw === 0 && g.isUnderReview && (
        <rect
          x={g.barX}
          y={g.barY}
          width={placeholderBw}
          height={BAR_H}
          fill="none"
          stroke="#000"
          stroke-width="1"
          stroke-dasharray="3 3"
          opacity="0.4"
        />
      )}

      {/* Rate label — inside bar (white) when bar wide enough, outside otherwise */}
      <text
        x={g.rateLabelX}
        y={g.sectorLabelY}
        font-size="10"
        fill={g.rateLabelFill}
        font-weight={g.rateLabelWeight}
        text-anchor={g.rateLabelAnchor}
      >{g.displayRateLabel}</text>

      {/* Mechanism tag */}
      <text
        x={VW - 6}
        y={g.mechTagY}
        font-size="8.5"
        font-family="'Manrope', 'Helvetica Neue', sans-serif"
        font-weight="600"
        letter-spacing="0.08em"
        fill="#555"
        text-anchor="end"
        style="text-transform:uppercase"
      >{g.row.mechanism}</text>

      {/* Effective date */}
      {g.dated && (
        <text
          x={VW - 6}
          y={g.dateTagY}
          font-size="8"
          fill="#888"
          text-anchor="end"
        >{g.dated}</text>
      )}

      {/* Row separator */}
      {!g.isLast && (
        <line
          x1={0}
          y1={g.sepY}
          x2={VW}
          y2={g.sepY}
          stroke="#000"
          stroke-width="0.4"
          opacity="0.12"
        />
      )}
    </g>
  ))}

  {/* Legend note */}
  <text
    x={ML}
    y={VH - MB + 18}
    font-size="9"
    fill="#666"
    text-anchor="start"
    font-family="'Manrope', 'Helvetica Neue', sans-serif"
  >Dashed outline = under review. Rate label reflects enacted rate or pending status.</text>

  {/* As-of stamp */}
  {asOf && (
    <text
      x={VW - MR + 4}
      y={VH - MB + 18}
      font-size="9"
      fill="#888"
      text-anchor="end"
    >As of {asOf}</text>
  )}
</svg>
