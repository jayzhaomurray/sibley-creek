---
/*
 * Panel5Demand — Canadian population demand fundamentals.
 * Two panels, side-by-side, 720x405. Housing section, plate-5.
 *
 * Left panel  — "POPULATION": total Canadian population level, quarterly.
 * Right panel — "POPULATION Y/Y": Y/Y growth rate, computed in-component
 *   as (pop[t] - pop[t-4]) / pop[t-4] * 100.
 *
 * Window: 2010-01-01 through latest available quarter.
 * This window captures the pre-2020 stable-growth baseline, the 2020 COVID
 * dip, the 2022-2024 immigration surge, and the 2025-2026 deceleration.
 *
 * Data: data/raw/pop_total.csv (quarterly, StatCan Table 17-10-0009-01,
 *   estimates of population, Canada, by quarter). Already git-tracked.
 *   Read via altUtils.readCsv at build time. Values in persons; displayed
 *   in millions on the level panel.
 *
 * Layout (Mode B two-panel — disparate units, each panel owns its y-axis):
 *   M_OUT_L = 36  — left y-tick gutter (left panel)
 *   GAP_X   = 40  — inter-panel gutter (right-panel y-tick labels live here)
 *   M_R     = 12  — right outer margin
 *   COL_W   = (720 - 36 - 40 - 12) / 2 = 316 per panel
 *
 * Canon-compliance:
 *  #1  1.5px solid pure ink line per panel.
 *  #2  MTA red terminal dot per panel, r=4.
 *  #3  1px pure-ink hairline plot frame per panel.
 *  #4  Horizontal gridlines at 0.18 ink opacity.
 *  #5  Y-tick labels: IBM Plex Mono 11px; topmost tick carries unit suffix
 *      ("M" for level, "%" for Y/Y).
 *  #6  X-tick labels: Manrope 11px, shared bottom x-axis.
 *  #13 viewBox 720x405, preserveAspectRatio xMidYMid meet.
 *  #14 aspect-ratio 16/9 on wrapper.
 *  #15 SVG role="img" aria-label.
 *  #17 No section-accent, no series-color tokens, no legend.
 *  #18 var(--paper) background.
 *  No source paragraph — source on plate metadata strip per 2026-05-13 rule.
 *
 * Methodology (Y/Y):
 *   Concept: annual population growth rate at each quarterly observation.
 *   Formula: (population this quarter minus population four quarters prior)
 *            divided by population four quarters prior, times 100.
 *   Source: StatCan demographic estimates methodology — direct application
 *           of standard Y/Y percent change, 4-quarter lag for quarterly data.
 *   No simplification vs source: formula is exact arithmetic on the
 *   published population level series; no approximation or seasonal
 *   adjustment applied.
 */

import { readCsv, decYear, type AltPoint } from "../_shared/altUtils";

// --- Props (data ignored: reads CSV at build time) ---------------------------
interface Props {
  data?: unknown;
}
const { data = null } = Astro.props;
void data;

// --- Data load and window filter ---------------------------------------------

const WIN_START = "2010-01-01";

const rawAll: AltPoint[] = readCsv("pop_total.csv");
const raw: AltPoint[] = rawAll.filter((p) => p.date >= WIN_START);

// Level series: convert persons to millions for display
const levelSeries: AltPoint[] = raw.map((p) => ({
  date: p.date,
  value: p.value !== null ? p.value / 1_000_000 : null,
}));

// Y/Y series: (pop[t] - pop[t-4]) / pop[t-4] * 100 (4-quarter lag, quarterly)
// We use rawAll (full history) for the lag lookups so that early 2010 points
// can reach back to 2009.
const rawMap = new Map<string, number>();
for (const p of rawAll) {
  if (p.value !== null) rawMap.set(p.date, p.value);
}

function quarterMinus4(date: string): string {
  // Subtract exactly 1 year from the date string (quarterly data).
  const y = parseInt(date.slice(0, 4), 10);
  return (y - 1) + date.slice(4);
}

const yoySeries: AltPoint[] = raw.map((p) => {
  if (p.value === null) return { date: p.date, value: null };
  const lagDate = quarterMinus4(p.date);
  const lagVal = rawMap.get(lagDate);
  if (lagVal === undefined || lagVal === 0) return { date: p.date, value: null };
  return {
    date: p.date,
    value: ((p.value - lagVal) / lagVal) * 100,
  };
});

// --- Helpers -----------------------------------------------------------------

function lastReal(s: AltPoint[]): AltPoint | null {
  for (let i = s.length - 1; i >= 0; i--) {
    const p = s[i]!;
    if (typeof p.value === "number" && !Number.isNaN(p.value)) return p;
  }
  return null;
}

// --- Shared x-domain ---------------------------------------------------------

const allX: number[] = [];
for (const p of levelSeries) {
  const x = decYear(p.date);
  if (!Number.isNaN(x)) allX.push(x);
}
const xMin = allX.length > 0 ? Math.min(...allX) : 2010;
const xMax = allX.length > 0 ? Math.max(...allX) : 2026;

// --- Y-domain: level panel (millions) ----------------------------------------
// Data range ~33.5M to ~41.5M. Step 2M; ticks: 34, 36, 38, 40, 42.
// Floor/ceil to step-2 nice boundaries.

const levelVals: number[] = levelSeries
  .filter((p): p is AltPoint & { value: number } =>
    typeof p.value === "number" && !Number.isNaN(p.value)
  )
  .map((p) => p.value);
const levelDataMin = levelVals.length > 0 ? Math.min(...levelVals) : 33;
const levelDataMax = levelVals.length > 0 ? Math.max(...levelVals) : 42;

const LEVEL_STEP = 2;
const LEVEL_LO = Math.floor(levelDataMin / LEVEL_STEP) * LEVEL_STEP;
const LEVEL_HI = Math.ceil(levelDataMax / LEVEL_STEP) * LEVEL_STEP;

const LEVEL_TICKS: number[] = [];
for (let v = LEVEL_LO; v <= LEVEL_HI; v += LEVEL_STEP) LEVEL_TICKS.push(v);

// --- Y-domain: Y/Y panel (percent) -------------------------------------------
// Data range approximately -0.5% to +4%. Step 1%; ticks: 0, 1, 2, 3, 4.
// Floor data min down, ceil data max up, both to step-1.

const yoyVals: number[] = yoySeries
  .filter((p): p is AltPoint & { value: number } =>
    typeof p.value === "number" && !Number.isNaN(p.value)
  )
  .map((p) => p.value);
const yoyDataMin = yoyVals.length > 0 ? Math.min(...yoyVals) : -1;
const yoyDataMax = yoyVals.length > 0 ? Math.max(...yoyVals) : 4;

const YOY_STEP = 1;
const YOY_LO = Math.floor(yoyDataMin / YOY_STEP) * YOY_STEP;
const YOY_HI = Math.ceil(yoyDataMax / YOY_STEP) * YOY_STEP;

const YOY_TICKS: number[] = [];
for (let v = YOY_LO; v <= YOY_HI; v += YOY_STEP) YOY_TICKS.push(v);

// --- Layout constants --------------------------------------------------------

const VB_W = 720;
const VB_H = 405;
const M_OUT_L = 36;   // left y-tick gutter
const M_R     = 12;   // right outer margin
const M_T     = 30;   // top (subheading)
const M_B     = 36;   // bottom (x-ticks + labels)
const GAP_X   = 40;   // inter-panel gutter (right-panel y-ticks live here)
const COLS    = 2;

// COL_W = (720 - 36 - 40 - 12) / 2 = 316
const COL_W = (VB_W - M_OUT_L - GAP_X - M_R) / COLS;
const PLOT_H  = VB_H - M_T - M_B;

// Sub-panel inner margins
const SUB_M_L = 4;   // per spec (uniform, y-ticks live in outer/inter-panel gutters)
const SUB_M_R = 8;   // no direct label for single series

// Panel 0 (left: level)
const P0_CX = M_OUT_L;                  // panel container left edge
const P0_PLOT_X0 = P0_CX + SUB_M_L;
const P0_PLOT_X1 = P0_CX + COL_W - SUB_M_R;
const P0_PLOT_W  = P0_PLOT_X1 - P0_PLOT_X0;
const P0_PLOT_Y0 = M_T;
const P0_PLOT_Y1 = M_T + PLOT_H;

// Panel 1 (right: Y/Y)
const P1_CX = M_OUT_L + COL_W + GAP_X; // panel container left edge
const P1_PLOT_X0 = P1_CX + SUB_M_L;
const P1_PLOT_X1 = P1_CX + COL_W - SUB_M_R;
const P1_PLOT_W  = P1_PLOT_X1 - P1_PLOT_X0;
const P1_PLOT_Y0 = M_T;
const P1_PLOT_Y1 = M_T + PLOT_H;

// --- Scale functions ---------------------------------------------------------

const xScale = (xv: number, plotX0: number, plotW: number): number =>
  plotX0 + ((xv - xMin) / (xMax - xMin || 1)) * plotW;

const yScaleLevel = (v: number): number =>
  P0_PLOT_Y0 + PLOT_H - ((v - LEVEL_LO) / ((LEVEL_HI - LEVEL_LO) || 1)) * PLOT_H;

const yScaleYoy = (v: number): number =>
  P1_PLOT_Y0 + PLOT_H - ((v - YOY_LO) / ((YOY_HI - YOY_LO) || 1)) * PLOT_H;

// --- X-ticks: 2010, 2013, 2016, 2019, 2022, 2025 — clean 3-year anchors -----

const X_TICK_YEARS = [2010, 2013, 2016, 2019, 2022, 2025];
// Render shared x-ticks once (bottom of chart, apply to both panels)
const xTicksLeft: Array<{ x: number; label: string }> = [];
const xTicksRight: Array<{ x: number; label: string }> = [];
for (const yr of X_TICK_YEARS) {
  const dy = yr + (1 - 0.5) / 12; // mid-January anchor
  if (dy >= xMin - 0.1 && dy <= xMax + 0.1) {
    xTicksLeft.push({ x: xScale(dy, P0_PLOT_X0, P0_PLOT_W), label: String(yr) });
    xTicksRight.push({ x: xScale(dy, P1_PLOT_X0, P1_PLOT_W), label: String(yr) });
  }
}

// --- Path builders -----------------------------------------------------------

function buildPath(
  series: AltPoint[],
  plotX0: number,
  plotW: number,
  ys: (v: number) => number,
): string {
  let p = "";
  let started = false;
  for (const pt of series) {
    if (typeof pt.value !== "number" || Number.isNaN(pt.value)) {
      started = false;
      continue;
    }
    const xv = decYear(pt.date);
    if (Number.isNaN(xv)) continue;
    const sx = xScale(xv, plotX0, plotW);
    const sy = ys(pt.value);
    p += (started ? "L" : "M") + sx.toFixed(2) + " " + sy.toFixed(2) + " ";
    started = true;
  }
  return p.trim();
}

const levelPath = buildPath(levelSeries, P0_PLOT_X0, P0_PLOT_W, yScaleLevel);
const yoyPath   = buildPath(yoySeries,   P1_PLOT_X0, P1_PLOT_W, yScaleYoy);

// --- Zero line for Y/Y panel (only if range spans zero) ----------------------

const yoySpansZero = YOY_LO < 0 && YOY_HI > 0;
const yoyZeroY = yoySpansZero ? yScaleYoy(0) : null;

// --- Terminal dots -----------------------------------------------------------

function terminalDot(
  series: AltPoint[],
  plotX0: number,
  plotW: number,
  ys: (v: number) => number,
): { x: number; y: number; value: number; date: string } | null {
  const last = lastReal(series);
  if (!last || typeof last.value !== "number") return null;
  const xv = decYear(last.date);
  if (Number.isNaN(xv)) return null;
  return {
    x: xScale(xv, plotX0, plotW),
    y: ys(last.value),
    value: last.value,
    date: last.date,
  };
}

const levelDot = terminalDot(levelSeries, P0_PLOT_X0, P0_PLOT_W, yScaleLevel);
const yoyDot   = terminalDot(yoySeries,   P1_PLOT_X0, P1_PLOT_W, yScaleYoy);

// --- Aria label --------------------------------------------------------------

const ariaLabel =
  "Two-panel chart: Canadian population demand fundamentals, quarterly 2010 to present. " +
  "Left panel: population level in millions. " +
  (levelDot ? `Latest ${levelDot.date.slice(0, 7)}: ${levelDot.value.toFixed(2)}M. ` : "") +
  "Right panel: population year-over-year growth rate. " +
  (yoyDot ? `Latest ${yoyDot.date.slice(0, 7)}: ${yoyDot.value.toFixed(2)}%.` : "");
---

<div class="p5dem" data-panel="housing-panel-5">
  <svg
    class="p5dem__svg"
    viewBox={`0 0 ${VB_W} ${VB_H}`}
    preserveAspectRatio="xMidYMid meet"
    role="img"
    aria-label={ariaLabel}
  >

    {/* -------- LEFT PANEL: POPULATION LEVEL -------------------------------- */}

    {/* subpanel heading */}
    <text
      class="p5dem__subhead"
      x={P0_PLOT_X0.toFixed(2)}
      y={(M_T - 8).toFixed(2)}
      text-anchor="start"
    >POPULATION</text>

    {/* horizontal gridlines */}
    {LEVEL_TICKS.map((v) => {
      const yy = yScaleLevel(v);
      return (
        <line
          class="p5dem__gridline"
          x1={P0_PLOT_X0.toFixed(2)} y1={yy.toFixed(2)}
          x2={P0_PLOT_X1.toFixed(2)} y2={yy.toFixed(2)}
        />
      );
    })}

    {/* data line */}
    <path class="p5dem__line" d={levelPath} fill="none" />

    {/* plot frame */}
    <rect
      class="p5dem__frame"
      x={P0_PLOT_X0} y={P0_PLOT_Y0}
      width={P0_PLOT_W} height={PLOT_H}
    />

    {/* x-ticks (shared axis — both panels share the same time domain) */}
    {xTicksLeft.map((t) => (
      <g>
        <line
          class="p5dem__xtick"
          x1={t.x.toFixed(2)} y1={P0_PLOT_Y1.toFixed(2)}
          x2={t.x.toFixed(2)} y2={(P0_PLOT_Y1 + 4).toFixed(2)}
        />
        <text
          class="p5dem__xtick-label"
          x={t.x.toFixed(2)}
          y={(P0_PLOT_Y1 + 16).toFixed(2)}
          text-anchor="middle"
        >{t.label}</text>
      </g>
    ))}

    {/* y-tick labels: left panel — in M_OUT_L gutter */}
    {LEVEL_TICKS.map((v, idx) => {
      const yy = yScaleLevel(v);
      const isTop = idx === LEVEL_TICKS.length - 1;
      const txt = v.toFixed(0) + (isTop ? "M" : "");
      return (
        <text
          class="p5dem__ytick-label"
          x={(P0_PLOT_X0 - 5).toFixed(2)}
          y={(yy + 4).toFixed(2)}
          text-anchor="end"
        >{txt}</text>
      );
    })}

    {/* MTA red terminal dot */}
    {levelDot && (
      <circle
        class="p5dem__latest-dot"
        cx={levelDot.x.toFixed(2)}
        cy={levelDot.y.toFixed(2)}
        r="4"
      >
        <title>{`${levelDot.date.slice(0, 7)}: ${levelDot.value.toFixed(2)}M`}</title>
      </circle>
    )}

    {/* -------- RIGHT PANEL: POPULATION Y/Y --------------------------------- */}

    {/* subpanel heading */}
    <text
      class="p5dem__subhead"
      x={P1_PLOT_X0.toFixed(2)}
      y={(M_T - 8).toFixed(2)}
      text-anchor="start"
    >POPULATION Y/Y</text>

    {/* horizontal gridlines */}
    {YOY_TICKS.map((v) => {
      const yy = yScaleYoy(v);
      return (
        <line
          class="p5dem__gridline"
          x1={P1_PLOT_X0.toFixed(2)} y1={yy.toFixed(2)}
          x2={P1_PLOT_X1.toFixed(2)} y2={yy.toFixed(2)}
        />
      );
    })}

    {/* zero line on Y/Y panel (explicit zero reference, only when range spans zero) */}
    {yoyZeroY !== null && (
      <line
        class="p5dem__zeroline"
        x1={P1_PLOT_X0.toFixed(2)} y1={yoyZeroY.toFixed(2)}
        x2={P1_PLOT_X1.toFixed(2)} y2={yoyZeroY.toFixed(2)}
      />
    )}

    {/* data line */}
    <path class="p5dem__line" d={yoyPath} fill="none" />

    {/* plot frame */}
    <rect
      class="p5dem__frame"
      x={P1_PLOT_X0} y={P1_PLOT_Y0}
      width={P1_PLOT_W} height={PLOT_H}
    />

    {/* x-ticks (right panel) */}
    {xTicksRight.map((t) => (
      <g>
        <line
          class="p5dem__xtick"
          x1={t.x.toFixed(2)} y1={P1_PLOT_Y1.toFixed(2)}
          x2={t.x.toFixed(2)} y2={(P1_PLOT_Y1 + 4).toFixed(2)}
        />
        <text
          class="p5dem__xtick-label"
          x={t.x.toFixed(2)}
          y={(P1_PLOT_Y1 + 16).toFixed(2)}
          text-anchor="middle"
        >{t.label}</text>
      </g>
    ))}

    {/* y-tick labels: right panel — in GAP_X gutter (to left of right panel) */}
    {YOY_TICKS.map((v, idx) => {
      const yy = yScaleYoy(v);
      const isTop = idx === YOY_TICKS.length - 1;
      const txt = v.toFixed(0) + (isTop ? "%" : "");
      return (
        <text
          class="p5dem__ytick-label"
          x={(P1_PLOT_X0 - 5).toFixed(2)}
          y={(yy + 4).toFixed(2)}
          text-anchor="end"
        >{txt}</text>
      );
    })}

    {/* MTA red terminal dot */}
    {yoyDot && (
      <circle
        class="p5dem__latest-dot"
        cx={yoyDot.x.toFixed(2)}
        cy={yoyDot.y.toFixed(2)}
        r="4"
      >
        <title>{`${yoyDot.date.slice(0, 7)}: ${yoyDot.value.toFixed(2)}%`}</title>
      </circle>
    )}

  </svg>
</div>

<style>
  .p5dem {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: var(--paper);
    overflow: visible;
  }

  .p5dem__svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    font-family: var(--font-sans);
  }

  /* Subpanel headings: micro-caps Manrope 600 */
  .p5dem__subhead {
    fill: var(--ink);
    font-family: var(--font-sans);
    font-size: 9px;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  /* Horizontal gridlines: 0.18 ink opacity */
  .p5dem__gridline {
    stroke: var(--ink);
    stroke-width: 1;
    stroke-opacity: 0.18;
    shape-rendering: crispEdges;
  }

  /* Zero reference line on Y/Y panel: slightly heavier than gridline */
  .p5dem__zeroline {
    stroke: var(--ink);
    stroke-width: 1;
    stroke-opacity: 0.35;
    shape-rendering: crispEdges;
  }

  /* Data line: 1.5px solid pure ink */
  .p5dem__line {
    stroke: var(--ink);
    stroke-width: 1.5;
    stroke-linejoin: round;
    stroke-linecap: round;
    fill: none;
    vector-effect: non-scaling-stroke;
  }

  /* Plot frame: 1px pure-ink hairline */
  .p5dem__frame {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1;
    shape-rendering: crispEdges;
  }

  /* X-axis tick marks */
  .p5dem__xtick {
    stroke: var(--ink);
    stroke-width: 1;
    shape-rendering: crispEdges;
  }

  /* X-axis tick labels: Manrope 400 11px */
  .p5dem__xtick-label {
    fill: var(--ink);
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: var(--fw-regular);
    font-variant-numeric: tabular-nums;
  }

  /* Y-axis tick labels: IBM Plex Mono 400 11px */
  .p5dem__ytick-label {
    fill: var(--ink);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: var(--fw-regular);
    font-variant-numeric: tabular-nums;
  }

  /* MTA red terminal dot */
  .p5dem__latest-dot {
    fill: var(--accent);
    stroke: none;
  }
</style>
