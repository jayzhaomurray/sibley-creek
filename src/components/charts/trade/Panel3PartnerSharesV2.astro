---
/*
 * Panel3PartnerSharesV2 - plate-1, US export share.
 *
 * Primary line:
 *   us_share[t] = (exports_us[t] / exports_total[t]) * 100
 *
 * Source series:
 *   panel-3 primary   = trade_exports_total  (StatCan 12-10-0121-01)
 *   panel-3 secondary = trade_exports_us     (StatCan 12-10-0121-01)
 *
 * The ex-gold comparator was dropped on 2026-05-13 to preserve the gold
 * reveal on plate-3. If a future iteration brings it back, see git history
 * for the original two-line implementation.
 */

import type { PanelData, PanelSeries, SeriesPoint } from "../_shared/panelData";
import PanelLiveChart from "../_shared/PanelLiveChart.astro";
import PanelEmpty from "../_shared/PanelEmpty.astro";

interface Props {
  data?: PanelData | null;
}

const { data = null } = Astro.props;

let primaryDerived: PanelSeries | null = null;

if (data && data.primary && data.secondary) {
  const total = data.primary.data;
  const us = data.secondary.data;

  const usByDate = new Map<string, number | null>();
  for (const p of us) usByDate.set(p.date, p.value);

  const shareData: SeriesPoint[] = [];
  for (const p of total) {
    const usV = usByDate.get(p.date);
    const totalV = p.value;
    if (
      typeof usV !== "number" || typeof totalV !== "number" ||
      Number.isNaN(usV) || Number.isNaN(totalV) || totalV === 0
    ) {
      shareData.push({ date: p.date, value: null });
    } else {
      shareData.push({ date: p.date, value: (usV / totalV) * 100 });
    }
  }

  primaryDerived = {
    key: "us_share_of_exports",
    label: "US share",
    data: shareData,
    unit: "%",
    kind: "percent",
    frequency: data.primary.frequency ?? "monthly",
    asOfISO: data.primary.asOfISO ?? null,
    source: data.primary.source ?? null,
    sourceUrl: data.primary.sourceUrl ?? null,
    sourceId: data.primary.sourceId ?? null,
  };
}
---
{primaryDerived ? (
  <PanelLiveChart
    primary={primaryDerived}
    primaryLabel="US share"
    dataPanelAttr="trade-3-v2"
    ariaLabel="US share of total Canadian merchandise exports, percent of total."
    yTickStride={5}
    yDomainMin={63}
  />
) : (
  <PanelEmpty reason="US-share derivation requires the export series." />
)}
