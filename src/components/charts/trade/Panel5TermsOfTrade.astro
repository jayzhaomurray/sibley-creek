---
/*
 * AUDIT-FLAGGED 2026-05-11 - see design/chart-editorial-audit-2026-05-11.md
 * Improved version: ./Panel5TermsOfTradeV2.astro
 * Live in production until user reviews comparison page and picks one.
 * Decision pending.
 */
/*
 * Panel5TermsOfTrade - terms of trade.
 *
 * Pipeline emits `wti` and `brent` as proxies; the ToT index itself is
 * not on disk. We render the proxies as the closest available series.
 *
 * Synthetic-data fallback removed.
 */

import type { PanelData } from "../_shared/panelData";
import PanelLiveChart from "../_shared/PanelLiveChart.astro";
import PanelEmpty from "../_shared/PanelEmpty.astro";

interface Props {
  data?: PanelData | null;
}

const { data = null } = Astro.props;
---
{data && data.primary ? (
  <PanelLiveChart
    primary={data.primary}
    secondary={data.secondary}
    primaryLabel="WTI"
    secondaryLabel="Brent"
    dataPanelAttr="trade-5"
    ariaLabel="Oil price proxies for terms of trade: WTI and Brent."
  />
) : (
  <PanelEmpty reason="Terms-of-trade index not yet emitted." />
)}
