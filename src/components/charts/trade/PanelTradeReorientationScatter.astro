---
/*
 * PanelTradeReorientationScatter â€” Export reorientation scatter, latest YoY window
 *
 * Chart type: Scatter plot, 720x405 (16:9).
 *
 * Each dot is one NAPCS sub-chapter (100 sectors).
 *   X-axis (linear):       delta_us    = end_us    - start_us    (CAD M)
 *   Y-axis (signed-sqrt):  delta_nonus = (end_total - end_us) -
 *                                        (start_total - start_us)  (CAD M)
 *   Dot area:              sqrt(end_total), mapped to r=[2,13]px
 *
 * Y-axis uses signed-sqrt transform: y = sign(v) * sqrt(|v|) * K.
 * Gold's delta_nonus is +4,784 (CAD M); the next-largest is +816 (oil).
 * A linear y-axis would crush the entire cluster into an unreadable band.
 * Signed-sqrt preserves sign and zero while compressing the outlier.
 * Tick labels carry the original CAD-M values; the transform is
 * transparent to the reader.
 *
 * Labeled sectors (4):
 *   Gold  â€” NAPCS 35 (unwrought gold/silver/platinum)
 *   Oil   â€” NAPCS 13 (crude oil and bitumen)
 *   Gas   â€” NAPCS 14 (natural gas)
 *   Cars  â€” NAPCS 81 (passenger cars and light trucks)
 *
 * Axis-orienting phrases (replace axis titles):
 *   "Sold less to the US"            â€” near Cars (most negative delta_us)
 *   "Sold more to non-US markets"    â€” near Gold (most positive delta_nonus)
 *
 * Quadrant reading:
 *   Top-left:     real pivot    (lost US, gained non-US)
 *   Top-right:    grew both     (gained US + non-US)
 *   Bottom-right: concentrated  (gained US, lost non-US)
 *   Bottom-left:  shrinking     (lost both)
 *
 * Canon compliance (design/canon_reference_panel.md + design/design-system.md v1.0):
 *   - Dots: 1px pure ink stroke, fill-opacity 0.18. No MTA red on points.
 *   - Zero gridlines: 1px pure ink, opacity 0.4 (heavier than regular gridlines 0.18).
 *   - Regular gridlines: 1px pure ink, opacity 0.18.
 *   - 1px pure ink hairline plot frame.
 *   - Title: Manrope 600, 12px, micro-caps, letter-spacing 0.10em.
 *   - Tick labels: IBM Plex Mono 400, 11px, ink-faint.
 *   - Dot labels: Manrope 600, 12px, pure ink.
 *   - Orienting phrases: Manrope 400 italic, 11px, ink-faint.
 *   - viewBox 720x405. No client JS.
 *
 * Methodology note (direct derivation, no external source beyond StatCan):
 *   delta_us    = end_us - start_us
 *   delta_nonus = (end_total - end_us) - (start_total - start_us)
 *   Both are first-differences of published StatCan 12-10-0182-01 monthly
 *   export values by NAPCS sub-chapter. No smoothing; no seasonal adjustment.
 *   Year-over-year snapshot comparison: window_start vs window_end (from meta).
 *   Window advances automatically as StatCan publishes new months.
 *
 * Data: data/processed/sectoral_exports_latest_yoy.csv
 *   100 rows, one per NAPCS sub-chapter.
 *   Columns: napcs_code, napcs_label_en, napcs_classification_code,
 *            start_total, start_us, end_total, end_us,
 *            vector_all, vector_us
 */

import { readFileSync } from "node:fs";
import { resolve } from "node:path";

// ---- CSV parse ---------------------------------------------------------------
interface RawRow {
  code:      number;
  label:     string;
  tot_start: number;
  us_start:  number;
  tot_end:   number;
  us_end:    number;
}

function parseCsv(): RawRow[] {
  const p = resolve(process.cwd(), "data", "processed", "sectoral_exports_latest_yoy.csv");
  let txt: string;
  try {
    txt = readFileSync(p, "utf-8");
  } catch {
    return [];
  }
  const lines = txt.trim().split(/\r?\n/);
  const out: RawRow[] = [];
  for (let i = 1; i < lines.length; i++) {
    const line = lines[i]!;
    // Pattern: code,"label",[class],tot25,us25,tot26,us26,vec,vec
    // or:      code,label,[class],tot25,us25,tot26,us26,vec,vec
    const m = line.match(/^(\d+),\"?([^",]+(?:,[^"]+)?)\"?,\[[^\]]+\],([\d.]+),([\d.]+),([\d.]+),([\d.]+)/);
    if (!m) continue;
    out.push({
      code:      parseInt(m[1]!, 10),
      label:     m[2]!.trim(),
      tot_start: parseFloat(m[3]!),
      us_start:  parseFloat(m[4]!),
      tot_end:   parseFloat(m[5]!),
      us_end:    parseFloat(m[6]!),
    });
  }
  return out;
}

// ---- Derived values ----------------------------------------------------------
interface ScatterDot {
  code:        number;
  label:       string;
  delta_us:    number;  // CAD M
  delta_nonus: number;  // CAD M
  size:        number;  // end_total, CAD M (for radius)
}

const raw = parseCsv();
const dots: ScatterDot[] = raw.map((r) => ({
  code:        r.code,
  label:       r.label,
  delta_us:    r.us_end   - r.us_start,
  delta_nonus: (r.tot_end - r.us_end) - (r.tot_start - r.us_start),
  size:        r.tot_end,
}));

// ---- Labeled sectors ---------------------------------------------------------
const goldDot    = dots.find((d) => d.code === 35)!;
const oilDot     = dots.find((d) => d.label.toLowerCase().includes("crude"))!;
const refinedDot = dots.find((d) => d.code === 19)!;

// ---- Geometry ----------------------------------------------------------------
const VB_W = 720;
const VB_H = 405;

// Margins: left is wider (y-tick labels), bottom wider (x-tick labels).
const M_L = 64;   // y-tick labels live here
const M_R = 110;  // right margin reserves room for size legend
const M_T = 52;   // title + top clearance
const M_B = 40;   // x-tick labels

const PLOT_W = VB_W - M_L - M_R;  // 636
const PLOT_H = VB_H - M_T - M_B;  // 313

// ---- X scale: linear ---------------------------------------------------------
// Apr 2025->Apr 2026 data range: -276 to +2210. Extend to -400 / +2400.
const X_LO = -400;
const X_HI = 2400;

function xPx(v: number): number {
  return M_L + ((v - X_LO) / (X_HI - X_LO)) * PLOT_W;
}

// ---- Y scale: linear ---------------------------------------------------------
// Linear because gold is the editorial story â€” let it dwarf everything else.
// Apr 2025->Apr 2026 range: -261 to +2481 (gold). Pad to -400 / +2800.
const Y_LO = -400;
const Y_HI = 2800;

function yPx(v: number): number {
  return M_T + PLOT_H - ((v - Y_LO) / (Y_HI - Y_LO)) * PLOT_H;
}

// ---- Dot radius: sqrt(size) mapped to [2, 13] --------------------------------
// SQRT_SIZE_MAX anchored to crude oil (NAPCS 13), the largest sector by end_total.
const SQRT_SIZE_MIN = Math.sqrt(2.6);
const SQRT_SIZE_MAX = Math.sqrt(15239);

function dotR(size: number): number {
  const s = Math.sqrt(Math.max(size, 0));
  return 2 + ((s - SQRT_SIZE_MIN) / (SQRT_SIZE_MAX - SQRT_SIZE_MIN)) * 11;
}

// ---- Axis tick definitions ---------------------------------------------------
// Y-axis: linear ticks at 500-CAD-M increments (gold tops at ~2481)
const Y_TICKS_RAW = [0, 500, 1000, 1500, 2000, 2500];

// X-axis: ticks spanning -400 to +2400 (most data is positive; light negative anchor)
const X_TICKS_RAW = [-200, 0, 500, 1000, 1500, 2000];

function fmtAxisNum(v: number): string {
  if (v === 0) return "0";
  const b = v / 1000;
  const sign = b > 0 ? "+" : "";
  return sign + b.toFixed(1).replace(/\.0$/, "") + "B";
}

// ---- Plot-frame coords -------------------------------------------------------
const FRAME_X  = M_L;
const FRAME_Y  = M_T;
const FRAME_W  = PLOT_W;
const FRAME_H  = PLOT_H;

// ---- Zero-line pixel positions -----------------------------------------------
const X_ZERO_PX = xPx(0);
const Y_ZERO_PX = yPx(0);

// ---- Dot pixel positions for labeled sectors --------------------------------
const goldX  = xPx(goldDot.delta_us);
const goldY  = yPx(goldDot.delta_nonus);
const goldR  = dotR(goldDot.size);
const oilX   = xPx(oilDot.delta_us);
const oilY   = yPx(oilDot.delta_nonus);
const oilR   = dotR(oilDot.size);
const refinedX = xPx(refinedDot.delta_us);
const refinedY = yPx(refinedDot.delta_nonus);
const refinedR = dotR(refinedDot.size);
---

<div class="scatter-chart" data-panel="trade-reorientation-scatter">
  <svg
    class="scatter-chart__svg"
    viewBox={`0 0 ${VB_W} ${VB_H}`}
    preserveAspectRatio="xMidYMid meet"
    role="img"
    aria-label={[
      "Scatter chart: Canadian export reorientation by sector, year-over-year.",
      "X-axis: change in exports to the US (CAD millions).",
      "Y-axis: change in exports to non-US markets (CAD billions).",
      `Gold (NAPCS 35): US change ${goldDot.delta_us.toFixed(0)}, non-US change ${goldDot.delta_nonus >= 0 ? "+" : ""}${goldDot.delta_nonus.toFixed(0)}.`,
      `Oil (NAPCS 13): US change ${oilDot.delta_us.toFixed(0)}, non-US change ${oilDot.delta_nonus >= 0 ? "+" : ""}${oilDot.delta_nonus.toFixed(0)}.`,
      `Refined petroleum (NAPCS 19): US change +${refinedDot.delta_us.toFixed(0)}, non-US change +${refinedDot.delta_nonus.toFixed(0)}.`,
    ].join(" ")}
  >

    {/* ---- Chart title ------------------------------------------------------ */}
    <text
      class="scatter-chart__title"
      x={M_L + PLOT_W / 2}
      y={M_T - 30}
      text-anchor="middle"
    >CHANGE IN EXPORTS, APRIL 2025 TO 2026</text>

    {/* ---- Y-axis label (vertical, left of plot) â€” unit descriptor ----------- */}
    <text
      class="scatter-chart__axis-descriptor"
      x={M_L - 52}
      y={M_T + PLOT_H / 2}
      text-anchor="middle"
      transform={`rotate(-90, ${M_L - 52}, ${M_T + PLOT_H / 2})`}
    >Î” NON-US EXPORTS (CAD)</text>

    {/* ---- X-axis label (horizontal, below plot) â€” unit descriptor ----------- */}
    <text
      class="scatter-chart__axis-descriptor"
      x={M_L + PLOT_W / 2}
      y={M_T + PLOT_H + 36}
      text-anchor="middle"
    >Î” US EXPORTS (CAD)</text>

    {/* ---- Plot frame â€” 1px pure ink hairline -------------------------------- */}
    <rect
      class="scatter-chart__frame"
      x={FRAME_X}
      y={FRAME_Y}
      width={FRAME_W}
      height={FRAME_H}
      fill="none"
    />

    {/* ---- Regular horizontal gridlines (non-zero) --------------------------- */}
    {Y_TICKS_RAW.filter((t) => t !== 0).map((t) => (
      <line
        class="scatter-chart__gridline"
        x1={M_L}
        y1={yPx(t).toFixed(2)}
        x2={M_L + PLOT_W}
        y2={yPx(t).toFixed(2)}
      />
    ))}

    {/* ---- Regular vertical gridlines (non-zero) ----------------------------- */}
    {X_TICKS_RAW.filter((t) => t !== 0).map((t) => (
      <line
        class="scatter-chart__gridline scatter-chart__gridline--vert"
        x1={xPx(t).toFixed(2)}
        y1={M_T}
        x2={xPx(t).toFixed(2)}
        y2={M_T + PLOT_H}
      />
    ))}

    {/* ---- Zero gridlines (heavier) ----------------------------------------- */}
    {/* Horizontal zero (delta_nonus = 0) */}
    <line
      class="scatter-chart__zero-line"
      x1={M_L}
      y1={Y_ZERO_PX.toFixed(2)}
      x2={M_L + PLOT_W}
      y2={Y_ZERO_PX.toFixed(2)}
    />
    {/* Vertical zero (delta_us = 0) */}
    <line
      class="scatter-chart__zero-line scatter-chart__zero-line--vert"
      x1={X_ZERO_PX.toFixed(2)}
      y1={M_T}
      x2={X_ZERO_PX.toFixed(2)}
      y2={M_T + PLOT_H}
    />

    {/* ---- Y-axis tick labels ----------------------------------------------- */}
    {Y_TICKS_RAW.map((t, i) => (
      <text
        class="scatter-chart__ytick-label"
        x={M_L - 6}
        y={(yPx(t) + 4).toFixed(2)}
        text-anchor="end"
      >
        {fmtAxisNum(t)}
      </text>
    ))}

    {/* ---- X-axis tick labels ----------------------------------------------- */}
    {X_TICKS_RAW.map((t, i) => (
      <text
        class="scatter-chart__xtick-label"
        x={xPx(t).toFixed(2)}
        y={(M_T + PLOT_H + 16).toFixed(2)}
        text-anchor="middle"
      >
        {fmtAxisNum(t)}
      </text>
    ))}

    {/* ---- Scatter dots â€” all non-labeled sectors first ---------------------- */}
    {dots
      .filter((d) => ![35, 13, 19].includes(d.code))
      .map((d) => {
        const cx = xPx(d.delta_us);
        const cy = yPx(d.delta_nonus);
        const r  = dotR(d.size);
        // clip to plot area (any dot outside gets clamped; shouldn't happen)
        if (cx < M_L - r || cx > M_L + PLOT_W + r) return null;
        if (cy < M_T - r || cy > M_T + PLOT_H + r) return null;
        return (
          <circle
            class="scatter-chart__dot"
            cx={cx.toFixed(2)}
            cy={cy.toFixed(2)}
            r={r.toFixed(2)}
          >
          </circle>
        );
      })}

    {/* ---- Labeled sector dots (painted last = on top) ----------------------- */}

    {/* Oil */}
    <circle
      class="scatter-chart__dot scatter-chart__dot--labeled"
      cx={oilX.toFixed(2)}
      cy={oilY.toFixed(2)}
      r={oilR.toFixed(2)}
    >
    </circle>
    <text
      class="scatter-chart__dot-label"
      x={(oilX + oilR + 5).toFixed(2)}
      y={(oilY - 5).toFixed(2)}
      text-anchor="start"
    >Oil</text>

    {/* Refined petroleum */}
    <circle
      class="scatter-chart__dot scatter-chart__dot--labeled"
      cx={refinedX.toFixed(2)}
      cy={refinedY.toFixed(2)}
      r={refinedR.toFixed(2)}
    >
    </circle>
    <text
      class="scatter-chart__dot-label"
      x={(refinedX + refinedR + 5).toFixed(2)}
      y={(refinedY - 5).toFixed(2)}
      text-anchor="start"
    >Refined petroleum</text>

    {/* Gold â€” MTA red, the editorial outlier */}
    <circle
      class="scatter-chart__dot scatter-chart__dot--labeled"
      cx={goldX.toFixed(2)}
      cy={goldY.toFixed(2)}
      r={goldR.toFixed(2)}
      style="stroke:#E63946; fill:#E63946; fill-opacity:0.22"
    >
    </circle>
    <text
      class="scatter-chart__dot-label"
      x={(goldX + goldR + 5).toFixed(2)}
      y={(goldY + 4).toFixed(2)}
      text-anchor="start"
    >Gold</text>

    {/* ---- Axis-orienting phrases ------------------------------------------- */}
    {/* "Sold more to the US" â€” lower-right, along the positive x-axis */}
    <text
      class="scatter-chart__orient-phrase"
      x={(FRAME_X + FRAME_W - 10).toFixed(2)}
      y={(Y_ZERO_PX + 22).toFixed(2)}
      text-anchor="end"
    >Sold more to the US</text>

    {/* "Sold more to non-US markets" â€” upper-left interior, clear of the top frame */}
    <text
      class="scatter-chart__orient-phrase"
      x={(X_ZERO_PX + 8).toFixed(2)}
      y={(M_T + 14).toFixed(2)}
      text-anchor="start"
    >Sold more to non-US markets</text>

    {/* ---- Size legend (right margin) ----------------------------------- */}
    {(() => {
      const LEG_X     = M_L + PLOT_W + 30;    // circle center x
      const LEG_Y0    = M_T + 12;             // header y
      const LEG_LBL_X = LEG_X + 18;           // label x, right of circles
      const refs = [
        { size: 10000, label: "$10B" },
        { size: 1000,  label: "$1B"  },
        { size: 100,   label: "$100M" },
      ];
      // Stack circles bottom-aligned to the largest at top, with vertical
      // gaps tuned for visual separation across the radius range.
      let cy = LEG_Y0 + 26;
      return (
        <g class="scatter-chart__size-legend">
          <text
            class="scatter-chart__legend-header"
            x={LEG_X - 12}
            y={LEG_Y0}
            text-anchor="start"
          >Total exports</text>
          {refs.map((ref) => {
            const r = dotR(ref.size);
            const y = cy;
            cy += Math.max(r * 2 + 8, 22);
            return (
              <g>
                <circle
                  class="scatter-chart__dot"
                  cx={LEG_X.toFixed(2)}
                  cy={y.toFixed(2)}
                  r={r.toFixed(2)}
                />
                <text
                  class="scatter-chart__legend-label"
                  x={LEG_LBL_X.toFixed(2)}
                  y={(y + 4).toFixed(2)}
                  text-anchor="start"
                >{ref.label}</text>
              </g>
            );
          })}
        </g>
      );
    })()}

  </svg>
</div>

<style>
  /*
   * PanelTradeReorientationScatter â€” Vignelli scatter plot.
   * No MTA red on data points (every point is a "latest" observation).
   * Pure ink stroke + 0.18 fill-opacity per project brief.
   */

  .scatter-chart {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: var(--paper, #fff);
    overflow: visible;
  }

  .scatter-chart__svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    font-family: var(--font-sans, 'Manrope', sans-serif);
  }

  /* Chart title â€” Manrope 600, 12px micro-caps */
  .scatter-chart__title {
    fill: var(--ink, #000);
    font-family: var(--font-sans, 'Manrope', sans-serif);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.10em;
    text-transform: uppercase;
  }

  /* Axis descriptor â€” Manrope 600, 10px micro-caps, ink-faint */
  .scatter-chart__axis-descriptor {
    fill: var(--ink-faint, #555);
    font-family: var(--font-sans, 'Manrope', sans-serif);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.10em;
    text-transform: uppercase;
  }

  /* Plot frame â€” 1px pure ink hairline */
  .scatter-chart__frame {
    stroke: var(--ink, #000);
    stroke-width: 1;
    shape-rendering: crispEdges;
  }

  /* Regular gridlines â€” 1px pure ink, 0.18 opacity */
  .scatter-chart__gridline {
    stroke: var(--ink, #000);
    stroke-width: 1;
    stroke-opacity: 0.18;
    shape-rendering: crispEdges;
  }

  /* Zero lines â€” heavier, 0.4 opacity */
  .scatter-chart__zero-line {
    stroke: var(--ink, #000);
    stroke-width: 1;
    stroke-opacity: 0.4;
    shape-rendering: crispEdges;
  }

  /* Y-axis tick labels â€” IBM Plex Mono 400, 11px, ink-faint */
  .scatter-chart__ytick-label {
    fill: var(--ink-faint, #555);
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 11px;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }

  /* X-axis tick labels â€” IBM Plex Mono 400, 11px, ink-faint */
  .scatter-chart__xtick-label {
    fill: var(--ink-faint, #555);
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 11px;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }

  /* Scatter dots â€” thin ring + high-transparency fill, pure ink */
  .scatter-chart__dot {
    stroke: var(--ink, #000);
    stroke-width: 1;
    fill: var(--ink, #000);
    fill-opacity: 0.18;
  }

  /* Labeled dots â€” slightly more prominent stroke */
  .scatter-chart__dot--labeled {
    stroke-width: 1.25;
    fill-opacity: 0.22;
  }

  /* Sector label â€” Manrope 600, 12px, pure ink */
  .scatter-chart__dot-label {
    fill: var(--ink, #000);
    font-family: var(--font-sans, 'Manrope', sans-serif);
    font-size: 12px;
    font-weight: 600;
  }

  /* Axis-orienting phrases â€” Manrope 400, 11px, italic, ink-faint */
  .scatter-chart__orient-phrase {
    fill: var(--ink-faint, #555);
    font-family: var(--font-sans, 'Manrope', sans-serif);
    font-size: 11px;
    font-weight: 400;
    font-style: italic;
  }

  /* Signed-sqrt scale note â€” IBM Plex Mono 400, 10px, ink-faint */
  .scatter-chart__legend-header {
    fill: var(--ink, #000);
    font-family: var(--font-sans, 'Manrope', sans-serif);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .scatter-chart__legend-label {
    fill: var(--ink-faint, #555);
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 10px;
    font-weight: 400;
  }
</style>
