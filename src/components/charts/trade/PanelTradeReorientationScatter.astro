---
/*
 * PanelTradeReorientationScatter — "Export reorientation: Mar 2025 to Mar 2026"
 *
 * Chart type: Scatter plot, 720x405 (16:9).
 *
 * Each dot is one NAPCS sub-chapter (100 sectors).
 *   X-axis (linear):       delta_us   = mar2026_us   - mar2025_us   (CAD M)
 *   Y-axis (signed-sqrt):  delta_nonus = (mar2026_total - mar2026_us) -
 *                                        (mar2025_total - mar2025_us)  (CAD M)
 *   Dot area:              sqrt(mar2026_total), mapped to r=[2,13]px
 *
 * Y-axis uses signed-sqrt transform: y = sign(v) * sqrt(|v|) * K.
 * Gold's delta_nonus is +4,784 (CAD M); the next-largest is +816 (oil).
 * A linear y-axis would crush the entire cluster into an unreadable band.
 * Signed-sqrt preserves sign and zero while compressing the outlier.
 * Tick labels carry the original CAD-M values; the transform is
 * transparent to the reader.
 *
 * Labeled sectors (4):
 *   Gold  — NAPCS 35 (unwrought gold/silver/platinum)
 *   Oil   — NAPCS 13 (crude oil and bitumen)
 *   Gas   — NAPCS 14 (natural gas)
 *   Cars  — NAPCS 81 (passenger cars and light trucks)
 *
 * Axis-orienting phrases (replace axis titles):
 *   "Sold less to the US"            — near Cars (most negative delta_us)
 *   "Sold more to non-US markets"    — near Gold (most positive delta_nonus)
 *
 * Quadrant reading:
 *   Top-left:     real pivot    (lost US, gained non-US)
 *   Top-right:    grew both     (gained US + non-US)
 *   Bottom-right: concentrated  (gained US, lost non-US)
 *   Bottom-left:  shrinking     (lost both)
 *
 * Canon compliance (design/canon_reference_panel.md + design/design-system.md v1.0):
 *   - Dots: 1px pure ink stroke, fill-opacity 0.18. No MTA red on points.
 *   - Zero gridlines: 1px pure ink, opacity 0.4 (heavier than regular gridlines 0.18).
 *   - Regular gridlines: 1px pure ink, opacity 0.18.
 *   - 1px pure ink hairline plot frame.
 *   - Title: Manrope 600, 12px, micro-caps, letter-spacing 0.10em.
 *   - Tick labels: IBM Plex Mono 400, 11px, ink-faint.
 *   - Dot labels: Manrope 600, 12px, pure ink.
 *   - Orienting phrases: Manrope 400 italic, 11px, ink-faint.
 *   - viewBox 720x405. No client JS.
 *
 * Methodology note (direct derivation, no external source beyond StatCan):
 *   delta_us    = mar2026_us - mar2025_us
 *   delta_nonus = (mar2026_total - mar2026_us) - (mar2025_total - mar2025_us)
 *   Both are first-differences of published StatCan 12-10-0182-01 monthly
 *   export values by NAPCS sub-chapter. No smoothing; no seasonal adjustment.
 *   Year-over-year snapshot comparison: March 2025 vs March 2026.
 *
 * Data: data/processed/sectoral_exports_mar_to_mar.csv
 *   100 rows, one per NAPCS sub-chapter.
 *   Columns: napcs_code, napcs_label_en, napcs_classification_code,
 *            mar2025_total, mar2025_us, mar2026_total, mar2026_us,
 *            vector_all, vector_us
 */

import { readFileSync } from "node:fs";
import { resolve } from "node:path";

// ---- CSV parse ---------------------------------------------------------------
interface RawRow {
  code: number;
  label: string;
  tot25: number;
  us25:  number;
  tot26: number;
  us26:  number;
}

function parseCsv(): RawRow[] {
  const p = resolve(process.cwd(), "data", "processed", "sectoral_exports_mar_to_mar.csv");
  let txt: string;
  try {
    txt = readFileSync(p, "utf-8");
  } catch {
    return [];
  }
  const lines = txt.trim().split(/\r?\n/);
  const out: RawRow[] = [];
  for (let i = 1; i < lines.length; i++) {
    const line = lines[i]!;
    // Pattern: code,"label",[class],tot25,us25,tot26,us26,vec,vec
    // or:      code,label,[class],tot25,us25,tot26,us26,vec,vec
    const m = line.match(/^(\d+),\"?([^",]+(?:,[^"]+)?)\"?,\[[^\]]+\],([\d.]+),([\d.]+),([\d.]+),([\d.]+)/);
    if (!m) continue;
    out.push({
      code:  parseInt(m[1]!, 10),
      label: m[2]!.trim(),
      tot25: parseFloat(m[3]!),
      us25:  parseFloat(m[4]!),
      tot26: parseFloat(m[5]!),
      us26:  parseFloat(m[6]!),
    });
  }
  return out;
}

// ---- Derived values ----------------------------------------------------------
interface ScatterDot {
  code:        number;
  label:       string;
  delta_us:    number;  // CAD M
  delta_nonus: number;  // CAD M
  size:        number;  // mar2026_total, CAD M (for radius)
}

const raw = parseCsv();
const dots: ScatterDot[] = raw.map((r) => ({
  code:        r.code,
  label:       r.label,
  delta_us:    r.us26  - r.us25,
  delta_nonus: (r.tot26 - r.us26) - (r.tot25 - r.us25),
  size:        r.tot26,
}));

// ---- Labeled sectors ---------------------------------------------------------
const goldDot  = dots.find((d) => d.code === 35)!;
const oilDot   = dots.find((d) => d.label.toLowerCase().includes("crude"))!;
const gasDot   = dots.find(
  (d) => d.label.toLowerCase().includes("natural gas") &&
         !d.label.toLowerCase().includes("liquid")
)!;
const carsDot  = dots.find((d) => d.code === 81)!;

// ---- Geometry ----------------------------------------------------------------
const VB_W = 720;
const VB_H = 405;

// Margins: left is wider (y-tick labels), bottom wider (x-tick labels).
const M_L = 64;   // y-tick labels live here
const M_R = 110;  // right margin reserves room for size legend
const M_T = 52;   // title + top clearance
const M_B = 40;   // x-tick labels

const PLOT_W = VB_W - M_L - M_R;  // 636
const PLOT_H = VB_H - M_T - M_B;  // 313

// ---- X scale: linear ---------------------------------------------------------
// Data range: -1247 to +589. Extend to -1400 / +700 for headroom.
const X_LO = -1400;
const X_HI =  700;

function xPx(v: number): number {
  return M_L + ((v - X_LO) / (X_HI - X_LO)) * PLOT_W;
}

// ---- Y scale: linear ---------------------------------------------------------
// Linear because gold is the editorial story — let it dwarf everything else.
// Range fits data with light padding: -400 to +5200 (gold ~4784).
const Y_LO = -400;
const Y_HI = 5200;

function yPx(v: number): number {
  return M_T + PLOT_H - ((v - Y_LO) / (Y_HI - Y_LO)) * PLOT_H;
}

// ---- Dot radius: sqrt(size) mapped to [2, 13] --------------------------------
const SQRT_SIZE_MIN = Math.sqrt(2.6);
const SQRT_SIZE_MAX = Math.sqrt(12761);

function dotR(size: number): number {
  const s = Math.sqrt(Math.max(size, 0));
  return 2 + ((s - SQRT_SIZE_MIN) / (SQRT_SIZE_MAX - SQRT_SIZE_MIN)) * 11;
}

// ---- Axis tick definitions ---------------------------------------------------
// Y-axis: linear ticks at 1000-CAD-M increments
const Y_TICKS_RAW = [0, 1000, 2000, 3000, 4000, 5000];

// X-axis: evenly spaced linear ticks
const X_TICKS_RAW = [-1200, -800, -400, 0, 400];

function fmtAxisNum(v: number): string {
  if (v === 0) return "0";
  const b = v / 1000;
  const sign = b > 0 ? "+" : "";
  return sign + b.toFixed(1).replace(/\.0$/, "") + "B";
}

// ---- Plot-frame coords -------------------------------------------------------
const FRAME_X  = M_L;
const FRAME_Y  = M_T;
const FRAME_W  = PLOT_W;
const FRAME_H  = PLOT_H;

// ---- Zero-line pixel positions -----------------------------------------------
const X_ZERO_PX = xPx(0);
const Y_ZERO_PX = yPx(0);

// ---- Dot pixel positions for labeled sectors --------------------------------
const goldX  = xPx(goldDot.delta_us);
const goldY  = yPx(goldDot.delta_nonus);
const goldR  = dotR(goldDot.size);
const oilX   = xPx(oilDot.delta_us);
const oilY   = yPx(oilDot.delta_nonus);
const oilR   = dotR(oilDot.size);
const gasX   = xPx(gasDot.delta_us);
const gasY   = yPx(gasDot.delta_nonus);
const gasR   = dotR(gasDot.size);
const carsX  = xPx(carsDot.delta_us);
const carsY  = yPx(carsDot.delta_nonus);
const carsR  = dotR(carsDot.size);
---

<div class="scatter-chart" data-panel="trade-reorientation-scatter">
  <svg
    class="scatter-chart__svg"
    viewBox={`0 0 ${VB_W} ${VB_H}`}
    preserveAspectRatio="xMidYMid meet"
    role="img"
    aria-label={[
      "Scatter chart: Canadian export reorientation by sector, March 2025 to March 2026.",
      "X-axis: change in exports to the US (CAD millions).",
      "Y-axis: change in exports to non-US markets (CAD billions).",
      `Gold (NAPCS 35): US change ${goldDot.delta_us.toFixed(0)}, non-US change +${goldDot.delta_nonus.toFixed(0)}.`,
      `Oil (NAPCS 13): US change ${oilDot.delta_us.toFixed(0)}, non-US change +${oilDot.delta_nonus.toFixed(0)}.`,
      `Natural gas (NAPCS 14): US change +${gasDot.delta_us.toFixed(0)}, non-US change ${gasDot.delta_nonus.toFixed(0)}.`,
      `Cars (NAPCS 81): US change ${carsDot.delta_us.toFixed(0)}, non-US change +${carsDot.delta_nonus.toFixed(0)}.`,
    ].join(" ")}
  >

    {/* ---- Chart title ------------------------------------------------------ */}
    <text
      class="scatter-chart__title"
      x={M_L + PLOT_W / 2}
      y={M_T - 30}
      text-anchor="middle"
    >CHANGE IN EXPORTS, MARCH 2025 TO 2026</text>

    {/* ---- Y-axis label (vertical, left of plot) — unit descriptor ----------- */}
    <text
      class="scatter-chart__axis-descriptor"
      x={M_L - 52}
      y={M_T + PLOT_H / 2}
      text-anchor="middle"
      transform={`rotate(-90, ${M_L - 52}, ${M_T + PLOT_H / 2})`}
    >Δ NON-US EXPORTS (CAD)</text>

    {/* ---- X-axis label (horizontal, below plot) — unit descriptor ----------- */}
    <text
      class="scatter-chart__axis-descriptor"
      x={M_L + PLOT_W / 2}
      y={M_T + PLOT_H + 36}
      text-anchor="middle"
    >Δ US EXPORTS (CAD)</text>

    {/* ---- Plot frame — 1px pure ink hairline -------------------------------- */}
    <rect
      class="scatter-chart__frame"
      x={FRAME_X}
      y={FRAME_Y}
      width={FRAME_W}
      height={FRAME_H}
      fill="none"
    />

    {/* ---- Regular horizontal gridlines (non-zero) --------------------------- */}
    {Y_TICKS_RAW.filter((t) => t !== 0).map((t) => (
      <line
        class="scatter-chart__gridline"
        x1={M_L}
        y1={yPx(t).toFixed(2)}
        x2={M_L + PLOT_W}
        y2={yPx(t).toFixed(2)}
      />
    ))}

    {/* ---- Regular vertical gridlines (non-zero) ----------------------------- */}
    {X_TICKS_RAW.filter((t) => t !== 0).map((t) => (
      <line
        class="scatter-chart__gridline scatter-chart__gridline--vert"
        x1={xPx(t).toFixed(2)}
        y1={M_T}
        x2={xPx(t).toFixed(2)}
        y2={M_T + PLOT_H}
      />
    ))}

    {/* ---- Zero gridlines (heavier) ----------------------------------------- */}
    {/* Horizontal zero (delta_nonus = 0) */}
    <line
      class="scatter-chart__zero-line"
      x1={M_L}
      y1={Y_ZERO_PX.toFixed(2)}
      x2={M_L + PLOT_W}
      y2={Y_ZERO_PX.toFixed(2)}
    />
    {/* Vertical zero (delta_us = 0) */}
    <line
      class="scatter-chart__zero-line scatter-chart__zero-line--vert"
      x1={X_ZERO_PX.toFixed(2)}
      y1={M_T}
      x2={X_ZERO_PX.toFixed(2)}
      y2={M_T + PLOT_H}
    />

    {/* ---- Y-axis tick labels ----------------------------------------------- */}
    {Y_TICKS_RAW.map((t, i) => (
      <text
        class="scatter-chart__ytick-label"
        x={M_L - 6}
        y={(yPx(t) + 4).toFixed(2)}
        text-anchor="end"
      >
        {fmtAxisNum(t)}
      </text>
    ))}

    {/* ---- X-axis tick labels ----------------------------------------------- */}
    {X_TICKS_RAW.map((t, i) => (
      <text
        class="scatter-chart__xtick-label"
        x={xPx(t).toFixed(2)}
        y={(M_T + PLOT_H + 16).toFixed(2)}
        text-anchor="middle"
      >
        {fmtAxisNum(t)}
      </text>
    ))}

    {/* ---- Scatter dots — all non-labeled sectors first ---------------------- */}
    {dots
      .filter((d) => ![35, 13, 14, 81].includes(d.code))
      .map((d) => {
        const cx = xPx(d.delta_us);
        const cy = yPx(d.delta_nonus);
        const r  = dotR(d.size);
        // clip to plot area (any dot outside gets clamped; shouldn't happen)
        if (cx < M_L - r || cx > M_L + PLOT_W + r) return null;
        if (cy < M_T - r || cy > M_T + PLOT_H + r) return null;
        return (
          <circle
            class="scatter-chart__dot"
            cx={cx.toFixed(2)}
            cy={cy.toFixed(2)}
            r={r.toFixed(2)}
          >
            <title>{`${d.label}: US change ${d.delta_us >= 0 ? "+" : ""}${d.delta_us.toFixed(0)} CAD M, non-US change ${d.delta_nonus >= 0 ? "+" : ""}${d.delta_nonus.toFixed(0)} CAD M`}</title>
          </circle>
        );
      })}

    {/* ---- Labeled sector dots (painted last = on top) ----------------------- */}

    {/* Oil */}
    <circle
      class="scatter-chart__dot scatter-chart__dot--labeled"
      cx={oilX.toFixed(2)}
      cy={oilY.toFixed(2)}
      r={oilR.toFixed(2)}
    >
      <title>{`Crude oil and bitumen (NAPCS 13): US change ${oilDot.delta_us.toFixed(0)} CAD M, non-US change +${oilDot.delta_nonus.toFixed(0)} CAD M`}</title>
    </circle>
    <text
      class="scatter-chart__dot-label"
      x={(oilX + oilR + 5).toFixed(2)}
      y={(oilY - 5).toFixed(2)}
      text-anchor="start"
    >Oil</text>

    {/* Gas */}
    <circle
      class="scatter-chart__dot scatter-chart__dot--labeled"
      cx={gasX.toFixed(2)}
      cy={gasY.toFixed(2)}
      r={gasR.toFixed(2)}
    >
      <title>{`Natural gas (NAPCS 14): US change +${gasDot.delta_us.toFixed(0)} CAD M, non-US change ${gasDot.delta_nonus.toFixed(0)} CAD M`}</title>
    </circle>
    <text
      class="scatter-chart__dot-label"
      x={gasX.toFixed(2)}
      y={(gasY - gasR - 6).toFixed(2)}
      text-anchor="middle"
    >Gas</text>

    {/* Cars */}
    <circle
      class="scatter-chart__dot scatter-chart__dot--labeled"
      cx={carsX.toFixed(2)}
      cy={carsY.toFixed(2)}
      r={carsR.toFixed(2)}
    >
      <title>{`Passenger cars and light trucks (NAPCS 81): US change ${carsDot.delta_us.toFixed(0)} CAD M, non-US change +${carsDot.delta_nonus.toFixed(0)} CAD M`}</title>
    </circle>
    <text
      class="scatter-chart__dot-label"
      x={(carsX + carsR + 5).toFixed(2)}
      y={(carsY).toFixed(2)}
      text-anchor="start"
    >Cars</text>

    {/* Gold — MTA red, the editorial outlier */}
    <circle
      class="scatter-chart__dot scatter-chart__dot--labeled"
      cx={goldX.toFixed(2)}
      cy={goldY.toFixed(2)}
      r={goldR.toFixed(2)}
      style="stroke:#E63946; fill:#E63946; fill-opacity:0.22"
    >
      <title>{`Unwrought gold, silver, and platinum (NAPCS 35): US change ${goldDot.delta_us.toFixed(0)} CAD M, non-US change +${goldDot.delta_nonus.toFixed(0)} CAD M`}</title>
    </circle>
    <text
      class="scatter-chart__dot-label"
      x={(goldX + goldR + 5).toFixed(2)}
      y={(goldY + 4).toFixed(2)}
      text-anchor="start"
    >Gold</text>

    {/* ---- Axis-orienting phrases ------------------------------------------- */}
    {/* "Sold less to the US" — near Cars */}
    <text
      class="scatter-chart__orient-phrase"
      x={(carsX + 2).toFixed(2)}
      y={(carsY + carsR + 12).toFixed(2)}
      text-anchor="start"
    >Sold less to the US</text>

    {/* "Sold more to non-US markets" — near Gold, lifted further from grid */}
    <text
      class="scatter-chart__orient-phrase"
      x={(goldX + goldR + 5).toFixed(2)}
      y={(goldY - goldR - 20).toFixed(2)}
      text-anchor="start"
    >Sold more to non-US markets</text>

    {/* ---- Size legend (right margin) ----------------------------------- */}
    {(() => {
      const LEG_X     = M_L + PLOT_W + 30;    // circle center x
      const LEG_Y0    = M_T + 12;             // header y
      const LEG_LBL_X = LEG_X + 18;           // label x, right of circles
      const refs = [
        { size: 10000, label: "$10B" },
        { size: 1000,  label: "$1B"  },
        { size: 100,   label: "$100M" },
      ];
      // Stack circles bottom-aligned to the largest at top, with vertical
      // gaps tuned for visual separation across the radius range.
      let cy = LEG_Y0 + 26;
      return (
        <g class="scatter-chart__size-legend">
          <text
            class="scatter-chart__legend-header"
            x={LEG_X - 12}
            y={LEG_Y0}
            text-anchor="start"
          >Total exports</text>
          {refs.map((ref) => {
            const r = dotR(ref.size);
            const y = cy;
            cy += Math.max(r * 2 + 8, 22);
            return (
              <g>
                <circle
                  class="scatter-chart__dot"
                  cx={LEG_X.toFixed(2)}
                  cy={y.toFixed(2)}
                  r={r.toFixed(2)}
                />
                <text
                  class="scatter-chart__legend-label"
                  x={LEG_LBL_X.toFixed(2)}
                  y={(y + 4).toFixed(2)}
                  text-anchor="start"
                >{ref.label}</text>
              </g>
            );
          })}
        </g>
      );
    })()}

  </svg>
</div>

<style>
  /*
   * PanelTradeReorientationScatter — Vignelli scatter plot.
   * No MTA red on data points (every point is a "latest" observation).
   * Pure ink stroke + 0.18 fill-opacity per project brief.
   */

  .scatter-chart {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: var(--paper, #fff);
    overflow: visible;
  }

  .scatter-chart__svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    font-family: var(--font-sans, 'Manrope', sans-serif);
  }

  /* Chart title — Manrope 600, 12px micro-caps */
  .scatter-chart__title {
    fill: var(--ink, #000);
    font-family: var(--font-sans, 'Manrope', sans-serif);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.10em;
    text-transform: uppercase;
  }

  /* Axis descriptor — Manrope 600, 10px micro-caps, ink-faint */
  .scatter-chart__axis-descriptor {
    fill: var(--ink-faint, #555);
    font-family: var(--font-sans, 'Manrope', sans-serif);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.10em;
    text-transform: uppercase;
  }

  /* Plot frame — 1px pure ink hairline */
  .scatter-chart__frame {
    stroke: var(--ink, #000);
    stroke-width: 1;
    shape-rendering: crispEdges;
  }

  /* Regular gridlines — 1px pure ink, 0.18 opacity */
  .scatter-chart__gridline {
    stroke: var(--ink, #000);
    stroke-width: 1;
    stroke-opacity: 0.18;
    shape-rendering: crispEdges;
  }

  /* Zero lines — heavier, 0.4 opacity */
  .scatter-chart__zero-line {
    stroke: var(--ink, #000);
    stroke-width: 1;
    stroke-opacity: 0.4;
    shape-rendering: crispEdges;
  }

  /* Y-axis tick labels — IBM Plex Mono 400, 11px, ink-faint */
  .scatter-chart__ytick-label {
    fill: var(--ink-faint, #555);
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 11px;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }

  /* X-axis tick labels — IBM Plex Mono 400, 11px, ink-faint */
  .scatter-chart__xtick-label {
    fill: var(--ink-faint, #555);
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 11px;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }

  /* Scatter dots — thin ring + high-transparency fill, pure ink */
  .scatter-chart__dot {
    stroke: var(--ink, #000);
    stroke-width: 1;
    fill: var(--ink, #000);
    fill-opacity: 0.18;
  }

  /* Labeled dots — slightly more prominent stroke */
  .scatter-chart__dot--labeled {
    stroke-width: 1.25;
    fill-opacity: 0.22;
  }

  /* Sector label — Manrope 600, 12px, pure ink */
  .scatter-chart__dot-label {
    fill: var(--ink, #000);
    font-family: var(--font-sans, 'Manrope', sans-serif);
    font-size: 12px;
    font-weight: 600;
  }

  /* Axis-orienting phrases — Manrope 400, 11px, italic, ink-faint */
  .scatter-chart__orient-phrase {
    fill: var(--ink-faint, #555);
    font-family: var(--font-sans, 'Manrope', sans-serif);
    font-size: 11px;
    font-weight: 400;
    font-style: italic;
  }

  /* Signed-sqrt scale note — IBM Plex Mono 400, 10px, ink-faint */
  .scatter-chart__legend-header {
    fill: var(--ink, #000);
    font-family: var(--font-sans, 'Manrope', sans-serif);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .scatter-chart__legend-label {
    fill: var(--ink-faint, #555);
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 10px;
    font-weight: 400;
  }
</style>
