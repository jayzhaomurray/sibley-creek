---
/*
 * PanelSectorPivot — "US share of sector exports: May 2025 → May 2026"
 *
 * Chart type: Slopegraph (Tufte two-snapshot ranking-change form).
 * Two columns: MAY 2025 (left) and MAY 2026 (right).
 * Each sector is one slope-line connecting its share at each snapshot.
 * Downward slope = diversification away from US.
 * Upward slope   = concentration toward US.
 *
 * Metric: US share of total sector exports
 *   = exports_<sector>_us[t] / (exports_<sector>_us[t] + exports_<sector>_nonus[t]) × 100
 *
 * Sectors: steel, aluminum, softwood, autos (Section 232 tariffed).
 * Copper: code path present; picks up automatically when
 *   data/processed/exports_copper_us.csv + exports_copper_nonus.csv land on disk.
 *
 * Sort order: by Δ US share (May 2025 → May 2026), ascending (biggest
 *   diversifiers on top, concentrators on bottom).
 *
 * Visual canon (design/design-system.md v1.0):
 *   - Aluminum (editorial outlier): MTA red (#E63946) slope line, both dots,
 *     percent values, and sector label.
 *   - All other sectors: pure ink (#000) throughout.
 *   - 1.5px slope line per sector.
 *   - 4px dots at each end.
 *   - Left of left dot: May 2025 % value, text-anchor="end"
 *   - Right of right dot: May 2026 % value, then sector label, text-anchor="start"
 *   - Column headers "MAY 2025" / "MAY 2026" in Manrope micro-caps above columns
 *   - Two vertical reference lines (the column spines)
 *   - No gridlines, no legend, no caption, no JS
 *
 * viewBox: 720×405
 *
 * Data source: data/processed/ CSVs
 *   exports_steel_us.csv / exports_steel_nonus.csv
 *   exports_aluminum_us.csv / exports_aluminum_nonus.csv
 *   exports_softwood_us.csv / exports_softwood_nonus.csv
 *   exports_autos_us.csv / exports_autos_nonus.csv
 *   (exports_copper_us.csv / exports_copper_nonus.csv — picked up when present)
 * Monthly NSA, CAD millions. Source: StatCan Table 12-10-0182-01.
 *
 * Canon compliance (design/canon_reference_panel.md):
 *   1. Lines: 1.5px solid. Aluminum = MTA red; all others = pure ink.
 *   2. Both dots per sector: Aluminum = MTA red; all others = pure ink.
 *   3. Left % value: same color as line. text-anchor="end", left of left dot.
 *   4. Right % value: same color as line. text-anchor="start", right of right dot.
 *   5. Sector label: same color as line. text-anchor="start", right of right % value.
 *   6. No Δpp annotations.
 *   7. No color encoding of direction on non-Aluminum sectors.
 *   8. Column headers: Manrope 600 11px micro-caps, centered above each column.
 *   9. Column spine: 1px pure ink hairline rule (the two vertical guides).
 *  10. No legend. No client JS.
 *  11. Native SVG <title> on every data dot.
 *  12. viewBox 720×405.
 *  13. aria-label describes the chart.
 */

import { readFileSync } from "node:fs";
import { resolve } from "node:path";

// ---- CSV reader ---------------------------------------------------------------
interface RawPoint { date: string; value: number }

function readProcessedCsv(slug: string): RawPoint[] {
  const p = resolve(process.cwd(), "data", "processed", `${slug}.csv`);
  let txt: string;
  try {
    txt = readFileSync(p, "utf-8");
  } catch {
    return [];
  }
  const lines = txt.split(/\r?\n/).filter((l) => l.length > 0);
  const out: RawPoint[] = [];
  for (let i = 1; i < lines.length; i++) {
    const line = lines[i]!;
    const idx = line.indexOf(",");
    if (idx < 0) continue;
    const date = line.slice(0, idx).trim();
    const raw  = line.slice(idx + 1).trim();
    if (!date) continue;
    const v = raw === "" || raw === "NA" || raw === "null" ? null : Number(raw);
    if (typeof v === "number" && !Number.isNaN(v) && v !== null) {
      out.push({ date, value: v });
    }
  }
  return out;
}

// ---- Pull a single month value from a series ---------------------------------
function monthValue(pts: RawPoint[], datePrefix: string): number | null {
  const hit = pts.find((p) => p.date.startsWith(datePrefix));
  return hit ? hit.value : null;
}

// ---- Sector definitions (copper picked up automatically when CSVs present) ---
interface SectorDef {
  key: string;
  label: string;
}
const SECTOR_DEFS: SectorDef[] = [
  { key: "steel",     label: "Steel" },
  { key: "aluminum",  label: "Aluminum" },
  { key: "copper",    label: "Copper" },   // no-op if CSVs absent
  { key: "softwood",  label: "Softwood" },
  { key: "autos",     label: "Cars" },
];

interface SectorSlope {
  label: string;
  share25: number;   // May 2025 US share, %
  share26: number;   // May 2026 US share, %
  delta: number;     // share26 - share25, pp
}

const slopes: SectorSlope[] = [];

for (const def of SECTOR_DEFS) {
  const usData  = readProcessedCsv(`exports_${def.key}_us`);
  const nonData = readProcessedCsv(`exports_${def.key}_nonus`);
  if (usData.length === 0 || nonData.length === 0) continue; // copper skipped until data lands

  const us25  = monthValue(usData,  "2025-05");
  const non25 = monthValue(nonData, "2025-05");
  const us26  = monthValue(usData,  "2026-05");
  const non26 = monthValue(nonData, "2026-05");

  if (us25 === null || non25 === null || us26 === null || non26 === null) continue;
  if (us25 + non25 === 0 || us26 + non26 === 0) continue;

  const share25 = (us25  / (us25  + non25))  * 100;
  const share26 = (us26  / (us26  + non26))  * 100;
  const delta   = share26 - share25;

  slopes.push({ label: def.label, share25, share26, delta });
}

// Sort ascending by delta: biggest diversifiers (most negative) on top.
// Then move aluminum to the END of the render list so its SVG elements
// paint last and are never obscured by other sectors sharing the same y.
// The visual y-position of aluminum in the chart is unchanged — only the
// DOM rendering order shifts so aluminum's red marks sit on top.
slopes.sort((a, b) => a.delta - b.delta);
const alIdx = slopes.findIndex((s) => s.label === "Aluminum");
if (alIdx >= 0) {
  const [alRow] = slopes.splice(alIdx, 1) as [SectorSlope];
  slopes.push(alRow);
}

// ---- Geometry -----------------------------------------------------------------
const VB_W = 720;
const VB_H = 405;

// Margins: wide L/R to push slopes into center 30-40% of chart width.
// The two column spines sit at X_LEFT and X_RIGHT; with generous margins
// the slope distance is compressed and the visual slope angle is steeper.
// Left: "97%" at ~11px mono ≈ 24px; 8px gap to dot → plenty of room.
// Right: DOT_R(4) + GAP(8) + "86%"(~24px) + LABEL_GAP(10) + "Aluminum"(~62px) → ~108px.
const M_L  = 200;  // wide left margin pushes left spine inward
const M_R  = 200;  // wide right margin pushes right spine inward
const M_T  = 72;   // room for chart title + column headers + top padding
const M_B  = 32;   // bottom padding

const PLOT_W = VB_W - M_L - M_R;   // 320 — slopes span center ~44% of viewBox width
const PLOT_H = VB_H - M_T - M_B;   // 321

// Two column x-positions (the slopegraph "spines")
const X_LEFT  = M_L;                // May 2025 column (x=200)
const X_RIGHT = M_L + PLOT_W;       // May 2026 column (x=520)

// Y-scale: hardcoded to just-fit the data with margin.
// Aluminum May 2026 is near 63%, while the other sectors sit around 87-91%.
// 58-94 gives comfortable top + bottom clearance for the refreshed window.
const Y_LO = 58;
const Y_HI = 94;

function yPx(share: number): number {
  return M_T + PLOT_H - ((share - Y_LO) / (Y_HI - Y_LO)) * PLOT_H;
}

// ---- Label collision avoidance (right side only) -----------------------------
// Left side: May 2025 % value is pinned to dot y — no spreading needed.
// Right side: May 2026 % value + sector label group needs spreading when two
//   right dots share the same y-coordinate (e.g. aluminum 86% and steel 86%).
interface LabelPos { share: number; nominalY: number; adjustedY: number; label: string }

const MIN_LABEL_GAP = 14; // px minimum between adjacent label centers

function spreadLabels(items: LabelPos[]): LabelPos[] {
  const sorted = [...items].sort((a, b) => a.nominalY - b.nominalY);
  // First pass: push labels apart downward
  for (let i = 1; i < sorted.length; i++) {
    const prev = sorted[i - 1]!;
    const cur  = sorted[i]!;
    if (cur.adjustedY - prev.adjustedY < MIN_LABEL_GAP) {
      cur.adjustedY = prev.adjustedY + MIN_LABEL_GAP;
    }
  }
  // Second pass: pull back if any went below the plot bottom
  for (let i = sorted.length - 1; i >= 1; i--) {
    const cur  = sorted[i]!;
    const prev = sorted[i - 1]!;
    const maxY = M_T + PLOT_H - 4;
    if (cur.adjustedY > maxY) cur.adjustedY = maxY;
    if (cur.adjustedY - prev.adjustedY < MIN_LABEL_GAP) {
      prev.adjustedY = cur.adjustedY - MIN_LABEL_GAP;
    }
  }
  return sorted;
}

const rightLabelItems: LabelPos[] = slopes.map((s) => ({
  share:     s.share26,
  nominalY:  yPx(s.share26),
  adjustedY: yPx(s.share26),
  label:     s.label,
}));

const rightLabels = spreadLabels(rightLabelItems);

// Build lookup: label -> adjustedY for right side
const rightLabelY = new Map(rightLabels.map((l) => [l.label, l.adjustedY]));

// ---- Percent formatters ------------------------------------------------------
// Integer percent for dot labels (Math.round, no decimals).
function fmtPct(v: number): string {
  return Math.round(v) + "%";
}

// Share formatter for SVG <title> accessibility text (1 decimal).
function fmtShare(v: number): string {
  return v.toFixed(1) + "%";
}

// ---- Column header y-position ------------------------------------------------
const COL_HDR_Y  = M_T - 22;   // above the top spine cap
const SPINE_TOP  = M_T - 10;   // the vertical spine starts here
const SPINE_BTM  = M_T + PLOT_H + 10;
---

<div class="sg-chart" data-panel="trade-sector-pivot-slope">
  <svg
    class="sg-chart__svg"
    viewBox={`0 0 ${VB_W} ${VB_H}`}
    preserveAspectRatio="xMidYMid meet"
    role="img"
    aria-label={`Slopegraph: US share of total exports by Section 232 tariffed sector, May 2025 to May 2026. ${slopes.map(s => `${s.label}: ${fmtShare(s.share25)} to ${fmtShare(s.share26)}`).join("; ")}.`}
  >

    {/* ---- Column spine rules (the two vertical reference lines) ----------- */}
    <line
      class="sg-chart__spine"
      x1={X_LEFT}  y1={SPINE_TOP}
      x2={X_LEFT}  y2={SPINE_BTM}
    />
    <line
      class="sg-chart__spine"
      x1={X_RIGHT} y1={SPINE_TOP}
      x2={X_RIGHT} y2={SPINE_BTM}
    />

    {/* ---- Chart title ----------------------------------------------------- */}
    <text
      class="sg-chart__title"
      x={(X_LEFT + X_RIGHT) / 2}
      y={M_T - 44}
      text-anchor="middle"
    >SHARE OF EXPORTS TO US</text>

    {/* ---- Column headers -------------------------------------------------- */}
    <text
      class="sg-chart__col-header"
      x={X_LEFT}
      y={COL_HDR_Y}
      text-anchor="middle"
    >MAY 2025</text>
    <text
      class="sg-chart__col-header"
      x={X_RIGHT}
      y={COL_HDR_Y}
      text-anchor="middle"
    >MAY 2026</text>

    {/* ---- Slope lines + dots per sector ----------------------------------- */}
    {slopes.map((s) => {
      const y25 = yPx(s.share25);
      const y26 = yPx(s.share26);
      const lblRightY = rightLabelY.get(s.label) ?? y26;
      const DOT_R = 4;
      const PCT_GAP  = 8;  // px gap between dot edge and percent value text
      // IBM Plex Mono 11px: "86%" is ~3 chars * ~7px/char ≈ 21px; 28px gives a safe clearance.
      const PCT_TEXT_W = 28; // px budget for the right-side percent value text

      // Aluminum: MTA red throughout. All other sectors: pure ink.
      const isAluminum = s.label === "Aluminum";
      const markColor  = isAluminum ? "#E63946" : "var(--ink, #000)";

      // Right-side percent value x-position
      const pctRightX = X_RIGHT + DOT_R + PCT_GAP;
      // Sector label x-position: after the percent value text
      const sectorLabelX = pctRightX + PCT_TEXT_W;

      return (
        <g class="sg-chart__sector" data-sector={s.label.toLowerCase()} data-accent={isAluminum ? "red" : "none"}>

          {/* Slope line */}
          <line
            class="sg-chart__slope-line"
            x1={X_LEFT}  y1={y25.toFixed(2)}
            x2={X_RIGHT} y2={y26.toFixed(2)}
            stroke={markColor}
          />

          {/* Left dot — May 2025 */}
          <circle
            class="sg-chart__dot sg-chart__dot--left"
            cx={X_LEFT}
            cy={y25.toFixed(2)}
            r={DOT_R}
            fill={markColor}
          >
          </circle>

          {/* Left percent value — May 2025, pinned to dot y, text-anchor="end" */}
          <text
            class="sg-chart__pct-label"
            x={X_LEFT - DOT_R - PCT_GAP}
            y={(y25 + 4).toFixed(2)}
            text-anchor="end"
            fill={markColor}
          >{fmtPct(s.share25)}</text>

          {/* Right dot — May 2026 */}
          <circle
            class="sg-chart__dot sg-chart__dot--right"
            cx={X_RIGHT}
            cy={y26.toFixed(2)}
            r={DOT_R}
            fill={markColor}
          >
          </circle>

          {/* Right leader line from right-side group to dot (if label shifted) */}
          {Math.abs(lblRightY - y26) > 3 && (
            <line
              class="sg-chart__leader"
              x1={X_RIGHT + DOT_R + 3}
              y1={y26.toFixed(2)}
              x2={X_RIGHT + DOT_R + PCT_GAP - 2}
              y2={lblRightY.toFixed(2)}
            />
          )}

          {/* Right percent value — May 2026, text-anchor="start" */}
          <text
            class="sg-chart__pct-label"
            x={pctRightX}
            y={(lblRightY + 4).toFixed(2)}
            text-anchor="start"
            fill={markColor}
          >{fmtPct(s.share26)}</text>

          {/* Sector label — right of Apr 2026 percent value */}
          <text
            class="sg-chart__sector-label"
            x={sectorLabelX}
            y={(lblRightY + 4).toFixed(2)}
            text-anchor="start"
            fill={markColor}
          >{s.label}</text>

        </g>
      );
    })}

  </svg>
</div>

<style>
  /*
   * PanelSectorPivot — Vignelli slopegraph.
   * Two-snapshot US-share comparison: May 2025 → May 2026.
   * Aluminum: MTA red treatment (line, both dots, percent values, sector label).
   * All other sectors: pure ink throughout.
   * Color is applied via inline fill/stroke attributes in the JSX map;
   * the CSS class rules below set structural defaults only.
   */

  .sg-chart {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: var(--paper, #fff);
    overflow: visible;
  }

  .sg-chart__svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    font-family: var(--font-sans, 'Manrope', sans-serif);
  }

  /* Column spine — 1px pure ink hairline */
  .sg-chart__spine {
    stroke: var(--ink, #000);
    stroke-width: 1;
    stroke-opacity: 0.25;
    shape-rendering: crispEdges;
  }

  /* Chart title — Manrope 600, 12px micro-caps, ink */
  .sg-chart__title {
    fill: var(--ink, #000);
    font-family: var(--font-sans, 'Manrope', sans-serif);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.10em;
    text-transform: uppercase;
  }

  /* Column headers — Manrope 600, 11px micro-caps, ink-faint */
  .sg-chart__col-header {
    fill: var(--ink-faint, #555);
    font-family: var(--font-sans, 'Manrope', sans-serif);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.10em;
    text-transform: uppercase;
  }

  /* Slope line — 1.5px. Structural properties only; stroke color is set
     exclusively via inline attribute per sector so that aluminum's MTA red
     is never overridden. DO NOT add a `stroke:` rule here. */
  .sg-chart__slope-line {
    stroke-width: 1.5;
    stroke-linecap: round;
    fill: none;
    vector-effect: non-scaling-stroke;
  }

  /* Dots — fill is set inline per sector (ink or MTA red for Aluminum) */
  .sg-chart__dot--left,
  .sg-chart__dot--right {
    stroke: none;
  }

  /* Leader line — 0.5px ink, low opacity, connects shifted label to dot */
  .sg-chart__leader {
    stroke: var(--ink, #000);
    stroke-width: 0.5;
    stroke-opacity: 0.35;
    stroke-linecap: round;
  }

  /* Percent value labels (left dot and right dot) — IBM Plex Mono 400, 11px */
  /* fill is set inline per sector (ink or MTA red for Aluminum) */
  .sg-chart__pct-label {
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 11px;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }

  /* Sector label — Manrope 600, 13px */
  /* fill is set inline per sector (ink or MTA red for Aluminum) */
  .sg-chart__sector-label {
    font-family: var(--font-sans, 'Manrope', sans-serif);
    font-size: 13px;
    font-weight: 600;
  }

</style>
