---
/*
 * Panel3PartnerShares - partner shares of exports.
 *
 * Pipeline emits `trade_exports_total` (primary) and
 * `trade_exports_us` (secondary), both CAD millions. The share
 * derivation (US/total) is not on disk; we render the two raw export
 * series.
 *
 * Synthetic-data fallback removed.
 */

import type { PanelData } from "../_shared/panelData";
import PanelLiveChart from "../_shared/PanelLiveChart.astro";
import PanelEmpty from "../_shared/PanelEmpty.astro";

interface Props {
  data?: PanelData | null;
}

const { data = null } = Astro.props;
---
{data && data.primary ? (
  <PanelLiveChart
    primary={data.primary}
    secondary={data.secondary}
    primaryLabel="Total exports"
    secondaryLabel="Exports to US"
    dataPanelAttr="trade-3"
    ariaLabel="Total Canadian merchandise exports and exports to the US."
  />
) : (
  <PanelEmpty reason="Partner-share derivation not yet emitted." />
)}
