---
/*
 * Panel3PartnerShares - Trade plate 3.
 *
 * Spec: editorial canon 4.7.3. US share of Canadian merchandise exports
 * is the load-bearing series (solid 1.5px black) - the secular drift off
 * the mid-70s plateau is the editorial story. China, UK, Japan, Mexico
 * sit as 1px dashed-ink companions per the Vignelli multi-series rule.
 * MTA red dot on the latest US-share print.
 *
 * Visual: 10-year annual window. Y-axis is percent share. The US line
 * runs in the 65-78 range; others sit at the bottom (1-6). The visual
 * gap itself communicates the asymmetry - no second axis or scale break
 * needed.
 *
 * Plot vs SVG: hand-rolled SVG, five lines, dot. Below Plot's threshold.
 *
 * Placeholder: 10 annual prints 2017-2026. US drifts 76 -> 72; China
 * drifts 4 -> 5; UK / Japan / Mexico roughly flat.
 */

interface ShareRow {
  year: number;
  us: number;
  china: number;
  uk: number;
  japan: number;
  mexico: number;
}

interface Props {
  data?: ShareRow[];
  ariaLabel?: string;
}

function makePlaceholder(): ShareRow[] {
  const out: ShareRow[] = [];
  for (let i = 0; i < 10; i++) {
    const t = i / 9;
    out.push({
      year: 2017 + i,
      us: Number((76.5 - 4.5 * t + 0.4 * Math.sin(i * 1.1)).toFixed(2)),
      china: Number((3.9 + 1.4 * t + 0.2 * Math.cos(i)).toFixed(2)),
      uk: Number((3.0 + 0.3 * Math.sin(i * 0.7)).toFixed(2)),
      japan: Number((2.5 - 0.1 * t + 0.2 * Math.cos(i * 0.8)).toFixed(2)),
      mexico: Number((1.5 + 0.6 * t + 0.15 * Math.sin(i * 1.3)).toFixed(2)),
    });
  }
  return out;
}

const {
  data = makePlaceholder(),
  ariaLabel = "Country shares of Canadian merchandise exports, last 10 years.",
} = Astro.props;

// ---- Geometry ----
const VB_W = 720;
const VB_H = 432;
const M_L = 44;
const M_R = 76;
const M_T = 30;
const M_B = 34;
const PLOT_X0 = M_L;
const PLOT_Y0 = M_T;
const PLOT_W = VB_W - M_L - M_R;
const PLOT_H = VB_H - M_T - M_B;
const PLOT_X1 = PLOT_X0 + PLOT_W;
const PLOT_Y1 = PLOT_Y0 + PLOT_H;

const n = data.length;
const yLo = 0;
const yHi = 80;
const yTicks = [0, 20, 40, 60, 80];

function xScale(i: number): number {
  return PLOT_X0 + (i / (n - 1)) * PLOT_W;
}
function yScale(v: number): number {
  return PLOT_Y0 + PLOT_H - ((v - yLo) / (yHi - yLo)) * PLOT_H;
}

const partners = [
  { key: "us",      label: "US",     dash: "0",   stroke: 1.5, opacity: 1 },
  { key: "china",   label: "China",  dash: "4 2", stroke: 1,   opacity: 0.55 },
  { key: "uk",      label: "UK",     dash: "2 2", stroke: 1,   opacity: 0.55 },
  { key: "japan",   label: "Japan",  dash: "6 3", stroke: 1,   opacity: 0.55 },
  { key: "mexico",  label: "Mexico", dash: "1 2", stroke: 1,   opacity: 0.55 },
] as const;

function pathFor(key: keyof ShareRow): string {
  return data
    .map((d: ShareRow, i: number) => `${i === 0 ? "M" : "L"}${xScale(i).toFixed(2)} ${yScale(d[key] as number).toFixed(2)}`)
    .join(" ");
}

const xLabels: Array<{ x: number; label: string }> = data.map((d: ShareRow, i: number) => ({
  x: xScale(i),
  label: i === n - 1 ? String(d.year) : `'${String(d.year).slice(-2)}`,
}));

const last = data[n - 1];
const lastX = xScale(n - 1);
const lastUsY = yScale(last.us);
---
<figure class="trade-panel-3" aria-label={ariaLabel}>
  <svg
    class="trade-panel-3__svg"
    viewBox={`0 0 ${VB_W} ${VB_H}`}
    preserveAspectRatio="xMidYMid meet"
    role="img"
  >
    {/* Gridlines */}
    {yTicks.map((v) => (
      <line
        class="trade-panel-3__gridline"
        x1={PLOT_X0}
        y1={yScale(v).toFixed(2)}
        x2={PLOT_X1}
        y2={yScale(v).toFixed(2)}
      />
    ))}

    {/* Partner lines */}
    {partners.map((p) => (
      <path
        class:list={["trade-panel-3__line", `trade-panel-3__line--${p.key}`]}
        d={pathFor(p.key as keyof ShareRow)}
        stroke-dasharray={p.dash === "0" ? undefined : p.dash}
        stroke-width={p.stroke}
        opacity={p.opacity}
        fill="none"
      />
    ))}

    {/* Latest US dot */}
    <circle
      class="trade-panel-3__marker"
      cx={lastX.toFixed(2)}
      cy={lastUsY.toFixed(2)}
      r="3.5"
    >
      <title>{`${last.year}: US ${last.us.toFixed(1)}%`}</title>
    </circle>

    {/* Plot frame */}
    <rect
      class="trade-panel-3__frame"
      x={PLOT_X0}
      y={PLOT_Y0}
      width={PLOT_W}
      height={PLOT_H}
      fill="none"
    />

    {/* X-axis tick labels */}
    {xLabels.map((t) => (
      <text
        class="trade-panel-3__xtick-label"
        x={t.x.toFixed(2)}
        y={(PLOT_Y1 + 16).toFixed(2)}
        text-anchor="middle"
      >{t.label}</text>
    ))}

    {/* Y-axis tick labels */}
    {yTicks.map((v, i) => (
      <text
        class="trade-panel-3__ytick-label"
        x={(PLOT_X0 - 6).toFixed(2)}
        y={(yScale(v) + 3.5).toFixed(2)}
        text-anchor="end"
      >{i === yTicks.length - 1 ? `${v}%` : `${v}`}</text>
    ))}

    {/* Direct labels at termini */}
    {partners.map((p) => {
      const v = last[p.key as keyof ShareRow] as number;
      const y = yScale(v);
      return (
        <text
          class:list={[
            "trade-panel-3__direct-label",
            p.key === "us" ? "" : "trade-panel-3__direct-label--secondary",
          ]}
          x={(PLOT_X1 + 4).toFixed(2)}
          y={(y + 3.5).toFixed(2)}
          text-anchor="start"
        >{p.label}</text>
      );
    })}

    {/* Unit annotation top-left */}
    <text
      class="trade-panel-3__unit"
      x={PLOT_X0.toFixed(2)}
      y={(PLOT_Y0 - 12).toFixed(2)}
      text-anchor="start"
    >Share of Canadian merchandise exports, percent. US solid; others dashed.</text>
  </svg>
</figure>

<style>
  .trade-panel-3 {
    width: 100%;
    margin: 0;
    background-color: var(--surface);
  }
  .trade-panel-3__svg {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--font-sans);
    overflow: visible;
  }
  .trade-panel-3__gridline {
    stroke: var(--ink);
    stroke-opacity: 0.15;
    stroke-width: 1;
    shape-rendering: crispEdges;
  }
  .trade-panel-3__line {
    stroke: #000000;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .trade-panel-3__marker {
    fill: #E63946;
    stroke: var(--surface);
    stroke-width: 1.25;
  }
  .trade-panel-3__frame {
    stroke: #000000;
    stroke-width: 1;
    shape-rendering: crispEdges;
  }
  .trade-panel-3__xtick-label,
  .trade-panel-3__ytick-label {
    fill: var(--ink);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: var(--fw-regular);
    font-variant-numeric: tabular-nums;
  }
  .trade-panel-3__direct-label {
    font-size: 11px;
    font-weight: var(--fw-medium);
    font-variant-numeric: tabular-nums;
    fill: var(--ink);
  }
  .trade-panel-3__direct-label--secondary {
    opacity: 0.65;
  }
  .trade-panel-3__unit {
    fill: var(--ink);
    font-size: 11px;
    font-weight: var(--fw-medium);
    letter-spacing: 0.02em;
  }
</style>
