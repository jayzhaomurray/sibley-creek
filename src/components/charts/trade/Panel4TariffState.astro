---
/*
 * Panel4TariffState - tariff state log.
 *
 * Pipeline does not emit tariff data (this is an editorially-maintained
 * log per design-system Section 6.5, not a time series). PanelEmpty
 * until the tariff log is wired into a renderable form.
 *
 * Synthetic-data fallback removed.
 */

import type { PanelData } from "../_shared/panelData";
import PanelEmpty from "../_shared/PanelEmpty.astro";

interface Props {
  data?: PanelData | null;
}

const { data: _data = null } = Astro.props;
void _data;
---
<PanelEmpty reason="Tariff state log not yet wired (editorial table)." />
