---
/*
 * Panel1TradeBalance - merchandise trade balance.
 *
 * Pipeline emits `trade_balance_total` (primary, CAD millions) and
 * `trade_balance_total_3m_ma` (secondary). Both same unit; rendered
 * as overlay.
 *
 * Synthetic-data fallback removed.
 */

import type { PanelData } from "../_shared/panelData";
import PanelLiveChart from "../_shared/PanelLiveChart.astro";
import PanelEmpty from "../_shared/PanelEmpty.astro";

interface Props {
  data?: PanelData | null;
}

const { data = null } = Astro.props;
---
{data && data.primary ? (
  <PanelLiveChart
    primary={data.primary}
    secondary={data.secondary}
    primaryLabel="Trade bal."
    secondaryLabel="3mma"
    dataPanelAttr="trade-1"
    ariaLabel="Merchandise trade balance, monthly, CAD millions."
  />
) : (
  <PanelEmpty reason="Pipeline did not emit panel-1 data." />
)}
