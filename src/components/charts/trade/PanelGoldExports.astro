---
/*
 * Alt_GoldExportsAndPrice â€” "Gold exports surge with price."
 *
 * Two-panel composite, side-by-side, 720x405 (16:9).
 *
 * LEFT PANEL â€” GOLD EXPORTS
 *   Primary:   total gold/PGM exports, monthly, CAD millions.
 *              1.5px solid pure ink, MTA red 4px terminal dot.
 *   Secondary: UK-destination exports, 1px dashed "4 2" pure ink, 0.65 opacity.
 *   The UK line nearly overlaps total at the right edge (UK share ~97.4% in
 *   Mar 2026). That visual coincidence is the editorial signal.
 *   Y-axis: CAD millions, topmost tick carries "M" suffix.
 *   Direct labels: "Total" (Manrope 600) and "UK" (Manrope 400).
 *
 * RIGHT PANEL â€” GOLD PRICE
 *   Single line: monthly close, USD/oz.
 *   1.5px solid pure ink, MTA red 4px terminal dot.
 *   Y-axis: USD, topmost tick carries "$" prefix.
 *   Direct label: "USD/oz" (Manrope 600).
 *
 * Window: 2020-01 through latest available for exports and gold price.
 *
 * Mode B per-panel y-axis (units differ: CAD M vs USD/oz).
 * Left panel y-ticks in left gutter (M_OUT_L).
 * Right panel y-ticks in GAP_X gutter between panels.
 *
 * Data source: data/processed/ CSVs
 *   exports_gold_total.csv â€” StatCan 12-10-0182-01, NAPCS 35
 *   exports_gold_uk.csv    â€” same table, UK destination
 *   gold_price_monthly.csv â€” monthly close, USD/oz
 *
 * Canon compliance (design/canon_reference_panel.md):
 *   1.  Primary line: pure ink 1.5px solid. MTA red 4px terminal dot.
 *   2.  Secondary line: pure ink 1px dashed "4 2", 0.65 opacity. No terminal dot.
 *   3.  Y-axis: IBM Plex Mono 400 12px, per-panel (Mode B).
 *   4.  X-axis: Manrope 400 12px, 3-4 ticks, bottom row only.
 *   5.  1px pure ink hairline plot frame per panel.
 *   6.  3 horizontal gridlines per panel, stroke-opacity 0.18.
 *   7.  No legend. Direct end-of-line labels only.
 *   8.  Native SVG <title> on hit areas. Zero client JS.
 *   9.  viewBox 720x405.
 *  10.  No __source paragraph below SVG (spec request).
 *
 * Methodology note (direct series, no derivation):
 *   Both export series are direct pulls from StatCan 12-10-0182-01,
 *   NAPCS chapter 35 (precious metals and non-monetary gold). Backend
 *   caveat: ~85-90% of chapter-35 value is gold; silver and PGM
 *   constitute the balance. Stated in caption.
 *   Gold price is a monthly close series in USD/oz. No derivation,
 *   no smoothing, no indexing.
 */

import { readFileSync } from "node:fs";
import { resolve } from "node:path";

// ---- Types -------------------------------------------------------------------
type RawPoint = { date: string; value: number };

// ---- CSV reader --------------------------------------------------------------
function readProcessedCsv(slug: string): RawPoint[] {
  const p = resolve(process.cwd(), "data", "processed", `${slug}.csv`);
  let txt: string;
  try {
    txt = readFileSync(p, "utf-8");
  } catch {
    return [];
  }
  const lines = txt.split(/\r?\n/).filter((l) => l.length > 0);
  const out: RawPoint[] = [];
  for (let i = 1; i < lines.length; i++) {
    const line = lines[i]!;
    const idx = line.indexOf(",");
    if (idx < 0) continue;
    const date = line.slice(0, idx).trim();
    const raw = line.slice(idx + 1).trim();
    if (!date) continue;
    const v = raw === "" || raw === "NA" || raw === "null" ? null : Number(raw);
    if (typeof v === "number" && !Number.isNaN(v)) {
      out.push({ date, value: v });
    }
  }
  return out;
}

// ---- Load data ---------------------------------------------------------------
const rawTotal = readProcessedCsv("exports_gold_total");
const rawUk    = readProcessedCsv("exports_gold_uk");
const rawPrice = readProcessedCsv("gold_price_monthly");

// ---- Window: 2020-01 onward --------------------------------------------------
const WIN_START = "2020-01-01";
function win(pts: RawPoint[]): RawPoint[] {
  return pts.filter((p) => p.date >= WIN_START);
}

const total = win(rawTotal);
const uk    = win(rawUk);
const price = win(rawPrice);

// ---- decYear helper ----------------------------------------------------------
function decYear(dateStr: string): number {
  const [ys, ms] = dateStr.split("-");
  const y = parseInt(ys ?? "2020", 10);
  const m = parseInt(ms ?? "1", 10);
  return y + (m - 0.5) / 12;
}

// ---- Y-scale helpers ---------------------------------------------------------
function niceStep(lo: number, hi: number, target = 4): number {
  const span = hi - lo;
  if (span <= 0) return 1;
  const raw = span / target;
  const mag = Math.pow(10, Math.floor(Math.log10(raw)));
  for (const f of [1, 2, 2.5, 5, 10]) {
    const c = f * mag;
    const n = Math.floor(span / c);
    if (n >= 2 && n <= 6) return c;
  }
  return 10 * mag;
}

function computeAxisScale(
  vals: number[],
  target = 4,
): { yLo: number; yHi: number; ticks: number[] } {
  if (vals.length === 0) return { yLo: 0, yHi: 1, ticks: [0, 1] };
  const dMin = Math.min(...vals);
  const dMax = Math.max(...vals);
  const span = dMax - dMin || 1;
  const pad = span * 0.06;
  const lo = dMin - pad;
  const hi = dMax + pad;
  const step = niceStep(lo, hi, target);
  const tStart = Math.ceil(lo / step) * step;
  const ticks: number[] = [];
  for (let v = tStart; v <= hi + 1e-9; v += step) {
    ticks.push(parseFloat(v.toFixed(6)));
  }
  // Clamp to 2-5 ticks
  while (ticks.length > 5) ticks.splice(Math.floor(ticks.length / 2), 1);
  if (ticks.length < 2) return { yLo: lo, yHi: hi, ticks: [lo, hi] };
  const finalLo = ticks[0]! - step * 0.1;
  const finalHi = ticks[ticks.length - 1]! + step * 0.1;
  return { yLo: finalLo, yHi: finalHi, ticks };
}

// ---- Left panel (exports) y-axis ---------------------------------------------
const totalVals = total.map((p) => p.value);
const ukVals    = uk.map((p) => p.value);
const priceVals = price.map((p) => p.value);
const leftAxis  = computeAxisScale([...totalVals, ...ukVals], 4);

// ---- Right panel (price) y-axis â€” fixed floor at $1000, explicit ticks ------
// Floor fixed at 1000 so the 2020 values (~$1564) sit comfortably above the
// base. Keep the ceiling above the latest full price path so high 2026 prints
// do not escape the clipped plot area.
const RP_Y_LO = 1000;
const RP_Y_HI = Math.max(5500, Math.ceil((Math.max(...priceVals, 0) + 200) / 100) * 100);
const RP_TICKS = [1000, 2000, 3000, 4000, 5000, RP_Y_HI]
  .filter((v, i, arr) => v <= RP_Y_HI && arr.indexOf(v) === i);
const rightAxis = { yLo: RP_Y_LO, yHi: RP_Y_HI, ticks: RP_TICKS };

// ---- Tick formatter ----------------------------------------------------------
function fmtLeftTick(v: number, isTop: boolean): string {
  // Display in CAD billions. Input v is in CAD millions.
  const b = v / 1000;
  // Whole-number billions if integer; one decimal otherwise.
  const txt = Number.isInteger(b) ? String(b) : b.toFixed(1);
  return isTop ? `$${txt}B` : txt;
}

function fmtRightTick(v: number, isTop: boolean): string {
  // Ticks are exact multiples of 1000; $ prefix on topmost only
  const n = Math.round(v);
  return isTop ? `$${n.toLocaleString()}` : n.toLocaleString();
}

// ---- Shared x-domain ---------------------------------------------------------
// Covers both panels: 2020-01 to max of both latest dates
const allDates = [...total, ...price].map((p) => decYear(p.date));
const xMin = Math.min(...allDates);
const xMax = Math.max(...allDates);

// ---- Geometry ----------------------------------------------------------------
const VB_W = 720;
const VB_H = 440;

// Outer margins
const M_OUT_L = 46;   // left outer gutter â€” left panel y-ticks
const M_R     = 12;   // right outer margin â€” right panel label room
const M_T     = 28;   // top
const M_B     = 36;   // bottom â€” x-tick labels

// Gap between panels â€” right panel y-ticks live here
const GAP_X = 96;

// Total plot area
const TOTAL_W = VB_W - M_OUT_L - M_R;
const TOTAL_H = VB_H - M_T - M_B;

// Panel widths: equal â€” GAP_X sits between them, not inside either panel.
const LEFT_W  = Math.round((TOTAL_W - GAP_X) / 2);
const RIGHT_W = TOTAL_W - GAP_X - LEFT_W;

// Panel boundaries
const LP_X0 = M_OUT_L;
const LP_X1 = LP_X0 + LEFT_W;
const LP_Y0 = M_T;
const LP_Y1 = LP_Y0 + TOTAL_H;

const RP_X0 = LP_X1 + GAP_X;
const RP_X1 = RP_X0 + RIGHT_W;
const RP_Y0 = M_T;
const RP_Y1 = RP_Y0 + TOTAL_H;

// ---- Scale factories ---------------------------------------------------------
function makeXScale(x0: number, x1: number): (xv: number) => number {
  return (xv: number) => x0 + ((xv - xMin) / (xMax - xMin || 1)) * (x1 - x0);
}

function makeYScale(
  yLo: number,
  yHi: number,
  y0: number,
  y1: number,
): (v: number) => number {
  return (v: number) => y0 + (y1 - y0) - ((v - yLo) / (yHi - yLo || 1)) * (y1 - y0);
}

const leftXScale  = makeXScale(LP_X0, LP_X1);
const leftYScale  = makeYScale(leftAxis.yLo, leftAxis.yHi, LP_Y0, LP_Y1);
const rightXScale = makeXScale(RP_X0, RP_X1);
const rightYScale = makeYScale(rightAxis.yLo, rightAxis.yHi, RP_Y0, RP_Y1);

// ---- Path builder ------------------------------------------------------------
function buildPath(
  pts: RawPoint[],
  xScale: (x: number) => number,
  yScale: (v: number) => number,
): string {
  let d = "";
  let started = false;
  for (const pt of pts) {
    const xv = decYear(pt.date);
    if (Number.isNaN(xv)) { started = false; continue; }
    const x = xScale(xv);
    const y = yScale(pt.value);
    if (!Number.isFinite(x) || !Number.isFinite(y)) {
      started = false;
      continue;
    }
    const px = x.toFixed(2);
    const py = y.toFixed(2);
    d += started ? `L${px} ${py} ` : `M${px} ${py} `;
    started = true;
  }
  return d.trim();
}

// ---- Paths -------------------------------------------------------------------
const totalPath = buildPath(total, leftXScale, leftYScale);
const ukPath    = buildPath(uk,    leftXScale, leftYScale);
const pricePath = buildPath(price, rightXScale, rightYScale);

// ---- Terminal points ---------------------------------------------------------
const totalLast = total[total.length - 1]!;
const ukLast    = uk[uk.length - 1]!;
const priceLast = price[price.length - 1]!;

const totalLastX = leftXScale(decYear(totalLast.date));
const totalLastY = leftYScale(totalLast.value);
const ukLastX    = leftXScale(decYear(ukLast.date));
const ukLastY    = leftYScale(ukLast.value);
const priceLastX = rightXScale(decYear(priceLast.date));
const priceLastY = rightYScale(priceLast.value);

// ---- Direct label positions --------------------------------------------------
// Labels anchor text-anchor="start" in the right gutter of the left panel â€”
// i.e., to the right of LP_X1, inside the GAP_X zone. This ensures they
// never touch the data lines inside the plot area and never collide with the
// right-panel y-ticks (which anchor text-anchor="end" at RP_X0 - 6).
const LABEL_GAP = 7;           // horizontal gap from frame right edge to label
const LABEL_MIN_SEP = 14;      // minimum vertical separation between stacked labels

const totalLabelX = LP_X1 + LABEL_GAP;
const totalLabelY = totalLastY + 4;

// UK terminal is nearly coincident with total â€” stack down by LABEL_MIN_SEP if needed
const ukLabelX = LP_X1 + LABEL_GAP;
const ukLabelY = Math.abs(ukLastY - totalLastY) < LABEL_MIN_SEP
  ? totalLabelY + LABEL_MIN_SEP
  : ukLastY + 4;

// "USD/oz" label for right panel
const priceLabelX = Math.min(priceLastX + LABEL_GAP, RP_X1 + 50);
const priceLabelY = priceLastY + 4;

// ---- X-ticks â€” shared (same date domain for both panels) --------------------
// 4 ticks: 2020, 2022, 2024, 2026
const X_TICK_YEARS = [2020, 2022, 2024, 2026];

interface XTick { xLeft: number; xRight: number; label: string }
const xTicks: XTick[] = X_TICK_YEARS
  .map((yr) => {
    const xv = yr + 0.5 / 12;
    if (xv < xMin - 0.1 || xv > xMax + 0.1) return null;
    return {
      xLeft:  leftXScale(xv),
      xRight: rightXScale(xv),
      label:  String(yr),
    };
  })
  .filter((t): t is XTick => t !== null);

// ---- Latest values (for aria-label) -----------------------------------------
const MONTH_NAMES = [
  "January",
  "February",
  "March",
  "April",
  "May",
  "June",
  "July",
  "August",
  "September",
  "October",
  "November",
  "December",
] as const;

function fmtMonthYear(dateStr: string): string {
  const [ys, ms] = dateStr.split("-");
  const y = parseInt(ys ?? "", 10);
  const m = parseInt(ms ?? "", 10);
  if (!Number.isFinite(y) || !Number.isFinite(m) || m < 1 || m > 12) return dateStr.slice(0, 7);
  return `${MONTH_NAMES[m - 1]} ${y}`;
}

const latestTotalFmt = Math.round(totalLast.value).toLocaleString();
const latestPriceFmt = Math.round(priceLast.value).toLocaleString();
const latestTotalMonth = fmtMonthYear(totalLast.date);
const latestPriceMonth = fmtMonthYear(priceLast.date);
---

<div class="gep-chart" data-panel="alt-trade-gold">
  <svg
    class="gep-chart__svg"
    viewBox={`0 0 ${VB_W} ${VB_H}`}
    preserveAspectRatio="xMidYMid meet"
    role="img"
    aria-label={`Two-panel composite: left panel shows Canadian gold and PGM exports to all countries and to the UK, monthly CAD millions, January 2020 to ${latestTotalMonth}; total exports reached ${latestTotalFmt} million in ${latestTotalMonth} with the UK absorbing 97 percent. Right panel shows gold price in USD per ounce through ${latestPriceMonth} at ${latestPriceFmt}.`}
  >

    <!-- =====================================================================
         CLIP PATHS â€” one per panel so lines never escape the plot frame
         ===================================================================== -->
    <defs>
      <clipPath id="clip-left">
        <rect x={LP_X0} y={LP_Y0} width={LEFT_W} height={TOTAL_H} />
      </clipPath>
      <clipPath id="clip-right">
        <rect x={RP_X0} y={RP_Y0} width={RIGHT_W} height={TOTAL_H} />
      </clipPath>
    </defs>

    <!-- =====================================================================
         LEFT PANEL â€” GOLD EXPORTS
         ===================================================================== -->

    <!-- Panel label -->
    <text
      class="gep-chart__panel-label"
      x={LP_X0}
      y={LP_Y0 - 10}
    >GOLD EXPORTS</text>

    <!-- Gridlines â€” left panel -->
    {leftAxis.ticks.map((v) => {
      const yv = leftYScale(v);
      if (yv < LP_Y0 - 0.5 || yv > LP_Y1 + 0.5) return null;
      return (
        <line
          class="gep-chart__gridline"
          x1={LP_X0}
          y1={yv.toFixed(2)}
          x2={LP_X1}
          y2={yv.toFixed(2)}
        />
      );
    })}

    <!-- UK line (secondary: dashed 1px, 0.65 opacity) â€” behind total -->
    {ukPath && (
      <path class="gep-chart__line--secondary" d={ukPath} clip-path="url(#clip-left)" />
    )}

    <!-- Total line (primary: solid 1.5px) -->
    {totalPath && (
      <path class="gep-chart__line--primary" d={totalPath} clip-path="url(#clip-left)" />
    )}

    <!-- Hit areas â€” total (every 3rd point) -->
    {total.filter((_p, i) => i % 3 === 0).map((pt) => {
      const cx = leftXScale(decYear(pt.date));
      const cy = leftYScale(pt.value);
      return (
        <circle class="gep-chart__hit" cx={cx.toFixed(2)} cy={cy.toFixed(2)} r="5" clip-path="url(#clip-left)">
        </circle>
      );
    })}

    <!-- Hit areas â€” UK (every 3rd point) -->
    {uk.filter((_p, i) => i % 3 === 0).map((pt) => {
      const cx = leftXScale(decYear(pt.date));
      const cy = leftYScale(pt.value);
      return (
        <circle class="gep-chart__hit" cx={cx.toFixed(2)} cy={cy.toFixed(2)} r="5" clip-path="url(#clip-left)">
        </circle>
      );
    })}

    <!-- MTA red terminal dot â€” total only (no clip-path: dot must always be visible) -->
    <circle
      class="gep-chart__latest-dot"
      cx={totalLastX.toFixed(2)}
      cy={totalLastY.toFixed(2)}
      r="4"
    >
    </circle>

    <!-- Plot frame â€” left panel -->
    <rect
      class="gep-chart__frame"
      x={LP_X0}
      y={LP_Y0}
      width={LP_X1 - LP_X0}
      height={LP_Y1 - LP_Y0}
    />

    <!-- Y-axis tick labels â€” left panel (in left gutter) -->
    {leftAxis.ticks.map((v, i) => {
      const yv = leftYScale(v);
      if (yv < LP_Y0 - 2 || yv > LP_Y1 + 2) return null;
      const isTop = i === leftAxis.ticks.length - 1;
      return (
        <text
          class="gep-chart__ytick-label"
          x={(LP_X0 - 6).toFixed(1)}
          y={(yv + 4).toFixed(1)}
          text-anchor="end"
        >
          {fmtLeftTick(v, isTop)}
        </text>
      );
    })}

    <!-- Direct end-of-line labels â€” right gutter of left panel, clear of lines -->
    <text
      class="gep-chart__direct-label--primary"
      x={totalLabelX.toFixed(1)}
      y={totalLabelY.toFixed(1)}
      text-anchor="start"
    >Total</text>

    <text
      class="gep-chart__direct-label--secondary"
      x={ukLabelX.toFixed(1)}
      y={ukLabelY.toFixed(1)}
      text-anchor="start"
    >UK</text>

    <!-- X-axis ticks â€” left panel (bottom) -->
    {xTicks.map((t) => {
      if (t.xLeft < LP_X0 - 1 || t.xLeft > LP_X1 + 1) return null;
      return (
        <text
          class="gep-chart__xtick-label"
          x={t.xLeft.toFixed(1)}
          y={(LP_Y1 + 16).toFixed(1)}
          text-anchor="middle"
        >
          {t.label}
        </text>
      );
    })}


    <!-- =====================================================================
         RIGHT PANEL â€” GOLD PRICE
         ===================================================================== -->

    <!-- Sub-panel label -->
    <text
      class="gep-chart__panel-label"
      x={RP_X0 + 4}
      y={RP_Y0 - 8}
    >GOLD PRICE PER OZ</text>

    <!-- Gridlines â€” right panel -->
    {rightAxis.ticks.map((v) => {
      const yv = rightYScale(v);
      if (yv < RP_Y0 - 0.5 || yv > RP_Y1 + 0.5) return null;
      return (
        <line
          class="gep-chart__gridline"
          x1={RP_X0}
          y1={yv.toFixed(2)}
          x2={RP_X1}
          y2={yv.toFixed(2)}
        />
      );
    })}

    <!-- Price line (primary: solid 1.5px) -->
    {pricePath && (
      <path class="gep-chart__line--primary" d={pricePath} clip-path="url(#clip-right)" />
    )}

    <!-- Hit areas â€” price (every 3rd point) -->
    {price.filter((_p, i) => i % 3 === 0).map((pt) => {
      const cx = rightXScale(decYear(pt.date));
      const cy = rightYScale(pt.value);
      return (
        <circle class="gep-chart__hit" cx={cx.toFixed(2)} cy={cy.toFixed(2)} r="5" clip-path="url(#clip-right)">
        </circle>
      );
    })}

    <!-- MTA red terminal dot â€” price (no clip-path: dot must always be visible) -->
    <circle
      class="gep-chart__latest-dot"
      cx={priceLastX.toFixed(2)}
      cy={priceLastY.toFixed(2)}
      r="4"
    >
    </circle>

    <!-- Plot frame â€” right panel -->
    <rect
      class="gep-chart__frame"
      x={RP_X0}
      y={RP_Y0}
      width={RP_X1 - RP_X0}
      height={RP_Y1 - RP_Y0}
    />

    <!-- Y-axis tick labels â€” right panel (in GAP_X gutter, left-aligned) -->
    {rightAxis.ticks.map((v, i) => {
      const yv = rightYScale(v);
      if (yv < RP_Y0 - 2 || yv > RP_Y1 + 2) return null;
      const isTop = i === rightAxis.ticks.length - 1;
      return (
        <text
          class="gep-chart__ytick-label"
          x={(RP_X0 - 6).toFixed(1)}
          y={(yv + 4).toFixed(1)}
          text-anchor="end"
        >
          {fmtRightTick(v, isTop)}
        </text>
      );
    })}

    <!-- X-axis ticks â€” right panel (bottom) -->
    {xTicks.map((t) => {
      if (t.xRight < RP_X0 - 1 || t.xRight > RP_X1 + 1) return null;
      return (
        <text
          class="gep-chart__xtick-label"
          x={t.xRight.toFixed(1)}
          y={(RP_Y1 + 16).toFixed(1)}
          text-anchor="middle"
        >
          {t.label}
        </text>
      );
    })}

  </svg>
</div>

<style>
  .gep-chart {
    width: 100%;
    background: var(--paper);
  }

  .gep-chart__svg {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--font-sans);
  }

  /* Panel label: Manrope 600, 11px micro-caps, pure ink */
  .gep-chart__panel-label {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    fill: var(--ink);
  }

  /* Gridlines: pure ink at 0.18 opacity */
  .gep-chart__gridline {
    stroke: var(--ink);
    stroke-width: 1;
    stroke-opacity: 0.18;
    fill: none;
  }

  /* Primary data line: 1.5px solid pure ink */
  .gep-chart__line--primary {
    stroke: var(--ink);
    stroke-width: 1.5;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Secondary data line: 1px dashed pure ink, 0.65 opacity */
  .gep-chart__line--secondary {
    stroke: var(--ink);
    stroke-width: 1;
    stroke-dasharray: 4 2;
    stroke-opacity: 0.65;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* MTA red terminal dot */
  .gep-chart__latest-dot {
    fill: var(--accent);
    stroke: none;
  }

  /* Hit areas: invisible, hover via native <title> */
  .gep-chart__hit {
    fill: transparent;
    stroke: none;
    cursor: default;
  }

  /* Plot frame: 1px pure ink hairline */
  .gep-chart__frame {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1;
  }

  /* Y-axis tick labels: IBM Plex Mono 400 12px */
  .gep-chart__ytick-label {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 400;
    fill: var(--ink);
  }

  /* X-axis tick labels: Manrope 400 12px */
  .gep-chart__xtick-label {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 400;
    fill: var(--ink);
  }

  /* Direct end-of-line label, primary: Manrope 600 13px */
  .gep-chart__direct-label--primary {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: var(--fw-semibold);
    fill: var(--ink);
  }

  /* Direct end-of-line label, secondary: Manrope 400 13px */
  .gep-chart__direct-label--secondary {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 400;
    fill: var(--ink);
  }

