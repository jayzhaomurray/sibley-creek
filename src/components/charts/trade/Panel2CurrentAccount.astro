---
/*
 * AUDIT-FLAGGED 2026-05-11 - see design/chart-label-audit-2026-05-11.md
 * Improved version: ./Panel2CurrentAccountV2.astro
 * Live in production until user reviews comparison page and picks one.
 * Decision pending.
 */
/*
 * Panel2CurrentAccount - current account.
 *
 * Pipeline emits `trade_balance_total` (primary, monthly) and
 * `ca_goods_income` (secondary, quarterly). Units differ in cadence;
 * we render the trade balance as the load-bearing series.
 *
 * Synthetic-data fallback removed.
 */

import type { PanelData } from "../_shared/panelData";
import PanelLiveChart from "../_shared/PanelLiveChart.astro";
import PanelEmpty from "../_shared/PanelEmpty.astro";

interface Props {
  data?: PanelData | null;
}

const { data = null } = Astro.props;
---
{data && data.primary ? (
  <PanelLiveChart
    primary={data.primary}
    secondary={data.secondary}
    primaryLabel="Trade bal."
    secondaryLabel="CA goods+inc."
    dataPanelAttr="trade-2"
    ariaLabel="Trade balance and current account components."
  />
) : (
  <PanelEmpty reason="Pipeline did not emit panel-2 data." />
)}
