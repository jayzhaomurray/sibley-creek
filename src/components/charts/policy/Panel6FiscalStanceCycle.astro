---
/*
 * Panel6FiscalStanceCycle - Policy chartbook, plate 06.
 *
 * Editorial canon Section 4.5.6: cyclically-adjusted primary balance
 * (CAPB) vs output gap. The reader's question: is fiscal policy
 * procyclical or countercyclical, and where is the cycle?
 *
 * Visual: scatter on a quadrant grid. X-axis is the output gap (% of
 * potential GDP), Y-axis is the CAPB (% of potential GDP). Each dot is
 * one fiscal year. The latest year (mid-2025 / FY25 vintage) is the
 * MTA red dot; prior years are pure black open circles. A 1px ink
 * connector traces the year-to-year path so the reader sees direction
 * of travel.
 *
 * Quadrants labeled in micro-caps:
 *   - NE (positive gap, positive balance): "Countercyclical tightening"
 *   - SE (positive gap, negative balance): "Procyclical loosening"
 *   - SW (negative gap, negative balance): "Countercyclical loosening"
 *   - NW (negative gap, positive balance): "Procyclical tightening"
 *
 * Vignelli canon: monochrome dots, MTA red on the latest dot only, ink
 * connector, ink frame, no second hue.
 *
 * Plot vs SVG: hand-rolled SVG.
 */

interface YearPoint {
  label: string;     // "FY24/25" or "2024"
  output_gap: number;
  capb: number;
}

interface Props {
  data?: YearPoint[];
  asOf?: string;
  ariaLabel?: string;
}

function defaultData(): YearPoint[] {
  return [
    { label: "FY18/19", output_gap:  0.4, capb:  0.2 },
    { label: "FY19/20", output_gap:  0.6, capb:  0.0 },
    { label: "FY20/21", output_gap: -5.8, capb: -8.2 },
    { label: "FY21/22", output_gap: -1.2, capb: -2.0 },
    { label: "FY22/23", output_gap:  0.6, capb: -1.2 },
    { label: "FY23/24", output_gap:  0.1, capb: -1.0 },
    { label: "FY24/25", output_gap: -0.5, capb: -1.3 },
    { label: "FY25/26", output_gap: -0.3, capb: -1.5 },
  ];
}

const {
  data = defaultData(),
  asOf = "FY25/26",
  ariaLabel = `Fiscal stance vs cycle: CAPB and output gap, ${asOf}`,
} = Astro.props;

// ---- Geometry --------------------------------------------------------------
const VB_W = 720;
const VB_H = 440;
const M_T = 32;
const M_B = 44;
const M_L = 70;
const M_R = 32;
const PLOT_X0 = M_L;
const PLOT_Y0 = M_T;
const PLOT_W = VB_W - M_L - M_R;
const PLOT_H = VB_H - M_T - M_B;
const PLOT_X1 = PLOT_X0 + PLOT_W;
const PLOT_Y1 = PLOT_Y0 + PLOT_H;

// Symmetric axes.
const X_MIN = -7;
const X_MAX = 3;
const Y_MIN = -9;
const Y_MAX = 2;
const xTicks = [-6, -4, -2, 0, 2];
const yTicks = [-8, -6, -4, -2, 0, 2];

function xScale(v: number): number {
  return PLOT_X0 + ((v - X_MIN) / (X_MAX - X_MIN)) * PLOT_W;
}
function yScale(v: number): number {
  return PLOT_Y0 + PLOT_H - ((v - Y_MIN) / (Y_MAX - Y_MIN)) * PLOT_H;
}

const points = data.map((p) => ({ ...p, x: xScale(p.output_gap), y: yScale(p.capb) }));
const connector = points
  .map((p, i) => `${i === 0 ? "M" : "L"}${p.x.toFixed(2)} ${p.y.toFixed(2)}`)
  .join(" ");

const last = points[points.length - 1];
const prior = points.slice(0, -1);
---
<div class="policy-panel-6" aria-label={ariaLabel}>
  <svg
    class="policy-panel-6__svg"
    viewBox={`0 0 ${VB_W} ${VB_H}`}
    preserveAspectRatio="xMidYMid meet"
    role="img"
    aria-label={ariaLabel}
  >
    {/* X gridlines */}
    {xTicks.map((v) => (
      <line
        class:list={["policy-panel-6__gridline", { "policy-panel-6__gridline--zero": v === 0 }]}
        x1={xScale(v).toFixed(2)}
        y1={PLOT_Y0.toFixed(2)}
        x2={xScale(v).toFixed(2)}
        y2={PLOT_Y1.toFixed(2)}
      />
    ))}
    {/* Y gridlines */}
    {yTicks.map((v) => (
      <line
        class:list={["policy-panel-6__gridline", { "policy-panel-6__gridline--zero": v === 0 }]}
        x1={PLOT_X0.toFixed(2)}
        y1={yScale(v).toFixed(2)}
        x2={PLOT_X1.toFixed(2)}
        y2={yScale(v).toFixed(2)}
      />
    ))}

    {/* Quadrant labels - micro caps in the corners */}
    <text
      class="policy-panel-6__quad-label"
      x={(PLOT_X1 - 6).toFixed(2)}
      y={(PLOT_Y0 + 12).toFixed(2)}
      text-anchor="end"
    >Countercyclical tightening</text>
    <text
      class="policy-panel-6__quad-label"
      x={(PLOT_X1 - 6).toFixed(2)}
      y={(PLOT_Y1 - 6).toFixed(2)}
      text-anchor="end"
    >Procyclical loosening</text>
    <text
      class="policy-panel-6__quad-label"
      x={(PLOT_X0 + 6).toFixed(2)}
      y={(PLOT_Y0 + 12).toFixed(2)}
      text-anchor="start"
    >Procyclical tightening</text>
    <text
      class="policy-panel-6__quad-label"
      x={(PLOT_X0 + 6).toFixed(2)}
      y={(PLOT_Y1 - 6).toFixed(2)}
      text-anchor="start"
    >Countercyclical loosening</text>

    {/* Connector trace */}
    <path class="policy-panel-6__connector" d={connector} fill="none" />

    {/* Prior-year open circles */}
    {prior.map((p) => (
      <circle
        class="policy-panel-6__dot-prior"
        cx={p.x.toFixed(2)}
        cy={p.y.toFixed(2)}
        r="3.5"
      >
        <title>{`${p.label}: gap ${p.output_gap.toFixed(1)}, CAPB ${p.capb.toFixed(1)}`}</title>
      </circle>
    ))}

    {/* Latest filled MTA red */}
    <circle
      class="policy-panel-6__dot-now"
      cx={last.x.toFixed(2)}
      cy={last.y.toFixed(2)}
      r="4.5"
    >
      <title>{`${last.label}: gap ${last.output_gap.toFixed(1)}, CAPB ${last.capb.toFixed(1)}`}</title>
    </circle>

    {/* Year labels on every other point so they don't crowd */}
    {points.map((p, i) => {
      if (i % 2 !== 0 && i !== points.length - 1) return null;
      const isLast = i === points.length - 1;
      return (
        <text
          class:list={["policy-panel-6__pt-label", { "policy-panel-6__pt-label--last": isLast }]}
          x={(p.x + 6).toFixed(2)}
          y={(p.y - 5).toFixed(2)}
          text-anchor="start"
        >{p.label.replace("FY", "")}</text>
      );
    })}

    {/* Frame */}
    <rect
      class="policy-panel-6__frame"
      x={PLOT_X0.toFixed(2)}
      y={PLOT_Y0.toFixed(2)}
      width={PLOT_W.toFixed(2)}
      height={PLOT_H.toFixed(2)}
      fill="none"
    />

    {/* Y-tick labels */}
    {yTicks.map((v, i) => (
      <text
        class="policy-panel-6__ytick-label"
        x={(PLOT_X0 - 6).toFixed(2)}
        y={(yScale(v) + 3.5).toFixed(2)}
        text-anchor="end"
      >{i === yTicks.length - 1 ? `${v > 0 ? "+" : ""}${v}%` : `${v > 0 ? "+" : ""}${v}`}</text>
    ))}

    {/* X-tick labels */}
    {xTicks.map((v) => (
      <text
        class="policy-panel-6__xtick-label"
        x={xScale(v).toFixed(2)}
        y={(PLOT_Y1 + 16).toFixed(2)}
        text-anchor="middle"
      >{`${v > 0 ? "+" : ""}${v}`}</text>
    ))}

    {/* Axis titles */}
    <text
      class="policy-panel-6__axis-title"
      x={(PLOT_X0 + PLOT_W / 2).toFixed(2)}
      y={(PLOT_Y1 + 32).toFixed(2)}
      text-anchor="middle"
    >Output gap (% of potential GDP)</text>
    <text
      class="policy-panel-6__axis-title"
      x={(PLOT_X0 - 50).toFixed(2)}
      y={(PLOT_Y0 + PLOT_H / 2).toFixed(2)}
      text-anchor="middle"
      transform={`rotate(-90, ${(PLOT_X0 - 50).toFixed(2)}, ${(PLOT_Y0 + PLOT_H / 2).toFixed(2)})`}
    >CAPB (% of potential GDP)</text>
  </svg>
</div>

<style>
  .policy-panel-6 {
    width: 100%;
    aspect-ratio: 720 / 440;
    background-color: var(--surface);
  }
  .policy-panel-6__svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    font-family: var(--font-sans);
  }
  .policy-panel-6__gridline {
    stroke: var(--rule);
    stroke-width: 1;
    stroke-opacity: 0.18;
    shape-rendering: crispEdges;
  }
  .policy-panel-6__gridline--zero {
    stroke: var(--ink);
    stroke-opacity: 1;
  }
  .policy-panel-6__frame {
    stroke: var(--ink);
    stroke-width: 1;
    shape-rendering: crispEdges;
  }
  .policy-panel-6__connector {
    stroke: var(--ink);
    stroke-width: 1;
    stroke-opacity: 0.55;
    fill: none;
  }
  .policy-panel-6__dot-prior {
    fill: var(--surface);
    stroke: var(--ink);
    stroke-width: 1.25;
  }
  .policy-panel-6__dot-now {
    fill: var(--accent);
  }
  .policy-panel-6__pt-label {
    fill: var(--ink);
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: var(--fw-regular);
    font-variant-numeric: tabular-nums;
    opacity: 0.65;
  }
  .policy-panel-6__pt-label--last {
    opacity: 1;
    font-weight: var(--fw-semibold);
  }
  .policy-panel-6__quad-label {
    fill: var(--ink);
    font-size: 9px;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.10em;
    text-transform: uppercase;
    opacity: 0.50;
  }
  .policy-panel-6__ytick-label,
  .policy-panel-6__xtick-label {
    fill: var(--ink);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: var(--fw-regular);
    font-variant-numeric: tabular-nums;
  }
  .policy-panel-6__axis-title {
    fill: var(--ink);
    font-size: 10px;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.10em;
    text-transform: uppercase;
  }
</style>
