---
/*
 * Panel2MarketPath - 2y GoC vs overnight.
 *
 * Pipeline emits `yield_2yr` (primary, %) and `overnight_rate_daily`
 * (secondary, %). Both share % units; render as the overlay pair.
 *
 * Synthetic-data fallback removed.
 */

import type { PanelData } from "../_shared/panelData";
import PanelLiveChart from "../_shared/PanelLiveChart.astro";
import PanelEmpty from "../_shared/PanelEmpty.astro";

interface Props {
  data?: PanelData | null;
}

const { data = null } = Astro.props;
---
{data && data.primary ? (
  <PanelLiveChart
    primary={data.primary}
    secondary={data.secondary}
    primaryLabel="2y GoC"
    secondaryLabel="Overnight"
    secondaryStep={true}
    dataPanelAttr="policy-2"
    ariaLabel="2-year GoC yield and BoC overnight rate."
  />
) : (
  <PanelEmpty reason="Pipeline did not emit panel-2 data." />
)}
