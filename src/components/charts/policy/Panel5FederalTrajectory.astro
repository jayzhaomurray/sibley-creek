---
/*
 * Panel5FederalTrajectory - federal deficit trajectory.
 *
 * Pipeline emits `dof_fiscal_monthly_balance` (primary, CAD millions)
 * and `dof_fiscal_ytd_balance` (secondary). Editorial argument is
 * deficit YTD plus debt-service growth; the latter is not on disk.
 *
 * Synthetic-data fallback removed.
 */

import type { PanelData } from "../_shared/panelData";
import PanelLiveChart from "../_shared/PanelLiveChart.astro";
import PanelEmpty from "../_shared/PanelEmpty.astro";

interface Props {
  data?: PanelData | null;
}

const { data = null } = Astro.props;
---
{data && data.primary ? (
  <PanelLiveChart
    primary={data.primary}
    secondary={data.secondary}
    primaryLabel="Monthly bal."
    secondaryLabel="YTD balance"
    dataPanelAttr="policy-5"
    ariaLabel="Federal monthly and year-to-date fiscal balance."
  />
) : (
  <PanelEmpty reason="Debt-service growth index not yet emitted." />
)}
