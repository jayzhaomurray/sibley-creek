---
/*
 * Panel4BalanceSheet - BoC balance sheet (default view).
 *
 * Pipeline emits `boc_settlement_balances` (primary, CAD billions) and
 * `boc_total_assets` (secondary). Both CAD billions; rendered together.
 *
 * Wave 5 fold (EDR brief Section 3): CORRA-vs-target spread becomes
 * the secondary view (toggle) once backend lands the derived
 * `corra_target_spread` series. Spread units (%) differ from the
 * balance-sheet level units (CAD billions), so the toggle is a true
 * view-switch and cannot be a single-axis overlay - it is deferred
 * until the centralized toggle pattern lands. For now the panel
 * renders only the balance-sheet pair; backend's CORRA-spread series
 * will arrive in panel meta and the toggle will plug in then.
 *
 * Synthetic-data fallback removed.
 */

import type { PanelData } from "../_shared/panelData";
import PanelLiveChart from "../_shared/PanelLiveChart.astro";
import PanelEmpty from "../_shared/PanelEmpty.astro";

interface Props {
  data?: PanelData | null;
}

const { data = null } = Astro.props;
---
{data && data.primary ? (
  <PanelLiveChart
    primary={data.primary}
    secondary={data.secondary}
    primaryLabel="Settl. bal."
    secondaryLabel="Total assets"
    dataPanelAttr="policy-4"
    ariaLabel="BoC settlement balances and total assets, CAD billions."
  />
) : (
  <PanelEmpty reason="Pipeline did not emit panel-4 data." />
)}
