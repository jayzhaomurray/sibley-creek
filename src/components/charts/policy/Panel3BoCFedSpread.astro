---
/*
 * AUDIT-FLAGGED 2026-05-11 - see design/chart-editorial-audit-2026-05-11.md
 * Improved version: ./Panel3BoCFedSpreadV2.astro
 * Live in production until user reviews comparison page and picks one.
 * Decision pending.
 */
/*
 * Panel3BoCFedSpread - BoC-Fed 2-year spread.
 *
 * Pipeline emits `yield_2yr` (Canada) and `us_2yr` (US) as % series.
 * Spread derivation is not on disk; we render the two raw 2y yields
 * as the primary pair.
 *
 * Synthetic-data fallback removed.
 */

import type { PanelData } from "../_shared/panelData";
import PanelLiveChart from "../_shared/PanelLiveChart.astro";
import PanelEmpty from "../_shared/PanelEmpty.astro";

interface Props {
  data?: PanelData | null;
}

const { data = null } = Astro.props;
---
{data && data.primary ? (
  <PanelLiveChart
    primary={data.primary}
    secondary={data.secondary}
    primaryLabel="2y Canada"
    secondaryLabel="2y US"
    dataPanelAttr="policy-3"
    ariaLabel="Canada and US 2-year yields."
  />
) : (
  <PanelEmpty reason="Spread derivation not yet emitted." />
)}
