---
/*
 * Panel4SubAggregates - inflation sub-aggregates.
 *
 * Pipeline emits `cpi_shelter_yoy` as a Y/Y % primary series. Editorial
 * argument is a ranked horizontal bar chart of multiple sub-aggregates
 * (shelter, services ex-shelter, goods, food, energy); per-aggregate
 * Y/Y series are not all on disk. We render the shelter line as the
 * load-bearing component until the full slate lands.
 *
 * Synthetic-data fallback removed.
 */

import type { PanelData } from "../_shared/panelData";
import PanelLiveChart from "../_shared/PanelLiveChart.astro";
import PanelEmpty from "../_shared/PanelEmpty.astro";

interface Props {
  data?: PanelData | null;
}

const { data = null } = Astro.props;
---
{data && data.primary ? (
  <PanelLiveChart
    primary={data.primary}
    secondary={data.secondary}
    primaryLabel="Shelter y/y"
    dataPanelAttr="inflation-4"
    referenceValue={2}
    referenceLabel="2% BoC target"
    ariaLabel="Shelter CPI year-over-year."
  />
) : (
  <PanelEmpty reason="Per-aggregate Y/Y bar series not yet emitted." />
)}
