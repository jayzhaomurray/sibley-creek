---
/*
 * Panel2CoreTrio - BoC preferred core measures.
 *
 * Pipeline emits `cpi_trim` (primary) and `cpi_median` (secondary) as
 * percent series; both are above-target indicators. Reference rule at
 * the BoC's 2% target. Synthetic-data fallback removed.
 */

import type { PanelData } from "../_shared/panelData";
import PanelLiveChart from "../_shared/PanelLiveChart.astro";
import PanelEmpty from "../_shared/PanelEmpty.astro";

interface Props {
  data?: PanelData | null;
}

const { data = null } = Astro.props;
---
{data && data.primary ? (
  <PanelLiveChart
    primary={data.primary}
    secondary={data.secondary}
    primaryLabel="Core-trim"
    secondaryLabel="Core-median"
    dataPanelAttr="inflation-2"
    referenceValue={2}
    referenceLabel="2% BoC target"
    referenceBand={{ lower: 1, upper: 3, label: "Control range" }}
    ariaLabel="BoC preferred core measures: core-trim and core-median, year-over-year, with the BoC 1-3% control range and 2% target."
  />
) : (
  <PanelEmpty reason="Pipeline did not emit panel-2 data." />
)}
