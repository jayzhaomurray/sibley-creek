---
/*
 * Panel3Breadth - breadth of price pressure.
 *
 * Editorial argument is "share of CPI basket running above 3% Y/Y" -
 * a constructed share series. The pipeline emits the raw `cpi_components`
 * index (per-component); the breadth derivation is not on disk. Until
 * the share series lands we fall back to PanelEmpty.
 *
 * Synthetic-data fallback removed.
 */

import type { PanelData } from "../_shared/panelData";
import PanelLiveChart from "../_shared/PanelLiveChart.astro";
import PanelEmpty from "../_shared/PanelEmpty.astro";

interface Props {
  data?: PanelData | null;
}

const { data = null } = Astro.props;
---
{data && data.primary && data.primary.unit === "%" ? (
  <PanelLiveChart
    primary={data.primary}
    secondary={data.secondary}
    primaryLabel="Share >3%"
    dataPanelAttr="inflation-3"
    ariaLabel="Share of CPI basket running above 3% year-over-year."
  />
) : (
  <PanelEmpty reason="Breadth share-of-basket derivation not yet emitted." />
)}
