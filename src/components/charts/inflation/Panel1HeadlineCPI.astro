---
/*
 * Panel1HeadlineCPI - headline CPI Y/Y, single-series time series.
 *
 * Vignelli v1.0 canon-compliant rebuild (2026-05-11). Anchors to
 * src/components/charts/_canon_reference/PanelCanonReference.astro.
 * This panel's editorial argument is the cleanest single-series read
 * in the publication; the canon's single-series shape applies wholesale.
 *
 * Primary = headline Y/Y (pure ink 1.5px solid, MTA red latest dot,
 * Manrope 600 "CPI Y/Y" direct label). Secondary = 3M annualized (pure
 * ink 1px dashed `4 2`, no dot, Manrope 400 "3M AR" direct label).
 * Reference rule at 2% BoC target. Recession band for 2020Q1-Q2 (mostly
 * outside the 5-year window).
 *
 * Data contract preserved: { date, yoy, mom3_ar? }.
 */

interface DataPoint {
  date: string;
  yoy: number;
  mom3_ar?: number;
}

interface Props {
  data?: DataPoint[];
  asOf?: string;
  recentAnnotation?: string;
}

const {
  data: dataIn,
  asOf = "Apr 2026",
  recentAnnotation = "**Apr** print held at 2.1%, fourth month at target.",
} = Astro.props;

function buildPlaceholder(): DataPoint[] {
  const out: DataPoint[] = [];
  let y = 2021;
  let m = 5;
  for (let i = 0; i < 60; i++) {
    const t = i / 59;
    let yoy: number;
    if (t < 0.27) yoy = 3.4 + (8.1 - 3.4) * (t / 0.27);
    else if (t < 0.55) yoy = 8.1 - (8.1 - 3.1) * ((t - 0.27) / 0.28);
    else if (t < 0.78) yoy = 3.1 - (3.1 - 2.0) * ((t - 0.55) / 0.23);
    else yoy = 2.0 + 0.25 * Math.sin((t - 0.78) * 18);
    yoy = Math.round(yoy * 100) / 100;
    let ar: number;
    const tLead = Math.min(1, t + 0.04);
    if (tLead < 0.27) ar = 3.4 + (8.1 - 3.4) * (tLead / 0.27);
    else if (tLead < 0.55) ar = 8.1 - (8.1 - 3.1) * ((tLead - 0.27) / 0.28);
    else if (tLead < 0.78) ar = 3.1 - (3.1 - 2.0) * ((tLead - 0.55) / 0.23);
    else ar = 2.0 + 0.20 * Math.sin((tLead - 0.78) * 18);
    if (i >= 57) ar = yoy - 0.4;
    ar = Math.round(ar * 100) / 100;
    out.push({ date: `${y}-${String(m).padStart(2, "0")}`, yoy, mom3_ar: ar });
    m += 1;
    if (m > 12) { m = 1; y += 1; }
  }
  return out;
}

const data: DataPoint[] = dataIn && dataIn.length > 0 ? dataIn : buildPlaceholder();

// ---- Geometry --------------------------------------------------------------
const VB_W = 720;
const VB_H = 405;
const M_L = 56;
const M_R = 88;
const M_T = 44;
const M_B = 40;
const PLOT_X0 = M_L;
const PLOT_Y0 = M_T;
const PLOT_W = VB_W - M_L - M_R;
const PLOT_H = VB_H - M_T - M_B;
const PLOT_X1 = PLOT_X0 + PLOT_W;
const PLOT_Y1 = PLOT_Y0 + PLOT_H;

function decYearOf(d: string): number {
  const [ys, ms] = d.split("-");
  return Number(ys) + (Number(ms) - 0.5) / 12;
}
const decYears = data.map((d) => decYearOf(d.date));
const xMin = decYears[0];
const xMax = decYears[decYears.length - 1];

const ys = data.map((d) => d.yoy);
const rawMin = Math.min(...ys, 2);
const rawMax = Math.max(...ys, 2);
const yPad = (rawMax - rawMin) * 0.10;
const yLo = Math.floor(rawMin - yPad);
const yHi = Math.ceil(rawMax + yPad);
const crossesZero = yLo < 0 && yHi > 0;

function xScale(yr: number): number {
  return PLOT_X0 + ((yr - xMin) / (xMax - xMin)) * PLOT_W;
}
function yScale(v: number): number {
  return PLOT_Y0 + PLOT_H - ((v - yLo) / (yHi - yLo)) * PLOT_H;
}

function buildLine(values: Array<number | undefined>): string {
  let d = "";
  let started = false;
  for (let i = 0; i < values.length; i++) {
    const v = values[i];
    if (v === undefined || Number.isNaN(v)) continue;
    const x = xScale(decYears[i]).toFixed(2);
    const y = yScale(v).toFixed(2);
    d += `${started ? "L" : "M"}${x} ${y} `;
    started = true;
  }
  return d.trim();
}
const yoyPath = buildLine(data.map((d) => d.yoy));
const arPath = buildLine(data.map((d) => d.mom3_ar));

// ---- Latest --------------------------------------------------------------
const last = data[data.length - 1];
const lastX = xScale(decYears[decYears.length - 1]);
const lastYoyY = yScale(last.yoy);
const lastArY = last.mom3_ar !== undefined ? yScale(last.mom3_ar) : null;

// ---- Y ticks -------------------------------------------------------------
function pickStride(lo: number, hi: number): number {
  const span = hi - lo;
  for (const s of [1, 2, 2.5, 5]) {
    const n = Math.round(span / s);
    if (n >= 3 && n <= 5) return s;
  }
  return Math.max(1, Math.round(span / 4));
}
const yStride = pickStride(yLo, yHi);
const yTicks: number[] = [];
for (let v = yLo; v <= yHi + 1e-9; v += yStride) yTicks.push(Number(v.toFixed(2)));

// ---- X ticks -------------------------------------------------------------
const yearStart = Math.ceil(xMin);
const yearEnd = Math.floor(xMax);
const allYearTicks: Array<{ x: number; label: string }> = [];
for (let yr = yearStart; yr <= yearEnd; yr++) {
  const decY = yr + (1 - 0.5) / 12;
  if (decY < xMin || decY > xMax) continue;
  allYearTicks.push({ x: xScale(decY), label: String(yr) });
}
const xTickStride = Math.max(1, Math.ceil(allYearTicks.length / 5));
const xTicks = allYearTicks.filter((_, i) => i % xTickStride === 0);

// ---- Reference rule -------------------------------------------------------
const targetVal = 2;
const showRef = targetVal >= yLo && targetVal <= yHi;
const targetY = yScale(targetVal);

// ---- Recession ------------------------------------------------------------
const recStart = 2020 + (2 - 0.5) / 12;
const recEnd = 2020 + (4 - 0.5) / 12;
const recVisible = recEnd >= xMin && recStart <= xMax;
const recX0 = recVisible ? xScale(Math.max(recStart, xMin)) : 0;
const recX1 = recVisible ? xScale(Math.min(recEnd, xMax)) : 0;

// ---- Annotation ----------------------------------------------------------
function parseAnchor(s: string): Array<{ text: string; bold: boolean }> {
  const parts: Array<{ text: string; bold: boolean }> = [];
  const re = /\*\*([^*]+)\*\*/g;
  let last = 0;
  let m: RegExpExecArray | null;
  while ((m = re.exec(s)) !== null) {
    if (m.index > last) parts.push({ text: s.slice(last, m.index), bold: false });
    parts.push({ text: m[1], bold: true });
    last = m.index + m[0].length;
  }
  if (last < s.length) parts.push({ text: s.slice(last), bold: false });
  return parts;
}
const annoParts = recentAnnotation ? parseAnchor(recentAnnotation) : [];
const annoX0 = PLOT_X0 + 18;
const annoY0 = PLOT_Y0 + 22;
const annoMaxWidth = PLOT_W * 0.50;
const leaderStartX = annoX0 + Math.min(annoMaxWidth, 220);
const leaderStartY = annoY0 - 4;
const leaderEndX = lastX - 7;
const leaderEndY = lastYoyY;

const ariaLabel = `Headline CPI year-over-year and 3-month annualized, ${asOf}: ${last.yoy.toFixed(1)}% Y/Y. Latest print is the most recent month.`;
---
<div class="canon-chart" data-panel="inflation-1">
  <svg
    class="canon-chart__svg"
    viewBox={`0 0 ${VB_W} ${VB_H}`}
    preserveAspectRatio="xMidYMid meet"
    role="img"
    aria-label={ariaLabel}
  >
    {recVisible && (
      <g>
        <rect class="canon-chart__recession" x={recX0.toFixed(2)} y={PLOT_Y0}
          width={Math.max(1, recX1 - recX0).toFixed(2)} height={PLOT_H} />
        <text class="canon-chart__recession-label"
          x={((recX0 + recX1) / 2).toFixed(2)} y={(PLOT_Y0 + 12).toFixed(2)}
          text-anchor="middle">RECESSION (2020Q1-Q2)</text>
      </g>
    )}

    {yTicks.map((v) => {
      const y = yScale(v);
      if (crossesZero && Math.abs(v) < 1e-9) return null;
      return <line class="canon-chart__gridline"
        x1={PLOT_X0} y1={y.toFixed(2)} x2={PLOT_X1} y2={y.toFixed(2)} />;
    })}

    {crossesZero && (
      <line class="canon-chart__zero-line"
        x1={PLOT_X0} y1={yScale(0).toFixed(2)} x2={PLOT_X1} y2={yScale(0).toFixed(2)} />
    )}

    {showRef && (
      <g class="canon-chart__reference-group">
        <line class="canon-chart__reference-rule"
          x1={PLOT_X0} y1={targetY.toFixed(2)} x2={PLOT_X1} y2={targetY.toFixed(2)} />
        <text class="canon-chart__reference-label"
          x={(PLOT_X1 - 6).toFixed(2)} y={(targetY - 5).toFixed(2)}
          text-anchor="end">2% BoC target</text>
      </g>
    )}

    {/* Secondary: 3M AR dashed */}
    {arPath && (
      <path class="canon-chart__line-secondary" d={arPath} fill="none" />
    )}

    {/* Primary: Y/Y solid */}
    <path class="canon-chart__line" d={yoyPath} fill="none" />

    {/* Hit areas */}
    {data.map((d, i) => {
      const x = xScale(decYears[i]);
      return (
        <circle class="canon-chart__hit" cx={x.toFixed(2)} cy={yScale(d.yoy).toFixed(2)} r="4">
          <title>{`${d.date}: ${d.yoy.toFixed(1)}% Y/Y`}</title>
        </circle>
      );
    })}

    <circle class="canon-chart__latest-dot" cx={lastX.toFixed(2)} cy={lastYoyY.toFixed(2)} r="4">
      <title>{`Latest: ${last.date}: ${last.yoy.toFixed(1)}% Y/Y`}</title>
    </circle>

    <rect class="canon-chart__frame" x={PLOT_X0} y={PLOT_Y0} width={PLOT_W} height={PLOT_H} />

    {xTicks.map((t) => (
      <g>
        <line class="canon-chart__xtick" x1={t.x.toFixed(2)} y1={PLOT_Y1.toFixed(2)}
          x2={t.x.toFixed(2)} y2={(PLOT_Y1 + 4).toFixed(2)} />
        <text class="canon-chart__xtick-label" x={t.x.toFixed(2)} y={(PLOT_Y1 + 18).toFixed(2)}
          text-anchor="middle">{t.label}</text>
      </g>
    ))}

    {yTicks.map((v, i) => {
      const y = yScale(v);
      const isTop = i === yTicks.length - 1;
      const sign = v > 0 ? "+" : "";
      const num = `${sign}${v.toFixed(0)}`;
      const txt = isTop ? `${num}%` : num;
      return <text class="canon-chart__ytick-label" x={(PLOT_X0 - 8).toFixed(2)} y={(y + 4).toFixed(2)}
        text-anchor="end">{txt}</text>;
    })}

    <text class="canon-chart__direct-label" x={(lastX + 10).toFixed(2)} y={(lastYoyY + 4).toFixed(2)}
      text-anchor="start">CPI Y/Y</text>
    {lastArY !== null && (
      <text class="canon-chart__direct-label-secondary" x={(lastX + 10).toFixed(2)} y={(lastArY + 4).toFixed(2)}
        text-anchor="start">3M AR</text>
    )}

    {recentAnnotation && (
      <g class="canon-chart__annotation">
        <line class="canon-chart__anno-leader"
          x1={leaderStartX.toFixed(2)} y1={leaderStartY.toFixed(2)}
          x2={leaderEndX.toFixed(2)} y2={leaderEndY.toFixed(2)} />
        <foreignObject x={annoX0.toFixed(2)} y={(annoY0 - 18).toFixed(2)}
          width={annoMaxWidth.toFixed(2)} height="44">
          <p class="canon-chart__anno-text">
            {annoParts.map((part) =>
              part.bold
                ? <strong class="canon-chart__anno-anchor">{part.text}</strong>
                : <span>{part.text}</span>
            )}
          </p>
        </foreignObject>
      </g>
    )}
  </svg>
</div>

<style>
  .canon-chart { width: 100%; aspect-ratio: 16 / 9; background-color: var(--paper); overflow: visible; }
  .canon-chart__svg { display: block; width: 100%; height: 100%; overflow: visible; font-family: var(--font-sans); }
  .canon-chart__recession { fill: rgba(21, 23, 26, 0.06); }
  .canon-chart__recession-label {
    fill: var(--ink); font-family: var(--font-sans);
    font-size: 11px; font-weight: var(--fw-semibold); letter-spacing: 0.18em;
  }
  .canon-chart__gridline { stroke: var(--ink); stroke-width: 1; stroke-opacity: 0.18; shape-rendering: crispEdges; }
  .canon-chart__zero-line { stroke: var(--ink); stroke-width: 1; stroke-opacity: 1; shape-rendering: crispEdges; }
  .canon-chart__reference-rule { stroke: var(--ink); stroke-width: 1; stroke-dasharray: 4 2; shape-rendering: crispEdges; }
  .canon-chart__reference-label {
    fill: var(--ink); font-family: var(--font-sans);
    font-size: 12px; font-weight: var(--fw-semibold); letter-spacing: 0.04em;
  }
  .canon-chart__line {
    stroke: var(--ink); stroke-width: 1.5; stroke-linejoin: round; stroke-linecap: round;
    fill: none; vector-effect: non-scaling-stroke;
  }
  .canon-chart__line-secondary {
    stroke: var(--ink); stroke-width: 1; stroke-dasharray: 4 2;
    stroke-linejoin: round; stroke-linecap: butt; fill: none; vector-effect: non-scaling-stroke;
  }
  .canon-chart__hit { fill: transparent; pointer-events: all; }
  .canon-chart__latest-dot { fill: var(--accent); stroke: none; }
  .canon-chart__frame { fill: none; stroke: var(--ink); stroke-width: 1; shape-rendering: crispEdges; }
  .canon-chart__xtick { stroke: var(--ink); stroke-width: 1; shape-rendering: crispEdges; }
  .canon-chart__xtick-label {
    fill: var(--ink); font-family: var(--font-sans);
    font-size: 12px; font-weight: var(--fw-regular); font-variant-numeric: tabular-nums;
  }
  .canon-chart__ytick-label {
    fill: var(--ink); font-family: var(--font-mono);
    font-size: 12px; font-weight: var(--fw-regular); font-variant-numeric: tabular-nums;
  }
  .canon-chart__direct-label {
    fill: var(--ink); font-family: var(--font-sans);
    font-size: 13px; font-weight: var(--fw-semibold);
  }
  .canon-chart__direct-label-secondary {
    fill: var(--ink); font-family: var(--font-sans);
    font-size: 13px; font-weight: var(--fw-regular);
  }
  .canon-chart__anno-leader { stroke: var(--ink); stroke-width: 1; shape-rendering: crispEdges; fill: none; }
  .canon-chart__anno-text {
    margin: 0; color: var(--ink); font-family: var(--font-sans);
    font-size: 15px; font-weight: var(--fw-regular); line-height: 1.30;
  }
  .canon-chart__anno-anchor { font-weight: var(--fw-semibold); }
</style>
