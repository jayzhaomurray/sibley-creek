---
/*
 * Panel1HeadlineCPI - headline CPI Y/Y, single-series time series.
 *
 * Pipeline emits `cpi_all_items_yoy` directly as a Y/Y % series, which
 * matches this panel's editorial argument cleanly. Reference rule at
 * the BoC's 2% target. Synthetic-data fallback removed.
 *
 * Wave 5 fold (EDR brief Section 3, methodology C.4): CPI
 * ex-indirect-taxes overlay toggle is **Phase 2, not this wave** -
 * gated on backend wiring the StatCan ex-indirect-taxes vector (Table
 * 18-10-0004-13 candidate). Wrapper is intentionally not touched in
 * Wave 5; the toggle work returns when the data lands.
 */

import type { PanelData } from "../_shared/panelData";
import PanelLiveChart from "../_shared/PanelLiveChart.astro";
import PanelEmpty from "../_shared/PanelEmpty.astro";

interface Props {
  data?: PanelData | null;
}

const { data = null } = Astro.props;
---
{data && data.primary ? (
  <PanelLiveChart
    primary={data.primary}
    secondary={null}
    primaryLabel="CPI Y/Y"
    dataPanelAttr="inflation-1"
    referenceValue={2}
    referenceLabel="2% BoC target"
    referenceBand={{ lower: 1, upper: 3, label: "Control range" }}
    ariaLabel="Headline CPI year-over-year, with the BoC 1-3% control range and 2% target. Latest print is the most recent month."
  />
) : (
  <PanelEmpty reason="Pipeline did not emit panel-1 data." />
)}
