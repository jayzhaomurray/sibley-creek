---
/*
 * Panel5Expectations - inflation expectations.
 *
 * Pipeline emits `infl_exp_consumer_1y` (primary) and
 * `infl_exp_consumer_5y` (secondary) as Y/Y % series. Both are
 * directly renderable. Reference rule at 2% BoC target.
 *
 * Wave 5 fold (EDR brief Sections 3 and C.3): BOS firms-expecting->3%
 * (single line) and BOS distribution buckets (four-line stack,
 * below-1% / 1-2% / 2-3% / above-3%) added as secondary toggle views.
 * Default view stays as CSCE 1y + 5y consumer expectations. BOS
 * inputs (`bos_dist_*.csv`, `infl_exp_above3.csv`) are on disk per
 * EDR brief; full toggle UI is deferred until the centralized toggle
 * pattern lands.
 *
 * Synthetic-data fallback removed.
 */

import type { PanelData } from "../_shared/panelData";
import PanelLiveChart from "../_shared/PanelLiveChart.astro";
import PanelEmpty from "../_shared/PanelEmpty.astro";

interface Props {
  data?: PanelData | null;
}

const { data = null } = Astro.props;
---
{data && data.primary ? (
  <PanelLiveChart
    primary={data.primary}
    secondary={data.secondary}
    primaryLabel="1y consumer"
    secondaryLabel="5y consumer"
    dataPanelAttr="inflation-5"
    referenceValue={2}
    referenceLabel="2% BoC target"
    ariaLabel="Consumer inflation expectations, 1-year and 5-year."
  />
) : (
  <PanelEmpty reason="Pipeline did not emit panel-5 data." />
)}
