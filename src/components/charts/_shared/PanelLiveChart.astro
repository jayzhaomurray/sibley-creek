---
/*
 * PanelLiveChart - canonical rendering of a single panel's real data
 * from the pipeline shape `{ primary, secondary }`.
 *
 * This component preserves the Vignelli v1.0 canon visual identity
 * (viewBox 720x405, 1px hairline frame, pure-ink lines, MTA red latest
 * dot, dashed-4-2 secondary, recession band, Plex Mono y-ticks, Manrope
 * x-ticks, topmost y-tick carries the unit) for any panel whose
 * editorial argument can be expressed as a primary line (optionally
 * with a secondary overlay).
 *
 * Panel*.astro components delegate here when their pipeline data is
 * present. When the pipeline emits a series whose semantic does NOT
 * match the panel's editorial argument (e.g. the panel wants m/m %
 * but the pipeline emits levels), the Panel*.astro component is
 * responsible for the transformation OR for routing to PanelEmpty.
 *
 * Geometry numbers (VB_W=720, VB_H=405, margins) are pinned to canon;
 * they match Panel1HeadlineGDP.astro and PanelCanonReference.astro.
 * Do NOT change geometry here without coordinating with chart-builder.
 */

import type { PanelSeries, SeriesPoint } from "./panelData";
import { decYear, tailWindow } from "./panelData";
import {
  fmtTick as fmtTickKind,
  fmtValue,
  inferKindFromUnit,
  unitScaleFactor,
  type ValueKind,
} from "./format";

interface Props {
  primary: PanelSeries;
  secondary?: PanelSeries | null;
  /**
   * Optional third series. Canon multi-series adaptation: rendered as 1px
   * pure-ink stroke-dasharray "2 3" (sparser dash than secondary's "4 2");
   * no latest-print red dot (the MTA-red stamp is reserved for the primary).
   * Suppressed when its unit disagrees with the primary, identically to
   * the secondary series. Defaults to null so existing two-series panels
   * see zero visual change.
   */
  tertiary?: PanelSeries | null;
  /** Direct-label for the primary series. Manrope 600 at the line terminus. */
  primaryLabel?: string;
  /** Direct-label for the secondary series. Manrope 400 at the line terminus. */
  secondaryLabel?: string;
  /** Direct-label for the tertiary series. Manrope 400 at the line terminus. */
  tertiaryLabel?: string;
  /** Number of months of history to display. Default 60 (5 years). */
  windowMonths?: number;
  /** ARIA label override. */
  ariaLabel?: string;
  /**
   * Render the primary series as a step-after line (hold the previous value
   * horizontally to the next observation, then jump vertically to the new
   * value). Reserved for POLICY RATES, which are constant between discrete
   * decision dates - a smooth linear interpolation implies a gradual move
   * that did not happen. Default false (existing market / macro series stay
   * linear).
   */
  primaryStep?: boolean;
  /** Step-after rendering for the secondary series. Default false. */
  secondaryStep?: boolean;
  /** Step-after rendering for the tertiary series. Default false. */
  tertiaryStep?: boolean;
  /** Reference rule value (eg 2 for the BoC target). */
  referenceValue?: number | null;
  /** Reference rule label (eg "2% BoC target"). */
  referenceLabel?: string | null;
  /**
   * Optional secondary reference rule value (eg the historical average for
   * the secondary series in a dual-band panel). Same dashed-4-2 1px ink
   * treatment as the primary reference rule; labels obey Rule L4
   * suppression.
   */
  referenceValueSecondary?: number | null;
  /** Optional secondary reference rule label. */
  referenceLabelSecondary?: string | null;
  /**
   * Optional reference BAND (horizontal range shaded across the full plot
   * width). Used to show editorially-meaningful zones rather than a single
   * line - e.g. the BoC's 2.25-3.25% nominal neutral range on the policy
   * panel. Drawn behind the data line, in front of the recession band.
   * The y-domain auto-expands to keep both bounds in the visible plot.
   * Defaults to null so existing panels see zero visual change.
   */
  referenceBand?: { lower: number; upper: number; label?: string } | null;
  /** Position of the band label relative to the band rect.
   *  "above" (default) places the label just above the band's upper edge —
   *  works for charts where the data line stays below or inside the band.
   *  "below" places the label just below the band's lower edge — required
   *  for charts where the data line crosses the band's TOP edge at the
   *  leftmost x (i.e., the line starts above the band on the historical
   *  side, like inflation core measures during the 2022-23 spike). */
  bandLabelPosition?: "above" | "below";
  /** data-panel attribute for QA / theming hooks. */
  dataPanelAttr?: string;
}

const {
  primary,
  secondary = null,
  tertiary = null,
  primaryLabel,
  secondaryLabel,
  tertiaryLabel,
  windowMonths = 60,
  ariaLabel,
  primaryStep = false,
  secondaryStep = false,
  tertiaryStep = false,
  referenceValue = null,
  referenceLabel = null,
  referenceValueSecondary = null,
  referenceLabelSecondary = null,
  referenceBand = null,
  bandLabelPosition = "above",
  dataPanelAttr,
} = Astro.props;

// ---- Trim to display window ----------------------------------------------
const primDataFull: SeriesPoint[] = tailWindow(primary.data, windowMonths, primary.frequency);
const secDataFull: SeriesPoint[] = secondary
  ? tailWindow(secondary.data, windowMonths, secondary.frequency)
  : [];
const terDataFull: SeriesPoint[] = tertiary
  ? tailWindow(tertiary.data, windowMonths, tertiary.frequency)
  : [];

// ---- Polyline simplification --------------------------------------------
// Long daily series (520 trading days = 2y) make a polyline with hundreds
// of vertices that render slowly and produce visually-indistinguishable
// detail at the chart's display scale (~720px wide, ~330px tall plot).
// When the trimmed series is longer than POLYLINE_TARGET_VERTICES, decimate
// by every Nth point while preserving the LAST observation (the latest-dot
// must remain aligned to the real latest print). For monthly series this
// is a no-op (< 300 vertices in any realistic window).
const POLYLINE_TARGET_VERTICES = 300;
function decimate(series: SeriesPoint[]): SeriesPoint[] {
  if (series.length <= POLYLINE_TARGET_VERTICES) return series;
  const stride = Math.ceil(series.length / POLYLINE_TARGET_VERTICES);
  const out: SeriesPoint[] = [];
  for (let i = 0; i < series.length; i += stride) out.push(series[i]!);
  const last = series[series.length - 1]!;
  if (out[out.length - 1] !== last) out.push(last);
  return out;
}
const primData: SeriesPoint[] = decimate(primDataFull);
const secData: SeriesPoint[] = decimate(secDataFull);
const terData: SeriesPoint[] = decimate(terDataFull);

// ---- Geometry (pinned to canon) ------------------------------------------
const VB_W = 720;
const VB_H = 405;
const M_L = 56;
const M_R = 96;
const M_T = 44;
const M_B = 40;
const PLOT_X0 = M_L;
const PLOT_Y0 = M_T;
const PLOT_W = VB_W - M_L - M_R;
const PLOT_H = VB_H - M_T - M_B;
const PLOT_X1 = PLOT_X0 + PLOT_W;
const PLOT_Y1 = PLOT_Y0 + PLOT_H;

// ---- x-domain spans all series so they share an axis --------------------
const primX = primData.map((d) => decYear(d.date)).filter((v) => !Number.isNaN(v));
const secX = secData.map((d) => decYear(d.date)).filter((v) => !Number.isNaN(v));
const terX = terData.map((d) => decYear(d.date)).filter((v) => !Number.isNaN(v));
const xs = primX.concat(secX).concat(terX);
const xMin = xs.length > 0 ? Math.min(...xs) : 0;
const xMax = xs.length > 0 ? Math.max(...xs) : 1;

// ---- y-domain: span both series, only padded if we can. Two-series
//      readings only share an axis when the units agree; if the units
//      disagree (eg primary "%" and secondary "Index"), we suppress the
//      secondary to avoid a misleading dual-axis overlay.
const unitsMatch = secondary
  ? (primary.unit ?? "").toLowerCase() === (secondary.unit ?? "").toLowerCase()
  : false;
const terUnitsMatch = tertiary
  ? (primary.unit ?? "").toLowerCase() === (tertiary.unit ?? "").toLowerCase()
  : false;
const sharedSeries: number[] = primData
  .map((d) => d.value)
  .filter((v): v is number => typeof v === "number" && !Number.isNaN(v));
if (unitsMatch) {
  for (const d of secData) {
    if (typeof d.value === "number" && !Number.isNaN(d.value)) sharedSeries.push(d.value);
  }
}
if (terUnitsMatch) {
  for (const d of terData) {
    if (typeof d.value === "number" && !Number.isNaN(d.value)) sharedSeries.push(d.value);
  }
}
// Y-extent strategy: full min/max for short series; 2nd-98th percentile
// for long daily series. Daily prints carry single-day spikes (news days,
// settlement-balance reporting glitches) that push raw min/max far past
// the visible signal range and squash the line to a horizontal stroke at
// the mean. Percentile clipping at 100+ points (~5 trading months) is the
// industry-standard fix - we pad 10% past the clipped range so the
// signal still breathes inside the frame. Threshold of 100 matches the
// dispatch spec; documented for the next chart-builder reading this.
const Y_PERCENTILE_THRESHOLD = 100;
function pickYBounds(values: number[]): [number, number] {
  if (values.length === 0) return [0, 1];
  if (values.length < Y_PERCENTILE_THRESHOLD) {
    return [Math.min(...values), Math.max(...values)];
  }
  const sorted = [...values].sort((a, b) => a - b);
  const loIdx = Math.floor(sorted.length * 0.02);
  const hiIdx = Math.ceil(sorted.length * 0.98) - 1;
  return [sorted[loIdx]!, sorted[Math.max(loIdx, hiIdx)]!];
}
let yLo = 0;
let yHi = 1;
// Track the TRUE raw min/max (no percentile clipping) so downstream logic
// can decide whether the data line will overflow the visible plot frame.
// A spike-clipped series (covid-era LFS rates, indexed-to-baseline charts
// where one observation dwarfs the rest) still RENDERS its full path with
// `overflow: visible` — the path coordinates land above PLOT_Y0 or below
// PLOT_Y1 — so any label placed in the top or bottom margin would sit in
// the stroke's path. Used by `recVisible` below to suppress the recession
// label on charts where the line punches out of the plot box.
let yTrueMin = 0;
let yTrueMax = 1;
if (sharedSeries.length > 0) {
  yTrueMin = Math.min(...sharedSeries);
  yTrueMax = Math.max(...sharedSeries);
  const [rawMin, rawMax] = pickYBounds(sharedSeries);
  const span = rawMax - rawMin || Math.max(1, Math.abs(rawMax) * 0.1);
  yLo = rawMin - span * 0.10;
  yHi = rawMax + span * 0.10;
  if (referenceValue !== null && referenceValue !== undefined) {
    if (referenceValue < yLo) yLo = referenceValue - span * 0.05;
    if (referenceValue > yHi) yHi = referenceValue + span * 0.05;
  }
  if (referenceValueSecondary !== null && referenceValueSecondary !== undefined) {
    if (referenceValueSecondary < yLo) yLo = referenceValueSecondary - span * 0.05;
    if (referenceValueSecondary > yHi) yHi = referenceValueSecondary + span * 0.05;
  }
  if (referenceBand) {
    if (referenceBand.lower < yLo) yLo = referenceBand.lower - span * 0.05;
    if (referenceBand.upper > yHi) yHi = referenceBand.upper + span * 0.05;
  }
}
const yRange = yHi - yLo || 1;
const crossesZero = yLo < 0 && yHi > 0;

function xScale(yr: number): number {
  if (xMax === xMin) return PLOT_X0 + PLOT_W / 2;
  return PLOT_X0 + ((yr - xMin) / (xMax - xMin)) * PLOT_W;
}
function yScale(v: number): number {
  return PLOT_Y0 + PLOT_H - ((v - yLo) / yRange) * PLOT_H;
}

// Path-builder. When `step=true`, emit a step-after line: hold the previous
// value horizontally to the new observation's x, then jump vertically to the
// new value. This is the correct rendering for policy rates (constant
// between discrete decision dates). When `step=false` (default), emit the
// canonical linear interpolation used for continuously traded market series.
function buildLinePath(series: SeriesPoint[], step = false): string {
  let d = "";
  let started = false;
  let prevY: number | null = null;
  for (const pt of series) {
    if (typeof pt.value !== "number" || Number.isNaN(pt.value)) continue;
    const xv = decYear(pt.date);
    if (Number.isNaN(xv)) continue;
    const x = xScale(xv);
    const y = yScale(pt.value);
    const xs = x.toFixed(2);
    const ys = y.toFixed(2);
    if (!started) {
      d += `M${xs} ${ys} `;
      started = true;
    } else if (step && prevY !== null) {
      // Step-after: horizontal segment at the previous y to the new x,
      // then vertical jump at the new x to the new y.
      d += `L${xs} ${prevY.toFixed(2)} L${xs} ${ys} `;
    } else {
      d += `L${xs} ${ys} `;
    }
    prevY = y;
  }
  return d.trim();
}

const primPath = buildLinePath(primData, primaryStep);
const secPath = unitsMatch ? buildLinePath(secData, secondaryStep) : "";
const terPath = terUnitsMatch ? buildLinePath(terData, tertiaryStep) : "";

// ---- Latest ---------------------------------------------------------------
function lastReal(series: SeriesPoint[]): { x: number; y: number; v: number; date: string } | null {
  for (let i = series.length - 1; i >= 0; i--) {
    const pt = series[i]!;
    if (typeof pt.value === "number" && !Number.isNaN(pt.value)) {
      const xv = decYear(pt.date);
      if (Number.isNaN(xv)) continue;
      return { x: xScale(xv), y: yScale(pt.value), v: pt.value, date: pt.date };
    }
  }
  return null;
}
const lastPrim = lastReal(primData);
const lastSec = unitsMatch ? lastReal(secData) : null;
const lastTer = terUnitsMatch ? lastReal(terData) : null;

// ---- Y-axis ticks --------------------------------------------------------
// Nice-number tick stride. Returns a stride that lands on multiples of
// {1, 2, 2.5, 5} times a power of 10 — scales to any magnitude without
// the old hard-coded candidate list (which capped at 1000 and produced
// ugly fallback ticks for large-magnitude series like persons or hours).
function pickStride(lo: number, hi: number, targetTicks = 5): number {
  const span = hi - lo;
  if (!Number.isFinite(span) || span <= 0) return 1;
  const rough = span / targetTicks;
  const mag = Math.pow(10, Math.floor(Math.log10(rough)));
  const norm = rough / mag; // normalized into [1, 10)
  let nice: number;
  if (norm < 1.5) nice = 1;
  else if (norm < 3) nice = 2;
  else if (norm < 4) nice = 2.5;
  else if (norm < 7) nice = 5;
  else nice = 10;
  return nice * mag;
}
const yStride = pickStride(yLo, yHi);
const yTicks: number[] = [];
const start = Math.ceil(yLo / yStride) * yStride;
for (let v = start; v <= yHi + 1e-9; v += yStride) {
  yTicks.push(Number(v.toFixed(6)));
}
if (yTicks.length === 0) yTicks.push(Number(((yLo + yHi) / 2).toFixed(6)));

// ---- X-axis year ticks ---------------------------------------------------
const yearStart = Math.ceil(xMin);
const yearEnd = Math.floor(xMax);
const allYearTicks: Array<{ x: number; label: string }> = [];
for (let yr = yearStart; yr <= yearEnd; yr++) {
  const decY = yr + (1 - 0.5) / 12;
  if (decY < xMin || decY > xMax) continue;
  allYearTicks.push({ x: xScale(decY), label: String(yr) });
}
const xTickStride = Math.max(1, Math.ceil(allYearTicks.length / 5));
const xTicks = allYearTicks.filter((_, i) => i % xTickStride === 0);

// ---- Recession band (2020Q1-Q2) ------------------------------------------
const recStart = 2020 + (2 - 0.5) / 12;
const recEnd = 2020 + (4 - 0.5) / 12;
const recVisible = recEnd >= xMin && recStart <= xMax;
const recX0 = recVisible ? xScale(Math.max(recStart, xMin)) : 0;
const recX1 = recVisible ? xScale(Math.min(recEnd, xMax)) : 0;

// Suppress the RECESSION label (not the band itself) when the data line
// overflows the clipped y-domain. On covid-spike charts (indexed-to-Feb-
// 2020 LFS rates, housing affordability index, etc.) the rawMin/rawMax of
// the series sit well outside the percentile-clipped [yLo, yHi] window —
// the line renders its full path with `overflow: visible`, punching above
// PLOT_Y0 or below PLOT_Y1 — so any margin-anchored label is a guaranteed
// stroke collision. The shaded band itself remains visible; readers know
// the covid recession by sight. See text-vs-line overlap audit.
const yOverflowMargin = (yHi - yLo) * 0.005; // tiny tolerance for FP slop
const recLabelSuppressed = recVisible && (
  yTrueMin < yLo - yOverflowMargin || yTrueMax > yHi + yOverflowMargin
);

// ---- ValueKind + scale-factor resolution ---------------------------------
// Backend (pipeline/io/format.py, in-flight) will emit `kind` on each
// PanelSeries. Until it does, infer from the existing `unit` string;
// see `inferKindFromUnit` in ./format.ts for the unit -> ValueKind table.
//
// `unitScaleFactor` rebases values that arrived in a non-baseline unit
// (e.g. "CAD billions", "Millions of persons") into the formatter's
// expected baseline (M$ for currency_cad, raw items for count). The
// CHART geometry stays in the JSON's native units; only the formatted
// label readout uses the rescaled value. This keeps tick spacing in
// the same scale the data was emitted in.
const primaryKind: ValueKind = (primary.kind as ValueKind | null | undefined)
  ?? inferKindFromUnit(primary.unit);
const primaryScale = unitScaleFactor(primary.unit);

const computedAria = ariaLabel ?? `${primary.label}${secondary && unitsMatch ? ` and ${secondary.label}` : ""}${tertiary && terUnitsMatch ? ` and ${tertiary.label}` : ""}, last ${windowMonths} months. Latest print marked.`;

// ---- Reference rule(s) --------------------------------------------------
const refY = referenceValue !== null && referenceValue !== undefined
  ? yScale(referenceValue)
  : null;
const showRef = refY !== null && referenceValue! >= yLo && referenceValue! <= yHi;
const refY2 = referenceValueSecondary !== null && referenceValueSecondary !== undefined
  ? yScale(referenceValueSecondary)
  : null;
const showRef2 = refY2 !== null && referenceValueSecondary! >= yLo && referenceValueSecondary! <= yHi;

// ---- Reference band geometry --------------------------------------------
// The band spans [lower, upper] in data space; in pixel space, the rect's
// top edge is yScale(upper) (smaller y = higher value) and its bottom edge
// is yScale(lower). Both bounds were already folded into the y-domain
// expansion above, so the band is guaranteed to fall inside the plot.
const bandTopY = referenceBand ? yScale(Math.max(referenceBand.upper, referenceBand.lower)) : null;
const bandBotY = referenceBand ? yScale(Math.min(referenceBand.upper, referenceBand.lower)) : null;
const showBand = referenceBand !== null && bandTopY !== null && bandBotY !== null
  && bandBotY > bandTopY;
// Band label sits in the top margin ABOVE the plot frame, top-left
// anchored. The band itself is shaded behind the data line, so the label
// can't live INSIDE the band without conflicting with the line wherever
// the line happens to be inside-band at the leftmost x (true of every
// inflation regime where the chart's left edge lands during a return to
// the 1-3% range). The recession label, also placed at PLOT_Y0 - 6, only
// appears on long-window charts (240-mo) and the three reference-band
// charts (Panel1HeadlineCPI, Panel2CoreTrio, Panel1OvernightRate) all
// run a 60-mo window — no horizontal collision in practice. See the
// text-vs-line overlap audit.
// Band label position: "above" places ~4px above the band's upper edge
// (clamped to PLOT_Y0+10 so it never crosses the plot frame); "below"
// places at yScale(1.4) — inside the chart but below the band's lower
// edge — for charts where the data line crosses the band's TOP at the
// leftmost x (inflation core measures during the 2022-23 spike).
const BAND_LABEL_Y = bandTopY !== null
  ? (bandLabelPosition === "below"
      ? yScale((referenceBand?.lower ?? 0) - 0.6)
      : Math.max(PLOT_Y0 + 10, bandTopY - 4))
  : 0;
// (Band-label collision suppression resolves after showRefLabel /
// showRefLabel2 / RECESSION_LABEL_Y are defined below.)

// ---- Direct label fallbacks ---------------------------------------------
// Series-name labels wrap to two lines when they exceed the 14-char budget
// for a single line in the 96px right gutter (720-wide viewBox, Manrope
// 13px). Break order: comma, space, dash/slash, hard split. Ellipsis is
// NEVER used - per editorial direction, labels spill to a second line
// rather than truncate. The wrappers in src/components/charts/<section>/
// Panel*.astro should still pass concise forms; this is the safety net.
const LABEL_MAX_CHARS = 14;
function splitLabel(s: string | null | undefined): string[] {
  if (!s) return [];
  if (s.length <= LABEL_MAX_CHARS) return [s];
  const trySplit = (idx: number, includeChar: boolean): string[] => {
    const cut = includeChar ? idx + 1 : idx;
    return [s.slice(0, cut).trimEnd(), s.slice(cut).trimStart()];
  };
  // 1. Comma in budget — split immediately after the comma so it stays
  //    on the first line ("Per-cap GDP, Y/Y" -> ["Per-cap GDP,", "Y/Y"]).
  const commaIdx = s.lastIndexOf(",", LABEL_MAX_CHARS - 1);
  if (commaIdx > 0) return trySplit(commaIdx, true);
  // 2. Space in budget.
  const spaceIdx = s.lastIndexOf(" ", LABEL_MAX_CHARS - 1);
  if (spaceIdx > 0) return trySplit(spaceIdx, false);
  // 3. Slash or hyphen in budget — keep delimiter on first line.
  const slashIdx = s.lastIndexOf("/", LABEL_MAX_CHARS - 1);
  const dashIdx = s.lastIndexOf("-", LABEL_MAX_CHARS - 1);
  const delimIdx = Math.max(slashIdx, dashIdx);
  if (delimIdx > 0) return trySplit(delimIdx, true);
  // 4. No breakable character — hard split at the budget. Reader still
  //    sees the full label rather than an ellipsis.
  return [s.slice(0, LABEL_MAX_CHARS), s.slice(LABEL_MAX_CHARS)];
}
const primDirectLabelLines = splitLabel(primaryLabel ?? primary.label);
const secDirectLabelLines = secondary && unitsMatch
  ? splitLabel(secondaryLabel ?? secondary.label)
  : [];
const terDirectLabelLines = tertiary && terUnitsMatch
  ? splitLabel(tertiaryLabel ?? tertiary.label)
  : [];

// ---- Label placement, no-overlap canon -----------------------------------
// See design/canon_reference_panel.md "Label placement rules (no-overlap
// canon)" for the full rule set. The constants below are the pinned
// thresholds from Rule L1-L6. Changing one requires art-director sign-off.
const LABEL_GAP_X = 10;        // dot-center -> direct label x offset
const LABEL_LH = 14;           // direct-label vertical stack gap
const LABEL_MIN_DY = 12;       // direct-label vs direct-label collision guard
const REF_LABEL_MIN_DY = 16;   // direct-label vs reference-rule-label guard
const RECESSION_LABEL_GUARD = 12; // y-tick vs recession-label guard
const RECESSION_LABEL_Y = PLOT_Y0 - 6; // baseline of the recession label
                                         // (sits in the top margin above the
                                         // plot frame so the data line —
                                         // which in covid-spike charts
                                         // reaches the plot's top edge —
                                         // can't graze the label rect).

// Rule L6: stack primary + secondary direct labels when their natural
// baselines are within LABEL_MIN_DY of each other. Primary keeps its
// natural anchor; secondary moves. If the secondary would fall off the
// bottom margin, the move flips - secondary stays put and primary moves
// up.
// Multi-line labels (when splitLabel wrapped) extend further down the
// y-axis. Inflate the collision guards so a 2-line primary label does not
// land on top of the secondary direct label or the reference-rule label.
const primExtraLines = Math.max(0, primDirectLabelLines.length - 1);
const secExtraLines = Math.max(0, secDirectLabelLines.length - 1);
const terExtraLines = Math.max(0, terDirectLabelLines.length - 1);
const minDyForStack = LABEL_MIN_DY + Math.max(primExtraLines, secExtraLines, terExtraLines) * LABEL_LH;
const minDyForRef = REF_LABEL_MIN_DY + Math.max(primExtraLines, secExtraLines, terExtraLines) * LABEL_LH;

let primLabelY = lastPrim ? lastPrim.y + 4 : 0;
let secLabelY = lastSec ? lastSec.y + 4 : 0;
let terLabelY = lastTer ? lastTer.y + 4 : 0;
if (lastPrim && lastSec && secDirectLabelLines.length > 0) {
  if (Math.abs(primLabelY - secLabelY) < minDyForStack) {
    // Default: secondary slides away from primary. Move direction = away
    // from primary's natural baseline. If both are at near-identical y,
    // the secondary slides DOWN (positive y) so the primary keeps its
    // visually-anchored position on the upper series.
    const moveDown = secLabelY >= primLabelY;
    const stackGap = LABEL_LH + primExtraLines * LABEL_LH;
    secLabelY = moveDown ? primLabelY + stackGap : primLabelY - stackGap;
    // Bounds check: if the moved secondary would fall outside [PLOT_Y0+4,
    // PLOT_Y1 + M_B - 4], flip the move (primary moves instead).
    if (secLabelY < PLOT_Y0 + 4 || secLabelY > PLOT_Y1 + M_B - 4) {
      secLabelY = lastSec.y + 4;
      const flipGap = LABEL_LH + secExtraLines * LABEL_LH;
      primLabelY = moveDown ? secLabelY - flipGap : secLabelY + flipGap;
    }
  }
}
// Tertiary stacks against BOTH primary and (post-stack) secondary. The
// tertiary always moves; primary keeps its natural anchor, secondary keeps
// the position assigned above. Pattern mirrors AltLineChart's three-line
// stacking heuristic.
if (lastTer && terDirectLabelLines.length > 0) {
  const stackGapTer = LABEL_LH + Math.max(primExtraLines, secExtraLines) * LABEL_LH;
  if (lastPrim && Math.abs(primLabelY - terLabelY) < minDyForStack) {
    terLabelY = primLabelY + (terLabelY >= primLabelY ? stackGapTer : -stackGapTer);
  }
  if (lastSec && secDirectLabelLines.length > 0
      && Math.abs(secLabelY - terLabelY) < minDyForStack) {
    terLabelY = secLabelY + (terLabelY >= secLabelY ? stackGapTer : -stackGapTer);
  }
  // Bounds clamp - if the moved tertiary fell outside the legal band,
  // snap it back inside; loss of strict no-overlap is acceptable here
  // (three lines crowded into the same right gutter is an editorial
  // signal the panel may need a wider window or per-chart spec, not a
  // layout failure).
  if (terLabelY < PLOT_Y0 + 4) terLabelY = PLOT_Y0 + 4;
  if (terLabelY > PLOT_Y1 + M_B - 4) terLabelY = PLOT_Y1 + M_B - 4;
}

// Rule L4: reference-rule label is suppressed when within
// REF_LABEL_MIN_DY of any direct label.
let showRefLabel = showRef && !!referenceLabel;
if (showRefLabel && refY !== null) {
  if (lastPrim && Math.abs(primLabelY - refY) < minDyForRef) showRefLabel = false;
  if (lastSec && secDirectLabelLines.length > 0 && Math.abs(secLabelY - refY) < minDyForRef) showRefLabel = false;
  if (lastTer && terDirectLabelLines.length > 0 && Math.abs(terLabelY - refY) < minDyForRef) showRefLabel = false;
}
let showRefLabel2 = showRef2 && !!referenceLabelSecondary;
if (showRefLabel2 && refY2 !== null) {
  if (lastPrim && Math.abs(primLabelY - refY2) < minDyForRef) showRefLabel2 = false;
  if (lastSec && secDirectLabelLines.length > 0 && Math.abs(secLabelY - refY2) < minDyForRef) showRefLabel2 = false;
  if (lastTer && terDirectLabelLines.length > 0 && Math.abs(terLabelY - refY2) < minDyForRef) showRefLabel2 = false;
}
// Inter-reference label collision: when both reference labels render and
// their y-positions sit within REF_LABEL_MIN_DY of each other, suppress
// the SECONDARY label. The primary reference label is the higher-priority
// editorial signal (it carries the first-named historical average in the
// breadth panel).
if (showRefLabel && showRefLabel2 && refY !== null && refY2 !== null
    && Math.abs(refY - refY2) < REF_LABEL_MIN_DY) {
  showRefLabel2 = false;
}

// Rule L3: y-tick labels are suppressed within RECESSION_LABEL_GUARD of
// the recession-band label baseline. Topmost tick (carrying the unit) is
// NEVER suppressed - the unit must always read.
function ytickSuppressed(tickY: number, isTopTick: boolean): boolean {
  if (isTopTick) return false;
  if (!recVisible || recLabelSuppressed) return false;
  return Math.abs(tickY - RECESSION_LABEL_Y) < RECESSION_LABEL_GUARD;
}

// Reference-band label: micro-cap, anchored top-left of the band (inside
// the plot). Suppressed when it would collide with a reference-rule
// label (refY - 5 baseline) or with the recession-band label baseline.
// Direct labels live in the right gutter (x > PLOT_X1) so no horizontal
// overlap on the left.
const BAND_LABEL_GUARD = 12;
let showBandLabel = showBand && !!(referenceBand && referenceBand.label);
if (showBandLabel) {
  if (showRefLabel && refY !== null && Math.abs((refY - 5) - BAND_LABEL_Y) < BAND_LABEL_GUARD) {
    showBandLabel = false;
  }
  if (showRefLabel2 && refY2 !== null && Math.abs((refY2 - 5) - BAND_LABEL_Y) < BAND_LABEL_GUARD) {
    showBandLabel = false;
  }
  if (recVisible && !recLabelSuppressed
      && Math.abs(BAND_LABEL_Y - RECESSION_LABEL_Y) < BAND_LABEL_GUARD) {
    showBandLabel = false;
  }
}
---
<div class="canon-chart" data-panel={dataPanelAttr}>
  <svg
    class="canon-chart__svg"
    viewBox={`0 0 ${VB_W} ${VB_H}`}
    preserveAspectRatio="xMidYMid meet"
    role="img"
    aria-label={computedAria}
  >
    {recVisible && (
      <g class="canon-chart__recession-group">
        <rect
          class="canon-chart__recession"
          x={recX0.toFixed(2)}
          y={PLOT_Y0}
          width={Math.max(1, recX1 - recX0).toFixed(2)}
          height={PLOT_H}
        />
        {!recLabelSuppressed && (
          <text
            class="canon-chart__recession-label"
            x={(Math.max(recX1 + 4, PLOT_X0 + 4)).toFixed(2)}
            y={(PLOT_Y0 - 6).toFixed(2)}
            text-anchor="start"
          >RECESSION (2020Q1-Q2)</text>
        )}
      </g>
    )}

    {showBand && (
      <rect
        class="canon-chart__reference-band"
        x={PLOT_X0}
        y={(bandTopY as number).toFixed(2)}
        width={PLOT_W}
        height={((bandBotY as number) - (bandTopY as number)).toFixed(2)}
      />
    )}

    {showBandLabel && (
      <text
        class="canon-chart__reference-band-label"
        x={(PLOT_X0 + 6).toFixed(2)}
        y={BAND_LABEL_Y.toFixed(2)}
        text-anchor="start"
      >{(referenceBand as { label: string }).label.toUpperCase()}</text>
    )}

    {yTicks.map((v) => {
      const yy = yScale(v);
      if (crossesZero && Math.abs(v) < 1e-9) return null;
      return (
        <line
          class="canon-chart__gridline"
          x1={PLOT_X0}
          y1={yy.toFixed(2)}
          x2={PLOT_X1}
          y2={yy.toFixed(2)}
        />
      );
    })}

    {crossesZero && (
      <line
        class="canon-chart__zero-line"
        x1={PLOT_X0}
        y1={yScale(0).toFixed(2)}
        x2={PLOT_X1}
        y2={yScale(0).toFixed(2)}
      />
    )}

    {showRef && (
      <g class="canon-chart__reference-group">
        <line
          class="canon-chart__reference-rule"
          x1={PLOT_X0}
          y1={(refY as number).toFixed(2)}
          x2={PLOT_X1}
          y2={(refY as number).toFixed(2)}
        />
        {showRefLabel && (
          <text
            class="canon-chart__reference-label"
            x={(PLOT_X1 - 6).toFixed(2)}
            y={((refY as number) - 5).toFixed(2)}
            text-anchor="end"
          >{referenceLabel}</text>
        )}
      </g>
    )}

    {showRef2 && (
      <g class="canon-chart__reference-group">
        <line
          class="canon-chart__reference-rule"
          x1={PLOT_X0}
          y1={(refY2 as number).toFixed(2)}
          x2={PLOT_X1}
          y2={(refY2 as number).toFixed(2)}
        />
        {showRefLabel2 && (
          <text
            class="canon-chart__reference-label"
            x={(PLOT_X1 - 6).toFixed(2)}
            y={((refY2 as number) - 5).toFixed(2)}
            text-anchor="end"
          >{referenceLabelSecondary}</text>
        )}
      </g>
    )}

    {/* Clip-path constrains data lines to the plot rect. When the y-domain
       uses percentile clipping (long daily series, or short series where
       a covid-era outlier sits outside the visible range), the polyline
       paths would otherwise extend past the bottom or top of the plot.
       Reference rules, ticks, recession bands, and the latest dot stay
       OUTSIDE the clip group — they should remain visible at the edges. */}
    <defs>
      <clipPath id={`pcclip-${dataPanelAttr ?? 'plot'}`}>
        <rect x={PLOT_X0} y={PLOT_Y0} width={PLOT_W} height={PLOT_H} />
      </clipPath>
    </defs>
    <g clip-path={`url(#pcclip-${dataPanelAttr ?? 'plot'})`}>
      {terPath && (
        <path class="canon-chart__line-tertiary" d={terPath} fill="none" />
      )}

      {secPath && (
        <path class="canon-chart__line-secondary" d={secPath} fill="none" />
      )}

      {primPath && (
        <path class="canon-chart__line" d={primPath} fill="none" />
      )}
    </g>

    {/* When the chart is a three-line panel, the secondary and tertiary
       termini carry small pure-ink dots so each line's latest print
       resolves visually under the direct label. Two-line panels keep the
       canon's "dot on primary only" treatment (no change to existing). */}
    {terPath && lastSec && (
      <circle
        class="canon-chart__latest-dot-secondary"
        cx={lastSec.x.toFixed(2)}
        cy={lastSec.y.toFixed(2)}
        r="3"
      />
    )}
    {terPath && lastTer && (
      <circle
        class="canon-chart__latest-dot-tertiary"
        cx={lastTer.x.toFixed(2)}
        cy={lastTer.y.toFixed(2)}
        r="3"
      />
    )}

    {lastPrim && (
      <circle
        class="canon-chart__latest-dot"
        cx={lastPrim.x.toFixed(2)}
        cy={lastPrim.y.toFixed(2)}
        r="4"
      >
        <title>{`Latest: ${lastPrim.date}: ${fmtValue(lastPrim.v * primaryScale, primaryKind)}`}</title>
      </circle>
    )}

    <rect
      class="canon-chart__frame"
      x={PLOT_X0}
      y={PLOT_Y0}
      width={PLOT_W}
      height={PLOT_H}
    />

    {xTicks.map((t) => (
      <g>
        <line
          class="canon-chart__xtick"
          x1={t.x.toFixed(2)}
          y1={PLOT_Y1.toFixed(2)}
          x2={t.x.toFixed(2)}
          y2={(PLOT_Y1 + 4).toFixed(2)}
        />
        <text
          class="canon-chart__xtick-label"
          x={t.x.toFixed(2)}
          y={(PLOT_Y1 + 18).toFixed(2)}
          text-anchor="middle"
        >{t.label}</text>
      </g>
    ))}

    {yTicks.map((v, i) => {
      const yy = yScale(v);
      const isTop = i === yTicks.length - 1;
      if (ytickSuppressed(yy + 4, isTop)) return null;
      // Scale the value into the formatter's baseline unit before
      // formatting; the geometry above used the raw JSON value.
      const txt = fmtTickKind(v * primaryScale, primaryKind, isTop);
      return (
        <text
          class="canon-chart__ytick-label"
          x={(PLOT_X0 - 8).toFixed(2)}
          y={(yy + 4).toFixed(2)}
          text-anchor="end"
        >{txt}</text>
      );
    })}

    {lastPrim && primDirectLabelLines.length > 0 && (
      <text
        class="canon-chart__direct-label"
        x={(lastPrim.x + LABEL_GAP_X).toFixed(2)}
        y={primLabelY.toFixed(2)}
        text-anchor="start"
      >
        {primDirectLabelLines.map((line, i) => (
          i === 0
            ? <tspan>{line}</tspan>
            : <tspan x={(lastPrim.x + LABEL_GAP_X).toFixed(2)} dy={LABEL_LH}>{line}</tspan>
        ))}
      </text>
    )}
    {lastSec && secDirectLabelLines.length > 0 && (
      <text
        class="canon-chart__direct-label-secondary"
        x={(lastSec.x + LABEL_GAP_X).toFixed(2)}
        y={secLabelY.toFixed(2)}
        text-anchor="start"
      >
        {secDirectLabelLines.map((line, i) => (
          i === 0
            ? <tspan>{line}</tspan>
            : <tspan x={(lastSec.x + LABEL_GAP_X).toFixed(2)} dy={LABEL_LH}>{line}</tspan>
        ))}
      </text>
    )}
    {lastTer && terDirectLabelLines.length > 0 && (
      <text
        class="canon-chart__direct-label-tertiary"
        x={(lastTer.x + LABEL_GAP_X).toFixed(2)}
        y={terLabelY.toFixed(2)}
        text-anchor="start"
      >
        {terDirectLabelLines.map((line, i) => (
          i === 0
            ? <tspan>{line}</tspan>
            : <tspan x={(lastTer.x + LABEL_GAP_X).toFixed(2)} dy={LABEL_LH}>{line}</tspan>
        ))}
      </text>
    )}
  </svg>
</div>

<style>
  .canon-chart { width: 100%; aspect-ratio: 16 / 9; background-color: var(--paper); overflow: visible; }
  .canon-chart__svg { display: block; width: 100%; height: 100%; overflow: visible; font-family: var(--font-sans); }
  .canon-chart__recession { fill: rgba(21, 23, 26, 0.06); }
  .canon-chart__recession-label {
    fill: var(--ink); font-family: var(--font-sans);
    font-size: 11px; font-weight: var(--fw-semibold); letter-spacing: 0.18em;
  }
  .canon-chart__reference-band {
    fill: rgba(21, 23, 26, 0.07); stroke: none; shape-rendering: crispEdges;
  }
  .canon-chart__reference-band-label {
    fill: var(--ink); font-family: var(--font-sans);
    font-size: 10px; font-weight: var(--fw-semibold); letter-spacing: 0.16em;
    fill-opacity: 0.7;
  }
  .canon-chart__gridline { stroke: var(--ink); stroke-width: 1; stroke-opacity: 0.18; shape-rendering: crispEdges; }
  .canon-chart__zero-line { stroke: var(--ink); stroke-width: 1; stroke-opacity: 1; shape-rendering: crispEdges; }
  .canon-chart__reference-rule { stroke: var(--ink); stroke-width: 1; stroke-dasharray: 4 2; shape-rendering: crispEdges; }
  .canon-chart__reference-label {
    fill: var(--ink); font-family: var(--font-sans);
    font-size: 12px; font-weight: var(--fw-semibold); letter-spacing: 0.04em;
  }
  .canon-chart__line {
    stroke: var(--ink); stroke-width: 1.5; stroke-linejoin: round; stroke-linecap: round;
    fill: none; vector-effect: non-scaling-stroke;
  }
  .canon-chart__line-secondary {
    stroke: var(--ink); stroke-width: 1; stroke-dasharray: 4 2;
    stroke-linejoin: round; stroke-linecap: butt; fill: none; vector-effect: non-scaling-stroke;
  }
  .canon-chart__line-tertiary {
    stroke: var(--ink); stroke-width: 1; stroke-dasharray: 2 3;
    stroke-linejoin: round; stroke-linecap: butt; fill: none; vector-effect: non-scaling-stroke;
  }
  .canon-chart__latest-dot { fill: var(--accent); stroke: none; }
  .canon-chart__latest-dot-secondary { fill: var(--ink); stroke: none; }
  .canon-chart__latest-dot-tertiary { fill: var(--ink); stroke: none; }
  .canon-chart__frame { fill: none; stroke: var(--ink); stroke-width: 1; shape-rendering: crispEdges; }
  .canon-chart__xtick { stroke: var(--ink); stroke-width: 1; shape-rendering: crispEdges; }
  .canon-chart__xtick-label {
    fill: var(--ink); font-family: var(--font-sans);
    font-size: 12px; font-weight: var(--fw-regular); font-variant-numeric: tabular-nums;
  }
  .canon-chart__ytick-label {
    fill: var(--ink); font-family: var(--font-mono);
    font-size: 12px; font-weight: var(--fw-regular); font-variant-numeric: tabular-nums;
  }
  .canon-chart__direct-label {
    fill: var(--ink); font-family: var(--font-sans);
    font-size: 13px; font-weight: var(--fw-semibold);
  }
  .canon-chart__direct-label-secondary {
    fill: var(--ink); font-family: var(--font-sans);
    font-size: 13px; font-weight: var(--fw-regular);
  }
  .canon-chart__direct-label-tertiary {
    fill: var(--ink); font-family: var(--font-sans);
    font-size: 13px; font-weight: var(--fw-regular);
  }
</style>
