---
/*
 * PanelHeadlineCPIDual - mockup, headline CPI dual-panel.
 *
 * Mirrors the GDP plate-1 V3 treatment for inflation:
 *   - Left sub-panel: m/m CPI %, last 24 months, as bars. Latest bar
 *     in MTA red.
 *   - Right sub-panel: Y/Y CPI %, last 36 months, as a line. Instead
 *     of a single horizontal potential-growth reference (the GDP
 *     analogue), the right panel shades the BoC 1-3% control range
 *     across the full plot width.
 *
 * Data flow:
 *   - Y/Y already a processed series in panel-1's `primary`
 *     (cpi_all_items_yoy). Render directly.
 *   - m/m derived in the wrapper from panel-1's `secondary`
 *     (cpi_all_items, the CPI level / index).
 *
 * This is a mockup plate added at the top of /inflation for user
 * comparison against the existing single-line P1. Disposition pending.
 */

import type { PanelData, SeriesPoint } from "../../_shared/panelData";
import { decYear } from "../../_shared/panelData";
import PanelEmpty from "../../_shared/PanelEmpty.astro";

interface Props {
  data?: PanelData | null;
}

const { data = null } = Astro.props;

// ---- m/m derivation from the CPI level series --------------------------
function pctMoM(series: SeriesPoint[]): SeriesPoint[] {
  const out: SeriesPoint[] = [];
  for (let i = 0; i < series.length; i++) {
    const here = series[i]!;
    const prev = series[i - 1];
    if (
      !prev ||
      typeof prev.value !== "number" ||
      typeof here.value !== "number" ||
      prev.value === 0
    ) {
      out.push({ date: here.date, value: null });
    } else {
      out.push({ date: here.date, value: (here.value / prev.value - 1) * 100 });
    }
  }
  return out;
}

function lastReal(series: SeriesPoint[]): { date: string; value: number } | null {
  for (let i = series.length - 1; i >= 0; i--) {
    const pt = series[i]!;
    if (typeof pt.value === "number" && !Number.isNaN(pt.value)) {
      return { date: pt.date, value: pt.value };
    }
  }
  return null;
}

// Nice-tick stride (mirrors PanelLiveChart).
function pickStride(lo: number, hi: number, targetTicks = 4): number {
  const span = hi - lo;
  if (!Number.isFinite(span) || span <= 0) return 1;
  const rough = span / targetTicks;
  const mag = Math.pow(10, Math.floor(Math.log10(rough)));
  const norm = rough / mag;
  let nice: number;
  if (norm < 1.5) nice = 1;
  else if (norm < 3) nice = 2;
  else if (norm < 4) nice = 2.5;
  else if (norm < 7) nice = 5;
  else nice = 10;
  return nice * mag;
}

// ---- Window sizing (matches GDP V3) ------------------------------------
const MOM_WINDOW = 24;
const YOY_WINDOW = 36;

// BoC control range. The 2% target is the midpoint; the range is the
// statutorily-renewed "inflation-control" band.
const CONTROL_LOWER = 1;
const CONTROL_UPPER = 3;

// ---- Process input -------------------------------------------------------
const yoyFull: SeriesPoint[] = data?.primary?.data ?? [];
const levels: SeriesPoint[] = data?.secondary?.data ?? [];
const momFull = levels.length > 0 ? pctMoM(levels) : [];

const momData = momFull.slice(-MOM_WINDOW);
const yoyData = yoyFull
  .filter((d) => typeof d.value === "number" && !Number.isNaN(d.value))
  .slice(-YOY_WINDOW);

const hasData = momData.length > 0 && yoyData.length > 0;

// ---- Geometry -----------------------------------------------------------
const VB_W = 720;
const VB_H = 405;
const M_OUT = 8;
const GAP_X = 56;
const M_T = 52;
const M_B = 36;
const SUB_M_L = 40;
const SUB_M_R = 14;

const SUB_W = (VB_W - 2 * M_OUT - GAP_X) / 2;
const LEFT_X0 = M_OUT;
const LEFT_X1 = LEFT_X0 + SUB_W;
const RIGHT_X0 = LEFT_X1 + GAP_X;
const RIGHT_X1 = RIGHT_X0 + SUB_W;

const PLOT_Y0 = M_T;
const PLOT_Y1 = VB_H - M_B;
const PLOT_H = PLOT_Y1 - PLOT_Y0;

interface BarRect {
  x: number;
  y: number;
  w: number;
  h: number;
  isLatest: boolean;
}

interface SubPanelGeom {
  plotX0: number;
  plotX1: number;
  plotW: number;
  xMin: number;
  xMax: number;
  yLo: number;
  yHi: number;
  yRange: number;
  yTicks: number[];
  xTicks: Array<{ x: number; label: string }>;
  bandLowY: number | null;
  bandHighY: number | null;
  showBand: boolean;
  zeroY: number | null;
  path: string;
  lastX: number | null;
  lastY: number | null;
  lastValue: number | null;
  lastDate: string | null;
  bars: BarRect[];
}

function buildSubPanel(
  subBBoxX0: number,
  subBBoxX1: number,
  series: SeriesPoint[],
  band: { lower: number; upper: number } | null,
  kind: "line" | "bars",
): SubPanelGeom {
  const plotX0 = subBBoxX0 + SUB_M_L;
  const plotX1 = subBBoxX1 - SUB_M_R;
  const plotW = plotX1 - plotX0;

  const xs = series
    .map((d) => decYear(d.date))
    .filter((v) => !Number.isNaN(v));
  let xMin = xs.length > 0 ? Math.min(...xs) : 0;
  let xMax = xs.length > 0 ? Math.max(...xs) : 1;

  // Pad x-domain for bars so first/last sit inside the frame.
  if (kind === "bars" && series.length > 0) {
    const slotYears = (xMax - xMin) / Math.max(1, series.length - 1);
    xMin -= slotYears * 0.6;
    xMax += slotYears * 0.6;
  }

  const ys = series
    .map((d) => d.value)
    .filter((v): v is number => typeof v === "number" && !Number.isNaN(v));
  let yLo = 0;
  let yHi = 1;
  if (ys.length > 0) {
    const rawMin = Math.min(...ys);
    const rawMax = Math.max(...ys);
    const span = (rawMax - rawMin) || Math.max(1, Math.abs(rawMax) * 0.1);
    yLo = rawMin - span * 0.12;
    yHi = rawMax + span * 0.12;
  }
  // Expand y-domain to include the band bounds if they fall outside.
  if (band) {
    const span = yHi - yLo;
    if (band.lower < yLo) yLo = band.lower - span * 0.08;
    if (band.upper > yHi) yHi = band.upper + span * 0.08;
  }
  // Always include zero so the zero baseline draws as the bars' anchor
  // (for the m/m panel where some months are negative).
  if (yLo > 0) yLo = -Math.max(0.1, (yHi - yLo) * 0.05);
  if (yHi < 0) yHi = Math.max(0.1, (yHi - yLo) * 0.05);
  const yRange = yHi - yLo || 1;

  const xScale = (yr: number) => {
    if (xMax === xMin) return plotX0 + plotW / 2;
    return plotX0 + ((yr - xMin) / (xMax - xMin)) * plotW;
  };
  const yScale = (v: number) =>
    PLOT_Y0 + PLOT_H - ((v - yLo) / yRange) * PLOT_H;

  // y-ticks via nice-stride.
  const stride = pickStride(yLo, yHi);
  const yTicks: number[] = [];
  const start = Math.ceil(yLo / stride) * stride;
  for (let v = start; v <= yHi + 1e-9; v += stride) {
    yTicks.push(Number(v.toFixed(6)));
  }
  if (yTicks.length === 0) yTicks.push(Number(((yLo + yHi) / 2).toFixed(6)));

  // x-ticks: year boundaries within domain.
  const yearStart = Math.ceil(xMin);
  const yearEnd = Math.floor(xMax);
  const allYearTicks: Array<{ x: number; label: string }> = [];
  for (let yr = yearStart; yr <= yearEnd; yr++) {
    const decY = yr + (1 - 0.5) / 12;
    if (decY < xMin || decY > xMax) continue;
    allYearTicks.push({ x: xScale(decY), label: String(yr) });
  }
  const xTickStride = Math.max(1, Math.ceil(allYearTicks.length / 5));
  const xTicks = allYearTicks.filter((_, i) => i % xTickStride === 0);

  // Band geometry (only when a band was supplied).
  const bandLowY = band ? yScale(band.lower) : null;
  const bandHighY = band ? yScale(band.upper) : null;
  const showBand = band !== null && bandLowY !== null && bandHighY !== null;

  // Zero line for the m/m bar panel.
  const zeroY = yLo <= 0 && yHi >= 0 ? yScale(0) : null;

  // Build per-kind primitives.
  let path = "";
  let bars: BarRect[] = [];
  let lastX: number | null = null;
  let lastY: number | null = null;
  let lastValue: number | null = null;
  let lastDate: string | null = null;

  if (kind === "line") {
    let started = false;
    for (const pt of series) {
      if (typeof pt.value !== "number" || Number.isNaN(pt.value)) continue;
      const xv = decYear(pt.date);
      if (Number.isNaN(xv)) continue;
      const xp = xScale(xv).toFixed(2);
      const yp = yScale(pt.value).toFixed(2);
      path += (started ? "L" : "M") + xp + " " + yp + " ";
      started = true;
    }
    path = path.trim();
    const last = lastReal(series);
    if (last) {
      const xv = decYear(last.date);
      if (!Number.isNaN(xv)) {
        lastX = xScale(xv);
        lastY = yScale(last.value);
        lastValue = last.value;
        lastDate = last.date;
      }
    }
  } else {
    const zY = zeroY ?? yScale(0);
    let validCount = 0;
    for (const pt of series) {
      if (typeof pt.value === "number" && !Number.isNaN(pt.value)) validCount++;
    }
    const slotWidth = validCount > 0 ? plotW / Math.max(validCount, 1) : plotW;
    const barWidth = Math.max(2, slotWidth * 0.75);

    let lastIdx = -1;
    for (let i = series.length - 1; i >= 0; i--) {
      const v = series[i]!.value;
      if (typeof v === "number" && !Number.isNaN(v)) { lastIdx = i; break; }
    }

    for (let i = 0; i < series.length; i++) {
      const pt = series[i]!;
      if (typeof pt.value !== "number" || Number.isNaN(pt.value)) continue;
      const xv = decYear(pt.date);
      if (Number.isNaN(xv)) continue;
      const cx = xScale(xv);
      const valueY = yScale(pt.value);
      const topY = Math.min(valueY, zY);
      const botY = Math.max(valueY, zY);
      bars.push({
        x: cx - barWidth / 2,
        y: topY,
        w: barWidth,
        h: Math.max(0.5, botY - topY),
        isLatest: i === lastIdx,
      });
    }
  }

  return {
    plotX0,
    plotX1,
    plotW,
    xMin,
    xMax,
    yLo,
    yHi,
    yRange,
    yTicks,
    xTicks,
    bandLowY,
    bandHighY,
    showBand,
    zeroY,
    path,
    lastX,
    lastY,
    lastValue,
    lastDate,
    bars,
  };
}

const left = hasData
  ? buildSubPanel(LEFT_X0, LEFT_X1, momData, null, "bars")
  : null;
const right = hasData
  ? buildSubPanel(RIGHT_X0, RIGHT_X1, yoyData,
                  { lower: CONTROL_LOWER, upper: CONTROL_UPPER }, "line")
  : null;

const ariaLabel = "Headline CPI. Left panel: month-over-month percent change as bars, last 24 months. Right panel: year-over-year percent change as line, last 36 months, with the BoC 1-3% control range shaded across the plot.";
---
{hasData && left && right ? (
  <div class="canon-chart canon-chart--dual" data-panel="inflation-headline-dual">
    <svg
      class="canon-chart__svg"
      viewBox={`0 0 ${VB_W} ${VB_H}`}
      preserveAspectRatio="xMidYMid meet"
      role="img"
      aria-label={ariaLabel}
    >
      {/* ---- LEFT SUB-PANEL: m/m bars ------------------------------- */}
      <text
        class="canon-chart__subpanel-title"
        x={((LEFT_X0 + LEFT_X1) / 2).toFixed(2)}
        y={(M_T - 18).toFixed(2)}
        text-anchor="middle"
      >MONTH-OVER-MONTH, %</text>

      {left.yTicks.map((v) => {
        const yy = (PLOT_Y0 + PLOT_H) - ((v - left.yLo) / left.yRange) * PLOT_H;
        if (left.zeroY !== null && Math.abs(yy - left.zeroY) < 0.5) return null;
        return (
          <line
            class="canon-chart__gridline"
            x1={left.plotX0.toFixed(2)}
            y1={yy.toFixed(2)}
            x2={left.plotX1.toFixed(2)}
            y2={yy.toFixed(2)}
          />
        );
      })}

      {left.bars.map((b) => (
        <rect
          class={b.isLatest ? "canon-chart__bar canon-chart__bar--latest" : "canon-chart__bar"}
          x={b.x.toFixed(2)}
          y={b.y.toFixed(2)}
          width={b.w.toFixed(2)}
          height={b.h.toFixed(2)}
        />
      ))}

      {left.zeroY !== null && (
        <line
          class="canon-chart__zero-line"
          x1={left.plotX0.toFixed(2)}
          y1={left.zeroY.toFixed(2)}
          x2={left.plotX1.toFixed(2)}
          y2={left.zeroY.toFixed(2)}
        />
      )}

      <rect
        class="canon-chart__frame"
        x={left.plotX0}
        y={PLOT_Y0}
        width={left.plotW}
        height={PLOT_H}
      />

      {left.xTicks.map((t) => (
        <g>
          <line
            class="canon-chart__xtick"
            x1={t.x.toFixed(2)}
            y1={PLOT_Y1.toFixed(2)}
            x2={t.x.toFixed(2)}
            y2={(PLOT_Y1 + 4).toFixed(2)}
          />
          <text
            class="canon-chart__xtick-label"
            x={t.x.toFixed(2)}
            y={(PLOT_Y1 + 18).toFixed(2)}
            text-anchor="middle"
          >{t.label}</text>
        </g>
      ))}

      {left.yTicks.map((v, i) => {
        const yy = (PLOT_Y0 + PLOT_H) - ((v - left.yLo) / left.yRange) * PLOT_H;
        const isTop = i === left.yTicks.length - 1;
        const txt = `${v.toFixed(1)}${isTop ? "%" : ""}`;
        return (
          <text
            class="canon-chart__ytick-label"
            x={(left.plotX0 - 6).toFixed(2)}
            y={(yy + 4).toFixed(2)}
            text-anchor="end"
          >{txt}</text>
        );
      })}

      {/* ---- RIGHT SUB-PANEL: Y/Y line + 1-3% control band ----------- */}
      <text
        class="canon-chart__subpanel-title"
        x={((RIGHT_X0 + RIGHT_X1) / 2).toFixed(2)}
        y={(M_T - 18).toFixed(2)}
        text-anchor="middle"
      >YEAR-OVER-YEAR, %</text>

      {right.showBand && right.bandHighY !== null && right.bandLowY !== null && (
        <g class="canon-chart__band-group">
          <rect
            class="canon-chart__reference-band"
            x={right.plotX0.toFixed(2)}
            y={right.bandHighY.toFixed(2)}
            width={right.plotW.toFixed(2)}
            height={(right.bandLowY - right.bandHighY).toFixed(2)}
          />
          {/* Band label sits ABOVE the plot frame in the top margin. The
              Y/Y CPI line in the 36-month window touches every part of
              the band (1.65% trough to 4.4% / 8% peak), so placing the
              label inside-band or just outside the band's upper edge
              guarantees a stroke crossing somewhere in the label rect's
              x-span. The subpanel title sits at y = M_T - 18 = 34; the
              plot frame starts at PLOT_Y0 = M_T = 52; placing the label
              at PLOT_Y0 - 6 = 46 keeps it cleanly between the two. */}
          <text
            class="canon-chart__reference-band-label"
            x={(right.plotX0 + 6).toFixed(2)}
            y={(PLOT_Y0 - 6).toFixed(2)}
            text-anchor="start"
          >CONTROL RANGE</text>
        </g>
      )}

      {right.yTicks.map((v) => {
        const yy = (PLOT_Y0 + PLOT_H) - ((v - right.yLo) / right.yRange) * PLOT_H;
        if (right.zeroY !== null && Math.abs(yy - right.zeroY) < 0.5) return null;
        return (
          <line
            class="canon-chart__gridline"
            x1={right.plotX0.toFixed(2)}
            y1={yy.toFixed(2)}
            x2={right.plotX1.toFixed(2)}
            y2={yy.toFixed(2)}
          />
        );
      })}

      {right.zeroY !== null && (
        <line
          class="canon-chart__zero-line"
          x1={right.plotX0.toFixed(2)}
          y1={right.zeroY.toFixed(2)}
          x2={right.plotX1.toFixed(2)}
          y2={right.zeroY.toFixed(2)}
        />
      )}

      <path class="canon-chart__line" d={right.path} fill="none" />

      <rect
        class="canon-chart__frame"
        x={right.plotX0}
        y={PLOT_Y0}
        width={right.plotW}
        height={PLOT_H}
      />

      {right.xTicks.map((t) => (
        <g>
          <line
            class="canon-chart__xtick"
            x1={t.x.toFixed(2)}
            y1={PLOT_Y1.toFixed(2)}
            x2={t.x.toFixed(2)}
            y2={(PLOT_Y1 + 4).toFixed(2)}
          />
          <text
            class="canon-chart__xtick-label"
            x={t.x.toFixed(2)}
            y={(PLOT_Y1 + 18).toFixed(2)}
            text-anchor="middle"
          >{t.label}</text>
        </g>
      ))}

      {right.yTicks.map((v, i) => {
        const yy = (PLOT_Y0 + PLOT_H) - ((v - right.yLo) / right.yRange) * PLOT_H;
        const isTop = i === right.yTicks.length - 1;
        const txt = `${v.toFixed(1)}${isTop ? "%" : ""}`;
        return (
          <text
            class="canon-chart__ytick-label"
            x={(right.plotX0 - 6).toFixed(2)}
            y={(yy + 4).toFixed(2)}
            text-anchor="end"
          >{txt}</text>
        );
      })}

      {right.lastX !== null && right.lastY !== null && (
        <circle
          class="canon-chart__latest-dot"
          cx={right.lastX.toFixed(2)}
          cy={right.lastY.toFixed(2)}
          r="4"
        >
          <title>{`Latest: ${right.lastDate}: ${right.lastValue!.toFixed(2)}%`}</title>
        </circle>
      )}
    </svg>
  </div>
) : (
  <PanelEmpty reason="Headline CPI series not available for m/m derivation." />
)}

<style>
  .canon-chart { width: 100%; aspect-ratio: 16 / 9; background-color: var(--paper); overflow: visible; }
  .canon-chart__svg { display: block; width: 100%; height: 100%; overflow: visible; font-family: var(--font-sans); }
  .canon-chart__subpanel-title {
    fill: var(--ink); font-family: var(--font-sans);
    font-size: 11px; font-weight: var(--fw-semibold); letter-spacing: 0.18em;
  }
  .canon-chart__gridline { stroke: var(--ink); stroke-width: 1; stroke-opacity: 0.18; shape-rendering: crispEdges; }
  .canon-chart__zero-line { stroke: var(--ink); stroke-width: 1; stroke-opacity: 1; shape-rendering: crispEdges; }
  .canon-chart__reference-band {
    fill: rgba(21, 23, 26, 0.07); stroke: none; shape-rendering: crispEdges;
  }
  .canon-chart__reference-band-label {
    fill: var(--ink); font-family: var(--font-sans);
    font-size: 10px; font-weight: var(--fw-semibold); letter-spacing: 0.16em;
    fill-opacity: 0.7;
  }
  .canon-chart__line {
    stroke: var(--ink); stroke-width: 1.5; stroke-linejoin: round; stroke-linecap: round;
    fill: none; vector-effect: non-scaling-stroke;
  }
  .canon-chart__bar { fill: var(--ink); }
  .canon-chart__bar--latest { fill: var(--accent); }
  .canon-chart__latest-dot { fill: var(--accent); stroke: none; }
  .canon-chart__frame { fill: none; stroke: var(--ink); stroke-width: 1; shape-rendering: crispEdges; }
  .canon-chart__xtick { stroke: var(--ink); stroke-width: 1; shape-rendering: crispEdges; }
  .canon-chart__xtick-label {
    fill: var(--ink); font-family: var(--font-sans);
    font-size: 12px; font-weight: var(--fw-regular); font-variant-numeric: tabular-nums;
  }
  .canon-chart__ytick-label {
    fill: var(--ink); font-family: var(--font-mono);
    font-size: 12px; font-weight: var(--fw-regular); font-variant-numeric: tabular-nums;
  }
</style>
