---
/*
 * Panel5IRCCSupplyTrajectory - IRCC supply trajectory.
 *
 * Pipeline emits `pop_immigrants` (primary) and `pop_net_npr`
 * (secondary) as persons-flow series. Editorial argument is PR + NPR
 * inflows vs the IRCC plan; the plan-comparison overlay is not on disk
 * so we render the two raw flows.
 *
 * Synthetic-data fallback removed.
 */

import type { PanelData } from "../../_shared/panelData";
import PanelLiveChart from "../../_shared/PanelLiveChart.astro";
import PanelEmpty from "../../_shared/PanelEmpty.astro";

interface Props {
  data?: PanelData | null;
}

const { data = null } = Astro.props;
---
{data && data.primary ? (
  <PanelLiveChart
    primary={data.primary}
    secondary={data.secondary}
    primaryLabel="PR inflows"
    secondaryLabel="Net NPR"
    dataPanelAttr="labour-5"
    ariaLabel="Permanent-resident and net non-permanent-resident inflows."
  />
) : (
  <PanelEmpty reason="IRCC plan-vs-actual overlay not yet emitted." />
)}
