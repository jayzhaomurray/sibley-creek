---
/*
 * Panel6FiscalStanceCycle - fiscal stance vs cycle.
 *
 * Pipeline emits `capacity_util_total` (primary, %) as a cycle proxy.
 * Cyclically-adjusted primary balance is not on disk (StatCan does
 * not publish CAPB; IMF Article IV reading is annotated separately).
 * We render the cycle proxy alone.
 *
 * Synthetic-data fallback removed.
 */

import type { PanelData } from "../../_shared/panelData";
import PanelLiveChart from "../../_shared/PanelLiveChart.astro";
import PanelEmpty from "../../_shared/PanelEmpty.astro";

interface Props {
  data?: PanelData | null;
}

const { data = null } = Astro.props;
---
{data && data.primary && data.primary.data.length > 1 ? (
  <PanelLiveChart
    primary={data.primary}
    secondary={null}
    primaryLabel="Capacity util."
    dataPanelAttr="policy-6"
    ariaLabel="Total capacity utilization, percent."
  />
) : (
  <PanelEmpty reason="Cyclically-adjusted primary balance not yet emitted." />
)}
