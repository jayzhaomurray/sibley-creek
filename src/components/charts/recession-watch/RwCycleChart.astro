---
/*
 * RwCycleChart.astro — cycle-on-cycle overlay chart for /recession-watch/.
 *
 * Renders one of four charts:
 *   depth   — y: % change since peak, 0 at top, negative below, floor −6%
 *             COVID path clipped at floor + off-scale annotation
 *   breadth — y: % of sectors contracting/shedding, 0 at bottom, 100 at top
 *             dashed 50% reference line at right
 *
 * Spec: claude-ref/research/recession_watch/visual_spec_phase_a.md
 *
 * Data keys consumed from recession_watch.json metrics block:
 *   metric.current       — [{monthsSincePeak, value}]
 *   metric.comparators   — { "1981-82": [...], "1990-92": [...], "2008-09": [...], "2020": [...] }
 *   metric.current_reading
 *   metric.current_months_since_peak
 *
 * Geometry (720×405 viewBox):
 *   Margins: left 52, right 88, top 24, bottom 48
 *   Plot area: x0=52 y0=24 x1=632 y1=357  width=580 height=333
 *   X domain: 0–36 months
 *   Y depth:   0 (top=y0) to −6 (bottom=y1)
 *   Y breadth: 0 (bottom=y1) to 100 (top=y0)
 *
 * COVID clip (depth only):
 *   Draw COVID path up to where it crosses the −6% floor, then stop.
 *   Place a downward caret at the clip x on the floor line.
 *   Place annotation text below the frame baseline.
 *
 * No reader prose — all text is structural axis labelling (tick values,
 * eyebrow, "PEAK", "Past recessions", "Now"). Chart title is omitted;
 * the eyebrow above each chart in the page carries the category label.
 */

// ---- Types ----------------------------------------------------------------

interface DataPoint {
  monthsSincePeak: number;
  value: number;
}

type MetricLike = Record<string, any>; // JSON metric shape; structural check via key access

interface Props {
  /** "depth" or "breadth" — controls y-axis orientation and clipping. */
  chartType: "depth" | "breadth";
  /** Unique slug used to namespace SVG defs IDs. E.g. "gdp-depth", "emp-breadth". */
  chartId: string;
  /** Parsed metric object from recession_watch.json metrics block. */
  metric: MetricLike;
  /**
   * For depth charts: the COVID low value as a formatted string for the
   * off-scale annotation. E.g. "2020 low −13%". Use real value from data.
   */
  covidLowLabel?: string;
  /** ARIA label for the SVG element. */
  ariaLabel?: string;
}

const {
  chartType,
  chartId,
  metric,
  covidLowLabel = "",
  ariaLabel = "Recession watch cycle chart",
} = Astro.props;

// ---- Geometry constants ---------------------------------------------------

const VW = 720;
const VH = 405;
const LEFT = 52;    // y-tick gutter
const RIGHT = 88;   // space for "Now" label + right margin
const TOP = 24;     // top frame clearance (no in-chart eyebrow)
const BOTTOM = 48;  // x-ticks + COVID annotation band + axis label row
const X0 = LEFT;
const X1 = VW - RIGHT;
const Y0 = TOP;
const Y1 = VH - BOTTOM;
const PW = X1 - X0;  // 580
const PH = Y1 - Y0;  // 323

// X domain: 0–36 months
const X_MAX = 36;
function xPx(month: number): number {
  return X0 + (Math.min(month, X_MAX) / X_MAX) * PW;
}

// Y scales
const DEPTH_FLOOR = -6;
const DEPTH_CEIL = 0;

function yDepth(v: number): number {
  const clamped = Math.max(DEPTH_FLOOR, Math.min(DEPTH_CEIL, v));
  return Y0 + ((DEPTH_CEIL - clamped) / (DEPTH_CEIL - DEPTH_FLOOR)) * PH;
}

function yBreadth(v: number): number {
  const clamped = Math.max(0, Math.min(100, v));
  return Y1 - (clamped / 100) * PH;
}

function yPx(v: number): number {
  return chartType === "depth" ? yDepth(v) : yBreadth(v);
}

// ---- Polyline helper -------------------------------------------------------

function ptsToPolyline(pts: DataPoint[]): string {
  return pts
    .filter(p => p.monthsSincePeak <= X_MAX)
    .map(p => `${xPx(p.monthsSincePeak).toFixed(1)},${yPx(p.value).toFixed(1)}`)
    .join(" ");
}

// ---- COVID clip logic (depth only) ----------------------------------------

interface CovidClipResult {
  points: DataPoint[];
  clipX: number;
  hasClip: boolean;
}

function computeCovidClip(rawPts: DataPoint[]): CovidClipResult {
  const sorted = [...rawPts].sort((a, b) => a.monthsSincePeak - b.monthsSincePeak);
  const clipped: DataPoint[] = [];
  let clipX = X0;
  let hasClip = false;

  for (const pt of sorted) {
    if (pt.monthsSincePeak > X_MAX) break;
    if (pt.value >= DEPTH_FLOOR) {
      clipped.push(pt);
    } else {
      // First point below floor: interpolate crossing
      if (clipped.length > 0) {
        const prev = clipped[clipped.length - 1];
        const t = (DEPTH_FLOOR - prev.value) / (pt.value - prev.value);
        const interpMonth = prev.monthsSincePeak + t * (pt.monthsSincePeak - prev.monthsSincePeak);
        clipX = xPx(interpMonth);
        hasClip = true;
      }
      break;
    }
  }

  return { points: clipped, clipX, hasClip };
}

// ---- Build comparator paths -----------------------------------------------

const RECESSION_KEYS = ["1981-82", "1990-92", "2008-09", "2020"] as const;
type RecessionKey = typeof RECESSION_KEYS[number];

interface ComparatorPath {
  key: RecessionKey;
  polyline: string;
  covidClip?: CovidClipResult;
}

const comparatorPaths: ComparatorPath[] = RECESSION_KEYS.map((key) => {
  const raw = (metric.comparators?.[key] ?? []) as DataPoint[];
  if (chartType === "depth" && key === "2020") {
    const covidClip = computeCovidClip(raw);
    return { key, polyline: ptsToPolyline(covidClip.points), covidClip };
  }
  return { key, polyline: ptsToPolyline(raw) };
});

// ---- Current episode path -------------------------------------------------

const currentPts = (metric.current ?? []) as DataPoint[];
const currentPolyline = ptsToPolyline(currentPts);

// Terminal point for the red dot and "Now" label
const validCurrentPts = currentPts.filter(p => p.monthsSincePeak <= X_MAX);
const lastCurrentPt = validCurrentPts.length > 0
  ? validCurrentPts[validCurrentPts.length - 1]
  : null;
const dotX = lastCurrentPt ? xPx(lastCurrentPt.monthsSincePeak) : X0;
const dotY = lastCurrentPt ? yPx(lastCurrentPt.value) : Y0;
const nowLabelX = dotX + 10;
// If the dot is within 14px of the top frame, push the label down so it
// clears the top y-tick; otherwise centre it on the dot.
const nowLabelY = dotY < Y0 + 14 ? Y0 + 14 : dotY;
const dotTitle = lastCurrentPt ? `Now: ${lastCurrentPt.value.toFixed(2)}%` : "Now";

// ---- Axis ticks -----------------------------------------------------------

const xTicks = [0, 6, 12, 18, 24, 30, 36];
const yTicksDepth = [0, -2, -4, -6];
const yTicksBreadth = [0, 25, 50, 75, 100];
const yTicks = chartType === "depth" ? yTicksDepth : yTicksBreadth;

// Canon: topmost tick carries the unit suffix only; others are bare numbers.
function fmtYTick(v: number, isTopmost: boolean): string {
  return isTopmost ? `${v}%` : `${v}`;
}

// ---- COVID annotation (depth only) ----------------------------------------

const covidClip = chartType === "depth"
  ? comparatorPaths.find(p => p.key === "2020")?.covidClip ?? null
  : null;

// Compute in frontmatter to avoid < in JSX body
const showCovidAnnotation = covidClip !== null && covidClip.hasClip;
const covidCaretX = showCovidAnnotation ? (covidClip!.clipX) : 0;
// x-tick label y offset: push down when COVID annotation occupies the band
const xTickLabelY = showCovidAnnotation ? (Y1 + 28) : (Y1 + 14);

// ---- Reference lines and labels -------------------------------------------

// y=0 reference (depth: top of plot; breadth: bottom of plot)
const refZeroY = chartType === "depth" ? Y0 : Y1;

// 50% reference line (breadth only)
const ref50Y = yBreadth(50);

// ---- "Past recessions" label position ------------------------------------
// Depth: place in the envelope fan zone at month 14, value ~−3.8%
//        (mid-range of the historical drawdowns at that point)
// Breadth: place at month 10, value ~62%
//          (below 2020 spike, within 2008 zone, well clear of current stub)
const pastRecLabelX = chartType === "depth" ? xPx(14) : xPx(10);
const pastRecLabelY = chartType === "depth" ? yPx(-3.8) : yPx(62);
---

<svg
  viewBox={`0 0 ${VW} ${VH}`}
  preserveAspectRatio="xMidYMid meet"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={ariaLabel}
  style="width:100%;display:block;"
>
  <title>{ariaLabel}</title>

  {/* Clip path — namespaced by chartId to avoid duplicate ids on the page */}
  <defs>
    <clipPath id={`plot-clip-${chartId}`}>
      <rect x={X0} y={Y0} width={PW} height={PH} />
    </clipPath>
  </defs>

  {/* Background */}
  <rect x="0" y="0" width={VW} height={VH} fill="var(--paper, #FAFAF7)" />

  {/* Horizontal gridlines at the non-zero y-ticks */}
  {yTicks.filter(v => v !== 0).map(v => (
    <line
      x1={X0} y1={yPx(v)}
      x2={X1} y2={yPx(v)}
      stroke="#000000"
      stroke-width="1"
      stroke-opacity="0.18"
      vector-effect="non-scaling-stroke"
    />
  ))}

  {/* y=0 reference line — full weight, 1px */}
  <line
    x1={X0} y1={refZeroY}
    x2={X1} y2={refZeroY}
    stroke="#000000"
    stroke-width="1"
    stroke-opacity="1"
    vector-effect="non-scaling-stroke"
  />

  {/* 50% dashed reference (breadth only) */}
  {chartType === "breadth" && (
    <>
      <line
        x1={X0} y1={ref50Y}
        x2={X1} y2={ref50Y}
        stroke="#000000"
        stroke-width="1"
        stroke-dasharray="4 2"
        stroke-opacity="0.65"
        vector-effect="non-scaling-stroke"
      />
      <text
        x={X1 + 5}
        y={ref50Y}
        font-family="var(--font-sans, 'Manrope', sans-serif)"
        font-weight="600"
        font-size="10"
        fill="var(--ink, #000000)"
        fill-opacity="0.65"
        dominant-baseline="middle"
      >50%</text>
    </>
  )}

  {/* x=0 PEAK vertical line — heavier than gridlines */}
  <line
    x1={X0} y1={Y0}
    x2={X0} y2={Y1}
    stroke="#000000"
    stroke-width="1.5"
    stroke-opacity="1"
    vector-effect="non-scaling-stroke"
  />

  {/* PEAK label — just inside the top of the plot, right of the x=0 line */}
  <text
    x={X0 + 4}
    y={Y0 + 10}
    font-family="var(--font-sans, 'Manrope', sans-serif)"
    font-weight="600"
    font-size="9"
    letter-spacing="0.16em"
    fill="var(--ink, #000000)"
    fill-opacity="0.55"
    dominant-baseline="middle"
  >PEAK</text>

  {/* Comparator paths, clipped to plot area */}
  <g clip-path={`url(#plot-clip-${chartId})`}>
    {comparatorPaths.map(({ key, polyline }) => polyline ? (
      <polyline
        points={polyline}
        fill="none"
        stroke="#000000"
        stroke-width="1"
        stroke-opacity="0.28"
        vector-effect="non-scaling-stroke"
      >
        <title>{key} recession</title>
      </polyline>
    ) : null)}

    {/* Current episode — 2px bold, full opacity */}
    {currentPolyline && (
      <polyline
        points={currentPolyline}
        fill="none"
        stroke="#000000"
        stroke-width="2"
        stroke-opacity="1"
        vector-effect="non-scaling-stroke"
      />
    )}
  </g>

  {/* COVID off-scale annotation (depth only, when clip occurred) */}
  {showCovidAnnotation && (
    <>
      {/* Downward caret at the clip point — aria-hidden, decorative */}
      <text
        x={covidCaretX}
        y={Y1}
        font-family="var(--font-sans, 'Manrope', sans-serif)"
        font-weight="400"
        font-size="11"
        fill="var(--ink, #000000)"
        fill-opacity="0.28"
        text-anchor="middle"
        dominant-baseline="hanging"
        aria-hidden="true"
      >&#9662;</text>
      {/* Off-scale label — below the frame, above x-ticks */}
      {covidLowLabel && (
        <text
          x={covidCaretX}
          y={Y1 + 13}
          font-family="var(--font-sans, 'Manrope', sans-serif)"
          font-weight="400"
          font-size="9"
          fill="var(--ink, #000000)"
          fill-opacity="0.55"
          text-anchor="middle"
          dominant-baseline="hanging"
        >{covidLowLabel}</text>
      )}
    </>
  )}

  {/* MTA red terminal dot — the single red mark on the chart */}
  {lastCurrentPt && (
    <circle
      cx={dotX}
      cy={dotY}
      r="4"
      fill="#E63946"
      stroke="none"
    >
      <title>{dotTitle}</title>
    </circle>
  )}

  {/* "Now" label right of the dot */}
  {lastCurrentPt && (
    <text
      x={nowLabelX}
      y={nowLabelY}
      font-family="var(--font-sans, 'Manrope', sans-serif)"
      font-weight="600"
      font-size="13"
      fill="var(--ink, #000000)"
      dominant-baseline="middle"
    >Now</text>
  )}

  {/* "Past recessions" — single envelope label in clear space */}
  <text
    x={pastRecLabelX}
    y={pastRecLabelY}
    font-family="var(--font-sans, 'Manrope', sans-serif)"
    font-weight="400"
    font-size="12"
    fill="var(--ink, #000000)"
    fill-opacity="0.5"
    dominant-baseline="middle"
  >Past recessions</text>

  {/* Y-tick labels — IBM Plex Mono 400 12px pure ink, right-aligned in left gutter.
       Canon: topmost tick (smallest SVG y) carries unit suffix only (§1.3). */}
  {(() => {
    const topmostV = yTicks.reduce((a, b) => yPx(a) < yPx(b) ? a : b);
    return yTicks.map((v) => (
      <text
        x={X0 - 5}
        y={yPx(v)}
        font-family="var(--font-mono, 'IBM Plex Mono', monospace)"
        font-weight="400"
        font-size="12"
        fill="var(--ink, #000000)"
        text-anchor="end"
        dominant-baseline="middle"
      >{fmtYTick(v, v === topmostV)}</text>
    ));
  })()}

  {/* X-tick labels — Manrope 400 12px pure ink, below frame (§1.2). */}
  {xTicks.map(m => (
    <text
      x={xPx(m)}
      y={xTickLabelY}
      font-family="var(--font-sans, 'Manrope', sans-serif)"
      font-weight="400"
      font-size="12"
      fill="var(--ink, #000000)"
      text-anchor="middle"
      dominant-baseline="hanging"
    >{m}</text>
  ))}

  {/* X-axis meaning label — centred below the tick numbers, clear of all plot marks */}
  <text
    x={(X0 + X1) / 2}
    y={xTickLabelY + 14}
    font-family="var(--font-sans, 'Manrope', sans-serif)"
    font-weight="600"
    font-size="9"
    letter-spacing="0.18em"
    fill="var(--ink-faint, #6B6B6B)"
    text-anchor="middle"
    dominant-baseline="hanging"
  >MONTHS SINCE CYCLE PEAK</text>

  {/* Plot frame — 1px ink box */}
  <rect
    x={X0} y={Y0}
    width={PW} height={PH}
    fill="none"
    stroke="#000000"
    stroke-width="1"
    vector-effect="non-scaling-stroke"
  />

</svg>
