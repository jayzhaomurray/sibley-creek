---
/*
 * CompactTile - the homepage 6-grid "index tile" (Path C reversal).
 *
 * Path C tile reversal (2026-05-11). The first Path C build moved a single
 * editorial sentence into the tile body and added a one-word surprise verb
 * to the callout row. User reversed: the tile is now indicator-led, not
 * prose-led. The editorial line is gone; the indicator name (e.g. "Real
 * GDP, m/m", "Headline CPI, y/y", "USDCAD") takes its slot above the mini-
 * chart. The surprise verb (BEAT / MISSED / IN LINE) is gone from the
 * callout; the row simplifies to value + delta only.
 *
 * Tile anatomy (top to bottom):
 *
 *   1. Top 1px monochrome rule (`--rule`), flush with the card border.
 *   2. Eyebrow row:
 *        left  - section name, label-size sans, `--ink-muted`, ALL CAPS,
 *                letter-spacing 0.08em.
 *        right - as-of date, micro, `--ink-faint`, tabular figures.
 *      Single row, baseline-aligned.
 *   3. Indicator name: body-sm Inter weight 500, `--ink`. Single line; clamps
 *      to 2 if a future indicator label runs long. Sourced from the load-
 *      bearing print's `indicator` field (e.g. "Real GDP, m/m", "Headline
 *      CPI, y/y", "Unemployment rate", "MLS HPI, y/y", "BoC overnight rate",
 *      "USDCAD", "Merch trade balance"). Not editorial prose — naming, not
 *      narration. The `Section.tileLine` field on the data record is no
 *      longer read by this component; it's kept on the type for now so the
 *      data shape stays stable across the reversal, but ignored at render.
 *   4. Mini-chart slot: aspect-ratio 248/72, max-width 248px. When
 *      `MiniChart` ships from chart-builder it slots in here. v1 renders
 *      a dashed-border placeholder so the layout reads at its final size.
 *   5. Callout row (single line, no wrap):
 *        value - Inter weight 600, display-sm, tabular figures.
 *        delta - mono-xs, semantic color by `deltaDir`.
 *      The surprise verb (formerly at the right end of this row) was
 *      dropped per Path C reversal; the row now ends with the delta.
 *
 * What is NOT in the tile:
 *   - Editorial sentence (the `tileLine` text, dropped per reversal).
 *   - Surprise verb (BEAT / MISSED / IN LINE — dropped per reversal).
 *   - Italic deck headline question (lives on the section page).
 *   - Numeric eyebrow code ("01" / "02" — section-page wayfinding only).
 *   - Separate "AS OF" stamp line (folded into the eyebrow row).
 *   - Revision tag, methodology link, source line, inline sparkline.
 *
 * The tile remains a full-area link to the section page.
 *
 * Sizing target: ~280px wide x ~170-190px tall on desktop (shorter than
 * the prior Path C tile by roughly one body-sm line plus the verb line).
 *
 * Props:
 *   section - the Section record. The tile consumes only:
 *               - section name (`label` / `tileLabel`)
 *               - hero print's `indicator`, `asOf`, `value`, `delta`,
 *                 `deltaDir`
 *             `section.tileLine`, `blurb`, and other prints[] entries are
 *             ignored here.
 */

import type { Section, SectionPrint, SectionSlug } from "../data/sections";
import MiniChart from "./charts/MiniChart.astro";

interface Props {
  section: Section;
}

const { section } = Astro.props;

const tileLabel = section.tileLabel ?? section.label;
const href = `/${section.slug}/`;

// Pick the load-bearing print (chartSeriesKey, prints[0] fallback). The
// tile now surfaces only ONE print — the same one the section page leads
// with — so the homepage reads as the section's top-of-page summary.
const heroPrint =
  section.prints.find((p: SectionPrint) => p.key && p.key === section.chartSeriesKey)
    ?? section.prints[0];

// ----------------------------------------------------------------------------
// Per-section mini-chart spec map (design-system.md Section 5.2).
//
// For each section we declare:
//   - accent:           "data-first" (deep blue) or "ambient" (slate). The
//                       data-first sections are the four where the line's
//                       shape is itself the story (Inflation, Policy, Labour,
//                       GDP); ambient sections (Housing, Markets, Trade) let
//                       the chart recede so the editorial line leads.
//   - referenceValue:   Optional horizontal reference rule value. Only set
//                       on Inflation (2.0% target) and Policy (2.75% neutral
//                       midpoint per April 2026 MPR). All others omit per
//                       Section 5.2 — most series have no canonical anchor.
//   - referenceLabel:   Screen-reader description for the rule. MiniChart
//                       folds this into the SVG title for assistive tech.
//   - ariaWindow:       Human-readable description of the visible window,
//                       used to construct the chart's accessible name. Each
//                       section's chartSeriesKey series in sections.ts carries
//                       24 monthly points (~24-month window) except trade's
//                       terms-of-trade (quarterly) and policy (monthly steps).
//                       We describe by series semantics, not raw point count.
// ----------------------------------------------------------------------------
interface MiniChartSpec {
  accent: "data-first" | "ambient";
  referenceValue?: number;
  referenceLabel?: string;
  ariaWindow: string;
}

const miniChartSpecBySlug: Record<SectionSlug, MiniChartSpec> = {
  gdp: {
    accent: "data-first",
    ariaWindow: "Real GDP m/m, last 24 months",
  },
  inflation: {
    accent: "data-first",
    referenceValue: 2,
    referenceLabel: "2% target",
    ariaWindow: "Headline CPI y/y, last 24 months",
  },
  labour: {
    accent: "data-first",
    ariaWindow: "Unemployment rate, last 24 months",
  },
  housing: {
    accent: "ambient",
    ariaWindow: "MLS HPI y/y, last 24 months",
  },
  policy: {
    accent: "data-first",
    referenceValue: 2.75,
    referenceLabel: "Neutral 2.75%",
    ariaWindow: "BoC overnight rate, last 24 months",
  },
  markets: {
    accent: "ambient",
    ariaWindow: "USDCAD, last 24 weeks",
  },
  trade: {
    accent: "ambient",
    ariaWindow: "Merchandise trade balance, last 24 months",
  },
};

const chartSpec: MiniChartSpec = miniChartSpecBySlug[section.slug as SectionSlug];

// finalValueLabel: the print's value is already pre-formatted ("2.3%",
// "+0.2%", "$71.40", "-$2.3B") in sections.ts, including the unit. The
// design-system Section 5.2 examples for the direct label match those
// values verbatim, so we pass `heroPrint.value` straight through. If we
// later split units off `value` for separate styling, this is the single
// site to revisit.
const finalValueLabel = heroPrint?.value;

// Path C reversal (2026-05-11): the surprise-verb derivation
// (pos -> "beat", neg -> "missed", neutral -> "in line") and the
// `surpriseVerb`/`verb` constants that powered it were removed. The
// callout row no longer renders a verb. `deltaDir` is still derived
// because the delta itself (still rendered) needs its semantic color
// class.
type DeltaDir = "pos" | "neg" | "neutral";
const deltaDir: DeltaDir = (heroPrint?.deltaDir ?? "neutral") as DeltaDir;

// Indicator name. Sourced from the load-bearing print's `indicator`
// field — these are already in the form the design system wants on the
// tile ("Real GDP, m/m", "Headline CPI, y/y", "Unemployment rate",
// "MLS HPI, y/y", "BoC overnight rate", "USDCAD", "Merch trade balance").
// Defensive fallback to the section kicker keeps the slot non-empty if a
// future data shape ever lands without an indicator string on prints[0].
const indicatorLabel = heroPrint?.indicator ?? section.kicker ?? "";
---
<a
  class="ctile"
  href={href}
  aria-label={`${tileLabel} section`}
>
  <div class="ctile__top-rule" aria-hidden="true"></div>

  {/* Eyebrow row: section name left, as-of date right. */}
  <header class="ctile__eyebrow">
    <h3 class="ctile__name">{tileLabel}</h3>
    {heroPrint?.asOf && (
      <span class="ctile__asof">{heroPrint.asOf}</span>
    )}
  </header>

  {/* Indicator name - body-sm, single line (2-line clamp as a safety net).
   * Path C reversal (2026-05-11): replaces the editorial `tileLine` that
   * previously occupied this slot. The string names the data point shown
   * in the mini-chart and callout below (e.g. "Headline CPI, y/y"), so
   * the tile reads as "section, indicator, picture, value" top to bottom. */}
  {indicatorLabel && (
    <p class="ctile__indicator">{indicatorLabel}</p>
  )}

  {/* Mini-chart slot. chart-builder's MiniChart.astro renders inside the
   * reserved 248x72 aspect-ratio box. Series + per-section reference rule
   * + color tier come from `miniChartSpecBySlug` above. Sections without a
   * canonical reference value (GDP, Labour, Housing, Markets, Trade) pass
   * neither `referenceValue` nor `referenceLabel`; MiniChart omits the
   * dashed rule entirely in that case.
   *
   * Recession bands are intentionally omitted for v1 (per chart-builder's
   * task spec — we'll wire them in a later pass once the date-to-fraction
   * mapping helper lands in pipeline/).
   */}
  {heroPrint?.spark && heroPrint.spark.length > 0 && (
    <div class="ctile__chart">
      <MiniChart
        data={heroPrint.spark}
        seriesKey={section.chartSeriesKey}
        referenceValue={chartSpec.referenceValue}
        referenceLabel={chartSpec.referenceLabel}
        finalValueLabel={finalValueLabel}
        accent={chartSpec.accent}
        ariaLabel={chartSpec.ariaWindow}
      />
    </div>
  )}

  {/* Callout row: value + delta. Single row, no wrap. Path C reversal
   * (2026-05-11): the surprise verb (BEAT / MISSED / IN LINE) that
   * previously closed this row was removed; the row now ends with the
   * delta. The delta retains its semantic color via `deltaDir`. */}
  {heroPrint && (
    <div class="ctile__callout">
      <span class="ctile__value">{heroPrint.value}</span>
      <span class:list={["ctile__delta", `ctile__delta--${deltaDir}`]}>
        {heroPrint.delta}
      </span>
    </div>
  )}
</a>

<style>
  /* Tile shell. Top-aligned content stack with consistent vertical rhythm.
   * Target ~280px wide x ~190-210px tall on desktop. */
  .ctile {
    display: flex;
    flex-direction: column;
    position: relative;
    background-color: var(--surface);
    border: 1px solid var(--rule);
    border-top: none; /* top-rule overlay replaces the top border */
    border-radius: var(--radius-card);
    padding: var(--s-3) var(--s-4) var(--s-4);
    color: var(--ink);
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease-out);
    height: 100%;
    min-width: 0;
  }

  .ctile:hover {
    border-color: var(--ink-muted);
  }

  .ctile:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  /* Top 1px monochrome rule (anatomy item 1). Overlaps the card border by
   * -1px on each side so the border + rule read as one continuous edge,
   * matching the hero tile and section-page treatments. */
  .ctile__top-rule {
    position: absolute;
    inset: -1px -1px auto -1px;
    height: 1px;
    background-color: var(--rule);
    border-top-left-radius: var(--radius-card);
    border-top-right-radius: var(--radius-card);
  }

  /* Eyebrow row (anatomy item 2): section name + as-of date, baseline-aligned
   * on a single row, with the as-of stamp pushed right. */
  .ctile__eyebrow {
    margin-top: var(--s-2);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3);
  }

  /* Section name. Demoted from the previous serif display-sm header to a
   * micro-caps eyebrow label. Below it sits the indicator name
   * (.ctile__indicator); the section name reads as wayfinding, not as a
   * tile title. */
  .ctile__name {
    font-family: var(--font-sans);
    font-size: var(--fs-label);
    line-height: var(--lh-label);
    font-weight: var(--fw-medium);
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0;
  }

  .ctile__asof {
    font-family: var(--font-sans);
    font-size: var(--fs-micro);
    line-height: var(--lh-micro);
    font-weight: var(--fw-medium);
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* Indicator name (anatomy item 3). Body-sm Inter at weight 500, ink.
   * Path C reversal (2026-05-11): this slot used to hold the editorial
   * `tileLine` (a sentence clamped to 2 lines). It now holds the indicator
   * name (e.g. "Headline CPI, y/y") sourced from the hero print's
   * `indicator` field — a short label, typically a single line. The 2-line
   * clamp is retained as a safety net so a future longer indicator string
   * cannot push the tile taller than the design size. */
  .ctile__indicator {
    font-family: var(--font-sans);
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body-sm);
    font-weight: var(--fw-medium);
    color: var(--ink);
    margin: var(--s-3) 0 0;
    /* 2-line safety clamp. */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Mini-chart slot (anatomy item 4). Fixed aspect ratio and max-width per
   * spec so the MiniChart SVG (preserveAspectRatio="none") fills the exact
   * box reserved by the tile. CLS is zero on swap. */
  .ctile__chart {
    margin-top: var(--s-3);
    width: 100%;
    max-width: 248px;
    aspect-ratio: 248 / 72;
  }

  /* Callout row (anatomy item 5). value + delta on a single line, no wrap.
   * Sits directly under the mini-chart with a fixed s-3 top gap
   * (design-system 6.1: "the mini-chart bottom sits s-3 above the callout
   * row"). We deliberately do NOT push the callout to the bottom of the
   * tile via margin-top: auto — when tiles stretch to match the hero
   * column's height, the extra air must fall BELOW the callout so the
   * content stays top-aligned. A bottom-anchored callout would put the
   * gap in the middle of the tile, which reads as a layout bug.
   *
   * Path C reversal (2026-05-11): the surprise-verb span (BEAT / MISSED /
   * IN LINE) that previously closed this row was removed. The row now
   * carries value + delta only; the delta no longer needs the
   * `margin-left: auto` push that the verb previously used. */
  .ctile__callout {
    margin-top: var(--s-3);
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    flex-wrap: nowrap;
    min-width: 0;
  }

  /* Value. Inter weight 600 at display-sm with tabular figures, per the
   * same numeric voice the hero callout uses (F6 echo). */
  .ctile__value {
    font-family: var(--font-sans);
    font-size: var(--fs-display-sm);
    line-height: 1.05;
    font-weight: var(--fw-semibold);
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    font-feature-settings: "tnum";
    white-space: nowrap;
  }

  /* Delta. Mono-xs per design-system sec 2 (inline numerics use Plex Mono).
   * Color follows direction. */
  .ctile__delta {
    font-family: var(--font-mono);
    font-size: var(--fs-mono-xs);
    line-height: var(--lh-mono-xs);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .ctile__delta--pos { color: var(--pos); }
  .ctile__delta--neg { color: var(--neg); }
  .ctile__delta--neutral { color: var(--neutral); }

  /* Path C reversal (2026-05-11): `.ctile__verb` and its three direction
   * variants (`--pos`, `--neg`, `--neutral`) were removed. No surprise verb
   * renders in the callout row anymore. */

  /* Hover affordance: card border darkens to ink-muted (.ctile:hover above)
   * and the section name picks up a subtle underline so the link semantic
   * stays obvious. Same treatment as the prior tile; the previous tile
   * applied it to a larger serif name, this one applies it to the eyebrow
   * name. */
  .ctile:hover .ctile__name {
    text-decoration: underline;
    text-decoration-color: var(--ink-muted);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  /* Mobile: no layout changes needed — the tile is already a vertical
   * stack and the callout row content stays within ~260px even at
   * small widths. The mini-chart slot uses max-width so it never
   * overflows. */
  @media (max-width: 480px) {
    /* Tighten the chart slot on very narrow widths so the tile fits
     * single-column layouts without the chart dominating. */
    .ctile__chart {
      max-width: 100%;
    }
  }
</style>
