---
/*
 * BauhausSectionShape - one section rendered as a Constructivist shape-
 * tile. Shape maps to color, color maps to nothing else:
 *   circle    -> blue   (#0046A1)
 *   square    -> red    (#E20613)
 *   triangle  -> yellow (#FFD500)
 *
 * Each tile is a strict square frame containing a big shape, a giant
 * black numeral (the section's index), the section label, and the
 * load-bearing print's value rendered inside the shape (paper-white on
 * blue/red; black on yellow because contrast).
 *
 * Tiles tessellate on a grid; the assignment of shape per section is
 * deterministic and supplied by the parent (so the page commits, per
 * the brief).
 */

import type { Section } from "../../../data/sections";

interface Props {
  section: Section;
  num: number; // 1..n
  shape: "circle" | "square" | "triangle";
}

const { section, num, shape } = Astro.props;

const loadBearing = section.chartSeriesKey
  ? section.prints.find((p) => p.key === section.chartSeriesKey) ?? section.prints[0]
  : section.prints[0];

const deltaClass =
  loadBearing.deltaDir === "pos"
    ? "bh-tile__delta--pos"
    : loadBearing.deltaDir === "neg"
      ? "bh-tile__delta--neg"
      : "bh-tile__delta--neutral";

const shapeClass = `bh-tile--${shape}`;
const numStr = String(num).padStart(2, "0");
---
<article class:list={["bh-tile", shapeClass]} aria-labelledby={`bh-tile-${section.slug}-h`}>
  <div class="bh-tile__frame">
    <span class="bh-tile__index" aria-hidden="true">{numStr}</span>

    {shape === "circle" && (
      <div class="bh-tile__shape bh-tile__shape--circle" aria-hidden="true">
        <div class="bh-tile__value">
          <span class="bh-tile__value-num">{loadBearing.value}</span>
        </div>
      </div>
    )}
    {shape === "square" && (
      <div class="bh-tile__shape bh-tile__shape--square" aria-hidden="true">
        <div class="bh-tile__value">
          <span class="bh-tile__value-num">{loadBearing.value}</span>
        </div>
      </div>
    )}
    {shape === "triangle" && (
      <div class="bh-tile__shape bh-tile__shape--triangle" aria-hidden="true">
        <span class="bh-tile__tri" aria-hidden="true"></span>
        <div class="bh-tile__value bh-tile__value--ink">
          <span class="bh-tile__value-num">{loadBearing.value}</span>
        </div>
      </div>
    )}

    <div class="bh-tile__caption">
      <h3 id={`bh-tile-${section.slug}-h`} class="bh-tile__label">
        <a class="bh-tile__link" href={`/${section.slug}/`}>{section.label}</a>
      </h3>
      <p class="bh-tile__indicator">{loadBearing.indicator}</p>
      <p class="bh-tile__metarow">
        <span class:list={["bh-tile__delta", deltaClass]}>{loadBearing.delta}</span>
        <span class="bh-tile__asof">{loadBearing.asOf}</span>
      </p>
    </div>
  </div>
</article>

<style>
  .bh-tile {
    background: var(--bh-paper);
    border: 2px solid var(--bh-ink);
    position: relative;
    min-width: 0;
  }
  .bh-tile__frame {
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 0;
    height: 100%;
    min-height: 280px;
  }

  /* Big section numeral — bottom-left of the frame, very large, ink. */
  .bh-tile__index {
    position: absolute;
    left: 8px;
    bottom: 80px;
    font-family: var(--bh-display);
    font-size: clamp(80px, 11vw, 140px);
    line-height: 0.8;
    letter-spacing: -0.04em;
    color: var(--bh-ink);
    z-index: 1;
    pointer-events: none;
    opacity: 0.92;
  }

  /* Shape area --------------------------------------------------------- */
  .bh-tile__shape {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .bh-tile__shape--circle::before {
    content: "";
    position: absolute;
    top: 14%;
    right: -22%;
    width: 86%;
    aspect-ratio: 1 / 1;
    background: var(--bh-blue);
    border-radius: 50%;
    z-index: 0;
  }

  .bh-tile__shape--square::before {
    content: "";
    position: absolute;
    top: 12%;
    right: 6%;
    width: 72%;
    aspect-ratio: 1 / 1;
    background: var(--bh-red);
    z-index: 0;
  }

  .bh-tile__shape--triangle .bh-tile__tri {
    position: absolute;
    top: 8%;
    right: 0;
    width: 0;
    height: 0;
    border-left: 36% solid transparent;
    border-right: 36% solid transparent;
    border-bottom: 72% solid var(--bh-yellow);
    transform: translateX(8%);
    z-index: 0;
  }

  /* Value sits on top of the shape. White ink on blue/red; black ink
     on yellow (legibility comes first). */
  .bh-tile__value {
    position: relative;
    z-index: 2;
    color: var(--bh-paper);
    font-family: var(--bh-display);
    line-height: 0.85;
    letter-spacing: -0.02em;
    text-align: center;
    transform: translateY(-12%);
  }
  .bh-tile__value--ink {
    color: var(--bh-ink);
    transform: translateY(8%);
  }
  .bh-tile__value-num {
    display: inline-block;
    font-size: clamp(32px, 4.6vw, 52px);
    font-variant-numeric: tabular-nums;
  }

  /* Caption strip ------------------------------------------------------ */
  .bh-tile__caption {
    border-top: 2px solid var(--bh-ink);
    background: var(--bh-paper);
    padding: 10px 12px 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    position: relative;
    z-index: 3;
  }

  .bh-tile__label {
    margin: 0;
    font-family: var(--bh-subhead);
    font-weight: 700;
    font-size: clamp(18px, 1.8vw, 22px);
    line-height: 1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--bh-ink);
  }
  .bh-tile__link {
    color: inherit;
    text-decoration: none;
  }
  .bh-tile__link:hover,
  .bh-tile__link:focus-visible {
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 3px;
    outline: none;
  }
  .bh-tile__link:focus-visible {
    background: var(--bh-yellow);
  }

  .bh-tile__indicator {
    margin: 0;
    font-family: var(--bh-body);
    font-weight: 400;
    font-size: 13px;
    line-height: 1.3;
    color: var(--bh-ink);
  }

  .bh-tile__metarow {
    margin: 0;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    font-family: var(--bh-mono);
    font-size: 11px;
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .bh-tile__delta {
    font-variant-numeric: tabular-nums;
    font-weight: 700;
  }
  .bh-tile__delta--pos { color: var(--bh-blue); }
  .bh-tile__delta--neg { color: var(--bh-red); }
  .bh-tile__delta--neutral { color: var(--bh-ink); }
  .bh-tile__asof {
    color: var(--bh-ink);
    opacity: 0.6;
  }
</style>
