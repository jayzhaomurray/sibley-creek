---
/*
 * BauhausDiagonalSpine - a thick black rule cutting the page from
 * top-right to bottom-left, per the brief's identity moment. Pure SVG
 * so it scales cleanly and doesn't affect document flow. Pinned behind
 * the content (z-index: 0) with the page content sitting at z-index 1.
 *
 * Also stamps a small red square at the top of the diagonal and a blue
 * circle at the bottom, like ferrules on a Constructivist rule.
 */
---
<svg
  class="bh-spine"
  viewBox="0 0 100 100"
  preserveAspectRatio="none"
  aria-hidden="true"
  focusable="false"
>
  <line
    x1="100"
    y1="0"
    x2="0"
    y2="100"
    stroke="var(--bh-ink)"
    stroke-width="6"
    vector-effect="non-scaling-stroke"
  />
</svg>

<style>
  .bh-spine {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 0;
    /* SVG stroke is set in px via non-scaling-stroke; this thickness reads
       as a 6-7px page-wide diagonal on a typical desktop. */
  }
</style>
