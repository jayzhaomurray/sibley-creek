---
/*
 * SynthMasthead - Lane G (Synthwave / Cyberpunk Terminal).
 *
 * Renders the publication wordmark in Orbitron ExtraBold with a neon
 * underline that glows magenta-to-cyan, a pulsing LIVE badge in hot
 * magenta, and a top status rail in VT323 CRT-monospace that reads like
 * a vintage terminal header (coordinates, build, edition).
 *
 * No animation other than the LIVE badge pulse (CSS keyframes), gated
 * by prefers-reduced-motion at the page level.
 */

interface Props {
  editionDate: string;
  buildStamp: string;
  liveSectionLabel: string;
}

const { editionDate, buildStamp, liveSectionLabel } = Astro.props;
---
<header class="smast" role="banner">
  <div class="smast__rail" aria-label="System status">
    <span class="smast__rail-chip">
      <span class="smast__dot" aria-hidden="true"></span>
      <span>SYS::ONLINE</span>
    </span>
    <span class="smast__rail-sep" aria-hidden="true">//</span>
    <span class="smast__rail-cell">
      <span class="smast__k">NODE</span>
      <span class="smast__v">mrd.terminal.yyz</span>
    </span>
    <span class="smast__rail-sep" aria-hidden="true">//</span>
    <span class="smast__rail-cell">
      <span class="smast__k">BUILD</span>
      <span class="smast__v">{buildStamp}</span>
    </span>
    <span class="smast__rail-sep" aria-hidden="true">//</span>
    <span class="smast__rail-cell">
      <span class="smast__k">COORD</span>
      <span class="smast__v">43.6532N 79.3832W</span>
    </span>
    <span class="smast__rail-spacer" aria-hidden="true"></span>
    <span class="smast__rail-cell smast__rail-cell--right">
      <span class="smast__k">EDITION</span>
      <span class="smast__v smast__v--strong">{editionDate}</span>
    </span>
  </div>

  <div class="smast__wordmark">
    <div class="smast__word-row">
      <h1 class="smast__title">
        <span class="smast__title-word">MACRO</span>
        <span class="smast__title-word smast__title-word--alt">RESEARCH</span>
        <span class="smast__title-word">DEPARTMENT</span>
      </h1>
      <p class="smast__live" aria-label="Live signal indicator">
        <span class="smast__live-dot" aria-hidden="true"></span>
        <span class="smast__live-text">LIVE</span>
        <span class="smast__live-target">/ {liveSectionLabel.toUpperCase()}</span>
      </p>
    </div>
    <div class="smast__rule" aria-hidden="true"></div>
    <p class="smast__sub">
      <span class="smast__sub-key">/SCOPE</span>
      <span class="smast__sub-val">Canadian macroeconomy</span>
      <span class="smast__sub-sep" aria-hidden="true">|</span>
      <span class="smast__sub-key">/CHANNEL</span>
      <span class="smast__sub-val">synthwave.cyber</span>
      <span class="smast__sub-sep" aria-hidden="true">|</span>
      <span class="smast__sub-key">/REV</span>
      <span class="smast__sub-val">2026.05.G</span>
    </p>
  </div>
</header>

<style>
  .smast {
    position: relative;
    z-index: 2;
    color: var(--sy-ink);
    padding-bottom: 18px;
  }

  /* ---- Top status rail ---- */
  .smast__rail {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 12px;
    padding: 10px 12px;
    border: 1px solid var(--sy-rule);
    background: linear-gradient(180deg, rgba(0, 229, 255, 0.04), rgba(255, 46, 151, 0.03));
    font-family: var(--sy-font-crt);
    font-size: 16px;
    line-height: 1;
    letter-spacing: 0.04em;
    color: var(--sy-cyan);
    text-shadow: 0 0 6px rgba(0, 229, 255, 0.35);
  }

  .smast__rail-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--sy-acid);
    font-weight: 400;
    letter-spacing: 0.1em;
    text-shadow: 0 0 6px rgba(0, 255, 133, 0.45);
  }

  .smast__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--sy-acid);
    box-shadow: 0 0 8px var(--sy-acid), 0 0 16px rgba(0, 255, 133, 0.55);
  }

  .smast__rail-sep { color: var(--sy-ink-faint); text-shadow: none; }
  .smast__rail-spacer { flex: 1 1 auto; }

  .smast__rail-cell {
    display: inline-flex;
    gap: 6px;
    align-items: baseline;
    white-space: nowrap;
  }
  .smast__rail-cell--right { margin-left: auto; }

  .smast__k {
    color: var(--sy-ink-faint);
    letter-spacing: 0.12em;
    text-shadow: none;
  }
  .smast__v {
    color: var(--sy-cyan);
    font-feature-settings: "tnum", "lnum";
  }
  .smast__v--strong {
    color: var(--sy-magenta);
    text-shadow: 0 0 8px rgba(255, 46, 151, 0.55);
  }

  /* ---- Wordmark block ---- */
  .smast__wordmark {
    margin-top: 22px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .smast__word-row {
    display: flex;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 16px 28px;
    justify-content: space-between;
  }

  .smast__title {
    margin: 0;
    font-family: var(--sy-font-display);
    font-weight: 800;
    line-height: 0.88;
    letter-spacing: 0.01em;
    color: var(--sy-ink);
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    text-transform: uppercase;
  }

  .smast__title-word {
    display: inline-block;
    font-size: clamp(34px, 6.4vw, 78px);
    /* Neon outer glow on the wordmark - magenta on edges, cyan inner. */
    color: #FDFAFF;
    text-shadow:
      0 0 1px rgba(255, 255, 255, 0.9),
      0 0 12px rgba(0, 229, 255, 0.55),
      0 0 24px rgba(255, 46, 151, 0.45),
      0 0 48px rgba(255, 46, 151, 0.2);
  }

  .smast__title-word--alt {
    color: #FDE0EF;
    text-shadow:
      0 0 1px rgba(255, 255, 255, 0.95),
      0 0 14px rgba(255, 46, 151, 0.7),
      0 0 32px rgba(255, 46, 151, 0.4);
  }

  /* ---- LIVE pulsing badge ---- */
  .smast__live {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    border: 1px solid var(--sy-magenta);
    background: rgba(255, 46, 151, 0.08);
    font-family: var(--sy-font-display);
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 0.22em;
    color: var(--sy-magenta);
    text-transform: uppercase;
    box-shadow:
      0 0 8px rgba(255, 46, 151, 0.35),
      inset 0 0 12px rgba(255, 46, 151, 0.18);
    animation: sy-live-pulse 2.6s ease-in-out infinite;
  }

  .smast__live-dot {
    display: inline-block;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--sy-magenta);
    box-shadow: 0 0 10px var(--sy-magenta), 0 0 18px rgba(255, 46, 151, 0.7);
  }

  .smast__live-text {
    color: var(--sy-magenta);
    text-shadow: 0 0 8px rgba(255, 46, 151, 0.6);
  }

  .smast__live-target {
    color: var(--sy-cyan);
    font-family: var(--sy-font-crt);
    font-weight: 400;
    font-size: 16px;
    letter-spacing: 0.06em;
    text-shadow: 0 0 8px rgba(0, 229, 255, 0.55);
  }

  @keyframes sy-live-pulse {
    0%, 100% {
      box-shadow:
        0 0 8px rgba(255, 46, 151, 0.35),
        inset 0 0 12px rgba(255, 46, 151, 0.18);
    }
    50% {
      box-shadow:
        0 0 18px rgba(255, 46, 151, 0.7),
        0 0 36px rgba(255, 46, 151, 0.35),
        inset 0 0 16px rgba(255, 46, 151, 0.3);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .smast__live { animation: none; }
  }

  /* ---- The neon underline rule ---- */
  .smast__rule {
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--sy-magenta) 8%,
      var(--sy-magenta) 42%,
      var(--sy-cyan) 58%,
      var(--sy-cyan) 92%,
      transparent 100%
    );
    box-shadow:
      0 0 6px rgba(255, 46, 151, 0.5),
      0 0 14px rgba(0, 229, 255, 0.35);
  }

  /* ---- Sub rail ---- */
  .smast__sub {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    align-items: baseline;
    font-family: var(--sy-font-crt);
    font-size: 16px;
    letter-spacing: 0.04em;
    color: var(--sy-ink-muted);
  }
  .smast__sub-key {
    color: var(--sy-acid);
    text-shadow: 0 0 6px rgba(0, 255, 133, 0.4);
  }
  .smast__sub-val {
    color: var(--sy-ink);
  }
  .smast__sub-sep { color: var(--sy-ink-faint); }
</style>
