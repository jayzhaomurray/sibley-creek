---
/*
 * Lane R - Status Page: subscribe rail.
 *
 * Right-rail "subscribe to status updates" stub. Visual only — the email
 * field is non-functional (the brief specified a stub). Includes channel
 * chips (Email / RSS / Webhook) the way status pages typically display
 * options, plus a discreet uptime stat block underneath.
 *
 * Sticky on wide viewports so the rail tracks the row list as the user
 * scrolls; collapses inline on mobile.
 */

interface UptimeStat {
  label: string;
  value: string;
  note?: string;
}

interface Props {
  uptime: UptimeStat[];
}

const { uptime } = Astro.props;
---
<aside class="st-rail" aria-labelledby="st-rail-h">
  <div class="st-rail__card">
    <p class="st-rail__eyebrow">Stay informed</p>
    <h2 id="st-rail-h" class="st-rail__title">Subscribe to updates</h2>
    <p class="st-rail__deck">
      Get notified the moment an indicator publishes or an investigation
      changes state. No marketing email; release stamps only.
    </p>

    <form class="st-rail__form" action="#" method="post" aria-label="Subscribe form (stub)" onsubmit="return false;">
      <label class="st-rail__label" for="st-rail-email">Email address</label>
      <div class="st-rail__inputrow">
        <input
          id="st-rail-email"
          name="email"
          type="email"
          inputmode="email"
          autocomplete="email"
          placeholder="you@example.ca"
          aria-describedby="st-rail-note"
          class="st-rail__input"
          readonly
        />
        <button type="button" class="st-rail__submit" aria-disabled="true">
          Subscribe
        </button>
      </div>
      <p id="st-rail-note" class="st-rail__note">
        Visual stub. Not wired to a backend.
      </p>
    </form>

    <div class="st-rail__channels">
      <p class="st-rail__channelkey">Other channels</p>
      <ul class="st-rail__channellist" role="list">
        <li>
          <a class="st-rail__chip" href="#">
            <span class="st-rail__chipicon" aria-hidden="true">
              <svg viewBox="0 0 16 16" width="14" height="14" fill="none">
                <path d="M3 12V4a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1Z" stroke="currentColor" stroke-width="1.2"/>
                <path d="M4 4l4 4 4-4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            Email digest
          </a>
        </li>
        <li>
          <a class="st-rail__chip" href="#">
            <span class="st-rail__chipicon" aria-hidden="true">
              <svg viewBox="0 0 16 16" width="14" height="14" fill="none">
                <circle cx="4" cy="12" r="1.3" fill="currentColor"/>
                <path d="M4 8a4 4 0 0 1 4 4M4 4a8 8 0 0 1 8 8" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round"/>
              </svg>
            </span>
            RSS feed
          </a>
        </li>
        <li>
          <a class="st-rail__chip" href="#">
            <span class="st-rail__chipicon" aria-hidden="true">
              <svg viewBox="0 0 16 16" width="14" height="14" fill="none">
                <path d="M3 8.5 7 12l6-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            Webhook
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="st-rail__uptime" aria-label="Operational metrics">
    <p class="st-rail__uptimekey">Operational metrics</p>
    <dl class="st-rail__uptimegrid">
      {uptime.map((s) => (
        <div class="st-rail__uptimeitem">
          <dt class="st-rail__uptimelabel">{s.label}</dt>
          <dd class="st-rail__uptimeval">{s.value}</dd>
          {s.note && <dd class="st-rail__uptimenote">{s.note}</dd>}
        </div>
      ))}
    </dl>
  </div>
</aside>

<style>
  .st-rail {
    display: grid;
    gap: 16px;
    align-self: start;
    position: sticky;
    top: 88px;
  }

  .st-rail__card,
  .st-rail__uptime {
    border: 1px solid var(--st-line);
    border-radius: 8px;
    background: var(--st-paper);
    padding: 20px;
  }

  .st-rail__eyebrow {
    margin: 0 0 6px;
    font-family: var(--st-mono);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--st-slate);
  }
  .st-rail__title {
    margin: 0 0 8px;
    font-family: var(--st-sans);
    font-weight: 700;
    font-size: 18px;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--st-ink);
  }
  .st-rail__deck {
    margin: 0 0 16px;
    font-family: var(--st-sans);
    font-size: 13px;
    line-height: 1.5;
    color: var(--st-slate);
  }

  .st-rail__form {
    margin: 0 0 16px;
  }
  .st-rail__label {
    font-family: var(--st-mono);
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--st-slate);
    display: block;
    margin-bottom: 6px;
  }
  .st-rail__inputrow {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 6px;
  }
  .st-rail__input {
    font-family: var(--st-mono);
    font-size: 13px;
    padding: 8px 10px;
    border: 1px solid var(--st-line);
    border-radius: 4px;
    background: var(--st-paper);
    color: var(--st-ink);
    width: 100%;
    min-width: 0;
  }
  .st-rail__input:focus-visible {
    outline: 2px solid var(--st-info);
    outline-offset: 1px;
    border-color: var(--st-info);
  }
  .st-rail__submit {
    font-family: var(--st-sans);
    font-size: 13px;
    font-weight: 500;
    padding: 8px 14px;
    border: 1px solid var(--st-ink);
    border-radius: 4px;
    background: var(--st-ink);
    color: var(--st-paper);
    cursor: not-allowed;
    opacity: 0.85;
    transition: opacity 120ms ease;
  }
  .st-rail__submit:hover {
    opacity: 1;
  }
  .st-rail__submit:focus-visible {
    outline: 2px solid var(--st-info);
    outline-offset: 2px;
  }
  .st-rail__note {
    margin: 8px 0 0;
    font-family: var(--st-mono);
    font-size: 10.5px;
    color: var(--st-slate);
  }

  .st-rail__channels {
    border-top: 1px solid var(--st-line);
    padding-top: 14px;
  }
  .st-rail__channelkey {
    margin: 0 0 8px;
    font-family: var(--st-mono);
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--st-slate);
  }
  .st-rail__channellist {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .st-rail__chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    border-radius: 999px;
    border: 1px solid var(--st-line);
    background: var(--st-paper);
    font-family: var(--st-sans);
    font-size: 12px;
    font-weight: 500;
    color: var(--st-ink);
    text-decoration: none;
    line-height: 1;
  }
  .st-rail__chip:hover {
    border-color: var(--st-info);
    color: var(--st-info);
  }
  .st-rail__chip:focus-visible {
    outline: 2px solid var(--st-info);
    outline-offset: 2px;
  }
  .st-rail__chipicon {
    color: var(--st-slate);
    display: inline-flex;
  }
  .st-rail__chip:hover .st-rail__chipicon {
    color: var(--st-info);
  }

  .st-rail__uptimekey {
    margin: 0 0 12px;
    font-family: var(--st-mono);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--st-slate);
  }
  .st-rail__uptimegrid {
    margin: 0;
    display: grid;
    gap: 14px;
  }
  .st-rail__uptimeitem {
    display: grid;
    grid-template-rows: auto auto auto;
    gap: 2px;
  }
  .st-rail__uptimelabel {
    margin: 0;
    font-family: var(--st-sans);
    font-size: 12px;
    color: var(--st-slate);
  }
  .st-rail__uptimeval {
    margin: 0;
    font-family: var(--st-mono);
    font-size: 22px;
    font-weight: 500;
    color: var(--st-ink);
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }
  .st-rail__uptimenote {
    margin: 0;
    font-family: var(--st-mono);
    font-size: 10.5px;
    color: var(--st-slate);
  }

  @media (max-width: 1100px) {
    .st-rail {
      position: static;
    }
  }
</style>
