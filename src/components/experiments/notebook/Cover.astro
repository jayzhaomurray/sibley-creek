---
/*
 * Cover - top entry of the notebook splash. Layout mirrors a Moleskine /
 * Leuchtturm1917 inside-cover: ruled paper background, marginalia in the
 * left gutter (pencil-handwritten date + a "VOL. / NO." stamp), a printed
 * masthead in the right column, and a red-ink field stamp tilted in the
 * corner. Sections nav presented as a hand-listed contents index.
 *
 * Owned by the notebook splash only.
 */
import { sections, site } from "../../../data/sections";

interface Props {
  entryDate: string;       /* e.g. "11 MAY 2026" */
  volNo: string;
  issueNo: string;
}

const { entryDate, volNo, issueNo } = Astro.props;
---
<header class="nb-cover" role="banner">
  <div class="nb-cover__grid">
    <aside class="nb-cover__margin" aria-hidden="true">
      <span class="nb-cover__pencil-tag">Field Notebook</span>
      <span class="nb-cover__pencil-arrow">&#8594;</span>
      <span class="nb-cover__pencil-tag nb-cover__pencil-tag--rot">Vol. {volNo} / No. {issueNo}</span>
      <span class="nb-cover__pencil-date">{entryDate}</span>
    </aside>

    <div class="nb-cover__main">
      <p class="nb-cover__eyebrow">Property of the researcher / if found please return</p>

      <a class="nb-cover__wordmark" href="/" aria-label={`${site.name} home`}>
        <span class="nb-cover__name nb-cover__name--one">Macro Research</span>
        <span class="nb-cover__name nb-cover__name--two">Department</span>
      </a>

      <div class="nb-cover__sub">
        <span class="nb-cover__sub-pen">a working notebook of</span>
        <span class="nb-cover__sub-print">Canadian macroeconomic prints</span>
      </div>

      <div class="nb-cover__stamp" aria-hidden="true">
        <span class="nb-cover__stamp-ring">
          <span class="nb-cover__stamp-line nb-cover__stamp-line--top">Macro Research Department</span>
          <span class="nb-cover__stamp-line nb-cover__stamp-line--big">FIELD<br />NOTEBOOK</span>
          <span class="nb-cover__stamp-line nb-cover__stamp-line--bot">est. 2026 &middot; en-CA</span>
        </span>
      </div>
    </div>
  </div>

  <nav class="nb-cover__nav" aria-label="Sections">
    <p class="nb-cover__nav-head">
      <span class="nb-cover__nav-pen">Contents</span>
      <span class="nb-cover__nav-print">— sections in this book</span>
    </p>
    <ol class="nb-cover__nav-list" role="list">
      {sections.map((s, i) => (
        <li class="nb-cover__nav-item">
          <a href={`/${s.slug}/`} class="nb-cover__nav-link">
            <span class="nb-cover__nav-num">{String(i + 1).padStart(2, "0")}</span>
            <span class="nb-cover__nav-dots" aria-hidden="true"></span>
            <span class="nb-cover__nav-label">{s.label}</span>
            <span class="nb-cover__nav-folio">p.{i + 1}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
</header>

<style>
  .nb-cover {
    position: relative;
    z-index: 3;
    padding-top: 1.4rem;
    padding-bottom: 1.8rem;
  }

  .nb-cover__grid {
    display: grid;
    grid-template-columns: var(--nb-margin-width) minmax(0, 1fr);
    column-gap: var(--nb-gutter);
    position: relative;
  }

  /* Left margin - pencil marginalia */
  .nb-cover__margin {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-top: 0.5rem;
    padding-right: 0.5rem;
    align-items: flex-end;
    color: var(--nb-pencil);
    font-family: var(--nb-font-hand);
    font-size: 1.05rem;
    line-height: 1.1;
    text-align: right;
  }
  .nb-cover__pencil-tag {
    transform: rotate(-1.4deg);
    transform-origin: right center;
  }
  .nb-cover__pencil-tag--rot {
    transform: rotate(2deg);
  }
  .nb-cover__pencil-arrow {
    font-size: 1.4rem;
    color: var(--nb-pencil);
    transform: rotate(8deg);
  }
  .nb-cover__pencil-date {
    margin-top: 0.4rem;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    transform: rotate(-0.8deg);
    text-decoration: underline;
    text-decoration-color: var(--nb-pencil-faint);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  /* Right column - printed masthead */
  .nb-cover__main {
    position: relative;
    padding: 0.5rem 0 0;
  }

  .nb-cover__eyebrow {
    margin: 0 0 0.6rem;
    font-family: var(--nb-font-hand);
    font-size: 0.95rem;
    color: var(--nb-pencil);
    letter-spacing: 0.01em;
    transform: rotate(-0.4deg);
    transform-origin: left center;
  }

  .nb-cover__wordmark {
    display: block;
    text-decoration: none;
    color: var(--nb-ink);
    line-height: 0.9;
    opacity: 0;
    animation: nb-page-settle 700ms 120ms cubic-bezier(0.2, 0.6, 0.2, 1) forwards;
  }
  .nb-cover__name {
    display: block;
    font-family: var(--nb-font-display);
    font-weight: 700;
    font-size: clamp(2.6rem, 7vw, 5.4rem);
    letter-spacing: -0.01em;
  }
  .nb-cover__name--two {
    font-style: italic;
    margin-top: -0.04em;
  }

  .nb-cover__sub {
    margin-top: 0.9rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.6rem;
  }
  .nb-cover__sub-pen {
    font-family: var(--nb-font-hand);
    font-size: 1.15rem;
    color: var(--nb-pencil);
    transform: rotate(-0.6deg);
    transform-origin: left center;
  }
  .nb-cover__sub-print {
    font-family: var(--nb-font-mono);
    font-size: 0.95rem;
    color: var(--nb-ink);
    letter-spacing: 0.02em;
  }

  /* Red-ink rubber stamp, tilted in the right edge */
  .nb-cover__stamp {
    position: absolute;
    top: -0.4rem;
    right: 0;
    width: 138px;
    height: 138px;
    transform: rotate(8deg);
    opacity: 0.86;
    pointer-events: none;
  }
  .nb-cover__stamp-ring {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    border: 2.5px double var(--nb-red);
    border-radius: 50%;
    color: var(--nb-red);
    text-align: center;
    padding: 0.4rem;
    box-sizing: border-box;
    line-height: 1;
    box-shadow: inset 0 0 0 4px transparent;
    /* slight ink-blot irregularity via box-shadow split */
    filter: contrast(1.03);
  }
  .nb-cover__stamp-line {
    font-family: var(--nb-font-typewriter);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .nb-cover__stamp-line--top {
    font-size: 0.58rem;
  }
  .nb-cover__stamp-line--big {
    font-family: var(--nb-font-display);
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0.3rem 0;
    letter-spacing: 0.02em;
    line-height: 0.95;
  }
  .nb-cover__stamp-line--bot {
    font-size: 0.55rem;
  }

  /* Contents nav */
  .nb-cover__nav {
    margin-top: 2rem;
    padding-left: calc(var(--nb-margin-width) + var(--nb-gutter));
    padding-right: 0.5rem;
  }
  .nb-cover__nav-head {
    margin: 0 0 0.7rem;
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
  }
  .nb-cover__nav-pen {
    font-family: var(--nb-font-hand);
    font-size: 1.55rem;
    color: var(--nb-ink);
    transform: rotate(-1deg);
    transform-origin: left center;
    text-decoration: underline;
    text-decoration-color: var(--nb-red);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .nb-cover__nav-print {
    font-family: var(--nb-font-mono);
    font-size: 0.85rem;
    color: var(--nb-ink-mute);
  }

  .nb-cover__nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0 1.8rem;
  }
  .nb-cover__nav-item {
    border-bottom: 1px dashed var(--nb-pencil-faint);
    padding: 0.18rem 0;
  }
  .nb-cover__nav-link {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: baseline;
    gap: 0.4rem;
    color: inherit;
    text-decoration: none;
    font-family: var(--nb-font-typewriter);
    font-size: 0.95rem;
    color: var(--nb-blue);
    letter-spacing: 0.01em;
    line-height: 1.4;
  }
  .nb-cover__nav-link:hover .nb-cover__nav-label {
    color: var(--nb-red);
  }
  .nb-cover__nav-link:focus-visible {
    outline: 2px solid var(--nb-red);
    outline-offset: 3px;
    border-radius: 2px;
  }
  .nb-cover__nav-num {
    color: var(--nb-pencil);
    font-family: var(--nb-font-mono);
    font-size: 0.78rem;
  }
  .nb-cover__nav-label {
    color: var(--nb-blue);
    transition: color 150ms ease;
  }
  .nb-cover__nav-dots {
    border-bottom: 1px dotted var(--nb-pencil);
    align-self: center;
    height: 1px;
  }
  .nb-cover__nav-folio {
    color: var(--nb-pencil);
    font-family: var(--nb-font-hand);
    font-size: 1rem;
  }

  @media (max-width: 720px) {
    .nb-cover__grid {
      grid-template-columns: 1fr;
      column-gap: 0;
    }
    .nb-cover__margin {
      flex-direction: row;
      align-items: flex-end;
      text-align: left;
      gap: 1rem;
      flex-wrap: wrap;
      justify-content: flex-start;
    }
    .nb-cover__pencil-arrow { display: none; }
    .nb-cover__stamp {
      width: 96px;
      height: 96px;
      top: -1rem;
    }
    .nb-cover__nav {
      padding-left: 0;
    }
  }

  @keyframes nb-page-settle {
    from {
      opacity: 0;
      transform: rotate(0.8deg) translateY(6px);
    }
    to {
      opacity: 1;
      transform: rotate(0deg) translateY(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .nb-cover__wordmark {
      animation: none;
      opacity: 1;
    }
  }
</style>
