---
/*
 * SectionIndex - the six non-hero sections rendered as ruled-paper journal
 * entries, each with date stamp (asOf), section name, the headline
 * question in handwriting, and a typed load-bearing print. Marginalia
 * (pencil) gives the entry number and a tiny ditto/check mark.
 */
import type { Section } from "../../../data/sections";

interface Props {
  sections: Section[];
  heroSlug: string;
}

const { sections, heroSlug } = Astro.props;
const others = sections.filter((s) => s.slug !== heroSlug);

/* Tiny entry sparkline - generates the path for a small inline trace. */
function makePath(spark: number[] | undefined, w = 70, h = 22): string {
  if (!spark || spark.length < 2) return "";
  const min = Math.min(...spark);
  const max = Math.max(...spark);
  const range = max - min || 1;
  const step = w / (spark.length - 1);
  return spark
    .map((v, i) => {
      const x = i * step;
      const y = h - ((v - min) / range) * h;
      return `${i === 0 ? "M" : "L"}${x.toFixed(2)},${y.toFixed(2)}`;
    })
    .join(" ");
}

/* Pencil "tick" / "check" pool for marginalia - deterministic per slug
 * so the same section always gets the same mark across rebuilds. */
const marginGlyphs = ["✓", "—", "¶", "•", "¤", "*"];

function glyphFor(slug: string, idx: number): string {
  let h = 0;
  for (let i = 0; i < slug.length; i += 1) {
    h = (h * 31 + slug.charCodeAt(i)) >>> 0;
  }
  return marginGlyphs[(h + idx) % marginGlyphs.length];
}
---
<section class="nb-index" aria-labelledby="nb-index-title">
  <div class="nb-index__head-grid">
    <div class="nb-index__head-margin" aria-hidden="true">
      <span class="nb-index__head-pencil">cont'd &#8595;</span>
    </div>
    <div class="nb-index__head-body">
      <p class="nb-index__pretitle">
        <span class="nb-index__pretitle-pen">Other entries this week</span>
        <span class="nb-index__pretitle-rule" aria-hidden="true"></span>
      </p>
      <h2 id="nb-index-title" class="nb-index__title">
        Six questions, six prints
      </h2>
      <p class="nb-index__sub">
        <span class="nb-index__sub-pen">read across &mdash; each section turns on a single load-bearing series.</span>
      </p>
    </div>
  </div>

  <ol class="nb-index__list" role="list">
    {others.map((s, i) => {
      const p = s.prints[0];
      const path = makePath(p.spark);
      return (
        <li class="nb-index__item">
          <div class="nb-index__item-margin" aria-hidden="true">
            <span class="nb-index__entry-no">{String(i + 2).padStart(2, "0")}</span>
            <span class="nb-index__glyph">{glyphFor(s.slug, i)}</span>
          </div>
          <a href={`/${s.slug}/`} class="nb-index__link">
            <div class="nb-index__head-row">
              <span class="nb-index__date">{p.asOf}</span>
              <span class="nb-index__dot" aria-hidden="true">&middot;</span>
              <span class="nb-index__label">{s.label}</span>
              <span class="nb-index__cadence">({s.cadence.toLowerCase()})</span>
            </div>
            <h3 class="nb-index__q">{s.headlineQuestion}</h3>
            <div class="nb-index__print">
              <span class="nb-index__print-name">{p.indicator}</span>
              <span class="nb-index__print-spark" aria-hidden="true">
                <svg viewBox="0 0 70 22" preserveAspectRatio="none">
                  <path d={path} fill="none" stroke="var(--nb-blue)" stroke-width="1" stroke-linejoin="round" />
                </svg>
              </span>
              <span class="nb-index__print-value">{p.value}</span>
              <span class="nb-index__print-delta" data-dir={p.deltaDir}>{p.delta}</span>
            </div>
          </a>
        </li>
      );
    })}
  </ol>
</section>

<style>
  .nb-index {
    position: relative;
    z-index: 2;
    padding: 1.4rem 0 1.8rem;
  }

  /* Heading grid */
  .nb-index__head-grid {
    display: grid;
    grid-template-columns: var(--nb-margin-width) minmax(0, 1fr);
    column-gap: var(--nb-gutter);
    margin-bottom: 1.3rem;
  }
  .nb-index__head-margin {
    display: flex;
    justify-content: flex-end;
    padding-right: 0.5rem;
    padding-top: 0.6rem;
  }
  .nb-index__head-pencil {
    font-family: var(--nb-font-hand);
    color: var(--nb-pencil);
    font-size: 1.15rem;
    transform: rotate(-3deg);
    transform-origin: right center;
  }
  .nb-index__head-body {
    position: relative;
  }
  .nb-index__pretitle {
    margin: 0 0 0.4rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .nb-index__pretitle-pen {
    font-family: var(--nb-font-hand);
    font-size: 1.25rem;
    color: var(--nb-ink);
    text-decoration: underline;
    text-decoration-color: var(--nb-red);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
    transform: rotate(-0.8deg);
    transform-origin: left center;
  }
  .nb-index__pretitle-rule {
    flex: 1;
    border-bottom: 1px solid var(--nb-pencil-faint);
  }
  .nb-index__title {
    margin: 0 0 0.35rem;
    font-family: var(--nb-font-display);
    font-weight: 700;
    font-size: clamp(1.6rem, 3vw, 2.3rem);
    line-height: 1.05;
    letter-spacing: -0.005em;
    color: var(--nb-ink);
  }
  .nb-index__sub {
    margin: 0;
  }
  .nb-index__sub-pen {
    font-family: var(--nb-font-hand);
    font-size: 1.05rem;
    color: var(--nb-pencil);
    transform: rotate(-0.4deg);
    display: inline-block;
    transform-origin: left center;
  }

  /* List */
  .nb-index__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--nb-ink);
  }

  .nb-index__item {
    display: grid;
    grid-template-columns: var(--nb-margin-width) minmax(0, 1fr);
    column-gap: var(--nb-gutter);
    border-bottom: 1px solid var(--nb-pencil-faint);
    padding: 0.7rem 0 0.95rem;
    position: relative;
  }
  .nb-index__item:last-child { border-bottom: 1px solid var(--nb-ink); }

  .nb-index__item-margin {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    padding-right: 0.5rem;
    padding-top: 0.2rem;
    gap: 0.3rem;
    font-family: var(--nb-font-hand);
    color: var(--nb-pencil);
  }
  .nb-index__entry-no {
    font-family: var(--nb-font-mono);
    font-size: 0.78rem;
    color: var(--nb-pencil);
    letter-spacing: 0.04em;
  }
  .nb-index__glyph {
    font-size: 1.3rem;
    color: var(--nb-red);
    transform: rotate(6deg);
  }

  .nb-index__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .nb-index__link:focus-visible {
    outline: 2px solid var(--nb-red);
    outline-offset: 4px;
    border-radius: 2px;
  }
  .nb-index__link:hover .nb-index__q {
    color: var(--nb-red);
  }

  .nb-index__head-row {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    font-family: var(--nb-font-typewriter);
    font-size: 0.85rem;
    color: var(--nb-ink-mute);
    margin-bottom: 0.25rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .nb-index__date {
    color: var(--nb-blue);
    font-weight: 700;
  }
  .nb-index__dot { color: var(--nb-pencil); }
  .nb-index__label {
    color: var(--nb-ink);
    font-weight: 700;
  }
  .nb-index__cadence {
    color: var(--nb-pencil);
    text-transform: none;
    font-size: 0.78rem;
  }

  .nb-index__q {
    margin: 0 0 0.55rem;
    font-family: var(--nb-font-display);
    font-style: italic;
    font-weight: 600;
    font-size: clamp(1.15rem, 1.7vw, 1.4rem);
    line-height: 1.18;
    letter-spacing: -0.005em;
    color: var(--nb-ink);
    text-wrap: balance;
    transition: color 150ms ease;
  }

  .nb-index__print {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) auto auto auto;
    gap: 0.5rem 0.8rem;
    align-items: center;
    font-family: var(--nb-font-typewriter);
    font-size: 0.9rem;
  }
  .nb-index__print-name {
    color: var(--nb-ink);
  }
  .nb-index__print-spark svg {
    width: 70px;
    height: 22px;
    display: block;
  }
  .nb-index__print-value {
    color: var(--nb-ink);
    font-weight: 700;
    font-feature-settings: "tnum" 1, "lnum" 1;
  }
  .nb-index__print-delta {
    font-family: var(--nb-font-mono);
    font-size: 0.78rem;
    color: var(--nb-ink-mute);
  }
  .nb-index__print-delta[data-dir="pos"] { color: var(--nb-pos); }
  .nb-index__print-delta[data-dir="neg"] { color: var(--nb-red); }

  @media (max-width: 720px) {
    .nb-index__head-grid,
    .nb-index__item {
      grid-template-columns: 1fr;
      column-gap: 0;
    }
    .nb-index__head-margin,
    .nb-index__item-margin {
      flex-direction: row;
      align-items: baseline;
      justify-content: flex-start;
      padding-right: 0;
      padding-bottom: 0.3rem;
      gap: 0.6rem;
    }
    .nb-index__print {
      grid-template-columns: 1fr auto auto;
    }
    .nb-index__print-spark { display: none; }
  }
</style>
