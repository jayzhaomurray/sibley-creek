---
/*
 * PaperFiber - subtle paper-fiber overlay for the mid-century academic
 * textbook splash. Single feTurbulence noise blended via multiply at 0.05
 * opacity to keep the off-white background reading as aged paper without
 * crushing the ink.
 *
 * Pure decoration. aria-hidden. pointer-events: none. Fixed to viewport so
 * it costs nothing on scroll.
 */
---
<div class="atx-fiber" aria-hidden="true">
  <svg width="100%" height="100%" preserveAspectRatio="none">
    <filter id="atx-fiber-filter">
      <feTurbulence
        type="fractalNoise"
        baseFrequency="0.85"
        numOctaves="2"
        seed="11"
        stitchTiles="stitch"
      />
      <feColorMatrix
        type="matrix"
        values="0 0 0 0 0.36
                0 0 0 0 0.28
                0 0 0 0 0.14
                0 0 0 0.85 0"
      />
    </filter>
    <rect width="100%" height="100%" filter="url(#atx-fiber-filter)" />
  </svg>
</div>

<style>
  .atx-fiber {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    mix-blend-mode: multiply;
    opacity: 0.05;
  }
  .atx-fiber svg {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
