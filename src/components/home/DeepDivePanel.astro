---
/*
 * DeepDivePanel - homepage working-papers panel (production).
 *
 * Pillar titles ARE canon (editorial/dashboard_purpose.md sec 5). Status,
 * last-updated date, and deck copy are not yet pipeline-driven, so those
 * three slots render explicit placeholders instead of hand-typed values.
 *
 * Aesthetic:
 *  - One sans family. Weight contrast as hierarchy.
 *  - Black hairlines between entries.
 *  - Row number rendered like a Knoll-catalogue entry code: 01 / 02 / 03
 *    in Plex Mono, regular, padded.
 *  - Placeholder status / date strings live in mono micro-caps faint gray;
 *    deck slot renders visible lorem ipsum.
 */

import type { DeepDive } from "../../data/sections";
import { PLACEHOLDER } from "../../data/site_data_loader";

interface Props {
  deepDives: DeepDive[];
  figureNum: string;
}

const { deepDives, figureNum } = Astro.props;

// Deep-dive ordering: titles + pillar codes are canon, but `lastUpdated`
// stamps are hand-typed so we cannot use them for real recency ordering
// yet. Preserve the canon array order until a pipeline source exists.
const ordered = deepDives;
---
<article class="vig-dd" aria-labelledby="vig-dd-h">
  <header class="vig-dd__head">
    <div class="vig-dd__head-left">
      <p class="vig-dd__eyebrow">
        <span class="vig-dd__fig">Figure</span>
        <span class="vig-dd__fig-n">{figureNum}.</span>
      </p>
      <h2 id="vig-dd-h" class="vig-dd__h">
        Working papers
      </h2>
    </div>
    <p class="vig-dd__count">
      {ordered.length} active
    </p>
  </header>

  <p class="vig-dd__lede vig-dd__placeholder">
    {PLACEHOLDER.loremShort}
  </p>

  <ol class="vig-dd__list" role="list">
    {ordered.map((dd, i) => (
      <li class="vig-dd__row">
        <div class="vig-dd__row-num" aria-hidden="true">
          <span class="vig-dd__row-num-n">{String(i + 1).padStart(2, "0")}</span>
        </div>
        <div class="vig-dd__row-body">
          <p class="vig-dd__row-meta">
            <span class="vig-dd__pillar">Pillar {dd.pillar}</span>
            <span class="vig-dd__row-sep" aria-hidden="true"></span>
            <span class="vig-dd__section">{dd.section}</span>
            <span class="vig-dd__row-sep" aria-hidden="true"></span>
            <span class="vig-dd__status vig-dd__placeholder vig-dd__placeholder--micro">
              {PLACEHOLDER.statusPending}
            </span>
          </p>
          <h3 class="vig-dd__title">{dd.title}</h3>
          <p class="vig-dd__deck vig-dd__placeholder">
            {PLACEHOLDER.loremMid}
          </p>
          <p class="vig-dd__stamp vig-dd__placeholder vig-dd__placeholder--micro">
            Updated {PLACEHOLDER.notWired}
          </p>
        </div>
      </li>
    ))}
  </ol>
</article>

<style>
  .vig-dd {
    background: var(--paper);
    padding: 18px 20px 16px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-height: 100%;
  }

  .vig-dd__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 10px;
  }
  .vig-dd__head-left { min-width: 0; }
  .vig-dd__eyebrow {
    margin: 0;
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 10px;
    line-height: 1;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .vig-dd__fig {
    color: var(--ink);
  }
  .vig-dd__fig-n {
    color: var(--accent);
    font-weight: 800;
    letter-spacing: 0.1em;
  }
  .vig-dd__h {
    margin: 6px 0 0;
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 22px;
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .vig-dd__count {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 10px;
    line-height: 1;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .vig-dd__lede {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 200;
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink);
    max-width: 56ch;
  }

  .vig-dd__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid var(--ink);
  }
  .vig-dd__row {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 12px;
    padding: 12px 0 14px;
    border-bottom: 1px solid var(--ink);
  }
  .vig-dd__row:last-child {
    border-bottom: 0;
  }
  .vig-dd__row-num {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 12px;
    line-height: 1;
    color: var(--ink);
    padding-top: 3px;
    font-variant-numeric: tabular-nums;
  }
  .vig-dd__row-num-n {
    display: inline-block;
    border-bottom: 1px solid var(--ink);
    padding: 0 0 2px 0;
  }
  .vig-dd__row-body { min-width: 0; }

  .vig-dd__row-meta {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 9.5px;
    line-height: 1.1;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .vig-dd__pillar { color: var(--ink); font-weight: 800; }
  .vig-dd__section { color: var(--ink); }
  .vig-dd__row-sep {
    display: inline-block;
    width: 3px;
    height: 3px;
    background: var(--ink);
  }
  .vig-dd__status {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .vig-dd__title {
    margin: 6px 0 0;
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 15px;
    line-height: 1.2;
    letter-spacing: -0.005em;
    color: var(--ink);
  }
  .vig-dd__deck {
    margin: 5px 0 0;
    font-family: var(--font-sans);
    font-weight: 200;
    font-size: 12.5px;
    line-height: 1.45;
    color: var(--ink);
    max-width: 52ch;
  }
  .vig-dd__stamp {
    margin: 8px 0 0;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 10px;
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
  }

  /* Placeholder ink: --ink-faint resolves to pure black under the Vignelli
   * canon, so a hard-coded mid-gray gives the lorem / [ NOT WIRED ] markers
   * visible softening. Pairs with mono micro-caps for date / status slots. */
  .vig-dd__placeholder {
    color: #8A8A8A;
  }
  .vig-dd__placeholder--micro {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
</style>
