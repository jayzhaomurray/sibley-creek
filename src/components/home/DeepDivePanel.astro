---
/*
 * DeepDivePanel - homepage working-papers panel (production).
 *
 * Pillar titles ARE canon (editorial/dashboard_purpose.md sec 5). Status,
 * last-updated date, and deck copy are not yet pipeline-driven, so those
 * three slots render explicit placeholders instead of hand-typed values.
 *
 * Aesthetic:
 *  - One sans family. Weight contrast as hierarchy.
 *  - Black hairlines between entries.
 *  - Row number rendered like a Knoll-catalogue entry code: 01 / 02 / 03
 *    in Plex Mono, regular, padded.
 *  - Placeholder status / date strings live in mono micro-caps faint gray;
 *    deck slot renders visible lorem ipsum.
 */

import type { DeepDive } from "../../data/sections";
import { PLACEHOLDER } from "../../data/site_data_loader";
import { withBase } from "../../lib/urls";

interface Props {
  deepDives: DeepDive[];
  figureNum: string;
}

const { deepDives, figureNum } = Astro.props;

// Deep-dive ordering: newest first by `publishedAt`. Entries with "TK" or
// missing publishedAt sort to the bottom (treated as not-yet-dated plans).
// Take the top 3 — the splash card is a teaser; the full list lives at
// /research/.
function publishedAtOrder(a: string | undefined, b: string | undefined): number {
  const isMissing = (v: string | undefined): boolean =>
    !v || v === "TK" || !/^\d{4}-\d{2}-\d{2}$/.test(v);
  const am = isMissing(a);
  const bm = isMissing(b);
  if (am && bm) return 0;
  if (am) return 1;
  if (bm) return -1;
  return (b as string).localeCompare(a as string);
}

const ordered = [...deepDives]
  .sort((x, y) => publishedAtOrder(x.publishedAt, y.publishedAt))
  .slice(0, 3);

// Date formatter for "Published <date>" stamp; mirrors the research index.
const MONTH_SHORT = [
  "Jan", "Feb", "Mar", "Apr", "May", "Jun",
  "Jul", "Aug", "Sep", "Oct", "Nov", "Dec",
];
function displayDate(raw?: string): string {
  if (!raw || raw === "TK") return "TK";
  const parts = raw.split("-");
  if (parts.length !== 3) return raw;
  const [y, m, d] = parts.map((n) => parseInt(n, 10));
  if (Number.isNaN(y) || Number.isNaN(m) || Number.isNaN(d)) return raw;
  if (m < 1 || m > 12) return raw;
  return `${MONTH_SHORT[m - 1]} ${d}, ${y}`;
}
---
<article class="vig-dd" aria-labelledby="vig-dd-h">
  <header class="vig-dd__head">
    <div class="vig-dd__head-left">
      <p class="vig-dd__eyebrow">
        <span class="vig-dd__fig">Figure</span>
        <span class="vig-dd__fig-n">{figureNum}.</span>
      </p>
      <h2 id="vig-dd-h" class="vig-dd__h">
        <a class="vig-dd__h-link" href={withBase("/research/")}>Research</a>
      </h2>
    </div>
  </header>

  <ol class="vig-dd__list" role="list">
    {ordered.map((dd, i) => {
      const isPublished = Boolean(dd.publishedPath);
      const RowBody = (
        <>
          <div class="vig-dd__row-num" aria-hidden="true">
            <span class="vig-dd__row-num-n">{String(i + 1).padStart(2, "0")}</span>
          </div>
          <div class="vig-dd__row-body">
            <p class="vig-dd__row-meta">
              <span class="vig-dd__section">{dd.section}</span>
            </p>
            <h3 class="vig-dd__title">{dd.title}</h3>
            <p class="vig-dd__deck">{dd.deck}</p>
            <p class="vig-dd__stamp">
              {isPublished ? (
                <>
                  <span class="vig-dd__stamp-label">Published</span>
                  {" "}
                  <span class="vig-dd__stamp-body">{displayDate(dd.publishedAt)}</span>
                </>
              ) : (
                <span class="vig-dd__stamp-body vig-dd__stamp-body--tk">Coming soon</span>
              )}
            </p>
          </div>
        </>
      );
      return (
        <li class:list={["vig-dd__row", { "vig-dd__row--unpublished": !isPublished }]}>
          {/* Until individual pieces are promoted to editorial/published/, every
            * row links to /research/ (the index). Once a piece publishes, its
            * row's link target switches to its own slug page automatically. */}
          <a
            class="vig-dd__row-link"
            href={isPublished ? withBase(`/research/${dd.slug}/`) : withBase("/research/")}
          >
            {RowBody}
          </a>
        </li>
      );
    })}
  </ol>
</article>

<style>
  .vig-dd {
    background: var(--paper);
    padding: 18px 20px 16px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-height: 100%;
  }

  .vig-dd__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 10px;
  }
  .vig-dd__head-left { min-width: 0; }
  .vig-dd__eyebrow {
    margin: 0;
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 10px;
    line-height: 1;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .vig-dd__fig {
    color: var(--ink);
  }
  .vig-dd__fig-n {
    color: var(--accent);
    font-weight: 800;
    letter-spacing: 0.1em;
  }
  .vig-dd__h {
    margin: 6px 0 0;
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 22px;
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .vig-dd__h-link {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 80ms linear;
  }
  .vig-dd__h-link:hover {
    border-bottom-color: var(--ink);
  }
  .vig-dd__h-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .vig-dd__count {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 10px;
    line-height: 1;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .vig-dd__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
    /* No border-top: the header's closing rule already separates header
     * from body. Stacking another hairline created a double-rule + visible
     * gap between the "Research" heading and the first row. */
  }
  .vig-dd__row {
    border-bottom: 1px solid var(--ink);
  }
  .vig-dd__row:last-child {
    border-bottom: 0;
  }
  /* Row link wraps the whole row; published rows are clickable, unpublished
   * rows render the same content in a non-interactive div with no hover
   * affordance (route does not exist until publication). */
  .vig-dd__row-link {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 12px;
    padding: 12px 0 14px;
    color: inherit;
    text-decoration: none;
    transition: opacity 120ms ease-out;
  }
  a.vig-dd__row-link:hover .vig-dd__title {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  a.vig-dd__row-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .vig-dd__row-link--unpublished {
    cursor: default;
  }
  .vig-dd__row-num {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 12px;
    line-height: 1;
    color: var(--ink);
    padding-top: 3px;
    font-variant-numeric: tabular-nums;
  }
  .vig-dd__row-num-n {
    display: inline-block;
    border-bottom: 1px solid var(--ink);
    padding: 0 0 2px 0;
  }
  .vig-dd__row-body { min-width: 0; }

  .vig-dd__row-meta {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 9.5px;
    line-height: 1.1;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .vig-dd__pillar { color: var(--ink); font-weight: 800; }
  .vig-dd__section { color: var(--ink); }
  .vig-dd__row-sep {
    display: inline-block;
    width: 3px;
    height: 3px;
    background: var(--ink);
  }
  .vig-dd__status {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .vig-dd__title {
    margin: 6px 0 0;
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 15px;
    line-height: 1.2;
    letter-spacing: -0.005em;
    color: var(--ink);
  }
  .vig-dd__deck {
    margin: 5px 0 0;
    font-family: var(--font-sans);
    font-weight: 200;
    font-size: 12.5px;
    line-height: 1.45;
    color: var(--ink);
    max-width: 52ch;
  }
  .vig-dd__stamp {
    margin: 8px 0 0;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 10px;
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
  }

  /* Placeholder ink: --ink-faint resolves to pure black under the Vignelli
   * canon, so a hard-coded mid-gray gives the lorem / [ NOT WIRED ] markers
   * visible softening. Pairs with mono micro-caps for date / status slots. */
  .vig-dd__placeholder {
    color: #8A8A8A;
  }
  .vig-dd__placeholder--micro {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  /* "Coming soon" stamp on unpublished deep dives. Mirrors the research
   * index's `--tk` rule so the unpublished status reads in placeholder
   * gray rather than the pure-ink "Published <date>" Plex Mono treatment.
   * Class is set on the same span as `.vig-dd__stamp-body` so it inherits
   * the host's font-family (sans micro-caps) but overrides the color. */
  .vig-dd__stamp-body--tk {
    font-family: var(--font-mono);
    color: #8A8A8A;
  }
</style>
