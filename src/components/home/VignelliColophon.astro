---
/*
 * VignelliColophon - site-wide page footer for the production canon.
 *
 * 2026-05-20: Rebuilt (again) as a multi-column fat footer.
 *
 *   Previous colophon: slim two-line layout (brand mark + secondary nav).
 *
 *   New structure: three columns + brand strip.
 *
 *     COL 1: TOPICS       COL 2: COMPANY         COL 3: CONNECT
 *     Overview            About                   Subscribe
 *     Output              Methodology             Contact
 *     Inflation           Research
 *     Labour              Advisory
 *     Housing
 *     Policy
 *     Markets
 *     Trade
 *
 *     ----------------------------------------------------------------
 *     SIBLEY CREEK . Independent macroeconomic research and advisory . (c) 2026
 *
 *   Topics column iterates the sections array so any slug rename flows
 *   through automatically.
 *
 * Aesthetic discipline:
 *   - Column headers: Manrope SemiBold, 9.5px, 0.22em tracking, uppercase.
 *   - Item links: Manrope Regular (400), 12px, ink color. Hover -> accent.
 *   - Top rule: 1px pure black hairline.
 *   - Bottom brand strip: Manrope 800 for the wordmark; Manrope 300 for desc.
 *   - 3 columns on desktop (>= 720px), stacked single-column on mobile.
 */

import { site, sections } from "../../data/sections";
import { withBase } from "../../lib/urls";

const currentYear = new Date().getFullYear();
---
<footer class="vig-col" role="contentinfo">

  {/* Top hairline rule */}
  <div class="vig-col__rules" aria-hidden="true">
    <hr class="vig-col__rule vig-col__rule--ink" />
  </div>

  {/* Three-column sitemap grid */}
  <div class="vig-col__grid">

    {/* Column 1: Topics */}
    <nav class="vig-col__col" aria-label="Topics">
      <p class="vig-col__col-header">Topics</p>
      <ul class="vig-col__col-list">
        <li>
          <a class="vig-col__col-link" href={withBase("/overview/")}>Overview</a>
        </li>
        {sections.map((section) => (
          <li>
            <a class="vig-col__col-link" href={withBase(`/${section.slug}/`)}>
              {section.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    {/* Column 2: Company */}
    <nav class="vig-col__col" aria-label="Company">
      <p class="vig-col__col-header">Company</p>
      <ul class="vig-col__col-list">
        <li>
          <a class="vig-col__col-link" href={withBase("/about/")}>About</a>
        </li>
        <li>
          <a class="vig-col__col-link" href={withBase("/methodology/")}>Methodology</a>
        </li>
        <li>
          <a class="vig-col__col-link" href={withBase("/research/")}>Research</a>
        </li>
        <li>
          <a class="vig-col__col-link" href={withBase("/advisory/")}>Advisory</a>
        </li>
      </ul>
    </nav>

    {/* Column 3: Connect */}
    <nav class="vig-col__col" aria-label="Connect">
      <p class="vig-col__col-header">Connect</p>
      <ul class="vig-col__col-list">
        <li>
          <a class="vig-col__col-link" href={withBase("/subscribe/")}>Subscribe</a>
        </li>
        <li>
          <a class="vig-col__col-link" href={withBase("/contact/")}>Contact</a>
        </li>
      </ul>
    </nav>

  </div>

  {/* Brand strip: hairline + one line */}
  <div class="vig-col__brand-strip">
    <hr class="vig-col__brand-rule" aria-hidden="true" />
    <p class="vig-col__brand-line">
      <span class="vig-col__brand-name">{site.name}</span>
      <span class="vig-col__brand-sep" aria-hidden="true">|</span>
      <span class="vig-col__brand-desc">Independent macroeconomic research and advisory</span>
      <span class="vig-col__brand-sep" aria-hidden="true">|</span>
      <span class="vig-col__brand-copy">&copy;&nbsp;{currentYear}</span>
    </p>
  </div>

</footer>

<style>
  .vig-col {
    padding-block: 32px 28px;
  }

  /* Top rule */
  .vig-col__rules {
    margin: 0 0 28px;
  }
  .vig-col__rule {
    border: 0;
    margin: 0;
  }
  .vig-col__rule--ink {
    border-top: 1px solid var(--ink);
  }

  /* ── Three-column grid ── */
  .vig-col__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px 40px;
    margin-bottom: 32px;
  }
  @media (min-width: 720px) {
    .vig-col__grid {
      /* Topics column wider (more items); Company + Connect equal narrow */
      grid-template-columns: 2fr 1fr 1fr;
    }
  }

  /* ── Column anatomy ── */

  /* Column header: micro-caps, Manrope SemiBold */
  .vig-col__col-header {
    margin: 0 0 12px;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 9.5px;
    line-height: 1;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .vig-col__col-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .vig-col__col-link {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 12px;
    line-height: 1.3;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 1px;
    transition:
      color 80ms linear,
      border-color 80ms linear;
  }
  .vig-col__col-link:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
  .vig-col__col-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /* ── Brand strip ── */
  .vig-col__brand-rule {
    border: 0;
    border-top: 1px solid var(--ink);
    margin: 0 0 14px;
  }
  .vig-col__brand-line {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 11px;
    line-height: 1.4;
    color: var(--ink);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    /* Breathing room around the vertical-bar separators */
    gap: 0 14px;
  }
  .vig-col__brand-name {
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 10px;
  }
  .vig-col__brand-sep {
    font-weight: 300;
    opacity: 0.32;
    color: var(--ink-faint);
  }
  .vig-col__brand-desc {
    font-weight: 300;
  }
  .vig-col__brand-copy {
    font-weight: 300;
    opacity: 0.7;
  }
</style>
