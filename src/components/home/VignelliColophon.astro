---
/*
 * VignelliColophon - site-wide page footer for the production canon.
 *
 * Adapted from src/components/experiments/academic-vignelli/Colophon.astro,
 * promoted out of the experiments dir. Differences from the splash version:
 *
 *   - Reads `site` + `nextRelease` from data/sections.ts (no props for
 *     publication / nextRelease shape; the footer is always-on chrome).
 *   - Drops the "This page is a design experiment..." disclaimer line; this
 *     is the production footer. The placeholder-vintage caveat is still
 *     present as a single short sentence.
 *   - "Produced" stamp uses the current date so the footer always reflects
 *     the build.
 *
 * Aesthetic discipline:
 *   - Two stacked rules above the row: signal red 2px + pure black 1px.
 *     The single brand-signal moment in the footer.
 *   - One sans family (Manrope) for everything; values that are numeric
 *     (next-release date, produced date) use IBM Plex Mono regular.
 *   - Black hairlines between blocks.
 */

import { site } from "../../data/sections";
import { withBase } from "../../lib/urls";
---
<footer class="vig-col" role="contentinfo">
  <div class="vig-col__rules" aria-hidden="true">
    <hr class="vig-col__rule vig-col__rule--ink" />
  </div>

  <div class="vig-col__row">
    <p class="vig-col__mark">
      <span class="vig-col__mark-name">{site.name}</span>
      <span class="vig-col__sep" aria-hidden="true"></span>
      <span class="vig-col__sub">Independent research.</span>
    </p>
    <p class="vig-col__notes">
      Reported values match the most recently published release vintage;
      revisions are not reconciled across releases.
    </p>
  </div>

  <div class="vig-col__sources">
    <p class="vig-col__sources-label">Sources</p>
    <p class="vig-col__sources-body">
      Statistics Canada;
      Bank of Canada;
      Canadian Real Estate Association;
      Department of Finance Canada;
      Canadian Bankers Association;
      Alberta Economic Dashboard;
      C.D. Howe Institute Business Cycle Council;
      Federal Reserve Economic Data (FRED);
      Yahoo Finance.
    </p>
  </div>

  {/*
   * Secondary nav: institutional pages.
   *
   * About + Methodology live in the footer, not the masthead. The masthead
   * is reserved for the seven sections + Research. This block uses the
   * micro-caps + hairline-separator vocabulary already established by the
   * sources label above so it slots cleanly into the colophon's register.
   */}
  <nav class="vig-col__secondary" aria-label="Institutional pages">
    <p class="vig-col__secondary-label">Publication</p>
    <ul class="vig-col__secondary-list">
      <li class="vig-col__secondary-item">
        <a class="vig-col__secondary-link" href={withBase("/about/")}>About</a>
      </li>
      <li class="vig-col__secondary-item">
        <a class="vig-col__secondary-link" href={withBase("/methodology/")}>
          Methodology
        </a>
      </li>
    </ul>
  </nav>

</footer>

<style>
  .vig-col {
    padding-block: 22px 32px;
  }
  .vig-col__rules {
    margin: 0 0 16px;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .vig-col__rule {
    border: 0;
    margin: 0;
  }
  .vig-col__rule--signal {
    border-top: 2px solid var(--accent);
  }
  .vig-col__rule--ink {
    border-top: 1px solid var(--ink);
  }
  .vig-col__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }
  @media (min-width: 720px) {
    .vig-col__row {
      grid-template-columns: 1fr 2fr;
      gap: 32px;
    }
  }
  .vig-col__mark {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.3;
    color: var(--ink);
  }
  .vig-col__mark-name {
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 12px;
  }
  .vig-col__sep {
    display: inline-block;
    width: 1px;
    height: 11px;
    background: var(--ink);
  }
  .vig-col__sub {
    color: var(--ink);
    font-weight: 200;
    font-size: 13px;
  }
  .vig-col__notes {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 200;
    font-size: 12px;
    line-height: 1.55;
    color: var(--ink);
    max-width: 76ch;
  }

  /* Sources block — consolidates all data source attributions for the
   * splash + section pages into one footer location. Spelled out in
   * full (no abbreviations) per editorial decision. */
  .vig-col__sources {
    margin: 16px 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--ink);
    display: grid;
    grid-template-columns: 1fr;
    gap: 6px;
  }
  @media (min-width: 720px) {
    .vig-col__sources {
      grid-template-columns: max-content 1fr;
      gap: 18px;
      align-items: baseline;
    }
  }
  .vig-col__sources-label {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 9.5px;
    line-height: 1;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .vig-col__sources-body {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 12px;
    line-height: 1.55;
    color: var(--ink);
    max-width: 80ch;
  }

  /* Secondary nav: About / Methodology. Mirrors the Sources block layout
   * (label column + body column on desktop, stacked on mobile) and the
   * sources block's hairline-separator entry into the colophon. */
  .vig-col__secondary {
    margin: 16px 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--ink);
    display: grid;
    grid-template-columns: 1fr;
    gap: 6px;
  }
  @media (min-width: 720px) {
    .vig-col__secondary {
      grid-template-columns: max-content 1fr;
      gap: 18px;
      align-items: baseline;
    }
  }
  .vig-col__secondary-label {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 9.5px;
    line-height: 1;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .vig-col__secondary-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0;
  }
  .vig-col__secondary-item {
    display: inline-flex;
    align-items: center;
  }
  /* Hairline separator between items: vertical 1px black rule, matching
   * the wordmark separator vocabulary above. The first item carries no
   * leading rule. */
  .vig-col__secondary-item + .vig-col__secondary-item::before {
    content: "";
    display: inline-block;
    width: 1px;
    height: 10px;
    background: var(--ink);
    margin: 0 14px;
  }
  .vig-col__secondary-link {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 10px;
    line-height: 1;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 2px;
    transition:
      color 80ms linear,
      border-color 80ms linear;
  }
  .vig-col__secondary-link:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
  .vig-col__secondary-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

</style>
