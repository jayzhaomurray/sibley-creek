---
/*
 * VignelliMasthead - site-wide page header for the production canon.
 *
 * Adapted from src/components/experiments/academic-vignelli/Masthead.astro,
 * promoted out of the experiments dir. Differences from the splash version:
 *
 *   - Reads from `site` + `sections` (data/sections.ts) so the wordmark and
 *     primary nav are sourced from data, not props.
 *   - Replaces the "Return to production homepage" link (a splash affordance)
 *     with the production primary section nav. Section links are routed to
 *     `/{slug}/`; active section is detected from `Astro.url.pathname`.
 *
 * Rail (showRail prop):
 *   The institutional rail previously rendered "Series / As of / Edition"
 *   filler. It was removed (2026-05-11) because the rail content was not
 *   informational - we will not ship placeholder eyebrows. The `showRail`
 *   prop is preserved at the call sites (BaseLayout's `showMastheadRail`)
 *   so we can wire content back in if a genuinely informational rail
 *   (e.g. an "As of" date stamp tied to data freshness) is decided. While
 *   no rail content is defined, the prop is accepted but renders nothing.
 *
 * Aesthetic discipline (Vignelli register):
 *   - Manrope Black (900) wordmark, all caps, tight tracking.
 *   - Manrope SemiBold (600) micro-caps for section nav labels.
 *   - Tight ink-faint pipe separators between nav labels (Vignelli chrome).
 *   - Pure black hairline rule underneath.
 *   - Signal red used only on focus rings / hover transition target.
 *
 * Layout:
 *   Wordmark and primary nav share a single flex row with `space-between`
 *   on desktop so the whole header sits on one line at 1440 viewport.
 *   The row wraps on mobile (<= 720px) to stack the nav below the mark.
 */

import { site, sections } from "../../data/sections";

interface Props {
  /**
   * Reserved for a future informational rail (date stamp, edition marker,
   * etc.). Currently unused at render - the prop survives so call sites
   * (BaseLayout `showMastheadRail`) keep working without churn the day we
   * reintroduce a rail. Accepted via the Props interface; not destructured
   * because nothing in the template reads it yet.
   */
  showRail?: boolean;
}

// Props.showRail is intentionally not destructured; see interface doc above.

const pathname = Astro.url.pathname;
const firstSegment = pathname.split("/").filter(Boolean)[0] ?? "";
---
<header class="vig-mast" role="banner">
  <div class="vig-mast__row">
    <a class="vig-mast__mark-link" href="/" aria-label={`${site.name} home`}>
      <span class="vig-mast__mark">{site.name}</span>
    </a>

    <nav class="vig-mast__nav" aria-label="Primary">
      <ul role="list" class="vig-mast__nav-list">
        {sections.map((section) => {
          const isActive = firstSegment === section.slug;
          return (
            <li class="vig-mast__nav-item">
              <a
                class:list={["vig-mast__nav-link", { "is-active": isActive }]}
                href={`/${section.slug}/`}
                aria-current={isActive ? "page" : undefined}
              >
                {section.label}
              </a>
            </li>
          );
        })}
        <li class="vig-mast__nav-item">
          <a
            class:list={["vig-mast__nav-link", { "is-active": firstSegment === "research" }]}
            href="/research/"
            aria-current={firstSegment === "research" ? "page" : undefined}
          >
            Research
          </a>
        </li>
      </ul>
    </nav>
  </div>

  <hr class="vig-mast__rule" aria-hidden="true" />
</header>

<style>
  .vig-mast {
    padding-top: 20px;
  }
  .vig-mast__row {
    display: flex;
    flex-wrap: nowrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 28px;
    padding-bottom: 12px;
  }
  .vig-mast__mark-link {
    color: var(--ink);
    text-decoration: none;
    flex: 0 0 auto;
    border-bottom: 1px solid transparent;
    transition: border-color 80ms linear;
  }
  .vig-mast__mark-link:hover {
    border-bottom-color: var(--ink);
  }
  .vig-mast__mark-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .vig-mast__mark {
    font-family: var(--font-sans);
    /* Manrope Black for the SIBLEY CREEK wordmark - heavier stroke than the
     * 800 it replaced; the shorter brand name carries the extra weight. */
    font-weight: 900;
    font-size: 16px;
    line-height: 1;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .vig-mast__nav {
    flex: 0 1 auto;
    min-width: 0;
  }
  .vig-mast__nav-list {
    display: flex;
    flex-wrap: nowrap;
    align-items: baseline;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .vig-mast__nav-item {
    display: inline-flex;
    align-items: baseline;
    min-width: 0;
  }
  /* Vignelli pipe separators between nav labels.
   *
   * Rendered as `::after` pseudo-content on each item except the last.
   * The pipe is a real glyph in the same Manrope family + line-height as
   * the label, so x-height alignment is automatic - no manual translateY
   * or background hairline. We mark the pipe aria-hidden via the standard
   * `::after`-on-decorative rule: screen readers ignore generated content
   * by default, so no extra ARIA wiring is needed.
   *
   * Color uses --ink-faint (semantic slot for faint ink chrome). Tokens
   * currently resolve --ink-faint to pure black under the Vignelli canon,
   * so we additionally drop opacity to 0.32 to give the pipe visible
   * restraint against the SemiBold labels. If a future token revision
   * gives --ink-faint a true tinted value, the opacity still composes
   * cleanly and the pipe gets even quieter without code change.
   *
   * Spacing: the pipe sits ~7px from each neighboring label
   * (margin-left + margin-right on the pseudo). Tighter than the previous
   * 18px nav-list gap; reads as `LABEL | LABEL`, not `LABEL  |  LABEL`.
   */
  .vig-mast__nav-item + .vig-mast__nav-item::before {
    content: "|";
    display: inline-block;
    margin: 0 7px;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 11px;
    line-height: 1.2;
    color: var(--ink-faint);
    opacity: 0.32;
    /* Decorative: ensure no underline ever inherits from a focused parent. */
    text-decoration: none;
    /* Sit on the same baseline as the labels. */
    vertical-align: baseline;
  }
  .vig-mast__nav-link {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 11px;
    line-height: 1.2;
    /* Slightly tightened from 0.14em so the seven-label row clears 1240px
     * comfortably with the wordmark on the same line. */
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    padding-block: 4px;
    border-bottom: 1px solid transparent;
    transition: border-color 80ms linear;
    white-space: nowrap;
  }
  .vig-mast__nav-link:hover {
    border-bottom-color: var(--ink);
  }
  .vig-mast__nav-link.is-active {
    border-bottom-color: var(--ink);
  }
  .vig-mast__nav-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .vig-mast__rule {
    border: 0;
    border-top: 1px solid var(--ink);
    margin: 0;
  }

  /* Mobile: stack the wordmark above the nav and allow the nav to wrap.
   * The pipe separators remain between adjacent items on the same line;
   * a wrapped row drops the pipe at the wrap point (because `::before`
   * is per item, not per visual neighbor). That's acceptable Vignelli
   * fallback; tighter chrome is a desktop concern. */
  @media (max-width: 720px) {
    .vig-mast__row {
      flex-wrap: wrap;
      gap: 12px 20px;
    }
    .vig-mast__nav-list {
      flex-wrap: wrap;
      row-gap: 4px;
    }
  }
</style>
