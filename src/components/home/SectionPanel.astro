---
/*
 * SectionPanel - homepage indicator panel (production).
 *
 * Consumes the merged "enriched section" shape from
 * src/data/site_data_loader.ts: editorial canon (slug, label,
 * headlineQuestion, cadence) plus pipeline data (prints, spark, asOf,
 * reference). Every field the pipeline did not produce is rendered as an
 * obvious placeholder (em-dashes for numbers, mono "[ NOT WIRED ]" for
 * dates, a dashed-border empty box for the chart). The intent is that an
 * editor scanning the homepage can tell at a glance which numbers are real
 * and which are still stubs.
 *
 * Aesthetic:
 *  - No fill. Panel is white with a 1px black hairline.
 *  - One sans family (Manrope). Tabular data in Plex Mono regular.
 *  - Deltas encoded by ^ / v glyphs in pure black; hue is NEVER used to
 *    encode direction.
 *  - Real chart: black 1.5px line, latest-print dot is the only red.
 *  - Placeholder chart: dashed-border empty box with "DATA NOT YET WIRED"
 *    micro caps centered in faint gray (so it cannot be confused with a
 *    real chart at any size).
 */

import type { EnrichedSection, EnrichedPrint } from "../../data/site_data_loader";
import { PLACEHOLDER } from "../../data/site_data_loader";

interface Props {
  section: EnrichedSection;
  figureNum: string;
}

const { section, figureNum } = Astro.props;

const loadBearing: EnrichedPrint = section.loadBearing;

// ---- Chart affordance helpers --------------------------------------------
// (1) Earliest-date label: derive from asOfISO and the spark window length so
//     the reader can see the time span the chart covers (e.g. "MAY 2024 ...
//     APR 2026") instead of an opaque "EARLIEST" stamp.
// (2) Y-tick unit suffix: pulled from the pipeline's `units` field and pinned
//     to the topmost tick only, per canon Section 5.3 ("topmost tick carries
//     the unit").
// (3) Delta-period stamp: "m/m" / "d/d" / "q/q" derived from the series'
//     `frequency` so the reader knows what window the delta compares.

function fmtDateLabel(iso: string, withDay: boolean): string {
  const m = iso.match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if (!m) return iso.toUpperCase();
  const [, yy, mm, dd] = m;
  const months = ["JAN","FEB","MAR","APR","MAY","JUN","JUL","AUG","SEP","OCT","NOV","DEC"];
  const mon = months[parseInt(mm!, 10) - 1] ?? mm!;
  if (withDay) return `${mon} ${parseInt(dd!, 10)}, ${yy}`;
  return `${mon} ${yy}`;
}

function computeEarliestISO(asOfISO: string | null, n: number, frequency: string | null): string | null {
  if (!asOfISO || n < 2) return null;
  const m = asOfISO.match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if (!m) return null;
  const yy = parseInt(m[1]!, 10);
  const mm = parseInt(m[2]!, 10);
  const dd = parseInt(m[3]!, 10);
  const back = n - 1;
  if (frequency === "daily") {
    const t = new Date(Date.UTC(yy, mm - 1, dd));
    t.setUTCDate(t.getUTCDate() - back);
    const py = t.getUTCFullYear();
    const pm = String(t.getUTCMonth() + 1).padStart(2, "0");
    const pd = String(t.getUTCDate()).padStart(2, "0");
    return `${py}-${pm}-${pd}`;
  }
  if (frequency === "quarterly") {
    const totalMonths = (yy * 12 + (mm - 1)) - back * 3;
    const py = Math.floor(totalMonths / 12);
    const pm = String((totalMonths % 12) + 1).padStart(2, "0");
    return `${py}-${pm}-01`;
  }
  // monthly (default)
  const totalMonths = (yy * 12 + (mm - 1)) - back;
  const py = Math.floor(totalMonths / 12);
  const pm = String((totalMonths % 12) + 1).padStart(2, "0");
  return `${py}-${pm}-01`;
}

function periodStampFor(frequency: string | null): string {
  if (frequency === "daily") return "d/d";
  if (frequency === "quarterly") return "q/q";
  if (frequency === "monthly") return "m/m";
  return "";
}

// Axis scale is decided ONCE per chart from the y-extent, so every tick on
// the axis renders in the same magnitude. The topmost tick carries the unit
// suffix; other ticks render bare. Auto-scales CAD millions to $B when any
// tick on the axis crosses $1B (i.e. the LARGEST magnitude across all ticks
// determines the scale — once we go to $B, every tick is in $B).
interface AxisScale {
  factor: number;       // multiplier applied to every tick value
  suffix: string;       // unit suffix appended to the TOP tick only
  decimals: number;     // decimals applied to every tick value
}

// Decimals derive from the SCALED step (the visible distance between
// consecutive ticks after factor is applied), not from the value magnitude.
// A step of 0.5 needs 1 decimal ("2.0"); a step of 1 needs 0 decimals
// ("3"); a step of 0.05 needs 2 decimals ("1.40"). Avoids the dumb case
// where a 2.5% tick rendered "2.50" because the value happened to be < 10.
function decimalsForStep(step: number): number {
  const s = Math.abs(step);
  if (s >= 1) return 0;
  if (s >= 0.1) return 1;
  if (s >= 0.01) return 2;
  if (s >= 0.001) return 3;
  return 4;
}

function computeAxisScale(yMin: number, yMax: number, step: number, units: string | null): AxisScale {
  if (!units) {
    return { factor: 1, suffix: "", decimals: decimalsForStep(step) };
  }
  const u = units.toLowerCase();
  if (u === "%" || u.startsWith("% ")) {
    return { factor: 1, suffix: "%", decimals: decimalsForStep(step) };
  }
  if (u.includes("cad per usd")) {
    // FX ticks need at least 2 decimals to show meaningful movement
    return { factor: 1, suffix: "", decimals: Math.max(2, decimalsForStep(step)) };
  }
  if (u.includes("cad millions")) {
    const maxAbs = Math.max(Math.abs(yMin), Math.abs(yMax));
    if (maxAbs >= 1000) {
      return { factor: 1 / 1000, suffix: "B", decimals: decimalsForStep(step / 1000) };
    }
    return { factor: 1, suffix: "M", decimals: 0 };
  }
  if (u.includes("cad billions")) {
    return { factor: 1, suffix: "B", decimals: decimalsForStep(step) };
  }
  return { factor: 1, suffix: "", decimals: decimalsForStep(step) };
}

function fmtTickAt(v: number, scale: AxisScale, isTop: boolean): string {
  const body = (v * scale.factor).toFixed(scale.decimals);
  return isTop && scale.suffix ? `${body}${scale.suffix}` : body;
}

// Nice-tick algorithm: pick a step rounded to (1 | 2 | 2.5 | 5) x power-of-10
// so ticks land on round numbers ("2.0%", "0", "5,000") rather than
// data-derived fractions ("2.34%", "-1248"). Targets ~3 ticks; allows 2-4
// depending on what the data fits.
function niceStep(range: number, targetTicks: number): number {
  if (range <= 0) return 1;
  const rough = range / Math.max(1, targetTicks - 1);
  const magnitude = Math.pow(10, Math.floor(Math.log10(Math.abs(rough))));
  const normalized = rough / magnitude;
  let mult;
  if (normalized < 1.5) mult = 1;
  else if (normalized < 3) mult = 2;
  else if (normalized < 4) mult = 2.5;
  else if (normalized < 7) mult = 5;
  else mult = 10;
  return mult * magnitude;
}

function niceTicks(dataMin: number, dataMax: number, targetTicks: number = 3): { values: number[]; step: number } {
  if (!isFinite(dataMin) || !isFinite(dataMax) || dataMin === dataMax) {
    // Flat data: one tick at the value, plus a small range above + below
    const v = dataMin;
    const eps = Math.abs(v) > 0 ? Math.abs(v) * 0.5 : 1;
    return { values: [v - eps, v, v + eps], step: eps };
  }
  const step = niceStep(dataMax - dataMin, targetTicks);
  const niceMin = Math.floor(dataMin / step) * step;
  const niceMax = Math.ceil(dataMax / step) * step;
  const values: number[] = [];
  // Cap at 6 ticks to avoid clutter at the tile scale.
  for (let i = 0; i < 12; i++) {
    const v = niceMin + i * step;
    if (v > niceMax + step * 1e-6) break;
    // Round to step boundary to absorb floating-point drift.
    values.push(Math.round(v / step) * step);
    if (values.length >= 6) break;
  }
  return { values, step };
}

// Chart geometry — 16:9 viewBox to match canon Tier-3 chartbook charts.
// Per the "all non-sparkline charts have identical dimensions" rule,
// homepage tile charts share the 720:405 aspect with section-page panel
// charts; here scaled to a smaller numeric range that keeps text sizing
// readable at tile width.
const W = 320;
const H = 180;
const PAD_L = 30;
const PAD_R = 8;
const PAD_T = 16;
const PAD_B = 22;

const plotW = W - PAD_L - PAD_R;
const plotH = H - PAD_T - PAD_B;

// Chart math only runs when we actually have a series. When `spark` is null
// the markup renders a dashed-border placeholder instead.
const hasSeries = Array.isArray(loadBearing.spark) && loadBearing.spark.length >= 2;
const series: number[] = hasSeries ? (loadBearing.spark as number[]) : [];

const minV = hasSeries ? Math.min(...series) : 0;
const maxV = hasSeries ? Math.max(...series) : 1;
// Nice-tick axis: pick a step that rounds to (1/2/2.5/5) x power-of-10 so
// every tick lands on a clean number. The first + last tick set yMin/yMax,
// so the data line always fits inside the tick range (no clipping).
const niceAxis = niceTicks(minV, maxV, 3);
const niceTickValues = niceAxis.values;
const niceTickStep = niceAxis.step;
const yMin = niceTickValues[0] as number;
const yMax = niceTickValues[niceTickValues.length - 1] as number;
const yRange = yMax - yMin || 1;

function xOf(i: number): number {
  return PAD_L + (i / (series.length - 1)) * plotW;
}
function yOf(v: number): number {
  return PAD_T + (1 - (v - yMin) / yRange) * plotH;
}

const pts = hasSeries
  ? series.map((v, i) => `${xOf(i).toFixed(2)},${yOf(v).toFixed(2)}`)
  : [];
const linePath = hasSeries ? "M " + pts.join(" L ") : "";

const axisScale = hasSeries
  ? computeAxisScale(yMin, yMax, niceTickStep, section.units)
  : { factor: 1, suffix: "", decimals: 2 };
const ticks = hasSeries
  ? niceTickValues.map((v, i, arr) => ({
      v,
      y: yOf(v),
      label: fmtTickAt(v, axisScale, i === arr.length - 1),
    }))
  : [];

const lastX = hasSeries ? xOf(series.length - 1) : 0;
const lastY = hasSeries ? yOf(series[series.length - 1] as number) : 0;

const zeroInRange = hasSeries && yMin < 0 && yMax > 0;
const zeroY = zeroInRange ? yOf(0) : null;

function dirGlyph(d: "pos" | "neg" | "neutral" | null): string {
  if (d === "pos") return "▲"; // black up-pointing triangle
  if (d === "neg") return "▼"; // black down-pointing triangle
  if (d === "neutral") return "—"; // em dash
  return PLACEHOLDER.directionNone; // placeholder when not wired
}

const allPrints = section.prints;

// asOf display (for SVG aria + caption). If the section has no real data we
// still need a string to substitute into the aria-label and the right-edge
// caption, but it must read clearly as a placeholder.
const asOfDisplay = loadBearing.asOf ?? PLACEHOLDER.notWired;
const valueDisplay = loadBearing.value ?? PLACEHOLDER.value;
const deltaDisplay = loadBearing.delta ?? PLACEHOLDER.value;

// Earliest-date stamp (left x-axis) — derived from the window the spark
// covers. Falls back to "—" when we don't have an ISO date to anchor off.
const earliestISO = computeEarliestISO(loadBearing.asOfISO, series.length, section.frequency);
const earliestDisplay = earliestISO
  ? fmtDateLabel(earliestISO, section.frequency === "daily")
  : "";

// Topmost y-tick gets the unit (canon Section 5.3); other ticks render bare.
// Axis scale + decimals are decided ONCE from the y-extent (see
// computeAxisScale) so every tick on the axis renders in the same magnitude.

// Delta-period stamp ("m/m" / "d/d" / "q/q") so the reader knows what window
// the delta compares.
const periodStamp = periodStampFor(section.frequency);
---
<article
  class="vig-panel"
  id={`panel-${section.slug}`}
  aria-labelledby={`panel-${section.slug}-h`}
  data-real={section.hasRealData ? "true" : "false"}
>
  <header class="vig-panel__head">
    <div class="vig-panel__head-left">
      <p class="vig-panel__eyebrow">
        <span class="vig-panel__fig">Figure</span>
        <span class="vig-panel__fig-n">{figureNum}.</span>
      </p>
      <h2 id={`panel-${section.slug}-h`} class="vig-panel__h">
        <a class="vig-panel__h-link" href={`/${section.slug}/`}>{section.label}</a>
      </h2>
    </div>
  </header>

  <p class="vig-panel__question">{section.headlineQuestion}</p>

  <div class="vig-panel__body">
    <figure class="vig-panel__fig-wrap">
      {hasSeries ? (
        <svg
          class="vig-panel__svg"
          viewBox={`0 0 ${W} ${H}`}
          role="img"
          aria-label={`${loadBearing.indicator}. Latest: ${valueDisplay} (${asOfDisplay}). Change: ${deltaDisplay}.`}
        >
          <rect
            x={PAD_L}
            y={PAD_T}
            width={plotW}
            height={plotH}
            fill="#FFFFFF"
            stroke="#000000"
            stroke-width="1"
          />
          {ticks.map((t, i) => (
            <text
              x={PAD_L - 5}
              y={t.y}
              text-anchor="end"
              dominant-baseline="middle"
              font-family="IBM Plex Mono, ui-monospace, monospace"
              font-size="8"
              fill="#000000"
            >
              {t.label}
            </text>
          ))}
          {zeroY !== null && (
            <line
              x1={PAD_L}
              x2={PAD_L + plotW}
              y1={zeroY}
              y2={zeroY}
              stroke="#000000"
              stroke-width="0.5"
              stroke-dasharray="2 2"
            />
          )}
          <path
            d={linePath}
            fill="none"
            stroke="#000000"
            stroke-width="1.5"
            stroke-linejoin="round"
            stroke-linecap="round"
          />
          <circle cx={lastX} cy={lastY} r="3" fill="#E63946" stroke="#FFFFFF" stroke-width="1" />
          <text
            x={PAD_L}
            y={H - 4}
            text-anchor="start"
            font-family="Manrope, Helvetica, Arial, sans-serif"
            font-weight="600"
            font-size="8"
            letter-spacing="1.4"
            fill="#000000"
          >
            {earliestDisplay}
          </text>
          <text
            x={PAD_L + plotW}
            y={H - 4}
            text-anchor="end"
            font-family="Manrope, Helvetica, Arial, sans-serif"
            font-weight="600"
            font-size="8"
            letter-spacing="1.4"
            fill="#000000"
          >
            {asOfDisplay.toUpperCase()}
          </text>
        </svg>
      ) : (
        <div
          class="vig-panel__empty"
          role="img"
          aria-label={`${loadBearing.indicator} chart: data not yet wired.`}
        >
          <p class="vig-panel__empty-cap">{PLACEHOLDER.chartEmpty}</p>
          {section.pipelineError && (
            <p class="vig-panel__empty-sub">{section.pipelineError}</p>
          )}
        </div>
      )}
      <figcaption class="vig-panel__cap">
        <span class="vig-panel__cap-mark">Fig. {figureNum}.</span>
        {loadBearing.indicator}, recent history.
        {hasSeries ? " Last observation marked." : (
          <span class="vig-panel__cap-placeholder"> {PLACEHOLDER.notWired}</span>
        )}
      </figcaption>
    </figure>

    <aside class="vig-panel__readout" aria-label="Headline reading">
      <p class="vig-panel__readout-k">{loadBearing.indicator}</p>
      <p class="vig-panel__readout-v">
        {loadBearing.value !== null ? (
          <span class="vig-panel__readout-num">{loadBearing.value}</span>
        ) : (
          <span class="vig-panel__readout-num vig-panel__placeholder vig-panel__placeholder--mono">
            {PLACEHOLDER.value}
          </span>
        )}
      </p>
      <p class="vig-panel__readout-meta">
        <span
          class="vig-panel__delta"
          aria-label={
            loadBearing.delta
              ? `Change ${loadBearing.delta} ${periodStamp}, direction ${loadBearing.deltaDir ?? "unknown"}`
              : "Change not yet wired"
          }
        >
          <span
            class:list={[
              "vig-panel__delta-glyph",
              loadBearing.deltaDir ? `vig-panel__delta-glyph--${loadBearing.deltaDir}` : null,
            ]}
            aria-hidden="true"
          >{dirGlyph(loadBearing.deltaDir)}</span>
          {loadBearing.delta !== null ? (
            <span class="vig-panel__delta-val">{loadBearing.delta}</span>
          ) : (
            <span class="vig-panel__delta-val vig-panel__placeholder vig-panel__placeholder--mono">
              {PLACEHOLDER.value}
            </span>
          )}
        </span>
        {loadBearing.asOf !== null ? (
          <span class="vig-panel__readout-asof">{loadBearing.asOf}</span>
        ) : (
          <span class="vig-panel__readout-asof vig-panel__placeholder vig-panel__placeholder--micro">
            {PLACEHOLDER.notWired}
          </span>
        )}
      </p>
      <p class="vig-panel__note vig-panel__placeholder">
        {PLACEHOLDER.loremShort}
      </p>
    </aside>
  </div>

  <table class="vig-panel__table" aria-label={`${section.label} indicators table`}>
    <thead>
      <tr>
        <th scope="col" class="vig-panel__th vig-panel__th--ind">Indicator</th>
        <th scope="col" class="vig-panel__th vig-panel__th--val">Value</th>
        <th scope="col" class="vig-panel__th vig-panel__th--delta">Change</th>
        <th scope="col" class="vig-panel__th vig-panel__th--asof">As of</th>
      </tr>
    </thead>
    <tbody>
      {allPrints.map((p) => (
        <tr class={p === loadBearing ? "vig-panel__tr vig-panel__tr--primary" : "vig-panel__tr"}>
          <td class="vig-panel__td vig-panel__td--ind">{p.indicator}</td>
          <td class={`vig-panel__td vig-panel__td--val${p.value === null ? " vig-panel__placeholder vig-panel__placeholder--mono" : ""}`}>
            {p.value ?? PLACEHOLDER.value}
          </td>
          <td class="vig-panel__td vig-panel__td--delta">
            <span
              class:list={[
                "vig-panel__td-glyph",
                p.deltaDir ? `vig-panel__td-glyph--${p.deltaDir}` : null,
              ]}
              aria-hidden="true"
            >{dirGlyph(p.deltaDir)}</span>
            {p.delta !== null ? (
              <span class="vig-panel__td-delta-val">{p.delta}</span>
            ) : (
              <span class="vig-panel__td-delta-val vig-panel__placeholder vig-panel__placeholder--mono">
                {PLACEHOLDER.value}
              </span>
            )}
          </td>
          <td class={`vig-panel__td vig-panel__td--asof${p.asOf === null ? " vig-panel__placeholder vig-panel__placeholder--micro" : ""}`}>
            {p.asOf ?? PLACEHOLDER.notWired}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</article>

<style>
  .vig-panel {
    background: var(--paper);
    padding: 18px 20px 16px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-height: 100%;
  }

  .vig-panel__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 10px;
  }
  .vig-panel__head-left { min-width: 0; }
  .vig-panel__eyebrow {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 10px;
    line-height: 1;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink);
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
  }
  .vig-panel__fig {
    color: var(--ink);
  }
  .vig-panel__fig-n {
    color: var(--accent);
    font-weight: 800;
    letter-spacing: 0.1em;
  }
  .vig-panel__h {
    margin: 6px 0 0;
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 22px;
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .vig-panel__h-link {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 80ms linear;
  }
  .vig-panel__h-link:hover {
    border-bottom-color: var(--ink);
  }
  .vig-panel__h-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .vig-panel__question {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 200;
    font-size: 14px;
    line-height: 1.45;
    color: var(--ink);
    max-width: 56ch;
  }

  .vig-panel__body {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
  }
  @media (min-width: 600px) {
    .vig-panel__body {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: 18px;
      align-items: start;
    }
  }

  .vig-panel__fig-wrap {
    margin: 0;
    min-width: 0;
  }
  .vig-panel__svg {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Dashed-border placeholder chart slot.
   * - Aspect ratio chosen to match the real SVG (320 x 110) so layout
   *   does not shift when the same section flips to real data.
   * - Dashed-border + light gray ink so it is OBVIOUSLY a stub at any
   *   size. The "DATA NOT YET WIRED" caption is the load-bearing tell. */
  .vig-panel__empty {
    width: 100%;
    aspect-ratio: 320 / 110;
    border: 1.5px dashed #9A9A9A;
    background:
      repeating-linear-gradient(
        135deg,
        transparent 0,
        transparent 8px,
        rgba(0, 0, 0, 0.025) 8px,
        rgba(0, 0, 0, 0.025) 9px
      );
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 8px;
    box-sizing: border-box;
  }
  .vig-panel__empty-cap {
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 11px;
    line-height: 1;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #6B6B6B;
    text-align: center;
  }
  .vig-panel__empty-sub {
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 9px;
    line-height: 1.3;
    color: #9A9A9A;
    text-align: center;
    max-width: 32ch;
  }

  .vig-panel__cap {
    margin: 6px 0 0;
    font-family: var(--font-sans);
    font-weight: 200;
    font-size: 11px;
    line-height: 1.4;
    color: var(--ink);
  }
  .vig-panel__cap-mark {
    font-weight: 600;
    color: var(--ink);
    margin-right: 4px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 10px;
  }
  .vig-panel__cap-placeholder {
    font-family: var(--font-mono);
    color: #6B6B6B;
    letter-spacing: 0.14em;
    font-size: 9.5px;
    text-transform: uppercase;
  }

  .vig-panel__readout {
    min-width: 0;
    padding-left: 0;
  }
  @media (min-width: 600px) {
    .vig-panel__readout {
