---
/*
 * TitleStatement - homepage academic title block (production).
 *
 * 3-cell summary stamp now reads from src/data/site_data_loader.ts so the
 * primary headline numbers (CPI, BoC overnight rate, Unemployment
 * rate) flow from the pipeline payload. If any of the three is not yet
 * wired, that cell renders an explicit em-dash + "[ NOT WIRED ]" marker
 * instead of a fake number.
 *
 * Lede / abstract: visibly Latin lorem ipsum. The homepage abstract is
 * editorial copy not yet authored; rather than pretending with a paraphrase
 * we make the gap obvious so the next pass picks it up.
 */

import { enrichedBySlug, PLACEHOLDER } from "../../data/site_data_loader";
import { splashHero, site } from "../../data/sections";

interface Props {
  dateLine: string;
}

const { dateLine } = Astro.props;

type StampCellSource = {
  /** Cell label rendered in micro-caps. Always real (canon). */
  label: string;
  /** Section slug to look up in the enriched payload. */
  section: "inflation" | "policy" | "labour";
  /** Optional indicator filter (when a section may carry multiple prints). */
  indicator?: string;
};

const stampSources: StampCellSource[] = [
  { label: "Headline inflation", section: "inflation", indicator: "Headline CPI, y/y" },
  { label: "BoC overnight rate", section: "policy", indicator: "BoC overnight rate" },
  { label: "Unemployment rate", section: "labour", indicator: "Unemployment rate" },
];

interface StampCell {
  label: string;
  value: string | null;
  asOf: string | null;
}

const stamp: StampCell[] = stampSources.map((row) => {
  const s = enrichedBySlug[row.section];
  if (!s) return { label: row.label, value: null, asOf: null };
  const p =
    s.prints.find((x) => x.indicator === row.indicator) ?? s.loadBearing;
  return {
    label: row.label,
    value: p.value,
    asOf: p.asOf,
  };
});
---
<section class="vig-title" aria-labelledby="vig-title-h">
  <h1 id="vig-title-h" class="vig-title__h">Where is Canada's economy right now?</h1>
  <p class="vig-title__abs">
    {splashHero.abstract}
  </p>

  <dl class="vig-title__stamp" aria-label="Headline numbers at a glance">
    {stamp.map((row) => (
      <div class="vig-title__stamp-row">
        <dt class="vig-title__stamp-k">{row.label}</dt>
        <dd class="vig-title__stamp-v">
          {row.value !== null ? (
            <span class="vig-title__stamp-num">{row.value}</span>
          ) : (
            <span class="vig-title__stamp-num vig-title__placeholder vig-title__placeholder--mono">
              {PLACEHOLDER.value}
            </span>
          )}
          {row.asOf !== null ? (
            <span class="vig-title__stamp-asof">{row.asOf}</span>
          ) : (
            <span class="vig-title__stamp-asof vig-title__placeholder vig-title__placeholder--micro">
              {PLACEHOLDER.notWired}
            </span>
          )}
        </dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .vig-title {
    padding-block: 32px 28px;
    /* No bottom border — the panel grid 28px below opens with its own
     * top hairline, and a redundant rule here read as a doubled line.
     * 2026-05-23: cut as part of the horizontal-rule audit on /overview/. */
  }
  .vig-title__eyebrow {
    margin: 0 0 14px;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 10px;
    line-height: 1;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink);
    opacity: 0.7;
  }

  .vig-title__h {
    margin: 0;
    font-family: var(--font-sans);
    /* SemiBold (600) — aligned with the section-page H1 and the
     * boutique-register H1 so the typographic register holds across
     * all surfaces of the site. */
    font-weight: 600;
    font-size: clamp(28px, 4vw, 44px);
    line-height: 1.05;
    color: var(--ink);
    max-width: 22ch;
    text-transform: none;
  }
  /* Dateline below the H1 — magazine-style issue date. Small, restrained,
   * monospaced numerals so the date reads as data, not display. */
  .vig-title__dateline {
    margin: 10px 0 0;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 13px;
    letter-spacing: 0.04em;
    line-height: 1;
    color: var(--ink);
    opacity: 0.7;
  }
  .vig-title__abs {
    margin: 16px 0 0;
    font-family: var(--font-sans);
    font-weight: 200;
    font-size: 17px;
    line-height: 1.55;
    color: var(--ink);
    max-width: 64ch;
  }

  .vig-title__stamp {
    margin: 22px 0 0;
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }
  @media (min-width: 720px) {
    .vig-title__stamp {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .vig-title__stamp-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    padding: 12px 14px 12px 0;
    border-bottom: 1px solid var(--ink);
  }
  @media (min-width: 720px) {
    .vig-title__stamp-row {
      border-bottom: 0;
      border-right: 1px solid var(--ink);
      flex-direction: column;
      align-items: flex-start;
      padding: 14px 18px;
    }
    .vig-title__stamp-row:first-child {
      padding-left: 0;
    }
    .vig-title__stamp-row:last-child {
      border-right: 0;
    }
  }
  .vig-title__stamp-row:last-child {
    border-bottom: 0;
  }
  .vig-title__stamp-k {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 10px;
    line-height: 1;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .vig-title__stamp-v {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  @media (min-width: 720px) {
    .vig-title__stamp-v {
      margin-top: 8px;
    }
  }
  .vig-title__stamp-num {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 20px;
    line-height: 1;
    letter-spacing: 0;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .vig-title__stamp-asof {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 10px;
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
  }

  /* Placeholder ink. Tokens.css resolves --ink-faint to pure black under
   * the Vignelli canon, so this component hard-codes a mid-gray so the
   * lorem ipsum / em-dash markers visibly read as placeholders. */
  .vig-title__placeholder {
    color: #8A8A8A;
  }
  .vig-title__placeholder--mono {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }
  .vig-title__placeholder--micro {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
</style>
