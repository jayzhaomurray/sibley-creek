---
import SectionLayout from "../layouts/SectionLayout.astro";
import type { Plate } from "../layouts/SectionLayout.astro";
import { sections } from "../data/sections";
import panelDataFile from "../../data/site/panel_data/fiscal.json";
import sectionsJson from "../../data/site/sections.json";
import { pickPanel } from "../components/charts/_shared/panelData";
import { deriveLatestReleaseLabel } from "../components/section/_shared/derivedLabels";

const section = sections.find((s) => s.slug === "fiscal");
if (!section) {
  throw new Error("Fiscal section not found in src/data/sections.ts");
}

const latestReleaseLabel = deriveLatestReleaseLabel(
  section.latestReleasePrefix ?? "",
  sectionsJson,
  "fiscal",
);

type RawPanels = { panels?: Record<string, { metadata?: any }> };
const panels = (panelDataFile as unknown as RawPanels).panels ?? {};

const panel1Data = pickPanel(panelDataFile, 1);
const panel2Data = pickPanel(panelDataFile, 2);

const fyToDate = (fy: string) => `${fy.split("-")[0]}-04-01`;
const toDeficitPositive = (d: any) => ({
  date: fyToDate(d.fy),
  value: -d.balance_cad_bn,
});
const toBalance = (d: any) => ({
  date: fyToDate(d.fy),
  value: d.balance_cad_bn,
});

const meta3 = panels["panel-3"]?.metadata;
const panel3Data = meta3 ? {
  panelNum: 3,
  primary: {
    key: "dof_seu_deficit_projection",
    label: "DoF SEU Apr 2026",
    unit: "CAD billions",
    asOfISO: "2026-04-28",
    data: (meta3.series?.dof_seu_2026?.data ?? [])
      .filter((d: any) => typeof d.balance_cad_bn === "number")
      .map(toDeficitPositive),
  },
  secondary: {
    key: "pbo_efo_deficit_projection",
    label: "PBO EFO Sept 2025",
    unit: "CAD billions",
    asOfISO: "2025-09-25",
    data: (meta3.series?.pbo_efo_sept_2025?.data ?? [])
      .filter((d: any) => typeof d.balance_cad_bn === "number")
      .map(toDeficitPositive),
  },
} : null;

const meta4 = panels["panel-4"]?.metadata;
const provinceOrder = ["QC", "ON", "BC", "AB"];
const provinces = Array.isArray(meta4?.provinces) ? meta4.provinces : [];
const orderedProvinces = provinceOrder
  .map((iso) => provinces.find((p: any) => p.iso === iso))
  .filter(Boolean);
const panel4Data = orderedProvinces.length === 4 ? {
  panelNum: 4,
  primary: {
    key: "provincial_debt_to_gdp",
    label: "Provincial debt-to-GDP",
    unit: "%",
    asOfISO: "2026-03-18",
    data: orderedProvinces.map((p: any) => ({
      date: `2026-01-01`,
      value: p.value_pct,
    })),
  },
  secondary: null,
} : null;

const meta5 = panels["panel-5"]?.metadata;
const panel5Data = meta5 ? {
  panelNum: 5,
  primary: {
    key: "budget_2025_total_deficit",
    label: "Budget 2025 total deficit",
    unit: "CAD billions",
    asOfISO: "2025-11-04",
    data: (meta5.series?.budget_2025_total_deficit?.data ?? [])
      .filter((d: any) => typeof d.balance_cad_bn === "number")
      .map(toBalance),
  },
  secondary: {
    key: "pbo_reclassified_operating_deficit",
    label: "PBO reclassified operating deficit",
    unit: "CAD billions",
    asOfISO: "2025-11-14",
    data: (meta5.series?.pbo_reclassified_operating_deficit?.data ?? [])
      .filter((d: any) => typeof d.balance_cad_bn === "number" && d.fy !== "2024-25")
      .map(toBalance),
  },
} : null;

const lede =
  "Federal fiscal policy is not in crisis, but the easy story is wrong. The deficit still sits near 2% of GDP, debt service is taking a larger share of revenue, and the real credibility test is whether Ottawa's operating/capital split survives outside scrutiny. The provinces make the stance uneven: Quebec and Ontario carry the balance-sheet weight, British Columbia has a basis problem, and Alberta remains the outlier at the low end.";

const plates: Plate[] = [
  {
    id: "plate-1",
    number: "01",
    indicator: "Federal monthly and fiscal-year-to-date balance",
    plateIndexLabel: "Federal trajectory",
    asOf: "February 28, 2026 (Fiscal Monitor)",
    title: "The federal track is ordinary, not counter-cyclical.",
    interpretationHtml:
      "Ottawa is not running an emergency stance, but it is also not tightening into the cycle. The Spring Economic Update puts the deficit at 2.1% of GDP in FY2025-26, while the Fiscal Monitor shows a $25.5 billion deficit after eleven months. The February surplus helped, but it does not change the fiscal-year shape: this is a familiar deficit cadence, not a deliberate macro offset.",
    callout: {
      value: "-$25.5 bn",
      unit: "Federal balance, fiscal YTD",
      delta: "11 months into FY2025-26",
      direction: "neg",
    },
    source: "Department of Finance Fiscal Monitor; Department of Finance Spring Economic Update.",
    chartKey: "fiscal-panel-1",
    data: panel1Data,
    citations: [
      { phrase: "2.1% of GDP", source: "card:dof_seu_2026_deficit_gdp_share", note: "DoF Spring Economic Update April 2026 projects the federal deficit at 2.1% of GDP for FY2025-26." },
      { phrase: "$25.5 billion deficit", source: "pipeline:dof:dof_fiscal_ytd_balance", note: "Federal fiscal YTD balance through February 2026, -$25.5bn per Fiscal Monitor." },
      { phrase: "February surplus", source: "pipeline:dof:dof_fiscal_monthly_balance", note: "February 2026 monthly federal balance was +$5.7bn per Fiscal Monitor." },
    ],
  },
  {
    id: "plate-2",
    number: "02",
    indicator: "Federal public debt charges as a share of revenues",
    plateIndexLabel: "Debt service",
    title: "Debt service is the binding line in the fiscal room.",
    interpretationHtml:
      "The deficit ratio is the headline, but the debt-service share is the constraint clients should watch. Public debt charges reached $49.3 billion fiscal-year-to-date through February 2026, and the derived debt-service-to-revenue ratio is 10.9%. The PBO's Main Estimates work puts the same burden on a path toward 13.2% of revenues by 2030-31, which is where fiscal space starts getting visibly rationed.",
    callout: {
      value: "10.9%",
      unit: "Debt service / revenues, FYTD",
      delta: "PBO anchor: 13.2% by 2030-31",
      direction: "neg",
    },
    source: "Department of Finance Fiscal Monitor; Parliamentary Budget Officer Main Estimates analysis.",
    chartKey: "fiscal-panel-debt-service",
    data: panel2Data,
    citations: [
      { phrase: "$49.3 billion", source: "card:dof_fiscal_monitor_debt_service_share", note: "Fiscal Monitor Feb 2026: public debt charges $49.3bn fiscal-year-to-date." },
      { phrase: "10.9%", source: "pipeline:dof:debt_service_ratio", note: "Derived from public debt charges divided by revenues through February 2026." },
      { phrase: "13.2% of revenues by 2030-31", source: "card:pbo_interest_burden_forecast_2030", note: "PBO Main Estimates 2026-27 analysis projects the federal interest burden rising to 13.2% of revenues by 2030-31." },
    ],
  },
  {
    id: "plate-3",
    number: "03",
    indicator: "PBO EFO Sept 2025 vs DoF SEU April 2026 deficit projection tracks",
    plateIndexLabel: "PBO vs DoF",
    title: "Finance and the PBO mostly agree on the headline deficit.",
    interpretationHtml:
      "The standard outsider take that Ottawa and the watchdog are miles apart is overstated on the headline deficit. Finance has FY2025-26 at $66.9 billion and FY2030-31 at $53.2 billion; the PBO's September outlook had the same starting year at $68.5 billion and the middle years close to $60 billion. The argument is not the line itself, but the assumptions and classifications underneath it.",
    source: "Department of Finance Spring Economic Update; Parliamentary Budget Officer Economic and Fiscal Outlook.",
    chartKey: "fiscal-panel-3",
    data: panel3Data,
    citations: [
      { phrase: "$66.9 billion", source: "card:dof_seu_2026_deficit_track", note: "DoF SEU April 2026 FY2025-26 deficit projection." },
      { phrase: "$53.2 billion", source: "card:dof_seu_2026_deficit_track", note: "DoF SEU April 2026 FY2030-31 deficit projection." },
      { phrase: "$68.5 billion", source: "card:pbo_efo_sept_2025_deficit_track", note: "PBO EFO Sept 2025 FY2025-26 deficit projection." },
      { phrase: "close to $60 billion", source: "card:pbo_efo_sept_2025_deficit_track", note: "PBO EFO Sept 2025 medium-term framing for the deficit through 2029-30." },
    ],
  },
  {
    id: "plate-4",
    number: "04",
    indicator: "Provincial debt-to-GDP, publisher's-own basis",
    plateIndexLabel: "Provincial stance",
    asOf: "Mixed vintage: ON Nov 2025; QC Mar 2026; AB/BC Feb 2026",
    title: "Provincial fiscal stance does not generalize from Ottawa.",
    interpretationHtml:
      "The provincial balance sheet is not one Canadian story. Quebec sits at 38.8% of GDP and Ontario at 37.7%, while Alberta is at 10.5%. British Columbia's 30.6% print is on a taxpayer-supported basis, so it belongs on the same page but not in the same sentence without the caveat.",
    source: "Ontario, Quebec, Alberta, and British Columbia budget documents.",
    chartKey: "fiscal-panel-provincial-debt",
    data: panel4Data,
    citations: [
      { phrase: "38.8% of GDP", source: "card:provincial_debt_to_gdp_qc", note: "Quebec Budget 2026-2027 net debt-to-GDP." },
      { phrase: "37.7%", source: "card:provincial_debt_to_gdp_on", note: "Ontario Fall Economic Outlook and Fiscal Review 2025 net debt-to-GDP." },
      { phrase: "10.5%", source: "card:provincial_debt_to_gdp_ab", note: "Alberta Budget 2026 net debt-to-GDP." },
      { phrase: "30.6%", source: "card:provincial_debt_to_gdp_bc", note: "BC Budget 2026 taxpayer-supported debt-to-GDP." },
      { phrase: "taxpayer-supported basis", source: "card:provincial_debt_to_gdp_bc", note: "BC publishes taxpayer-supported debt-to-GDP, unlike the net-debt basis used for ON/QC/AB in this plate." },
    ],
  },
  {
    id: "plate-5",
    number: "05",
    indicator: "Operating vs capital balance under the bifurcated budget framework",
    plateIndexLabel: "Operating/capital",
    asOf: "November 14, 2025 (PBO Budget 2025 review)",
    title: "The operating anchor depends on what counts as capital.",
    interpretationHtml:
      "The fiscal anchor lives or dies on classification. The PBO reclassifies $94 billion of spending that Budget 2025 treats as capital, equal to about 30% of Finance's claimed capital envelope. On that stricter basis, the operating balance is still in deficit by $18.1 billion in FY2028-29, the year Ottawa says the operating anchor is met.",
    callout: {
      value: "$94 bn",
      unit: "PBO reclassification gap",
      delta: "about 30% of DoF's claimed capital",
      direction: "neg",
    },
    source: "Parliamentary Budget Officer Budget 2025 review; Department of Finance Budget 2025.",
    chartKey: "fiscal-panel-5",
    data: panel5Data,
    citations: [
      { phrase: "$94 billion", source: "card:pbo_operating_capital_reclassification_nov_2025", note: "PBO Budget 2025 review: gap between DoF claimed capital and PBO reclassified capital." },
      { phrase: "30% of Finance's claimed capital envelope", source: "card:pbo_operating_capital_reclassification_nov_2025", note: "$94bn is about 30% of DoF's $311.5bn claimed capital envelope." },
      { phrase: "$18.1 billion", source: "card:pbo_operating_capital_reclassification_nov_2025", note: "PBO reclassified operating deficit in FY2028-29." },
      { phrase: "the year Ottawa says the operating anchor is met", source: "card:dof_operating_balance_projection", note: "DoF SEU/Budget operating-balance framing has the day-to-day operating balance moving into surplus in FY2028-29." },
    ],
  },
];

const pageDescription =
  "Internal draft of Sibley Creek's fiscal chartbook: federal trajectory, debt-service burden, PBO and Finance baselines, provincial debt dispersion, and operating/capital classification.";
---
<SectionLayout
  slug="fiscal"
  sectionIndex={5}
  sectionLabel="Fiscal (Codex draft)"
  headlineQuestion="What is Canada's fiscal stance, and is it consistent with the cycle?"
  lede={lede}
  latestReleaseLabel={latestReleaseLabel}
  plates={plates}
  title="Fiscal - Codex Draft (not public)"
  description={pageDescription}
  canonical="/fiscal-codex-draft/"
  noindex={true}
/>
