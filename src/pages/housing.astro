---
/*
 * Housing - Vignelli chartbook page.
 *
 * Seven plates per editorial canon section 4.4 (Wave 5 added Panel 7):
 *   01 Prices (MLS HPI national + six CMAs)
 *   02 Activity (starts, completions, permits)
 *   03 Inventory and absorption (sales-to-new-listings, months of inventory)
 *   04 Rent (CMHC RMS + CPI rent sub-series)
 *   05 Mortgage stack snapshot (BoC chartpack + OSFI + CMHC arrears)
 *   06 Population-to-housing-stock ratio (by CMA)
 *   07 Housing Affordability (Wave 5; BoC qualifying payment / income)
 *
 * Interpretation prose is placeholder, in publication voice; writer
 * refines.
 */

import SectionLayout from "../layouts/SectionLayout.astro";
import type { Plate } from "../layouts/SectionLayout.astro";
import { sections } from "../data/sections";
import panelDataFile from "../../data/site/panel_data/housing.json";
import { pickPanel } from "../components/charts/_shared/panelData";

const section = sections.find((s) => s.slug === "housing");
if (!section) {
  throw new Error("Housing section not found in src/data/sections.ts");
}

const panel1Data = pickPanel(panelDataFile, 1);
const panel2Data = pickPanel(panelDataFile, 2);
const panel3Data = pickPanel(panelDataFile, 3);
const panel4Data = pickPanel(panelDataFile, 4);
const panel5Data = pickPanel(panelDataFile, 5);
const panel6Data = pickPanel(panelDataFile, 6);
const panel7Data = pickPanel(panelDataFile, 7);

const plates: Plate[] = [
  {
    id: "plate-1",
    number: "01",
    indicator: "MLS HPI benchmark, national + six CMAs",
    plateIndexLabel: "Prices",
    asOf: "TK",
    title: "Composite HPI slipped further into negative territory; Toronto and Vancouver lead the drift.",
    interpretationHtml:
      "The national MLS HPI is at <strong>TK y/y</strong>, and the 6-month annualized print is softer still. " +
      "Toronto and Vancouver are doing most of the drift; Calgary remains firm and Montreal is roughly flat. " +
      "No national-average headline number is rendered - the CMA cuts tell the story.",
    callout: {
      value: "TK",
      unit: "MLS HPI composite, y/y, TK",
      delta: "TK vs prior",
      direction: "neutral",
    },
    source: "CREA MLS HPI national + six-CMA bulk file, latest vintage.",
    chartKey: "housing-panel-1",
    data: panel1Data,
  },
  {
    id: "plate-2",
    number: "02",
    indicator: "Activity: starts, completions, permits",
    plateIndexLabel: "Activity",
    asOf: "TK (starts) / TK (permits)",
    title: "Starts (3-month MA) below trend; permits drifting lower as the leading indicator.",
    interpretation:
      "Starts on the 3-month moving average sit roughly TK below the post-2020 average; the permits series, which leads starts " +
      "by a few months, has rolled over modestly. Completions are catching up to the surge in starts from two years ago, " +
      "with the rental-vs-ownership split skewed to rental on the most recent vintage.",
    source:
      "CMHC starts and completions (Table 34-10-0135); Statistics Canada Table 34-10-0066-01 (building permits).",
    chartKey: "housing-panel-2",
    data: panel2Data,
  },
  {
    id: "plate-3",
    number: "03",
    indicator: "Inventory and absorption",
    plateIndexLabel: "Inventory",
    asOf: "TK",
    title: "Sales-to-new-listings near TK; balanced-market floor in view.",
    interpretationHtml:
      "The national sales-to-new-listings ratio sits at <strong>TK</strong>, below the post-2010 average and at the lower end of the band CREA calls balanced. " +
      "Months of inventory by CMA cluster in a range of TK in Toronto and Vancouver and TK in Calgary. " +
      "A constructed measure - methodology one click away.",
    source:
      "BoC FVI national sales-to-new-listings; CREA XLSX bulk for CMA-level; months-of-inventory constructed.",
    chartKey: "housing-panel-3",
    data: panel3Data,
  },
  {
    id: "plate-4",
    number: "04",
    indicator: "Rent: CMHC RMS + CPI rent sub-series",
    plateIndexLabel: "Rent",
    asOf: "TK (RMS) / TK (CPI)",
    title: "Toronto and Vancouver rents loosened on the most recent monthly read.",
    interpretation:
      "The CMHC Rental Market Survey carries the levels and the vacancy direction; the StatCan CPI rented-accommodation sub-series carries the monthly velocity. " +
      "Toronto and Vancouver are loosening; Calgary and Edmonton are still firmer. The annual RMS print remains the citable source on the level.",
    source:
      "CMHC Rental Market Survey, latest annual vintage; Statistics Canada Table 18-10-0004-01 (rent sub-series).",
    chartKey: "housing-panel-4",
    data: panel4Data,
  },
  {
    id: "plate-5",
    number: "05",
    indicator: "Mortgage stack snapshot",
    plateIndexLabel: "Mortgage stack",
    asOf: "TK (BoC chartpack)",
    title: "Renewal cohort over the summer is the load-bearing window.",
    interpretation:
      "The Bank's most recently published Residential Mortgage Market chartpack remains the cite-grade source on vintage and term composition. " +
      "OSFI Bank Financial Data on residential exposures, plus CMHC RMIR and CBA chartered-bank arrears, complete the picture. " +
      "Our own full reconstruction by vintage and term is Pillar A deep-dive territory, not basics.",
    source:
      "BoC Residential Mortgage Market chartpack; OSFI Bank Financial Data; CMHC RMIR; CBA monthly arrears.",
    chartKey: "housing-panel-5",
    data: panel5Data,
  },
  {
    id: "plate-6",
    number: "06",
    indicator: "Population-to-housing-stock ratio, by CMA",
    plateIndexLabel: "Supply ratio",
    asOf: "TK (annual)",
    title: "Toronto and Vancouver still the tightest on the supply-response denominator.",
    interpretation:
      "Population per housing unit remains highest in Toronto and Vancouver, where the supply response has been slowest to arrive. " +
      "Calgary and Edmonton have absorbed faster population growth at flatter ratios. Annual frequency; v1 ships with the methodology note on " +
      "base year and intercensal interpolation.",
    source:
      "Statistics Canada Tables 17-10-0135 (CMA population) and 36-10-0688 (housing stock).",
    chartKey: "housing-panel-6",
    data: panel6Data,
  },
  {
    id: "plate-7",
    number: "07",
    indicator: "Housing affordability: BoC qualifying payment to income",
    plateIndexLabel: "Affordability",
    asOf: "TK (quarterly)",
    title: "Affordability index at TK; rate move TK doing the work on the most recent quarter.",
    interpretationHtml:
      "The BoC's qualifying-mortgage-payment-to-income index, the flow-side complement to the stock-side mortgage snapshot, sits at <strong>TK</strong>. " +
      "Direction is TK over the latest quarter; the dominant driver is TK (rate move / price move / income move). " +
      "The 1989-1991, 2007-2008, and 2022-2024 episodes mark the historical anchors against which the current level reads.",
    callout: {
      value: "TK",
      unit: "affordability index, TK",
      delta: "TK vs prior quarter",
      direction: "neutral",
    },
    source: "Bank of Canada Indicators of Capacity and Inflation Pressures (housing affordability index, qualifying payment / income).",
    chartKey: "housing-panel-7",
    data: panel7Data,
  },
];

const pageTitle = "Housing";
const pageDescription =
  "Housing chartbook: prices (MLS HPI), starts and permits, sales and inventory, rents, the mortgage stack, " +
  "the population-to-housing-stock ratio, and the BoC affordability index. Seven plates of chart-with-interpretation.";

const lede =
  "Seven plates trace the rate-sensitive sector: prices and activity, inventory and rents, the mortgage stack that carries " +
  "the household balance sheet, the supply ratio against the population it has to absorb, and the affordability index " +
  "that names what a new borrower would pay against current income.";
---
<SectionLayout
  slug="housing"
  sectionIndex={7}
  sectionLabel="Housing"
  headlineQuestion={section.headlineQuestion}
  lede={lede}
  latestReleaseLabel="MLS HPI, Mar 2026"
  plates={plates}
  title={pageTitle}
  description={pageDescription}
/>
