---
/*
 * Housing - basics-layer section page (placeholder).
 *
 * Six panels per editorial canon section 4.4:
 *   1. Prices
 *   2. Activity
 *   3. Inventory and absorption
 *   4. Rent
 *   5. Mortgage stack snapshot
 *   6. Population-to-housing-stock ratio
 *
 * Why this file is sparse:
 *   Navigation-skeleton placeholder. Writer + style-editor own panel
 *   titles, decks, callouts, and source citations. Backend pipeline owns
 *   vintage stamps and numeric values. Chart-builder hydrates chart slots.
 *   Frontend reserves panel order, eyebrows, anchors, and the page shell.
 *
 * Mirrors src/pages/gdp.astro structure; see that file for the worked
 * example with finished placeholder copy.
 */

import SectionLayout from "../layouts/SectionLayout.astro";
import type { Panel } from "../layouts/SectionLayout.astro";
import { sections } from "../data/sections";

const section = sections.find((s) => s.slug === "housing");
if (!section) {
  throw new Error("Housing section not found in src/data/sections.ts");
}

const pageAsOf = {
  label: "Placeholder release",
  releaseDate: "TBD",
};

const placeholderText = "Placeholder. Writer to populate.";
const placeholderMethodology = "Placeholder. Methodology to be documented by editorial.";
const placeholderSource = "Source citation TBD.";
const placeholderVintage = { releaseDate: "TBD" };

const panels: Panel[] = [
  {
    id: "panel-1",
    eyebrow: "Prices",
    title: placeholderText,
    deck: placeholderText,
    vintage: placeholderVintage,
    editorialStatus: placeholderText,
    source: placeholderSource,
    methodology: { body: placeholderMethodology },
  },
  {
    id: "panel-2",
    eyebrow: "Activity",
    title: placeholderText,
    deck: placeholderText,
    vintage: placeholderVintage,
    editorialStatus: placeholderText,
    source: placeholderSource,
    methodology: { body: placeholderMethodology },
  },
  {
    id: "panel-3",
    eyebrow: "Inventory and absorption",
    title: placeholderText,
    deck: placeholderText,
    vintage: placeholderVintage,
    editorialStatus: placeholderText,
    source: placeholderSource,
    methodology: { body: placeholderMethodology },
  },
  {
    id: "panel-4",
    eyebrow: "Rent",
    title: placeholderText,
    deck: placeholderText,
    vintage: placeholderVintage,
    editorialStatus: placeholderText,
    source: placeholderSource,
    methodology: { body: placeholderMethodology },
  },
  {
    id: "panel-5",
    eyebrow: "Mortgage stack snapshot",
    title: placeholderText,
    deck: placeholderText,
    vintage: placeholderVintage,
    editorialStatus: placeholderText,
    source: placeholderSource,
    methodology: { body: placeholderMethodology },
  },
  {
    id: "panel-6",
    eyebrow: "Population-to-housing-stock ratio",
    title: placeholderText,
    deck: placeholderText,
    vintage: placeholderVintage,
    editorialStatus: placeholderText,
    source: placeholderSource,
    methodology: { body: placeholderMethodology },
  },
];

const pageTitle = "Housing";
const pageDescription = `${section.headlineQuestion} The macro-research-department Housing section: prices, activity, inventory, rent, mortgage stack, and supply-vs-population ratios.`;
---
<SectionLayout
  slug="housing"
  sectionIndex={4}
  sectionName="Housing"
  sectionLabel={section.label}
  accentVar={section.accentVar}
  headlineQuestion={section.headlineQuestion}
  pageAsOf={pageAsOf}
  panels={panels}
  title={pageTitle}
  description={pageDescription}
/>
