---
/*
 * Housing - Vignelli chartbook page.
 *
 * Seven plates per editorial canon section 4.4 (Wave 5 added Panel 7):
 *   01 Prices (MLS HPI national + six CMAs)
 *   02 Activity (starts, completions, permits)
 *   03 Inventory and absorption (sales-to-new-listings, months of inventory)
 *   04 Rent (CMHC RMS + CPI rent sub-series)
 *   05 Mortgage stack snapshot (BoC chartpack + OSFI + CMHC arrears)
 *   06 Population-to-housing-stock ratio (by CMA)
 *   07 Housing Affordability (Wave 5; BoC qualifying payment / income)
 */

import SectionLayout from "../layouts/SectionLayout.astro";
import type { Plate } from "../layouts/SectionLayout.astro";
import { sections } from "../data/sections";
import panelDataFile from "../../data/site/panel_data/housing.json";
import sectionsJson from "../../data/site/sections.json";
import { pickPanel } from "../components/charts/_shared/panelData";
import { deriveLatestReleaseLabel } from "../components/section/_shared/derivedLabels";

const section = sections.find((s) => s.slug === "housing");
if (!section) {
  throw new Error("Housing section not found in src/data/sections.ts");
}

const latestReleaseLabel = deriveLatestReleaseLabel(
  section.latestReleasePrefix ?? "",
  sectionsJson,
  "housing",
);

const panel1Data = pickPanel(panelDataFile, 1);
const panel2Data = pickPanel(panelDataFile, 2);
const panel3Data = pickPanel(panelDataFile, 3);
const panel6Data = pickPanel(panelDataFile, 6);
const panel7Data = pickPanel(panelDataFile, 7);

const plates: Plate[] = [
  {
    id: "plate-1",
    number: "01",
    indicator: "MLS HPI, national + six CMAs, Y/Y",
    plateIndexLabel: "Prices",
    title: "The national price decline masks a widening split between Toronto-Vancouver and Montreal.",
    interpretationHtml:
      "The 4.0% national price drop conceals a sharper split: Toronto and Vancouver are leading the decline while Montreal is pulling the other way. " +
      "Toronto sits at -6.3% year-over-year and Vancouver at -6.8%, both deeper than the headline, while Montreal prints +3.7% — a ten-point gap between the weakest and strongest major market. " +
      "Calgary, Ottawa and Edmonton hover near flat. " +
      "A national index that has been negative for twenty-five straight months is, beneath the surface, two different housing cycles running at once.",
    callout: {
      value: "-4.0%",
      unitPrefix: "Composite home prices, Y/Y",
      delta: "+0.6pp vs Mar",
      direction: "neutral",
    },
    source: "CREA MLS HPI national + six-CMA bulk file (April 2026 release).",
    chartKey: "housing-panel-1",
    data: panel1Data,
    citations: [
      { phrase: "4.0% national price drop", source: "pipeline:crea:mls_hpi_national", note: "CREA MLS HPI Canada composite, Y/Y, April 2026 = -4.0% (slot crea_hpi_canada_yoy)." },
      { phrase: "Toronto sits at -6.3% year-over-year", source: "pipeline:crea:mls_hpi_toronto", note: "CREA MLS HPI Toronto CMA, Y/Y, April 2026." },
      { phrase: "Vancouver at -6.8%", source: "pipeline:crea:mls_hpi_vancouver", note: "CREA MLS HPI Vancouver CMA, Y/Y, April 2026." },
      { phrase: "Montreal prints +3.7%", source: "pipeline:crea:mls_hpi_montreal", note: "CREA MLS HPI Montreal CMA, Y/Y, April 2026." },
      { phrase: "ten-point gap between the weakest and strongest major market", source: "derived", note: "Montreal +3.7% minus Vancouver -6.8% = 10.5 pp spread across the six CMAs covered, April 2026." },
      { phrase: "Calgary, Ottawa and Edmonton hover near flat", source: "derived", note: "April 2026: Calgary -2.1%, Ottawa -0.7%, Edmonton -1.5% — all within ~2 pp of zero." },
      { phrase: "negative for twenty-five straight months", source: "pipeline:crea:mls_hpi_national", note: "Enumerated: CREA MLS HPI Canada Y/Y has printed negative every month from April 2024 through April 2026 inclusive (25 consecutive months)." },
    ],
  },
  {
    id: "plate-2",
    number: "02",
    indicator: "Housing starts, SAAR",
    plateIndexLabel: "Starts",
    asOfMode: "primary",
    title: "Starts have bounced back into their recent range, not rolled over.",
    interpretation:
      "Housing starts came in at 261.4K annualized in May 2026, down from 278.4K in April but still above the 2021-2023 average. " +
      "The 12-month average sits near 261.3K, essentially in line with that recent-cycle norm. " +
      "The starts tape is volatile month to month, but the smoother read is stabilization rather than a fresh rollover.",
    source:
      "Statistics Canada Table 34-10-0158-01 (housing starts, SAAR).",
    chartKey: "housing-panel-2",
    data: panel2Data,
    citations: [
      { phrase: "261.4K annualized in May 2026", source: "pipeline:statcan:34-10-0158-01", note: "Total housing starts, SAAR, all areas, May 2026." },
      { phrase: "278.4K in April", source: "pipeline:statcan:34-10-0158-01", note: "Total housing starts, SAAR, Apr 2026." },
      { phrase: "2021-2023 average", source: "derived", note: "Three-year mean of monthly SAAR starts, 2021-01 through 2023-12, StatCan 34-10-0158-01." },
      { phrase: "12-month average sits near 261.3K", source: "derived", note: "Trailing 12-month average of monthly housing starts, Jun 2025 through May 2026, StatCan 34-10-0158-01." },
    ],
  },
  {
    id: "plate-3",
    number: "03",
    indicator: "Sales-to-new-listings ratio, Canada",
    plateIndexLabel: "Inventory",
    title: "Absorption is soft but has not tipped into a buyers' market.",
    interpretationHtml:
      "The national sales-to-new-listings ratio sits at 49.2 in May 2026, up from 46.2 in April and inside the 45-to-65 band CREA describes as balanced. " +
      "The resale index has eased to 85.6, leaving Canada in a soft absorption regime rather than an outright buyers' market. " +
      "CMA-level 12-month resale counts to October 2025 point in the same direction: Toronto and Vancouver are absorbing the most volume relative to their listings overhang.",
    source:
      "Bank of Canada Valet (CREA sales-to-new-listings and resale index); CMA-level 12-month resale counts via BoC Valet.",
    chartKey: "housing-panel-3",
    data: panel3Data,
    citations: [
      { phrase: "49.2 in May 2026", source: "pipeline:boc:crea_snlr", note: "CREA sales-to-new-listings ratio, Canada, May 2026, via BoC Valet." },
      { phrase: "46.2 in April", source: "pipeline:boc:crea_snlr", note: "CREA sales-to-new-listings ratio, Canada, Apr 2026, via BoC Valet." },
      { phrase: "45-to-65 band CREA describes as balanced", source: "card:crea_snlr_balanced_band" },
      { phrase: "85.6", source: "pipeline:boc:crea_mls_hpi", note: "CREA MLS Home Price Index, Canada, Feb 2026, via BoC Valet FVI_CREA_MLS_HPI_CANADA." },
      { phrase: "12-month resale counts to October 2025", source: "derived", note: "Trailing-12-month CMA-level CREA resale counts; CMA-level data ships via CREA XLSX (pipeline.fetch.crea), not directly on BoC Valet." },
    ],
  },
  {
    id: "plate-4",
    number: "04",
    indicator: "BoC qualifying mortgage payment to income",
    plateIndexLabel: "Affordability",
    title: "Affordability is improving from peak but remains worse than prior stress episodes.",
    interpretationHtml:
      "The BoC's qualifying-mortgage-payment-to-income ratio sits at 42.3% in Q1 2026, down from 43.1% in Q4 2025 and 54.5% at the Q3 2023 peak. " +
      "The improvement traces to lower qualifying rates &mdash; the 5-year conventional has settled at 6.09% &mdash; partly offset by softer wage growth in the denominator. " +
      "The index remains well above the 1989-1991 and 2007-2008 stress episodes; the 2022-2024 tightening cycle is still the binding historical anchor.",
    callout: {
      value: "42.3%",
      unitPrefix: "qualifying payment / income",
      delta: "-0.8pp Q/Q",
      direction: "neg",
    },
    source: "Bank of Canada Valet (INDINF_AFFORD_Q, housing affordability index, qualifying payment / income).",
    chartKey: "housing-panel-7",
    data: panel7Data,
    citations: [
      { phrase: "42.3% in Q1 2026", source: "pipeline:boc:INDINF_AFFORD_Q", note: "BoC housing affordability index, qualifying payment / income, 2026Q1." },
      { phrase: "43.1% in Q4 2025", source: "pipeline:boc:INDINF_AFFORD_Q", note: "BoC housing affordability index, 2025Q4." },
      { phrase: "54.5% at the Q3 2023 peak", source: "pipeline:boc:INDINF_AFFORD_Q", note: "BoC qualifying-mortgage-payment-to-income ratio cycle peak; 54.5% in 2023Q3 per Valet INDINF_AFFORD_Q." },
      { phrase: "5-year conventional has settled at 6.09%", source: "card:boc_5y_mortgage_rate", note: "5-year conventional mortgage rate, BoC Valet V80691335." },
      { phrase: "1989-1991", source: "pipeline:boc:INDINF_AFFORD_Q", note: "Historical stress episode in BoC affordability series; identified from full-history INDINF_AFFORD_Q." },
      { phrase: "2007-2008", source: "pipeline:boc:INDINF_AFFORD_Q", note: "Historical stress episode in BoC affordability series." },
      { phrase: "2022-2024 tightening cycle", source: "pipeline:boc:V39079", note: "BoC overnight target rate hike cycle, Mar 2022 through Jul 2023 hike, on hold through 2024." },
    ],
  },
  {
    id: "plate-5",
    number: "05",
    indicator: "Mortgage arrears, household debt-service ratio",
    plateIndexLabel: "Stress",
    asOf: "Apr 2026 (arrears) / Q1 2026 (DSR)",
    title: "Mortgage stress is contained.",
    interpretationHtml:
      "Realized distress remains contained: the bank mortgage arrears rate sits at 0.28% in April, well within its historical range and far below stress-episode peaks. " +
      "The aggregate household debt-service ratio at 14.75% has edged up from late 2025 but remains below the 2024 cycle high. " +
      "Households have absorbed the tightening cycle without breaking; the housing system isn't accelerating into a boom or cracking into a bust.",
    source: "Canadian Bankers Association mortgage arrears; Statistics Canada Table 11-10-0065-01 (household debt-service ratio).",
    chartKey: "housing-panel-6",
    data: panel6Data,
    citations: [
      { phrase: "0.28% in April", source: "pipeline:cba:mortgage_arrears_national", note: "CBA national mortgage arrears rate, Apr 2026." },
      { phrase: "14.75%", source: "pipeline:statcan:11-10-0065-01", note: "Household aggregate debt-service ratio, 2026 Q1, SA. StatCan 11-10-0065-01 vector v1001696813." },
      { phrase: "late 2025", source: "pipeline:statcan:11-10-0065-01", note: "Household aggregate debt-service ratio was 14.68% in 2025Q4 before rising to 14.75% in 2026Q1." },
      { phrase: "below the 2024 cycle high", source: "derived", note: "DSR peaked during the 2024 BoC tightening cycle and remains below that high in 2026Q1." },
    ],
  },
];

const pageTitle = "Housing";
const pageDescription =
  "Canadian housing market chartbook: MLS HPI home prices, starts, sales-to-new-listings, mortgage arrears, and affordability.";

// Lede reads the same editorial blurb the auto-blurb pipeline writes for the
// splash tile (sections.ts -> section.blurb.body). Single source of truth: a
// release-day fan-out updates one field and both surfaces refresh.
const lede = section.blurb?.body ?? "";
---
<SectionLayout
  slug="housing"
  sectionIndex={5}
  sectionLabel="Housing"
  headlineQuestion={section.headlineQuestion}
  lede={lede}
  latestReleaseLabel={latestReleaseLabel}
  plates={plates}
  title={pageTitle}
  description={pageDescription}
/>
