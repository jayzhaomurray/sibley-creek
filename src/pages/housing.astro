const pageTitle = "Housing";
const pageDescription =
  "Housing chartbook: prices (MLS HPI), starts and permits, sales and inventory, rents, the mortgage stack, " +
  "and the population-to-housing-stock ratio. Six plates of chart-with-interpretation.";

const lede =
  "Six plates trace the rate-sensitive sector: prices and activity, inventory and rents, the mortgage stack that carries " +
  "the household balance sheet, and the supply ratio against the population it has to absorb.";
---
<SectionLayout
  slug="housing"
  sectionIndex={4}
  sectionLabel="Housing"
  headlineQuestion={section.headlineQuestion}
  lede={lede}
  latestReleaseLabel="MLS HPI, Apr 2026 - released May 15, 2026"
  plates={plates}
  title={pageTitle}
  description={pageDescription}
/>
