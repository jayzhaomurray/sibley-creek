---
/*
 * Housing - Vignelli chartbook page.
 *
 * Six plates per editorial canon section 4.4:
 *   01 Prices (MLS HPI national + six CMAs)
 *   02 Activity (starts, completions, permits)
 *   03 Inventory and absorption (sales-to-new-listings, months of inventory)
 *   04 Rent (CMHC RMS + CPI rent sub-series)
 *   05 Mortgage stack snapshot (BoC chartpack + OSFI + CMHC arrears)
 *   06 Population-to-housing-stock ratio (by CMA)
 *
 * No chart components for Housing yet; each plate reserves the chart
 * space with a dashed-border placeholder. chart-builder fills later.
 * Interpretation prose is placeholder, in publication voice; writer
 * refines.
 */

import SectionLayout from "../layouts/SectionLayout.astro";
import type { Plate } from "../layouts/SectionLayout.astro";
import { sections } from "../data/sections";

const section = sections.find((s) => s.slug === "housing");
if (!section) {
  throw new Error("Housing section not found in src/data/sections.ts");
}

const plates: Plate[] = [
  {
    id: "plate-1",
    number: "01",
    indicator: "MLS HPI benchmark, national + six CMAs",
