    interpretationHtml:
      "The national MLS HPI is down <strong>-1.4% y/y</strong>, and the 6-month annualized print is softer still. " +
      "Toronto and Vancouver are doing most of the drift; Calgary remains firm and Montreal is roughly flat. " +
      "No national-average headline number is rendered - the CMA cuts tell the story.",
    callout: {
      value: "-1.4%",
      unit: "MLS HPI composite, y/y, April 2026",
      delta: "-0.3 pp vs Mar",
      direction: "neg",
    },
    source: "CREA MLS HPI national + six-CMA bulk file, April 2026 vintage.",
  },
  {
