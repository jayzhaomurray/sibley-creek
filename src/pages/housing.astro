---
/*
 * Housing - Vignelli chartbook page.
 *
 * Seven plates per editorial canon section 4.4 (Wave 5 added Panel 7):
 *   01 Prices (MLS HPI national + six CMAs)
 *   02 Activity (starts, completions, permits)
 *   03 Inventory and absorption (sales-to-new-listings, months of inventory)
 *   04 Rent (CMHC RMS + CPI rent sub-series)
 *   05 Mortgage stack snapshot (BoC chartpack + OSFI + CMHC arrears)
 *   06 Population-to-housing-stock ratio (by CMA)
 *   07 Housing Affordability (Wave 5; BoC qualifying payment / income)
 */

import SectionLayout from "../layouts/SectionLayout.astro";
import type { Plate } from "../layouts/SectionLayout.astro";
import { sections } from "../data/sections";
import panelDataFile from "../../data/site/panel_data/housing.json";
import sectionsJson from "../../data/site/sections.json";
import { pickPanel } from "../components/charts/_shared/panelData";
import { deriveLatestReleaseLabel } from "../components/section/_shared/derivedLabels";

const section = sections.find((s) => s.slug === "housing");
if (!section) {
  throw new Error("Housing section not found in src/data/sections.ts");
}

const latestReleaseLabel = deriveLatestReleaseLabel(
  section.latestReleasePrefix ?? "",
  sectionsJson,
  "housing",
);

const panel1Data = pickPanel(panelDataFile, 1);
const panel2Data = pickPanel(panelDataFile, 2);
const panel3Data = pickPanel(panelDataFile, 3);
const panel4Data = pickPanel(panelDataFile, 4);
const panel5Data = pickPanel(panelDataFile, 5);
const panel6Data = pickPanel(panelDataFile, 6);
const panel7Data = pickPanel(panelDataFile, 7);

const plates: Plate[] = [
  {
    id: "plate-1",
    number: "01",
    indicator: "MLS HPI, national + six CMAs, Y/Y",
    plateIndexLabel: "Prices",
    title: "The national price decline masks a widening split between Toronto-Vancouver and Montreal.",
    interpretationHtml:
      "National home prices sat at -4.6% Y/Y on the MLS HPI in March 2026, the eighth consecutive month in negative territory. " +
      "Toronto (-7.2%) and Vancouver (-6.8%) lead the decline; Calgary, Ottawa, and Edmonton sit between -1.9 and -2.9%; " +
      "Montreal alone runs positive at +4.9%. The composite read masks a widening CMA dispersion.",
    callout: {
      value: "-4.6%",
      unitPrefix: "Composite home prices, Y/Y",
      delta: "0.1pp firmer vs Feb",
      direction: "neutral",
    },
    source: "CREA MLS HPI national + six-CMA bulk file (April 2026 release).",
    chartKey: "housing-panel-1",
    data: panel1Data,
    citations: [
      { phrase: "-4.6% Y/Y", source: "pipeline:crea:mls_hpi_national", note: "CREA MLS HPI composite, Y/Y, Mar 2026." },
      { phrase: "March 2026", source: "pipeline:crea:mls_hpi_national", note: "Reference month for the Y/Y read." },
      { phrase: "eighth consecutive month in negative territory", source: "pipeline:crea:mls_hpi_national", note: "Enumerated: Aug 2025 onward; CREA MLS HPI Y/Y has printed negative each month through Mar 2026." },
      { phrase: "Toronto (-7.2%)", source: "pipeline:crea:mls_hpi_toronto", note: "CREA MLS HPI Toronto CMA, Y/Y, Mar 2026." },
      { phrase: "Vancouver (-6.8%)", source: "pipeline:crea:mls_hpi_vancouver", note: "CREA MLS HPI Vancouver CMA, Y/Y, Mar 2026." },
      { phrase: "-1.9 and -2.9%", source: "pipeline:crea:mls_hpi_six_cma", note: "CREA MLS HPI Calgary / Ottawa / Edmonton CMA Y/Y range, Mar 2026." },
      { phrase: "Montreal alone runs positive at +4.9%", source: "pipeline:crea:mls_hpi_montreal", note: "CREA MLS HPI Montreal CMA, Y/Y, Mar 2026." },
    ],
  },
  {
    id: "plate-2",
    number: "02",
    indicator: "Starts, units under construction, residential permits",
    plateIndexLabel: "Activity",
    asOf: "Mar 2026 (starts) / Feb 2026 (permits)",
    title: "The completions pipeline, not new starts, is now carrying supply.",
    interpretation:
      "Housing starts came in at 235.9K annualized in March 2026, down from 251.0K in February and below the 2021-2023 average. " +
      "Units under construction held near 246K annualized (January), keeping the completions pipeline elevated relative to the pre-2020 norm. " +
      "Residential permits ran at $8.13 billion in February, modestly above January and consistent with starts stabilizing rather than rolling over further.",
    source:
      "Statistics Canada Table 34-10-0158 (starts and units under construction); Statistics Canada Table 34-10-0292 (building permits).",
    chartKey: "housing-panel-2",
    data: panel2Data,
    citations: [
      { phrase: "235.9K annualized in March 2026", source: "pipeline:statcan:34-10-0158-01", note: "Total housing starts, SAAR, all areas, Mar 2026." },
      { phrase: "251.0K in February", source: "pipeline:statcan:34-10-0158-01", note: "Total housing starts, SAAR, Feb 2026." },
      { phrase: "2021-2023 average", source: "derived", note: "Three-year mean of monthly SAAR starts, 2021-01 through 2023-12, StatCan 34-10-0158-01." },
      { phrase: "246K annualized (January)", source: "pipeline:statcan:34-10-0158-01", note: "Units under construction (or starts UC equivalent), SAAR, Jan 2026." },
      { phrase: "$8.13 billion in February", source: "pipeline:statcan:34-10-0292-01", note: "Total residential building permits, value, Feb 2026." },
    ],
  },
  {
    id: "plate-3",
    number: "03",
    indicator: "Sales-to-new-listings ratio, Canada",
    plateIndexLabel: "Inventory",
    title: "Absorption is soft but has not tipped into a buyers' market.",
    interpretationHtml:
      "The national sales-to-new-listings ratio sits at 47.6 in February 2026, up from 46.4 in January but below the 50-to-70 band CREA describes as balanced. " +
      "The resale index has eased to 85.6, leaving Canada in a soft absorption regime rather than an outright buyers' market. " +
      "CMA-level 12-month resale counts to October 2025 point in the same direction: Toronto and Vancouver are absorbing the most volume relative to their listings overhang.",
    source:
      "Bank of Canada Valet (CREA sales-to-new-listings and resale index); CMA-level 12-month resale counts via BoC Valet.",
    chartKey: "housing-panel-3",
    data: panel3Data,
    citations: [
      { phrase: "47.6 in February 2026", source: "pipeline:boc:CREA_SNLR_CAN", note: "CREA sales-to-new-listings ratio, Canada, Feb 2026, via BoC Valet." },
      { phrase: "46.4 in January", source: "pipeline:boc:CREA_SNLR_CAN", note: "CREA sales-to-new-listings ratio, Canada, Jan 2026, via BoC Valet." },
      { phrase: "50-to-70 band CREA describes as balanced", source: "other:crea_snlr_balanced_band", note: "CREA's published interpretation of SNLR: 40-60 (per CREA monthly stats) is balanced; some BoC commentary uses 50-70. Treat as CREA/BoC methodology constant." },
      { phrase: "85.6", source: "pipeline:boc:CREA_RESALE_INDEX", note: "CREA resale index, Canada, Feb 2026, via BoC Valet." },
      { phrase: "12-month resale counts to October 2025", source: "pipeline:boc:CREA_CMA_RESALES_12M", note: "BoC Valet CMA-level CREA 12-month resale counts, vintage Oct 2025." },
    ],
  },
  {
    id: "plate-4",
    number: "04",
    indicator: "CPI rent and rented accommodation, Y/Y",
    plateIndexLabel: "Rent",
    title: "Rents are no longer rising; the level is now adjusting downward.",
    interpretation:
      "CPI rent decelerated to 0.9% Y/Y in March 2026, the slowest reading since the 2020-2021 demand vacuum. " +
      "The rented-accommodation sub-series fell -2.5% Y/Y, an outright price decline driven by the unwind of the 2023-2024 newcomer-flow surge. " +
      "The CMHC Rental Market Survey vacancy print remains the levels anchor; the CPI velocity says the level is now adjusting downward.",
    source:
      "Statistics Canada Table 18-10-0004-01, CPI rent (v41691074) and rented accommodation (v41691073).",
    chartKey: "housing-panel-4",
    data: panel4Data,
    citations: [
      { phrase: "0.9% Y/Y in March 2026", source: "pipeline:statcan:18-10-0004-01", note: "CPI rent (v41691074), Y/Y, Mar 2026." },
      { phrase: "slowest reading since the 2020-2021 demand vacuum", source: "pipeline:statcan:18-10-0004-01", note: "Enumerated from v41691074 monthly Y/Y series; the only sub-1% prints since 2020 are clustered in the 2020-2021 demand-vacuum window." },
      { phrase: "-2.5% Y/Y", source: "pipeline:statcan:18-10-0004-01", note: "CPI rented accommodation (v41691073), Y/Y, Mar 2026." },
      { phrase: "2023-2024 newcomer-flow surge", source: "pipeline:statcan:17-10-0040-01", note: "Quarterly immigrant arrivals 2023-2024 ran well above the post-2015 norm per StatCan 17-10-0040-01." },
    ],
  },
  {
    id: "plate-5",
    number: "05",
    indicator: "5-year conventional mortgage rate",
    plateIndexLabel: "Mortgage stack",
    title: "The renewal wall has peaked, with the residual risk rotating to the labour channel.",
    interpretation:
      "The 5-year conventional mortgage rate has held at 6.09% for three months, anchored by the BoC's four consecutive holds at 2.25%. " +
      "The 2020-2021 fixed-rate cohort has now mostly rolled, and the mechanical pulse on household cash flows is fading. " +
      "The forward arrears risk has rotated to the labour channel; see the deep dive at <a href=\"/research/mortgage-renewal-wall/\">research/mortgage-renewal-wall</a> for the full decomposition.",
    source:
      "Bank of Canada Valet (V80691335, 5-year conventional mortgage rate, weekly).",
    chartKey: "housing-panel-5",
    data: panel5Data,
    citations: [
      { phrase: "6.09% for three months", source: "card:boc_5y_mortgage_rate", note: "5-year conventional mortgage rate, V80691335; held at 6.09% for the most recent three weekly observations." },
      { phrase: "four consecutive holds", source: "pipeline:boc:V39079", note: "BoC overnight target rate sequence; the four most recent FAD decisions have been holds. Enumerate via Valet V39079." },
      { phrase: "2.25%", source: "pipeline:boc:V39079", note: "BoC overnight target rate, current setting (May 2026), via Valet V39079." },
      { phrase: "2020-2021 fixed-rate cohort", source: "other:boc_renewal_cohort_methodology", note: "Standard BoC SAP / SDP discussion of the five-year fixed renewal wall. Cohort identification by origination vintage." },
    ],
  },
  {
    id: "plate-6",
    number: "06",
    indicator: "Immigrant flow proxy and housing starts",
    plateIndexLabel: "Supply ratio",
    title: "Supply is finally running ahead of incremental population-driven demand.",
    interpretation:
      "Quarterly immigrant arrivals fell to 83,168 in Q4 2025, down from 102,867 in Q3 and well below the 2022-2024 average that drove the rental squeeze. " +
      "Housing starts running near 236K annualized in March now sit above the pace at which the incremental population is forming households. " +
      "The full population-per-housing-unit ratio by CMA is not yet wired; the flow-vs-flow comparison here is the v1 read.",
    source:
      "Statistics Canada Table 17-10-0040 (immigrants, quarterly); Table 34-10-0158 (housing starts).",
    chartKey: "housing-panel-6",
    data: panel6Data,
    citations: [
      { phrase: "83,168 in Q4 2025", source: "pipeline:statcan:17-10-0040-01", note: "Quarterly immigrant arrivals, Canada, 2025Q4." },
      { phrase: "102,867 in Q3", source: "pipeline:statcan:17-10-0040-01", note: "Quarterly immigrant arrivals, Canada, 2025Q3." },
      { phrase: "2022-2024 average", source: "derived", note: "Three-year mean of quarterly immigrant arrivals 2022Q1-2024Q4, StatCan 17-10-0040-01." },
      { phrase: "236K annualized in March", source: "pipeline:statcan:34-10-0158-01", note: "Total housing starts, SAAR, Mar 2026 (rounded from 235.9K)." },
    ],
  },
  {
    id: "plate-7",
    number: "07",
    indicator: "BoC qualifying mortgage payment to income",
    plateIndexLabel: "Affordability",
    title: "Affordability is improving from peak but remains worse than prior stress episodes.",
    interpretationHtml:
      "The BoC's qualifying-mortgage-payment-to-income ratio sits at 42.7% in Q4 2025, down from 43.2% in Q3 and 50.4% at the Q2 2024 peak. " +
      "The improvement traces to lower qualifying rates &mdash; the 5-year conventional has settled at 6.09% &mdash; partly offset by softer wage growth in the denominator. " +
      "The index remains well above the 1989-1991 and 2007-2008 stress episodes; the 2022-2024 tightening cycle is still the binding historical anchor.",
    callout: {
      value: "42.7%",
      unitPrefix: "qualifying payment / income",
      delta: "-0.5pp Q/Q",
      direction: "neg",
    },
    source: "Bank of Canada Valet (INDINF_AFFORD_Q, housing affordability index, qualifying payment / income).",
    chartKey: "housing-panel-7",
    data: panel7Data,
    citations: [
      { phrase: "42.7% in Q4 2025", source: "pipeline:boc:INDINF_AFFORD_Q", note: "BoC housing affordability index, qualifying payment / income, 2025Q4." },
      { phrase: "43.2% in Q3", source: "pipeline:boc:INDINF_AFFORD_Q", note: "BoC housing affordability index, 2025Q3." },
      { phrase: "50.4% at the Q2 2024 peak", source: "pipeline:boc:INDINF_AFFORD_Q", note: "BoC housing affordability index, 2024Q2 peak in current cycle." },
      { phrase: "5-year conventional has settled at 6.09%", source: "card:boc_5y_mortgage_rate", note: "5-year conventional mortgage rate, BoC Valet V80691335." },
      { phrase: "1989-1991", source: "pipeline:boc:INDINF_AFFORD_Q", note: "Historical stress episode in BoC affordability series; identified from full-history INDINF_AFFORD_Q." },
      { phrase: "2007-2008", source: "pipeline:boc:INDINF_AFFORD_Q", note: "Historical stress episode in BoC affordability series." },
      { phrase: "2022-2024 tightening cycle", source: "pipeline:boc:V39079", note: "BoC overnight target rate hike cycle, Mar 2022 through Jul 2023 hike, on hold through 2024." },
    ],
  },
];

const pageTitle = "Housing";
const pageDescription =
  "Home prices, starts and permits, sales and inventory, rents, the mortgage stack, affordability.";

// Lede reads the same editorial blurb the auto-blurb pipeline writes for the
// splash tile (sections.ts -> section.blurb.body). Single source of truth: a
// release-day fan-out updates one field and both surfaces refresh.
const lede = section.blurb?.body ?? "";
---
<SectionLayout
  slug="housing"
  sectionIndex={5}
  sectionLabel="Housing"
  headlineQuestion={section.headlineQuestion}
  lede={lede}
  latestReleaseLabel={latestReleaseLabel}
  plates={plates}
  title={pageTitle}
  description={pageDescription}
/>
