    source:
      "CMHC Rental Market Survey, October 2025; Statistics Canada Table 18-10-0004-01 (rent sub-series).",
  },
  {
    id: "plate-5",
    number: "05",
    indicator: "Mortgage stack snapshot",
    plateIndexLabel: "Mortgage stack",
