    font-size: clamp(36px, 5vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .alt-page__lede {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink);
    max-width: 60ch;
  }

  .alt-section {
    margin-bottom: 64px;
  }
  .alt-section__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 12px;
    margin-bottom: 24px;
    border-bottom: 2px solid var(--ink);
  }
  .alt-section__title {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 32px;
    letter-spacing: -0.012em;
    color: var(--ink);
  }
  .alt-section__count {
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 12px;
    color: var(--ink);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .alt-unit {
    padding-block: 28px;
    border-bottom: 1px solid var(--ink);
  }
  .alt-unit:last-child {
    border-bottom: 0;
  }
  .alt-unit__head {
    margin-bottom: 16px;
  }
  .alt-unit__file {
    margin: 0 0 6px;
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 11px;
    color: var(--ink);
    opacity: 0.65;
  }
  .alt-unit__title {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 22px;
    line-height: 1.2;
    color: var(--ink);
  }

  .alt-unit__chart {
    width: 100%;
    border: 1px solid var(--ink);
    margin-bottom: 16px;
    background: var(--paper);
  }
  .alt-unit__chart :global(.alt-chart),
  .alt-unit__chart :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .alt-unit__meta {
