import TrdAlt2 from "../components/charts/_alternatives/trade/Alt2_UsExportShare.astro";
import TrdAlt3 from "../components/charts/_alternatives/trade/Alt3_BalanceSmoothing.astro";
import TrdAlt4 from "../components/charts/_alternatives/trade/Alt4_TermsTradeVsWti.astro";

// Housing
import HsgAlt1 from "../components/charts/_alternatives/housing/Alt1_HpiMultiCity.astro";
