interface AltSpec {
  file: string;
  title: string;
  whatDifferent: string;
  whyBetter: string;
  dataFields: string;
  Component: any;
  /**
   * Optional panel data passed through to the rendered component. Used when
   * the alternative IS a production component (rather than an Alt*.astro
   * placeholder) and needs real pipeline data to draw. Placeholder alts
   * leave this unset and receive no props.
   */
  componentData?: unknown;
}

interface SectionSpec {
  slug: string;
  name: string;
  alts: AltSpec[];
}

