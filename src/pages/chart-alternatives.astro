---
/*
 * chart-alternatives - chart-builder review page.
 *
 * Not linked from production navigation. URL-accessed only:
 *   /chart-alternatives
 *
 * Renders every chart manifest under src/components/charts/_alternatives/
 * <section>/index.ts, grouped by section, in a vertical scroll. Each chart
 * sits in a frame matching the chartbook-unit visual register so the reader
 * can evaluate it in the same surround a production plate would have.
 *
 * The user reads this page, picks the alternatives they want to keep, and
 * the rest get deleted, archived, or promoted in a follow-up sweep.
 *
 * Wiring:
 *   - This page does NOT import individual Alt*.astro files. Adding a new
 *     alt is one entry in the section's index.ts manifest — the page picks
 *     it up automatically on the next build.
 *   - Per-section manifests at _alternatives/<section>/index.ts.
 *   - Aggregate manifest (the section order) at _alternatives/index.ts.
 *
 * Sibling page: /chart-archive renders the same shape against
 * _archive/<section>/index.ts for charts parked indefinitely (with a
 * pinned-favorites zone above the rest).
 */

import BaseLayout from "../layouts/BaseLayout.astro";
import { shelves } from "../components/charts/_alternatives/index";
import type { ChartShelfEntry } from "../components/charts/_alternatives/_shared/shelfEntry";

// Sort entries within each section by addedAt desc; entries without
// addedAt fall to the bottom in original manifest order. Stable sort
// via manifest-index tiebreaker.
function sortByRecency(entries: ChartShelfEntry[]): ChartShelfEntry[] {
  return entries
    .map((entry, idx) => ({ entry, idx }))
    .sort((a, b) => {
      const aDate = a.entry.addedAt ?? "";
      const bDate = b.entry.addedAt ?? "";
      if (aDate && bDate && aDate !== bDate) return bDate.localeCompare(aDate);
      if (aDate && !bDate) return -1;
      if (!aDate && bDate) return 1;
      return a.idx - b.idx;
    })
    .map((wrapped) => wrapped.entry);
}

const sortedShelves = shelves.map((shelf) => ({
  ...shelf,
  entries: sortByRecency(shelf.entries),
}));

const totalCount = sortedShelves.reduce(
  (sum, s) => sum + s.entries.length,
  0,
);
---

<BaseLayout
  title="Chart alternatives"
  description="Internal review page for chart-builder alternative chart treatments. Not for production."
>
  <div class="alt-page">
    <header class="alt-page__head">
      <p class="alt-page__eyebrow">CHART-BUILDER REVIEW</p>
      <h1 class="alt-page__title">Chart alternatives</h1>
      <p class="alt-page__lede">
        {totalCount} alternative treatments across {sortedShelves.length} sections.
        Each chart consumes data already in the pipeline. Keep what survives;
        the rest get deleted in a follow-up sweep.
      </p>
      <p class="alt-page__crosslink">
        Charts parked indefinitely live on
        <a href="/chart-archive/">/chart-archive</a>.
      </p>
    </header>

    <nav class="alt-jump" aria-label="Jump to section">
      <ul class="alt-jump__list">
        {sortedShelves.map((shelf) => {
          const empty = shelf.entries.length === 0;
          return (
            <li class={`alt-jump__item${empty ? " alt-jump__item--empty" : ""}`}>
              {empty
                ? <span class="alt-jump__link" aria-disabled="true">
                    {shelf.name}
                    <span class="alt-jump__count">({shelf.entries.length})</span>
                  </span>
                : <a class="alt-jump__link" href={`#section-${shelf.slug}`}>
                    {shelf.name}
                    <span class="alt-jump__count">({shelf.entries.length})</span>
                  </a>
              }
            </li>
          );
        })}
      </ul>
    </nav>

    {sortedShelves.map((shelf) => (
      <section class="alt-section" id={`section-${shelf.slug}`}>
        <header class="alt-section__head">
          <h2 class="alt-section__title">{shelf.name}</h2>
          <p class="alt-section__count">
            {shelf.entries.length} alternative{shelf.entries.length === 1 ? "" : "s"}
          </p>
        </header>

        {shelf.entries.map((entry) => {
          const Component = entry.Component as any;
          return (
            <article class="alt-unit">
              <header class="alt-unit__head">
                <p class="alt-unit__file">{entry.file}</p>
                <h3 class="alt-unit__title">{entry.title}</h3>
              </header>

              <div class="alt-unit__chart">
                {entry.data !== undefined
                  ? <Component data={entry.data} />
                  : <Component />}
              </div>

              <dl class="alt-unit__meta">
                <div class="alt-unit__row">
                  <dt>What's different</dt>
                  <dd>{entry.whatDifferent}</dd>
                </div>
                <div class="alt-unit__row">
                  <dt>Why it might be better</dt>
                  <dd>{entry.whyBetter}</dd>
                </div>
                <div class="alt-unit__row">
                  <dt>Data fields</dt>
                  <dd><code>{entry.dataFields}</code></dd>
                </div>
              </dl>
            </article>
          );
        })}
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .alt-page {
    max-width: 880px;
    margin: 0 auto;
    padding-block: 48px 96px;
  }

  .alt-page__head {
    padding-bottom: 36px;
    border-bottom: 1px solid var(--ink);
    margin-bottom: 48px;
  }
  .alt-page__eyebrow {
    margin: 0 0 12px;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .alt-page__title {
    margin: 0 0 16px;
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: clamp(36px, 5vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .alt-page__lede {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink);
    max-width: 60ch;
  }
  .alt-page__crosslink {
    margin: 14px 0 0;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink);
    opacity: 0.75;
    max-width: 60ch;
  }
  .alt-page__crosslink a {
    color: var(--ink);
  }

  /* Wayfinding strip — sticky at top of viewport on scroll. */
  .alt-jump {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--paper);
    margin: -24px 0 32px;
    padding: 10px 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.15);
  }
  .alt-jump__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    align-items: baseline;
  }
  .alt-jump__item {
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.4;
  }
  .alt-jump__link {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 1px;
    transition: border-color 0.15s ease;
  }
  a.alt-jump__link:hover,
  a.alt-jump__link:focus-visible {
    border-bottom-color: var(--accent);
  }
  .alt-jump__count {
    margin-left: 4px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink);
    opacity: 0.55;
  }
  .alt-jump__item--empty .alt-jump__link {
    opacity: 0.4;
    cursor: default;
  }

  .alt-section {
    margin-bottom: 64px;
  }
  .alt-section__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 12px;
    margin-bottom: 24px;
    border-bottom: 2px solid var(--ink);
  }
  .alt-section__title {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 32px;
    letter-spacing: -0.012em;
    color: var(--ink);
  }
  .alt-section__count {
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 12px;
    color: var(--ink);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .alt-unit {
    padding-block: 28px;
    border-bottom: 1px solid var(--ink);
  }
  .alt-unit:last-child {
    border-bottom: 0;
  }
  .alt-unit__head {
    margin-bottom: 16px;
  }
  .alt-unit__file {
    margin: 0 0 6px;
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 11px;
    color: var(--ink);
    opacity: 0.65;
  }
  .alt-unit__title {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 22px;
    line-height: 1.2;
    color: var(--ink);
  }

  .alt-unit__chart {
    width: 100%;
    border: 1px solid var(--ink);
    margin-bottom: 16px;
    background: var(--paper);
  }
  .alt-unit__chart :global(.alt-chart),
  .alt-unit__chart :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .alt-unit__meta {
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
  }
  .alt-unit__row {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 16px;
    align-items: baseline;
  }
  .alt-unit__row dt {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .alt-unit__row dd {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink);
  }
  .alt-unit__row dd code {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink);
    background: rgba(0,0,0,0.04);
    padding: 1px 4px;
  }

  @media (max-width: 640px) {
    .alt-unit__row {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
