const totalCount = sections.reduce((sum, s) => sum + s.alts.length, 0);
---

<BaseLayout
  title="Chart alternatives"
  description="Internal review page for chart-builder alternative chart treatments. Not for production."
>
  <div class="alt-page">
    <header class="alt-page__head">
      <p class="alt-page__eyebrow">CHART-BUILDER REVIEW</p>
      <h1 class="alt-page__title">Chart alternatives</h1>
      <p class="alt-page__lede">
        {totalCount} alternative treatments across {sections.length} sections.
        Each chart consumes data already in the pipeline. Keep what survives;
        the rest get deleted in a follow-up sweep.
      </p>
    </header>

    {sections.map((section) => (
      <section class="alt-section" id={`section-${section.slug}`}>
        <header class="alt-section__head">
          <h2 class="alt-section__title">{section.name}</h2>
          <p class="alt-section__count">{section.alts.length} alternative{section.alts.length === 1 ? "" : "s"}</p>
        </header>

        {section.alts.map((alt) => (
          <article class="alt-unit">
            <header class="alt-unit__head">
              <p class="alt-unit__file">{alt.file}</p>
              <h3 class="alt-unit__title">{alt.title}</h3>
            </header>

            <div class="alt-unit__chart">
              {alt.componentData !== undefined
                ? <alt.Component data={alt.componentData} />
                : <alt.Component />}
            </div>

            <dl class="alt-unit__meta">
              <div class="alt-unit__row">
                <dt>What's different</dt>
                <dd>{alt.whatDifferent}</dd>
              </div>
              <div class="alt-unit__row">
                <dt>Why it might be better</dt>
                <dd>{alt.whyBetter}</dd>
              </div>
              <div class="alt-unit__row">
                <dt>Data fields</dt>
                <dd><code>{alt.dataFields}</code></dd>
              </div>
            </dl>
          </article>
        ))}
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .alt-page {
    max-width: 880px;
    margin: 0 auto;
    padding-block: 48px 96px;
  }

  .alt-page__head {
    padding-bottom: 36px;
    border-bottom: 1px solid var(--ink);
    margin-bottom: 48px;
  }
  .alt-page__eyebrow {
