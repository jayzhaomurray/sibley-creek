---
/*
 * Homepage v2 — DRAFT for iteration.
 *
 * Lives at sibleycreek.ca/v2/. Not linked from anywhere visible. Iterate freely.
 * When ready to promote:
 *   1. Move current src/pages/index.astro -> src/pages/_archive/index-v1.astro
 *   2. Rename this file (v2.astro) to index.astro
 *   3. Commit + push. Live splash swaps over.
 *
 * Differences from v1:
 *   - Dismissible signup modal (immediate on page load, 7-day localStorage cooldown)
 *   - Subscription pitch + signup form inline (fallback for dismissed-modal visitors)
 *   - Footer retainer mention linking to /work-with-us
 *   - Otherwise identical to v1
 *
 * Subscription form is currently a placeholder. To wire up to Kit:
 *   1. Set up the form in Kit's admin
 *   2. Replace REPLACE_WITH_KIT_FORM_ACTION_URL in BOTH the modal form and
 *      the inline form below
 *   3. Adjust the name attribute if Kit expects something other than "email_address"
 */

import BaseLayout from "../layouts/BaseLayout.astro";
import TitleStatement from "../components/home/TitleStatement.astro";
import PressStrip from "../components/home/PressStrip.astro";
import SectionPanel from "../components/home/SectionPanel.astro";
import DeepDivePanel from "../components/home/DeepDivePanel.astro";
import { deepDives, site } from "../data/sections";
import { enrichedSections, type EnrichedSection } from "../data/site_data_loader";

const ordered: EnrichedSection[] = enrichedSections;

const today = new Date();
const longDate = new Intl.DateTimeFormat("en-CA", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "America/Toronto",
}).format(today);

const pageDesc =
  `Canadian macro overview for ${longDate}. Seven indicator domains - GDP, ` +
  "inflation, labour, housing, monetary policy, markets, trade - each with " +
  "an anchor chart and the latest prints. Independent research.";
---
<BaseLayout
  title={site.name}
  description={pageDesc}
  pageClass="home-page"
  showMastheadRail={true}
>
  <article class="home">
    <TitleStatement dateLine={longDate} />

    {/* PREVIEW ONLY: PressStrip placed here for visual verification.
        Placement on index.astro is deferred pending the positioning call. */}
    <PressStrip />

    {/* Existing section grid - unchanged from v1 */}
    <section class="home__grid" aria-label="Indicator panels">
      <h2 class="visually-hidden">Indicator panels</h2>
      {ordered.map((s, i) => (
        <div class="home__cell">
          <SectionPanel section={s} figureNum={String(i + 1)} />
        </div>
      ))}
      <div class="home__cell">
        <DeepDivePanel deepDives={deepDives} figureNum="8" />
      </div>
    </section>

    {/* Subscribe section - below grid, after the credibility surface */}
    <section class="home__subscribe-band" aria-label="Subscribe to Sibley Creek">
      <div class="home__subscribe-inner">
        <h2 class="home__subscribe-title">Get Sibley Creek's research in your inbox.</h2>
        <p class="home__subscribe-lede">
          Independent Canadian macroeconomic analysis. Free to join the list while we build out the subscription product.
        </p>
        <form
          class="home__subscribe-form"
          action="REPLACE_WITH_KIT_FORM_ACTION_URL"
          method="post"
          target="_blank"
        >
          <label for="footer-signup-email" class="visually-hidden">Email address</label>
          <input
            type="email"
            id="footer-signup-email"
            name="email_address"
            placeholder="you@example.com"
            required
            class="home__subscribe-input"
          />
          <button type="submit" class="home__subscribe-button">
            Subscribe
          </button>
        </form>
        <p class="home__subscribe-note">
          Founding subscribers get a Sibley Creek hat or mug and lifetime founders pricing when the paid product launches.
        </p>
      </div>
    </section>

    {/* Advisory line removed: now covered by the colophon nav's "Work with us"
       link, which appears on every page and is the dignified pattern. */}
  </article>

  {/* Signup modal - immediate on load, dismissible, 7-day cooldown */}
  <div id="signup-modal" class="sc-modal" hidden>
    <div class="sc-modal__backdrop" data-dismiss></div>
    <div class="sc-modal__panel" role="dialog" aria-labelledby="sc-modal-title" aria-modal="true">
      <button type="button" class="sc-modal__close" aria-label="Close" data-dismiss>&times;</button>
      <p class="sc-modal__eyebrow">Sibley Creek</p>
      <h2 id="sc-modal-title" class="sc-modal__title">Join the list.</h2>
      <p class="sc-modal__lede">
        Sibley Creek research in your inbox. Independent Canadian macroeconomic analysis.
      </p>
      <form
        class="sc-modal__form"
        action="REPLACE_WITH_KIT_FORM_ACTION_URL"
        method="post"
        target="_blank"
      >
        <label for="sc-modal-email" class="visually-hidden">Email address</label>
        <input
          type="email"
          id="sc-modal-email"
          name="email_address"
          placeholder="you@example.com"
          required
          class="sc-modal__input"
        />
        <button type="submit" class="sc-modal__submit">Subscribe</button>
      </form>
      <p class="sc-modal__note">
        Founding subscribers get a Sibley Creek hat or mug and lifetime founders pricing when the paid product launches.
      </p>
      <button type="button" class="sc-modal__dismiss" data-dismiss>Maybe later</button>
    </div>
  </div>

  <style>
    /* Section grid (existing) */
    .home__grid {
      margin-top: 28px;
      display: grid;
      grid-template-columns: 1fr;
      gap: 0;
      border-top: 1px solid var(--ink);
      border-left: 1px solid var(--ink);
    }
    @media (min-width: 760px) {
      .home__grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
    .home__cell {
      min-width: 0;
      display: flex;
      border-right: 1px solid var(--ink);
      border-bottom: 1px solid var(--ink);
    }
    .home__cell > :global(*) {
      width: 100%;
    }

    /* Subscribe band - prominent, below the grid */
    .home__subscribe-band {
      margin-top: 0;
      padding: 48px 24px;
      border-top: 1px solid var(--ink);
      background-color: var(--paper);
    }
    .home__subscribe-inner {
      max-width: 560px;
      margin: 0 auto;
      text-align: center;
    }
    .home__subscribe-title {
      font-family: var(--font-sans);
      font-size: 24px;
      font-weight: var(--fw-semibold);
      line-height: 1.2;
      margin: 0 0 12px 0;
      color: var(--ink);
    }
    .home__subscribe-lede {
      font-family: var(--font-sans);
      font-size: 16px;
      line-height: 1.5;
      margin: 0 0 24px 0;
      color: var(--ink);
      opacity: 0.85;
    }
    .home__subscribe-form {
      display: flex;
      flex-direction: column;
      gap: 10px;
      max-width: 440px;
      margin: 0 auto;
    }
    @media (min-width: 480px) {
      .home__subscribe-form {
        flex-direction: row;
      }
    }
    .home__subscribe-input {
      flex: 1;
      padding: 12px 14px;
      border: 1px solid var(--ink);
      font-family: var(--font-sans);
      font-size: 15px;
      background-color: var(--paper);
      color: var(--ink);
    }
    .home__subscribe-input:focus {
      outline: 2px solid var(--accent);
      outline-offset: -2px;
    }
    .home__subscribe-button {
      padding: 12px 28px;
      background-color: var(--ink);
      color: var(--paper);
      border: 1px solid var(--ink);
      font-family: var(--font-sans);
      font-size: 15px;
      font-weight: var(--fw-semibold);
      cursor: pointer;
      white-space: nowrap;
    }
    .home__subscribe-button:hover {
      background-color: var(--accent);
      border-color: var(--accent);
    }
    .home__subscribe-note {
      font-family: var(--font-sans);
      font-size: 13px;
      line-height: 1.45;
      margin: 20px 0 0 0;
      color: var(--ink);
      opacity: 0.65;
      max-width: 480px;
      margin-left: auto;
      margin-right: auto;
    }

    /* Advisory line - quieter, below the subscribe band */
    .home__advisory-line {
      padding: 20px 24px;
      text-align: center;
      border-top: 1px solid var(--ink);
    }
    .home__advisory-line p {
      font-family: var(--font-sans);
      font-size: 13px;
      line-height: 1.5;
      color: var(--ink);
      opacity: 0.6;
      margin: 0;
      max-width: 560px;
      margin-left: auto;
      margin-right: auto;
    }
    .home__advisory-line a {
      color: var(--ink);
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 3px;
    }
    .home__advisory-line a:hover {
      color: var(--accent);
    }

    /* Signup modal - Sibley Creek register, not Substack default */
    .sc-modal {
      position: fixed;
      inset: 0;
      z-index: 9999;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 16px;
    }
    .sc-modal[hidden] {
      display: none;
    }
    .sc-modal__backdrop {
      position: absolute;
      inset: 0;
      background-color: rgba(21, 23, 26, 0.5);
      cursor: pointer;
    }
    .sc-modal__panel {
      position: relative;
      background-color: var(--paper);
      border: 1px solid var(--ink);
      padding: 40px 32px 32px 32px;
      max-width: 520px;
      width: 100%;
      box-shadow: 0 24px 48px rgba(21, 23, 26, 0.18);
    }
    .sc-modal__close {
      position: absolute;
      top: 8px;
      right: 12px;
      background: none;
      border: none;
      font-size: 28px;
      line-height: 1;
      color: var(--ink);
      cursor: pointer;
      padding: 4px 8px;
      opacity: 0.6;
    }
    .sc-modal__close:hover {
      opacity: 1;
    }
    .sc-modal__eyebrow {
      font-family: var(--font-sans);
      font-size: 12px;
      font-weight: var(--fw-semibold);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      margin: 0 0 8px 0;
      color: var(--ink);
      opacity: 0.7;
    }
    .sc-modal__title {
      font-family: var(--font-sans);
      font-size: 28px;
      font-weight: var(--fw-semibold);
      line-height: 1.15;
      margin: 0 0 12px 0;
      color: var(--ink);
    }
    .sc-modal__lede {
      font-family: var(--font-sans);
      font-size: 16px;
      line-height: 1.45;
      margin: 0 0 24px 0;
      color: var(--ink);
    }
    .sc-modal__form {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    @media (min-width: 480px) {
      .sc-modal__form {
        flex-direction: row;
      }
    }
    .sc-modal__input {
      flex: 1;
      padding: 11px 12px;
      border: 1px solid var(--ink);
      font-family: var(--font-sans);
      font-size: 15px;
      background-color: var(--paper);
      color: var(--ink);
    }
    .sc-modal__input:focus {
      outline: 2px solid var(--accent);
      outline-offset: -2px;
    }
    .sc-modal__submit {
      padding: 11px 24px;
      background-color: var(--ink);
      color: var(--paper);
      border: 1px solid var(--ink);
      font-family: var(--font-sans);
      font-size: 15px;
      font-weight: var(--fw-semibold);
      cursor: pointer;
      white-space: nowrap;
    }
    .sc-modal__submit:hover {
      background-color: var(--accent);
      border-color: var(--accent);
    }
    .sc-modal__note {
      font-family: var(--font-sans);
      font-size: 13px;
      line-height: 1.45;
      margin: 16px 0 20px 0;
      color: var(--ink);
      opacity: 0.65;
    }
    .sc-modal__dismiss {
      background: none;
      border: none;
      padding: 0;
      font-family: var(--font-sans);
      font-size: 13px;
      color: var(--ink);
      cursor: pointer;
      text-decoration: underline;
      text-underline-offset: 3px;
      opacity: 0.6;
    }
    .sc-modal__dismiss:hover {
      opacity: 1;
    }

    /* Lock body scroll while modal is open */
    :global(body.sc-modal-open) {
      overflow: hidden;
    }

    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  </style>

  <script>
    // Signup modal - immediate show on page load, 7-day localStorage cooldown
    (function () {
      const STORAGE_KEY = "sc-signup-modal-dismissed";
      const COOLDOWN_MS = 7 * 24 * 60 * 60 * 1000; // 7 days

      function shouldShow() {
        try {
          const dismissedAt = localStorage.getItem(STORAGE_KEY);
          if (!dismissedAt) return true;
          return Date.now() - parseInt(dismissedAt, 10) > COOLDOWN_MS;
        } catch (e) {
          return true; // localStorage unavailable; default to showing
        }
      }

      function dismiss() {
        try {
          localStorage.setItem(STORAGE_KEY, String(Date.now()));
        } catch (e) {
          // ignore
        }
        const modal = document.getElementById("signup-modal");
        if (modal) modal.hidden = true;
        document.body.classList.remove("sc-modal-open");
      }

      function init() {
        if (!shouldShow()) return;
        const modal = document.getElementById("signup-modal");
        if (!modal) return;

        modal.hidden = false;
        document.body.classList.add("sc-modal-open");

        // Wire all elements with data-dismiss to call dismiss()
        modal.querySelectorAll("[data-dismiss]").forEach((el) => {
          el.addEventListener("click", dismiss);
        });

        // Close on Escape
        function escapeHandler(e: KeyboardEvent) {
          if (e.key === "Escape") {
            dismiss();
            document.removeEventListener("keydown", escapeHandler);
          }
        }
        document.addEventListener("keydown", escapeHandler);

        // Focus email input
        const input = modal.querySelector(".sc-modal__input");
        if (input instanceof HTMLInputElement) input.focus();
      }

      // Delay slightly so it doesn't pop the moment the page loads (jarring)
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", () => {
          setTimeout(init, 800);
        });
      } else {
        setTimeout(init, 800);
      }
    })();
  </script>
</BaseLayout>
