---
import SectionLayout from "../layouts/SectionLayout.astro";
import type { Plate } from "../layouts/SectionLayout.astro";
import { sections } from "../data/sections";
import panelDataFile from "../../data/site/panel_data/fiscal.json";
import sectionsJson from "../../data/site/sections.json";
import { pickPanel } from "../components/charts/_shared/panelData";
import { deriveLatestReleaseLabel } from "../components/section/_shared/derivedLabels";

const section = sections.find((s) => s.slug === "fiscal");
if (!section) {
  throw new Error("Fiscal section not found in src/data/sections.ts");
}

const latestReleaseLabel = deriveLatestReleaseLabel(
  section.latestReleasePrefix ?? "",
  sectionsJson,
  "fiscal",
);

const panel1Data = pickPanel(panelDataFile, 1);
const panel2Data = pickPanel(panelDataFile, 2);

// Plates 3, 4, 5 are static-metadata panels: panel_data.py emits the full
// derived JSON tree under `metadata` but doesn't pre-shape it into the
// primary/secondary series shape the chart components expect. We synthesize
// the expected shape here from the metadata blobs.
//
// Long-term fix: per-panel transformers in pipeline/io/panel_data.py so the
// JSON-on-disk is already component-ready. Tracked as backend follow-up.

type RawPanels = { panels?: Record<string, { metadata?: any }> };
const _panels = (panelDataFile as unknown as RawPanels).panels ?? {};

// ---- Plate 3: PBO EFO Sept 2025 vs DoF SEU April 2026 ----------------------
// Convention: Panel3PBOvsDoF expects POSITIVE values (positive = deficit) —
// chart reads top-down. Metadata has negative balance_cad_bn (deficit).
const _meta3 = _panels["panel-3"]?.metadata;
const panel3Data = _meta3 ? {
  panelNum: 3,
  primary: {
    key: "dof_seu_deficit_projection",
    label: "DoF SEU Apr 2026",
    unit: "CAD billions",
    asOfISO: "2026-04-28",
    data: (_meta3.series?.dof_seu_2026?.data ?? [])
      .filter((d: any) => typeof d.balance_cad_bn === "number")
      .map((d: any) => ({
        date: `${d.fy.split("-")[0]}-04-01`,
        value: -d.balance_cad_bn,
      })),
  },
  secondary: {
    key: "pbo_efo_deficit_projection",
    label: "PBO EFO Sept '25",
    unit: "CAD billions",
    asOfISO: "2025-09-25",
    data: (_meta3.series?.pbo_efo_sept_2025?.data ?? [])
      .filter((d: any) => typeof d.balance_cad_bn === "number")
      .map((d: any) => ({
        date: `${d.fy.split("-")[0]}-04-01`,
        value: -d.balance_cad_bn,
      })),
  },
} : null;

// ---- Plate 4: Provincial net debt-to-GDP -----------------------------------
// Convention: Panel4ProvincialDebt expects 4 points in QC/ON/BC/AB order;
// value = percent (positive). Metadata already orders provinces this way.
const _meta4 = _panels["panel-4"]?.metadata;
const _provincesArr: any[] = _meta4?.provinces
  ? Object.values(_meta4.provinces)
  : [];
const panel4Data = _provincesArr.length >= 4 ? {
  panelNum: 4,
  primary: {
    key: "provincial_debt_to_gdp",
    label: "Provincial debt-to-GDP",
    unit: "%",
    asOfISO: "2026-03-18",
    data: _provincesArr.map((p: any) => ({
      date: `${p.iso}-2026`,
      value: typeof p.value_pct === "number" ? p.value_pct : 0,
    })),
  },
  secondary: null,
} : null;

// ---- Plate 5: Operating vs capital balance --------------------------------
// Convention: Panel5OperatingCapital expects NEGATIVE values (deficit
// stays negative); also rejects keys "oecd_capb" / "imf_capb" (old spec).
const _meta5 = _panels["panel-5"]?.metadata;
const panel5Data = _meta5 ? {
  panelNum: 5,
  primary: {
    key: "dof_budget_2025_total_deficit",
    label: "DoF total deficit",
    unit: "CAD billions",
    asOfISO: "2025-11-04",
    data: (_meta5.series?.budget_2025_total_deficit?.data ?? [])
      .filter((d: any) => typeof d.balance_cad_bn === "number")
      .map((d: any) => ({
        date: `${d.fy.split("-")[0]}-04-01`,
        value: d.balance_cad_bn,
      })),
  },
  secondary: {
    key: "pbo_reclassified_operating_deficit",
    label: "PBO reclassified operating",
    unit: "CAD billions",
    asOfISO: "2025-11-14",
    data: (_meta5.series?.pbo_reclassified_operating_deficit?.data ?? [])
      .filter((d: any) => typeof d.balance_cad_bn === "number")
      .map((d: any) => ({
        date: `${d.fy.split("-")[0]}-04-01`,
        value: d.balance_cad_bn,
      })),
  },
} : null;

const plates: Plate[] = [
  {
    id: "plate-1",
    number: "01",
    indicator: "Federal monthly + YTD balance",
    plateIndexLabel: "Federal trajectory",
    asOf: "February 28, 2026 (Fiscal Monitor)",
    title: "The YTD deficit tracks the same cadence as recent years, not a counter-cyclical lean.",
    interpretationHtml:
      "The deficit is on course to land near 2.1% of GDP for fiscal 2025-26, the trajectory the Spring Economic Update projects. " +
      "Eleven months in, the year-to-date balance sits at a $25.5 billion deficit, after a $5.7 billion February surplus pulled the cumulative line off its January trough. " +
      "Heavy autumn outflows and a strong tax-receipt month are the standard fiscal shape &mdash; not a stance leaning against the cycle.",
    callout: {
      value: "-$25.5 bn",
      unit: "Federal balance, fiscal YTD",
      delta: "11 months into FY 2025-26",
      direction: "neg",
    },
    source: "Department of Finance Fiscal Monitor.",
    chartKey: "fiscal-panel-1",
    data: panel1Data,
    citations: [
      { phrase: "2.1% of GDP", source: "card:dof_seu_2026_deficit_gdp_share", note: "DoF Spring Economic Update April 2026 projects federal deficit at 2.1% of GDP for FY2025-26." },
      { phrase: "$25.5 billion deficit", source: "pipeline:dof:dof_fiscal_ytd_balance", note: "Federal fiscal YTD balance, April 2025 through February 2026, -$25.5bn per Fiscal Monitor (Feb 28 2026 print)." },
      { phrase: "$5.7 billion February surplus", source: "pipeline:dof:dof_fiscal_monthly_balance", note: "February 2026 monthly federal budgetary balance, +$5.7bn per Fiscal Monitor." },
      { phrase: "January trough", source: "pipeline:dof:dof_fiscal_ytd_balance", note: "Federal YTD balance through January 2026, -$31.2bn per Fiscal Monitor." },
    ],
  },
  {
    id: "plate-2",
    number: "02",
    indicator: "Federal budgetary balance as % of GDP, FY1983-84 to FY2024-25 + SEU April 2026 projection",
    plateIndexLabel: "Stance trajectory",
    title: "The projected deficit narrows from 2.1% to 1.4% of GDP by FY2030-31.",
    interpretationHtml:
      "DoF pencils in a steady fade from 2.1% of GDP this year to 1.4% by FY2030-31 &mdash; restraint without a pivot to surplus. " +
      "The projected path stays inside the post-2008 deficit band but never crosses zero. " +
      "Against the COVID spike of nearly 15% of GDP, the closure is real; against the pre-pandemic 1.7% norm, the stated stance stays meaningfully looser.",
    source: "Department of Finance Canada, Fiscal Reference Tables 2025 (historical); DoF Spring Economic Update April 2026, Annex 1 Table A1.7 (projection).",
    chartKey: "fiscal-panel-2",
    data: panel2Data,
    citations: [
      { phrase: "2.1% of GDP this year", source: "card:dof_seu_2026_deficit_gdp_share", note: "DoF SEU April 2026 Annex 1 Table A1.7: FY2025-26 federal deficit = 2.1% of GDP." },
      { phrase: "1.4% by FY2030-31", source: "card:dof_federal_balance_pct_gdp_history", note: "DoF SEU April 2026 Annex 1 Table A1.7: FY2030-31 projected deficit = 1.4% of GDP. Verified by direct WebFetch 2026-05-25." },
      { phrase: "post-2008 deficit band", source: "card:dof_federal_balance_pct_gdp_history", note: "FRT 2025 historical: post-GFC era (FY2008-09 onward) federal balance ranges from -3.6% (GFC FY2009-10) to -0.0% (FY2015-16); excluding the COVID/recovery years, the band is 0% to -2%." },
      { phrase: "COVID spike of nearly 15% of GDP", source: "card:dof_federal_balance_pct_gdp_history", note: "FRT 2025: FY2020-21 federal balance = -14.8% of GDP (pandemic peak)." },
      { phrase: "pre-pandemic 1.7% norm", source: "card:dof_federal_balance_pct_gdp_history", note: "FRT 2025: FY2019-20 federal balance = -1.7% of GDP (last pre-pandemic year)." },
    ],
  },
  {
    id: "plate-3",
    number: "03",
    indicator: "PBO EFO Sept 2025 vs DoF SEU April 2026 deficit projection tracks",
    plateIndexLabel: "PBO vs DoF",
    title: "Two vintages of the federal deficit, converging more than they diverge.",
    interpretationHtml:
      "The Department of Finance projects a $66.9 billion deficit for fiscal 2025-26, declining to $53.2 billion by 2030-31; the Parliamentary Budget Officer's September 2025 outlook reads $68.5 billion in the same anchor year, settling near $60 billion through 2029-30. " +
      "The tracks differ less than the discourse suggests &mdash; assumption gaps, not policy disagreements, drive most of the wedge. " +
      "Where they part is on growth elasticities and the timing of revenue normalization.",
    source: "Department of Finance Spring Economic Update, April 2026; Parliamentary Budget Officer Economic and Fiscal Outlook, September 2025.",
    chartKey: "fiscal-panel-3",
    data: panel3Data,
    citations: [
      { phrase: "$66.9 billion deficit for fiscal 2025-26", source: "card:dof_seu_2026_deficit_track", note: "DoF SEU April 2026 FY2025-26 deficit projection: $66.9bn." },
      { phrase: "declining to $53.2 billion by 2030-31", source: "card:dof_seu_2026_deficit_track", note: "DoF SEU April 2026 FY2030-31 deficit projection: $53.2bn." },
      { phrase: "$68.5 billion in the same anchor year", source: "card:pbo_efo_sept_2025_deficit_track", note: "PBO EFO Sept 2025 anchor for FY2025-26 = $68.5bn deficit (2.2% of GDP)." },
      { phrase: "settling near $60 billion through 2029-30", source: "card:pbo_efo_sept_2025_deficit_track", note: "PBO EFO Sept 2025 own framing: medium-term deficit characterised as 'close to $60 billion' through 2029-30 (year-by-year table inside PDF; press release uses this band framing)." },
    ],
  },
  {
    id: "plate-4",
    number: "04",
    indicator: "Day-to-day operating balance, DoF SEU April 2026 projection FY2025-26 to FY2030-31",
    plateIndexLabel: "Operating balance",
    asOf: "April 28, 2026 (DoF SEU 2026 Annex 1 Table A1.5)",
    title: "Ottawa pencils in operating balance for FY2028-29.",
    interpretationHtml:
      "Under DoF's own definition, the day-to-day operating balance reaches surplus by FY2028-29 &mdash; the stated fiscal anchor met. " +
      "The track climbs from a $26.4 billion operating deficit this year to $0.9 billion in surplus by FY2028-29 and $6.1 billion by FY2030-31, a $32.5 billion swing over six years. " +
      "Whether the swing is real depends on the definitional fight over what counts as capital.",
    source: "Department of Finance Canada, Spring Economic Update April 2026, Annex 1 Table A1.5.",
    chartKey: "fiscal-panel-4",
    data: null,
    citations: [
      { phrase: "operating balance reaches surplus by FY2028-29", source: "card:dof_operating_balance_projection", note: "DoF SEU April 2026 Annex 1 Table A1.5: day-to-day operating balance = +$0.9bn in FY2028-29, the first positive year of the projection horizon." },
      { phrase: "stated fiscal anchor", source: "card:dof_operating_balance_projection", note: "SEU 2026 Annex 1 verbatim: 'from 2028-29 through to 2030-31, projected revenues are expected to more than offset day-to-day operating spending, meeting the government's fiscal anchor of balancing day-to-day operating spending with revenues.'" },
      { phrase: "$26.4 billion operating deficit this year", source: "card:dof_operating_balance_projection", note: "DoF SEU April 2026: FY2025-26 day-to-day operating balance = -$26.4bn." },
      { phrase: "$6.1 billion by FY2030-31", source: "card:dof_operating_balance_projection", note: "DoF SEU April 2026: FY2030-31 day-to-day operating balance = +$6.1bn (terminal surplus)." },
      { phrase: "$32.5 billion swing over six years", source: "card:dof_operating_balance_projection", note: "DoF SEU April 2026: ($6.1bn surplus FY2030-31) - (-$26.4bn deficit FY2025-26) = $32.5bn improvement." },
    ],
  },
  {
    id: "plate-5",
    number: "05",
    indicator: "Operating vs capital balance: DoF SEU Apr 2026 vs PBO Nov 2025 reclassification",
    plateIndexLabel: "Operating/capital",
    asOf: "November 14, 2025 (PBO Budget 2025 review)",
    title: "The PBO reclassifies $94 billion of spending the government calls capital.",
    interpretationHtml:
      "The government's split between operating and capital treats roughly $94 billion of spending over the six-year horizon as capital; the Parliamentary Budget Officer reclassifies it as operating under the international standard &mdash; about 30% of Ottawa's claimed capital pool. " +
      "Reclassified, the operating balance is materially worse than the headline &mdash; and that gap is what the government's fiscal anchor will ultimately be judged against. " +
      "The fight over what counts as capital is the fight over whether the stance is being measured honestly.",
    source: "Parliamentary Budget Officer operating/capital reclassification analysis, November 2025; Department of Finance Spring Economic Update, April 2026.",
    chartKey: "fiscal-panel-5",
    data: panel5Data,
    citations: [
      { phrase: "roughly $94 billion of spending", source: "card:pbo_operating_capital_reclassification_nov_2025", note: "PBO Budget 2025: Issues for Parliamentarians (RP-2526-017-S, Nov 14 2025): DoF claimed $311.5bn of capital over 2024-25 to 2029-30; PBO reclassified $217.3bn under IMF GFS 2014 standard; gap = $94bn / ~30%." },
      { phrase: "about 30% of DoF's claimed capital pool", source: "card:pbo_operating_capital_reclassification_nov_2025", note: "PBO Nov 14 2025: $94bn reclassified is approximately 30% of DoF's claimed $311.5bn capital total over the horizon." },
      { phrase: "international standard", source: "card:pbo_operating_capital_reclassification_nov_2025", note: "PBO applies international public-sector accounting standard for capital vs operating distinction, distinct from DoF's bifurcated-budget framework." },
    ],
  },
  {
    id: "plate-6",
    number: "06",
    indicator: "Federal debt as % of GDP, 1980–2031 (historical + SEU 2026 projection)",
    plateIndexLabel: "Debt-to-GDP",
    asOf: "FY2023-24 actual; projection to FY2030-31 (SEU April 2026)",
    title: "Federal debt holds above 40 per cent of GDP through the projection horizon.",
    interpretationHtml:
      "The federal debt-to-GDP ratio peaked at 66.6 per cent in FY1994–95; the Martin consolidation brought it to 28.2 per cent by FY2007–08. " +
      "The pandemic reversed that trajectory, pushing the ratio to 47.2 per cent in FY2019–20 before it retreated to 41.2 per cent by FY2023–24. " +
      "The Spring Economic Update projects a shallow peak of 41.9 per cent in FY2028–29, then a drift lower &mdash; declining but not converging toward pre-pandemic levels.",
    source: "Department of Finance Canada, Budget 2025 Annex 1 Chart A1.5 (historical, 1980–2024); DoF Spring Economic Update April 2026, Annex 1 Table A1.7 (projection, FY2024–25 to FY2030–31).",
    chartKey: "fiscal-panel-6",
    citations: [
      { phrase: "66.6 per cent in FY1994–95", source: "card:dof_federal_debt_to_gdp_trajectory", note: "Budget 2025 Annex 1 Chart A1.5: 1990s peak at 66.6% (year 1995 = FY1994-95)." },
      { phrase: "28.2 per cent by FY2007–08", source: "card:dof_federal_debt_to_gdp_trajectory", note: "Budget 2025 Annex 1 Chart A1.5: pre-GFC trough at 28.2% (year 2008 = FY2007-08)." },
      { phrase: "47.2 per cent in FY2019–20", source: "card:dof_federal_debt_to_gdp_trajectory", note: "Budget 2025 Annex 1 Chart A1.5: COVID-era peak at 47.2% (year 2020 = FY2019-20)." },
      { phrase: "41.2 per cent", source: "card:dof_federal_debt_to_gdp_trajectory", note: "Budget 2025 Annex 1 Chart A1.5 + Annual Financial Report 2025: FY2023-24 latest actual at 41.2%. AFR triangulation: accumulated deficit-to-GDP 41.2% at March 31 2025 (slightly different vintage frame)." },
      { phrase: "41.9 per cent in FY2028–29", source: "card:dof_federal_debt_to_gdp_trajectory", note: "DoF SEU April 2026 Annex 1 Table A1.7: peak projection 41.9% in FY2028-29 and FY2027-28." },
    ],
  },
];

const pageTitle = "Fiscal Policy";
const pageDescription =
  "Canada's fiscal policy stance: balance execution, deficit % GDP trajectory, PBO vs Finance projections, operating balance, reclassification, and debt-to-GDP.";

// Lede reads the same editorial blurb the auto-blurb pipeline writes for the
// splash tile (sections.ts -> section.blurb.body). Single source of truth: a
// release-day fan-out updates one field and both surfaces refresh.
const lede = section.blurb?.body ?? "";
---
<SectionLayout
  slug="fiscal"
  sectionIndex={5}
  sectionLabel="Fiscal (team review)"
  headlineQuestion={section.headlineQuestion}
  lede={lede}
  latestReleaseLabel={latestReleaseLabel}
  plates={plates}
  title={`Fiscal — Team Review Draft (not public)`}
  description={pageDescription}
  noindex={true}
/>
