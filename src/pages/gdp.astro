---
/*
 * GDP - Vignelli chartbook page.
 *
 * Six plates per editorial canon section 4.1, in EDR-fixed order:
 *   01 Headline real GDP
 *   02 Industry vs expenditure cross-check
 *   03 Contributions to quarterly growth
 *   04 Per-capita real GDP
 *   05 Output gap vs BoC potential
 *   06 Recession state (C.D. Howe BCC)
 *
 * Each plate is a ChartbookUnit: chart on the left, 2-4 sentence
 * interpretation on the right (vertical stack on mobile), callout strip
 * below, source line. The chart is a real chart (no sparkline tier),
 * dispatched via chartKey to a per-plate component from
 * src/components/charts/gdp/Panel*.astro.
 *
 * v1: interpretation prose is placeholder copy in publication voice
 * (Manrope 400 body-lg, ~360px column width). Writer fills via release-
 * day auto-draft + human rewrite.
 */

import SectionLayout from "../layouts/SectionLayout.astro";
import type { Plate } from "../layouts/SectionLayout.astro";
import { sections } from "../data/sections";

const section = sections.find((s) => s.slug === "gdp");
if (!section) {
  throw new Error("GDP section not found in src/data/sections.ts");
}

const plates: Plate[] = [
  {
    id: "plate-1",
    number: "01",
    indicator: "Headline real GDP, month-over-month",
    plateIndexLabel: "Headline GDP",
    asOf: "Mar 2026; released May 1, 2026",
    title: "Monthly GDP rose 0.2% in March, on consensus.",
    interpretationHtml:
      "Monthly GDP advanced <strong>+0.2%</strong> in March, the second consecutive monthly gain and in line with the Bloomberg consensus. " +
      "Goods-producing industries did the heavy lifting; services held steady. The year-over-year pace, near <strong>1.8%</strong>, " +
      "still sits below the Bank's estimate of trend, leaving the gap to potential open.",
    callout: {
      value: "+0.2%",
      unit: "month-over-month, March 2026",
      delta: "+0.1 pp vs Feb",
      direction: "pos",
    },
    source: "Statistics Canada Table 36-10-0434-01; consensus via Bloomberg.",
    chartKey: "gdp-panel-1",
  },
  {
    id: "plate-2",
    number: "02",
    indicator: "Industry vs expenditure cross-check",
    plateIndexLabel: "Industry vs expenditure",
    asOf: "Mar 2026 (industry) / Q1 2026 (expenditure)",
    title: "Industry and expenditure cuts agree on direction this quarter.",
    interpretation:
      "The two cuts agree in direction with a level gap of roughly 0.1 percentage point, well inside the typical reconciliation range. " +
      "No editorial divergence to call: industry and expenditure are telling the same story about Q1, even where the path of monthly prints differs.",
    source:
      "Statistics Canada Tables 36-10-0434-01 (industry) and 36-10-0104-01 (expenditure).",
    chartKey: "gdp-panel-2",
  },
  {
    id: "plate-3",
    number: "03",
    indicator: "Contributions to quarterly growth, Q1 2026",
    plateIndexLabel: "Contributions",
    asOf: "Q1 2026; released May 30, 2026",
    title: "Q1 growth led by consumption and exports; imports drag.",
    interpretationHtml:
      "Real GDP advanced <strong>+1.4% q/q SAAR</strong>, with consumption and exports each contributing roughly six tenths and imports subtracting four. " +
      "Inventories were the smallest of the six categories - a clean expansion profile rather than a stockbuild story. " +
      "Business-vs-residential investment split is deep-dive territory.",
    callout: {
      value: "+1.4%",
      unit: "quarterly, annualized, Q1 2026",
      delta: "+0.6 pp vs Q4 2025",
      direction: "pos",
    },
    source: "Statistics Canada Table 36-10-0104-01.",
    chartKey: "gdp-panel-3",
  },
  {
    id: "plate-4",
    number: "04",
    indicator: "Per-capita real GDP, year-over-year",
    plateIndexLabel: "Per-capita",
    asOf: "Q1 2026; released May 30, 2026",
    title:
      "Per-capita output contracted for the seventh consecutive quarter.",
    interpretationHtml:
      "Per-capita real GDP fell <strong>-1.0% y/y</strong>, the seventh consecutive quarterly contraction. " +
      "Aggregate growth keeps holding up; per-capita keeps drifting. The divergence is structural rather than cyclical - " +
      "population growth is doing the work the headline cannot.",
    callout: {
      value: "-1.0%",
      unit: "year-over-year, Q1 2026",
      delta: "7 consecutive quarters of contraction",
      direction: "neg",
    },
    source:
      "Statistics Canada Tables 36-10-0104-01 and 17-10-0009-01; per-capita calculation by Sibley Creek.",
    chartKey: "gdp-panel-4",
  },
  {
    id: "plate-5",
    number: "05",
    indicator: "Output gap vs BoC potential",
    plateIndexLabel: "Output gap",
    asOf: "Q1 2026; April MPR vintage",
    title: "Output sits 0.5% below the BoC's central potential estimate.",
    interpretationHtml:
      "The gap closed a touch to <strong>-0.5%</strong> in Q1, but more slowly than the April MPR projected. " +
      "Potential growth has been revised down twice this year; the closing pace is the result of a slower numerator " +
      "more than a faster denominator.",
    callout: {
      value: "-0.5%",
      unit: "Q1 2026, BoC central estimate",
      delta: "+0.2 pp vs Q4 2025",
      direction: "pos",
    },
    source:
      "BoC Valet INDINF_OUTGAPMPR_Q; Statistics Canada Table 36-10-0104-01.",
    chartKey: "gdp-panel-5",
  },
  {
    id: "plate-6",
    number: "06",
    indicator: "Recession state, C.D. Howe Business Cycle Council",
    plateIndexLabel: "Recession state",
    asOf: "Communique dated Mar 14, 2026",
    title: "Expansion continues since Q3 2020 per C.D. Howe BCC.",
    interpretation:
      "No reclassification since the BCC's most recent communique. The Council's three trough criteria - amplitude, duration, scope - " +
      "are all consistent with mature expansion. We do not redate independently.",
    source: "C.D. Howe Business Cycle Council communiques.",
    chartKey: "gdp-panel-6",
  },
];

const pageTitle = "GDP";
const pageDescription =
  "GDP chartbook: monthly and quarterly real GDP, contributions to growth, per-capita output, output gap, and recession state. " +
  "Six plates of chart-with-interpretation. Sources: Statistics Canada, Bank of Canada, C.D. Howe Business Cycle Council.";

const lede =
  "Six plates trace the state of Canadian real output: the monthly print, the quarterly cross-check, " +
  "the decomposition of growth, the per-capita cut, the gap to potential, and the BCC's recession state. " +
  "Each plate carries a chart and a short reading of what it means today.";
---
<SectionLayout
  slug="gdp"
  sectionIndex={1}
  sectionLabel="GDP"
  headlineQuestion={section.headlineQuestion}
  lede={lede}
  latestReleaseLabel="Monthly GDP by industry, Mar 2026 - released May 1, 2026"
  plates={plates}
  title={pageTitle}
  description={pageDescription}
/>
