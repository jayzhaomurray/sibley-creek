---
/*
 * GDP - Vignelli chartbook page.
 *
 * Six plates per editorial canon section 4.1, in EDR-fixed order:
 *   01 Headline real GDP
 *   02 Total vs per-capita GDP, indexed to 2019Q4 (population-padded read)
 *   03 Growth-rate cross-check (monthly m/m + quarterly Q/Q SAAR)
 *   04 Contributions to quarterly growth
 *   05 Output gap vs BoC potential
 *   06 Labour productivity, business sector
 *
 * NOTE 2026-05-11: Old P4 (per-capita Y/Y single line) replaced by the
 * total-vs-per-capita side-by-side chart, and promoted to slot 02. The
 * side-by-side is the thesis visual for /research/per-capita-output/ and
 * earns its placement immediately after headline GDP. Original P4 block
 * preserved below as a comment for user review.
 *
 * Each plate is a chart on the left, 2-4 sentence interpretation on the
 * right (vertical stack on mobile), callout strip below, source line.
 * Charts are dispatched via chartKey to a per-plate component from
 * src/components/charts/gdp/Panel*.astro.
 */

import SectionLayout from "../layouts/SectionLayout.astro";
import type { Plate } from "../layouts/SectionLayout.astro";
import { sections } from "../data/sections";
import panelDataFile from "../../data/site/panel_data/gdp.json";
import sectionsJson from "../../data/site/sections.json";
import { pickPanel } from "../components/charts/_shared/panelData";
import { deriveLatestReleaseLabel } from "../components/section/_shared/derivedLabels";

const section = sections.find((s) => s.slug === "gdp");
if (!section) {
  throw new Error("GDP section not found in src/data/sections.ts");
}

// Page-level "Latest release" stamp: editorial prefix + auto-derived date
// from the section's load-bearing print (sections.json). When the pipeline
// payload is unavailable the helper returns null and the SectionPageHeader
// flows the placeholder treatment.
const latestReleaseLabel = deriveLatestReleaseLabel(
  section.latestReleasePrefix ?? "",
  sectionsJson,
  "gdp",
);

// Pull each panel's pipeline-emitted data once at build time. Helper
// returns null when the entry is missing or has no primary series, which
// flows through to the Panel*.astro's "DATA NOT YET WIRED" path. No
// synthetic fallback anywhere.
const panel1Data = pickPanel(panelDataFile, 1);
const panel2Data = pickPanel(panelDataFile, 2);
const panel3Data = pickPanel(panelDataFile, 3);
const panel4Data = pickPanel(panelDataFile, 4);
const panel5Data = pickPanel(panelDataFile, 5);
const panel6Data = pickPanel(panelDataFile, 6);

// ORIGINAL Plate 04 (per-capita Y/Y single line) — preserved 2026-05-11
// for user review. Replaced by the total-vs-per-capita side-by-side chart,
// which has been promoted into slot 02. Delete this comment block once
// the user confirms the swap.
//
//   {
//     id: "plate-4",
//     number: "04",
//     indicator: "Per-capita real GDP, year-over-year",
//     plateIndexLabel: "Per-capita",
//     asOf: "2025Q4",
//     title: "Per-capita output is back in positive territory, barely.",
//     interpretationHtml:
//       "Per-capita real GDP rose 0.5% y/y in Q4 2025, down 0.1pp from the prior quarter. " +
//       "Aggregate GDP grew 0.7% over the same window; with population growth slowing as immigration moderates, the per-capita gap to the headline is narrower than it was through 2023 and 2024. " +
//       "Positive does not yet mean recovered: the level still trails the pre-2022 path.",
//     callout: { value: "+0.5%", unit: "Y/Y, 2025Q4", delta: "-0.1pp vs prior quarter", direction: "pos" },
//     source: "Statistics Canada Tables 36-10-0104-01 and 17-10-0009-01; per-capita calculation by Sibley Creek.",
//     chartKey: "gdp-panel-4",
//     data: panel4Data,
//   },

const plates: Plate[] = [
  {
    id: "plate-1",
    number: "01",
    indicator: "Headline real GDP, month-over-month",
    plateIndexLabel: "Headline GDP",
    asOf: "Feb 2026 (released Apr 30, 2026)",
    title: "Monthly GDP rose 0.2% in February, a second consecutive gain.",
    interpretationHtml:
      "Monthly real GDP advanced 0.2% in February, the second consecutive monthly gain after January's 0.1%. " +
      "The year-over-year pace sits at 1.0% &mdash; positive but still running below the Bank's estimate of trend, " +
      "consistent with an economy expanding without closing the slack opened earlier in the cycle.",
    callout: {
      value: "+0.2%",
      unitPrefix: "month-over-month",
      delta: "Y/Y +1.0%",
      direction: "pos",
    },
    source: "Statistics Canada Table 36-10-0434-01; consensus via Bloomberg.",
    chartKey: "gdp-panel-1",
    data: panel1Data,
  },
  {
    id: "plate-2",
    number: "02",
    indicator: "Total vs per-capita real GDP, indexed to 2019Q4",
    plateIndexLabel: "Population-padded",
    title: "Aggregate growth has run well ahead of per-capita output since 2019.",
    interpretationHtml:
      "Indexed to the eve of the pandemic, total real GDP sits roughly +11% above its 2019Q4 level; per-capita real GDP sits at +1%. " +
      "The gap between the two lines is the population contribution &mdash; the share of headline growth that has gone into adding people rather than into output per person. " +
      "Per-capita output has barely cleared the pre-pandemic level six years on, which is the central fact behind the deep dive on <a href=\"/research/per-capita-output/\">population-padded GDP</a>.",
    callout: {
      value: "+1%",
      unit: "per-capita real GDP, cumulative since 2019Q4",
      delta: "Total +11%",
      direction: "neutral",
    },
    source:
      "Statistics Canada Tables 36-10-0104-01 and 17-10-0009-01; per-capita and indexation by Sibley Creek.",
    chartKey: "gdp-panel-4",
    data: panel4Data,
  },
  {
    id: "plate-3",
    number: "03",
    indicator: "Growth-rate cross-check: monthly m/m and quarterly Q/Q SAAR",
    plateIndexLabel: "Growth rates",
    asOf: "Feb 2026 (m/m) / 2025Q4 (Q/Q SAAR)",
    title: "Monthly industry growth firmed in early 2026 even as the Q4 annualized read turned slightly negative.",
    interpretationHtml:
      "Industry-side GDP rose 0.2% m/m in February, the second consecutive monthly gain. The quarterly expenditure cut, on a Q/Q annualized basis, ran &minus;0.6% in Q4 2025 &mdash; the first negative quarter since 2023. " +
      "The cross-check is not a contradiction: monthly industry captures the early-2026 firming, while quarterly expenditure captures the softer close to 2025. Read them as adjacent windows on the same cycle, not competing signals.",
    callout: {
      value: "+0.2%",
      unitPrefix: "m/m industry",
      delta: "Q4 Q/Q SAAR -0.6%",
      direction: "pos",
    },
    source:
      "Statistics Canada Tables 36-10-0434-01 (monthly industry) and 36-10-0104-01 (quarterly expenditure). Growth rates derived in the chart wrapper.",
    chartKey: "gdp-panel-2",
    data: panel1Data,
  },
  {
    id: "plate-4",
    number: "04",
    indicator: "Contributions to quarterly growth",
    plateIndexLabel: "Contributions",
    title: "An inventory drawdown swamped a positive domestic profile in Q4.",
    interpretationHtml:
      "Real GDP contracted 0.6% q/q annualized in Q4 2025, but the composition is more constructive than the headline. " +
      "Consumption added 0.9pp, exports 1.8pp, government 0.7pp, and business investment 0.7pp &mdash; the entire shortfall came from inventories, which subtracted 4.2pp. " +
      "Stripping the inventory swing, final domestic demand and trade were both expansionary.",
    callout: {
      value: "-0.6%",
      unitPrefix: "q/q SAAR",
      delta: "Inventories -4.2pp",
      direction: "neg",
    },
    source: "Statistics Canada Table 36-10-0104-01.",
    chartKey: "gdp-panel-3",
    data: panel3Data,
  },
  {
    id: "plate-5",
    number: "05",
    indicator: "BoC MPR output gap",
    plateIndexLabel: "Output gap",
    asOf: "2025Q4; April 2026 MPR vintage",
    title: "Output gap widened to -1.0% in Q4 2025, doubling the Q3 shortfall.",
    interpretationHtml:
      "The BoC's measure of the output gap fell to -1.0% in Q4 2025 from -0.5% in Q3, the deepest reading since early 2021. " +
      "Measured output dipped on the quarter while potential continued to expand, so the shortfall reflects a demand-side slowdown rather than a supply-side hit. " +
      "Slack is opening, not closing &mdash; the disinflation case from the demand side is intact.",
    callout: {
      value: "-1.0%",
      unitPrefix: "% of potential",
      delta: "-0.5pp vs prior quarter",
      direction: "neg",
    },
    source:
      "Bank of Canada Monetary Policy Report, April 2026 (Valet INDINF_OUTGAPMPR_Q).",
    chartKey: "gdp-panel-5",
    data: panel5Data,
  },
  {
    id: "plate-6",
    number: "06",
    indicator: "Labour productivity, business sector",
    plateIndexLabel: "Productivity",
    title: "Productivity growth decelerated sharply into year-end.",
    interpretationHtml:
      "Business-sector labour productivity per hour rose 0.3% y/y in Q4 2025, down from 1.2% in Q3 and 2.1% at the end of 2024. " +
      "The recent run of positive prints had hinted at a turn; Q4 puts that back in question. " +
      "Canada's productivity level still trails the United States by a wide margin &mdash; the structural gap the Bank's speeches return to.",
    callout: {
      value: "+0.3%",
      unit: "Y/Y, business sector",
      delta: "-0.9pp vs Q3 2025",
      direction: "neg",
    },
    source:
      "Statistics Canada Table 36-10-0206-01 (vector v1409153); Y/Y derived in pipeline.build.derive_productivity_views.",
    chartKey: "gdp-panel-6",
    data: panel6Data,
  },
];

const pageTitle = "GDP";
const pageDescription =
  "Monthly and quarterly real GDP, contributions to growth, per-capita output, output gap, productivity.";

// Lede reads the same editorial blurb the auto-blurb pipeline writes for the
// splash tile (sections.ts -> section.blurb.body). Single source of truth: a
// release-day fan-out updates one field and both surfaces refresh.
const lede = section.blurb?.body ?? "";
---
<SectionLayout
  slug="gdp"
  sectionIndex={1}
  sectionLabel="GDP"
  headlineQuestion={section.headlineQuestion}
  lede={lede}
  latestReleaseLabel={latestReleaseLabel}
  plates={plates}
  title={pageTitle}
  description={pageDescription}
/>
