---
/*
 * /gdp/ - SEO continuity redirect to /output/.
 *
 * The section was renamed gdp -> output 2026-05-20. Old links from earlier
 * publication and search-engine indexing point at /gdp/; this page emits a
 * meta-refresh redirect plus a canonical pointing to /output/ so referrers
 * get the new URL and the search engine consolidates link equity onto the
 * new path.
 */
import { withBase } from "../lib/urls";
const target = withBase("/output/");
---
<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting to /output/ — Sibley Creek</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={target} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <style>
      body { font-family: system-ui, sans-serif; padding: 2rem; color: #000; }
      a { color: #D7263D; }
    </style>
  </head>
  <body>
    <p>This page has moved. Redirecting to <a href={target}>/output/</a>.</p>
  </body>
</html>
