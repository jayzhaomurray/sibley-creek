---
/*
 * GDP - Vignelli chartbook page.
 *
 * Six plates per chart-diagnosis 2026-05-12 rework + editorial-director
 * chart-order recommendation. The editorial arc is cyclical-first,
 * surface-to-under-the-hood industry, then output gap, then closes on
 * the per-capita deep-dive exit.
 *
 *   01 Headline real GDP - small-multiples m/m + Y/Y vs potential growth
 *   02 Contributions to quarterly growth - 4-bucket streamlined
 *      (final domestic demand, trade net, inventories, total overlay)
 *   03 Services vs goods Y/Y - surface industry split
 *   04 Manufacturing vs mining and oil, indexed to Dec 2019 - the
 *      under-the-hood split, 84-month compounded divergence; the
 *      regional shadow is ON/QC vs AB/SK
 *   05 BoC MPR output gap - cyclical synthesis, slack
 *      (methodology discussion pending; future Sibley nowcast extension
 *      to land here)
 *   06 Total vs per-capita real GDP, indexed to 2019Q4 - closes on the
 *      deepest structural arc; deep-dive exit ramp to
 *      /research/per-capita-output
 *
 * Cut from this page in the 2026-05-12 rework:
 *   - Growth-rate cross-check (was 03 pre-rework): redundant once 01
 *     carries m/m + Y/Y with proper geometry.
 *   - Productivity (was 06 pre-rework): structural story, not cyclical;
 *     idea parked in editorial/chart-diagnosis/ideas.md.
 */

import SectionLayout from "../layouts/SectionLayout.astro";
import type { Plate } from "../layouts/SectionLayout.astro";
import { sections } from "../data/sections";
import panelDataFile from "../../data/site/panel_data/gdp.json";
import sectionsJson from "../../data/site/sections.json";
import { pickPanel } from "../components/charts/_shared/panelData";
import { deriveLatestReleaseLabel } from "../components/section/_shared/derivedLabels";

const section = sections.find((s) => s.slug === "gdp");
if (!section) {
  throw new Error("GDP section not found in src/data/sections.ts");
}

const latestReleaseLabel = deriveLatestReleaseLabel(
  section.latestReleasePrefix ?? "",
  sectionsJson,
  "gdp",
);

const panel1Data = pickPanel(panelDataFile, 1);
const panel2Data = pickPanel(panelDataFile, 2);
const panel3Data = pickPanel(panelDataFile, 3);
const panel4Data = pickPanel(panelDataFile, 4);
const panel5Data = pickPanel(panelDataFile, 5);
const panel6Data = pickPanel(panelDataFile, 6);

const plates: Plate[] = [
  {
    id: "plate-1",
    number: "01",
    indicator: "Headline real GDP, m/m and Y/Y",
    plateIndexLabel: "Headline GDP",
    asOf: "Feb 2026 (released Apr 30, 2026)",
    title: "Canada's economy is growing, albeit weakly.",
    interpretationHtml:
      "Monthly real GDP advanced 0.2% in February, the fourth consecutive monthly gain since October's 0.3% decline. " +
      "The year-over-year pace sits at 1.0% &mdash; positive but still running below the Bank's near-term estimate of potential growth around 1.7%, " +
      "consistent with an economy expanding without closing the slack opened earlier in the cycle.",
    callout: {
      value: "+0.2%",
      unitPrefix: "month-over-month",
      delta: "Y/Y +1.0%",
      direction: "pos",
    },
    source: "Statistics Canada Table 36-10-0434-01; potential growth reference from BoC April 2026 Monetary Policy Report.",
    chartKey: "gdp-panel-1",
    data: panel1Data,
  },
  {
    id: "plate-2",
    number: "02",
    indicator: "Contributions to quarterly growth, by bucket",
    plateIndexLabel: "Contributions",
    title: "An inventory drawdown swamped a positive domestic profile in Q4.",
    interpretationHtml:
      "Real GDP contracted 0.6% q/q annualized in Q4 2025, but the composition is more constructive than the headline. " +
      "Final domestic demand &mdash; consumption, government, and business investment combined &mdash; contributed +2.3pp; trade net contributed +1.5pp. " +
      "The entire shortfall came from inventories, which subtracted 4.2pp. " +
      "Because inventory swings tend to mean-revert within a few quarters and reflect production timing rather than demand, stripping them out leaves the rest of the economy expanding at roughly 3.8pp annualized.",
    callout: {
      value: "-0.6%",
      unitPrefix: "q/q SAAR",
      delta: "Inventories -4.2pp",
      direction: "neg",
    },
    source: "Statistics Canada Table 36-10-0104-01 (quarterly expenditure-side contributions to growth).",
    chartKey: "gdp-panel-3",
    data: panel3Data,
  },
  {
    id: "plate-3",
    number: "03",
    indicator: "Real GDP by industry, services vs goods, Y/Y",
    plateIndexLabel: "Industry split",
    title: "On the surface, goods and services tell the same growth story.",
    interpretationHtml:
      "Services real GDP rose 1.0% Y/Y in February &mdash; the steady ~1% pace the sector has held all cycle. Goods real GDP rose 0.8% over the same window, putting the two halves of the economy in essentially the same range at the aggregate level. " +
      "The composition story is one level deeper. The next plate splits goods into manufacturing and mining and oil &mdash; the two are pulling in opposite directions, and the goods aggregate cancels them out.",
    callout: {
      value: "+1.0%",
      unitPrefix: "services, Y/Y",
      delta: "Goods +0.8%",
      direction: "pos",
    },
    source: "Statistics Canada Table 36-10-0434-01 (monthly real GDP by industry).",
    chartKey: "gdp-panel-2",
    data: panel2Data,
  },
  {
    id: "plate-4",
    number: "04",
    indicator: "Real GDP by industry, manufacturing vs mining and oil, indexed to Dec 2019",
    plateIndexLabel: "Cyclical drivers",
    title: "Under the hood, Canada's physical economy is on two tracks.",
    interpretationHtml:
      "Indexed to the eve of the pandemic, manufacturing real GDP sits 6% below its December 2019 level; mining and oil and gas extraction sits 13% above. The divergence has been uninterrupted since 2022 &mdash; mining and oil has grown every year, manufacturing has flattened or contracted every year. " +
      "The split maps onto geography: the manufacturing belt of Ontario and Quebec against the resource economies of Alberta and Saskatchewan.",
    callout: {
      value: "-6%",
      unitPrefix: "manufacturing, since Dec 2019",
      delta: "Mining and oil +13%",
      direction: "neg",
    },
    source: "Statistics Canada Table 36-10-0434-01 (monthly real GDP by industry).",
    chartKey: "gdp-panel-6",
    data: panel6Data,
  },
  {
    id: "plate-5",
    number: "05",
    indicator: "BoC MPR output gap",
    plateIndexLabel: "Output gap",
    asOf: "2025Q4; April 2026 MPR vintage",
    title: "Output gap widened to -1.0% in Q4 2025, doubling the Q3 shortfall.",
    interpretationHtml:
      "The BoC's measure of the output gap fell to -1.0% in Q4 2025 from -0.5% in Q3, the deepest reading since early 2021. " +
      "Measured output dipped on the quarter while potential continued to expand, so the shortfall reflects a demand-side slowdown rather than a supply-side hit. " +
      "Slack is opening, not closing &mdash; the disinflation case from the demand side is intact.",
    callout: {
      value: "-1.0%",
      unitPrefix: "% of potential",
      delta: "-0.5pp vs prior quarter",
      direction: "neg",
    },
    source:
      "Bank of Canada Monetary Policy Report, April 2026 (Valet INDINF_OUTGAPMPR_Q).",
    chartKey: "gdp-panel-5",
    data: panel5Data,
  },
  {
    id: "plate-6",
    number: "06",
    indicator: "Total vs per-capita real GDP, indexed to 2019Q4",
    plateIndexLabel: "Population-padded",
    title: "Output per head has fallen well short of overall growth.",
    interpretationHtml:
      "Indexed to the eve of the pandemic, total real GDP sits roughly +11% above its 2019Q4 level; per-capita real GDP sits at +1%. " +
      "The gap between the two lines is the population contribution &mdash; the share of headline growth that has gone into adding people rather than into output per person. " +
      "Per-capita output has barely cleared the pre-pandemic level six years on, which is the central fact behind the deep dive on <a href=\"/research/per-capita-output/\">population-padded GDP</a>.",
    callout: {
      value: "+1%",
      unit: "per-capita real GDP, cumulative since 2019Q4",
      delta: "Total +11%",
      direction: "neutral",
    },
    source:
      "Statistics Canada Tables 36-10-0104-01 and 17-10-0009-01; per-capita and indexation by Sibley Creek.",
    chartKey: "gdp-panel-4",
    data: panel4Data,
  },
];

const pageTitle = "GDP";
const pageDescription =
  "Monthly and quarterly real GDP, contributions to growth, industry splits, output gap, per-capita output.";

const lede = section.blurb?.body ?? "";
---
<SectionLayout
  slug="gdp"
  sectionIndex={1}
  sectionLabel="GDP"
  headlineQuestion={section.headlineQuestion}
  lede={lede}
  latestReleaseLabel={latestReleaseLabel}
  plates={plates}
  title={pageTitle}
  description={pageDescription}
/>
