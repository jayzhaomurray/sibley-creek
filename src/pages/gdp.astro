---
/*
 * GDP - Vignelli chartbook page.
 *
 * Six plates per editorial canon section 4.1, in EDR-fixed order:
 *   01 Headline real GDP
 *   02 Industry vs expenditure cross-check
 *   03 Contributions to quarterly growth
 *   04 Per-capita real GDP
 *   05 Output gap vs BoC potential
 *   06 Labour productivity, business sector
 *
 * Each plate is a chart on the left, 2-4 sentence interpretation on the
 * right (vertical stack on mobile), callout strip below, source line.
 * Charts are dispatched via chartKey to a per-plate component from
 * src/components/charts/gdp/Panel*.astro.
 */

import SectionLayout from "../layouts/SectionLayout.astro";
import type { Plate } from "../layouts/SectionLayout.astro";
import { sections } from "../data/sections";
import panelDataFile from "../../data/site/panel_data/gdp.json";
import { pickPanel } from "../components/charts/_shared/panelData";

const section = sections.find((s) => s.slug === "gdp");
if (!section) {
  throw new Error("GDP section not found in src/data/sections.ts");
}

// Pull each panel's pipeline-emitted data once at build time. Helper
// returns null when the entry is missing or has no primary series, which
// flows through to the Panel*.astro's "DATA NOT YET WIRED" path. No
// synthetic fallback anywhere.
const panel1Data = pickPanel(panelDataFile, 1);
const panel2Data = pickPanel(panelDataFile, 2);
const panel3Data = pickPanel(panelDataFile, 3);
const panel4Data = pickPanel(panelDataFile, 4);
const panel5Data = pickPanel(panelDataFile, 5);
const panel6Data = pickPanel(panelDataFile, 6);

const plates: Plate[] = [
  {
    id: "plate-1",
    number: "01",
    indicator: "Headline real GDP, month-over-month",
    plateIndexLabel: "Headline GDP",
    asOf: "Feb 2026 (released Apr 30, 2026)",
    title: "Monthly GDP rose 0.2% in February, a second consecutive gain.",
    interpretationHtml:
      "Monthly real GDP advanced <strong>0.2%</strong> in February, the second consecutive monthly gain after January's 0.1%. " +
      "The year-over-year pace sits at <strong>1.0%</strong> &mdash; positive but still running below the Bank's estimate of trend, " +
      "consistent with an economy expanding without closing the slack opened earlier in the cycle.",
    callout: {
      value: "+0.2%",
      unit: "month-over-month, Feb 2026",
      delta: "Y/Y +1.0%",
      direction: "pos",
    },
    source: "Statistics Canada Table 36-10-0434-01; consensus via Bloomberg.",
    chartKey: "gdp-panel-1",
    data: panel1Data,
  },
  {
    id: "plate-2",
    number: "02",
    indicator: "Industry vs expenditure cross-check",
    plateIndexLabel: "Industry vs expenditure",
    asOf: "Feb 2026 (industry) / 2025Q4 (expenditure)",
    title: "Monthly industry is climbing; the quarterly cut is flat.",
    interpretation:
      "Industry-side monthly GDP has risen for two months into February, putting the Q1 2026 monthly trajectory above the Q4 2025 quarterly level. Expenditure-side GDP slipped 0.2% from Q3 to Q4 2025, the first quarterly decline of the year. The two cuts are not in conflict: the industry path is what is firming now, while the expenditure print captures a softer end to 2025.",
    source:
      "Statistics Canada Tables 36-10-0434-01 (industry) and 36-10-0104-01 (expenditure).",
    chartKey: "gdp-panel-2",
    data: panel2Data,
  },
  {
    id: "plate-3",
    number: "03",
    indicator: "Contributions to quarterly growth",
    plateIndexLabel: "Contributions",
    asOf: "2025Q4",
    title: "An inventory drawdown swamped a positive domestic profile in Q4.",
    interpretationHtml:
      "Real GDP contracted <strong>0.6% q/q SAAR</strong> in Q4 2025, but the composition is more constructive than the headline. " +
      "Consumption added 0.9pp, exports 1.8pp, government 0.7pp, and business investment 0.7pp &mdash; the entire shortfall came from inventories, which subtracted <strong>4.2pp</strong>. " +
      "Stripping the inventory swing, final domestic demand and trade were both expansionary.",
    callout: {
      value: "-0.6%",
      unit: "q/q SAAR, 2025Q4",
      delta: "Inventories -4.2pp",
      direction: "neg",
    },
    source: "Statistics Canada Table 36-10-0104-01.",
    chartKey: "gdp-panel-3",
    data: panel3Data,
  },
  {
    id: "plate-4",
    number: "04",
    indicator: "Per-capita real GDP, year-over-year",
    plateIndexLabel: "Per-capita",
    asOf: "2025Q4",
    title: "Per-capita output is back in positive territory, barely.",
    interpretationHtml:
      "Per-capita real GDP rose <strong>0.5% y/y</strong> in Q4 2025, down 0.1pp from the prior quarter. " +
      "Aggregate GDP grew 0.7% over the same window; with population growth slowing as immigration moderates, the per-capita gap to the headline is narrower than it was through 2023 and 2024. " +
      "Positive does not yet mean recovered: the level still trails the pre-2022 path.",
    callout: {
      value: "+0.5%",
      unit: "Y/Y, 2025Q4",
      delta: "-0.1pp vs prior quarter",
      direction: "pos",
    },
    source:
      "Statistics Canada Tables 36-10-0104-01 and 17-10-0009-01; per-capita calculation by Sibley Creek.",
    chartKey: "gdp-panel-4",
    data: panel4Data,
  },
  {
    id: "plate-5",
    number: "05",
    indicator: "Output gap vs BoC potential",
    plateIndexLabel: "Output gap",
    asOf: "2025Q4; latest MPR vintage",
    title: "Output sits 1.0% below the Bank's central potential estimate.",
    interpretationHtml:
      "The output gap widened to <strong>-1.0%</strong> in Q4 2025 from -0.5% in Q3, the largest negative reading since early 2021. " +
      "The widening reflects the Q4 expenditure-side contraction; potential continued to grow while measured output dipped. " +
      "Slack is opening, not closing &mdash; the disinflation case from the demand side is intact.",
    callout: {
      value: "-1.0%",
      unit: "% of potential, 2025Q4",
      delta: "-0.5pp vs prior quarter",
      direction: "neg",
    },
    source:
      "BoC Valet INDINF_OUTGAPMPR_Q; Statistics Canada Table 36-10-0104-01.",
    chartKey: "gdp-panel-5",
    data: panel5Data,
  },
  {
    id: "plate-6",
    number: "06",
    indicator: "Labour productivity, business sector",
    plateIndexLabel: "Productivity",
    asOf: "2025Q4",
    title: "Productivity growth decelerated sharply into year-end.",
    interpretationHtml:
      "Business-sector labour productivity per hour rose <strong>0.3% y/y</strong> in Q4 2025, down from 1.2% in Q3 and 2.1% at the end of 2024. " +
      "The recent run of positive prints had hinted at a turn; Q4 puts that back in question. " +
      "Canada's productivity level still trails the United States by a wide margin &mdash; the structural gap the Bank's speeches return to.",
    callout: {
      value: "+0.3%",
      unit: "Y/Y, business sector",
      delta: "-0.9pp vs Q3 2025",
      direction: "neg",
    },
    source:
      "Statistics Canada Table 36-10-0206-01 (vector v1409153); Y/Y derived in pipeline.build.derive_productivity_views.",
    chartKey: "gdp-panel-6",
    data: panel6Data,
  },
];

const pageTitle = "GDP";
const pageDescription =
  "GDP chartbook: monthly and quarterly real GDP, contributions to growth, per-capita output, output gap, and labour productivity. " +
  "Sources: Statistics Canada, Bank of Canada.";

const lede =
  "Canadian real output through the monthly print and the quarterly cross-check, " +
  "the decomposition of growth, the per-capita cut, and the gap to potential.";
---
<SectionLayout
  slug="gdp"
  sectionIndex={1}
  sectionLabel="GDP"
  headlineQuestion={section.headlineQuestion}
  lede={lede}
  latestReleaseLabel="Monthly GDP by industry, Feb 2026"
  plates={plates}
  title={pageTitle}
  description={pageDescription}
/>
