---
/*
 * /subscribe — dedicated signup page.
 *
 * Destination for both the v2 footer "Subscribe" link and the eventual
 * persistent masthead Subscribe button. Focused signup, no other content
 * competing for attention. Mirrors the modal pitch but lives at a real
 * URL so it can be linked from anywhere.
 *
 * DRAFT v0. When the paid product launches, this page evolves into a
 * tier-selection page (Free / Standard / Anchor) with pricing.
 *
 * Email capture (interim): the form POSTs to formsubmit.co, which
 * forwards each submission to jay@sibleycreek.ca as an email.
 * No backend, no Kit/Beehiiv account yet. Using the raw-email AJAX
 * endpoint until Jay clicks the activation link in the first formsubmit
 * delivery to that address. After activation, swap the action URL to the
 * secure hash from the formsubmit dashboard.
 *
 * TO MIGRATE to real newsletter infra (Kit, Beehiiv, Mailchimp, etc.):
 *   1. Set up the form in the service's admin
 *   2. Replace the formsubmit.co action below with the service's action
 *   3. Adjust the input name= attribute if the service expects "email_address"
 *      or similar instead of "email"
 */

import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/sections";

const pageDesc =
  "Subscribe to Sibley Creek's independent Canadian macroeconomic research.";
---
<BaseLayout
  title={`Subscribe — ${site.name}`}
  description={pageDesc}
  pageClass="subscribe-page"
  showMastheadRail={true}
>
  <article class="sub">
    <header class="sub__header">
      <h1 class="sub__title">Subscribe.</h1>
    </header>

    <section class="sub__intro">
      <p>
        Get Sibley Creek's research in your inbox. Independent Canadian macroeconomic analysis from a team that combines journalism, data discipline, and source-driven reporting.
      </p>
      <p>
        We're building toward a paid subscription product. For now, the list is free to join — we'll keep you in the loop on what we publish, and you'll have first access when the paid tiers launch.
      </p>
    </section>

    <section class="sub__form-section">
      <form
        class="sub__form"
        action="https://formsubmit.co/ajax/jay@sibleycreek.ca"
        method="POST"
        data-formsubmit-ajax
        data-success-msg="Subscribed. Thanks — first issue lands when it lands."
      >
        <input type="hidden" name="_subject" value="Sibley subscriber (subscribe page)" />
        <input type="hidden" name="source" value="subscribe_page" />
        <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />

        <div class="sub__field">
          <label class="sub__label" for="subscribe-email">Email address</label>
          <input
            type="email"
            id="subscribe-email"
            name="email"
            placeholder="you@example.com"
            required
            class="sub__input"
            autocomplete="email"
          />
        </div>

        <div class="sub__field">
          <label class="sub__label" for="subscribe-name">
            Name <span class="sub__label-aside">(optional)</span>
          </label>
          <input
            type="text"
            id="subscribe-name"
            name="name"
            placeholder="Your name"
            class="sub__input"
            autocomplete="name"
          />
        </div>

        <div class="sub__field">
          <label class="sub__label" for="subscribe-org">
            Organization <span class="sub__label-aside">(optional)</span>
          </label>
          <input
            type="text"
            id="subscribe-org"
            name="organization"
            placeholder="Your organization"
            class="sub__input"
            autocomplete="organization"
          />
        </div>

        <div class="sub__field">
          <label class="sub__label" for="subscribe-role">
            Role <span class="sub__label-aside">(optional)</span>
          </label>
          <input
            type="text"
            id="subscribe-role"
            name="role"
            placeholder="Your role"
            class="sub__input"
          />
        </div>

        <div class="sub__field sub__field--checkbox">
          <label class="sub__checkbox-label" for="subscribe-advisory">
            <input
              type="checkbox"
              id="subscribe-advisory"
              name="advisory_interest"
              value="yes"
              class="sub__checkbox"
            />
            I'm also interested in Sibley's advisory services
          </label>
        </div>

        <button type="submit" class="sub__submit">Subscribe</button>
      </form>
    </section>

    <section class="sub__founding">
      <h2 class="sub__section-title">Founding subscribers</h2>
      <p>
        When the paid product launches, the first cohort of paying subscribers — the Anchors — will receive a Sibley Creek hat or mug (your choice), lifetime founders pricing locked in, and their name on a permanent founding-supporter list.
      </p>
      <p>
        You don't need to do anything now to qualify. Just be on the list when the paid tiers open.
      </p>
    </section>
  </article>

  <style>
    .sub {
      max-width: 640px;
      margin: 0 auto;
      padding: 32px 24px 64px 24px;
    }
    .sub__header {
      border-bottom: 1px solid var(--ink);
      padding-bottom: 24px;
      margin-bottom: 32px;
    }
    .sub__eyebrow {
      font-family: var(--font-sans);
      font-size: 13px;
      font-weight: var(--fw-semibold);
      line-height: 1;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      margin: 0 0 12px 0;
      color: var(--ink);
      opacity: 0.7;
    }
    .sub__title {
      font-family: var(--font-sans);
      font-size: 42px;
      font-weight: var(--fw-semibold);
      line-height: 1.1;
      margin: 0;
      color: var(--ink);
    }

    .sub__intro {
      margin-bottom: 32px;
    }
    .sub__intro p {
      font-family: var(--font-sans);
      font-size: 18px;
      line-height: 1.55;
      color: var(--ink);
      margin: 0 0 16px 0;
    }

    .sub__form-section {
      margin-bottom: 40px;
    }
    .sub__form {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }
    .sub__field {
      display: flex;
      flex-direction: column;
      gap: 7px;
    }
    .sub__label {
      font-family: var(--font-sans);
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--ink);
    }
    .sub__label-aside {
      font-weight: 400;
      letter-spacing: 0.06em;
      text-transform: none;
      opacity: 0.55;
      margin-left: 6px;
    }
    .sub__field--checkbox {
      gap: 0;
    }
    .sub__checkbox-label {
      font-family: var(--font-sans);
      font-size: 15px;
      font-weight: 400;
      line-height: 1.4;
      color: var(--ink);
      display: flex;
      align-items: flex-start;
      gap: 10px;
      cursor: pointer;
    }
    .sub__checkbox {
      flex: 0 0 auto;
      width: 16px;
      height: 16px;
      margin-top: 2px;
      accent-color: var(--ink);
      cursor: pointer;
    }
    .sub__input {
      padding: 12px 14px;
      border: 1px solid var(--ink);
      font-family: var(--font-sans);
      font-size: 15px;
      background-color: var(--paper);
      color: var(--ink);
      width: 100%;
    }
    .sub__input:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 1px;
    }
    .sub__submit {
      align-self: flex-start;
      padding: 14px 26px;
      background-color: var(--ink);
      color: var(--paper);
      border: 1px solid var(--ink);
      font-family: var(--font-sans);
      font-size: 12px;
      font-weight: var(--fw-semibold);
      letter-spacing: 0.18em;
      text-transform: uppercase;
      cursor: pointer;
      white-space: nowrap;
      transition: background 80ms linear, color 80ms linear;
    }
    .sub__submit:hover {
      background-color: var(--paper);
      color: var(--ink);
    }
    .sub__submit:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }

    .sub__section-title {
      font-family: var(--font-sans);
      font-size: 14px;
      font-weight: var(--fw-semibold);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      margin: 0 0 16px 0;
      color: var(--ink);
      padding-bottom: 8px;
      border-bottom: 1px solid var(--ink);
    }

    .sub__founding p {
      font-family: var(--font-sans);
      font-weight: 400;
      font-size: 18px;
      line-height: 1.55;
      color: var(--ink);
      margin: 0 0 16px 0;
    }

    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  </style>
</BaseLayout>
