---
/*
 * /work-with-us — retainer / advisory engagements landing page.
 *
 * DRAFT v0. Iterate freely. The /v2 splash footer links here, so this page
 * needs to exist as a real destination, but the copy and structure below
 * are placeholders and should be refined when Jay has more clarity on:
 *   - target client segments (post customer-discovery week)
 *   - example engagements (after first retainers land)
 *   - contact form mechanics (currently a mailto link; can upgrade)
 *
 * Pricing is deliberately NOT shown. "Custom-quoted" framing per the
 * Capital Economics model. Pricing happens in conversation.
 */

import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/sections";

const pageDesc =
  "Sibley Creek offers institutional macroeconomic research and advisory " +
  "engagements scoped to specific client needs. Get in touch.";
---
<BaseLayout
  title={`Work with us — ${site.name}`}
  description={pageDesc}
  pageClass="work-with-us-page"
  showMastheadRail={true}
>
  <article class="wwu">
    <header class="wwu__header">
      <h1 class="wwu__title">Work with us.</h1>
    </header>

    <section class="wwu__intro">
      <p>
        Sibley Creek works with select institutional clients on bespoke macroeconomic research and advisory engagements. We do the work that a firm would want from an internal economist — monthly briefings, ad-hoc analysis on demand, board-level presentations, custom research — without the cost of a full-time hire.
      </p>
      <p>
        Engagements are scoped to the client's specific situation: what you need to understand, how often, in what format, and for which decisions. Pricing is quoted on request based on that scope.
      </p>
    </section>

    <section class="wwu__what-we-do">
      <h2 class="wwu__section-title">What we do</h2>
      <ul class="wwu__list">
        <li>Monthly written outlooks tailored to the client's interests</li>
        <li>Pre-event briefings ahead of major Canadian economic data releases and Bank of Canada policy announcements</li>
        <li>Ad-hoc Q&amp;A on macroeconomic questions affecting the client's business</li>
        <li>Bespoke research projects: scenario modelling, sector analysis, regional deep-dives, custom forecasting</li>
        <li>Board and executive presentations</li>
        <li>White papers and public-facing research authored on behalf of the client</li>
        <li>Training sessions for internal teams</li>
      </ul>
    </section>

    <section class="wwu__methodology">
      <h2 class="wwu__section-title">How we work</h2>
      <p>
        Sibley Creek's research methodology combines disciplined data analysis with ground-truth reporting. We start with the data: simple statistics, clear visualizations, and the questions the data raises. Then we triangulate — talking to the people closest to the process being studied, not just the conventional aggregate experts. The output is a thoughtful, well-researched, fact-checked, opinionated, and pleasant-to-read answer to the client's specific question.
      </p>
      <p>
        Every piece of reader-facing work passes through three review gates before delivery: fact-check, style polish, and surface fit. The team operates to a standard, not a deadline.
      </p>
    </section>

    <section class="wwu__contact">
      <h2 class="wwu__section-title">Get in touch</h2>
      <p>
        For inquiries about advisory engagements, please email Jay Zhao-Murray, Chief Economist:
      </p>
      <p class="wwu__contact-email">
        <a href="mailto:jay@sibleycreek.ca">jay@sibleycreek.ca</a>
      </p>
      <p class="wwu__contact-note">
        We respond to inquiries within two business days. Initial conversations are exploratory and at no cost.
      </p>
    </section>
  </article>

  <style>
    .wwu {
      max-width: 720px;
      margin: 0 auto;
      padding: 32px 24px 64px 24px;
    }
    .wwu__header {
      border-bottom: 1px solid var(--ink);
      padding-bottom: 24px;
      margin-bottom: 32px;
    }
    .wwu__eyebrow {
      font-family: var(--font-sans);
      font-size: 13px;
      font-weight: var(--fw-semibold);
      line-height: 1;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      margin: 0 0 12px 0;
      color: var(--ink);
      opacity: 0.7;
    }
    .wwu__title {
      font-family: var(--font-sans);
      font-size: 42px;
      font-weight: var(--fw-semibold);
      line-height: 1.1;
      margin: 0;
      color: var(--ink);
    }

    .wwu__intro {
      margin-bottom: 40px;
    }
    .wwu__intro p {
      font-family: var(--font-sans);
      font-size: 18px;
      line-height: 1.55;
      color: var(--ink);
      margin: 0 0 16px 0;
    }

    .wwu__section-title {
      font-family: var(--font-sans);
      font-size: 14px;
      font-weight: var(--fw-semibold);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      margin: 0 0 16px 0;
      color: var(--ink);
      padding-bottom: 8px;
      border-bottom: 1px solid var(--ink);
    }

    .wwu__what-we-do,
    .wwu__methodology,
    .wwu__contact {
      margin-bottom: 40px;
    }

    .wwu__list {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .wwu__list li {
      font-family: var(--font-sans);
      font-size: 16px;
      line-height: 1.5;
      padding: 8px 0;
      border-bottom: 1px solid var(--ink);
      border-bottom-color: rgba(21, 23, 26, 0.15);
      color: var(--ink);
    }
    .wwu__list li:last-child {
      border-bottom: none;
    }

    .wwu__methodology p,
    .wwu__contact p {
      font-family: var(--font-sans);
      font-size: 16px;
      line-height: 1.55;
      color: var(--ink);
      margin: 0 0 14px 0;
    }

    .wwu__contact-email {
      font-family: var(--font-sans);
      font-size: 18px;
      font-weight: var(--fw-semibold);
      margin: 16px 0 !important;
    }
    .wwu__contact-email a {
      color: var(--accent);
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 3px;
    }
    .wwu__contact-email a:hover {
      color: var(--ink);
    }
    .wwu__contact-note {
      font-size: 14px !important;
      opacity: 0.7;
    }
  </style>
</BaseLayout>
