---
/*
 * /work-with-us/ — SEO continuity redirect to /advisory/.
 *
 * Page renamed 2026-05-21. Old route stays as a meta-refresh redirect so
 * any earlier inbound links keep landing on the right destination.
 */
import { withBase } from "../lib/urls";
const target = withBase("/advisory/");
---
<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting to /advisory/ — Sibley Creek</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={target} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <style>
      body { font-family: system-ui, sans-serif; padding: 2rem; color: #000; }
      a { color: #D7263D; }
    </style>
  </head>
  <body>
    <p>This page has moved. Redirecting to <a href={target}>/advisory/</a>.</p>
  </body>
</html>
