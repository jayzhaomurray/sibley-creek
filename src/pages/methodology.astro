---
/*
 * /methodology/ - institutional Methodology page.
 *
 * Source content: editorial/drafts/methodology_page.md (style-editor pass
 * complete, TK-free, ~590 words across four H2 sections). The body is
 * rendered inline as HTML rather than routed through Astro's markdown loader
 * for the same reason as /about/: a single page with no per-edit churn does
 * not need the indirection. The draft remains the source of truth.
 *
 * Visual register: Vignelli, mirroring /about/. Shared `.static` +
 * `.markdown-body` surface (defined inline below; identical to /about/ so the
 * two pages render as a matched pair). H2 sections carry the canonical
 * 1px hairline underline.
 */

import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/sections";

const pageTitle = "Methodology";
const pageDesc =
  "Where the data come from, how often they update, and how revisions " +
  "move through.";
---
<BaseLayout title={pageTitle} description={pageDesc} pageClass="static-page">
  <article class="static" aria-labelledby="static-h">
    <header class="static__header">
      <p class="static__kicker">
        <span class="static__kicker-tok">{site.name}</span>
        <span class="static__kicker-sep" aria-hidden="true">|</span>
        <span class="static__kicker-tok static__kicker-tok--name">
          Methodology
        </span>
      </p>

      <div class="static__band">
        <h1 id="static-h" class="static__h">Methodology</h1>
      </div>

      <hr class="static__rule" aria-hidden="true" />
    </header>

    <div class="static__body markdown-body">
      <h2>Data sources</h2>

      <p>
        Statistics Canada is the spine: CPI (headline plus the BoC's
        core measures and sub-aggregates), the Labour Force Survey,
        monthly and quarterly GDP, merchandise trade, housing starts,
        and population. The Bank of Canada provides the overnight rate,
        GoC benchmark yields, USDCAD, the Canadian Survey of Consumer
        Expectations, the Business Outlook Survey, and the output gap.
        FRED supplies US comparators &mdash; UST yields, fed funds,
        the VIX, IG and HY credit spreads, WTI and Brent. CREA delivers
        the MLS HPI. The Department of Finance Fiscal Monitor carries
        the federal balance and debt-service costs. The Canadian Bankers
        Association mortgage-arrears file proxies the broader stock view.
      </p>

      <h2>Cadence</h2>

      <p>
        Each section refreshes on the release calendar of its primary
        trigger: CPI mid-month, LFS the first Friday, monthly GDP roughly
        60 days behind reference, merchandise trade with a 30-day lag.
        Markets refreshes daily on yields, FX, and commodities. Policy
        is event-driven on the Bank of Canada's eight fixed announcement
        dates and the quarterly Monetary Policy Report.
      </p>

      <h2>Vintage and revisions</h2>

      <p>
        Monthly prints typically revise the prior one to three
        observations; GDP revises the prior two quarters; CREA back-
        revises three months. The site shows the latest vintage as-is
        and lets the next pipeline build flow revisions through. The CPI
        basket updates roughly every five years; year-over-year changes
        remain comparable across baskets via StatCan's chained index.
      </p>

      <h2>Citation</h2>

      <p>
        Citations name primary Canadian institutions directly: Statistics
        Canada, the Bank of Canada, OSFI, CMHC, the Department of Finance,
        the PBO, C.D. Howe's Business Cycle Council, the IMF Article IV,
        and the OECD Economic Survey. Market consensus enters as a
        derived comparator on a print, not as a quoted view.
      </p>
    </div>
  </article>

  <style>
    /* Shared static-page surface; mirrors /about/. See about.astro for the
     * design-system citation. Kept inline (not extracted to a shared
     * component) because the two pages are the only consumers and the
     * markup is mostly content, not structure. */

    .static {
      width: 100%;
      max-width: var(--col-wide);
      margin: 0 auto;
      padding-top: 28px;
      padding-bottom: var(--s-9);
    }

    .static__kicker {
      margin: 0 0 18px;
      display: inline-flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 0 10px;
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 10px;
      line-height: 1;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--ink);
    }
    .static__kicker-tok { display: inline-block; }
    .static__kicker-tok--name { font-weight: 800; }
    .static__kicker-sep {
      color: var(--ink);
      opacity: 0.32;
      font-weight: 400;
    }

    .static__band {
      border-top: 1px solid var(--ink);
      padding-top: 18px;
    }
    .static__h {
      margin: 0;
      font-family: var(--font-sans);
      font-weight: 800;
      font-size: clamp(36px, 5.5vw, 56px);
      line-height: 1.05;
      letter-spacing: -0.018em;
      color: var(--ink);
      max-width: 22ch;
    }

    .static__rule {
      border: 0;
      border-top: 2px solid var(--ink);
      margin: 32px 0 0;
    }

    .static__body {
      margin-top: var(--s-7);
      max-width: var(--col-body);
    }

    .markdown-body h2 {
      font-family: var(--font-sans);
      font-weight: 800;
      font-size: var(--fs-display-md);
      line-height: var(--lh-display-md);
      letter-spacing: -0.012em;
      color: var(--ink);
      margin: var(--s-8) 0 var(--s-3);
      max-width: 32ch;
      padding-bottom: var(--s-3);
      border-bottom: 1px solid var(--ink);
    }
    .markdown-body h2:first-child {
      margin-top: 0;
    }

    .markdown-body p {
      font-family: var(--font-sans);
      font-weight: 400;
      font-size: var(--fs-body-lg);
      line-height: var(--lh-body-lg);
      color: var(--ink);
      margin: 0 0 var(--s-5);
    }
    .markdown-body p:last-child {
      margin-bottom: 0;
    }

    .markdown-body strong,
    .markdown-body b {
      font-weight: 600;
      color: var(--ink);
    }

    .markdown-body em,
    .markdown-body i {
      font-style: normal;
      font-weight: 200;
    }

    .markdown-body a {
      color: var(--ink);
      text-decoration-color: var(--ink);
    }
    .markdown-body a:hover {
      color: var(--accent);
      text-decoration-color: var(--accent);
    }
  </style>
</BaseLayout>
