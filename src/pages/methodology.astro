---
/*
 * /methodology/ - institutional Methodology page.
 *
 * Source content: editorial/drafts/methodology_page.md (style-editor pass
 * complete, TK-free, ~590 words across four H2 sections). The body is
 * rendered inline as HTML rather than routed through Astro's markdown loader
 * for the same reason as /about/: a single page with no per-edit churn does
 * not need the indirection. The draft remains the source of truth.
 *
 * Visual register: Vignelli, mirroring /about/. Shared `.static` +
 * `.markdown-body` surface (defined inline below; identical to /about/ so the
 * two pages render as a matched pair). H2 sections carry the canonical
 * 1px hairline underline.
 */

import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/sections";

const pageTitle = "Methodology";
const pageDesc =
  "Where the data come from, how often they update, and how revisions " +
  "move through.";
---
<BaseLayout title={pageTitle} description={pageDesc} pageClass="static-page">
  <article class="static" aria-labelledby="static-h">
    <header class="static__header">
      <h1 id="static-h" class="static__h">Methodology</h1>
    </header>

    <div class="static__body markdown-body">
      <h2>Sources</h2>

      <p>
        Statistics Canada is the spine. The Bank of Canada, CREA, the
        Department of Finance, FRED, Yahoo Finance, the Canadian Bankers
        Association, and the Government of Alberta complete the roster.
      </p>

      <h2>Update timing</h2>

      <p>
        Each section refreshes when its primary source releases. The
        data pipeline polls every weekday morning and afternoon; the
        site rebuilds automatically when new source data lands.
      </p>

      <h2>Vintage and revisions</h2>

      <p>
        Monthly prints typically revise the prior one to three
        observations. The site shows the latest vintage as-is and lets
        the next pipeline build flow revisions through.
      </p>

      <h2>AI and automation</h2>

      <p>
        Prose on this site is drafted with LLM assistance. Research notes
        flagged with a &ldquo;Draft&rdquo; stamp carry prose not yet
        human-revised.
      </p>
    </div>
  </article>

  <style>
    /* Shared static-page surface; mirrors /about/. See about.astro for the
     * design-system citation. Kept inline (not extracted to a shared
     * component) because the two pages are the only consumers and the
     * markup is mostly content, not structure. */

    /* Boutique register — matches /about/, /work-with-us/, /contact/. */
    .static {
      width: 100%;
      max-width: 720px;
      margin: 0 auto;
      padding: 32px 24px 64px;
    }

    .static__header {
      border-bottom: 1px solid var(--ink);
      padding-bottom: 24px;
      margin-bottom: 32px;
    }
    .static__kicker {
      margin: 0 0 12px;
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 13px;
      line-height: 1;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--ink);
      opacity: 0.7;
    }
    .static__h {
      margin: 0;
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 42px;
      line-height: 1.1;
      color: var(--ink);
    }

    .static__body {
      /* No top margin: header already has margin-bottom: 32px. */
    }

    .markdown-body h2 {
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 14px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--ink);
      margin: 40px 0 16px;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--ink);
    }
    .markdown-body h2:first-child {
      margin-top: 0;
    }

    .markdown-body p {
      font-family: var(--font-sans);
      font-weight: 400;
      font-size: 18px;
      line-height: 1.55;
      color: var(--ink);
      margin: 0 0 16px;
    }
    .markdown-body p:last-child {
      margin-bottom: 0;
    }

    .markdown-body strong,
    .markdown-body b {
      font-weight: 600;
      color: var(--ink);
    }

    .markdown-body em,
    .markdown-body i {
      font-style: normal;
      font-weight: 200;
    }

    .markdown-body a {
      color: var(--ink);
      text-decoration-color: var(--ink);
    }
    .markdown-body a:hover {
      color: var(--accent);
      text-decoration-color: var(--accent);
    }
  </style>
</BaseLayout>
