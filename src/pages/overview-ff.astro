---
/*
 * /overview-ff/ — alternate overview with the Forex Factory calendar.
 *
 * Forex Factory does NOT publish an iframeable widget — their site sends
 * `X-Frame-Options: SAMEORIGIN`. Their XML feed at
 * `nfs.faireconomy.media/ff_calendar_thisweek.xml` is open, so this page
 * fetches the feed at build time, parses it, and renders a Sibley-styled
 * calendar table.
 *
 * Scope: this is a draft/alt surface for comparison against the live
 * `/overview/` (which uses investing.com's iframe). noindex + excluded
 * from sitemap so it's reachable only by direct URL.
 *
 * Refresh model: build-time fetch with a 6-hour disk cache at
 * `data/derived/ff_calendar_cache.xml`. Forex Factory rate-limits (HTTP
 * 429) when builds hit the CDN repeatedly, so we re-fetch only when the
 * cache is stale or missing. On fetch failure (429, network, etc.) we
 * fall back to the cached copy regardless of age — better to render
 * yesterday's calendar than the empty state.
 *
 * Filter: none — the full Forex Factory week is rendered, all countries
 * and all impact levels. Same scope FF shows on its own site, just in
 * Sibley type. We may later add per-currency / per-impact filter chips,
 * but the unfiltered view is the comparison baseline.
 */
import { readFileSync, writeFileSync, existsSync, statSync, mkdirSync } from "node:fs";
import { dirname, resolve } from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import TitleStatement from "../components/home/TitleStatement.astro";
import SectionPanel from "../components/home/SectionPanel.astro";
import { site } from "../data/sections";
import { enrichedSections, type EnrichedSection } from "../data/site_data_loader";

// --- Section panel grid (same as /overview/) ---------------------------------
const ordered: EnrichedSection[] = enrichedSections;

// --- Date line --------------------------------------------------------------
const today = new Date();
const longDate = new Intl.DateTimeFormat("en-CA", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "America/Toronto",
}).format(today);

// --- Forex Factory feed -----------------------------------------------------
type FFEvent = {
  title: string;
  country: string;
  date: string;   // raw "MM-DD-YYYY"
  time: string;   // raw "h:mma" or "All Day" / "Tentative"
  impact: "High" | "Medium" | "Low" | "Holiday" | string;
  forecast: string;
  previous: string;
  url: string;
};

type FFDayBucket = {
  dateLabel: string;
  isoDate: string;
  events: FFEvent[];
};

const FF_URL = "https://nfs.faireconomy.media/ff_calendar_thisweek.xml";
const FF_CACHE_PATH = resolve(process.cwd(), "data/derived/ff_calendar_cache.xml");
const FF_CACHE_TTL_MS = 6 * 60 * 60 * 1000; // 6h

let ffBuckets: FFDayBucket[] = [];
let ffFetchError: string | null = null;

// Plain-text extractor for a CDATA-wrapped XML field. The FF feed uses
// `<title>...</title>` (no CDATA) and `<date><![CDATA[...]]></date>`. Handle
// both; trim whitespace.
const stripCData = (s: string): string => {
  const m = s.match(/<!\[CDATA\[([\s\S]*?)\]\]>/);
  if (m) return m[1]!.trim();
  return s.trim();
};
const tagText = (block: string, tag: string): string => {
  const re = new RegExp(`<${tag}>([\\s\\S]*?)<\\/${tag}>`, "i");
  const m = block.match(re);
  if (!m) return "";
  return stripCData(m[1]!);
};

// MM-DD-YYYY -> ISO YYYY-MM-DD
const toISO = (raw: string): string => {
  const m = raw.match(/^(\d{2})-(\d{2})-(\d{4})$/);
  if (!m) return raw;
  return `${m[3]}-${m[1]}-${m[2]}`;
};

const MONTH_NAMES = [
  "January", "February", "March", "April", "May", "June",
  "July", "August", "September", "October", "November", "December",
];
const dayLabel = (iso: string): string => {
  const m = iso.match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if (!m) return iso;
  const y = parseInt(m[1]!, 10);
  const mo = parseInt(m[2]!, 10);
  const d = parseInt(m[3]!, 10);
  const dt = new Date(Date.UTC(y, mo - 1, d));
  const dow = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"][dt.getUTCDay()];
  return `${dow}, ${MONTH_NAMES[mo - 1]} ${d}`;
};

// --- Fetch w/ disk cache ----------------------------------------------------
// Pattern: if the cache file exists and is younger than the TTL, use it
// directly. Otherwise try to refresh. On any fetch error (including 429
// rate-limit) fall back to the cached copy regardless of age. Only if
// there's no cache at all AND the fetch fails do we render the error
// state. This keeps builds cheap and resilient to FF throttling.
const cacheAgeMs = (): number | null => {
  if (!existsSync(FF_CACHE_PATH)) return null;
  try { return Date.now() - statSync(FF_CACHE_PATH).mtimeMs; }
  catch { return null; }
};
const readCache = (): string | null => {
  if (!existsSync(FF_CACHE_PATH)) return null;
  try { return readFileSync(FF_CACHE_PATH, { encoding: "latin1" }); }
  catch { return null; }
};
const writeCache = (xml: string): void => {
  try {
    mkdirSync(dirname(FF_CACHE_PATH), { recursive: true });
    writeFileSync(FF_CACHE_PATH, xml, { encoding: "latin1" });
  } catch { /* swallow — cache is best-effort */ }
};

let xml: string | null = null;
const age = cacheAgeMs();
if (age !== null && age < FF_CACHE_TTL_MS) {
  xml = readCache();
}
if (xml === null) {
  try {
    const res = await fetch(FF_URL, {
      headers: { "User-Agent": "SibleyCreek/1.0 (+https://sibleycreek.ca)" },
    });
    if (!res.ok) {
      ffFetchError = `Forex Factory feed returned HTTP ${res.status}; using cached copy.`;
      xml = readCache();
    } else {
      const buf = await res.arrayBuffer();
      xml = new TextDecoder("windows-1252").decode(buf);
      writeCache(xml);
    }
  } catch (err) {
    ffFetchError = err instanceof Error ? err.message : "Unknown fetch error";
    xml = readCache();
  }
}

try {
  if (xml === null) {
    if (!ffFetchError) ffFetchError = "No Forex Factory data available (no cache, no network).";
  } else {
    // Live or cached XML in hand; parse the same way regardless.
    ffFetchError = null;
    const eventBlocks = xml.match(/<event>[\s\S]*?<\/event>/g) ?? [];

    const events: FFEvent[] = eventBlocks.map((block): FFEvent => ({
      title: tagText(block, "title"),
      country: tagText(block, "country"),
      date: tagText(block, "date"),
      time: tagText(block, "time"),
      impact: tagText(block, "impact"),
      forecast: tagText(block, "forecast"),
      previous: tagText(block, "previous"),
      url: tagText(block, "url"),
    }));

    // Group by date.
    const byDate = new Map<string, FFEvent[]>();
    for (const e of events) {
      const iso = toISO(e.date);
      const arr = byDate.get(iso) ?? [];
      arr.push(e);
      byDate.set(iso, arr);
    }
    ffBuckets = Array.from(byDate.entries())
      .sort(([a], [b]) => a.localeCompare(b))
      .map(([isoDate, evs]) => ({
        isoDate,
        dateLabel: dayLabel(isoDate),
        events: evs,
      }));
  }
} catch (err) {
  ffFetchError = err instanceof Error ? err.message : "Unknown fetch error";
}

const pageDesc =
  `Canadian macro overview for ${longDate}, with the full Forex Factory ` +
  "week ahead. Internal alt to /overview/. Independent research.";
---
<BaseLayout
  title={`Overview (FF alt) — ${site.name}`}
  description={pageDesc}
  pageClass="home-page"
  showMastheadRail={true}
>
  <Fragment slot="head">
    <meta name="robots" content="noindex,nofollow" />
  </Fragment>

  <article class="home">
    <TitleStatement dateLine={longDate} />

    <section class="home__grid" aria-label="Indicator panels">
      <h2 class="visually-hidden">Indicator panels</h2>
      {ordered.map((s, i) => (
        <div class="home__cell">
          {s.slug === "fiscal" ? (
            <a class="fiscal-soon" href="/fiscal/">
              <p class="fiscal-soon__eyebrow">
                <span class="fiscal-soon__fig">Figure</span>
                <span class="fiscal-soon__fig-n">{String(i + 1)}.</span>
              </p>
              <h3 class="fiscal-soon__h">Fiscal</h3>
              <p class="fiscal-soon__lede">
                What is Canada's fiscal policy stance?
              </p>
              <p class="fiscal-soon__stamp">In development</p>
            </a>
          ) : (
            <SectionPanel section={s} figureNum={String(i + 1)} />
          )}
        </div>
      ))}
    </section>

    <section class="ffcal" aria-labelledby="ffcal-h">
      <header class="ffcal__head">
        <p class="ffcal__eyebrow">
          <span class="ffcal__fig">Figure</span>
          <span class="ffcal__fig-n">9.</span>
        </p>
        <h2 id="ffcal-h" class="ffcal__h">Week ahead</h2>
      </header>

      {ffFetchError ? (
        <p class="ffcal__error">Calendar feed unavailable: {ffFetchError}</p>
      ) : ffBuckets.length === 0 ? (
        <p class="ffcal__error">No events listed for this week.</p>
      ) : (
        <div class="ffcal__body">
          {ffBuckets.map((bucket) => (
            <div class="ffcal__day">
              <h3 class="ffcal__day-h">{bucket.dateLabel}</h3>
              <table class="ffcal__table">
                <thead>
                  <tr>
                    <th class="ffcal__th ffcal__th--time">Time</th>
                    <th class="ffcal__th ffcal__th--cur">Cur.</th>
                    <th class="ffcal__th ffcal__th--imp">Imp.</th>
                    <th class="ffcal__th ffcal__th--event">Event</th>
                    <th class="ffcal__th ffcal__th--num">Forecast</th>
                    <th class="ffcal__th ffcal__th--num">Previous</th>
                  </tr>
                </thead>
                <tbody>
                  {bucket.events.map((ev) => (
                    <tr class={`ffcal__row ffcal__row--${(ev.impact || "low").toLowerCase()}`}>
                      <td class="ffcal__td ffcal__td--time">{ev.time || "—"}</td>
                      <td class="ffcal__td ffcal__td--cur">{ev.country}</td>
                      <td class="ffcal__td ffcal__td--imp">
                        <span class={`ffcal__impact ffcal__impact--${(ev.impact || "low").toLowerCase()}`}>
                          {ev.impact || "—"}
                        </span>
                      </td>
                      <td class="ffcal__td ffcal__td--event">{ev.title}</td>
                      <td class="ffcal__td ffcal__td--num">{ev.forecast || "—"}</td>
                      <td class="ffcal__td ffcal__td--num">{ev.previous || "—"}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ))}
        </div>
      )}

      <p class="ffcal__attribution">
        Calendar data from
        <a href="https://www.forexfactory.com/calendar" rel="nofollow noopener" target="_blank">Forex Factory</a>.
      </p>
    </section>
  </article>

  <style>
    /* ──────────────── Section panel grid (same as /overview/) ──────────────── */
    .home__grid {
      margin-top: 28px;
      display: grid;
      grid-template-columns: 1fr;
      gap: 0;
      border-top: 1px solid var(--ink);
      border-left: 1px solid var(--ink);
    }
    @media (min-width: 760px) {
      .home__grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
    .home__cell {
      min-width: 0;
      display: flex;
      border-right: 1px solid var(--ink);
      border-bottom: 1px solid var(--ink);
    }
    .home__cell > :global(*) {
      width: 100%;
    }
    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    /* ──────────────── Fiscal "In development" placeholder cell ──────────────── */
    .fiscal-soon {
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      padding: 20px 22px 24px;
      min-height: 260px;
      text-decoration: none;
      color: var(--ink);
      transition: background-color 0.15s ease;
    }
    .fiscal-soon:hover { background-color: rgba(0, 0, 0, 0.02); }
    .fiscal-soon:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: -2px;
    }
    .fiscal-soon__eyebrow {
      margin: 0 0 12px;
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 10px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--ink);
      line-height: 1.4;
    }
    .fiscal-soon__fig { color: var(--ink); font-weight: 600; }
    .fiscal-soon__fig-n {
      color: var(--accent);
      font-weight: 800;
      margin-left: 0.2em;
    }
    .fiscal-soon__h {
      margin: 0 0 8px;
      font-family: var(--font-sans);
      font-weight: 800;
      font-size: 22px;
      letter-spacing: -0.01em;
      line-height: 1.05;
      color: var(--ink);
    }
    .fiscal-soon__lede {
      margin: 0 0 auto;
      font-family: var(--font-sans);
      font-weight: 300;
      font-size: 15px;
      line-height: 1.4;
      color: var(--ink);
    }
    .fiscal-soon__stamp {
      margin: 28px 0 0;
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 10px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--ink-soft, #777);
    }

    /* ──────────────── Forex Factory calendar (Sibley-styled) ──────────────── */
    .ffcal {
      margin-top: 32px;
      padding-bottom: 28px;
    }
    .ffcal__head { padding-bottom: 10px; }
    .ffcal__eyebrow {
      margin: 0;
      padding-top: 16px;
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 10px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--ink);
      line-height: 1.4;
    }
    .ffcal__fig { color: var(--ink); font-weight: 600; }
    .ffcal__fig-n { color: var(--accent); font-weight: 800; margin-left: 0.2em; }
    .ffcal__h {
      margin: 6px 0 0;
      font-family: var(--font-sans);
      font-weight: 800;
      font-size: 22px;
      letter-spacing: -0.01em;
      line-height: 1.05;
      color: var(--ink);
    }

    .ffcal__error {
      margin: 24px 0 0;
      font-family: var(--font-sans);
      font-weight: 400;
      font-size: 13px;
      color: var(--ink);
      opacity: 0.6;
    }

    .ffcal__body {
      margin-top: 16px;
      max-width: 920px;
    }
    .ffcal__day { margin-bottom: 20px; }
    .ffcal__day-h {
      margin: 0 0 4px;
      padding-bottom: 6px;
      font-family: var(--font-sans);
      font-weight: 700;
      font-size: 13px;
      letter-spacing: 0.04em;
      color: var(--ink);
      border-bottom: 1px solid var(--ink);
    }
    .ffcal__table {
      width: 100%;
      border-collapse: collapse;
      font-family: var(--font-sans);
      font-size: 13px;
      line-height: 1.4;
    }
    .ffcal__th {
      padding: 8px 8px 6px;
      text-align: left;
      font-weight: 600;
      font-size: 10px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--ink);
      opacity: 0.6;
      border-bottom: 1px solid rgba(0,0,0,0.12);
    }
    .ffcal__th--num { text-align: right; font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace); }
    .ffcal__td {
      padding: 7px 8px;
      vertical-align: top;
      border-bottom: 1px solid rgba(0,0,0,0.06);
    }
    .ffcal__td--time {
      font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
      font-size: 12px;
      color: var(--ink);
      white-space: nowrap;
    }
    .ffcal__td--cur {
      font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
      font-size: 12px;
      font-weight: 600;
      color: var(--ink);
    }
    .ffcal__td--imp { white-space: nowrap; }
    .ffcal__td--event { color: var(--ink); }
    .ffcal__td--num {
      text-align: right;
      font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
      font-size: 12px;
      color: var(--ink);
    }

    /* Impact chip — small text, no fill colour beyond ink/accent.
     * High = filled accent square; Medium = hairline ink square;
     * Low / Holiday = hollow grey square. */
    .ffcal__impact {
      display: inline-block;
      padding: 2px 6px;
      font-size: 10px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-weight: 600;
      border: 1px solid var(--ink);
      color: var(--ink);
    }
    .ffcal__impact--high {
      background-color: var(--accent);
      color: #fff;
      border-color: var(--accent);
    }
    .ffcal__impact--medium { background: transparent; }
    .ffcal__impact--low { opacity: 0.5; }
    .ffcal__impact--holiday { opacity: 0.5; }

    .ffcal__attribution {
      max-width: 920px;
      margin: 14px 0 0;
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 10px;
      line-height: 1.4;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--ink);
    }
    .ffcal__attribution a {
      color: var(--ink);
      text-decoration: none;
      border-bottom: 1px solid var(--ink);
      margin-left: 0.3em;
    }
    .ffcal__attribution a:hover {
      color: var(--accent);
      border-bottom-color: var(--accent);
    }
    .ffcal__attribution a:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 3px;
    }

    @media (max-width: 600px) {
      .ffcal__th--num,
      .ffcal__td--num {
        display: none;
      }
    }
  </style>
</BaseLayout>
