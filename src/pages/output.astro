---
/*
 * GDP - Vignelli chartbook page.
 *
 * Six plates per chart-diagnosis 2026-05-12 rework + editorial-director
 * chart-order recommendation. The editorial arc is cyclical-first,
 * surface-to-under-the-hood industry, then output gap, then closes on
 * the per-capita deep-dive exit.
 *
 *   01 Headline real GDP - small-multiples m/m + Y/Y vs potential growth
 *   02 Contributions to quarterly growth - 4-bucket streamlined
 *      (final domestic demand, trade net, inventories, total overlay)
 *   03 Services vs goods Y/Y - surface industry split
 *   04 Manufacturing vs mining and oil, indexed to Jan 2023 - the
 *      under-the-hood split, 38-month divergence; the
 *      regional shadow is ON/QC vs AB/SK
 *   05 BoC MPR output gap - cyclical synthesis, slack
 *      (methodology discussion pending; future Sibley nowcast extension
 *      to land here)
 *   06 Total vs per-capita real GDP, indexed to Q4 2019 - closes on the
 *      deepest structural arc; deep-dive exit ramp to
 *      /research/per-capita-output
 *
 * Cut from this page in the 2026-05-12 rework:
 *   - Growth-rate cross-check (was 03 pre-rework): redundant once 01
 *     carries m/m + Y/Y with proper geometry.
 *   - Productivity (was 06 pre-rework): structural story, not cyclical;
 *     idea parked in editorial/chart-diagnosis/ideas.md.
 */

import SectionLayout from "../layouts/SectionLayout.astro";
import type { Plate } from "../layouts/SectionLayout.astro";
import { sections } from "../data/sections";
import panelDataFile from "../../data/site/panel_data/output.json";
import sectionsJson from "../../data/site/sections.json";
import { pickPanel } from "../components/charts/_shared/panelData";
import { deriveLatestReleaseLabel } from "../components/section/_shared/derivedLabels";

const section = sections.find((s) => s.slug === "output");
if (!section) {
  throw new Error("Output section not found in src/data/sections.ts");
}

const latestReleaseLabel = deriveLatestReleaseLabel(
  section.latestReleasePrefix ?? "",
  sectionsJson,
  "output",
);

const panel1Data = pickPanel(panelDataFile, 1);
const panel2Data = pickPanel(panelDataFile, 2);
const panel3Data = pickPanel(panelDataFile, 3);
const panel4Data = pickPanel(panelDataFile, 4);
const panel5Data = pickPanel(panelDataFile, 5);

const plates: Plate[] = [
  {
    id: "plate-1",
    number: "01",
    indicator: "Headline real GDP, m/m and Y/Y",
    plateIndexLabel: "Headline GDP",
    asOfMode: "primary",
    title: "Headline growth is running at 0.4%, well below potential.",
    interpretationHtml:
      "Monthly real GDP slipped 0.1% in March, dragging the year-over-year pace down to 0.4%. " +
      "That now sits nearly a full point below the Bank of Canada's 1.2% estimate of near-term potential growth &mdash; well below trend.",
    callout: {
      value: "-0.1%",
      unitPrefix: "month-over-month",
      delta: "Y/Y +0.4%",
      direction: "neg",
    },
    source: "Statistics Canada Table 36-10-0434-01 (monthly real GDP by industry); potential growth reference from BoC Monetary Policy Report, April 2026, Appendix (2026 estimate 1.2%).",
    chartKey: "gdp-panel-1",
    data: panel1Data,
    citations: [
      { phrase: "0.1% in March", source: "pipeline:statcan:36-10-0434-01" },
      { phrase: "0.4%", source: "pipeline:statcan:36-10-0434-01" },
      { phrase: "nearly a full point", source: "derived", note: "1.2% - 0.4% = 0.8pp" },
      { phrase: "1.2% estimate of near-term potential growth", source: "card:boc_mpr_potential_growth" },
    ],
  },
  {
    id: "plate-2",
    number: "02",
    indicator: "Contributions to quarterly growth, by bucket",
    plateIndexLabel: "Contributions",
    title: "A standstill, not a recession.",
    interpretationHtml:
      "Q1 GDP edged down 0.1% annualized, the second consecutive negative quarter after Q4 2025's inventory-led 1-point drag. " +
      "At that scale Q1 sits closer to statistical noise than economic signal &mdash; well inside StatCan's typical revision band.",
    callout: {
      value: "-0.1%",
      unitPrefix: "q/q SAAR",
      delta: "2nd negative quarter",
      direction: "neg",
    },
    source: "Statistics Canada Table 36-10-0104-01 (quarterly expenditure-side contributions to growth).",
    chartKey: "gdp-panel-3",
    data: panel3Data,
    citations: [
      { phrase: "0.1% annualized", source: "pipeline:statcan:36-10-0104-01", note: "Q1 2026 real GDP quarterly q/q SAAR (total contribution -0.144pp, rounded)." },
      { phrase: "second consecutive negative quarter", source: "pipeline:statcan:36-10-0104-01", note: "Q4 2025 contribution -0.987pp; Q1 2026 -0.144pp. Two consecutive negative quarters." },
      { phrase: "inventory-led 1-point drag", source: "derived", note: "Q4 2025 total contribution roughly -1pp (-0.987pp), inventory-driven per the May 29 commentary." },
    ],
  },
  {
    id: "plate-3",
    number: "03",
    indicator: "Real GDP by industry, services vs goods Y/Y + manufacturing vs mining and oil indexed to Jan 2023",
    plateIndexLabel: "Industry composite",
    title: "Resources have outrun factories by 18 percentage points since January 2023.",
    interpretationHtml:
      "Mining and oil-and-gas output is up roughly 12% since January 2023; manufacturing is down about 6% &mdash; an 18-point split inside the goods economy. " +
      "Services, which employ most Canadians, are running at about 1% year-over-year. " +
      "The divergence maps cleanly onto Canada's regional economic geography: resource provinces pulling one direction, central-Canada factory floors pulling the other.",
    callout: {
      value: "+12%",
      unitPrefix: "mining + oil, since Jan 2023",
      delta: "Manufacturing -6%",
      direction: "neutral",
    },
    source: "Statistics Canada Table 36-10-0434-01 (monthly real GDP by industry).",
    chartKey: "gdp-panel-2",
    data: panel2Data,
    citations: [
      { phrase: "January 2023", source: "derived", note: "Chart anchor date for the right-panel index. Both mining/oil and manufacturing monthly series carry a 2023-01-01 observation in StatCan 36-10-0434-01. Appears in both title and blurb." },
      { phrase: "18 percentage points", source: "derived", note: "12.16% - (-6.12%) = 18.28pp, rounded to 18 points. Inputs: mining and oil and manufacturing cumulative changes since January 2023 from StatCan 36-10-0434-01." },
      { phrase: "roughly 12%", source: "pipeline:statcan:36-10-0434-01", note: "Mining and oil-and-gas extraction, cumulative real GDP change Jan 2023 to Feb 2026: (0.121981 / 0.108753 - 1) * 100 = +12.16%." },
      { phrase: "down about 6%", source: "pipeline:statcan:36-10-0434-01", note: "Manufacturing real GDP, cumulative change Jan 2023 to Feb 2026: (0.199199 / 0.212183 - 1) * 100 = -6.12%." },
      { phrase: "18-point split", source: "derived", note: "Same calculation as 18 percentage points citation: 12.16pp - (-6.12pp) = 18.28pp." },
      { phrase: "1% year-over-year", source: "pipeline:statcan:36-10-0434-01", note: "Services real GDP Y/Y at Feb 2026: (1.758647 / 1.740295 - 1) * 100 = 1.05%, rounded to ~1%." },
    ],
  },
  {
    id: "plate-4",
    number: "04",
    indicator: "BoC MPR output gap",
    plateIndexLabel: "Output gap",
    title: "The output gap reopened to 1% in Q4 — a hold story, not a hike one.",
    interpretationHtml:
      "The Bank of Canada's output gap estimate widened to -1.0% in Q4 from -0.5% in Q3, the deepest reading since early 2021. " +
      "The shortfall is demand-side: not enough spending to absorb the economy's productive capacity. " +
      "A gap this size keeps the easing bias intact and takes a near-term hike off the conversation.",
    callout: {
      value: "-1.0%",
      unitPrefix: "% of potential",
      delta: "-0.5pp vs prior quarter",
      direction: "neg",
    },
    source:
      "Bank of Canada Monetary Policy Report, April 2026 (Valet INDINF_OUTGAPMPR_Q).",
    chartKey: "gdp-panel-5",
    data: panel5Data,
    citations: [
      { phrase: "-1.0% in Q4", source: "pipeline:boc:INDINF_OUTGAPMPR_Q", note: "BoC MPR output gap, Q4 2025." },
      { phrase: "-0.5% in Q3", source: "pipeline:boc:INDINF_OUTGAPMPR_Q", note: "BoC MPR output gap, Q3 2025." },
      { phrase: "deepest reading since early 2021", source: "pipeline:boc:INDINF_OUTGAPMPR_Q", note: "Enumerated Q1 2021 onward: only Q1 2021 (-1.7) and Q2 2021 (-2.0) were deeper than Q4 2025." },
    ],
  },
  {
    id: "plate-5",
    number: "05",
    indicator: "Total vs per-capita real GDP, indexed to pre-pandemic baseline (Q4 2019)",
    plateIndexLabel: "Per capita",
    asOfMode: "primary",
    title: "Total output is up about 11% since the pre-pandemic peak — per-capita output is barely above it.",
    interpretationHtml:
      "Total real GDP has grown about 11% since Q4 2019; on a per-person basis, output has risen less than 1%. " +
      "The 10-point wedge is the population story &mdash; Canada has added nearly 3.8 million people in that span, accounting for almost all of the headline growth without materially lifting living standards.",
    callout: {
      value: "+1%",
      unitPrefix: "per-capita real GDP, since Q4 2019",
      delta: "Total +11%",
      direction: "neg",
    },
    source:
      "Statistics Canada Tables 36-10-0104-01 and 17-10-0009-01; per-capita and indexation by Sibley Creek.",
    chartKey: "gdp-panel-4",
    data: panel4Data,
    citations: [
      { phrase: "Q4 2019", source: "derived", note: "Chart baseline date = 2019Q4 (2019-10-01 in StatCan quarterly notation). Both GDP and population series carry this observation per StatCan 36-10-0104-01 and 17-10-0009-01." },
      { phrase: "about 11%", source: "derived", note: "Total real GDP cumulative since 2019Q4: 2,502,165 / 2,255,354 - 1 = +10.94%. Inputs: StatCan 36-10-0104-01, 2025Q4 latest vintage. Appears in both title and blurb." },
      { phrase: "less than 1%", source: "derived", note: "Per-capita real GDP = total / population. 2019Q4: 2,255,354e6 / 37,828,162 = 59,621 CAD/person. 2025Q4: 2,502,165e6 / 41,575,585 = 60,184 CAD/person. Change: +0.94%. Inputs: StatCan 36-10-0104-01 (GDP) and 17-10-0009-01 (population)." },
      { phrase: "10-point wedge", source: "derived", note: "10.94% (total) - 0.94% (per-capita) = 10.0pp. Inputs: StatCan 36-10-0104-01 and 17-10-0009-01." },
      { phrase: "3.8 million people", source: "pipeline:statcan:17-10-0009-01", note: "Population Q4 2019 = 37,828,162; Q4 2025 = 41,575,585; difference = 3,747,423 ≈ 3.8 million." },
    ],
  },
];

const pageTitle = "Output";
const pageDescription =
  "Canadian GDP chartbook: monthly and quarterly output, industry splits, contributions to growth, the output gap, and per-capita real GDP.";

const lede = section.blurb?.body ?? "";
---
<SectionLayout
  slug="output"
  sectionIndex={1}
  sectionLabel="Output"
  headlineQuestion={section.headlineQuestion}
  lede={lede}
  latestReleaseLabel={latestReleaseLabel}
  plates={plates}
  title={pageTitle}
  description={pageDescription}
/>
