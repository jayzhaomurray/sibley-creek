---
/*
 * /fiscal/ — Chartbook page wiring the six fiscal plates.
 *
 * FINAL SLATE (Jay-approved 2026-06-04):
 *   plate-1 (01) balance two-panel        — fiscal.json panel-6
 *   plate-2 (02) DoF-vs-PBO dispute bars  — fiscal.json panel-11 (NEW)
 *   plate-3 (03) rev vs exp merged lines  — fiscal.json panels 7+8 (combined)
 *   plate-4 (04) debt/GDP                 — fiscal.json panel-9
 *   plate-5 (05) debt service ratio        — fiscal.json panel-2
 *   plate-6 (06) issuance by instrument   — fiscal.json panel-10
 *
 * PLATE 3 DATA WIRING (merged revenue+expense chart, R2.5):
 *   Plate2RevenuesPctGDP is the merged two-line chart (revenues vs expenses).
 *   It receives a combined PanelData where:
 *     primary   = panel-7 primary (frt_revenues_pct_gdp)
 *     secondary = panel-8 primary (frt_program_exp_pct_gdp)
 *   This is composed here before passing to SectionLayout. (The component
 *   keeps its historical "Plate2" filename per "tag and leave"; it renders
 *   as plate-3 in the final slate.)
 *
 * PLATE 2 (NEW 2026-06-04): Plate2OperatingDispute, grouped signed bars,
 *   DoF operating balance (SEU Apr 2026) vs PBO recast (Nov 2025 recast of
 *   Budget 2025). The two series are different vintages — the component and
 *   the copy both avoid same-year subtraction; the $94B annotation is the
 *   verified capital-classification wedge.
 *
 * Plate3ProgramExpPctGDP CUT 2026-06-02 (redundant with the merged rev/exp
 * chart). Plate1BalanceComposition + Plate2RevExpTwoPanel UNWIRED 2026-06-02
 * (Jay picked the winners). All losing files retained per "tag and leave".
 *
 * Reader copy: passed all three gates (fact / style / surface-fit), two
 * rounds, 2026-06-04. Plate-2 and plate-4 PBO claims cite source cards
 * pending user approval — see editorial/source_cards/_pending/fiscal/.
 */

import SectionLayout from "../layouts/SectionLayout.astro";
import type { Plate } from "../layouts/SectionLayout.astro";
import { sections } from "../data/sections";
import panelDataFile from "../../data/site/panel_data/fiscal.json";
import { pickPanel } from "../components/charts/_shared/panelData";
import type { PanelData } from "../components/charts/_shared/panelData";

const section = sections.find((s) => s.slug === "fiscal");
if (!section) {
  throw new Error("Fiscal section not found in src/data/sections.ts");
}

const panel2Data  = pickPanel(panelDataFile, 2);
const panel6Data  = pickPanel(panelDataFile, 6);
const panel7Data  = pickPanel(panelDataFile, 7);
const panel8Data  = pickPanel(panelDataFile, 8);
const panel9Data  = pickPanel(panelDataFile, 9);
const panel10Data = pickPanel(panelDataFile, 10);
const panel11Data = pickPanel(panelDataFile, 11);

// ---- Plate 3 combined data: revenues (primary) + expenses (secondary) ----------
// Plate2RevenuesPctGDP is the merged two-line chart (R2.5).
// The component reads: data.primary = revenues, data.secondary = expenses.
const plate3CombinedData: PanelData | null = (panel7Data && panel8Data)
  ? {
      ...panel7Data,
      // Graft panel-8's primary series into the secondary slot so the merged
      // chart component can read both series from a single data prop.
      secondary: panel8Data.primary ?? null,
    }
  : (panel7Data ?? null);

const plates: Plate[] = [
  {
    id: "plate-1",
    number: "01",
    indicator: "Budget balance — full history + forecast operating/capital zoom",
    plateIndexLabel: "Operating balance",
    title: "Ottawa plans to balance day-to-day spending and borrow only for capital.",
    interpretation:
      "Ottawa's plan separates the budget in two: balance day-to-day operations, borrow only for capital. The operating balance is set to swing from deficit to a small surplus by 2028-29; capital investment at $40 to $60 billion annually keeps the headline balance in the red.",
    source: "Department of Finance Canada, Fiscal Reference Tables 2025; Spring Economic Update 2026.",
    chartKey: "fiscal-plate-1-alt",
    data: panel6Data,
    // Explicit: derived as-of reads the forecast endpoint (Mar 2031) as if it
    // were a data vintage. Stamp the actual vintage instead.
    asOf: "DoF Apr 2026",
  },
  {
    id: "plate-2",
    number: "02",
    indicator: "Budget 2025 operating balance under two definitions of capital",
    plateIndexLabel: "Capital, disputed",
    title: "The watchdog thinks Ottawa's definition of capital spending is too loose.",
    interpretation:
      "Ottawa's books show day-to-day spending balancing by 2028-29. But count tax breaks and subsidies as everyday spending, and $94 billion moves back into operating expenses over the plan's six years, the Parliamentary Budget Officer says. That would keep the operating books in deficit through 2029-30.",
    source: "Parliamentary Budget Officer, Budget 2025: Issues for Parliamentarians (RP-2526-017-S, November 2025), Table 4; PBO Assessment of Spring Economic Update: Fiscal Anchors (NT-2627-002-S, May 2026).",
    citations: [
      { phrase: "too loose", source: "card:dof_vs_pbo_operating_capital_dispute", note: "Plain-English render of PBO RP-2526-017-S p.1 verbatim: 'the Government's definition of capital investments is overly expansive.' Attributed via 'The watchdog thinks.'" },
      { phrase: "balancing by 2028-29", source: "card:dof_vs_pbo_operating_capital_dispute", note: "RP-2526-017-S Table 4, row 1 (Budget 2025 as presented): −4.1, −33.0, −8.7, −5.5, +1.7, +3.0 — first positive FY2028-29 at +$1.7bn." },
      { phrase: "count tax breaks and subsidies as everyday spending", source: "card:dof_vs_pbo_operating_capital_dispute", note: "The categories PBO reclassifies out of capital: corporate income-tax expenditures ('tax breaks' per Gate-1 ruling), investment tax credits, operating subsidies." },
      { phrase: "$94 billion moves back into operating expenses over the plan's six years", source: "card:dof_vs_pbo_operating_capital_dispute", note: "Cumulative classification wedge $94.2bn over FY2024-25→2029-30 (DoF $311.5bn capital vs PBO $217.3bn). Attributed via trailing 'the Parliamentary Budget Officer says.'" },
      { phrase: "in deficit through 2029-30", source: "card:dof_vs_pbo_operating_capital_dispute", note: "Table 4, row 2 (same budget, PBO definition): −10.5, −45.8, −25.3, −23.3, −18.1, −17.6 — all negative. 'Would' marks the conditional (under PBO's definition)." },
    ],
    chartKey: "fiscal-plate-2-dispute",
    data: panel11Data,
    // One document read two ways — stamp names the document + recast vintage.
    asOf: "Budget 2025; PBO Nov 2025",
  },
  {
    id: "plate-3",
    number: "03",
    indicator: "Federal revenues vs program expenses, % of GDP",
    plateIndexLabel: "Revenue vs spending",
    title: "The deficit narrows only in the forecast, and only from the spending side.",
    interpretation:
      "Whatever the definition fight, the deficit is a spending story. Revenue has barely moved as a share of GDP—even as program spending hit a peacetime-record 28% in 2020-21. The forecast closes the gap from the spending side, returning expenses below revenue by decade's end.",
    source: "Department of Finance Canada, Fiscal Reference Tables 2025; Spring Economic Update 2026.",
    chartKey: "fiscal-plate-2",
    data: plate3CombinedData,
    asOf: "DoF Apr 2026",
  },
  {
    id: "plate-4",
    number: "04",
    indicator: "Federal debt, % of GDP",
    plateIndexLabel: "Debt/GDP",
    title: "Both sides project the debt ratio flat.",
    interpretation:
      "Neither the government nor the watchdog disputes the direction of the federal debt ratio. Ottawa's plan holds it near 41% through the decade; the Parliamentary Budget Officer projects its own track flat in the low-42s. The fight over this budget is not about the debt ratio.",
    source: "Department of Finance Canada, Fiscal Reference Tables 2025; Spring Economic Update 2026; Parliamentary Budget Officer, Economic and Fiscal Outlook – June 2026 (RP-2627-002-S).",
    citations: [
      { phrase: "Ottawa's plan holds it near 41% through the decade", source: "pipeline:fiscal:panel-9", note: "frt_federal_debt_pct_gdp: 41.1% FY2025-26 to 41.6% FY2030-31 (DoF track)." },
      { phrase: "projects its own track flat in the low-42s", source: "card:pbo_efo_june2026_debt_gdp", note: "PBO EFO June 2026 p.9: 'projected to remain flat over the medium term'; track FY2027-28→2030-31: 42.4, 42.6, 42.6, 42.5 — vs DoF 41.x. Gap 0.1–0.9pp; reflects PBO's higher deficits AND a different GDP denominator vintage (not purely deficit-driven)." },
    ],
    chartKey: "fiscal-plate-4",
    data: panel9Data,
    asOf: "DoF Apr 2026; PBO Jun 2026",
  },
  {
    id: "plate-5",
    number: "05",
    indicator: "Public debt charges as share of federal revenues, monthly",
    plateIndexLabel: "Carrying cost",
    title: "Flat ratio or not, the bill to carry the debt keeps climbing.",
    interpretation:
      "A flat debt ratio does not mean a flat bill. Federal debt charges already take a rising share of every revenue dollar, and the Parliamentary Budget Officer projects that share climbing to roughly thirteen cents by 2030-31.",
    source: "Department of Finance Canada, Fiscal Monitor (monthly); Parliamentary Budget Officer, Economic and Fiscal Outlook – June 2026 (RP-2627-002-S).",
    citations: [
      { phrase: "roughly thirteen cents by 2030-31", source: "card:pbo_efo_june2026_debt_gdp", note: "PBO EFO June 2026: debt service ratio 10.5% (2024-25) / 10.6% (2025-26) rising to 13.1% by 2030-31. 'Roughly thirteen cents' rounds true." },
      { phrase: "already take a rising share", source: "pipeline:fiscal:panel-2", note: "debt_service_ratio monthly series: latest 10.74% (Mar 2026), up from the 2022 lows; 5-yr trailing band on the chart carries the history." },
    ],
    chartKey: "fiscal-panel-debt-service",
    data: panel2Data,
    asOf: "DoF Feb 2026; PBO Jun 2026",
  },
  {
    id: "plate-6",
    number: "06",
    indicator: "Gross issuance by maturity bucket: bills, notes, bonds",
    plateIndexLabel: "Issuance by instrument",
    title: "Bonds, not bills, pushed issuance to a planned record.",
    interpretation:
      "Issuance was set to reach a record $612 billion under the FY2025-26 borrowing plan, topping the $590 billion 2020-21 pandemic peak. Almost the entire increase sits in marketable bonds, short and long tenors up as deficits widened and the refinancing load grew. The bill stock barely moved; the market absorbed duration, not just dollars.",
    source: "Department of Finance Canada, Fiscal Reference Tables 2025; Debt Management Report (gross issuance of bonds and bills).",
    footnote:
      "Bills are Treasury bills, money-market instruments maturing in under a year; the figure shown is the year-end bill stock, not annual auction volume, which rolls several times over. Notes group the short marketable-bond sectors (2-, 3- and 5-year), and Bonds group the long sectors (10- and 30-year, plus Green bonds); both are true gross issuance flow for the year. “Notes” is a presentational label, not a Government of Canada instrument class—Canada issues Treasury bills and marketable bonds by tenor.",
    chartKey: "fiscal-plate-5",
    data: panel10Data,
    // "Mar 2027" derived stamp = the FY2026-27 plan endpoint, not a vintage.
    asOf: "DoF Apr 2026",
  },
];

const pageTitle = "Fiscal";
const pageDescription =
  "Canadian fiscal policy chartbook: budget balance composition, the operating-vs-capital classification dispute, revenues and program expenses as a share of GDP, federal debt trajectory, and debt issuance by instrument.";

const lede = section.blurb?.body ?? "";
---
<SectionLayout
  slug="fiscal"
  sectionIndex={5}
  sectionLabel="Fiscal"
  headlineQuestion={section.headlineQuestion}
  lede={lede}
  latestReleaseLabel={null}
  plates={plates}
  title={pageTitle}
  description={pageDescription}
  dateModified={new Date(section.updatedAt).toISOString()}
  noindex={true}
/>
