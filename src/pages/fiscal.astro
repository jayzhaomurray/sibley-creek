---
/*
 * /fiscal/ — coming-soon placeholder.
 *
 * The full chartbook is still in development. Draft alternatives should live
 * on separate direct-link review routes until one is explicitly promoted.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { sections, site } from "../data/sections";
import { withBase } from "../lib/urls";

const fiscalSection = sections.find((s) => s.slug === "fiscal");
const headlineQuestion =
  fiscalSection?.headlineQuestion ?? "What is Canada's fiscal policy stance?";
---
<BaseLayout
  title={`Fiscal — ${site.name}`}
  description="Sibley Creek's fiscal policy section. Coming soon."
  pageClass="coming-soon-page"
>
  <main class="coming-soon" aria-labelledby="coming-soon-h">
    <p class="coming-soon__eyebrow">
      <span class="coming-soon__fig">Section</span>
      <span class="coming-soon__fig-n">05.</span>
      <span class="coming-soon__label">Fiscal</span>
    </p>
    <h1 id="coming-soon-h" class="coming-soon__h">{headlineQuestion}</h1>
    <p class="coming-soon__lede">
      The fiscal section is in development. Check back shortly.
    </p>
    <p class="coming-soon__back">
      <a href={withBase("/overview/")}>Back to the overview</a>
    </p>
  </main>

  <style>
    .coming-soon {
      max-width: 720px;
      margin: 96px auto 160px;
      padding: 0 32px;
      font-family: var(--font-sans);
    }

    .coming-soon__eyebrow {
      margin: 0 0 28px;
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 10px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--ink);
      line-height: 1.4;
    }

    .coming-soon__fig {
      color: var(--ink);
      font-weight: 600;
    }

    .coming-soon__fig-n {
      color: var(--accent);
      font-weight: 800;
      margin-left: 0.2em;
    }

    .coming-soon__label {
      margin-left: 0.6em;
      color: var(--ink);
    }

    .coming-soon__h {
      margin: 0 0 32px;
      font-family: var(--font-sans);
      font-weight: 800;
      font-size: clamp(36px, 6vw, 64px);
      letter-spacing: -0.01em;
      line-height: 1.05;
      color: var(--ink);
    }

    .coming-soon__lede {
      margin: 0 0 40px;
      font-family: var(--font-sans);
      font-weight: 300;
      font-size: 18px;
      line-height: 1.5;
      color: var(--ink);
    }

    .coming-soon__back {
      margin: 0;
      font-family: var(--font-sans);
      font-weight: 400;
      font-size: 14px;
      line-height: 1.4;
    }

    .coming-soon__back a {
      color: var(--ink);
      text-decoration: none;
      border-bottom: 1px solid var(--ink);
    }

    .coming-soon__back a:hover {
      color: var(--accent);
      border-bottom-color: var(--accent);
    }

    .coming-soon__back a:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 3px;
    }
  </style>
</BaseLayout>
