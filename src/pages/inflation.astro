---
import SectionLayout from "../layouts/SectionLayout.astro";
import type { Plate } from "../layouts/SectionLayout.astro";
import { sections } from "../data/sections";
import panelDataFile from "../../data/site/panel_data/inflation.json";
import sectionsJson from "../../data/site/sections.json";
import { pickPanel } from "../components/charts/_shared/panelData";
import { deriveLatestReleaseLabel } from "../components/section/_shared/derivedLabels";

const section = sections.find((s) => s.slug === "inflation");
if (!section) {
  throw new Error("Inflation section not found in src/data/sections.ts");
}

const latestReleaseLabel = deriveLatestReleaseLabel(
  section.latestReleasePrefix ?? "",
  sectionsJson,
  "inflation",
);

const panel1Data = pickPanel(panelDataFile, 1);
const panel2Data = pickPanel(panelDataFile, 2);
const panel3Data = pickPanel(panelDataFile, 3);
const panel4Data = pickPanel(panelDataFile, 4);
const panel5Data = pickPanel(panelDataFile, 5);

const plates: Plate[] = [
  {
    id: "plate-1",
    number: "01",
    indicator: "Headline CPI, m/m and Y/Y",
    plateIndexLabel: "Headline CPI",
    title: "Inflation snapped back inside the control band in June.",
    interpretationHtml:
      "Headline inflation fell back to 2.8% year-over-year in June from 3.2% in May. " +
      "That returns the headline inside the Bank of Canada's 1-to-3% control band after a single month above it. " +
      "The reversal is concentrated in gasoline, which fell after an interim Middle East ceasefire eased pressure at the pump &mdash; an energy correction, not yet evidence of a broader disinflation.",
    callout: {
      value: "2.8%",
      unitPrefix: "Y/Y",
      delta: "m/m -0.4%",
      direction: "neg",
    },
    source:
      "Statistics Canada Table 18-10-0004-01.",
    chartKey: "inflation-panel-1",
    data: panel1Data,
    citations: [
      { phrase: "2.8% year-over-year in June", source: "pipeline:statcan:18-10-0004-01", note: "Headline CPI NSA Y/Y, June 2026 = 2.798%." },
      { phrase: "3.2% in May", source: "pipeline:statcan:18-10-0004-01", note: "Headline CPI NSA Y/Y, May 2026 = 3.226%." },
      { phrase: "1-to-3% control band", source: "card:boc_inflation_mandate" },
      { phrase: "gasoline, which fell after an interim Middle East ceasefire", source: "derived", note: "VERIFIED 2026-07-20 against work/published/commentaries/cpi-2026-07-20.pdf (p.2): gasoline \"fell 10% month-over-month following the announcement of an interim ceasefire agreement in the Middle East.\"" },
    ],
  },
  {
    id: "plate-2",
    number: "02",
    indicator: "Core-trim and core-median, Y/Y",
    plateIndexLabel: "Preferred cores",
    title: "Core measures are now running below the 2% midpoint.",
    interpretationHtml:
      "CPI-trim eased to 1.8% in June and CPI-median eased to 1.9%, both down two-tenths from May and now below the Bank of Canada's 2% midpoint. " +
      "Neither preferred-core measure confirmed May's headline breakout, so June's reversal matches what the underlying trend had been saying. " +
      "The policy question shifts from whether the overshoot would spread to whether energy has further to give back.",
    callout: {
      value: "1.8%",
      unitPrefix: "core-trim, Y/Y",
      delta: "-0.2pp vs May",
      direction: "neg",
    },
    source: "Bank of Canada (CPI-trim, CPI-median).",
    chartKey: "inflation-panel-2",
    data: panel2Data,
    citations: [
      { phrase: "CPI-trim eased to 1.8%", source: "pipeline:statcan:cpi_trim", note: "CPI-trim Y/Y, June 2026 = 1.8%, down from 2.0% in May (BoC Valet preferred-core series)." },
      { phrase: "CPI-median eased to 1.9%", source: "pipeline:statcan:cpi_median", note: "CPI-median Y/Y, June 2026 = 1.9%, down from 2.1% in May (BoC Valet preferred-core series)." },
      { phrase: "down two-tenths from May", source: "derived", note: "CPI-trim 2.0% to 1.8% and CPI-median 2.1% to 1.9%, both -0.2pp May to June 2026." },
      { phrase: "2% midpoint", source: "card:boc_inflation_mandate" },
    ],
  },
  {
    id: "plate-3",
    number: "03",
    indicator: "Share of CPI basket above 3% Y/Y",
    plateIndexLabel: "Breadth",
    title: "Breadth reversed course in June, undoing May's widening.",
    interpretationHtml:
      "The share of the CPI basket running above 3% year-over-year fell to 28.8% in June from 34.6% in May. " +
      "The share running below 1% jumped to 43.2% from 34.9% &mdash; June's cooling reached beyond components merely running hot. " +
      "May's widening looks like the energy-driven blip it appeared to be, not the start of a broader breakout.",
    callout: {
      value: "28.8%",
      unitPrefix: "share >3% Y/Y",
      delta: "-5.8pp vs May",
      direction: "neg",
    },
    source: "Statistics Canada Table 18-10-0004-01; component shares constructed.",
    chartKey: "inflation-panel-3",
    data: panel3Data,
    citations: [
      { phrase: "above 3%", source: "card:boc_inflation_mandate", note: "Reference threshold is the upper edge of the BoC 1-3% control band." },
      { phrase: "below 1%", source: "derived", note: "Methodology threshold: share of weighted CPI basket with Y/Y below 1.0% — the lower edge of the BoC 1-3% control band." },
      { phrase: "28.8% in June", source: "derived", note: "Weighted-basket breadth share (the series plotted on the chart) with Y/Y > 3%, June 2026 = 28.8375%. Matches pipeline.build.derive_cpi_breadth_band(). Callout delta: 28.8375% minus 34.6134% (May) = -5.78pp, rounds to -5.8pp." },
      { phrase: "34.6% in May", source: "derived", note: "Weighted-basket breadth share with Y/Y > 3%, May 2026 = 34.6134%." },
      { phrase: "43.2%", source: "derived", note: "Share of weighted CPI basket with Y/Y < 1%, June 2026 = 43.1991%." },
      { phrase: "34.9%", source: "derived", note: "Share of weighted CPI basket with Y/Y < 1%, May 2026 = 34.8736%." },
    ],
  },
  {
    id: "plate-4",
    number: "04",
    indicator: "Shelter, services, goods, food, energy, Y/Y",
    plateIndexLabel: "Sub-aggregates",
    title: "Energy's collapse is masking a pickup in services inflation.",
    interpretationHtml:
      "Energy inflation collapsed to 14.3% year-over-year in June from 22.2% in May as gasoline reversed, and goods inflation eased to 3.5% from 4.8%. " +
      "Services excluding shelter accelerated to 3.0% from 2.3%, with World Cup-related travel demand pushing hotel, rental-car, and tour prices higher in Ontario and British Columbia. " +
      "Shelter and food both eased slightly, and June's story is a rotation &mdash; energy giving back its spring, services picking up the slack &mdash; not a uniform cooling.",
    callout: {
      value: "14.3%",
      unitPrefix: "energy, Y/Y",
      delta: "-7.9pp vs prior",
      direction: "neg",
    },
    source:
      "Statistics Canada Table 18-10-0004-01 (CPI sub-aggregates).",
    chartKey: "inflation-panel-4",
    data: panel4Data,
    citations: [
      { phrase: "Energy inflation collapsed to 14.3%", source: "pipeline:statcan:18-10-0004-01", note: "Energy CPI Y/Y, June 2026 = 14.3160%." },
      { phrase: "22.2% in May", source: "pipeline:statcan:18-10-0004-01", note: "Energy CPI Y/Y, May 2026 = 22.1753%." },
      { phrase: "goods inflation eased to 3.5%", source: "pipeline:statcan:18-10-0004-01", note: "Goods CPI Y/Y, June 2026 = 3.5052%." },
      { phrase: "4.8%", source: "pipeline:statcan:18-10-0004-01", note: "Goods CPI Y/Y, May 2026 = 4.8143%." },
      { phrase: "Services excluding shelter accelerated to 3.0%", source: "pipeline:statcan:18-10-0004-01", note: "Services excluding shelter CPI Y/Y, June 2026 = 3.0271% (data/processed/cpi_services_ex_shelter_yoy.csv)." },
      { phrase: "2.3%", source: "pipeline:statcan:18-10-0004-01", note: "Services excluding shelter CPI Y/Y, May 2026 = 2.2584%." },
      { phrase: "World Cup-related travel demand pushing hotel, rental-car, and tour prices higher in Ontario and British Columbia", source: "derived", note: "VERIFIED 2026-07-20 against work/published/commentaries/cpi-2026-07-20.pdf (p.2): StatCan-attributed detail that hotels/traveller's accommodation in Ontario and BC ran +20% y/y (driven by Toronto and Vancouver) and rental cars/travel tours +7% y/y, both linked to the World Cup. Style pass 2026-07-20: dropped the imprecise \"sharply\" intensifier per fact-checker's own note; consider specific percentages on next redraft." },
      { phrase: "Shelter and food both eased slightly", source: "pipeline:statcan:18-10-0004-01", note: "Shelter CPI Y/Y, June 2026 = 1.5483%, down from 1.7121% in May. Food CPI Y/Y, June 2026 = 3.4765%, down from 3.7871% in May." },
    ],
  },
  {
    id: "plate-5",
    number: "05",
    indicator: "Consumer and firm inflation expectations",
    plateIndexLabel: "Expectations",
    title: "The inflation anchor slipped in Q2, with firms moving furthest.",
    interpretationHtml:
      "Five-year consumer expectations rose to 3.4% from 3.0%, and the share of firms expecting inflation above 3% jumped to 44% from 11% &mdash; the highest reading since late 2023. " +
      "Both surveys were fielded in late April and May, as the war drove WTI crude toward $101 a barrel, up from roughly $65 before the conflict began, and nearly three-quarters of firms reported the war had already raised their costs. " +
      "June's CPI print cooled to 2.8% after both surveys had closed: the backward-looking data eased while the forward-looking readings turned more worried.",
    callout: {
      value: "44%",
      unitPrefix: "BOS share expecting inflation above 3%",
      delta: "+33pp vs Q1",
      direction: "pos",
    },
    source: "Bank of Canada Canadian Survey of Consumer Expectations and Business Outlook Survey, Q2 2026.",
    chartKey: "inflation-panel-5",
    data: panel5Data,
    citations: [
      { phrase: "rose to 3.4%", source: "pipeline:boc:infl_exp_consumer_5y", note: "5-year consumer inflation expectations (BoC Valet CES_C1_LONG_TERM), Q2 2026 (2026-04-01 vintage) = 3.39%, rounds to 3.4%. data/raw/infl_exp_consumer_5y.csv." },
      { phrase: "3.0%", source: "pipeline:boc:infl_exp_consumer_5y", note: "Same series, Q1 2026 (2026-01-01 vintage) = 3.02%, rounds to 3.0%." },
      { phrase: "above 3%", source: "card:boc_inflation_mandate", note: "Reference threshold is the upper edge of the BoC 1-3% control band." },
      { phrase: "jumped to 44%", source: "pipeline:boc:infl_exp_above3", note: "Business Outlook Survey share of firms expecting inflation above 3% (BoC Valet ABOVE3), Q2 2026 (2026-04-01 vintage) = 44.0%. Corroborated by the independently-sourced companion series data/raw/bos_dist_above3.csv (Valet INDINF_BOSOVER3_Q), same value. Both fetched 2026-07-20." },
      { phrase: "11%", source: "pipeline:boc:infl_exp_above3", note: "Same series, Q1 2026 (2026-01-01 vintage) = 11.0%." },
      { phrase: "the highest reading since late 2023", source: "derived", note: "True superlative per writing-style.md 4.1h: scanning data/raw/bos_dist_above3.csv back from the 2026-04-01 print of 44.0%, the most recent prior observation at or above 44.0% is 2023-10-01 at 54.0%; every quarter in between (2024-01-01 through 2026-01-01) printed below 44%. Compute: prior_above(bos_dist_above3, 44)." },
      { phrase: "fielded in late April and May", source: "card:boc_q2_2026_bos_csce_release", note: "BOS Q2 2026 field period May 1-21, 2026 (bankofcanada.ca/2026/07/business-outlook-survey-second-quarter-of-2026/); CSCE Q2 2026 field period April 27-May 21, 2026 with follow-up calls May 22-27 (bankofcanada.ca/2026/07/canadian-survey-of-consumer-expectations-second-quarter-of-2026/). Corrected 2026-07-20 fact-check round 2: original draft anachronistically attributed the survey move to the July ceasefire collapse, which happened three+ weeks after both surveys closed." },
      { phrase: "WTI crude toward $101 a barrel, up from roughly $65 before the conflict began", source: "card:boc_q2_2026_bos_csce_release", note: "BOS Q2 2026 release: WTI averaged US$101/bbl over the May 1-21 consultation period vs US$65/bbl Feb 1-27, 2026 before the war began. Independently corroborated against data/raw/wti.csv (Feb 2026 ~$64-67/bbl; May 1-21, 2026 well over $100/bbl, peak $108.66 on 2026-05-18)." },
      { phrase: "nearly three-quarters of firms reported the war had already raised their costs", source: "card:boc_q2_2026_bos_csce_release", note: "Verbatim finding from the BOS Q2 2026 report (bankofcanada.ca/2026/07/business-outlook-survey-second-quarter-of-2026/)." },
      { phrase: "June's CPI print cooled to 2.8%", source: "pipeline:statcan:18-10-0004-01", note: "Headline CPI NSA Y/Y, June 2026 = 2.798%, rounds to 2.8%. Same figure already verified on plate-1 of this page." },
    ],
  },
];

const pageTitle = "Inflation";
const pageDescription =
  "Canadian inflation chartbook: headline CPI, BoC preferred cores (trim and median), breadth, sub-aggregates, and inflation expectations.";

// Lede reads the same editorial blurb the auto-blurb pipeline writes for the
// splash tile (sections.ts -> section.blurb.body). Single source of truth: a
// release-day fan-out updates one field and both surfaces refresh.
const lede = section.blurb?.body ?? "";
---
<SectionLayout
  slug="inflation"
  sectionIndex={2}
  sectionLabel="Inflation"
  headlineQuestion={section.headlineQuestion}
  lede={lede}
  latestReleaseLabel={latestReleaseLabel}
  plates={plates}
  title={pageTitle}
  description={pageDescription}
/>
