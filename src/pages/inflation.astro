---
/*
 * Inflation - Vignelli chartbook page.
 *
 * Six plates per editorial canon section 4.2:
 *   01 Headline CPI
 *   02 BoC preferred core measures (core-trim, core-median)
 *   03 Breadth
 *   04 Sub-aggregates
 *   05 Inflation expectations
 *   06 Pass-through watch
 *
 * Each plate is a ChartbookUnit: real chart on the left, short
 * interpretation paragraph on the right, callout strip, source.
 * Charts dispatched via chartKey to src/components/charts/inflation/.
 *
 * v1: interpretation prose is placeholder, in publication voice.
 * Writer + style-editor refine on release day.
 */

import SectionLayout from "../layouts/SectionLayout.astro";
import type { Plate } from "../layouts/SectionLayout.astro";
import { sections } from "../data/sections";
import panelDataFile from "../../data/site/panel_data/inflation.json";
import { pickPanel } from "../components/charts/_shared/panelData";

const section = sections.find((s) => s.slug === "inflation");
if (!section) {
  throw new Error("Inflation section not found in src/data/sections.ts");
}

const panel1Data = pickPanel(panelDataFile, 1);
const panel2Data = pickPanel(panelDataFile, 2);
const panel3Data = pickPanel(panelDataFile, 3);
const panel4Data = pickPanel(panelDataFile, 4);
const panel5Data = pickPanel(panelDataFile, 5);
const panel6Data = pickPanel(panelDataFile, 6);

const plates: Plate[] = [
  {
    id: "plate-1",
    number: "01",
    indicator: "Headline CPI, year-over-year",
    plateIndexLabel: "Headline CPI",
    asOf: "TK",
    title: "Headline CPI printed TK in the latest month, TK relative to consensus.",
    interpretationHtml:
      "Headline CPI printed <strong>TK y/y</strong>, TK relative to consensus and TK relative to the prior month. " +
      "Shelter is still doing the heavy lifting; mortgage interest cost remains the largest single contributor. " +
      "Three-month annualized momentum sits a notch above the year-over-year, consistent with a flat near-term path.",
    callout: {
      value: "TK",
      unit: "year-over-year, TK",
      delta: "TK vs prior",
      direction: "neutral",
    },
    source:
      "Statistics Canada Table 18-10-0004-01; consensus via Bloomberg.",
    chartKey: "inflation-panel-1",
    data: panel1Data,
  },
  {
    id: "plate-2",
    number: "02",
    indicator: "BoC preferred core measures (core-trim, core-median)",
    plateIndexLabel: "Core trio",
    asOf: "TK",
    title: "Preferred cores reading TK; core-trim TK against prior month.",
    interpretationHtml:
      "Core-trim printed <strong>TK</strong> and core-median <strong>TK</strong>. " +
      "The 3-month annualized profile on both measures sits below the year-over-year, the cleanest sign yet that the underlying impulse is fading. " +
      "Common is shown for historical anchor only - the Bank has deprioritized it since late 2022.",
    callout: {
      value: "TK",
      unit: "core-trim, y/y, TK",
      delta: "TK vs prior",
      direction: "neutral",
    },
    source: "Statistics Canada Table 18-10-0256-01 (BoC preferred cores).",
    chartKey: "inflation-panel-2",
    data: panel2Data,
  },
  {
    id: "plate-3",
    number: "03",
    indicator: "Breadth of price pressure",
    plateIndexLabel: "Breadth",
    asOf: "TK",
    title: "Breadth narrowed; share of basket above 3% still clustered in shelter.",
    interpretation:
      "Roughly TK of the CPI basket is now running above 3% year-over-year, down from a peak above two thirds in 2022. " +
      "The remaining cluster is concentrated in shelter sub-components. Goods breadth has effectively normalized; services breadth is the open question.",
    source: "Statistics Canada Table 18-10-0004-01; component shares constructed.",
    chartKey: "inflation-panel-3",
    data: panel3Data,
  },
  {
    id: "plate-4",
    number: "04",
    indicator: "Sub-aggregates: shelter, services ex-shelter, goods, food, energy",
    plateIndexLabel: "Sub-aggregates",
    asOf: "TK",
    title: "Shelter and services-ex-shelter remain the only above-target lines.",
    interpretation:
      "Shelter is still printing well above the band and accounts for most of the gap to target. Services-ex-shelter is gradually easing but slowly. " +
      "Goods-ex-energy is at target and energy is roughly flat year-over-year. The residual stickiness is shelter-resolution-dependent.",
    source:
      "Statistics Canada Table 18-10-0004-01 (CPI sub-aggregates); ex- aggregates basket-weighted.",
    chartKey: "inflation-panel-4",
    data: panel4Data,
  },
  {
    id: "plate-5",
    number: "05",
    indicator: "Inflation expectations: CSCE + BOS",
    plateIndexLabel: "Expectations",
    asOf: "TK (CSCE, BOS)",
    title: "Consumer 1y expectations eased; BOS firms above 3% kept declining.",
    interpretationHtml:
      "The Bank's Canadian Survey of Consumer Expectations one-year measure eased to roughly <strong>TK</strong> from a higher prior print, " +
      "and the five-year measure held near <strong>TK</strong>. The share of BOS firms expecting CPI above 3% has been falling for several consecutive quarters - " +
      "still above the long-run baseline, but the direction is unambiguous.",
    source: "Bank of Canada CSCE and Business Outlook Survey, latest quarterly releases.",
    chartKey: "inflation-panel-5",
    data: panel5Data,
  },
  {
    id: "plate-6",
    number: "06",
    indicator: "Pass-through watch: FX and wages into goods / services",
    plateIndexLabel: "Pass-through",
    asOf: "TK (CPI); TK (FX)",
    title: "CAD weakness has not yet shown up in goods-ex-energy; wages still bite into services.",
    interpretation:
      "USDCAD has drifted weaker over the past year, but goods-ex-energy CPI has stayed near target - the FX pass-through window is open but quiet so far. " +
      "On the wage side, the gap between LFS-Micro wage growth and services-ex-shelter CPI has narrowed only modestly. " +
      "Interpretation is prose only; no regression in basics.",
    source:
      "Statistics Canada Tables 18-10-0004-01, 14-10-0064-01; BoC Valet FXUSDCAD.",
    chartKey: "inflation-panel-6",
    data: panel6Data,
  },
];

const pageTitle = "Inflation";
const pageDescription =
  "Inflation chartbook: headline CPI, BoC preferred cores, breadth, sub-aggregates, expectations, and FX / wage pass-through. " +
  "Sources: Statistics Canada, Bank of Canada.";

const lede =
  "Where prices sit relative to the Bank of Canada's 2% target: the headline print, the preferred cores, " +
  "the breadth of pressure across the basket, the sub-aggregate composition, expectations from households and firms, " +
  "and the FX and wage channels feeding pass-through.";
---
<SectionLayout
  slug="inflation"
  sectionIndex={2}
  sectionLabel="Inflation"
  headlineQuestion={section.headlineQuestion}
  lede={lede}
  latestReleaseLabel="Headline CPI, Mar 2026"
  plates={plates}
  title={pageTitle}
  description={pageDescription}
/>
