---
/*
 * Inflation - basics-layer section page (placeholder).
 *
 * Six panels per editorial canon section 4.2:
 *   1. Headline CPI
 *   2. Core trio
 *   3. Breadth
 *   4. Sub-aggregates
 *   5. Inflation expectations
 *   6. Pass-through watch
 *
 * Why this file is sparse:
 *   This is the navigation-skeleton placeholder. Writer + style-editor own
 *   panel titles, decks, callouts, and source citations. Backend pipeline
 *   owns vintage stamps and numeric values. Chart-builder hydrates chart
 *   slots. Frontend is reserving the structure: panel order, eyebrows,
 *   anchors, and the page shell.
 *
 * What this page is NOT:
 *   - A homepage (that is /).
 *   - A deep-dive (those rotate into separate pages under /inflation/...).
 *   - A chart canvas. Each panel reserves a chart slot with a dashed-border
 *     placeholder; chart-builder hydrates them later.
 *
 * Mirrors src/pages/gdp.astro structure; see that file for the worked
 * example with finished placeholder copy.
 */

import SectionLayout from "../layouts/SectionLayout.astro";
import type { Panel } from "../layouts/SectionLayout.astro";
import { sections } from "../data/sections";

const section = sections.find((s) => s.slug === "inflation");
if (!section) {
  throw new Error("Inflation section not found in src/data/sections.ts");
}

const pageAsOf = {
  label: "Placeholder release",
  releaseDate: "TBD",
};

// Panel placeholders. Eyebrows are the canonical EDR labels from
// editorial/dashboard_purpose.md section 4.2. Title / deck / source /
// methodology bodies are short scaffolding strings only - writer fills in.
const placeholderText = "Placeholder. Writer to populate.";
const placeholderMethodology = "Placeholder. Methodology to be documented by editorial.";
const placeholderSource = "Source citation TBD.";
const placeholderVintage = { releaseDate: "TBD" };

const panels: Panel[] = [
  {
    id: "panel-1",
    eyebrow: "Headline CPI",
    title: placeholderText,
    deck: placeholderText,
    vintage: placeholderVintage,
    editorialStatus: placeholderText,
    source: placeholderSource,
    methodology: { body: placeholderMethodology },
    chartKey: "inflation-panel-1",
  },
  {
    id: "panel-2",
    eyebrow: "Core trio",
    title: placeholderText,
    deck: placeholderText,
    vintage: placeholderVintage,
    editorialStatus: placeholderText,
    source: placeholderSource,
    methodology: { body: placeholderMethodology },
    chartKey: "inflation-panel-2",
  },
  {
    id: "panel-3",
    eyebrow: "Breadth",
    title: placeholderText,
    deck: placeholderText,
    vintage: placeholderVintage,
    editorialStatus: placeholderText,
    source: placeholderSource,
    methodology: { body: placeholderMethodology },
    chartKey: "inflation-panel-3",
  },
  {
    id: "panel-4",
    eyebrow: "Sub-aggregates",
    title: placeholderText,
    deck: placeholderText,
    vintage: placeholderVintage,
    editorialStatus: placeholderText,
    source: placeholderSource,
    methodology: { body: placeholderMethodology },
    chartKey: "inflation-panel-4",
  },
  {
    id: "panel-5",
    eyebrow: "Inflation expectations",
    title: placeholderText,
    deck: placeholderText,
    vintage: placeholderVintage,
    editorialStatus: placeholderText,
    source: placeholderSource,
    methodology: { body: placeholderMethodology },
    chartKey: "inflation-panel-5",
  },
  {
    id: "panel-6",
    eyebrow: "Pass-through watch",
    title: placeholderText,
    deck: placeholderText,
    vintage: placeholderVintage,
    editorialStatus: placeholderText,
    source: placeholderSource,
    methodology: { body: placeholderMethodology },
    chartKey: "inflation-panel-6",
  },
];

const pageTitle = "Inflation";
const pageDescription = `${section.headlineQuestion} The macro-research-department Inflation section: headline CPI, BoC preferred cores, breadth, sub-aggregates, expectations, and pass-through.`;
---
<SectionLayout
  slug="inflation"
  sectionIndex={2}
  sectionName="Inflation"
  sectionLabel={section.label}
  accentVar={section.accentVar}
  headlineQuestion={section.headlineQuestion}
  pageAsOf={pageAsOf}
  panels={panels}
  title={pageTitle}
  description={pageDescription}
/>
