---
import SectionLayout from "../layouts/SectionLayout.astro";
import type { Plate } from "../layouts/SectionLayout.astro";
import { sections } from "../data/sections";
import panelDataFile from "../../data/site/panel_data/inflation.json";
import sectionsJson from "../../data/site/sections.json";
import { pickPanel } from "../components/charts/_shared/panelData";
import { deriveLatestReleaseLabel } from "../components/section/_shared/derivedLabels";

const section = sections.find((s) => s.slug === "inflation");
if (!section) {
  throw new Error("Inflation section not found in src/data/sections.ts");
}

const latestReleaseLabel = deriveLatestReleaseLabel(
  section.latestReleasePrefix ?? "",
  sectionsJson,
  "inflation",
);

const panel1Data = pickPanel(panelDataFile, 1);
const panel2Data = pickPanel(panelDataFile, 2);
const panel3Data = pickPanel(panelDataFile, 3);
const panel4Data = pickPanel(panelDataFile, 4);
const panel5Data = pickPanel(panelDataFile, 5);

const plates: Plate[] = [
  {
    id: "plate-1",
    number: "01",
    indicator: "Headline CPI, m/m and Y/Y",
    plateIndexLabel: "Headline CPI",
    title: "Headline CPI moved above the control band in May.",
    interpretationHtml:
      "Headline inflation climbed to 3.2% year-over-year in May from 2.8% in April, with the unadjusted monthly move at 1.0%. " +
      "That puts the headline above the Bank of Canada's 1-to-3% control band. " +
      "The composition matters: the overshoot is energy-led, but the move is no longer just a one-month April pop.",
    callout: {
      value: "+3.2%",
      unitPrefix: "Y/Y",
      delta: "m/m +1.0%",
      direction: "pos",
    },
    source:
      "Statistics Canada Table 18-10-0004-01.",
    chartKey: "inflation-panel-1",
    data: panel1Data,
    citations: [
      { phrase: "3.2% year-over-year in May", source: "pipeline:statcan:18-10-0004-01", note: "Headline CPI NSA Y/Y, May 2026." },
      { phrase: "2.8% in April", source: "pipeline:statcan:18-10-0004-01", note: "Headline CPI NSA Y/Y, April 2026." },
      { phrase: "1.0%", source: "pipeline:statcan:18-10-0004-01", note: "Headline CPI m/m NSA, May 2026 = 0.9524%, rounds to 1.0%." },
      { phrase: "1-to-3% control band", source: "card:boc_inflation_mandate" },
    ],
  },
  {
    id: "plate-2",
    number: "02",
    indicator: "Core-trim and core-median, Y/Y",
    plateIndexLabel: "Preferred cores",
    title: "Core measures held near target even as headline broke higher.",
    interpretationHtml:
      "CPI-trim held at 2.0% in May and CPI-median held at 2.1%, unchanged from April. " +
      "Both measures sit within a tenth of the 2% target, so the Bank of Canada's preferred-core signal did not confirm the headline acceleration. " +
      "That keeps the policy question focused on persistence: whether energy leaks into broader prices and expectations.",
    callout: {
      value: "2.0%",
      unitPrefix: "core-trim, Y/Y",
      delta: "unchanged vs prior",
      direction: "neutral",
    },
    source: "Bank of Canada (CPI-trim, CPI-median).",
    chartKey: "inflation-panel-2",
    data: panel2Data,
    citations: [
      { phrase: "CPI-trim held at 2.0%", source: "pipeline:statcan:cpi_trim", note: "CPI-trim Y/Y, May 2026 (BoC Valet preferred-core series)." },
      { phrase: "CPI-median held at 2.1%", source: "pipeline:statcan:cpi_median", note: "CPI-median Y/Y, May 2026 (BoC Valet preferred-core series)." },
      { phrase: "unchanged from April", source: "pipeline:statcan:cpi_trim", note: "CPI-trim held at 2.0% from April to May 2026; CPI-median held at 2.1% from April to May 2026." },
      { phrase: "2% target", source: "card:boc_inflation_mandate" },
    ],
  },
  {
    id: "plate-3",
    number: "03",
    indicator: "Share of CPI basket above 3% Y/Y",
    plateIndexLabel: "Breadth",
    title: "Breadth widened, with 33.6% of the basket running above 3%.",
    interpretationHtml:
      "The valid-component breadth measure rose to 33.6% in May from 28.6% in April, while the BoC-recipe measure rose to 34.6%. " +
      "That is still far below the 2022 episode when more than two thirds of the basket cleared 3%, but the direction is no longer benign. " +
      "A narrow energy shock is becoming a broader watch item, not yet a generalized inflation episode.",
    callout: {
      value: "33.6%",
      unitPrefix: "share >3% Y/Y",
      delta: "+5.0pp vs prior",
      direction: "pos",
    },
    source: "Statistics Canada Table 18-10-0004-01; component shares constructed.",
    chartKey: "inflation-panel-3",
    data: panel3Data,
    citations: [
      { phrase: "rising faster than 3%", source: "derived", note: "Methodology threshold for the breadth measure: share of CPI components with Y/Y above 3.0% — the upper edge of the BoC 1-3% control band." },
      { phrase: "33.6% in May", source: "derived", note: "Share of valid CPI components with Y/Y > 3%, May 2026 = 33.5858%." },
      { phrase: "28.6% in April", source: "derived", note: "Share of valid CPI components with Y/Y > 3%, April 2026 = 28.5570%." },
      { phrase: "34.6%", source: "derived", note: "BoC-recipe breadth measure for components with Y/Y > 3%, May 2026 = 34.6134%." },
      { phrase: "2022 episode when more than two thirds of the basket cleared 3%", source: "derived", note: "Peak share of CPI components Y/Y > 3% during the 2022 inflation episode: 68.76% at Sept 2022 (also Aug 67.89%, Jul 67.09%, May 66.98%); constructed from StatCan 18-10-0004-01 component series." },
    ],
  },
  {
    id: "plate-4",
    number: "04",
    indicator: "Shelter, services, goods, food, energy, Y/Y",
    plateIndexLabel: "Sub-aggregates",
    title: "Energy and goods drove the May acceleration.",
    interpretationHtml:
      "Energy inflation rose to 22.2% year-over-year in May, and goods inflation rose to 4.8%. " +
      "The ex-energy read is much softer: goods excluding energy slowed to 0.7%, shelter held at 1.7%, services sat at 2.0%, and food ran at 3.8%. " +
      "The headline is above band, but the pressure is still concentrated in energy-sensitive goods rather than the full services/shelter core.",
    callout: {
      value: "22.2%",
      unitPrefix: "energy, Y/Y",
      delta: "+3.0pp vs prior",
      direction: "pos",
    },
    source:
      "Statistics Canada Table 18-10-0004-01 (CPI sub-aggregates).",
    chartKey: "inflation-panel-4",
    data: panel4Data,
    citations: [
      { phrase: "Energy inflation rose to 22.2%", source: "pipeline:statcan:18-10-0004-01", note: "Energy CPI Y/Y, May 2026 = 22.1753%." },
      { phrase: "goods inflation rose to 4.8%", source: "pipeline:statcan:18-10-0004-01", note: "Goods CPI Y/Y, May 2026 = 4.8143%." },
      { phrase: "goods excluding energy slowed to 0.7%", source: "pipeline:statcan:18-10-0004-01", note: "Goods excluding energy CPI Y/Y, May 2026 = 0.7147%; April 2026 = 0.9439%." },
      { phrase: "shelter held at 1.7%", source: "pipeline:statcan:18-10-0004-01", note: "Shelter CPI Y/Y, May 2026 = 1.7121%." },
      { phrase: "services sat at 2.0%", source: "pipeline:statcan:18-10-0004-01", note: "Services CPI Y/Y, May 2026 = 1.9683%." },
      { phrase: "food ran at 3.8%", source: "pipeline:statcan:18-10-0004-01", note: "Food CPI Y/Y, May 2026 = 3.7871%." },
    ],
  },
  {
    id: "plate-5",
    number: "05",
    indicator: "Consumer and firm inflation expectations",
    plateIndexLabel: "Expectations",
    title: "Expectations kept moderating as the headline jumped.",
    interpretationHtml:
      "Five-year consumer inflation expectations in the CSCE eased to 3.0% in Q1, down from a recent-cycle peak of 3.7% in mid-2025. " +
      "On the firm side, the share of businesses expecting inflation above 3% has collapsed to 11%, from around 40% as recently as early 2024. " +
      "Both anchors held while the headline reaccelerated &mdash; which is why the Bank of Canada can tolerate a brief blip above 2% without flinching on the rate path.",
    callout: {
      value: "3.0%",
      unit: "CSCE 5y consumer expectations, Q1 2026",
      delta: "vs 2% BoC target",
      direction: "neutral",
    },
    source: "Bank of Canada Canadian Survey of Consumer Expectations and Business Outlook Survey, Q1 2026.",
    chartKey: "inflation-panel-5",
    data: panel5Data,
    citations: [
      { phrase: "3.0% in Q1", source: "pipeline:boc:CES_C1_LONG_TERM", note: "CSCE 5y consumer inflation expectations, Q1 2026. BoC Valet series CES_C1_LONG_TERM (slot infl_exp_consumer_5y)." },
      { phrase: "peak of 3.7% in mid-2025", source: "pipeline:boc:CES_C1_LONG_TERM", note: "CSCE 5y series peak reading mid-2025; BoC Valet CES_C1_LONG_TERM." },
      { phrase: "above 3%", source: "card:boc_inflation_mandate", note: "Reference threshold is the upper edge of the BoC 1-3% control band." },
      { phrase: "collapsed to 11%", source: "pipeline:boc:ABOVE3", note: "Share of BOS firms expecting CPI above 3%, Q1 2026. BoC Valet ABOVE3 (slot infl_exp_above3)." },
      { phrase: "around 40%", source: "pipeline:boc:ABOVE3", note: "BOS share-above-3% peak reading, early 2024." },
      { phrase: "early 2024", source: "pipeline:boc:ABOVE3", note: "BOS share-above-3% time anchor for the prior peak." },
      { phrase: "above 2%", source: "card:boc_inflation_mandate", note: "Reference is the 2% midpoint of the BoC inflation-control target." },
    ],
  },
];

const pageTitle = "Inflation";
const pageDescription =
  "Canadian inflation chartbook: headline CPI, BoC preferred cores (trim and median), breadth, sub-aggregates, and inflation expectations.";

// Lede reads the same editorial blurb the auto-blurb pipeline writes for the
// splash tile (sections.ts -> section.blurb.body). Single source of truth: a
// release-day fan-out updates one field and both surfaces refresh.
const lede = section.blurb?.body ?? "";
---
<SectionLayout
  slug="inflation"
  sectionIndex={2}
  sectionLabel="Inflation"
  headlineQuestion={section.headlineQuestion}
  lede={lede}
  latestReleaseLabel={latestReleaseLabel}
  plates={plates}
  title={pageTitle}
  description={pageDescription}
/>
