---
import SectionLayout from "../layouts/SectionLayout.astro";
import type { Plate } from "../layouts/SectionLayout.astro";
import { sections } from "../data/sections";
import panelDataFile from "../../data/site/panel_data/inflation.json";
import sectionsJson from "../../data/site/sections.json";
import { pickPanel } from "../components/charts/_shared/panelData";
import { deriveLatestReleaseLabel } from "../components/section/_shared/derivedLabels";

const section = sections.find((s) => s.slug === "inflation");
if (!section) {
  throw new Error("Inflation section not found in src/data/sections.ts");
}

const latestReleaseLabel = deriveLatestReleaseLabel(
  section.latestReleasePrefix ?? "",
  sectionsJson,
  "inflation",
);

const panel1Data = pickPanel(panelDataFile, 1);
const panel2Data = pickPanel(panelDataFile, 2);
const panel3Data = pickPanel(panelDataFile, 3);
const panel4Data = pickPanel(panelDataFile, 4);
const panel5Data = pickPanel(panelDataFile, 5);

const plates: Plate[] = [
  {
    id: "plate-1",
    number: "01",
    indicator: "Headline CPI, m/m and Y/Y",
    plateIndexLabel: "Headline CPI",
    asOf: "Mar 2026",
    title: "Headline CPI reaccelerated to 2.3% in March, the upper half of the band.",
    interpretationHtml:
      "Headline inflation rose to 2.3% year-over-year in March from 1.8% in February, a 0.5-point jump that lifts CPI into the upper half of the 1-to-3% control band. " +
      "Prices climbed 0.5% on the month. " +
      "The three-month annualized run-rate sits near 2.9%, confirming the reacceleration is momentum, not a base effect.",
    callout: {
      value: "+2.3%",
      unitPrefix: "Y/Y",
      delta: "m/m +0.5%",
      direction: "pos",
    },
    source:
      "Statistics Canada Table 18-10-0004-01.",
    chartKey: "inflation-panel-1",
    data: panel1Data,
    citations: [
      { phrase: "2.3% year-over-year in March", source: "pipeline:statcan:18-10-0004-01", note: "Headline CPI Y/Y, latest print. Future: migrate to slot:cpi_all_items_yoy@latest once check_citation_coverage understands slot resolution." },
      { phrase: "1.8% in February", source: "pipeline:statcan:18-10-0004-01", note: "Headline CPI Y/Y, one print back. Future: migrate to slot:cpi_all_items_yoy@T-1." },
      { phrase: "0.5-point jump", source: "derived", note: "Latest vs prior headline Y/Y month-over-month change. Future: migrate to compute: cpi_all_items_yoy@latest - cpi_all_items_yoy@T-1." },
      { phrase: "1-to-3% control band", source: "card:boc_inflation_mandate" },
      { phrase: "0.5% on the month", source: "pipeline:statcan:18-10-0004-01", note: "Headline CPI m/m, March 2026." },
      { phrase: "near 2.9%", source: "derived", note: "Three-month annualized run-rate of headline CPI through March 2026, computed from monthly index from StatCan 18-10-0004-01." },
    ],
  },
  {
    id: "plate-2",
    number: "02",
    indicator: "Core-trim and core-median, Y/Y",
    plateIndexLabel: "Preferred cores",
    title: "Core measures held near target as headline reaccelerated.",
    interpretationHtml:
      "Core-trim eased to 2.2% in March and core-median held at 2.3% &mdash; both within a tenth of the 2% target and both lower than they were three months ago. " +
      "The headline reacceleration hasn't bled into the core measures, which is where the signal the Bank of Canada reads sits. " +
      "Core-common, once the anchor measure, has been deprioritized in the policy frame.",
    callout: {
      value: "2.2%",
      unitPrefix: "core-trim, Y/Y",
      delta: "-0.1pp vs prior",
      direction: "neg",
    },
    source: "Bank of Canada (CPI-trim, CPI-median, CPI-common).",
    chartKey: "inflation-panel-2",
    data: panel2Data,
    citations: [
      { phrase: "2.2% in March", source: "pipeline:boc:cpi_trim", note: "CPI-trim Y/Y, March 2026 (BoC Valet preferred-core series)." },
      { phrase: "2.3%", source: "pipeline:boc:cpi_median", note: "CPI-median Y/Y, March 2026 (BoC Valet preferred-core series)." },
      { phrase: "2% target", source: "card:boc_inflation_mandate" },
    ],
  },
  {
    id: "plate-3",
    number: "03",
    indicator: "Share of CPI basket above 3% Y/Y",
    plateIndexLabel: "Breadth",
    title: "Breadth widened in March: 27% of the basket runs above 3%.",
    interpretationHtml:
      "The share of CPI components rising faster than 3% year-over-year jumped to 28.0% in March from 23.0% in February &mdash; a 5.0-point move in a single print. " +
      "That's a real broadening, not a one-line distortion. " +
      "The level still sits well below the 2022 peak above two thirds of the basket, but the direction has turned.",
    callout: {
      value: "28.0%",
      unitPrefix: "share >3% Y/Y",
      delta: "+5.0pp vs prior",
      direction: "pos",
    },
    source: "Statistics Canada Table 18-10-0004-01; component shares constructed.",
    chartKey: "inflation-panel-3",
    data: panel3Data,
    citations: [
      { phrase: "27% of the basket runs above 3%", source: "derived", note: "Share of CPI components with Y/Y above 3.0%, March 2026; constructed from StatCan 18-10-0004-01 component-level Y/Y series." },
      { phrase: "rising faster than 3%", source: "derived", note: "Methodology threshold for the breadth measure: share of CPI components with Y/Y above 3.0% — the upper edge of the BoC 1-3% control band." },
      { phrase: "28.0% in March", source: "derived", note: "Share of CPI basket components with Y/Y > 3%, March 2026; constructed from StatCan 18-10-0004-01." },
      { phrase: "23.0% in February", source: "derived", note: "Share of CPI basket components with Y/Y > 3%, February 2026; constructed from StatCan 18-10-0004-01." },
      { phrase: "5.0-point move", source: "derived", note: "28.0% - 23.0% = 5.0pp (Mar vs Feb 2026 breadth share)." },
      { phrase: "2022 peak", source: "derived", note: "Peak share of CPI components Y/Y > 3% during the 2022 inflation episode; constructed from StatCan 18-10-0004-01 component series." },
      { phrase: "above two thirds of the basket", source: "derived", note: "2022 breadth peak exceeded ~67% of CPI components above 3% Y/Y; constructed from StatCan 18-10-0004-01." },
    ],
  },
  {
    id: "plate-4",
    number: "04",
    indicator: "Shelter, services, goods, food, energy, Y/Y",
    plateIndexLabel: "Sub-aggregates",
    title: "Composition flipped: food and energy now carry the overshoot, not shelter.",
    interpretationHtml:
      "Shelter inflation, the engine of the 2023-24 overshoot, has cooled to 1.7% &mdash; below the 2% target for a third straight month. " +
      "Services run at 2.5% and goods at 2.1%, both well-behaved. " +
      "The pressure has rotated to food at 4.0% and energy at 3.9%, the two components the Bank of Canada is most willing to look through. " +
      "The overshoot has migrated, not vanished.",
    callout: {
      value: "1.7%",
      unitPrefix: "shelter, Y/Y",
      delta: "+0.2pp vs prior",
      direction: "pos",
    },
    source:
      "Statistics Canada Table 18-10-0004-01 (CPI sub-aggregates).",
    chartKey: "inflation-panel-4",
    data: panel4Data,
    citations: [
      { phrase: "2023-24 overshoot", source: "pipeline:statcan:18-10-0004-01", note: "Shelter Y/Y peaked above 6% in 2023 and stayed above the 2% target through 2024 per CPI sub-aggregate series." },
      { phrase: "cooled to 1.7%", source: "pipeline:statcan:18-10-0004-01", note: "Shelter Y/Y, March 2026." },
      { phrase: "2% target", source: "card:boc_inflation_mandate" },
      { phrase: "third straight month", source: "pipeline:statcan:18-10-0004-01", note: "Shelter Y/Y prints below 2% in January, February, and March 2026 — enumerated from the monthly sub-aggregate series." },
      { phrase: "Services run at 2.5%", source: "pipeline:statcan:18-10-0004-01", note: "Services Y/Y, March 2026." },
      { phrase: "goods at 2.1%", source: "pipeline:statcan:18-10-0004-01", note: "Goods Y/Y, March 2026." },
      { phrase: "food at 4.0%", source: "pipeline:statcan:18-10-0004-01", note: "Food Y/Y, March 2026." },
      { phrase: "energy at 3.9%", source: "pipeline:statcan:18-10-0004-01", note: "Energy Y/Y, March 2026." },
    ],
  },
  {
    id: "plate-5",
    number: "05",
    indicator: "Consumer and firm inflation expectations",
    plateIndexLabel: "Expectations",
    asOf: "Q1 2026 (CSCE / BOS)",
    title: "Expectations kept moderating as the headline jumped.",
    interpretationHtml:
      "Five-year consumer inflation expectations in the CSCE eased to 3.0% in Q1, down from a recent-cycle peak of 3.7% in mid-2025. " +
      "On the firm side, the share of businesses expecting inflation above 3% has collapsed to 11%, from around 40% as recently as early 2024. " +
      "Both anchors held while the headline reaccelerated &mdash; which is why the Bank of Canada can tolerate a brief blip above 2% without flinching on the rate path.",
    callout: {
      value: "3.0%",
      unit: "CSCE 5y consumer expectations, Q1 2026",
      delta: "vs 2% BoC target",
      direction: "neutral",
    },
    source: "Bank of Canada Canadian Survey of Consumer Expectations and Business Outlook Survey, Q1 2026.",
    chartKey: "inflation-panel-5",
    data: panel5Data,
    citations: [
      { phrase: "3.0% in Q1", source: "pipeline:boc:CES_C1_LONG_TERM", note: "CSCE 5y consumer inflation expectations, Q1 2026. BoC Valet series CES_C1_LONG_TERM (slot infl_exp_consumer_5y)." },
      { phrase: "peak of 3.7% in mid-2025", source: "pipeline:boc:CES_C1_LONG_TERM", note: "CSCE 5y series peak reading mid-2025; BoC Valet CES_C1_LONG_TERM." },
      { phrase: "above 3%", source: "card:boc_inflation_mandate", note: "Reference threshold is the upper edge of the BoC 1-3% control band." },
      { phrase: "collapsed to 11%", source: "pipeline:boc:ABOVE3", note: "Share of BOS firms expecting CPI above 3%, Q1 2026. BoC Valet ABOVE3 (slot infl_exp_above3)." },
      { phrase: "around 40%", source: "pipeline:boc:ABOVE3", note: "BOS share-above-3% peak reading, early 2024." },
      { phrase: "early 2024", source: "pipeline:boc:ABOVE3", note: "BOS share-above-3% time anchor for the prior peak." },
      { phrase: "above 2%", source: "card:boc_inflation_mandate", note: "Reference is the 2% midpoint of the BoC inflation-control target." },
    ],
  },
];

const pageTitle = "Inflation";
const pageDescription =
  "Headline CPI, preferred cores, breadth, sub-aggregates, inflation expectations.";

// Lede reads the same editorial blurb the auto-blurb pipeline writes for the
// splash tile (sections.ts -> section.blurb.body). Single source of truth: a
// release-day fan-out updates one field and both surfaces refresh.
const lede = section.blurb?.body ?? "";
---
<SectionLayout
  slug="inflation"
  sectionIndex={2}
  sectionLabel="Inflation"
  headlineQuestion={section.headlineQuestion}
  lede={lede}
  latestReleaseLabel={latestReleaseLabel}
  plates={plates}
  title={pageTitle}
  description={pageDescription}
/>
