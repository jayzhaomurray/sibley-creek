---
import SectionLayout from "../layouts/SectionLayout.astro";
import type { Plate } from "../layouts/SectionLayout.astro";
import { sections } from "../data/sections";
import panelDataFile from "../../data/site/panel_data/inflation.json";
import sectionsJson from "../../data/site/sections.json";
import { pickPanel } from "../components/charts/_shared/panelData";
import { deriveLatestReleaseLabel } from "../components/section/_shared/derivedLabels";

const section = sections.find((s) => s.slug === "inflation");
if (!section) {
  throw new Error("Inflation section not found in src/data/sections.ts");
}

const latestReleaseLabel = deriveLatestReleaseLabel(
  section.latestReleasePrefix ?? "",
  sectionsJson,
  "inflation",
);

const panel1Data = pickPanel(panelDataFile, 1);
const panel2Data = pickPanel(panelDataFile, 2);
const panel3Data = pickPanel(panelDataFile, 3);
const panel4Data = pickPanel(panelDataFile, 4);
const panel5Data = pickPanel(panelDataFile, 5);

const plates: Plate[] = [
  {
    id: "plate-1",
    number: "01",
    indicator: "Headline CPI, m/m and Y/Y",
    plateIndexLabel: "Headline CPI",
    asOf: "Apr 2026",
    title: "Headline CPI rose to 2.8% in April on higher gasoline prices.",
    interpretationHtml:
      "Headline inflation climbed to 2.8% year-over-year in April from 2.4% in March, lifted by higher global energy prices tied to the war in Iran. " +
      "The print came in below the 3.1% consensus, and the monthly move was modest at 0.4% unadjusted and 0.3% seasonally adjusted. " +
      "Headline remains inside the 1-to-3% control band, and the source of the lift is an energy shock the Bank of Canada can look through.",
    callout: {
      value: "+2.8%",
      unitPrefix: "Y/Y",
      delta: "m/m +0.4%",
      direction: "pos",
    },
    source:
      "Statistics Canada Table 18-10-0004-01.",
    chartKey: "inflation-panel-1",
    data: panel1Data,
    citations: [
      { phrase: "2.8% year-over-year in April", source: "pipeline:statcan:18-10-0004-01", note: "Headline CPI NSA Y/Y, April 2026." },
      { phrase: "2.4% in March", source: "pipeline:statcan:18-10-0004-01", note: "Headline CPI NSA Y/Y, March 2026 (one print back)." },
      { phrase: "war in Iran", source: "card:iran_oil_conflict_2026_05", note: "Geopolitical attribution for April energy-price lift; Tier B card pending user_confirmed_at." },
      { phrase: "3.1% consensus", source: "card:economist_consensus_april_2026_cpi", note: "Consensus expected 3.1% Y/Y for April headline CPI. Mode 2 aggregated consensus citation; source-card pending." },
      { phrase: "0.4% unadjusted", source: "pipeline:statcan:18-10-0004-01", note: "Headline CPI m/m NSA, April 2026 (per April 2026 release commentary; pipeline m/m NSA derivation to be slotted via _derived_slot_queue)." },
      { phrase: "0.3% seasonally adjusted", source: "pipeline:statcan:18-10-0006-01", note: "Headline CPI m/m SA, April 2026 (per April 2026 release commentary; SA level refresh pending — flag to fact-checker)." },
      { phrase: "1-to-3% control band", source: "card:boc_inflation_mandate" },
    ],
  },
  {
    id: "plate-2",
    number: "02",
    indicator: "Core-trim and core-median, Y/Y",
    plateIndexLabel: "Preferred cores",
    asOf: "Apr 2026",
    title: "Core measures ticked down in April, closer to the 2% target.",
    interpretationHtml:
      "Core-trim fell to 2.0% in April and core-median to 2.1%, each two-tenths lower than March and lower again than three months ago. " +
      "Both measures now sit within a tenth of the 2% target &mdash; effectively where the Bank of Canada wants them. " +
      "The energy lift in headline has not bled into the underlying signal — the only read that matters for the rate path.",
    callout: {
      value: "2.0%",
      unitPrefix: "core-trim, Y/Y",
      delta: "-0.2pp vs prior",
      direction: "neg",
    },
    source: "Bank of Canada (CPI-trim, CPI-median).",
    chartKey: "inflation-panel-2",
    data: panel2Data,
    citations: [
      { phrase: "2.0% in April", source: "pipeline:statcan:cpi_trim", note: "CPI-trim Y/Y, April 2026 (BoC Valet preferred-core series)." },
      { phrase: "core-median to 2.1%", source: "pipeline:statcan:cpi_median", note: "CPI-median Y/Y, April 2026 (BoC Valet preferred-core series)." },
      { phrase: "two-tenths lower than March", source: "pipeline:statcan:cpi_trim", note: "CPI-trim 2.2% (Mar) -> 2.0% (Apr) = -0.2pp; CPI-median 2.3% (Mar) -> 2.1% (Apr) = -0.2pp." },
      { phrase: "lower again than three months ago", source: "pipeline:statcan:cpi_trim", note: "Both trim and median ran higher in January 2026 than they print in April 2026; BoC Valet preferred-core series." },
      { phrase: "2% target", source: "card:boc_inflation_mandate" },
    ],
  },
  {
    id: "plate-3",
    number: "03",
    indicator: "Share of CPI basket above 3% Y/Y",
    plateIndexLabel: "Breadth",
    asOf: "Apr 2026",
    title: "Breadth remains narrow, with 29% of the basket running above 3%.",
    interpretationHtml:
      "The share of CPI components rising faster than 3% year-over-year sits at 29% in April, narrower than March's 30% and well below the 2022 episode when more than two thirds of the basket cleared that line. " +
      "Pressure is concentrated, not diffuse &mdash; a mix the Bank of Canada can read as a relative-price story rather than a generalized one.",
    callout: {
      value: "29%",
      unitPrefix: "share >3% Y/Y",
      delta: "-1pp vs prior",
      direction: "neg",
    },
    source: "Statistics Canada Table 18-10-0004-01; component shares constructed.",
    chartKey: "inflation-panel-3",
    data: panel3Data,
    citations: [
      { phrase: "rising faster than 3%", source: "derived", note: "Methodology threshold for the breadth measure: share of CPI components with Y/Y above 3.0% — the upper edge of the BoC 1-3% control band." },
      { phrase: "29% in April", source: "derived", note: "Share of CPI basket components with Y/Y > 3%, April 2026 = 29.43% rounds to 29%; constructed from StatCan 18-10-0004-01 component-level Y/Y series." },
      { phrase: "narrower than March's 30%", source: "derived", note: "March 2026 = 30.47% rounds to 30%; April narrowed -1pp from March." },
      { phrase: "2022 episode when more than two thirds of the basket cleared that line", source: "derived", note: "Peak share of CPI components Y/Y > 3% during the 2022 inflation episode: 68.76% at Sept 2022 (also Aug 67.89%, Jul 67.09%, May 66.98%); constructed from StatCan 18-10-0004-01 component series." },
    ],
  },
  {
    id: "plate-4",
    number: "04",
    indicator: "Shelter, services, goods, food, energy, Y/Y",
    plateIndexLabel: "Sub-aggregates",
    asOf: "Apr 2026",
    title: "Gas and energy drove April's lift while the rest of the basket stayed soft.",
    interpretationHtml:
      "Energy ran at 19.2% year-over-year in April on higher global oil and gasoline prices, the source of nearly all of the headline acceleration. " +
      "The rest of the basket is well-behaved: shelter at 1.8% is a fourth straight month below the 2% target, services eased to 1.7%, food slowed to 3.5%, and goods at 4.4% looks hot only because energy sits inside it &mdash; strip those components and goods inflation is mild. " +
      "That mix is why the Bank of Canada can absorb an energy-driven headline without changing course.",
    callout: {
      value: "19.2%",
      unitPrefix: "energy, Y/Y",
      delta: "+15.4pp vs prior",
      direction: "pos",
    },
    source:
      "Statistics Canada Table 18-10-0004-01 (CPI sub-aggregates).",
    chartKey: "inflation-panel-4",
    data: panel4Data,
    citations: [
      { phrase: "Energy ran at 19.2%", source: "pipeline:statcan:18-10-0004-01", note: "Energy Y/Y, April 2026." },
      { phrase: "higher global oil and gasoline prices", source: "card:iran_oil_conflict_2026_05", note: "Geopolitical attribution for April energy-price lift; Tier B card pending user_confirmed_at." },
      { phrase: "shelter at 1.8%", source: "pipeline:statcan:18-10-0004-01", note: "Shelter Y/Y, April 2026." },
      { phrase: "fourth straight month below the 2% target", source: "pipeline:statcan:18-10-0004-01", note: "Shelter Y/Y prints below 2% in January (1.7%), February (1.5%), March (1.7%), April (1.8%) 2026; enumerated from monthly sub-aggregate series." },
      { phrase: "2% target", source: "card:boc_inflation_mandate" },
      { phrase: "services eased to 1.7%", source: "pipeline:statcan:18-10-0004-01", note: "Services Y/Y, April 2026 (1.65% rounds to 1.7%); March was 2.5%." },
      { phrase: "food slowed to 3.5%", source: "pipeline:statcan:18-10-0004-01", note: "Food Y/Y, April 2026 (3.50% rounds to 3.5%); March was 4.0%." },
      { phrase: "Goods at 4.4%", source: "pipeline:statcan:18-10-0004-01", note: "Goods Y/Y, April 2026 (4.42% rounds to 4.4%); March was 2.1%. The Y/Y lift sits inside the energy components of the goods aggregate." },
    ],
  },
  {
    id: "plate-5",
    number: "05",
    indicator: "Consumer and firm inflation expectations",
    plateIndexLabel: "Expectations",
    asOf: "Q1 2026 (CSCE / BOS)",
    title: "Expectations kept moderating as the headline jumped.",
    interpretationHtml:
      "Five-year consumer inflation expectations in the CSCE eased to 3.0% in Q1, down from a recent-cycle peak of 3.7% in mid-2025. " +
      "On the firm side, the share of businesses expecting inflation above 3% has collapsed to 11%, from around 40% as recently as early 2024. " +
      "Both anchors held while the headline reaccelerated &mdash; which is why the Bank of Canada can tolerate a brief blip above 2% without flinching on the rate path.",
    callout: {
      value: "3.0%",
      unit: "CSCE 5y consumer expectations, Q1 2026",
      delta: "vs 2% BoC target",
      direction: "neutral",
    },
    source: "Bank of Canada Canadian Survey of Consumer Expectations and Business Outlook Survey, Q1 2026.",
    chartKey: "inflation-panel-5",
    data: panel5Data,
    citations: [
      { phrase: "3.0% in Q1", source: "pipeline:boc:CES_C1_LONG_TERM", note: "CSCE 5y consumer inflation expectations, Q1 2026. BoC Valet series CES_C1_LONG_TERM (slot infl_exp_consumer_5y)." },
      { phrase: "peak of 3.7% in mid-2025", source: "pipeline:boc:CES_C1_LONG_TERM", note: "CSCE 5y series peak reading mid-2025; BoC Valet CES_C1_LONG_TERM." },
      { phrase: "above 3%", source: "card:boc_inflation_mandate", note: "Reference threshold is the upper edge of the BoC 1-3% control band." },
      { phrase: "collapsed to 11%", source: "pipeline:boc:ABOVE3", note: "Share of BOS firms expecting CPI above 3%, Q1 2026. BoC Valet ABOVE3 (slot infl_exp_above3)." },
      { phrase: "around 40%", source: "pipeline:boc:ABOVE3", note: "BOS share-above-3% peak reading, early 2024." },
      { phrase: "early 2024", source: "pipeline:boc:ABOVE3", note: "BOS share-above-3% time anchor for the prior peak." },
      { phrase: "above 2%", source: "card:boc_inflation_mandate", note: "Reference is the 2% midpoint of the BoC inflation-control target." },
    ],
  },
];

const pageTitle = "Inflation";
const pageDescription =
  "Headline CPI, preferred cores, breadth, sub-aggregates, inflation expectations.";

// Lede reads the same editorial blurb the auto-blurb pipeline writes for the
// splash tile (sections.ts -> section.blurb.body). Single source of truth: a
// release-day fan-out updates one field and both surfaces refresh.
const lede = section.blurb?.body ?? "";
---
<SectionLayout
  slug="inflation"
  sectionIndex={2}
  sectionLabel="Inflation"
  headlineQuestion={section.headlineQuestion}
  lede={lede}
  latestReleaseLabel={latestReleaseLabel}
  plates={plates}
  title={pageTitle}
  description={pageDescription}
/>
