---
import SectionLayout from "../layouts/SectionLayout.astro";
import type { Plate } from "../layouts/SectionLayout.astro";
import { sections } from "../data/sections";
import panelDataFile from "../../data/site/panel_data/inflation.json";
import { pickPanel } from "../components/charts/_shared/panelData";

const section = sections.find((s) => s.slug === "inflation");
if (!section) {
  throw new Error("Inflation section not found in src/data/sections.ts");
}

const panel1Data = pickPanel(panelDataFile, 1);
const panel2Data = pickPanel(panelDataFile, 2);
const panel3Data = pickPanel(panelDataFile, 3);
const panel4Data = pickPanel(panelDataFile, 4);
const panel5Data = pickPanel(panelDataFile, 5);
const panel6Data = pickPanel(panelDataFile, 6);

const plates: Plate[] = [
  {
    id: "plate-1",
    number: "01",
    indicator: "Headline CPI, Y/Y",
    plateIndexLabel: "Headline CPI",
    asOf: "Mar 2026",
    title: "Headline CPI back to 2.3%, with three-month momentum running hotter",
    interpretationHtml:
      "Headline CPI rose <strong>2.3% Y/Y</strong> in March, up 0.5pp from February's 1.8% and back above the BoC's 2% target. " +
      "The three-month annualized print, near 2.9%, is running above the Y/Y &mdash; the bounce in February's index has carried through. " +
      "Food and energy contributed most of the reacceleration; shelter no longer leads.",
    callout: {
      value: "2.3%",
      unit: "Y/Y, Mar 2026",
      delta: "+0.5pp vs prior",
      direction: "pos",
    },
    source:
      "Statistics Canada Table 18-10-0004-01.",
    chartKey: "inflation-panel-1",
    data: panel1Data,
  },
  {
    id: "plate-2",
    number: "02",
    indicator: "Core-trim and core-median, Y/Y",
    plateIndexLabel: "Preferred cores",
    asOf: "Mar 2026",
    title: "Core-trim ticks down to 2.2%; core-median holds at 2.3%",
    interpretationHtml:
      "Core-trim eased to <strong>2.2% Y/Y</strong> in March, down 0.1pp from February. Core-median held at <strong>2.3%</strong>. " +
      "Both preferred measures now sit inside the BoC's 1-3% control band and within 0.3pp of the 2% midpoint &mdash; the underlying disinflation has held even as headline turned. " +
      "Core-common, shown as historical anchor, prints 2.6%; the BoC has deprioritized it since late 2022.",
    callout: {
      value: "2.2%",
      unit: "core-trim, Y/Y, Mar 2026",
      delta: "-0.1pp vs prior",
      direction: "neg",
    },
    source: "Bank of Canada (CPI-trim, CPI-median, CPI-common).",
    chartKey: "inflation-panel-2",
    data: panel2Data,
  },
  {
    id: "plate-3",
    number: "03",
    indicator: "Share of CPI basket above 3% Y/Y",
    plateIndexLabel: "Breadth",
    asOf: "Mar 2026",
    title: "Breadth widens: a quarter of the basket back above 3%",
    interpretationHtml:
      "The share of CPI components rising more than 3% Y/Y jumped to <strong>27.2%</strong> in March from 22.3% in February &mdash; a 4.9pp widening and the first meaningful breadth expansion since late 2025. " +
      "The level is still well below the 2022 peak above two thirds, but the direction matches the headline reacceleration. " +
      "Whether March marks a one-month spike or the start of a broader re-firming is the read to track in April.",
    callout: {
      value: "27.2%",
      unit: "share >3% Y/Y, Mar 2026",
      delta: "+4.9pp vs prior",
      direction: "pos",
    },
    source: "Statistics Canada Table 18-10-0004-01; component shares constructed.",
    chartKey: "inflation-panel-3",
    data: panel3Data,
  },
  {
    id: "plate-4",
    number: "04",
    indicator: "Shelter, services, goods, food, energy, Y/Y",
    plateIndexLabel: "Sub-aggregates",
    asOf: "Mar 2026",
    title: "Food and energy now lead; shelter has rolled below target",
    interpretationHtml:
      "Food rose <strong>4.0% Y/Y</strong> and energy <strong>3.9%</strong> in March &mdash; the two above-target lines and the bulk of the headline reacceleration. " +
      "Shelter has cooled to 1.7% as mortgage-interest cost faded to 0.7% and rent slowed to 0.9%; the line that drove the 2023-24 overshoot is no longer a source of pressure. " +
      "Services held at 2.5%, goods at 2.1%. The composition has flipped: the stickiness that remains is in food and energy, not housing.",
    callout: {
      value: "1.7%",
      unit: "shelter, Y/Y, Mar 2026",
      delta: "+0.2pp vs prior",
      direction: "pos",
    },
    source:
      "Statistics Canada Table 18-10-0004-01 (CPI sub-aggregates).",
    chartKey: "inflation-panel-4",
    data: panel4Data,
  },
  {
    id: "plate-5",
    number: "05",
    indicator: "Consumer and firm inflation expectations",
    plateIndexLabel: "Expectations",
    asOf: "Q1 2026",
    title: "Firm expectations keep falling; consumer one-year still sticky near 4%",
    interpretationHtml:
      "The Canadian Survey of Consumer Expectations one-year measure held at <strong>4.0%</strong> in Q1 2026, essentially unchanged from 4.1% in Q4 and well above realized CPI. The five-year measure eased to <strong>3.0%</strong>. " +
      "The share of Business Outlook Survey firms expecting CPI above 3% fell to <strong>11%</strong> from 16% in Q4 &mdash; the lowest reading since 2021 and a third of its mid-2024 level. " +
      "Firms have largely re-anchored; consumers have not yet followed.",
    callout: {
      value: "11%",
      unit: "BOS firms expecting CPI >3%, Q1 2026",
      delta: "-5pp vs prior",
      direction: "neg",
    },
    source: "Bank of Canada Canadian Survey of Consumer Expectations and Business Outlook Survey, Q1 2026.",
    chartKey: "inflation-panel-5",
    data: panel5Data,
  },
  {
    id: "plate-6",
    number: "06",
    indicator: "FX and wage pass-through into goods and services",
    plateIndexLabel: "Pass-through",
    asOf: "Pending wiring",
    title: "Pass-through panel awaits the ex-energy and ex-shelter derivations",
    interpretation:
      "Pairs the FX channel (USDCAD Y/Y against goods-ex-energy CPI) with the wage channel (LFS-Micro wage growth against services-ex-shelter CPI). The two basket-weighted ex-aggregates are not yet in the processed tier; the chart renders once the derivations land.",
    source:
      "Pending: Statistics Canada Tables 18-10-0004-01, 14-10-0064-01; BoC Valet FXUSDCAD.",
    chartKey: "inflation-panel-6",
    data: panel6Data,
  },
];

const pageTitle = "Inflation";
const pageDescription =
  "Inflation chartbook: headline CPI, BoC preferred cores, breadth, sub-aggregates, expectations, and FX / wage pass-through. " +
  "Sources: Statistics Canada, Bank of Canada.";

const lede =
  "Where prices sit relative to the Bank of Canada's 2% target: the headline print, the preferred cores, " +
  "the breadth of pressure across the basket, the sub-aggregate composition, expectations from households and firms, " +
  "and the FX and wage channels feeding pass-through.";
---
<SectionLayout
  slug="inflation"
  sectionIndex={2}
  sectionLabel="Inflation"
  headlineQuestion={section.headlineQuestion}
  lede={lede}
  latestReleaseLabel="Headline CPI, Mar 2026"
  plates={plates}
  title={pageTitle}
  description={pageDescription}
/>
