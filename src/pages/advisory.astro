---
/*
 * /advisory/ — Hire Sibley Creek (renamed from /work-with-us/ on 2026-05-21).
 *
 * The old /work-with-us/ route now meta-refreshes here for SEO continuity.
 * Body copy rewritten 2026-05-22 around the staff-augmentation framing
 * and the three engagement shapes (retainer / project / one-off).
 *
 * Pricing is deliberately NOT shown. "Custom-quoted" framing per the
 * Capital Economics model. Pricing happens in conversation.
 */

import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/sections";

const pageDesc =
  "Hire Sibley Creek for institutional Canadian macroeconomic research and " +
  "advisory engagements — retainer, project, or one-off. Get in touch.";
---
<BaseLayout
  title={`Hire Sibley Creek — ${site.name}`}
  description={pageDesc}
  pageClass="advisory-page"
  showMastheadRail={true}
>
  <article class="wwu">
    <header class="wwu__header">
      <h1 class="wwu__title">Hire Sibley Creek.</h1>
    </header>

    <section class="wwu__intro">
      <p>
        Sibley Creek is an independent Canadian macroeconomic research and advisory firm. We work with in-house economics teams running close to capacity, extending bandwidth on Canadian inflation, monetary policy, fiscal policy, trade pass-through, and sector-level effects. We also work with firms whose generalist coverage runs into a Canada-specific gap project work can fill.
      </p>
      <p>
        Engagements are scoped to the client's questions: what you need to understand, how often, in what format, and for which decisions. Pricing is set in conversation against that scope.
      </p>
    </section>

    <section class="wwu__engagements">
      <h2 class="wwu__section-title">How we engage</h2>

      <div class="wwu__engagement">
        <h3 class="wwu__engagement-title">Retainer — continuous bandwidth</h3>
        <p>
          For in-house teams of one to three economists already in place and stretched. We pick up the work the desk does not have hours for and stay close to the client's recurring questions over the quarter.
        </p>
        <ul class="wwu__list">
          <li>Same-day commentary on every major Canadian data release and Bank of Canada decision</li>
          <li>On-call Q&amp;A on macroeconomic questions affecting the business</li>
          <li>Monthly outlooks tailored to the client's portfolio of issues</li>
          <li>Board-level briefings ahead of policy moments</li>
        </ul>
      </div>

      <div class="wwu__engagement">
        <h3 class="wwu__engagement-title">Project — defined scope</h3>
        <p>
          For teams whose generalist coverage runs into a specific Canada-macro gap. Defined scope, defined deliverables, defined timeline.
        </p>
        <ul class="wwu__list">
          <li>Scenario modelling and custom forecasting</li>
          <li>Sector deep-dives and regional cuts</li>
          <li>Trade pass-through and policy-impact studies</li>
          <li>Expert-witness and regulatory-filing inputs</li>
        </ul>
      </div>

      <div class="wwu__engagement">
        <h3 class="wwu__engagement-title">One-off — specific outputs</h3>
        <p>
          For clients who need a single deliverable in a defined window.
        </p>
        <ul class="wwu__list">
          <li>White papers authored under client byline</li>
          <li>Board and executive presentations</li>
          <li>Training sessions for internal teams</li>
          <li>Conference and panel appearances</li>
        </ul>
      </div>
    </section>

    <section class="wwu__clients">
      <h2 class="wwu__section-title">Who we work with</h2>
      <p>
        Hedge funds and asset managers. Family offices. Trade associations and industry groups. Wealth managers. Government relations and public affairs firms. Exporters. Real estate developers. Pensions, endowments, and foundations. Crown corporations.
      </p>
    </section>

    <section class="wwu__methodology">
      <h2 class="wwu__section-title">How we work</h2>
      <p>
        Sibley Creek's research method combines disciplined data analysis with ground-truth reporting. We start with the data: simple statistics, clear visualizations, and the questions the data raises. Then we triangulate — talking to the people closest to the process being studied, not just the conventional aggregate experts. The output is a thoughtful, well-researched, fact-checked, opinionated, and pleasant-to-read answer to the client's specific question.
      </p>
    </section>

    <section class="wwu__contact">
      <h2 class="wwu__section-title">Get in touch</h2>
      <p>
        Send a brief note below — Jay will reply within one business day to schedule. Or book directly if you prefer.
      </p>

      <form
        class="wwu__prebrief-form"
        action="https://formsubmit.co/ajax/jay@sibleycreek.ca"
        method="POST"
        data-formsubmit-ajax
        data-formsubmit-replace-section
        data-success-msg="Thanks. Jay will reply within 1 business day to schedule."
      >
        <input type="hidden" name="_subject" value="Sibley advisory inquiry (pre-call brief)" />
        <input type="hidden" name="source" value="advisory_prebrief" />
        <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />

        <div class="wwu__field">
          <label class="wwu__label" for="advisory-name">Name</label>
          <input
            class="wwu__input"
            type="text"
            id="advisory-name"
            name="name"
            autocomplete="name"
            required
          />
        </div>

        <div class="wwu__field">
          <label class="wwu__label" for="advisory-org">Organization</label>
          <input
            class="wwu__input"
            type="text"
            id="advisory-org"
            name="organization"
            autocomplete="organization"
            required
          />
        </div>

        <div class="wwu__field">
          <label class="wwu__label" for="advisory-question">
            What would you like to discuss?
            <span class="wwu__label-hint">One or two sentences is enough.</span>
          </label>
          <textarea
            class="wwu__input wwu__input--textarea"
            id="advisory-question"
            name="message"
            rows="4"
            required
          ></textarea>
        </div>

        <div class="wwu__field">
          <label class="wwu__label" for="advisory-email">Email</label>
          <input
            class="wwu__input"
            type="email"
            id="advisory-email"
            name="email"
            autocomplete="email"
            required
          />
        </div>

        <button class="wwu__prebrief-submit" type="submit">Send &rarr;</button>
      </form>

      <p class="wwu__direct-book">
        Or book directly:
        <a
          href="https://calendar.app.google/TUWHM2Xtg7gvVKj5A"
          target="_blank"
          rel="noopener noreferrer"
        >30-minute discovery call &rarr;</a>
      </p>

      <p class="wwu__contact-fallback">
        Prefer email? Reach Jay directly at <a href="mailto:jay@sibleycreek.ca">jay@sibleycreek.ca</a>.
      </p>
    </section>
  </article>

  <style>
    .wwu {
      max-width: 720px;
      margin: 0 auto;
      padding: 32px 24px 64px 24px;
    }
    .wwu__header {
      border-bottom: 1px solid var(--ink);
      padding-bottom: 24px;
      margin-bottom: 32px;
    }
    .wwu__title {
      font-family: var(--font-sans);
      font-size: 42px;
      font-weight: var(--fw-semibold);
      line-height: 1.1;
      margin: 0;
      color: var(--ink);
    }

    .wwu__intro {
      margin-bottom: 40px;
    }
    .wwu__intro p {
      font-family: var(--font-sans);
      font-size: 18px;
      line-height: 1.55;
      color: var(--ink);
      margin: 0 0 16px 0;
    }

    .wwu__section-title {
      font-family: var(--font-sans);
      font-size: 14px;
      font-weight: var(--fw-semibold);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      margin: 0 0 16px 0;
      color: var(--ink);
      padding-bottom: 8px;
      border-bottom: 1px solid var(--ink);
    }

    .wwu__engagements,
    .wwu__clients,
    .wwu__methodology,
    .wwu__contact {
      margin-bottom: 40px;
    }

    .wwu__engagement {
      margin: 0 0 28px 0;
    }
    .wwu__engagement:last-child {
      margin-bottom: 0;
    }
    .wwu__engagement-title {
      font-family: var(--font-sans);
      font-size: 17px;
      font-weight: var(--fw-semibold);
      line-height: 1.3;
      margin: 0 0 8px 0;
      color: var(--ink);
    }
    .wwu__engagement p {
      font-family: var(--font-sans);
      font-size: 16px;
      line-height: 1.55;
      color: var(--ink);
      margin: 0 0 12px 0;
    }

    .wwu__clients p {
      font-family: var(--font-sans);
      font-size: 16px;
      line-height: 1.6;
      color: var(--ink);
      margin: 0;
    }

    .wwu__list {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .wwu__list li {
      font-family: var(--font-sans);
      font-size: 16px;
      line-height: 1.5;
      padding: 8px 0;
      border-bottom: 1px solid var(--ink);
      border-bottom-color: rgba(21, 23, 26, 0.15);
      color: var(--ink);
    }
    .wwu__list li:last-child {
      border-bottom: none;
    }

    .wwu__methodology p,
    .wwu__contact p {
      font-family: var(--font-sans);
      font-size: 16px;
      line-height: 1.55;
      color: var(--ink);
      margin: 0 0 14px 0;
    }

    /* Pre-call brief form */
    .wwu__prebrief-form {
      display: flex;
      flex-direction: column;
      gap: 22px;
      margin: 24px 0 28px;
    }
    .wwu__field {
      display: flex;
      flex-direction: column;
      gap: 7px;
    }
    .wwu__label {
      font-family: var(--font-sans);
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--ink);
      display: flex;
      flex-direction: column;
      gap: 3px;
    }
    .wwu__label-hint {
      font-weight: 400;
      font-size: 12px;
      letter-spacing: 0.04em;
      text-transform: none;
      opacity: 0.55;
    }
    .wwu__input {
      font-family: var(--font-sans);
      font-size: 15px;
      font-weight: 400;
      line-height: 1.4;
      padding: 12px 14px;
      border: 1px solid var(--ink);
      background: var(--paper);
      color: var(--ink);
      width: 100%;
    }
    .wwu__input:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 1px;
    }
    .wwu__input--textarea {
      resize: vertical;
      min-height: 110px;
    }
    .wwu__prebrief-submit {
      align-self: flex-start;
      padding: 14px 26px;
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 12px;
      line-height: 1;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--paper);
      background: var(--ink);
      border: 1px solid var(--ink);
      cursor: pointer;
      transition: background 80ms linear, color 80ms linear;
    }
    .wwu__prebrief-submit:hover {
      background: var(--paper);
      color: var(--ink);
    }
    .wwu__prebrief-submit:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }

    /* "Or book directly" secondary link */
    .wwu__direct-book {
      font-family: var(--font-sans);
      font-size: 14px;
      font-weight: 400;
      color: var(--ink);
      margin: 0 0 12px;
    }
    .wwu__direct-book a {
      color: var(--ink);
      text-decoration: none;
      border-bottom: 1px solid var(--ink);
      transition: border-color 80ms linear;
    }
    .wwu__direct-book a:hover {
      border-bottom-color: var(--accent);
      color: var(--accent);
    }

    .wwu__contact-fallback {
      font-size: 13px;
      opacity: 0.7;
    }
  </style>
</BaseLayout>
