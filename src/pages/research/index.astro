---
/*
 * /research/ — research index. Two sections:
 *   1. Data commentary — same-day PDF notes on every major Canadian print.
 *      Sourced from `commentaries` in src/data/sections.ts.
 *   2. Deep dives — long-form research pieces. Sourced from `deepDives`.
 *
 * DEFERRED: tab navigation (Recent / Commentaries / Deep dives). Plan
 * lives in memory at project_research_tab_nav_phase3.md. Trigger: 3rd
 * distinct content series, OR a single archive crossing ~50 items.
 * Until then, the two-section split below does the same job with less
 * chrome. Surface the memory note when revisiting research scaling.
 *
 * Visual register: boutique (matches /about/, /work-with-us/, /contact/,
 * /methodology/, /subscribe/). 720px max-width, 32/24/64 padding,
 * bare "Sibley Creek" eyebrow, 42px Manrope 600 H1, 1px ink header
 * border-bottom. Section subheads use the 14px uppercase + hairline-
 * border-bottom pattern.
 *
 * Each row in either list is a single click target. Sorted newest-first
 * by publishedAt; "TK" / "Coming soon" entries sort to the bottom.
 */

import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  commentaries,
  sections,
  site,
  type DataCommentary,
  type SectionSlug,
} from "../../data/sections";
import { withBase } from "../../lib/urls";

// Section slug -> display label (e.g. "housing" -> "Housing").
const sectionLabelFor = (slug: SectionSlug): string => {
  const s = sections.find((x) => x.slug === slug);
  return s ? s.label : slug;
};

// Sort newest first. "TK" sentinels sort to bottom.
const commentariesOrdered: DataCommentary[] = [...commentaries].sort((a, b) =>
  b.publishedAt.localeCompare(a.publishedAt),
);

// Landing-page limits — keep the page scannable as content fills in.
// The commentary archive at /research/commentaries/ carries the full list.
// Deep-dives section is in coming-soon mode — list rendering is gone until
// the first dive is publishable.
const COMMENTARY_LIMIT = 3;
const commentariesLanding = commentariesOrdered.slice(0, COMMENTARY_LIMIT);
const commentaryOverflow = commentariesOrdered.length > COMMENTARY_LIMIT;

// Hand-rolled YYYY-MM-DD -> "May 19, 2026" formatter (avoids timezone shift
// that breaks date parity between local and CI build hosts).
const MONTH_SHORT = [
  "Jan", "Feb", "Mar", "Apr", "May", "Jun",
  "Jul", "Aug", "Sep", "Oct", "Nov", "Dec",
];
const displayDate = (raw?: string): string => {
  if (!raw || raw === "TK") return "TK";
  const parts = raw.split("-");
  if (parts.length !== 3) return raw;
  const [y, m, d] = parts.map((n) => parseInt(n, 10));
  if (Number.isNaN(y) || Number.isNaN(m) || Number.isNaN(d)) return raw;
  if (m < 1 || m > 12) return raw;
  return `${MONTH_SHORT[m - 1]} ${d}, ${y}`;
};

const pageTitle = "Research";
const pageDesc =
  "Sibley Creek research output: same-day data commentary on every major " +
  "Canadian print, and long-form deep dives on the structural questions " +
  "behind the dashboard.";
---
<BaseLayout title={pageTitle} description={pageDesc} pageClass="research-index">
  <article class="static" aria-labelledby="research-h">
    <header class="static__header">
      <h1 id="research-h" class="static__h">Research</h1>
    </header>

    <p class="static__lede">
      Two modes of work: same-day commentary on every major Canadian
      print, and long-form deep dives on the structural questions
      underneath. Newest first.
    </p>

    {/* ── Section 1: Data commentary ── */}
    <section class="research__section" aria-labelledby="commentary-h">
      <h2 id="commentary-h" class="research__section-title">
        Data commentary
      </h2>
      <p class="research__section-desc">
        Same-day notes on every major Canadian print. Distributed as PDFs
        to subscribers; visible here as they ship.
      </p>

      {commentariesLanding.length === 0 ? (
        <p class="research__empty">No commentaries published yet.</p>
      ) : (
        <>
          <ol class="research__list" role="list">
            {commentariesLanding.map((c) => (
              <li class="research__row">
                <a
                  class="research__row-link research__row-link--pdf"
                  href={withBase(`/research/commentaries/${c.slug}/`)}
                >
                  <div class="research__row-meta">
                    <span class="research__row-date">{displayDate(c.publishedAt)}</span>
                    <span class="research__row-badge">{sectionLabelFor(c.section)}</span>
                  </div>
                  <div class="research__row-body">
                    <h3 class="research__row-title">{c.title}</h3>
                    <p class="research__row-excerpt">{c.excerpt}</p>
                  </div>
                  <span class="research__row-pdf-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 4 v12" />
                      <path d="M6 12 l6 6 6-6" />
                      <path d="M5 20 h14" />
                    </svg>
                  </span>
                </a>
              </li>
            ))}
          </ol>
          {commentaryOverflow && (
            <p class="research__see-all">
              <a class="research__see-all-link" href={withBase("/research/commentaries/")}>
                See all {commentariesOrdered.length} commentaries →
              </a>
            </p>
          )}
        </>
      )}
    </section>

    {/* ── Section 2: Deep dives — coming-soon placeholder ──
         Deep dives are paused until the first ones are ready to ship.
         The section still appears on /research/ so the two-mode framing
         (commentary + dives) reads as the firm's stated output mix;
         the list is replaced with a restrained "Coming soon" stamp.
         Drop this placeholder + restore the list rendering when the
         first dive is publishable. */}
    <section class="research__section" aria-labelledby="deepdives-h">
      <h2 id="deepdives-h" class="research__section-title">
        Deep dives
      </h2>
      <p class="research__section-desc">
        Multi-week investigations on the structural pieces of the
        Canadian economy.
      </p>
      <p class="research__coming-soon">Coming soon.</p>
    </section>
  </article>

  <style>
    /* ─────────── boutique-register container (matches /about/, etc.) ─────────── */
    .static {
      width: 100%;
      max-width: 720px;
      margin: 0 auto;
      padding: 32px 24px 64px;
    }
    .static__header {
      border-bottom: 1px solid var(--ink);
      padding-bottom: 24px;
      margin-bottom: 32px;
    }
    .static__kicker {
      margin: 0 0 12px;
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 13px;
      line-height: 1;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--ink);
      opacity: 0.7;
    }
    .static__h {
      margin: 0;
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 42px;
      line-height: 1.1;
      color: var(--ink);
    }
    .static__lede {
      margin: 0 0 48px;
      font-family: var(--font-sans);
      font-weight: 400;
      font-size: 18px;
      line-height: 1.55;
      color: var(--ink);
    }

    /* ─────────── Sections ─────────── */
    .research__section {
      margin-bottom: 44px;
    }
    .research__section:last-child {
      margin-bottom: 0;
    }
    .research__section-title {
      margin: 0 0 12px;
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 14px;
      line-height: 1;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--ink);
      padding-bottom: 8px;
      border-bottom: 1px solid var(--ink);
    }
    .research__section-desc {
      margin: 0 0 24px;
      font-family: var(--font-sans);
      font-weight: 400;
      font-size: 14px;
      line-height: 1.55;
      color: var(--ink);
      opacity: 0.6;
      max-width: 56ch;
    }
    .research__empty {
      margin: 0;
      font-family: var(--font-sans);
      font-weight: 400;
      font-size: 14px;
      line-height: 1.4;
      color: var(--ink);
      opacity: 0.55;
    }

    /* Coming-soon stamp used on the deep-dives section while dives are
     * paused. Smaller and more reserved than the section subhead so it
     * reads as "watch this space," not as a feature. */
    .research__coming-soon {
      margin: 24px 0 0;
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 11px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--ink);
      opacity: 0.65;
    }

    /* ─────────── List + rows ─────────── */
    .research__list {
      margin: 0;
      padding: 0;
      list-style: none;
      border-top: 1px solid rgba(0,0,0,0.12);
    }
    .research__row {
      margin: 0;
      padding: 0;
      border-bottom: 1px solid rgba(0,0,0,0.12);
    }

    .research__row-link {
      display: grid;
      grid-template-columns: 1fr;
      gap: 8px 24px;
      padding: 20px 0 22px;
      text-decoration: none;
      color: var(--ink);
    }
    @media (min-width: 560px) {
      .research__row-link {
        grid-template-columns: 132px 1fr;
        gap: 0 24px;
        padding: 18px 0 20px;
        align-items: baseline;
      }
      /* PDF rows reserve a column on the right for the download icon. */
      .research__row-link--pdf {
        grid-template-columns: 132px 1fr auto;
      }
    }
    a.research__row-link:hover .research__row-title {
      color: var(--accent);
      border-bottom-color: var(--accent);
    }
    a.research__row-link:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }
    .research__row-link--static {
      cursor: default;
    }
    .research__row--unpublished {
      opacity: 0.55;
    }

    /* Left meta rail */
    .research__row-meta {
      display: flex;
      flex-direction: column;
      gap: 4px;
      align-items: flex-start;
    }
    .research__row-date {
      font-family: var(--font-mono);
      font-weight: 400;
      font-size: 12px;
      line-height: 1;
      letter-spacing: 0.04em;
      color: var(--ink);
      font-variant-numeric: tabular-nums;
    }
    .research__row-date--tk {
      color: #8A8A8A;
    }
    .research__row-badge {
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 9.5px;
      line-height: 1;
      letter-spacing: 0.20em;
      text-transform: uppercase;
      color: var(--ink);
      opacity: 0.55;
    }
    .research__row-chip {
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 9.5px;
      line-height: 1;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--accent);
    }

    /* Right body */
    .research__row-body {
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .research__row-title {
      margin: 0;
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 17px;
      line-height: 1.3;
      color: var(--ink);
      border-bottom: 1px solid transparent;
      padding-bottom: 1px;
      align-self: flex-start;
      transition: color 80ms linear, border-color 80ms linear;
    }
    .research__row-deck {
      margin: 0;
      font-family: var(--font-sans);
      font-weight: 400;
      font-size: 14px;
      line-height: 1.5;
      color: var(--ink);
      opacity: 0.70;
      max-width: 60ch;
    }

    /* Excerpt under a commentary row title — the take preview pulled from
     * the PDF's "THE TAKE" block. Same weight/size as the deep-dive deck
     * so the two row types feel cousins. */
    .research__row-excerpt {
      margin: 0;
      font-family: var(--font-sans);
      font-weight: 400;
      font-size: 14px;
      line-height: 1.5;
      color: var(--ink);
      opacity: 0.70;
      max-width: 60ch;
    }

    /* PDF download icon on the right of a commentary row. Ink-faint by
     * default, accent on hover (the same hover that lights the title).
     * Sits in the third grid column on PDF rows. */
    .research__row-pdf-icon {
      display: inline-flex;
      align-items: flex-start;
      justify-content: center;
      padding-top: 2px;
      color: var(--ink);
      opacity: 0.5;
      transition: color 80ms linear, opacity 80ms linear;
    }
    a.research__row-link--pdf:hover .research__row-pdf-icon {
      color: var(--accent);
      opacity: 1;
    }
    .research__row-pdf-icon svg {
      display: block;
    }

    /* "See all" overflow link sits below a sliced landing list. */
    .research__see-all {
      margin: 20px 0 0;
    }
    .research__see-all-link {
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 11px;
      line-height: 1;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--accent);
      text-decoration: none;
      border-bottom: 1px solid transparent;
      transition: border-color 80ms linear;
    }
    .research__see-all-link:hover {
      border-bottom-color: var(--accent);
    }
  </style>
</BaseLayout>
