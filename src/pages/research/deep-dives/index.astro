---
/*
 * /research/deep-dives/ — full archive of long-form research pieces.
 *
 * The /research/ landing surfaces the latest 3; this page carries the
 * full chronological list. Unpublished entries render as "Coming soon"
 * with the unpublished row treatment.
 *
 * Visual register: boutique (matches /research/, /about/, etc.).
 */

import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  deepDives,
  sections,
  site,
  type DeepDive,
  type SectionSlug,
} from "../../../data/sections";
import { withBase } from "../../../lib/urls";

const sectionLabelFor = (slug: SectionSlug): string => {
  const s = sections.find((x) => x.slug === slug);
  return s ? s.label : slug;
};

const ordered: DeepDive[] = [...deepDives].sort((a, b) => {
  const aTk = !a.publishedAt || a.publishedAt === "TK";
  const bTk = !b.publishedAt || b.publishedAt === "TK";
  if (aTk && bTk) return 0;
  if (aTk) return 1;
  if (bTk) return -1;
  return (b.publishedAt as string).localeCompare(a.publishedAt as string);
});

const MONTH_SHORT = [
  "Jan", "Feb", "Mar", "Apr", "May", "Jun",
  "Jul", "Aug", "Sep", "Oct", "Nov", "Dec",
];
const displayDate = (raw?: string): string => {
  if (!raw || raw === "TK") return "TK";
  const parts = raw.split("-");
  if (parts.length !== 3) return raw;
  const [y, m, d] = parts.map((n) => parseInt(n, 10));
  if (Number.isNaN(y) || Number.isNaN(m) || Number.isNaN(d)) return raw;
  if (m < 1 || m > 12) return raw;
  return `${MONTH_SHORT[m - 1]} ${d}, ${y}`;
};

const pageTitle = "Deep dives";
const pageDesc =
  "Full archive of Sibley Creek long-form research on the structural " +
  "pieces of the Canadian economy. Newest first.";
---
<BaseLayout title={`${pageTitle} — ${site.name}`} description={pageDesc} pageClass="research-archive">
  <article class="static" aria-labelledby="archive-h">
    <header class="static__header">
      <h1 id="archive-h" class="static__h">Deep dives</h1>
    </header>

    <p class="static__lede">
      Multi-week investigations on the structural pieces of the
      Canadian economy. Newest first.
    </p>

    {ordered.length === 0 ? (
      <p class="research__empty">No deep dives published yet.</p>
    ) : (
      <ol class="research__list" role="list">
        {ordered.map((dd) => {
          const isPublished = Boolean(dd.publishedPath);
          const href = isPublished ? withBase(`/research/${dd.slug}/`) : null;
          const inner = (
            <>
              <div class="research__row-meta">
                <span class:list={["research__row-date", { "research__row-date--tk": !dd.publishedAt || dd.publishedAt === "TK" }]}>
                  {dd.publishedAt && dd.publishedAt !== "TK"
                    ? displayDate(dd.publishedAt)
                    : "Coming soon"}
                </span>
                <span class="research__row-badge">{sectionLabelFor(dd.section)}</span>
                {dd.draftStatus === "draft" && isPublished && (
                  <span class="research__row-chip">Draft</span>
                )}
              </div>
              <div class="research__row-body">
                <h3 class="research__row-title">{dd.title}</h3>
                <p class="research__row-deck">{dd.deck}</p>
              </div>
            </>
          );
          return (
            <li class:list={["research__row", { "research__row--unpublished": !isPublished }]}>
              {href ? (
                <a class="research__row-link" href={href}>{inner}</a>
              ) : (
                <div class="research__row-link research__row-link--static">{inner}</div>
              )}
            </li>
          );
        })}
      </ol>
    )}

    <p class="static__back">
      <a class="static__back-link" href={withBase("/research/")}>← Back to research</a>
    </p>
  </article>

  <style>
    .static {
      width: 100%;
      max-width: 720px;
      margin: 0 auto;
      padding: 32px 24px 64px;
    }
    .static__header {
      border-bottom: 1px solid var(--ink);
      padding-bottom: 24px;
      margin-bottom: 32px;
    }
    .static__kicker {
      margin: 0 0 12px;
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 13px;
      line-height: 1;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--ink);
      opacity: 0.7;
    }
    .static__h {
      margin: 0;
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 42px;
      line-height: 1.1;
      color: var(--ink);
    }
    .static__lede {
      margin: 0 0 32px;
      font-family: var(--font-sans);
      font-weight: 400;
      font-size: 18px;
      line-height: 1.55;
      color: var(--ink);
      max-width: 56ch;
    }

    .research__empty {
      margin: 0;
      font-family: var(--font-sans);
      font-weight: 400;
      font-size: 14px;
      line-height: 1.4;
      color: var(--ink);
      opacity: 0.55;
    }

    .research__list {
      margin: 0;
      padding: 0;
      list-style: none;
      border-top: 1px solid rgba(0,0,0,0.12);
    }
    .research__row {
      margin: 0;
      padding: 0;
      border-bottom: 1px solid rgba(0,0,0,0.12);
    }
    .research__row-link {
      display: grid;
      grid-template-columns: 1fr;
      gap: 8px 24px;
      padding: 20px 0 22px;
      text-decoration: none;
      color: var(--ink);
    }
    @media (min-width: 560px) {
      .research__row-link {
        grid-template-columns: 132px 1fr;
        gap: 0 24px;
        padding: 18px 0 20px;
        align-items: baseline;
      }
    }
    a.research__row-link:hover .research__row-title {
      color: var(--accent);
      border-bottom-color: var(--accent);
    }
    a.research__row-link:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }
    .research__row-link--static {
      cursor: default;
    }
    .research__row--unpublished {
      opacity: 0.55;
    }

    .research__row-meta {
      display: flex;
      flex-direction: column;
      gap: 4px;
      align-items: flex-start;
    }
    .research__row-date {
      font-family: var(--font-mono);
      font-weight: 400;
      font-size: 12px;
      line-height: 1;
      letter-spacing: 0.04em;
      color: var(--ink);
      font-variant-numeric: tabular-nums;
    }
    .research__row-date--tk {
      color: #8A8A8A;
    }
    .research__row-badge {
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 9.5px;
      line-height: 1;
      letter-spacing: 0.20em;
      text-transform: uppercase;
      color: var(--ink);
      opacity: 0.55;
    }
    .research__row-chip {
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 9.5px;
      line-height: 1;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--accent);
    }

    .research__row-body {
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .research__row-title {
      margin: 0;
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 17px;
      line-height: 1.3;
      color: var(--ink);
      border-bottom: 1px solid transparent;
      padding-bottom: 1px;
      align-self: flex-start;
      transition: color 80ms linear, border-color 80ms linear;
    }
    .research__row-deck {
      margin: 0;
      font-family: var(--font-sans);
      font-weight: 400;
      font-size: 14px;
      line-height: 1.5;
      color: var(--ink);
      opacity: 0.70;
      max-width: 60ch;
    }

    .static__back {
      margin: 40px 0 0;
    }
    .static__back-link {
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 11px;
      line-height: 1;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--ink);
      text-decoration: none;
      border-bottom: 1px solid transparent;
      transition: border-color 80ms linear;
      opacity: 0.7;
    }
    .static__back-link:hover {
      opacity: 1;
      border-bottom-color: var(--ink);
    }
  </style>
</BaseLayout>
