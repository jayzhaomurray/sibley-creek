---
/*
 * /research/commentaries/ — full archive of data commentaries.
 *
 * The /research/ landing surfaces the latest 5; this page carries the
 * full chronological list. When the archive crosses ~30 items it should
 * grow month-grouping subheaders (MAY 2026 ▸ rows ▸ APRIL 2026 ▸ rows);
 * skipped until that threshold to keep the page honest about scale.
 *
 * Visual register: boutique (matches /research/, /about/, etc.).
 */

import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  commentaries,
  sections,
  site,
  type DataCommentary,
  type SectionSlug,
} from "../../../data/sections";
import { withBase } from "../../../lib/urls";

const sectionLabelFor = (slug: SectionSlug): string => {
  const s = sections.find((x) => x.slug === slug);
  return s ? s.label : slug;
};

const ordered: DataCommentary[] = [...commentaries].sort((a, b) =>
  b.publishedAt.localeCompare(a.publishedAt),
);

const MONTH_SHORT = [
  "Jan", "Feb", "Mar", "Apr", "May", "Jun",
  "Jul", "Aug", "Sep", "Oct", "Nov", "Dec",
];
const displayDate = (raw?: string): string => {
  if (!raw || raw === "TK") return "TK";
  const parts = raw.split("-");
  if (parts.length !== 3) return raw;
  const [y, m, d] = parts.map((n) => parseInt(n, 10));
  if (Number.isNaN(y) || Number.isNaN(m) || Number.isNaN(d)) return raw;
  if (m < 1 || m > 12) return raw;
  return `${MONTH_SHORT[m - 1]} ${d}, ${y}`;
};

const pageTitle = "Data commentary";
const pageDesc =
  "Full archive of Sibley Creek's same-day notes on every major Canadian " +
  "economic print. Newest first.";
---
<BaseLayout title={`${pageTitle} — ${site.name}`} description={pageDesc} pageClass="research-archive">
  <article class="static" aria-labelledby="archive-h">
    <header class="static__header">
      <h1 id="archive-h" class="static__h">Data commentary</h1>
    </header>

    <p class="static__lede">
      Same-day notes on every major Canadian print. Distributed as PDFs
      to subscribers; visible here as they ship. Newest first.
    </p>

    {ordered.length === 0 ? (
      <p class="research__empty">No commentaries published yet.</p>
    ) : (
      <ol class="research__list" role="list">
        {ordered.map((c) => (
          <li class="research__row">
            <a class="research__row-link research__row-link--pdf" href={withBase(c.pdfPath)}>
              <div class="research__row-meta">
                <span class="research__row-date">{displayDate(c.publishedAt)}</span>
                <span class="research__row-badge">{sectionLabelFor(c.section)}</span>
              </div>
              <div class="research__row-body">
                <h3 class="research__row-title">{c.title}</h3>
                <p class="research__row-excerpt">{c.excerpt}</p>
              </div>
              <span class="research__row-pdf-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 4 v12" />
                  <path d="M6 12 l6 6 6-6" />
                  <path d="M5 20 h14" />
                </svg>
              </span>
            </a>
          </li>
        ))}
      </ol>
    )}

    <p class="static__back">
      <a class="static__back-link" href={withBase("/research/")}>← Back to research</a>
    </p>
  </article>

  <style>
    .static {
      width: 100%;
      max-width: 720px;
      margin: 0 auto;
      padding: 32px 24px 64px;
    }
    .static__header {
      border-bottom: 1px solid var(--ink);
      padding-bottom: 24px;
      margin-bottom: 32px;
    }
    .static__kicker {
      margin: 0 0 12px;
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 13px;
      line-height: 1;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--ink);
      opacity: 0.7;
    }
    .static__h {
      margin: 0;
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 42px;
      line-height: 1.1;
      color: var(--ink);
    }
    .static__lede {
      margin: 0 0 32px;
      font-family: var(--font-sans);
      font-weight: 400;
      font-size: 18px;
      line-height: 1.55;
      color: var(--ink);
      max-width: 56ch;
    }

    .research__empty {
      margin: 0;
      font-family: var(--font-sans);
      font-weight: 400;
      font-size: 14px;
      line-height: 1.4;
      color: var(--ink);
      opacity: 0.55;
    }

    .research__list {
      margin: 0;
      padding: 0;
      list-style: none;
      border-top: 1px solid rgba(0,0,0,0.12);
    }
    .research__row {
      margin: 0;
      padding: 0;
      border-bottom: 1px solid rgba(0,0,0,0.12);
    }
    .research__row-link {
      display: grid;
      grid-template-columns: 1fr;
      gap: 8px 24px;
      padding: 20px 0 22px;
      text-decoration: none;
      color: var(--ink);
    }
    @media (min-width: 560px) {
      .research__row-link {
        grid-template-columns: 132px 1fr;
        gap: 0 24px;
        padding: 18px 0 20px;
        align-items: baseline;
      }
      .research__row-link--pdf {
        grid-template-columns: 132px 1fr auto;
      }
    }
    a.research__row-link:hover .research__row-title {
      color: var(--accent);
      border-bottom-color: var(--accent);
    }
    a.research__row-link:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }

    .research__row-meta {
      display: flex;
      flex-direction: column;
      gap: 4px;
      align-items: flex-start;
    }
    .research__row-date {
      font-family: var(--font-mono);
      font-weight: 400;
      font-size: 12px;
      line-height: 1;
      letter-spacing: 0.04em;
      color: var(--ink);
      font-variant-numeric: tabular-nums;
    }
    .research__row-badge {
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 9.5px;
      line-height: 1;
      letter-spacing: 0.20em;
      text-transform: uppercase;
      color: var(--ink);
      opacity: 0.55;
    }

    .research__row-body {
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .research__row-title {
      margin: 0;
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 17px;
      line-height: 1.3;
      color: var(--ink);
      border-bottom: 1px solid transparent;
      padding-bottom: 1px;
      align-self: flex-start;
      transition: color 80ms linear, border-color 80ms linear;
    }
    .research__row-excerpt {
      margin: 0;
      font-family: var(--font-sans);
      font-weight: 400;
      font-size: 14px;
      line-height: 1.5;
      color: var(--ink);
      opacity: 0.70;
      max-width: 60ch;
    }

    /* PDF download icon on the right of a commentary row. */
    .research__row-pdf-icon {
      display: inline-flex;
      align-items: flex-start;
      justify-content: center;
      padding-top: 2px;
      color: var(--ink);
      opacity: 0.5;
      transition: color 80ms linear, opacity 80ms linear;
    }
    a.research__row-link--pdf:hover .research__row-pdf-icon {
      color: var(--accent);
      opacity: 1;
    }
    .research__row-pdf-icon svg {
      display: block;
    }

    .static__back {
      margin: 40px 0 0;
    }
    .static__back-link {
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 11px;
      line-height: 1;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--ink);
      text-decoration: none;
      border-bottom: 1px solid transparent;
      transition: border-color 80ms linear;
      opacity: 0.7;
    }
    .static__back-link:hover {
      opacity: 1;
      border-bottom-color: var(--ink);
    }
  </style>
</BaseLayout>
