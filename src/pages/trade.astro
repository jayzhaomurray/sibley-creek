---
import SectionLayout from "../layouts/SectionLayout.astro";
import type { Plate } from "../layouts/SectionLayout.astro";
import { sections } from "../data/sections";
import panelDataFile from "../../data/site/panel_data/trade.json";
import sectionsJson from "../../data/site/sections.json";
import { pickPanel, pickPanelByKey } from "../components/charts/_shared/panelData";
import { deriveLatestReleaseLabel } from "../components/section/_shared/derivedLabels";

const section = sections.find((s) => s.slug === "trade");
if (!section) {
  throw new Error("Trade section not found in src/data/sections.ts");
}

const latestReleaseLabel = deriveLatestReleaseLabel(
  section.latestReleasePrefix ?? "",
  sectionsJson,
  "trade",
);

const leadData = pickPanel(panelDataFile, 3);
const plate2Data = pickPanel(panelDataFile, 8);
const plate3Data = pickPanelByKey(panelDataFile, "panel-9");
const plate4Data = pickPanelByKey(panelDataFile, "panel-7-alt");

const plates: Plate[] = [
  {
    id: "plate-lead",
    number: "01",
    chartKey: "trade-panel-balance-vs-share",
    indicator: "Goods trade balance (C$M) and US share of goods exports (%)",
    plateIndexLabel: "Balance and US share",
    title: "The US export share is back near 70%.",
    interpretationHtml:
      "Canada's US-bound export share fell to 66.0% in March, then rebounded to 69.2% in April and 70.0% in May. " +
      "That is close to where it was a year earlier. The apparent diversification pulse was mostly gold: shipments to London surged, then cooled as the gold flow normalized.",
    callout: {
      value: "70.0%",
      unitPrefix: "US share of goods exports",
      delta: "+0.8pp m/m",
      direction: "neutral",
    },
    source: "Statistics Canada Tables 12-10-0011-01 (trade balance) and 12-10-0121-01 (exports by country).",
    data: leadData,
    citations: [
      { phrase: "66.0% in March", source: "pipeline:statcan:12-10-0121-01", note: "US share of total goods exports, March 2026: 66.0%." },
      { phrase: "69.2% in April", source: "pipeline:statcan:12-10-0121-01", note: "US share of total goods exports, April 2026: 69.2%." },
      { phrase: "70.0% in May", source: "pipeline:statcan:12-10-0121-01", note: "US share of total goods exports, May 2026: 70.0%." },
      { phrase: "close to where it was a year earlier", source: "pipeline:statcan:12-10-0121-01", note: "US share of total goods exports, May 2025: 69.6%." },
      { phrase: "shipments to London surged, then cooled", source: "pipeline:statcan:12-10-0182-01", note: "NAPCS 35 gold/silver/PGM exports to the UK fell from C$7.8B in March to C$5.6B in April and C$4.6B in May 2026." },
    ],
  },
  {
    id: "plate-2",
    number: "02",
    chartKey: "trade-panel-reorientation-scatter",
    indicator: "Δ exports to US vs Δ exports to non-US, by NAPCS sub-chapter, May 2025 to May 2026",
    plateIndexLabel: "Sector-by-sector shift",
    title: "Trade diversification is extremely limited.",
    interpretationHtml:
      "Gold still accounts for the clearest non-US export growth, but the surge is fading: total precious-metals exports fell from C$8.0B in March to C$5.6B in May. " +
      "At the same time, exports to the US rose to C$52.2B, a new high in the refreshed data. " +
      "Strip out the gold corridor and the pivot still is not there.",
    source: "Statistics Canada Table 12-10-0182-01 (NAPCS sub-chapter exports by partner country).",
    data: plate2Data,
    citations: [
      { phrase: "clearest non-US export growth", source: "pipeline:statcan:12-10-0182-01", note: "NAPCS 35 gold/silver/PGM exports remain the dominant visible non-US growth channel in the refreshed trade panels." },
      { phrase: "fell from C$8.0B in March to C$5.6B in May", source: "pipeline:statcan:12-10-0182-01", note: "NAPCS 35 total exports: C$8.0B in March 2026, C$6.1B in April, C$5.6B in May." },
      { phrase: "exports to the US rose to C$52.2B", source: "pipeline:statcan:12-10-0121-01", note: "Seasonally adjusted goods exports to the United States, May 2026: C$52.2B." },
    ],
  },
  {
    id: "plate-3",
    number: "03",
    chartKey: "trade-panel-gold",
    indicator: "Gold and PGM exports: total and UK destination, with gold price",
    plateIndexLabel: "Gold corridor",
    title: "London is still buying most of Canada's gold, but the surge is cooling.",
    interpretationHtml:
      "For decades, gold has been mined in Ontario and Quebec and sent straight to London's bullion banks, who store much of it in the Bank of England's vaults. " +
      "The story is old; what changed was the scale of the flow. " +
      "Canada sold C$5.6 billion of precious metals in May, down from C$8.0 billion in March, and the UK's share fell to 83% from 97%.",
    callout: {
      value: "83%",
      unitPrefix: "UK share of gold/PGM exports",
      delta: "May 2026",
      direction: "neutral",
    },
    source: "Statistics Canada Table 12-10-0182-01 (NAPCS 35: unwrought gold, silver, and PGM by partner country); Yahoo Finance (gold futures, USD/oz).",
    data: plate3Data,
    citations: [
      { phrase: "gold has been mined in Ontario and Quebec", source: "derived", note: "Natural Resources Canada: Ontario and Quebec are the two largest gold-producing provinces, together accounting for roughly three-quarters of Canadian gold production." },
      { phrase: "sent straight to London's bullion banks, who store much of it in the Bank of England's vaults", source: "derived", note: "Royal Canadian Mint named on the original LBMA Good Delivery List in 1934; Canadian refined gold flows to LBMA-member bullion banks (HSBC, JPM, ICBC Standard) in London, who custody a substantial portion of their bullion at the Bank of England. BoE vaults hold ~5,000 tonnes of gold, of which only ~300 tonnes is UK reserves; the balance is custody for foreign central banks and commercial bullion banks." },
      { phrase: "C$5.6 billion of precious metals in May", source: "pipeline:statcan:12-10-0182-01", note: "NAPCS 35 total exports, all countries, May 2026: C$5,598M." },
      { phrase: "down from C$8.0 billion in March", source: "pipeline:statcan:12-10-0182-01", note: "NAPCS 35 total exports, all countries, March 2026: C$8,026M." },
      { phrase: "UK's share fell to 83% from 97%", source: "derived", note: "UK share of NAPCS 35 exports: 97.4% in March 2026 and 82.6% in May 2026." },
    ],
  },
  {
    id: "plate-4",
    number: "04",
    chartKey: "trade-panel-sector-pivot",
    indicator: "Tariff-exposed sectors: US share of total exports, May 2025 vs May 2026",
    plateIndexLabel: "Tariff-exposed sectors",
    title: "Aluminum is the only clear move away from the US.",
    interpretationHtml:
      "Of the tariff-exposed sectors charted, aluminum is the only clear move away from the US between May 2025 and May 2026. " +
      "Its US share fell from 88.7% to 62.9%, while steel, softwood, and autos each moved away by less than five points and copper moved further toward the US. " +
      "One sector is moving; the rest are still mostly tied to the US market.",
    source: "Statistics Canada Table 12-10-0182-01 (NAPCS sub-chapter exports by partner country).",
    data: plate4Data,
    citations: [
      { phrase: "between May 2025 and May 2026", source: "pipeline:statcan:12-10-0182-01", note: "Plate compares the latest May 2026 tariff-exposed sector readings with the same month a year earlier, May 2025." },
      { phrase: "tariff-exposed sectors charted", source: "derived", note: "Chart renders steel, aluminum, copper, softwood lumber, and autos/parts from StatCan 12-10-0182-01. Steel, aluminum, copper, and autos are subject to US Section 232 tariffs; softwood is covered by US AD/CVD duties." },
      { phrase: "aluminum is the only clear move away from the US", source: "derived", note: "Aluminum (NAPCS 32+38) US share fell 25.8pp between May 2025 and May 2026. Source: StatCan 12-10-0182-01." },
      { phrase: "88.7% to 62.9%", source: "derived", note: "Aluminum US share: May 2025 = 88.7%; May 2026 = 62.9%. Source: StatCan 12-10-0182-01." },
      { phrase: "steel, softwood, and autos each moved away by less than five points", source: "derived", note: "US share May 2025 -> May 2026: steel 91.1% -> 87.0% (-4.1pp), softwood 88.9% -> 88.1% (-0.8pp), autos 90.8% -> 88.3% (-2.5pp). Source: StatCan 12-10-0182-01." },
      { phrase: "copper moved further toward the US", source: "derived", note: "Copper US share rose from 88.9% in May 2025 to 90.6% in May 2026. Source: StatCan 12-10-0182-01." },
    ],
  },
];

const pageTitle = "Trade";
const pageDescription =
  "Canadian trade chartbook: merchandise balance, US partner share, sector-level export pivot, gold flows, and trade reorientation under tariffs.";

// Lede reads the same editorial blurb the auto-blurb pipeline writes for the
// splash tile (sections.ts -> section.blurb.body). Single source of truth: a
// release-day fan-out updates one field and both surfaces refresh.
const lede = section.blurb?.body ?? "";
---
<SectionLayout
  slug="trade"
  sectionIndex={6}
  sectionLabel="Trade"
  headlineQuestion={section.headlineQuestion}
  lede={lede}
  latestReleaseLabel={latestReleaseLabel}
  plates={plates}
  title={pageTitle}
  description={pageDescription}
/>
