---
/*
 * Trade - basics-layer section page (placeholder).
 *
 * Six panels per editorial canon section 4.7:
 *   1. Merchandise trade balance
 *   2. Current account
 *   3. Partner shares
 *   4. Tariff state
 *   5. Terms of trade
 *   6. FDI by sector
 *
 * Why this file is sparse:
 *   Navigation-skeleton placeholder. Writer + style-editor own panel
 *   titles, decks, callouts, and source citations. Backend pipeline owns
 *   vintage stamps and numeric values. Chart-builder hydrates chart slots.
 *   Frontend reserves panel order, eyebrows, anchors, and the page shell.
 *
 * Mirrors src/pages/gdp.astro structure; see that file for the worked
 * example with finished placeholder copy.
 */

import SectionLayout from "../layouts/SectionLayout.astro";
import type { Panel } from "../layouts/SectionLayout.astro";
import { sections } from "../data/sections";

const section = sections.find((s) => s.slug === "trade");
if (!section) {
  throw new Error("Trade section not found in src/data/sections.ts");
}

const pageAsOf = {
  label: "Placeholder release",
  releaseDate: "TBD",
};

const placeholderText = "Placeholder. Writer to populate.";
const placeholderMethodology = "Placeholder. Methodology to be documented by editorial.";
const placeholderSource = "Source citation TBD.";
const placeholderVintage = { releaseDate: "TBD" };

const panels: Panel[] = [
  {
    id: "panel-1",
    eyebrow: "Merchandise trade balance",
    title: placeholderText,
    deck: placeholderText,
    vintage: placeholderVintage,
    editorialStatus: placeholderText,
    source: placeholderSource,
    methodology: { body: placeholderMethodology },
  },
  {
    id: "panel-2",
    eyebrow: "Current account",
    title: placeholderText,
    deck: placeholderText,
    vintage: placeholderVintage,
    editorialStatus: placeholderText,
    source: placeholderSource,
    methodology: { body: placeholderMethodology },
  },
  {
    id: "panel-3",
    eyebrow: "Partner shares",
    title: placeholderText,
    deck: placeholderText,
    vintage: placeholderVintage,
    editorialStatus: placeholderText,
    source: placeholderSource,
    methodology: { body: placeholderMethodology },
  },
  {
    id: "panel-4",
    eyebrow: "Tariff state",
    title: placeholderText,
    deck: placeholderText,
    vintage: placeholderVintage,
    editorialStatus: placeholderText,
    source: placeholderSource,
    methodology: { body: placeholderMethodology },
  },
  {
    id: "panel-5",
    eyebrow: "Terms of trade",
    title: placeholderText,
    deck: placeholderText,
    vintage: placeholderVintage,
    editorialStatus: placeholderText,
    source: placeholderSource,
    methodology: { body: placeholderMethodology },
  },
  {
    id: "panel-6",
    eyebrow: "FDI by sector",
    title: placeholderText,
    deck: placeholderText,
    vintage: placeholderVintage,
    editorialStatus: placeholderText,
    source: placeholderSource,
    methodology: { body: placeholderMethodology },
  },
];

const pageTitle = "Trade";
const pageDescription = `${section.headlineQuestion} The macro-research-department Trade section: merchandise trade balance, current account, partner shares, tariff state, terms of trade, and FDI.`;
---
<SectionLayout
  slug="trade"
  sectionIndex={7}
  sectionName="Trade"
  sectionLabel={section.label}
  accentVar={section.accentVar}
  headlineQuestion={section.headlineQuestion}
  pageAsOf={pageAsOf}
  panels={panels}
  title={pageTitle}
  description={pageDescription}
/>
