---
import SectionLayout from "../layouts/SectionLayout.astro";
import type { Plate } from "../layouts/SectionLayout.astro";
import { sections } from "../data/sections";
import panelDataFile from "../../data/site/panel_data/trade.json";
import sectionsJson from "../../data/site/sections.json";
import { pickPanel, pickPanelByKey } from "../components/charts/_shared/panelData";
import { deriveLatestReleaseLabel } from "../components/section/_shared/derivedLabels";

const section = sections.find((s) => s.slug === "trade");
if (!section) {
  throw new Error("Trade section not found in src/data/sections.ts");
}

const latestReleaseLabel = deriveLatestReleaseLabel(
  section.latestReleasePrefix ?? "",
  sectionsJson,
  "trade",
);

const leadData = pickPanel(panelDataFile, 3);
const plate2Data = pickPanel(panelDataFile, 8);
const plate3Data = pickPanelByKey(panelDataFile, "panel-9");
const plate4Data = pickPanelByKey(panelDataFile, "panel-7-alt");

const plates: Plate[] = [
  {
    id: "plate-lead",
    number: "01",
    chartKey: "trade-panel-balance-vs-share",
    indicator: "Goods trade balance (C$M) and US share of goods exports (%)",
    plateIndexLabel: "Balance and US share",
    title: "The US export share swung on gold, not diversification.",
    interpretationHtml:
      "Canada's US-bound export share fell from three quarters a year ago to 66.1% in March, before bouncing back to 69.5% in April. " +
      "What looks like diversification and reversal is mostly a gold story — gold exports to London surged as prices hit all-time highs, and both are now retreating in tandem.",
    callout: {
      value: "69.5%",
      unitPrefix: "US share of goods exports",
      delta: "+3.4pp m/m",
      direction: "neutral",
    },
    source: "Statistics Canada Tables 12-10-0011-01 (trade balance) and 12-10-0121-01 (exports by country).",
    data: leadData,
    citations: [
      { phrase: "three quarters a year ago", source: "pipeline:statcan:12-10-0121-01", note: "US share of total Canadian goods exports ~74.4% (April 2025) ≈ three quarters." },
      { phrase: "66.1% in March", source: "pipeline:statcan:12-10-0121-01", note: "US share of total goods exports, March 2026: 66.1%." },
      { phrase: "bouncing back to 69.5% in April", source: "pipeline:statcan:12-10-0121-01", note: "US share of total goods exports, April 2026: 69.5% (+3.4pp m/m)." },
      { phrase: "gold exports to London surged as prices hit all-time highs", source: "derived", note: "NAPCS 35 gold/silver/PGM exports to UK peaked at C$7.8B in March 2026; gold futures (GC=F) hit an all-time high ~$5,230/oz monthly (Feb 2026). Sources: StatCan 12-10-0182-01 + Yahoo Finance." },
      { phrase: "both are now retreating in tandem", source: "derived", note: "UK gold exports fell C$7.8B (Mar) to C$5.6B (Apr); gold price retreated from ~$5,230/oz (Feb) to ~$4,440/oz (Jun). Sources: StatCan 12-10-0182-01 + Yahoo Finance GC=F." },
    ],
  },
  {
    id: "plate-2",
    number: "02",
    chartKey: "trade-panel-reorientation-scatter",
    indicator: "Δ exports to US vs Δ exports to non-US, by NAPCS sub-chapter, April 2025 to April 2026",
    plateIndexLabel: "Sector-by-sector shift",
    title: "Trade diversification is extremely limited.",
    interpretationHtml:
      "Gold still accounts for most of Canada's non-US export growth — though its surge has cooled to about half the March pace. " +
      "The next-largest movers, crude oil and refined petroleum, climbed even faster on the US axis than the non-US one: a commodity boom selling into both markets at once, not a reorientation. " +
      "Strip out gold and oil, and the pivot still isn't there.",
    source: "Statistics Canada Table 12-10-0182-01 (NAPCS sub-chapter exports by partner country).",
    data: plate2Data,
    citations: [
      { phrase: "Gold still accounts for most of Canada's non-US export growth", source: "derived", note: "NAPCS 35 (gold/silver/PGM) Δ non-US exports April 2026 vs April 2025: +C$2,481M — the largest single sub-chapter non-US gain. Source: StatCan 12-10-0182-01." },
      { phrase: "its surge has cooled to about half the March pace", source: "derived", note: "NAPCS 35 Δ non-US exports: +C$4,784M in the Mar-2025→Mar-2026 window; +C$2,481M in the Apr-2025→Apr-2026 window = 52%, roughly half. Source: StatCan 12-10-0182-01." },
      { phrase: "crude oil and refined petroleum, climbed even faster on the US axis than the non-US one", source: "derived", note: "Crude oil (NAPCS 13) Δ Apr2025→Apr2026: US +C$2,211M vs non-US +C$1,327M. Refined petroleum (NAPCS 19): US +C$1,035M vs non-US +C$589M. Both grew more toward the US than non-US. Source: StatCan 12-10-0182-01." },
    ],
  },
  {
    id: "plate-3",
    number: "03",
    chartKey: "trade-panel-gold",
    indicator: "Gold and PGM exports: total and UK destination, with gold price",
    plateIndexLabel: "Gold corridor",
    title: "London is buying all of Canada's gold — prices hit record highs.",
    interpretationHtml:
      "For decades, gold has been mined in Ontario and Quebec and sent straight to London's bullion banks, who store much of it in the Bank of England's vaults. " +
      "The story is old; what's new is the price. " +
      "With spot near $4,600, Canada sold C$6 billion of precious metals in April — down from March's C$8 billion as the surge began to normalize, but still far above a typical month.",
    callout: {
      value: "91%",
      unitPrefix: "UK share of gold/PGM exports",
      delta: "Apr 2026",
      direction: "neutral",
    },
    source: "Statistics Canada Table 12-10-0182-01 (NAPCS 35: unwrought gold, silver, and PGM by partner country); Yahoo Finance (gold futures, USD/oz).",
    data: plate3Data,
    citations: [
      { phrase: "gold has been mined in Ontario and Quebec", source: "derived", note: "Natural Resources Canada: Ontario and Quebec are the two largest gold-producing provinces, together accounting for roughly three-quarters of Canadian gold production." },
      { phrase: "sent straight to London's bullion banks, who store much of it in the Bank of England's vaults", source: "derived", note: "Royal Canadian Mint named on the original LBMA Good Delivery List in 1934; Canadian refined gold flows to LBMA-member bullion banks (HSBC, JPM, ICBC Standard) in London, who custody a substantial portion of their bullion at the Bank of England. BoE vaults hold ~5,000 tonnes of gold, of which only ~300 tonnes is UK reserves; the balance is custody for foreign central banks and commercial bullion banks." },
      { phrase: "spot near $4,600", source: "derived", note: "Gold futures (GC=F), monthly close, April 2026, ~$4,615 per ounce (down from a ~$5,230 all-time high in February 2026). Source: Yahoo Finance." },
      { phrase: "Canada sold C$6 billion of precious metals in April", source: "pipeline:statcan:12-10-0182-01", note: "NAPCS 35 (unwrought gold, silver, and platinum group metals) total exports, all countries, April 2026: C$6,080M ≈ C$6 billion." },
      { phrase: "down from March's C$8 billion", source: "pipeline:statcan:12-10-0182-01", note: "NAPCS 35 total exports, all countries, March 2026: C$8,026M ≈ C$8 billion." },
    ],
  },
  {
    id: "plate-4",
    number: "04",
    chartKey: "trade-panel-sector-pivot",
    indicator: "Tariff-exposed sectors: US share of total exports, April 2025 vs April 2026",
    plateIndexLabel: "Tariff-exposed sectors",
    title: "Of the tariff-exposed sectors, only aluminum is pulling away from the US — and barely.",
    interpretationHtml:
      "Of the five tariff-exposed sectors charted, only aluminum has shifted away from the US between April 2025 and April 2026 — and by under five points. " +
      "Steel held roughly flat, while softwood, autos, and copper all leaned more heavily on the US, copper by over four points. " +
      "One sector is inching out; the rest are stuck or moving the wrong way.",
    source: "Statistics Canada Table 12-10-0182-01 (NAPCS sub-chapter exports by partner country).",
    data: plate4Data,
    citations: [
      { phrase: "the five tariff-exposed sectors charted", source: "derived", note: "Chart renders five sectors: steel (NAPCS 30+31), aluminum (NAPCS 32+38), copper (NAPCS 33), softwood (NAPCS 55), cars (NAPCS 81). Of these, steel/aluminum/copper/cars are subject to US Section 232 tariffs (steel + aluminum 2018+, copper July 2025 50%, autos April 2025 25%); softwood is covered by US AD/CVD duties (Lumber V dispute, 2017+) rather than Section 232. 'Tariff-exposed' is the accurate framing. Source: StatCan 12-10-0182-01." },
      { phrase: "only aluminum has shifted away from the US between April 2025 and April 2026 — and by under five points", source: "derived", note: "Aluminum (NAPCS 32+38) US share: Apr 2025 = 93.1%; Apr 2026 = 88.3%; Δ = -4.9pp. The only sector with a meaningful move away from the US over the window. Source: StatCan 12-10-0182-01." },
      { phrase: "Steel held roughly flat", source: "derived", note: "Steel (NAPCS 30+31) US share: Apr 2025 = 88.3%; Apr 2026 = 87.7%; Δ = -0.6pp. Source: StatCan 12-10-0182-01." },
      { phrase: "softwood, autos, and copper all leaned more heavily on the US, copper by over four points", source: "derived", note: "US share Apr 2025 -> Apr 2026: softwood (NAPCS 55) 88.0% -> 88.2% (+0.3pp); autos (NAPCS 81) 89.0% -> 89.5% (+0.6pp); copper (NAPCS 33) 85.7% -> 90.1% (+4.5pp). Source: StatCan 12-10-0182-01." },
    ],
  },
];

const pageTitle = "Trade";
const pageDescription =
  "Canadian trade chartbook: merchandise balance, US partner share, sector-level export pivot, gold flows, and trade reorientation under tariffs.";

// Lede reads the same editorial blurb the auto-blurb pipeline writes for the
// splash tile (sections.ts -> section.blurb.body). Single source of truth: a
// release-day fan-out updates one field and both surfaces refresh.
const lede = section.blurb?.body ?? "";
---
<SectionLayout
  slug="trade"
  sectionIndex={6}
  sectionLabel="Trade"
  headlineQuestion={section.headlineQuestion}
  lede={lede}
  latestReleaseLabel={latestReleaseLabel}
  plates={plates}
  title={pageTitle}
  description={pageDescription}
/>
