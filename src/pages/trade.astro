---
import SectionLayout from "../layouts/SectionLayout.astro";
import type { Plate } from "../layouts/SectionLayout.astro";
import { sections } from "../data/sections";
import panelDataFile from "../../data/site/panel_data/trade.json";
import sectionsJson from "../../data/site/sections.json";
import { pickPanel } from "../components/charts/_shared/panelData";
import { deriveLatestReleaseLabel } from "../components/section/_shared/derivedLabels";

const section = sections.find((s) => s.slug === "trade");
if (!section) {
  throw new Error("Trade section not found in src/data/sections.ts");
}

const latestReleaseLabel = deriveLatestReleaseLabel(
  section.latestReleasePrefix ?? "",
  sectionsJson,
  "trade",
);

const panel1Data = pickPanel(panelDataFile, 1);
const panel2Data = pickPanel(panelDataFile, 2);
const panel3Data = pickPanel(panelDataFile, 3);
const panel4Data = pickPanel(panelDataFile, 4);
const panel5Data = pickPanel(panelDataFile, 5);
const panel6Data = pickPanel(panelDataFile, 6);

const plates: Plate[] = [
  {
    id: "plate-1",
    number: "01",
    chartKey: "trade-panel-1",
    indicator: "Goods trade balance, monthly + 3mma",
    plateIndexLabel: "Goods balance",
    title: "March's surplus reads as a single-print reversal, not a settled turn.",
    interpretationHtml:
      "The goods trade balance swung to a $1.8 billion surplus in March 2026 from a $5.1 billion deficit in February, the first monthly surplus since September 2025. " +
      "Total exports hit a record $68.8 billion; exports to the US rose to $45.5 billion, leaving the bilateral surplus with the United States at $7.1 billion. " +
      "The three-month moving average remains in deficit at roughly $2.2 billion, so March is a sharp single-print reversal rather than a settled turn.",
    callout: {
      value: "+$1.8B",
      unitPrefix: "goods trade balance",
      delta: "+$6.9B m/m",
      direction: "pos",
    },
    source:
      "Statistics Canada Tables 12-10-0119-01 (balance), 12-10-0121-01 (exports), 12-10-0122-01 (imports).",
    data: panel1Data,
    citations: [
      { phrase: "$1.8 billion surplus in March 2026", source: "pipeline:statcan:12-10-0119-01", note: "Goods trade balance, total all countries, March 2026." },
      { phrase: "$5.1 billion deficit in February", source: "pipeline:statcan:12-10-0119-01", note: "Goods trade balance, total all countries, February 2026." },
      { phrase: "first monthly surplus since September 2025", source: "pipeline:statcan:12-10-0119-01", note: "Enumerated monthly trade-balance series: Sep 2025 was the last surplus print before March 2026." },
      { phrase: "record $68.8 billion", source: "pipeline:statcan:12-10-0121-01", note: "Total goods exports, March 2026; record vs full series back to 1997." },
      { phrase: "exports to the US rose to $45.5 billion", source: "pipeline:statcan:12-10-0121-01", note: "Goods exports to United States, March 2026." },
      { phrase: "bilateral surplus with the United States at $7.1 billion", source: "pipeline:statcan:12-10-0121-01", note: "Goods trade balance with US (exports to US minus imports from US), March 2026." },
      { phrase: "deficit at roughly $2.2 billion", source: "derived", note: "3-month moving average of monthly goods trade balance (Jan-Mar 2026) from 12-10-0119-01." },
    ],
  },
  {
    id: "plate-2",
    number: "02",
    chartKey: "trade-panel-2",
    indicator: "Current account: goods, services, primary income",
    plateIndexLabel: "Current account",
    title: "Primary income has flipped to a structural surplus, narrowing the external shortfall.",
    interpretationHtml:
      "The current account deficit narrowed to $0.7 billion in Q4 2025 from $5.3 billion in Q3, the smallest quarterly shortfall in over a year. " +
      "Goods remained the binding drag at -$4.5 billion; services held a $1.4 billion surplus and primary income stayed positive at $3.3 billion. " +
      "The primary-income line has run in surplus for three consecutive quarters, a reversal from the persistent deficits of 2022-23.",
    source: "Statistics Canada Table 36-10-0014-01.",
    data: panel2Data,
    citations: [
      { phrase: "deficit narrowed to $0.7 billion in Q4 2025", source: "pipeline:statcan:36-10-0014-01", note: "Current account balance, Q4 2025." },
      { phrase: "$5.3 billion in Q3", source: "pipeline:statcan:36-10-0014-01", note: "Current account balance, Q3 2025." },
      { phrase: "smallest quarterly shortfall in over a year", source: "pipeline:statcan:36-10-0014-01", note: "Enumerated quarterly current-account series: Q4 2025 narrower than any quarter since Q3 2024." },
      { phrase: "binding drag at -$4.5 billion", source: "pipeline:statcan:36-10-0014-01", note: "Goods component of current account, Q4 2025." },
      { phrase: "$1.4 billion surplus", source: "pipeline:statcan:36-10-0014-01", note: "Services component of current account, Q4 2025." },
      { phrase: "$3.3 billion", source: "pipeline:statcan:36-10-0014-01", note: "Primary income component of current account, Q4 2025." },
      { phrase: "three consecutive quarters", source: "pipeline:statcan:36-10-0014-01", note: "Enumerated primary-income series: positive in Q2, Q3, Q4 2025." },
      { phrase: "persistent deficits of 2022-23", source: "pipeline:statcan:36-10-0014-01", note: "Enumerated primary-income series: negative in every quarter of 2022 and 2023." },
    ],
  },
  {
    id: "plate-3",
    number: "03",
    chartKey: "trade-panel-3",
    indicator: "US export share of total goods exports",
    plateIndexLabel: "US export share",
    title: "Canadian exports are reorienting away from the US at the fastest peacetime pace in decades.",
    interpretationHtml:
      "The US absorbed 66.1% of Canadian goods exports in March 2026, down from 74.4% in March 2025 and a 2024 calendar average near 76.3%. " +
      "Total exports rose to a record $68.8 billion over the same window, so the share decline reflects geographic redirection rather than an export contraction. " +
      "A ten-percentage-point move in fourteen months is the largest peacetime reorientation of Canadian trade in decades.",
    callout: {
      value: "66.1%",
      unitPrefix: "US share of goods exports",
      delta: "-8.3pp y/y",
      direction: "neg",
    },
    source: "Statistics Canada Table 12-10-0121-01 (exports by country).",
    data: panel3Data,
    citations: [
      { phrase: "66.1% of Canadian goods exports in March 2026", source: "pipeline:statcan:12-10-0121-01", note: "US share of total Canadian goods exports, March 2026." },
      { phrase: "74.4% in March 2025", source: "pipeline:statcan:12-10-0121-01", note: "US share of total Canadian goods exports, March 2025." },
      { phrase: "2024 calendar average near 76.3%", source: "derived", note: "Mean of monthly US export share over Jan-Dec 2024, computed from 12-10-0121-01." },
      { phrase: "record $68.8 billion", source: "pipeline:statcan:12-10-0121-01", note: "Total goods exports, March 2026; record vs full series back to 1997." },
      { phrase: "ten-percentage-point move in fourteen months", source: "derived", note: "74.4% (Mar 2025) minus 66.1% (Mar 2026) = -8.3pp y/y; 2024 calendar average 76.3% minus 66.1% (Mar 2026) = ~10pp over fourteen months." },
    ],
  },
  {
    id: "plate-4",
    number: "04",
    chartKey: "trade-panel-4",
    indicator: "Tariff state: US trade actions affecting Canada",
    plateIndexLabel: "Tariff state",
    asOf: "Current as of May 11, 2026",
    title: "The USMCA review is the visible event; the Section 232 stack is the binding exposure.",
    interpretationHtml:
      "Section 232 rates of 50% on steel and aluminum have been in force since June 2025; copper joined the stack in April 2026 under the April 2 proclamation. Autos and parts carry 25%, and a 10% Section 232 line on softwood lumber stacks atop AD/CVD duties for an effective burden near 45%. " +
      "A preliminary Commerce Department review on April 14 proposes cutting the softwood AD/CVD components to 24.83%, with final determinations due in August and October. " +
      "The July 1 USMCA joint review is the visible event; the sector-targeted Section 232 stack is the binding exposure underneath it.",
    source:
      "USTR / DoC effective tariff actions log; Global Affairs Canada countermeasures notices.",
    data: panel4Data,
    citations: [
      { phrase: "Section 232 rates of 50% on steel and aluminum", source: "other:USTR effective-tariff actions log; Section 232 rate on steel and aluminum imports from Canada raised to 50% in June 2025." },
      { phrase: "in force since June 2025", source: "other:USTR effective-tariff actions log; Section 232 steel and aluminum 50% rate effective date June 2025." },
      { phrase: "copper joined the stack in April 2026", source: "other:Presidential proclamation of April 2, 2026 adding Section 232 tariff on copper imports." },
      { phrase: "April 2 proclamation", source: "other:Presidential proclamation dated April 2, 2026 extending Section 232 coverage." },
      { phrase: "Autos and parts carry 25%", source: "other:USTR effective-tariff actions log; Section 232 auto and auto-parts rate of 25% on Canadian-origin shipments." },
      { phrase: "10% Section 232 line on softwood lumber", source: "other:USTR effective-tariff actions log; Section 232 line on softwood lumber at 10% effective rate." },
      { phrase: "effective burden near 45%", source: "derived", note: "10% Section 232 line on softwood lumber stacked atop combined AD/CVD duties (~35%) yields effective burden ~45%." },
      { phrase: "preliminary Commerce Department review on April 14", source: "other:US Commerce Department preliminary softwood-lumber AD/CVD review issued April 14, 2026." },
      { phrase: "cutting the softwood AD/CVD components to 24.83%", source: "other:US Commerce Department preliminary determination, April 14, 2026; proposed combined AD/CVD rate 24.83%." },
      { phrase: "final determinations due in August and October", source: "other:US Commerce Department softwood AD/CVD timetable; final AD determination scheduled August 2026, final CVD October 2026." },
      { phrase: "July 1 USMCA joint review", source: "other:USMCA Article 34.7 joint review date scheduled July 1, 2026 per US-Canada-Mexico tri-national notice." },
    ],
  },
  {
    id: "plate-5",
    number: "05",
    chartKey: "trade-panel-5",
    indicator: "Terms of trade, national accounts",
    plateIndexLabel: "Terms of trade",
    title: "The export-price income tailwind has flattened rather than reversed.",
    interpretationHtml:
      "The terms-of-trade index sat at 105.5 in Q4 2025, up 0.6 points on the quarter and essentially flat against Q4 2024. " +
      "The index remains above 100 â€” export prices still favorable relative to imports â€” but roughly a point below the Q2 2024 peak of 106.6. " +
      "The income tailwind from rising export prices that ran through 2023 and early 2024 has flattened rather than reversed.",
    callout: {
      value: "105.5",
      unit: "terms-of-trade index, Q4 2025 (2017 = 100)",
      delta: "+0.6 q/q",
      direction: "pos",
    },
    source: "Statistics Canada Table 36-10-0014-01 (terms of trade derived).",
    data: panel5Data,
    citations: [
      { phrase: "105.5 in Q4 2025", source: "pipeline:statcan:36-10-0014-01", note: "Terms-of-trade index level, Q4 2025 (2017 = 100)." },
      { phrase: "up 0.6 points on the quarter", source: "derived", note: "Q4 2025 (105.5) minus Q3 2025 (104.9) = +0.6 index points." },
      { phrase: "essentially flat against Q4 2024", source: "pipeline:statcan:36-10-0014-01", note: "Terms-of-trade index, Q4 2024 vs Q4 2025; change well under 1 point." },
      { phrase: "remains above 100", source: "pipeline:statcan:36-10-0014-01", note: "Terms-of-trade index level above 100 base (2017 = 100), Q4 2025." },
      { phrase: "Q2 2024 peak of 106.6", source: "pipeline:statcan:36-10-0014-01", note: "Terms-of-trade index level at Q2 2024; series peak across 2022-2025." },
      { phrase: "ran through 2023 and early 2024", source: "pipeline:statcan:36-10-0014-01", note: "Enumerated quarterly terms-of-trade index: rising trajectory through 2023 into early 2024 before plateauing." },
    ],
  },
  {
    id: "plate-6",
    number: "06",
    chartKey: "trade-panel-6",
    indicator: "FDI by sector: inward and outward",
    plateIndexLabel: "FDI",
    asOf: "Pending",
    title: "Foreign direct investment by sector, inward and outward, awaits ingestion.",
    interpretation:
      "Sectoral foreign direct-investment flows from Statistics Canada Table 36-10-0008 are pending ingestion; this plate will update once the series is wired.",
    source: "Statistics Canada Table 36-10-0008-01 (FDI by industry).",
    data: panel6Data,
  },
];

const pageTitle = "Trade";
const pageDescription =
  "Merchandise balance, current account, partner shares, tariff state, terms of trade, FDI.";

// Lede reads the same editorial blurb the auto-blurb pipeline writes for the
// splash tile (sections.ts -> section.blurb.body). Single source of truth: a
// release-day fan-out updates one field and both surfaces refresh.
const lede = section.blurb?.body ?? "";
---
<SectionLayout
  slug="trade"
  sectionIndex={6}
  sectionLabel="Trade"
  headlineQuestion={section.headlineQuestion}
  lede={lede}
  latestReleaseLabel={latestReleaseLabel}
  plates={plates}
  title={pageTitle}
  description={pageDescription}
/>
