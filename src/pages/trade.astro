---
import SectionLayout from "../layouts/SectionLayout.astro";
import type { Plate } from "../layouts/SectionLayout.astro";
import { sections } from "../data/sections";
import panelDataFile from "../../data/site/panel_data/trade.json";
import sectionsJson from "../../data/site/sections.json";
import { pickPanel } from "../components/charts/_shared/panelData";
import { deriveLatestReleaseLabel } from "../components/section/_shared/derivedLabels";

const section = sections.find((s) => s.slug === "trade");
if (!section) {
  throw new Error("Trade section not found in src/data/sections.ts");
}

const latestReleaseLabel = deriveLatestReleaseLabel(
  section.latestReleasePrefix ?? "",
  sectionsJson,
  "trade",
);

const plate1Data = pickPanel(panelDataFile, 3);

const plates: Plate[] = [
  {
    id: "plate-1",
    number: "01",
    chartKey: "trade-panel-3",
    indicator: "US export share of total goods exports",
    plateIndexLabel: "US export share",
    title: "The share of US-bound exports has fallen to two thirds.",
    interpretationHtml:
      "Canada's US-bound export share dropped from 74.4% in March 2025 to 66.1% in March 2026 — an eight-point move in a year that, on its face, would read as the sharpest reorientation of Canadian trade in decades. " +
      "The disaggregated picture tells a different story.",
    callout: {
      value: "66.1%",
      unitPrefix: "US share of goods exports",
      delta: "-8.3pp y/y",
      direction: "neg",
    },
    source: "Statistics Canada Table 12-10-0121-01 (exports by country).",
    data: plate1Data,
    citations: [
      { phrase: "66.1% in March 2026", source: "pipeline:statcan:12-10-0121-01", note: "US share of total Canadian goods exports, March 2026." },
      { phrase: "74.4% in March 2025", source: "pipeline:statcan:12-10-0121-01", note: "US share of total Canadian goods exports, March 2025." },
      { phrase: "an eight-point move in a year", source: "derived", note: "74.4% (Mar 2025) minus 66.1% (Mar 2026) = -8.3pp y/y." },
    ],
  },
  {
    id: "plate-2",
    number: "02",
    chartKey: "trade-panel-reorientation-scatter",
    indicator: "Δ exports to US vs Δ exports to non-US, by NAPCS sub-chapter, March 2025 to March 2026",
    plateIndexLabel: "Sector-by-sector shift",
    title: "Trade diversification is extremely limited.",
    interpretationHtml:
      "One sub-chapter — gold — accounts for nearly all the non-US export growth Canada saw this year. " +
      "Every other product cluster sits near zero on the non-US axis. " +
      "Strip out the gold channel and there would be no pivot.",
    source: "Statistics Canada Table 12-10-0182-01 (NAPCS sub-chapter exports by partner country).",
    data: null,
    citations: [
      { phrase: "gold — accounts for nearly all the non-US export growth Canada saw this year", source: "derived", note: "NAPCS 35 (gold/silver/PGM) Δ non-US exports March 2026 vs March 2025: roughly +C$4,784M — roughly 6x the next-largest non-US gain (oil at +C$816M). Sum of all positive non-US Δs across NAPCS sub-chapters is dominated by NAPCS 35. Source: StatCan 12-10-0182-01." },
      { phrase: "Every other product cluster sits near zero on the non-US axis", source: "derived", note: "Visible from the scatter: outside NAPCS 35, no sub-chapter exceeds ~C$1B Δ non-US between March 2025 and March 2026. Source: StatCan 12-10-0182-01." },
    ],
  },
  {
    id: "plate-3",
    number: "03",
    chartKey: "trade-panel-gold",
    indicator: "Gold and PGM exports: total and UK destination, with gold price",
    plateIndexLabel: "Gold corridor",
    title: "London is buying all of Canada's gold — prices hit record highs.",
    interpretationHtml:
      "For decades, gold has been mined in Ontario and Quebec and sent straight to London's bullion banks, who store much of it in the Bank of England's vaults. " +
      "The story is old; what's new is the price. " +
      "With spot nearly at $4,700, Canada sold C$8 billion of precious metals in March — more than twice as much as last year.",
    callout: {
      value: "97%",
      unitPrefix: "UK share of gold/PGM exports",
      delta: "Mar 2026",
      direction: "neutral",
    },
    source: "Statistics Canada Table 12-10-0182-01 (NAPCS 35: unwrought gold, silver, and PGM by partner country); Yahoo Finance (gold futures, USD/oz).",
    data: null,
    citations: [
      { phrase: "gold has been mined in Ontario and Quebec", source: "derived", note: "Natural Resources Canada: Ontario and Quebec are the two largest gold-producing provinces, together accounting for roughly three-quarters of Canadian gold production." },
      { phrase: "sent straight to London's bullion banks, who store much of it in the Bank of England's vaults", source: "derived", note: "Royal Canadian Mint named on the original LBMA Good Delivery List in 1934; Canadian refined gold flows to LBMA-member bullion banks (HSBC, JPM, ICBC Standard) in London, who custody a substantial portion of their bullion at the Bank of England. BoE vaults hold ~5,000 tonnes of gold, of which only ~300 tonnes is UK reserves; the balance is custody for foreign central banks and commercial bullion banks." },
      { phrase: "spot nearly at $4,700", source: "derived", note: "Gold futures (GC=F), monthly close, May 2026, ~$4,676 per ounce. Source: Yahoo Finance." },
      { phrase: "Canada sold C$8 billion of precious metals in March", source: "pipeline:statcan:12-10-0182-01", note: "NAPCS 35 (unwrought gold, silver, and platinum group metals) total exports, all countries, March 2026: C$8,026M ≈ C$8 billion." },
      { phrase: "more than twice as much as last year", source: "derived", note: "NAPCS 35 total exports: Mar 2026 = C$8,026M; Mar 2025 = C$3,651M. Ratio = 2.20x = +120% y/y. Source: StatCan 12-10-0182-01." },
    ],
  },
  {
    id: "plate-4",
    number: "04",
    chartKey: "trade-panel-sector-pivot",
    indicator: "Tariff-exposed sectors: US share of total exports, March 2025 vs March 2026",
    plateIndexLabel: "Tariff-exposed sectors",
    title: "Of the tariff-exposed sectors, only aluminum has diversified meaningfully.",
    interpretationHtml:
      "Of the five tariff-exposed sectors charted, only aluminum has meaningfully shifted away from the US — down almost 11 points between March 2025 and March 2026, with real volume routed to non-US buyers. " +
      "Steel, softwood, and cars each shed under five points of US share; copper drifted the other way and became slightly more US-dependent. " +
      "One sector adapted; the rest stayed locked in.",
    source: "Statistics Canada Table 12-10-0182-01 (NAPCS sub-chapter exports by partner country).",
    data: null,
    citations: [
      { phrase: "the five tariff-exposed sectors charted", source: "derived", note: "Chart renders five sectors: steel (NAPCS 30+31), aluminum (NAPCS 32+38), copper (NAPCS 33), softwood (NAPCS 55), cars (NAPCS 81). Of these, steel/aluminum/copper/cars are subject to US Section 232 tariffs (steel + aluminum 2018+, copper July 2025 50%, autos April 2025 25%); softwood is covered by US AD/CVD duties (Lumber V dispute, 2017+) rather than Section 232. 'Tariff-exposed' is the accurate framing. Source: StatCan 12-10-0182-01." },
      { phrase: "aluminum has meaningfully shifted away from the US — down almost 11 points", source: "derived", note: "Aluminum (NAPCS 32+38) US share: Mar 2025 = 96.9%; Mar 2026 = 86.0%; Δ = -10.9pp ≈ 11pp. Source: StatCan 12-10-0182-01." },
      { phrase: "between March 2025 and March 2026", source: "pipeline:statcan:12-10-0182-01", note: "Window of analysis for all sector-share computations." },
      { phrase: "Steel, softwood, and cars each shed under five points of US share", source: "derived", note: "Steel Δ = -4.8pp (91.1% → 86.3%); softwood Δ = -1.8pp (90.5% → 88.7%); cars Δ = -1.5pp (92.2% → 90.6%). All under 5pp. Source: StatCan 12-10-0182-01." },
      { phrase: "copper drifted the other way and became slightly more US-dependent", source: "derived", note: "Copper (NAPCS 33) US share: Mar 2025 = 80.7%; Mar 2026 = 81.7%; Δ = +1.0pp. Only sector in the cohort whose US share rose over the window. Source: StatCan 12-10-0182-01." },
    ],
  },
];

const pageTitle = "Trade";
const pageDescription =
  "Canadian trade chartbook: merchandise balance, US partner share, sector-level export pivot, gold flows, and trade reorientation under tariffs.";

// Lede reads the same editorial blurb the auto-blurb pipeline writes for the
// splash tile (sections.ts -> section.blurb.body). Single source of truth: a
// release-day fan-out updates one field and both surfaces refresh.
const lede = section.blurb?.body ?? "";
---
<SectionLayout
  slug="trade"
  sectionIndex={6}
  sectionLabel="Trade"
  headlineQuestion={section.headlineQuestion}
  lede={lede}
  latestReleaseLabel={latestReleaseLabel}
  plates={plates}
  title={pageTitle}
  description={pageDescription}
/>
