---
/*
 * /overview/ — Canadian macro overview (the dashboard).
 *
 * Three stacked surfaces:
 *   1. Indicator panel grid: 2x4 hairline-bordered cells, one per
 *      section. Fiscal cell renders "In development" while the chartbook
 *      is in team review.
 *   2. Week ahead: Canadian economic calendar parsed from the Forex
 *      Factory XML feed at build time. Sibley-styled (Manrope + Plex
 *      Mono, hairlines, accent on high-impact). Ottawa time. Currency
 *      column dropped (CAD-only view). See FF section below for cache
 *      + timezone logic.
 *   3. What we're reading: live reporter-byline feed powered by the
 *      Cloudflare Worker at workers/news-feed/. Browser fetches the
 *      Worker on page load; Worker aggregates Google News RSS across
 *      a curated reporter list, dedupes by URL, returns top items.
 *
 * Promoted from /overview-ff/ on 2026-05-25 — the previous /overview/
 * used investing.com's iframe widget for the calendar; archived at
 * src/pages/_archive/overview-investingcom.astro.
 *
 * Forex Factory feed model: their XML at
 * `nfs.faireconomy.media/ff_calendar_thisweek.xml` is open. We fetch
 * at build time, parse, render. 6-hour disk cache at
 * `data/derived/ff_calendar_cache.xml` prevents hammering FF on
 * rapid rebuilds (they rate-limit aggressively). On fetch failure
 * (429, network, etc.) we fall back to the cached copy regardless
 * of age — better to render yesterday's calendar than the empty
 * state.
 *
 * Timezone: the Forex Factory XML feed publishes ALL times in GMT/UTC.
 * The feed text "12:30pm" for a StatCan release is actually 8:30 AM ET.
 * convertFFTimestamp() reads (date, time) → returns the ET-localised
 * date+time. Date is recomputed because a late-night GMT event could
 * fall on the prior ET date.
 */
import { readFileSync, writeFileSync, existsSync, statSync, mkdirSync } from "node:fs";
import { dirname, resolve } from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import TitleStatement from "../components/home/TitleStatement.astro";
import SectionPanel from "../components/home/SectionPanel.astro";
import { site } from "../data/sections";
import { enrichedSections, type EnrichedSection } from "../data/site_data_loader";

// --- Section panel grid (same as /overview/) ---------------------------------
const ordered: EnrichedSection[] = enrichedSections;

// --- Date line --------------------------------------------------------------
const today = new Date();
const longDate = new Intl.DateTimeFormat("en-CA", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "America/Toronto",
}).format(today);

// --- Forex Factory feed -----------------------------------------------------
type FFEvent = {
  title: string;
  country: string;
  date: string;   // raw "MM-DD-YYYY"
  time: string;   // raw "h:mma" or "All Day" / "Tentative"
  impact: "High" | "Medium" | "Low" | "Holiday" | string;
  forecast: string;
  previous: string;
  url: string;
};

type FFDayBucket = {
  dateLabel: string;
  isoDate: string;
  events: FFEvent[];
};

const FF_URL = "https://nfs.faireconomy.media/ff_calendar_thisweek.xml";
const FF_CACHE_PATH = resolve(process.cwd(), "data/derived/ff_calendar_cache.xml");
const FF_CACHE_TTL_MS = 6 * 60 * 60 * 1000; // 6h
const COUNTRIES_KEEP = new Set(["CAD"]);

let ffBuckets: FFDayBucket[] = [];
let ffFetchError: string | null = null;

// Plain-text extractor for a CDATA-wrapped XML field. The FF feed uses
// `<title>...</title>` (no CDATA) and `<date><![CDATA[...]]></date>`. Handle
// both; trim whitespace.
const stripCData = (s: string): string => {
  const m = s.match(/<!\[CDATA\[([\s\S]*?)\]\]>/);
  if (m) return m[1]!.trim();
  return s.trim();
};
const tagText = (block: string, tag: string): string => {
  const re = new RegExp(`<${tag}>([\\s\\S]*?)<\\/${tag}>`, "i");
  const m = block.match(re);
  if (!m) return "";
  return stripCData(m[1]!);
};

// MM-DD-YYYY -> ISO YYYY-MM-DD
const toISO = (raw: string): string => {
  const m = raw.match(/^(\d{2})-(\d{2})-(\d{4})$/);
  if (!m) return raw;
  return `${m[3]}-${m[1]}-${m[2]}`;
};

// Convert Forex Factory's GMT timestamp to America/Toronto.
// Returns { etDateISO, etTimeLabel }. On non-numeric times ("All Day",
// "Tentative", blank), passes the raw date and the raw time label through.
const TIME_FMT_ET = new Intl.DateTimeFormat("en-US", {
  timeZone: "America/Toronto",
  hour: "numeric",
  minute: "2-digit",
  hour12: true,
});
const DATE_FMT_ET = new Intl.DateTimeFormat("en-CA", {
  timeZone: "America/Toronto",
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
});
const convertFFTimestamp = (
  rawDate: string,
  rawTime: string,
): { etDateISO: string; etTimeLabel: string } => {
  const tm = rawTime.match(/^(\d+):(\d+)(am|pm)$/i);
  const dm = rawDate.match(/^(\d{2})-(\d{2})-(\d{4})$/);
  if (!tm || !dm) {
    // Pass-through for "All Day", "Tentative", or unparseable.
    return { etDateISO: toISO(rawDate), etTimeLabel: rawTime || "—" };
  }
  let h = parseInt(tm[1]!, 10);
  const mins = parseInt(tm[2]!, 10);
  const isPM = tm[3]!.toLowerCase() === "pm";
  if (isPM && h < 12) h += 12;
  if (!isPM && h === 12) h = 0;
  const mm = parseInt(dm[1]!, 10);
  const dd = parseInt(dm[2]!, 10);
  const yyyy = parseInt(dm[3]!, 10);
  // FF time is GMT — construct a UTC Date with no offset, then re-format
  // the same instant in the America/Toronto zone.
  const utc = new Date(Date.UTC(yyyy, mm - 1, dd, h, mins));
  const etDateISO = DATE_FMT_ET.format(utc); // en-CA yields "YYYY-MM-DD"
  const etTimeLabel = TIME_FMT_ET.format(utc)
    .toLowerCase()
    .replace(/\s/g, ""); // "8:30am"
  return { etDateISO, etTimeLabel };
};

const MONTH_NAMES = [
  "January", "February", "March", "April", "May", "June",
  "July", "August", "September", "October", "November", "December",
];
const dayLabel = (iso: string): string => {
  const m = iso.match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if (!m) return iso;
  const y = parseInt(m[1]!, 10);
  const mo = parseInt(m[2]!, 10);
  const d = parseInt(m[3]!, 10);
  const dt = new Date(Date.UTC(y, mo - 1, d));
  const dow = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"][dt.getUTCDay()];
  return `${dow}, ${MONTH_NAMES[mo - 1]} ${d}`;
};

// --- Fetch w/ disk cache ----------------------------------------------------
// Freshness is DATA-AWARE, not mtime-aware.
//
// Root cause of the original stale-calendar bug: `git checkout` resets every
// file's mtime to "now", so the mtime-based TTL always passed in CI →
// the build used whatever was committed and never fetched live. Fixed by
// inspecting the dates INSIDE the cached XML: the cache is only considered
// fresh if it contains at least one event whose date falls within the current
// ISO week. mtime is no longer consulted for freshness; the former FF_CACHE_TTL_MS
// is retained only as a secondary guard for local dev (rapid re-builds within
// the same week where data-aware freshness would always pass).
//
// Staleness guard: after parsing, if the calendar covers only dates that are
// entirely in the past, a build warning is emitted. In CI (GITHUB_ACTIONS=true)
// this becomes a hard error so stale content cannot ship silently.

// Return the ISO week identifier "YYYY-Www" for a given Date.
const isoWeekKey = (d: Date): string => {
  // Thursday-based ISO week: shift to Thursday's week, then compute.
  const tmp = new Date(Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate()));
  tmp.setUTCDate(tmp.getUTCDate() + 4 - (tmp.getUTCDay() || 7));
  const yearStart = new Date(Date.UTC(tmp.getUTCFullYear(), 0, 1));
  const week = Math.ceil(((tmp.getTime() - yearStart.getTime()) / 86400000 + 1) / 7);
  return `${tmp.getUTCFullYear()}-W${String(week).padStart(2, "0")}`;
};

// Parse all event dates from a raw XML string and return the latest one as a
// Date. Returns null if the XML has no parseable dates.
const latestEventDate = (rawXml: string): Date | null => {
  const dateMatches = rawXml.matchAll(/<date><!\[CDATA\[(\d{2}-\d{2}-\d{4})\]\]><\/date>/g);
  let latest: Date | null = null;
  for (const m of dateMatches) {
    const parts = m[1]!.match(/^(\d{2})-(\d{2})-(\d{4})$/);
    if (!parts) continue;
    const d = new Date(Date.UTC(
      parseInt(parts[3]!, 10),
      parseInt(parts[1]!, 10) - 1,
      parseInt(parts[2]!, 10),
    ));
    if (!latest || d > latest) latest = d;
  }
  return latest;
};

// True if the cached XML covers the CURRENT ISO week.
const ffCacheCoversCurrentWeek = (rawXml: string): boolean => {
  const latest = latestEventDate(rawXml);
  if (!latest) return false;
  return isoWeekKey(latest) === isoWeekKey(new Date());
};

const readCache = (): string | null => {
  if (!existsSync(FF_CACHE_PATH)) return null;
  try { return readFileSync(FF_CACHE_PATH, { encoding: "latin1" }); }
  catch { return null; }
};
const writeCache = (xml: string): void => {
  try {
    mkdirSync(dirname(FF_CACHE_PATH), { recursive: true });
    writeFileSync(FF_CACHE_PATH, xml, { encoding: "latin1" });
  } catch { /* swallow — cache is best-effort */ }
};

// Statistic-only: still read mtime for a secondary local-dev guard so rapid
// re-builds on the same week don't hammer FF on every `npm run build`. In CI
// mtime is meaningless (always "now" after git checkout); the data-aware check
// is the authoritative gate in both environments.
const cacheAgeMs = (): number | null => {
  if (!existsSync(FF_CACHE_PATH)) return null;
  try { return Date.now() - statSync(FF_CACHE_PATH).mtimeMs; }
  catch { return null; }
};

let xml: string | null = null;
// Step 1: read the cache and check data-aware freshness first.
const cachedXml = readCache();
const cachedCoversThisWeek = cachedXml !== null && ffCacheCoversCurrentWeek(cachedXml);
const localAge = cacheAgeMs();
const withinMttlWindow = localAge !== null && localAge < FF_CACHE_TTL_MS;

if (cachedCoversThisWeek && withinMttlWindow) {
  // Local dev: cache covers this week AND was written recently. Use it.
  xml = cachedXml;
} else if (cachedCoversThisWeek && process.env.GITHUB_ACTIONS !== "true") {
  // Local dev: cache covers this week but is older than TTL. Use it anyway —
  // FF data doesn't change mid-week. Only re-fetch if week rolled over.
  xml = cachedXml;
}
// In CI (GITHUB_ACTIONS=true): never use the cache as the primary source
// regardless of data-aware freshness, because the point of every CI build is
// to capture any mid-week forecast/previous updates FF pushes. The cache is
// the fallback-only path.

if (xml === null) {
  try {
    const res = await fetch(FF_URL, {
      headers: { "User-Agent": "SibleyCreek/1.0 (+https://sibleycreek.ca)" },
    });
    if (!res.ok) {
      ffFetchError = `Forex Factory feed returned HTTP ${res.status}; using cached copy.`;
      // Fall back to cache on HTTP error. The data-aware staleness guard
      // below will catch + warn/error if the cache is for a past week.
      xml = cachedXml;
    } else {
      const buf = await res.arrayBuffer();
      xml = new TextDecoder("windows-1252").decode(buf);
      writeCache(xml);
    }
  } catch (err) {
    ffFetchError = err instanceof Error ? err.message : "Unknown fetch error";
    // Fall back to cache on network error. Same staleness guard applies.
    xml = cachedXml;
  }
}

try {
  if (xml === null) {
    if (!ffFetchError) ffFetchError = "No Forex Factory data available (no cache, no network).";
  } else {
    // Live or cached XML in hand; parse the same way regardless.
    ffFetchError = null;
    const eventBlocks = xml.match(/<event>[\s\S]*?<\/event>/g) ?? [];

    const events: FFEvent[] = eventBlocks
      .map((block): FFEvent => ({
        title: tagText(block, "title"),
        country: tagText(block, "country"),
        date: tagText(block, "date"),
        time: tagText(block, "time"),
        impact: tagText(block, "impact"),
        forecast: tagText(block, "forecast"),
        previous: tagText(block, "previous"),
        url: tagText(block, "url"),
      }))
      .filter((e) => COUNTRIES_KEEP.has(e.country));

    // Group by ET date (date can shift if a GMT-late-night event lands
    // before the local ET day rolls over). Also overwrite the time label
    // and country-stripped date string on each event so render is ET-clean.
    const byDate = new Map<string, FFEvent[]>();
    for (const e of events) {
      const { etDateISO, etTimeLabel } = convertFFTimestamp(e.date, e.time);
      e.time = etTimeLabel;
      const arr = byDate.get(etDateISO) ?? [];
      arr.push(e);
      byDate.set(etDateISO, arr);
    }
    ffBuckets = Array.from(byDate.entries())
      .sort(([a], [b]) => a.localeCompare(b))
      .map(([isoDate, evs]) => ({
        isoDate,
        dateLabel: dayLabel(isoDate),
        events: evs,
      }));

    // ── Staleness guard ──────────────────────────────────────────────────────
    // After parsing, check that the calendar we're about to render actually
    // covers the current week. If every event date is in the past, we're
    // rendering a stale calendar — which is worse than the empty state because
    // it looks authoritative. Emit a build warning; in CI escalate to a hard
    // process exit so the stale content cannot ship silently.
    //
    // "Past week" criterion: the latest event date in the parsed XML belongs
    // to an ISO week that is strictly earlier than the current ISO week.
    const latestInXml = latestEventDate(xml);
    if (latestInXml !== null) {
      const xmlWeek = isoWeekKey(latestInXml);
      const nowWeek = isoWeekKey(new Date());
      if (xmlWeek < nowWeek) {
        const msg =
          `[overview] STALE CALENDAR: FF data covers ISO week ${xmlWeek}; ` +
          `current week is ${nowWeek}. The calendar being rendered is for a ` +
          `past week. Check FF fetch path / scheduled refresh workflow.`;
        if (process.env.GITHUB_ACTIONS === "true") {
          // Hard fail in CI: stale calendar must not ship.
          console.error(msg);
          process.exit(1);
        } else {
          // Build warning in local dev — not fatal, but visible.
          console.warn(msg);
        }
      }
    }
    // ── end staleness guard ──────────────────────────────────────────────────
  }
} catch (err) {
  ffFetchError = err instanceof Error ? err.message : "Unknown fetch error";
}

const pageDesc =
  `Canadian macro overview for ${longDate}. Eight indicator domains — output, ` +
  "inflation, labour, monetary, fiscal, housing, trade, markets — each with " +
  "an anchor chart and the latest prints, plus the Canadian week ahead and " +
  "a curated reporter byline feed. Independent research.";

// ────────────────────────────────────────────────────────────────────────────
// "What we're reading" — reporter-byline news feed.
//
// Build-time aggregation: rss-parser fetches Google News RSS for each
// reporter (quoted-name query), then we merge, dedupe by URL, sort by
// pubDate desc, take top 12. The render is fully server-side — no
// client JS needed.
//
// Freshness comes from GitHub Actions cron firing `deploy.yml` every
// 15 min, which re-runs this fetch. Each cron-triggered build hits
// Google News from a fresh GHA runner (no disk cache across runs).
//
// Local dev keeps a disk cache at `data/derived/news_feed_cache.json`
// with a 15-min TTL so rapid `npm run build` iterations don't hammer
// Google News from a single residential IP. On fetch failure (any
// reason), fall back to the cached copy regardless of age.
//
// Why Google News rather than per-outlet author RSS: most of these
// outlets (Globe, Bloomberg, WSJ, Reuters) don't publish per-byline
// RSS. Google News quoted-name search covers all of them.
import Parser from "rss-parser";

// Per-reporter feed sources. Three modes per reporter:
//   1. `rssUrl` set → fetch the outlet's per-author RSS directly
//      (Bloomberg .rss is the only outlet exposing this for our list)
//   2. `searchQuery` set → use this exact Google News query. For
//      reporters at outlets that paywall / bot-block direct access
//      (WSJ, Reuters, Globe), constraining the query with the outlet
//      name (e.g. `"Paul Vieira" "Wall Street Journal"`) drastically
//      improves both volume and signal — Google News indexes WSJ
//      headlines even though direct WSJ access is paywalled.
//   3. neither → default Google News query is `"Name"` (quoted)
//
// Bloomberg .rss verified 2026-05-25 via researcher (see
// research/reporter_rss_urls.md). Greg Quinn left Bloomberg for MNI
// Market News (subscription wire, no public RSS) — stays on Google
// News with no outlet constraint since MNI isn't well-indexed.
type ReporterFeed = {
  name: string;
  rssUrl?: string;
  searchQuery?: string;
  sourceLabel?: string;
  // Optional title-must-match regex. For columnists or wire reporters
  // whose Google News query returns articles that *mention* them but
  // aren't their bylines OR for wire reporters whose bylines appear
  // on non-beat stories (e.g. Reuters reporters credited on Cuba /
  // Iran / UFO wires alongside Canadian macro work), require the
  // title to pass a topic gate.
  titleMustMatch?: RegExp;
  // Override the source attribution for all items from this reporter.
  // Necessary for Reuters reporters whose articles appear via MSN /
  // TradingView syndication — the host is MSN but the byline is
  // Reuters wire. Outlet reservation groups on the override label.
  primaryOutlet?: string;
};

// Canada-topic gate for Reuters wire reporters. Reuters Canada
// correspondents get credited on multi-byline wire stories that
// often aren't Canadian (Rubio / Iran / UFO files / etc.). This
// regex drops anything without a Canada anchor in the title.
const REUTERS_CANADA_FILTER = /canad|loonie|TSX|BoC|Carney|StatCan|Ottawa|Champagne|Macklem|Bank of Canada/i;

const REPORTER_FEEDS: ReporterFeed[] = [
  // Bloomberg — direct per-author RSS (clean attribution by construction)
  { name: "Laura Dhillon Kane", rssUrl: "https://www.bloomberg.com/authors/AWTYgfjBi9I/laura-dhillon-kane.rss", sourceLabel: "BLOOMBERG" },
  { name: "Erik Hertzberg",     rssUrl: "https://www.bloomberg.com/authors/ASMz3hGbX_o/erik-hertzberg.rss",     sourceLabel: "BLOOMBERG" },
  { name: "Nojoud Al Mallees",  rssUrl: "https://www.bloomberg.com/authors/AXv522UYITE/nojoud-al-mallees.rss",  sourceLabel: "BLOOMBERG" },
  { name: "Brian Platt",        rssUrl: "https://www.bloomberg.com/authors/AVhsUwCy8eU/brian-platt.rss",        sourceLabel: "BLOOMBERG" },
  { name: "Derek Decloet",      rssUrl: "https://www.bloomberg.com/authors/AUgcl3vfSXE/derek-decloet.rss",      sourceLabel: "BLOOMBERG" },
  // WSJ — Google News with outlet constraint (direct WSJ access is paywalled / bot-blocked)
  { name: "Paul Vieira",        searchQuery: '"Paul Vieira" "Wall Street Journal"' },
  { name: "Robb Stewart",       searchQuery: '"Robb Stewart" "Wall Street Journal"' },
  // Reuters — broaden the site filter to include MSN + TradingView
  // syndication. The plain "<Name>" Reuters query misses multi-byline
  // wire stories (AI-Workers, BoC-Patient, Inflation-2.8% verified
  // 2026-05-25) — those appear under MSN / TradingView. Then a Canada-
  // topic title filter drops non-Canadian wires (Rubio / Cuba / UFO).
  // primaryOutlet forces display = REUTERS regardless of host.
  { name: "Promit Mukherjee",   searchQuery: '"Promit Mukherjee" (site:reuters.com OR site:msn.com OR site:tradingview.com)', titleMustMatch: REUTERS_CANADA_FILTER, primaryOutlet: "REUTERS" },
  { name: "David Ljunggren",    searchQuery: '"David Ljunggren" (site:reuters.com OR site:msn.com OR site:tradingview.com)',  titleMustMatch: REUTERS_CANADA_FILTER, primaryOutlet: "REUTERS" },
  { name: "Fergal Smith",       searchQuery: '"Fergal Smith" (site:reuters.com OR site:msn.com OR site:tradingview.com)',     titleMustMatch: REUTERS_CANADA_FILTER, primaryOutlet: "REUTERS" },
  // Globe and Mail — Google News with outlet constraint
  { name: "Matt Lundy",         searchQuery: '"Matt Lundy" "Globe and Mail"' },
  { name: "Mark Rendell",       searchQuery: '"Mark Rendell" "Globe and Mail"' },
  { name: "Bill Curry",         searchQuery: '"Bill Curry" "Globe and Mail"' },
  // Coyne is a Globe Opinion columnist — his legit pieces start with
  // "Opinion:" or contain "Coyne" in the headline. Without this filter,
  // unrelated Globe news pieces that quote him in body get attributed
  // to him (false positive). NOTE: avoid \b anchors next to ":" — the
  // colon is non-word so \b after "Opinion:" never matches.
  { name: "Andrew Coyne",       searchQuery: '"Andrew Coyne" "Globe and Mail"', titleMustMatch: /Opinion:|Coyne/i },
  // The Logic — Carmichael's columns use "Carmichael:" prefix consistently
  { name: "Kevin Carmichael",   searchQuery: '"Kevin Carmichael" "The Logic"', titleMustMatch: /Carmichael/i },
  // MNI Market News — Greg Quinn's MNI bylines aren't headline-indexable
  // by Google News (subscription wire, no surfaced byline). His
  // Bloomberg .rss is stale (he left). Keeping the entry so the query
  // runs but expect zero results from current sources. Do NOT use the
  // "Greg Quinn" Substack at The Line — different person.
  { name: "Greg Quinn",         searchQuery: '"Greg Quinn" "MNI Market News"' },
];

// Outlet allowlist — substring match (lowercased) against the source
// name Google News appends to each item's title. Items from outlets not
// on this list are filtered out. Tightens noise from cross-matched
// player names (Transfermarkt soccer), niche industry blogs, etc.
const SOURCE_PATTERNS_KEEP = [
  "globe and mail",
  "bloomberg",          // also catches "BNN Bloomberg"
  "reuters",
  "wall street journal",
  "wsj",
  "financial post",
  "canadian press",
  "the logic",
  "national post",
  "cbc",
  "toronto star",
  "thestar",
];

const sourceAllowed = (sourceName: string): boolean => {
  if (!sourceName) return false;
  const lower = sourceName.toLowerCase();
  return SOURCE_PATTERNS_KEEP.some((p) => lower.includes(p));
};

// CBC items are kept only when they look like print news articles
// (cbc.ca/news/...). Their TV / radio program segments come through
// Google News with recognisable show-name prefixes — we exclude those.
// (Google News doesn't expose the underlying outlet URL, so we filter
// on the title format instead.)
const CBC_SHOW_PREFIXES = [
  "at issue",
  "power & politics",
  "power and politics",
  "cross country checkup",
  "the current",
  "as it happens",
  "front burner",
  "the house",
  "the national",
  "ideas",
  "q with",
  "quirks & quarks",
  "quirks and quarks",
];

const isCbcShowSegment = (sourceName: string, title: string): boolean => {
  if (!sourceName.toLowerCase().includes("cbc")) return false;
  const lowerTitle = title.toLowerCase();
  return CBC_SHOW_PREFIXES.some((prefix) => lowerTitle.startsWith(prefix));
};

// Normalize the raw source name from Google News to a short display
// label. Keeps the source column compact + visually consistent.
const normalizeSource = (raw: string): string => {
  if (!raw) return "";
  const lower = raw.toLowerCase();
  if (lower.includes("bnn")) return "BNN";
  if (lower.includes("bloomberg")) return "BLOOMBERG";
  if (lower.includes("globe and mail")) return "GLOBE";
  if (lower.includes("reuters")) return "REUTERS";
  if (lower.includes("wsj") || lower.includes("wall street journal")) return "WSJ";
  if (lower.includes("financial post")) return "FINANCIAL POST";
  if (lower.includes("canadian press")) return "CP";
  if (lower.includes("the logic")) return "THE LOGIC";
  if (lower.includes("national post")) return "NATIONAL POST";
  if (lower.includes("cbc")) return "CBC";
  if (lower.includes("toronto star") || lower.includes("thestar")) return "STAR";
  // Allowlist match got us here but the label isn't recognised —
  // uppercase the raw name as a defensive fallback.
  return raw.toUpperCase();
};

// Google News appends " - Outlet Name" to every title. Splitting on the
// last " - " gives us a cleaned title plus the source name without
// parsing extra XML or HTML.
const splitTitleAndSource = (rawTitle: string): { title: string; source: string } => {
  if (!rawTitle) return { title: "", source: "" };
  const lastDash = rawTitle.lastIndexOf(" - ");
  if (lastDash < 0) return { title: rawTitle, source: "" };
  return {
    title: rawTitle.slice(0, lastDash).trim(),
    source: rawTitle.slice(lastDash + 3).trim(),
  };
};

const NEWS_CACHE_PATH = resolve(process.cwd(), "data/derived/news_feed_cache.json");
const NEWS_CACHE_TTL_MS = 15 * 60 * 1000; // 15 min
const NEWS_TOP_N = 10;
// Freshness floor: drop items older than this from the feed before
// any per-outlet reservation. If an outlet has nothing in the window,
// no reservation — the feed shrinks rather than padding with stale
// content. 14 days fits the macro publishing cadence (covers BoC
// meeting cycles + monthly StatCan releases) without dragging in
// month-old wires.
const NEWS_MAX_AGE_DAYS = 14;
const NEWS_MAX_AGE_MS = NEWS_MAX_AGE_DAYS * 24 * 60 * 60 * 1000;

type NewsItem = {
  title: string;
  link: string;
  pubDate: string;
  source: string;
  reporter: string;
};

type NewsCache = {
  generatedAt: string | null;
  items: NewsItem[];
  wasDeduped: boolean;
};

const googleNewsUrl = (query: string): string => {
  const params = new URLSearchParams({
    q: query,
    hl: "en-CA",
    gl: "CA",
    ceid: "CA:en",
  });
  return `https://news.google.com/rss/search?${params.toString()}`;
};

const newsDedupeKey = (item: NewsItem): string => {
  const source = normalizeSource(item.source);
  const title = item.title
    .toLowerCase()
    .replace(/[’']/g, "")
    .replace(/[^a-z0-9]+/g, " ")
    .trim();
  return `${source}|${title}`;
};

const dedupeNewsItems = (items: NewsItem[]): NewsItem[] => {
  const seenUrls = new Set<string>();
  const seenStories = new Set<string>();
  const deduped: NewsItem[] = [];
  for (const item of items) {
    const storyKey = newsDedupeKey(item);
    if (!item.link || seenUrls.has(item.link) || seenStories.has(storyKey)) continue;
    seenUrls.add(item.link);
    seenStories.add(storyKey);
    deduped.push(item);
  }
  return deduped;
};

const newsParser = new Parser({
  timeout: 8000,
  headers: {
    "User-Agent":
      "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 " +
      "(KHTML, like Gecko) Chrome/121.0.0.0 Safari/537.36",
    Accept: "application/rss+xml, application/xml, text/xml, */*;q=0.1",
    "Accept-Language": "en-CA,en;q=0.9",
  },
});

const newsCacheAgeMs = (cache: NewsCache | null): number | null => {
  if (!cache?.generatedAt) return null;
  const generatedMs = Date.parse(cache.generatedAt);
  if (Number.isNaN(generatedMs)) return null;
  return Date.now() - generatedMs;
};

const readNewsCache = (): NewsCache | null => {
  if (!existsSync(NEWS_CACHE_PATH)) return null;
  try {
    const raw = readFileSync(NEWS_CACHE_PATH, "utf-8");
    const parsed = JSON.parse(raw);
    if (!Array.isArray(parsed?.items)) return null;
    const items = dedupeNewsItems(parsed.items);
    return {
      generatedAt: typeof parsed.generatedAt === "string" ? parsed.generatedAt : null,
      items,
      wasDeduped: items.length !== parsed.items.length,
    };
  } catch { return null; }
};

const writeNewsCache = (items: NewsItem[], generatedAt = new Date().toISOString()): void => {
  try {
    mkdirSync(dirname(NEWS_CACHE_PATH), { recursive: true });
    writeFileSync(
      NEWS_CACHE_PATH,
      JSON.stringify({ generatedAt, items: dedupeNewsItems(items) }, null, 2),
      "utf-8",
    );
  } catch { /* best-effort */ }
};

// Staleness guard for the news cache. Warn (or error in CI) if we're falling
// back to a cache whose newest item is older than NEWS_MAX_AGE_DAYS. This
// prevents silently rendering weeks-old headlines as "current" news. The
// threshold matches NEWS_MAX_AGE_MS so the live-fetch filter and the fallback
// guard use the same window.
const NEWS_STALE_WARN_THRESHOLD_MS = NEWS_MAX_AGE_MS;
const _warnIfNewsCacheStale = (cache: NewsCache): void => {
  const newest = cache.items.reduce((best, item) => {
    const t = Date.parse(item.pubDate);
    return Number.isNaN(t) ? best : Math.max(best, t);
  }, 0);
  if (newest === 0) return; // no parseable dates — skip
  const ageMs = Date.now() - newest;
  if (ageMs > NEWS_STALE_WARN_THRESHOLD_MS) {
    const ageDays = Math.round(ageMs / (24 * 60 * 60 * 1000));
    const msg =
      `[overview] STALE NEWS CACHE: newest item is ${ageDays} days old ` +
      `(threshold: ${NEWS_MAX_AGE_DAYS} days). Live fetch failed and the ` +
      `fallback cache is stale. Check Google News fetch / reporter list.`;
    if (process.env.GITHUB_ACTIONS === "true") {
      // Warn-only in CI for news (a broken Google News fetch is less severe
      // than a broken calendar; the section degrades gracefully). Escalate
      // to error only if the news section is truly empty.
      console.warn(msg);
    } else {
      console.warn(msg);
    }
  }
};

let newsItems: NewsItem[] = [];
let newsFromCache = false;

const cachedNews = readNewsCache();
// GitHub Actions checks out tracked files with fresh mtimes, so cache
// freshness must come from the JSON payload. In CI, prefer a live fetch
// on every scheduled build and reserve the cache for failure fallback.
const newsAge = process.env.GITHUB_ACTIONS === "true" ? null : newsCacheAgeMs(cachedNews);
if (newsAge !== null && newsAge < NEWS_CACHE_TTL_MS) {
  if (cachedNews && cachedNews.items.length > 0) {
    newsItems = cachedNews.items;
    newsFromCache = true;
    if (cachedNews.wasDeduped) {
      writeNewsCache(cachedNews.items, cachedNews.generatedAt ?? undefined);
    }
  }
}

if (newsItems.length === 0) {
  try {
    const settled = await Promise.allSettled(
      REPORTER_FEEDS.map(async ({ name, rssUrl, searchQuery, sourceLabel, titleMustMatch, primaryOutlet }) => {
        // Direct outlet RSS: feed's source is the outlet itself.
        let items: NewsItem[];
        if (rssUrl) {
          const feed = await newsParser.parseURL(rssUrl);
          items = (feed.items ?? []).map((item): NewsItem => ({
            title: (item.title ?? "").trim(),
            link: item.link ?? "",
            pubDate: item.pubDate ?? item.isoDate ?? "",
            source: primaryOutlet ?? sourceLabel ?? "",
            reporter: name,
          }));
        } else {
          // Fallback: Google News search. primaryOutlet overrides the
          // raw source from title-split — useful when the same byline
          // appears across multiple hosts (Reuters wire syndicated to
          // MSN / TradingView).
          const query = searchQuery ?? `"${name}"`;
          const feed = await newsParser.parseURL(googleNewsUrl(query));
          items = (feed.items ?? []).map((item): NewsItem => {
            const { title, source: rawSource } = splitTitleAndSource(item.title ?? "");
            return {
              title,
              link: item.link ?? "",
              pubDate: item.pubDate ?? "",
              source: primaryOutlet ?? rawSource,
              reporter: name,
            };
          });
        }
        // Per-reporter title filter — drops false positives (columnist
        // misattributions) and off-beat content (Reuters reporters
        // credited on non-Canadian wires).
        if (titleMustMatch) {
          items = items.filter((it) => titleMustMatch.test(it.title));
        }
        return items;
      }),
    );

    const all: NewsItem[] = settled
      .flatMap((s) => (s.status === "fulfilled" ? s.value : []))
      .filter((item) => sourceAllowed(item.source))
      .filter((item) => !isCbcShowSegment(item.source, item.title));

    // Dedupe by URL and by normalized source/title. Google News often
    // emits the same wire story through multiple RSS URLs.
    const deduped = dedupeNewsItems(all);

    // Sort all dedupes by pubDate desc — basis for both per-outlet
    // selection and recency fill.
    deduped.sort((a, b) => {
      const at = Date.parse(a.pubDate) || 0;
      const bt = Date.parse(b.pubDate) || 0;
      return bt - at;
    });

    // Freshness floor: drop items older than NEWS_MAX_AGE_DAYS. Applied
    // before reservation so per-outlet minimums only count fresh items.
    const nowMs = Date.now();
    const fresh = deduped.filter((item) => {
      const t = Date.parse(item.pubDate);
      if (Number.isNaN(t)) return false;
      return nowMs - t <= NEWS_MAX_AGE_MS;
    });

    // Per-outlet minimum: guarantee at least N items per outlet, where
    // N varies by outlet. WSJ and Reuters get 2 each (lower publishing
    // cadence than Bloomberg, otherwise crowded out). Others default
    // to 1 so each outlet in the curated list has at least token
    // representation even on busy Bloomberg days.
    const OUTLET_MINIMUMS: Record<string, number> = {
      WSJ: 2,
      REUTERS: 2,
      GLOBE: 2,
    };
    const DEFAULT_OUTLET_MIN = 1;

    const reservedByOutlet = new Map<string, NewsItem[]>();
    for (const item of fresh) {
      const outlet = normalizeSource(item.source);
      if (!outlet) continue;
      const min = OUTLET_MINIMUMS[outlet] ?? DEFAULT_OUTLET_MIN;
      const existing = reservedByOutlet.get(outlet) ?? [];
      if (existing.length < min) {
        existing.push(item);
        reservedByOutlet.set(outlet, existing);
      }
    }
    const reservedItems = Array.from(reservedByOutlet.values()).flat();
    const reservedSet = new Set(reservedItems);
    const fillItems = fresh.filter((i) => !reservedSet.has(i));

    const combined = [
      ...reservedItems,
      ...fillItems.slice(0, Math.max(0, NEWS_TOP_N - reservedItems.length)),
    ];
    // Final sort by date for display order.
    combined.sort((a, b) => {
      const at = Date.parse(a.pubDate) || 0;
      const bt = Date.parse(b.pubDate) || 0;
      return bt - at;
    });

    newsItems = combined.slice(0, NEWS_TOP_N);

    if (newsItems.length > 0) {
      writeNewsCache(newsItems);
    } else {
      // Empty live fetch — fall back to stale cache if available.
      const stale = readNewsCache();
      if (stale && stale.items.length > 0) {
        newsItems = stale.items;
        newsFromCache = true;
        if (stale.wasDeduped) {
          writeNewsCache(stale.items, stale.generatedAt ?? undefined);
        }
        // Staleness guard for news cache fallback.
        _warnIfNewsCacheStale(stale);
      }
    }
  } catch (_err) {
    const stale = readNewsCache();
    if (stale && stale.items.length > 0) {
      newsItems = stale.items;
      newsFromCache = true;
      if (stale.wasDeduped) {
        writeNewsCache(stale.items, stale.generatedAt ?? undefined);
      }
      // Staleness guard for news cache fallback.
      _warnIfNewsCacheStale(stale);
    }
  }
}

// Format pubDate for render. Date only — Google News reports pubDate
// as the indexing time rather than the original publication time, so
// time-of-day is unreliable across most of our sources. Showing only
// the date keeps the imprecision invisible. Bloomberg direct RSS does
// have accurate times but we display uniformly to keep the row
// consistent across mixed sources.
const NEWS_LABEL_FMT = new Intl.DateTimeFormat("en-US", {
  timeZone: "America/Toronto",
  month: "short",
  day: "numeric",
});
const fmtNewsDate = (raw: string): string => {
  const t = Date.parse(raw);
  if (Number.isNaN(t)) return "";
  return NEWS_LABEL_FMT.format(new Date(t));
};
---
<BaseLayout
  title={`Overview — ${site.name}`}
  description={pageDesc}
  pageClass="home-page"
  showMastheadRail={true}
>
  <article class="home">
    <TitleStatement dateLine={longDate} />

    <section class="home__grid" aria-label="Indicator panels">
      <h2 class="visually-hidden">Indicator panels</h2>
      {ordered.map((s, i) => (
        <div class="home__cell">
          {s.slug === "fiscal" ? (
            <a class="fiscal-soon" href="/fiscal/">
              <p class="fiscal-soon__eyebrow">
                <span class="fiscal-soon__fig">Figure</span>
                <span class="fiscal-soon__fig-n">{String(i + 1)}.</span>
              </p>
              <h3 class="fiscal-soon__h">Fiscal</h3>
              <p class="fiscal-soon__lede">
                What is Canada's fiscal policy stance?
              </p>
              <p class="fiscal-soon__stamp">In development</p>
            </a>
          ) : (
            <SectionPanel section={s} figureNum={String(i + 1)} />
          )}
        </div>
      ))}
    </section>

    <section class="ffcal" aria-labelledby="ffcal-h">
      <header class="ffcal__head">
        <p class="ffcal__eyebrow">
          <span class="ffcal__fig">Figure</span>
          <span class="ffcal__fig-n">9.</span>
        </p>
        <h2 id="ffcal-h" class="ffcal__h">Week ahead</h2>
      </header>

      {ffFetchError ? (
        <p class="ffcal__error">Calendar feed unavailable: {ffFetchError}</p>
      ) : ffBuckets.length === 0 ? (
        <p class="ffcal__error">No Canadian events listed for this week.</p>
      ) : (
        <div class="ffcal__body">
          {ffBuckets.map((bucket) => (
            <div class="ffcal__day">
              <h3 class="ffcal__day-h">{bucket.dateLabel}</h3>
              <table class="ffcal__table">
                <colgroup>
                  <col class="ffcal__col--time" />
                  <col class="ffcal__col--imp" />
                  <col class="ffcal__col--event" />
                  <col class="ffcal__col--num" />
                  <col class="ffcal__col--num" />
                </colgroup>
                <thead>
                  <tr>
                    <th class="ffcal__th ffcal__th--time">Time</th>
                    <th class="ffcal__th ffcal__th--imp">Importance</th>
                    <th class="ffcal__th ffcal__th--event">Event</th>
                    <th class="ffcal__th ffcal__th--num">Forecast</th>
                    <th class="ffcal__th ffcal__th--num">Previous</th>
                  </tr>
                </thead>
                <tbody>
                  {bucket.events.map((ev) => (
                    <tr class={`ffcal__row ffcal__row--${(ev.impact || "low").toLowerCase()}`}>
                      <td class="ffcal__td ffcal__td--time">{ev.time || "—"}</td>
                      <td class="ffcal__td ffcal__td--imp">
                        <span class={`ffcal__impact ffcal__impact--${(ev.impact || "low").toLowerCase()}`}>
                          {ev.impact || "—"}
                        </span>
                      </td>
                      <td class="ffcal__td ffcal__td--event">{ev.title}</td>
                      <td class="ffcal__td ffcal__td--num">{ev.forecast || "—"}</td>
                      <td class="ffcal__td ffcal__td--num">{ev.previous || "—"}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ))}
        </div>
      )}

      <p class="ffcal__attribution">
        Calendar data from
        <a href="https://www.forexfactory.com/calendar" rel="nofollow noopener" target="_blank">Forex Factory</a>.
        Ottawa time.
      </p>
    </section>

    {/* ──────────────── What we're reading (reporter byline feed) ────────────────
         Server-side rendered at build time. The fetch lives in this page's
         frontmatter above; rss-parser pulls Google News RSS for each
         reporter, merges/dedupes/sorts. GitHub Actions cron triggers a
         redeploy every 15 min so the live site stays close to current. */}
    <section class="reading" aria-labelledby="reading-h">
      <header class="reading__head">
        <p class="reading__eyebrow">
          <span class="reading__fig">Figure</span>
          <span class="reading__fig-n">10.</span>
        </p>
        <h2 id="reading-h" class="reading__h">On our radar</h2>
      </header>

      <div class="reading__body">
        {newsItems.length === 0 ? (
          <p class="reading__error">
            Feed unavailable. Refresh on the next build.
          </p>
        ) : (
          <ol class="reading__list" role="list">
            {newsItems.map((item) => (
              <li class="reading__row">
                <a
                  class="reading__row-link"
                  href={item.link}
                  rel="noopener"
                  target="_blank"
                  title={item.title}
                >
                  <span class="reading__row-date">{fmtNewsDate(item.pubDate)}</span>
                  <span class="reading__row-source">{normalizeSource(item.source)}</span>
                  <span class="reading__row-title">{item.title}</span>
                </a>
              </li>
            ))}
          </ol>
        )}
      </div>

      <p class="reading__attribution">
        Bylines from a curated reporter list. Data via Google News RSS.
        {newsFromCache && " (cached)"}
      </p>
    </section>

  </article>

  <style>
    /* ──────────────── Section panel grid (same as /overview/) ──────────────── */
    .home__grid {
      margin-top: 28px;
      display: grid;
      grid-template-columns: 1fr;
      gap: 0;
      border-top: 1px solid var(--ink);
      border-left: 1px solid var(--ink);
    }
    @media (min-width: 760px) {
      .home__grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
    .home__cell {
      min-width: 0;
      display: flex;
      border-right: 1px solid var(--ink);
      border-bottom: 1px solid var(--ink);
    }
    .home__cell > :global(*) {
      width: 100%;
    }
    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    /* ──────────────── Fiscal "In development" placeholder cell ──────────────── */
    .fiscal-soon {
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      padding: 20px 22px 24px;
      min-height: 260px;
      text-decoration: none;
      color: var(--ink);
      transition: background-color 0.15s ease;
    }
    .fiscal-soon:hover { background-color: rgba(0, 0, 0, 0.02); }
    .fiscal-soon:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: -2px;
    }
    .fiscal-soon__eyebrow {
      margin: 0 0 12px;
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 10px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--ink);
      line-height: 1.4;
    }
    .fiscal-soon__fig { color: var(--ink); font-weight: 600; }
    .fiscal-soon__fig-n {
      color: var(--accent);
      font-weight: 800;
      margin-left: 0.2em;
    }
    .fiscal-soon__h {
      margin: 0 0 8px;
      font-family: var(--font-sans);
      font-weight: 800;
      font-size: 22px;
      letter-spacing: -0.01em;
      line-height: 1.05;
      color: var(--ink);
    }
    .fiscal-soon__lede {
      margin: 0 0 auto;
      font-family: var(--font-sans);
      font-weight: 300;
      font-size: 15px;
      line-height: 1.4;
      color: var(--ink);
    }
    .fiscal-soon__stamp {
      margin: 28px 0 0;
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 10px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--ink-soft, #777);
    }

    /* ──────────────── Forex Factory calendar (Sibley-styled) ──────────────── */
    .ffcal {
      margin-top: 32px;
      padding-bottom: 28px;
    }
    .ffcal__head { padding-bottom: 10px; }
    .ffcal__eyebrow {
      margin: 0;
      padding-top: 16px;
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 10px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--ink);
      line-height: 1.4;
    }
    .ffcal__fig { color: var(--ink); font-weight: 600; }
    .ffcal__fig-n { color: var(--accent); font-weight: 800; margin-left: 0.2em; }
    .ffcal__h {
      margin: 6px 0 0;
      font-family: var(--font-sans);
      font-weight: 800;
      font-size: 22px;
      letter-spacing: -0.01em;
      line-height: 1.05;
      color: var(--ink);
    }

    .ffcal__error {
      margin: 24px 0 0;
      font-family: var(--font-sans);
      font-weight: 400;
      font-size: 13px;
      color: var(--ink);
      opacity: 0.6;
    }

    .ffcal__body {
      margin-top: 16px;
      max-width: 920px;
    }
    .ffcal__day { margin-bottom: 20px; }
    .ffcal__day-h {
      margin: 0 0 4px;
      padding-bottom: 6px;
      font-family: var(--font-sans);
      font-weight: 700;
      font-size: 13px;
      letter-spacing: 0.04em;
      color: var(--ink);
      border-bottom: 1px solid var(--ink);
    }
    .ffcal__table {
      width: 100%;
      /* table-layout: fixed pins col widths to the <colgroup>, so every
