      color: var(--ink);
      text-decoration: none;
      border-bottom: 1px solid var(--ink);
      margin-left: 0.3em;
    }
    .ffcal__attribution a:hover {
      color: var(--accent);
      border-bottom-color: var(--accent);
    }
    .ffcal__attribution a:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 3px;
    }

    @media (max-width: 600px) {
      .ffcal__th--num,
      .ffcal__td--num {
        display: none;
      }
    }

    /* ──────────────── What we're reading (reporter bylines) ──────────────── */
    .reading {
      margin-top: 40px;
      padding-bottom: 28px;
    }
    .reading__head { padding-bottom: 10px; }
    .reading__eyebrow {
      margin: 0;
      padding-top: 16px;
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 10px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--ink);
      line-height: 1.4;
    }
    .reading__fig { color: var(--ink); font-weight: 600; }
    .reading__fig-n { color: var(--accent); font-weight: 800; margin-left: 0.2em; }
    .reading__h {
      margin: 6px 0 0;
      font-family: var(--font-sans);
      font-weight: 800;
      font-size: 22px;
      letter-spacing: -0.01em;
      line-height: 1.05;
      color: var(--ink);
    }

    .reading__body {
      margin-top: 16px;
      max-width: 920px;
    }

    .reading__loading,
    .reading__error {
      margin: 12px 0 0;
      font-family: var(--font-sans);
      font-weight: 400;
      font-size: 13px;
      line-height: 1.4;
      color: var(--ink);
      opacity: 0.6;
    }

    .reading__list {
      margin: 0;
      padding: 0;
      list-style: none;
      border-top: 1px solid var(--ink);
    }
    .reading__row {
      margin: 0;
      padding: 0;
      border-bottom: 1px solid rgba(0,0,0,0.08);
    }
    /* Bloomberg-terminal-style one-line layout. Each column has
     * overflow control so nothing spills into its neighbour:
     *   [date 70px] [source 110px] [headline flex]
     * Date is now month + day only (e.g. "May 23") so the column
     * shrinks. Source column fits "FINANCIAL POST" (longest
     * abbreviated label) in Manrope 600 10px 0.14em. */
    .reading__row-link {
      display: grid;
      grid-template-columns: 70px 110px minmax(0, 1fr);
      align-items: baseline;
      column-gap: 16px;
      padding: 7px 0;
      text-decoration: none;
      color: var(--ink);
      transition: background-color 0.12s ease;
    }
    .reading__row-link:hover { background-color: rgba(0,0,0,0.025); }
    .reading__row-link:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: -2px;
    }

    /* Date — Plex Mono, mirrors the calendar's time column register.
     * overflow controls keep it inside the 130px column even if
     * tomorrow's locale formatting produces a longer string. */
    .reading__row-date {
      font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
      font-size: 11px;
      letter-spacing: 0;
      color: var(--ink);
      opacity: 0.7;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    /* Source — Manrope SemiBold uppercase letter-spaced. Matches the
     * eyebrow / chip register used elsewhere on the page. */
    .reading__row-source {
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 10px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--ink);
      opacity: 0.75;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    /* Headline — Manrope 500. Single-line truncate. */
    .reading__row-title {
      font-family: var(--font-sans);
      font-weight: 500;
      font-size: 14px;
      line-height: 1.35;
      color: var(--ink);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      min-width: 0;
    }
    .reading__row-link:hover .reading__row-title { color: var(--accent); }

    /* Narrow viewports — collapse to two rows per item: meta on top
     * (date + source), headline below. Headline can wrap to two lines. */
    @media (max-width: 760px) {
      .reading__row-link {
        grid-template-columns: auto auto;
        grid-template-rows: auto auto;
        row-gap: 3px;
        column-gap: 10px;
        padding: 10px 0;
      }
      .reading__row-date  { grid-column: 1; grid-row: 1; }
      .reading__row-source { grid-column: 2; grid-row: 1; }
      .reading__row-title {
        grid-column: 1 / -1; grid-row: 2;
        white-space: normal;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
      }
    }

    .reading__attribution {
      max-width: 920px;
      margin: 14px 0 0;
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 10px;
      line-height: 1.4;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--ink);
      opacity: 0.55;
    }
  </style>
</BaseLayout>
