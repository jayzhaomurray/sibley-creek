---
/*
 * /topics/ — landing page that indexes the seven topic chartbooks.
 *
 * Distinct from /overview/ (the live dashboard with current numbers) —
 * this page is the navigational landing: a card per section, each linking
 * into that section's chartbook page. Surfaced from the splash showcase 02
 * and from the masthead dropdown's "All topics" entry.
 *
 * Visual register: boutique (matches /about/, /work-with-us/, etc.) at a
 * slightly wider container to comfortably hold the card grid.
 */

import BaseLayout from "../layouts/BaseLayout.astro";
import { sections, site } from "../data/sections";
import { withBase } from "../lib/urls";

const pageDesc =
  "Eight sections of the Canadian economy — output, inflation, labour, " +
  "monetary policy, fiscal policy, housing, trade, markets. Each section " +
  "is its own chartbook: current prints, short history, written synthesis.";
---
<BaseLayout
  title={`Chartbooks — ${site.name}`}
  description={pageDesc}
  pageClass="topics-page"
>
  <article class="topics" aria-labelledby="topics-h">
    <header class="topics__header">
      <h1 id="topics-h" class="topics__h">Chartbooks</h1>
    </header>

    <p class="topics__lede">
      Eight sections of the Canadian economy, each its own chartbook —
      current prints, short history, written synthesis. For the live
      read on what just landed, see <a href={withBase("/overview/")}>the
      overview</a>.
    </p>

    <ul class="topics__list" role="list">
      {sections.map((s) => (
        <li class="topics__row">
          <a class="topics__rowlink" href={withBase(`/${s.slug}/`)}>
            <p class="topics__row-eyebrow">{s.label}</p>
            <div class="topics__row-body">
              <h2 class="topics__row-question">{s.headlineQuestion}</h2>
              {s.kicker && <p class="topics__row-kicker">{s.kicker}</p>}
            </div>
          </a>
        </li>
      ))}
    </ul>
  </article>

  <style>
    .topics {
      width: 100%;
      max-width: 880px;
      margin: 0 auto;
      padding: 32px 24px 64px;
    }
    .topics__header {
      border-bottom: 1px solid var(--ink);
      padding-bottom: 24px;
      margin-bottom: 32px;
    }
    .topics__h {
      margin: 0;
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 42px;
      line-height: 1.1;
      color: var(--ink);
    }
    .topics__lede {
      margin: 0 0 40px;
      font-family: var(--font-sans);
      font-weight: 400;
      font-size: 18px;
      line-height: 1.55;
      color: var(--ink);
      max-width: 56ch;
    }

    /* ── Stacked catalogue list ── */
    /* Each section is one horizontal row: section label sits in a
     * fixed-width left column (eyebrow), the headline question + kicker
     * sit in the right column. Hairline rule between rows. */
    .topics__list {
      margin: 0;
      padding: 0;
      list-style: none;
      border-top: 1px solid var(--ink);
    }
    .topics__row {
      border-bottom: 1px solid var(--ink);
    }
    .topics__rowlink {
      display: grid;
      grid-template-columns: minmax(120px, 160px) 1fr;
      gap: 28px;
      align-items: baseline;
      padding: 24px 4px;
      color: var(--ink);
      text-decoration: none;
      transition: background 80ms linear;
    }
    .topics__rowlink:hover {
      background: #FAFAFA;
    }
    .topics__rowlink:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: -2px;
    }
    @media (max-width: 540px) {
      /* On narrow viewports, eyebrow stacks above the body. */
      .topics__rowlink {
        grid-template-columns: 1fr;
        gap: 8px;
      }
    }

    .topics__row-eyebrow {
      margin: 0;
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 11px;
      line-height: 1.1;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--accent, #D7263D);
    }
    .topics__row-body {
      min-width: 0;
    }
    .topics__row-question {
      margin: 0;
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 22px;
      line-height: 1.2;
      letter-spacing: -0.01em;
      color: var(--ink);
      max-width: 36ch;
    }
    .topics__row-kicker {
      margin: 8px 0 0;
      font-family: var(--font-sans);
      font-weight: 400;
      font-size: 15px;
      line-height: 1.5;
      color: var(--ink);
      opacity: 0.75;
      max-width: 56ch;
    }
  </style>
</BaseLayout>
