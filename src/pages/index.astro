---
/*
 * Homepage / splash — promoted from v3.astro 2026-05-20.
 *
 * Structure:
 *   1. Hero band (left-aligned slogan + sub + two CTAs)
 *   2. How we work (inverted ink-on-paper band, true viewport-bleed)
 *   3. Showcase 01 — Live tracker (link out to /overview/)
 *   4. Showcase 02 — Chart research
 *   5. Showcase 03 — Data commentary (PDF perspective stack)
 *   6. Subscribe band
 *   7. Advisory teaser
 *
 * The dashboard (the previous splash content) now lives at /overview/.
 * Screencaps in public/showcase/ render real screenshots; if files are
 * missing the alt text shows and layout still works.
 */

import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/urls";
import {
  latestCommentary,
  commentaryCoverPath,
  commentaryPage2Path,
  sections,
} from "../data/sections";

// Splash showcase 03 auto-selects the most recent commentary from the
// registry. The cover + page-2 images are derived from the slug, so the
// promo rotates as new commentaries land — no per-publication code change.
const latest = latestCommentary();
---
<BaseLayout
  title="Sibley Creek"
  description="Independent Canadian macroeconomic research and advisory firm focused on Canada."
  pageClass="splash-page"
>

  {/* ─────────────── BAND 1: TWO-COLUMN HERO (text + map animation) ─────────────── */}
  <section class="v3-hero" aria-labelledby="v3-hero-h">
    <div class="v3-hero__content">
      <h1 id="v3-hero-h" class="v3-hero__h">Canadian macro.<br/>Until it's obvious.</h1>
      <p class="v3-hero__deck">
        Seeing clearly comes from knowing what to ignore.
      </p>
      <p class="v3-hero__credit">
        Sibley Creek is an independent macroeconomic research and advisory
        firm, focused on Canada.
      </p>
      <div class="v3-hero__cta-row">
        <a class="v3-hero__cta v3-hero__cta--primary" href="#subscribe">
          Subscribe →
        </a>
        <a class="v3-hero__cta v3-hero__cta--secondary" href={withBase("/advisory/")}>
          Hire us
        </a>
      </div>
    </div>

    {/* Hero map animation: Canada outline draws in, cities fade in by rank,
        Sibley Creek lands as the red moment. One-shot, freezes at ~8.5s.
        SVG layers populated by /scripts/hero-canada-anim.js using geo data
        from /scripts/hero-canada-geo.js. */}
    <div class="v3-hero__art" aria-hidden="true">
      <svg id="hc-svg" viewBox="0 0 720 500" preserveAspectRatio="xMidYMid meet">
        <g id="hc-outline"></g>
        <g id="hc-highways"></g>
        <g id="hc-cities"></g>
        <g id="hc-labels"></g>
        <g id="hc-sibley"></g>
      </svg>
    </div>
  </section>
  <script is:inline src={withBase("/scripts/hero-canada-geo.js")}></script>
  <script is:inline src={withBase("/scripts/hero-canada-anim.js")}></script>

  {/* ─────────── HOW WE WORK (inverted band) ─────────── */}
  <section class="v3-method" aria-labelledby="v3-method-h">
    <h2 id="v3-method-h" class="v3-method__eyebrow">How we work</h2>
    <p class="v3-method__lead">
      Think of it as economic analysis meets investigative journalism.
      First we dig through the data. Then we get on the phone and talk to
      the people on the ground.
    </p>
    <p class="v3-method__founder">
      Founded by <strong>Jay Zhao-Murray</strong>, former Canada economics
      data editor at&nbsp;Bloomberg.
    </p>
  </section>

  {/* ─────────── SHOWCASE 01: Live tracker ─────────── */}
  <section class="v3-row v3-row--lr" aria-labelledby="v3-row1-h">
    <div class="v3-row__copy">
      <p class="v3-row__kicker">Live tracker</p>
      <h2 id="v3-row1-h" class="v3-row__h">Our reading of the Canadian economy, every day.</h2>
      <p class="v3-row__body">
        Eight sections — inflation, output, labour, housing, policy, markets,
        trade — each charted and annotated. The numbers and our take,
        refreshed as the data lands.
      </p>
      <a class="v3-row__cta" href={withBase("/overview/")}>See the dashboard →</a>
    </div>
    <div class="v3-row__visual">
      <div class="v3-frame">
        <div class="v3-frame__chrome" aria-hidden="true">
          <span class="v3-frame__dot"></span>
          <span class="v3-frame__dot"></span>
          <span class="v3-frame__dot"></span>
          <span class="v3-frame__url">sibleycreek.ca/overview</span>
        </div>
        <img
          class="v3-frame__img"
          src={withBase("/showcase/dashboard.png")}
          alt="Sibley Creek dashboard — screencap"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </section>

  {/* ─────────── SHOWCASE 02: Chartbooks (animated carousel) ─────────── */}
  <section class="v3-row v3-row--rl" aria-labelledby="v3-row2-h">
    <div class="v3-row__visual">
      <div class="v3-frame">
        <div class="v3-frame__chrome" aria-hidden="true">
          <span class="v3-frame__dot"></span>
          <span class="v3-frame__dot"></span>
          <span class="v3-frame__dot"></span>
          <span class="v3-frame__url" data-carousel-url>{`sibleycreek.ca/${sections[0]?.slug ?? "topics"}`}</span>
        </div>
        <div class="v3-carousel" data-carousel>
          {sections.map((s, i) => (
            <img
              class="v3-carousel__slide"
              src={withBase(`/showcase/chartbook-${s.slug}.png`)}
              alt={`${s.label} chartbook — Sibley Creek`}
              data-slide={i}
              data-slug={s.slug}
              data-active={i === 0 ? "true" : "false"}
              loading={i === 0 ? "eager" : "lazy"}
              decoding="async"
            />
          ))}
        </div>
      </div>
    </div>
    <div class="v3-row__copy">
      <p class="v3-row__kicker">Chartbooks</p>
      <h2 id="v3-row2-h" class="v3-row__h">A chartbook for every section.</h2>
      <p class="v3-row__body">
        Seven sections of the Canadian economy — inflation, output, labour,
        housing, policy, markets, trade — each its own chartbook of five to
        six plates, threaded with a written argument.
      </p>
      <p class="v3-row__body">
        Built from the primary sources, in the house typography. The charts
        are the analysis.
      </p>
      <a class="v3-row__cta" href={withBase("/topics/")}>Browse the chartbooks →</a>
    </div>
  </section>

  {/* ─────────── SHOWCASE 03: Data commentary (PDF stack) ─────────── */}
  <section class="v3-row v3-row--lr" aria-labelledby="v3-row3-h">
    <div class="v3-row__copy">
      <p class="v3-row__kicker">Data commentary</p>
      <h2 id="v3-row3-h" class="v3-row__h">Same-day analysis of every major Canadian print.</h2>
      <p class="v3-row__body">
        Every major Canadian print — CPI, jobs, BoC decisions, trade,
        monthly GDP — gets a one-page note within hours: the take, the
        chart, and a forward look at next month's watch-item.
      </p>
      <p class="v3-row__body">
        Distributed as PDFs to subscribers. Visible here as they ship.
      </p>
      {latest && (
        <a class="v3-row__cta" href={withBase(latest.pdfPath)}>Read the latest note →</a>
      )}
    </div>
    <div class="v3-row__visual">
      {latest && (
        <div class="v3-pdf-stack" aria-hidden="true">
          <img
            class="v3-pdf-stack__back"
            src={withBase(commentaryPage2Path(latest))}
            alt=""
            loading="lazy"
            decoding="async"
          />
          <img
            class="v3-pdf-stack__cover"
            src={withBase(commentaryCoverPath(latest))}
            alt={`Sibley Creek — ${latest.title}`}
            loading="lazy"
            decoding="async"
          />
        </div>
      )}
    </div>
  </section>

  {/* ─────────── ADVISORY (dark pillar band — moved above subscribe) ─────────── */}
  {/* Dark-band treatment matches "How we work" — gives the advisory pitch
      visual weight separate from the showcase rows, and frames the
      publication-arc trio between two intentional pillars. */}
  <section class="v3-adv" aria-labelledby="v3-adv-h">
    <div class="v3-adv__inner">
      <p class="v3-adv__eyebrow">Advisory</p>
      <h2 id="v3-adv-h" class="v3-adv__h">Work with Sibley Creek directly.</h2>
      <p class="v3-adv__lead">
        We extend in-house economics teams that are swamped, and provide
        specialized Canadian-macro depth that generalist desks can't always
        cover. On retainer, on project, or for one-off briefings.
      </p>
      <p class="v3-adv__clients">
        Typical clients: hedge funds and asset managers, family offices,
        trade associations, wealth managers, government relations firms,
        corporates with material commodity, tariff, or currency exposure,
        and Crown corporations.
      </p>
      <a class="v3-adv__cta" href={withBase("/advisory/")}>Hire us →</a>
    </div>
  </section>

  {/* ─────────── SUBSCRIBE ─────────── */}
  <section id="subscribe" class="v3-sub" aria-labelledby="v3-sub-h">
    <div class="v3-sub__inner">
      <p class="v3-sub__eyebrow">Subscribe</p>
      <h2 id="v3-sub-h" class="v3-sub__h">Get our research in your inbox.</h2>
      <p class="v3-sub__body">
        Same-day commentary on every major Canadian print. Chart packs as
        they ship. A paid tier with forward-looking research is in
        development.
      </p>

      {/*
        Email capture (interim): POSTs to formsubmit.co, which forwards
        each submission to jayzhaomurray@outlook.com. Uses the secure
        endpoint hash (not the naked email) so the email isn't scrapable
        by bots and new pages don't require per-form re-verification.
        Swap to jay@sibleycreek.ca via formsubmit dashboard once the
        mailbox exists (task #22). Replace formsubmit.co with Kit /
        Beehiiv / Mailchimp action when proper newsletter infra is set up.
      */}
      <form
        class="v3-sub__form"
        action="https://formsubmit.co/ajax/a3077ccc8400c684e07ef6c39d7d34c6"
        method="POST"
        data-formsubmit-ajax
        data-success-msg="Subscribed. Thanks — first issue lands when it lands."
      >
        <label for="v3-sub-email" class="v3-sub__lbl">Email address</label>
        <input
          id="v3-sub-email"
          name="email"
          class="v3-sub__input"
          type="email"
          placeholder="you@firm.ca"
          autocomplete="email"
          required
        />
        <input type="hidden" name="_subject" value="New Sibley Creek subscriber" />
        <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />
        <button class="v3-sub__btn" type="submit">Subscribe →</button>
      </form>

      <ul class="v3-sub__bullets">
        <li><span class="v3-sub__bullet-mk">·</span> No spam. Cancel any time.</li>
        <li><span class="v3-sub__bullet-mk">·</span> Free during founding-subscriber phase.</li>
        <li><span class="v3-sub__bullet-mk">·</span> First access to the paid tier when it launches.</li>
      </ul>
    </div>
  </section>

<script>
  /* Splash chartbook carousel — cycles slides every 3.5s. Auto-discovers
   * the slide count at runtime so adding sections in sections.ts (e.g.
   * the future 8th panel) requires no code change here.
   *
   * NOTE: Deliberately does NOT respect prefers-reduced-motion. The
   * crossfade is gentle (600ms opacity) and the carousel is a key
   * marketing surface; competitor sites animate regardless of the OS
   * setting and we match that convention here. */
  (function () {
    const carousels = document.querySelectorAll<HTMLElement>("[data-carousel]");
    carousels.forEach((c) => {
      const slides = Array.from(
        c.querySelectorAll<HTMLImageElement>(".v3-carousel__slide"),
      );
      if (slides.length <= 1) return;
      const frame = c.closest(".v3-frame");
      const urlEl = frame?.querySelector<HTMLElement>("[data-carousel-url]");
      let i = 0;
      const advance = () => {
        slides[i].setAttribute("data-active", "false");
        i = (i + 1) % slides.length;
        slides[i].setAttribute("data-active", "true");
        if (urlEl) {
          const slug = slides[i].getAttribute("data-slug");
          if (slug) urlEl.textContent = `sibleycreek.ca/${slug}`;
        }
      };
      setInterval(advance, 3500);
    });
  })();
</script>
</BaseLayout>

<style>
  /* ════════════════════════════════════════════════════════════════════
   * Splash page (promoted from v3.astro, 2026-05-20)
   * ════════════════════════════════════════════════════════════════════ */

  /* ─── BAND 1: HERO with text overlaid on Canada-map animation ─── */
  /*
   * Layout pattern is Word "wrap behind text": the animation sits
   * absolutely positioned, sized large, extending past the shell on the
   * right. The text content sits above it (z-index 2) on the left, free
   * of the grid constraint that previously forced the animation small.
   * Sibley Creek's red dot lands east of the text block (it's at the real
   * geographic coordinates of Sibley Creek, central-eastern in the map).
   */
  .v3-hero {
    padding-block: 128px 96px;
    text-align: left;
    position: relative;
    /* No overflow:hidden — the art deliberately bleeds past .v3-hero's
     * right edge into the viewport margin via the right-side break-out.
     * Clipping killed the map on wide viewports (2560+) for colleagues.
     * min-height bumped to fit the art at its max 900px width (625px
     * tall at 720:500 aspect) so it doesn't bleed into the masthead. */
    min-height: 640px;
  }
  @media (max-width: 720px) { .v3-hero { padding-block: 56px 64px; } }

  .v3-hero__content {
    position: relative;
    z-index: 2;
    max-width: 620px;
    min-width: 0;
  }

  .v3-hero__art {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    /* Anchor to the right; on wide viewports extend past the shell into
     * the right viewport margin (echoes the "How we work" full-bleed). */
    right: min(0px, calc(50% - 50vw + var(--gutter-desktop)));
    /* Scales with viewport: 580px on tighter desktops, capped at 900px
     * on wide screens. Lands the map's left edge near the right side of
     * the text block without overlap. */
    width: clamp(580px, 50vw, 900px);
    aspect-ratio: 720 / 500;
    z-index: 1;
    pointer-events: none;
  }
  .v3-hero__art svg { display: block; width: 100%; height: 100%; }

  /* At narrow viewports, abandon the overlap layout — stack vertically. */
  @media (max-width: 1100px) {
    .v3-hero {
      min-height: 0;
      overflow: visible;
    }
    .v3-hero__content { max-width: 100%; }
    .v3-hero__art {
      position: static;
      transform: none;
      width: 100%;
      max-width: 560px;
      margin-top: 40px;
      right: auto;
    }
  }

  .v3-hero__h {
    margin: 0;
    max-width: 18ch;
    font-family: var(--font-sans);
    /* Weight 600 (SemiBold), down from 800. Aligns with the boutique
     * register H1 weight on the prose pages; less aggressive than the
     * previous ExtraBold for the marketing surface. Comparator H1s
     * (Variant, Capital, BCA) read confident at this weight without
     * the heavy ink. */
    font-weight: 600;
    font-size: clamp(36px, 5vw, 60px);
    line-height: 1.05;
    letter-spacing: -0.018em;
    color: var(--ink);
  }
  /* Aphorism deck — the philosophical claim sitting under the H1. Larger
   * than body, light weight, reads as the "thesis" of the firm. */
  .v3-hero__deck {
    margin: 28px 0 0;
    max-width: 50ch;
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: 22px;
    line-height: 1.4;
    color: var(--ink);
  }
  /* Institutional credit — names the firm. Smaller, lighter opacity so
   * it reads as attribution / credit line rather than equal-weight body. */
  .v3-hero__credit {
    margin: 16px 0 0;
    max-width: 56ch;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink);
    opacity: 0.7;
  }
  .v3-hero__cta-row {
    margin: 36px 0 0;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .v3-hero__cta {
    display: inline-block;
    padding: 14px 26px;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 12px;
    line-height: 1;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid var(--ink);
    transition: background 80ms linear, color 80ms linear;
  }
  .v3-hero__cta--primary { background: var(--ink); color: var(--paper, #fff); }
  .v3-hero__cta--primary:hover { background: var(--paper, #fff); color: var(--ink); }
  .v3-hero__cta--secondary { background: var(--paper, #fff); color: var(--ink); }
  .v3-hero__cta--secondary:hover { background: var(--ink); color: var(--paper, #fff); }
  .v3-hero__cta:focus-visible {
    outline: 2px solid var(--accent, #D7263D);
    outline-offset: 3px;
  }

  /* ─── SHOWCASE ROWS ─── */
  .v3-row {
    padding-block: 72px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
    border-bottom: 1px solid var(--ink);
  }
  @media (min-width: 880px) {
    .v3-row {
      grid-template-columns: 1fr 1fr;
      gap: 64px;
      padding-block: 88px;
    }
    .v3-row--rl .v3-row__copy   { grid-column: 2; grid-row: 1; }
    .v3-row--rl .v3-row__visual { grid-column: 1; grid-row: 1; }
  }

  .v3-row__copy { max-width: 52ch; }
  .v3-row__kicker {
    margin: 0 0 18px;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 11px;
    line-height: 1;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent, #D7263D);
  }
  .v3-row__h {
    margin: 0 0 18px;
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: clamp(26px, 3.4vw, 38px);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--ink);
    max-width: 18ch;
  }
  .v3-row__body {
    margin: 0 0 14px;
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink);
  }
  .v3-row__cta {
    display: inline-block;
    margin-top: 10px;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 12px;
    line-height: 1;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent, #D7263D);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 80ms linear;
  }
  .v3-row__cta:hover { border-bottom-color: var(--accent, #D7263D); }

  .v3-row__visual {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ─── Faux-browser frame containing the real screencap ─── */
  .v3-frame {
    width: 100%;
    max-width: 560px;
    border: 1px solid var(--ink);
    background: var(--paper, #fff);
    box-shadow: 0 24px 48px -16px rgba(0,0,0,0.18);
    overflow: hidden;
  }
  .v3-frame__chrome {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    border-bottom: 1px solid var(--ink);
    background: #F5F5F5;
  }
  .v3-frame__dot {
    width: 9px; height: 9px;
    border-radius: 50%;
    background: var(--ink);
    opacity: 0.25;
  }
  .v3-frame__url {
    margin-left: 14px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink);
    opacity: 0.65;
  }
  .v3-frame__img {
    /* Use aspect-ratio (matches the chartbook carousel inside .v3-frame
     * one section down) so the frame stays consistent across viewports.
     * Without this, height: auto stretched the dashboard screencap —
     * 1440x2856 native, ratio 0.50 — into a very tall block on mobile,
     * even with max-height 520. object-fit + object-position keep the
     * top of the screencap visible (chart panels above the fold). */
    width: 100%;
    aspect-ratio: 14 / 10;
    display: block;
    max-height: 520px;
    object-fit: cover;
    object-position: top center;
  }

  /* ─── Showcase 02 carousel — cycles through topic chartbook screencaps.
   * Slides stack absolutely inside the frame; the JS toggles
   * data-active="true" on the next slide every interval. Number of slides
   * is auto-derived from the `sections` array, so adding/removing
   * sections in sections.ts just works — no code change here needed. */
  .v3-carousel {
    position: relative;
    width: 100%;
    aspect-ratio: 14 / 10;
    max-height: 520px;
    overflow: hidden;
    background: var(--paper, #fff);
  }
  .v3-carousel__slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    opacity: 0;
    transition: opacity 600ms linear;
  }
  .v3-carousel__slide[data-active="true"] {
    opacity: 1;
  }

  /* ─── PDF perspective stack ─── */
  .v3-pdf-stack {
    position: relative;
    width: 100%;
    max-width: 440px;
    aspect-ratio: 6 / 7;
    perspective: 1400px;
  }
  .v3-pdf-stack__back,
  .v3-pdf-stack__cover {
    position: absolute;
    width: 78%;
    height: auto;
    aspect-ratio: 7 / 9;
    object-fit: cover;
    object-position: top center;
    border: 1px solid var(--ink);
    background: var(--paper, #fff);
    transform-style: preserve-3d;
  }
  .v3-pdf-stack__back {
    top: 14px;
    left: 22%;
    transform: rotateY(-6deg) rotateZ(2.5deg);
    box-shadow: 0 30px 60px -18px rgba(0,0,0,0.18);
    z-index: 1;
  }
  .v3-pdf-stack__cover {
    top: 38px;
    left: 0;
    transform: rotateY(-4deg) rotateZ(-2deg);
    box-shadow: 0 36px 64px -20px rgba(0,0,0,0.28);
    z-index: 2;
  }

  /* ─── BAND: HOW WE WORK (inverted ink-on-paper, true full-bleed) ─── */
  .v3-method {
    padding-block: 84px 92px;
    background: var(--ink);
    color: var(--paper, #fff);
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    padding-left: calc(50vw - 50%);
    padding-right: calc(50vw - 50%);
  }

  .v3-method__eyebrow {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 11px;
    line-height: 1;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--paper, #fff);
    opacity: 0.9;
  }
  .v3-method__lead {
    margin: 32px 0 0;
    /* Wider max-width + smaller display size: the prior clamp peaked at
     * 42px which makes a 3-sentence block hard to track. Smaller display
     * size + slightly wider line gives the eye natural rest points. */
    max-width: 40ch;
