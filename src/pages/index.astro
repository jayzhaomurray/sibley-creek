---
/*
 * Homepage - Canadian Macro Overview (Vignelli register, production canon).
 *
 * 2026-05-11: This page replaces the previous Layout-B (Hero + 6) homepage.
 * The Vignelli aesthetic - promoted out of /experiments/splash-academic-
 * vignelli/ - is now the production homepage.
 *
 * Layout:
 *   1. Title Statement: eyebrow + headline ("Canadian Macro Overview" + date
 *      in signal red) + abstract + 3-cell headline-numbers stamp.
 *   2. Indicator panel grid: 2 x 4 hairline-bordered cells. Seven section
 *      panels + an eighth "Working papers" cell.
 *
 * Masthead and colophon are owned by BaseLayout (Vignelli chrome); this
 * page renders only the body.
 *
 * Hero selection / rate-rail composition is NOT part of this layout. The
 * Vignelli register treats all seven sections as equal panels in the
 * editorial grid; the title statement carries the date / publication
 * voice. If we want a "hero of the day" in v1.1 we'll do it in the title
 * statement, not by re-introducing the hero-and-six split.
 *
 * What this page is NOT:
 *   - A chart canvas. Each panel renders its own small load-bearing chart
 *     inline (SVG, black line + red latest-point dot). chart-builder may
 *     hydrate these later via dispatch keys; the static SVG is the v1
 *     baseline.
 *   - An experiment route. The Vignelli experiment under /experiments/
 *     splash-academic-vignelli/ remains live for visual comparison; this
 *     page is the canonical homepage.
 */

import BaseLayout from "../layouts/BaseLayout.astro";
import TitleStatement from "../components/home/TitleStatement.astro";
import SectionPanel from "../components/home/SectionPanel.astro";
import DeepDivePanel from "../components/home/DeepDivePanel.astro";
import {
  sections,
  deepDives,
  site,
  type Section,
} from "../data/sections";

// Canonical section ordering. Seven sections + one working-papers cell.
const ordered: Section[] = (
  ["gdp", "inflation", "labour", "housing", "policy", "markets", "trade"] as const
)
  .map((slug) => sections.find((s) => s.slug === slug))
  .filter((s): s is Section => Boolean(s));

// Title-statement date line. Always reflects today.
const today = new Date();
const longDate = today.toLocaleDateString("en-CA", {
  month: "long",
  day: "numeric",
  year: "numeric",
});

const abstract =
  "A reading-first summary of the Canadian macro picture as of " +
  longDate +
  ". Seven indicator domains, each rendered as a compact panel with one " +
  "load-bearing chart, the latest headline reading, and a small table of " +
  "supporting prints. Working papers index follows the section grid.";

const pageDesc =
  `Canadian macro overview for ${longDate}. Seven indicator domains - GDP, ` +
  "inflation, labour, housing, monetary policy, markets, trade - each with " +
  "a load-bearing chart and the latest prints. Independent research.";
---
<BaseLayout
  title={site.name}
  description={pageDesc}
  pageClass="home-page"
  showMastheadRail={true}
>
  <article class="home">
    <TitleStatement
      dateLine={longDate}
      abstract={abstract}
      sections={sections}
    />

    <section class="home__grid" aria-label="Indicator panels">
      <h2 class="visually-hidden">Indicator panels</h2>
      {ordered.map((s, i) => (
        <div class="home__cell">
          <SectionPanel section={s} figureNum={String(i + 1)} />
        </div>
      ))}
      {/* 8th cell: working papers */}
      <div class="home__cell">
        <DeepDivePanel deepDives={deepDives} figureNum="8" />
      </div>
    </section>
  </article>

  <style>
    .home__grid {
      margin-top: 28px;
      display: grid;
      grid-template-columns: 1fr;
      gap: 0;
      /* Vignelli / Knoll catalogue: panels meet at shared 1px black
       * hairlines. We collapse the gap and use the panel borders to form a
       * continuous grid. */
      border-top: 1px solid var(--ink);
      border-left: 1px solid var(--ink);
    }
    @media (min-width: 760px) {
      .home__grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
    .home__cell {
      min-width: 0;
      display: flex;
      border-right: 1px solid var(--ink);
      border-bottom: 1px solid var(--ink);
    }
    .home__cell > :global(*) {
      width: 100%;
    }

    /* a11y utility - visually hidden but available to screen readers */
    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  </style>
</BaseLayout>
