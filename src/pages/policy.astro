---
import SectionLayout from "../layouts/SectionLayout.astro";
import type { Plate } from "../layouts/SectionLayout.astro";
import { sections } from "../data/sections";
import panelDataFile from "../../data/site/panel_data/policy.json";
import sectionsJson from "../../data/site/sections.json";
import { pickPanel } from "../components/charts/_shared/panelData";
import { deriveLatestReleaseLabel } from "../components/section/_shared/derivedLabels";

const section = sections.find((s) => s.slug === "policy");
if (!section) {
  throw new Error("Policy section not found in src/data/sections.ts");
}

// Policy uses an override for the page-level "Latest release" stamp because
// the primary event is the rate decision (not one of the pipeline's
// monthly prints). When the override is set, compose the stamp directly;
// otherwise fall through to the standard derivation.
const latestReleaseLabel = section.latestReleaseDateOverride
  ? `${section.latestReleasePrefix ?? ""}, ${section.latestReleaseDateOverride}`
  : deriveLatestReleaseLabel(
      section.latestReleasePrefix ?? "",
      sectionsJson,
      "policy",
    );

const panel1Data = pickPanel(panelDataFile, 1);
const panel2Data = pickPanel(panelDataFile, 2);
const panel3Data = pickPanel(panelDataFile, 3);
const panel4Data = pickPanel(panelDataFile, 4);
const panel5Data = pickPanel(panelDataFile, 5);
const panel6Data = pickPanel(panelDataFile, 6);

const plates: Plate[] = [
  {
    id: "plate-1",
    number: "01",
    indicator: "Overnight rate",
    plateIndexLabel: "Overnight rate",
    asOf: "April 29, 2026 (rate decision)",
    title: "The Bank has settled the overnight rate inside its neutral range.",
    interpretationHtml:
      "The Bank held the overnight rate target at 2.25% on April 29, the fourth consecutive hold since the 25 bps cut to 2.25% on October 29, 2025. " +
      "The setting sits inside the BoC's stated 2.25 to 3.25% nominal neutral range; further easing would push policy into accommodative territory. " +
      "The April Monetary Policy Report describes the current stance as appropriately positioned while the inflation moderation works through.",
    callout: {
      value: "2.25%",
      unit: "BoC overnight rate target",
      delta: "Unchanged at Apr 29 decision",
      direction: "neutral",
    },
    source: "Bank of Canada rate decision and Monetary Policy Report, latest vintage.",
    chartKey: "policy-panel-1",
    data: panel1Data,
  },
  {
    id: "plate-2",
    number: "02",
    indicator: "2y GoC vs overnight",
    plateIndexLabel: "Market path",
    title: "The market has stopped pricing further near-term easing.",
    interpretationHtml:
      "The 2-year Government of Canada yield closed at 2.94% on May 7, roughly 69 bps above the 2.25% overnight target. " +
      "The curve is no longer pricing further near-term easing; the gap reflects term premium and a market that has converged toward the Bank's hold. " +
      "The April MPR's market-implied curve remains the primary-source reference for the full OIS-implied path.",
    source: "BoC Valet (rates); MPR market-implied curve, latest vintage.",
    chartKey: "policy-panel-2",
    data: panel2Data,
  },
  {
    id: "plate-3",
    number: "03",
    indicator: "Canada 2y minus US 2y",
    plateIndexLabel: "BoC-Fed spread",
    title: "The cross-border spread is deep but no longer the binding constraint on the BoC.",
    interpretationHtml:
      "GoC 2y at 2.94% against UST 2y at 3.92% leaves the Canada-US 2y spread at minus 98 bps. " +
      "On daily data since 2001, that reading sits at the 5th percentile of the distribution -- deep, but roughly 70 bps off the all-time minus 170 bps trough reached on February 3, 2025. " +
      "USDCAD has held below 1.36 through the spring, which is why the FX channel is not currently the binding constraint on the Bank's hold.",
    callout: {
      value: "-98 bps",
      unit: "Canada 2y minus US 2y",
      delta: "5th percentile, post-2001",
      direction: "neutral",
    },
    source: "BoC Valet (Canada 2y); FRED DGS2 (US 2y); distribution constructed.",
    chartKey: "policy-panel-3",
    data: panel3Data,
  },
  {
    id: "plate-4",
    number: "04",
    indicator: "BoC asset composition",
    plateIndexLabel: "Asset composition",
    asOf: "May 6, 2026 (weekly statement)",
    title: "Government bonds anchor the post-QT balance sheet.",
    interpretationHtml:
      "The Bank of Canada's asset side has settled into a shape defined by what's left of the Government Bond Purchase Programme. " +
      "Government of Canada bonds account for $154.6bn of $219.0bn in total assets — about 71 per cent — and total assets have held near that level for roughly eighteen months, consistent with the Bank's December 2024 call that quantitative tightening was complete. " +
      "Repos are the operating margin, running in a $20–50bn range as the Bank manages the floor system week to week, while Treasury bills and advances sit close to zero after the pandemic-era liquidity backstops ran off.",
    callout: {
      value: "71%",
      unit: "GoC bonds, share of BoC assets",
      delta: "$154.6 bn of $219.0 bn total",
      direction: "neutral",
    },
    source:
      "Bank of Canada weekly statement (assets and liabilities; formerly Schedule B2).",
    chartKey: "policy-panel-4",
    data: panel4Data,
  },
  {
    id: "plate-5",
    number: "05",
    indicator: "BoC liability composition",
    plateIndexLabel: "Liability composition",
    asOf: "May 6, 2026 (weekly statement)",
    title: "The liability side has settled into a new floor-system equilibrium.",
    interpretationHtml:
      "Banknotes carry $122.5bn of $219.0bn in total liabilities — about 56 per cent — and have drifted up only $30bn over six years, a passive function of currency demand rather than policy. " +
      "Settlement balances are the active line: from a $0.25bn pre-pandemic floor to a $330bn peak in 2021-22, drained through QT, and now $63.9bn — inside the $50–70bn operating range the Bank named in its December 2024 framework statement. " +
      "Government of Canada deposits have normalized to $26bn from a COVID spike above $80bn, reverse repos sit at zero, and residual other liabilities round out the remaining $7bn.",
    callout: {
      value: "$63.9 bn",
      unit: "Settlement balances",
      delta: "Inside Dec-2024 $50–70 bn range",
      direction: "neutral",
    },
    source:
      "Bank of Canada weekly statement (assets and liabilities; formerly Schedule B2).",
    chartKey: "policy-panel-5",
    data: panel5Data,
  },
  {
    id: "plate-6",
    number: "06",
    indicator: "Federal budget balance, monthly and fiscal YTD",
    plateIndexLabel: "Federal trajectory",
    asOf: "February 28, 2026 (Fiscal Monitor)",
    title: "The federal balance is tracking a familiar fiscal-year arc.",
    interpretationHtml:
      "Eleven months into fiscal 2025-26, the federal balance is running a $25.5 billion deficit, after a $5.7 billion February surplus pulled the year-to-date reading off its January trough of $31.2 billion. " +
      "The monthly panel runs deficit in eight of eleven prints and surplus in three, with the largest single-month positive landing in February as personal income tax instalments cleared. " +
      "The cadence is the standard one — heavy outflows through the autumn, tax-receipt months tugging the cumulative line back toward the mean — and the next Fiscal Monitor will close the year with the March print.",
    callout: {
      value: "-$25.5 bn",
      unit: "Federal balance, fiscal YTD",
      delta: "11 months into FY 2025-26",
      direction: "neg",
    },
    source: "Department of Finance Fiscal Monitor.",
    chartKey: "policy-panel-6",
    data: panel6Data,
  },
  {
    id: "plate-7",
    number: "07",
    indicator: "BoC and Fed policy paths over time",
    plateIndexLabel: "Policy divergence",
    asOf: "April 2026 (BoC monthly)",
    title: "The BoC-Fed policy gap has reached a generational depth.",
    interpretationHtml:
      "BoC overnight at 2.25% against the Fed's 3.75% target upper bound leaves the policy-rate spread at -150 bps in monthly data through April 2026 -- a deeper gap than at any point in the prior two decades outside the 2002-2004 episode. " +
      "The bottom panel tracks the BoC-Fed spread directly: a near-zero line through most of the 1996-2019 window, a sharp positive spike during the 2022-23 BoC-leads-hiking phase, and a clean monotone descent into the current negative regime as the Bank cut ahead of the Fed through 2024-25. " +
      "The market-rate read of the same divergence -- the 2y GoC minus 2y UST spread, which reached -170 bps on February 3, 2025 -- is the deep-dive's editorial anchor; see " +
      "<a href=\"/research/boc-fed-divergence/\">the BoC-Fed divergence research note</a> for the full case.",
    source:
      "Bank of Canada Valet (overnight rate target, monthly); FRED DFF (fed funds effective, daily resampled to monthly last). " +
      "BoC-Fed spread derived in chart, percentage points.",
    chartKey: "policy-panel-7",
    data: panel1Data,
  },
];

const pageTitle = "Policy";
const pageDescription =
  "BoC overnight rate, market path, BoC-Fed spread, balance sheet, federal trajectory, fiscal stance.";

// Lede reads the same editorial blurb the auto-blurb pipeline writes for the
// splash tile (sections.ts -> section.blurb.body). Single source of truth: a
// release-day fan-out updates one field and both surfaces refresh.
const lede = section.blurb?.body ?? "";
---
<SectionLayout
  slug="policy"
  sectionIndex={4}
  sectionLabel="Policy"
  headlineQuestion={section.headlineQuestion}
  lede={lede}
  latestReleaseLabel={latestReleaseLabel}
  plates={plates}
  title={pageTitle}
  description={pageDescription}
/>
