const pageTitle = "Policy";
const pageDescription = `${section.headlineQuestion} The macro-research-department Policy section: BoC overnight rate, market path, BoC-Fed spread, balance sheet, federal trajectory, and fiscal stance vs cycle.`;
---
<SectionLayout
  slug="policy"
  sectionIndex={5}
  sectionName="Policy"
  sectionLabel={section.label}
  accentVar={section.accentVar}
  headlineQuestion={section.headlineQuestion}
  pageAsOf={pageAsOf}
  panels={panels}
  title={pageTitle}
  description={pageDescription}
/>
