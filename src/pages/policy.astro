---
/*
 * Policy - basics-layer section page (placeholder).
 *
 * Editorial canon section 4.5 splits Policy into a monetary sub-surface
 * (4 elements) and a fiscal sub-surface (4 elements). For the v1
 * navigation-skeleton placeholder we surface six panels as the
 * load-bearing slate; the monetary / fiscal split is editorial / writer
 * territory once the canonical six-panel narrative is locked.
 *
 * Six panels per editorial canon section 4.5 (selected slate):
 *   1. BoC overnight rate
 *   2. Market path (2y GoC vs overnight; OIS-implied)
 *   3. BoC-Fed spread
 *   4. Balance sheet
 *   5. Federal trajectory
 *   6. Fiscal stance vs cycle
 *
 * Why this file is sparse:
 *   Navigation-skeleton placeholder. Writer + style-editor own panel
 *   titles, decks, callouts, and source citations. Backend pipeline owns
 *   vintage stamps and numeric values. Chart-builder hydrates chart slots.
 *   Frontend reserves panel order, eyebrows, anchors, and the page shell.
 *
 * Open question for editorial-director: do we keep this six-panel slate or
 * surface eight panels (full monetary + fiscal sub-surfaces) when the page
 * is wired through to real content?
 *
 * Mirrors src/pages/gdp.astro structure; see that file for the worked
 * example with finished placeholder copy.
 */

import SectionLayout from "../layouts/SectionLayout.astro";
import type { Panel } from "../layouts/SectionLayout.astro";
import { sections } from "../data/sections";

const section = sections.find((s) => s.slug === "policy");
if (!section) {
  throw new Error("Policy section not found in src/data/sections.ts");
}

const pageAsOf = {
  label: "Placeholder release",
  releaseDate: "TBD",
};

const placeholderText = "Placeholder. Writer to populate.";
const placeholderMethodology = "Placeholder. Methodology to be documented by editorial.";
const placeholderSource = "Source citation TBD.";
const placeholderVintage = { releaseDate: "TBD" };

const panels: Panel[] = [
  {
    id: "panel-1",
    eyebrow: "BoC overnight rate",
    title: placeholderText,
    deck: placeholderText,
    vintage: placeholderVintage,
    editorialStatus: placeholderText,
    source: placeholderSource,
    methodology: { body: placeholderMethodology },
  },
  {
    id: "panel-2",
    eyebrow: "Market path",
    title: placeholderText,
    deck: placeholderText,
    vintage: placeholderVintage,
    editorialStatus: placeholderText,
    source: placeholderSource,
    methodology: { body: placeholderMethodology },
  },
  {
    id: "panel-3",
    eyebrow: "BoC-Fed spread",
    title: placeholderText,
    deck: placeholderText,
    vintage: placeholderVintage,
    editorialStatus: placeholderText,
    source: placeholderSource,
    methodology: { body: placeholderMethodology },
  },
  {
    id: "panel-4",
    eyebrow: "Balance sheet",
    title: placeholderText,
    deck: placeholderText,
    vintage: placeholderVintage,
    editorialStatus: placeholderText,
    source: placeholderSource,
    methodology: { body: placeholderMethodology },
  },
  {
    id: "panel-5",
    eyebrow: "Federal trajectory",
    title: placeholderText,
    deck: placeholderText,
    vintage: placeholderVintage,
    editorialStatus: placeholderText,
    source: placeholderSource,
    methodology: { body: placeholderMethodology },
  },
  {
    id: "panel-6",
    eyebrow: "Fiscal stance vs cycle",
    title: placeholderText,
    deck: placeholderText,
    vintage: placeholderVintage,
    editorialStatus: placeholderText,
    source: placeholderSource,
    methodology: { body: placeholderMethodology },
  },
