---
import SectionLayout from "../layouts/SectionLayout.astro";
import type { Plate } from "../layouts/SectionLayout.astro";
import { sections } from "../data/sections";
import panelDataFile from "../../data/site/panel_data/policy.json";
import sectionsJson from "../../data/site/sections.json";
import { pickPanel } from "../components/charts/_shared/panelData";
import { deriveLatestReleaseLabel } from "../components/section/_shared/derivedLabels";

const section = sections.find((s) => s.slug === "policy");
if (!section) {
  throw new Error("Policy section not found in src/data/sections.ts");
}

// Policy uses an override for the page-level "Latest release" stamp because
// the primary event is the rate decision (not one of the pipeline's
// monthly prints). When the override is set, compose the stamp directly;
// otherwise fall through to the standard derivation.
const latestReleaseLabel = section.latestReleaseDateOverride
  ? `${section.latestReleasePrefix ?? ""}, ${section.latestReleaseDateOverride}`
  : deriveLatestReleaseLabel(
      section.latestReleasePrefix ?? "",
      sectionsJson,
      "policy",
    );

const panel1Data = pickPanel(panelDataFile, 1);
const panel2Data = pickPanel(panelDataFile, 2);
const panel4Data = pickPanel(panelDataFile, 4);
const panel5Data = pickPanel(panelDataFile, 5);
const panel6Data = pickPanel(panelDataFile, 6);

const plates: Plate[] = [
  {
    id: "plate-1",
    number: "01",
    indicator: "Overnight rate",
    plateIndexLabel: "Overnight rate",
    asOf: "April 29, 2026 (rate decision)",
    title: "The Bank has settled the overnight rate inside its neutral range.",
    interpretationHtml:
      "The Bank held the overnight rate target at 2.25% on April 29, the fourth consecutive hold since the 25 bps cut to 2.25% on October 29, 2025. " +
      "The setting sits inside the BoC's stated 2.25 to 3.25% nominal neutral range; further easing would push policy into accommodative territory. " +
      "The April Monetary Policy Report describes the current stance as appropriately positioned while the inflation moderation works through.",
    callout: {
      value: "2.25%",
      unit: "BoC overnight rate target",
      delta: "Unchanged at Apr 29 decision",
      direction: "neutral",
    },
    source: "Bank of Canada rate decision and Monetary Policy Report, latest vintage.",
    chartKey: "policy-panel-1",
    data: panel1Data,
    citations: [
      { phrase: "2.25% on April 29", source: "pipeline:boc:V39079", note: "BoC overnight target rate, April 29 2026 FAD decision, via Valet V39079." },
      { phrase: "fourth consecutive hold", source: "card:boc_fad_holds_post_oct_2025_cut", expected_count: 4, note: "Enumerated FAD holds since Oct 29, 2025 cut. Card carries authoritative list; build fails if length drifts from expected_count." },
      { phrase: "25 bps cut to 2.25% on October 29, 2025", source: "pipeline:boc:V39079", note: "BoC overnight target stepped from 2.50% to 2.25% on Oct 29 2025 per Valet V39079 step history." },
      { phrase: "2.25 to 3.25% nominal neutral range", source: "card:boc_mpr_neutral_range" },
    ],
  },
  {
    id: "plate-2",
    number: "02",
    indicator: "BoC and Fed policy paths over time",
    plateIndexLabel: "Policy divergence",
    asOf: "April 2026 (BoC monthly)",
    title: "The BoC-Fed policy gap is narrowing from a generational depth.",
    interpretationHtml:
      "The BoC-Fed gap stands at -150 bps, narrowest since February 2025 and 25 bps off the -175 generational trough sustained from March through November 2025, when the BoC out-cut a Fed already a full point into its own easing. " +
      "One December Fed cut has done the closing work; the BoC has held since October. " +
      "The asymmetry is now running the other way.",
    source:
      "Bank of Canada Valet (overnight rate target, monthly); FRED DFF (fed funds effective, daily resampled to monthly last). " +
      "BoC-Fed spread derived in chart, percentage points.",
    chartKey: "policy-panel-7",
    data: panel1Data,
    citations: [
      { phrase: "-150 bps", source: "derived", note: "BoC 2.25% - Fed upper bound 3.75% = -1.50 pp = -150 bps. Inputs: data/raw/overnight_rate_target.csv (BoC monthly) and data/raw/fed_funds.csv (Fed daily, latest May 2026 = 3.75%)." },
      { phrase: "narrowest since February 2025", source: "derived", note: "Feb 2025: BoC 3.00% - Fed 4.50% = -150 bps (last reading at or narrower than -150). Mar-Nov 2025 spread was -175 sustained; gap returned to -150 at Dec 2025 with Fed Dec 11 cut to 3.75%." },
      { phrase: "25 bps off the -175 generational trough", source: "derived", note: "Current spread -150 bps minus sustained 2025 trough -175 bps = 25 bps of narrowing. Sustained trough Mar-Nov 2025: BoC 2.75-2.25 minus Fed 4.50-4.00. Deepest sustained negative spread since 1996-97 (which reached -251)." },
      { phrase: "March through November 2025", source: "derived", note: "BoC monthly overnight x Fed monthly upper bound: spread held at -175 bps from end-Mar 2025 (BoC cut to 2.75) through end-Nov 2025 (before Fed Dec 11 cut)." },
      { phrase: "Fed already a full point into its own easing", source: "derived", note: "Fed cut 5.50 to 4.50 across three meetings: Sep 18 2024 (-50 bps), Nov 8 2024 (-25), Dec 19 2024 (-25). Total: 100 bps = a full percentage point, completed before the 2025 BoC cycle's deepest spreads." },
      { phrase: "One December Fed cut has done the closing work", source: "derived", note: "Fed cut from 4.00 to 3.75 on Dec 11 2025 with BoC unchanged at 2.25, narrowing the spread from -175 to -150. Only Fed cut between BoC's Oct 29 cut and the present." },
      { phrase: "BoC has held since October", source: "card:boc_fad_holds_post_oct_2025_cut", expected_count: 4, note: "Enumerated FAD holds since Oct 29, 2025 cut to 2.25%: Dec 10, Jan 28, Mar 18, Apr 29." },
    ],
  },
  {
    id: "plate-3",
    number: "03",
    indicator: "2y GoC vs overnight",
    plateIndexLabel: "Market path",
    title: "The market has stopped pricing further near-term easing.",
    interpretationHtml:
      "The 2-year Government of Canada yield closed at 2.94% on May 7, roughly 69 bps above the 2.25% overnight target. " +
      "The curve is no longer pricing further near-term easing; the gap reflects term premium and a market that has converged toward the Bank's hold. " +
      "The April MPR's market-implied curve remains the primary-source reference for the full OIS-implied path.",
    source: "BoC Valet (rates); MPR market-implied curve, latest vintage.",
    chartKey: "policy-panel-2",
    data: panel2Data,
    citations: [
      { phrase: "2.94% on May 7", source: "pipeline:boc:yield_2yr", note: "GoC 2y benchmark yield, daily close May 7 2026, via BoC Valet." },
      { phrase: "2.25% overnight target", source: "pipeline:boc:V39079", note: "BoC overnight target rate, current setting via Valet V39079." },
      { phrase: "roughly 69 bps", source: "derived", note: "2.94% (GoC 2y) - 2.25% (overnight) = 0.69 pp = 69 bps." },
    ],
  },
  {
    id: "plate-4",
    number: "04",
    indicator: "BoC asset composition",
    plateIndexLabel: "Asset composition",
    asOf: "May 6, 2026 (weekly statement)",
    title: "Government bonds anchor the post-QT balance sheet.",
    interpretationHtml:
      "The Bank of Canada's asset side has settled into a shape defined by what's left of the Government Bond Purchase Programme. " +
      "Government of Canada bonds account for $154.6bn of $219.0bn in total assets — about 71 per cent — and total assets have held near that level for roughly eighteen months, consistent with the Bank's January 2025 call that quantitative tightening was complete. " +
      "Repos are the operating margin, running in a $20–50bn range as the Bank manages the floor system week to week, while Treasury bills and advances sit close to zero after the pandemic-era liquidity backstops ran off.",
    callout: {
      value: "71%",
      unit: "GoC bonds, share of BoC assets",
      delta: "$154.6 bn of $219.0 bn total",
      direction: "neutral",
    },
    source:
      "Bank of Canada weekly statement (assets and liabilities; formerly Schedule B2).",
    chartKey: "policy-panel-4",
    data: panel4Data,
    citations: [
      { phrase: "$154.6bn of $219.0bn in total assets", source: "pipeline:boc:boc_goc_bonds", note: "BoC weekly statement: GoC bonds = $154.6bn; total assets = $219.0bn; latest May 6 2026 vintage." },
      { phrase: "about 71 per cent", source: "derived", note: "154.6 / 219.0 = 70.6%, rounded to 71 per cent." },
      { phrase: "January 2025 call that quantitative tightening was complete", source: "card:boc_qt_end_2025_01" },
      { phrase: "$20–50bn range", source: "pipeline:boc:boc_repos", note: "BoC repos operating range over the past ~18 months, $20bn-$50bn, per weekly statement series." },
    ],
  },
  {
    id: "plate-5",
    number: "05",
    indicator: "BoC liability composition",
    plateIndexLabel: "Liability composition",
    asOf: "May 6, 2026 (weekly statement)",
    title: "The liability side has settled into a new floor-system equilibrium.",
    interpretationHtml:
      "Banknotes carry $122.5bn of $219.0bn in total liabilities — about 56 per cent — and have drifted up only $30bn over six years, a passive function of currency demand rather than policy. " +
      "Settlement balances are the active line: from a $0.25bn pre-pandemic floor to a $330bn peak in 2021-22, drained through QT, and now $63.9bn — inside the $50–70bn operating range the Bank named in its January 2025 framework. " +
      "Government of Canada deposits have normalized to $26bn from a COVID spike above $80bn, reverse repos sit at zero, and residual other liabilities round out the remaining $7bn.",
    callout: {
      value: "$63.9 bn",
      unit: "Settlement balances",
      delta: "Inside Dec-2024 $50–70 bn range",
      direction: "neutral",
    },
    source:
      "Bank of Canada weekly statement (assets and liabilities; formerly Schedule B2).",
    chartKey: "policy-panel-5",
    data: panel5Data,
    citations: [
      { phrase: "Banknotes carry $122.5bn of $219.0bn in total liabilities", source: "pipeline:boc:boc_banknotes", note: "BoC weekly statement: banknotes = $122.5bn; total liabilities = $219.0bn; May 6 2026 vintage." },
      { phrase: "about 56 per cent", source: "derived", note: "122.5 / 219.0 = 55.9%, rounded to 56 per cent." },
      { phrase: "drifted up only $30bn over six years", source: "pipeline:boc:boc_banknotes", note: "Banknotes ~$92bn pre-pandemic to $122.5bn now, a ~$30bn drift over six years per BoC weekly statement." },
      { phrase: "$0.25bn pre-pandemic floor", source: "pipeline:boc:boc_settlement_balances", note: "Pre-pandemic settlement balances target floor ~$250m per BoC weekly statement history." },
      { phrase: "$330bn peak in 2021-22", source: "pipeline:boc:boc_settlement_balances", note: "Peak settlement balances during 2021-2022 QE period, ~$330bn per BoC weekly statement series." },
      { phrase: "now $63.9bn", source: "pipeline:boc:boc_settlement_balances", note: "Settlement balances, latest May 6 2026 weekly print, $63.9bn." },
      { phrase: "$50–70bn operating range the Bank named in its January 2025 framework", source: "card:boc_floor_system_operating_range" },
      { phrase: "normalized to $26bn", source: "pipeline:boc:boc_goc_deposits", note: "GoC deposits at BoC, latest weekly statement, $26bn." },
      { phrase: "COVID spike above $80bn", source: "pipeline:boc:boc_goc_deposits", note: "GoC deposits at BoC peaked above $80bn during COVID-era cash management per weekly statement history." },
      { phrase: "remaining $7bn", source: "pipeline:boc:boc_total_liabilities", note: "Residual other liabilities on BoC balance sheet, latest weekly statement, ~$7bn." },
    ],
  },
  {
    id: "plate-6",
    number: "06",
    indicator: "Federal budget balance, monthly and fiscal YTD",
    plateIndexLabel: "Federal trajectory",
    asOf: "February 28, 2026 (Fiscal Monitor)",
    title: "The federal balance is tracking a familiar fiscal-year arc.",
    interpretationHtml:
      "Eleven months into fiscal 2025-26, the federal balance is running a $25.5 billion deficit, after a $5.7 billion February surplus pulled the year-to-date reading off its January trough of $31.2 billion. " +
      "The monthly panel runs deficit in eight of eleven prints and surplus in three, with the largest single-month positive landing in February as personal income tax instalments cleared. " +
      "The cadence is the standard one — heavy outflows through the autumn, tax-receipt months tugging the cumulative line back toward the mean — and the next Fiscal Monitor will close the year with the March print.",
    callout: {
      value: "-$25.5 bn",
      unit: "Federal balance, fiscal YTD",
      delta: "11 months into FY 2025-26",
      direction: "neg",
    },
    source: "Department of Finance Fiscal Monitor.",
    chartKey: "policy-panel-6",
    data: panel6Data,
    citations: [
      { phrase: "fiscal 2025-26", source: "pipeline:dof:dof_fiscal_ytd_balance", note: "Fiscal year 2025-26 (April 2025 through March 2026) per Department of Finance Fiscal Monitor convention." },
      { phrase: "$25.5 billion deficit", source: "pipeline:dof:dof_fiscal_ytd_balance", note: "Federal fiscal YTD balance, April 2025 through February 2026, -$25.5bn per Fiscal Monitor (Feb 28 2026 print)." },
      { phrase: "$5.7 billion February surplus", source: "pipeline:dof:dof_fiscal_monthly_balance", note: "February 2026 monthly federal budgetary balance, +$5.7bn per Fiscal Monitor." },
      { phrase: "January trough of $31.2 billion", source: "pipeline:dof:dof_fiscal_ytd_balance", note: "Federal YTD balance through January 2026, -$31.2bn per Fiscal Monitor." },
    ],
  },
];

const pageTitle = "Policy";
const pageDescription =
  "BoC overnight rate, market path, BoC-Fed spread, balance sheet, federal trajectory, fiscal stance.";

// Lede reads the same editorial blurb the auto-blurb pipeline writes for the
// splash tile (sections.ts -> section.blurb.body). Single source of truth: a
// release-day fan-out updates one field and both surfaces refresh.
const lede = section.blurb?.body ?? "";
---
<SectionLayout
  slug="policy"
  sectionIndex={4}
  sectionLabel="Policy"
  headlineQuestion={section.headlineQuestion}
  lede={lede}
  latestReleaseLabel={latestReleaseLabel}
  plates={plates}
  title={pageTitle}
  description={pageDescription}
/>
