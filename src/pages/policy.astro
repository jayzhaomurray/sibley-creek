---
/*
 * /policy/ -> /monetary/ redirect stub.
 *
 * The Policy section was renamed to Monetary on 2026-05-24 when fiscal
 * policy earned its own standalone section at /fiscal/. This page exists
 * solely to redirect any external links (LinkedIn posts, commentary PDFs,
 * Google index) that still point to /policy/.
 *
 * Mechanism: meta-refresh (works on GitHub Pages static hosting where
 * server-side 301 is not available). The canonical link tells crawlers the
 * authoritative URL so link equity transfers to /monetary/.
 *
 * Keep this stub indefinitely until all known external links are updated.
 */

// No frontmatter imports needed -- this page is a pure HTML stub.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Redirecting to Monetary Policy — Sibley Creek</title>
    <meta http-equiv="refresh" content="0; url=/monetary/" />
    <link rel="canonical" href="https://sibleycreek.ca/monetary/" />
    <meta name="robots" content="noindex,follow" />
  </head>
  <body>
    <p>
      This page has moved. If you are not redirected automatically,
      <a href="/monetary/">click here</a>.
    </p>
  </body>
</html>
