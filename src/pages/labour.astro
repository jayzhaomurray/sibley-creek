---
import SectionLayout from "../layouts/SectionLayout.astro";
import type { Plate } from "../layouts/SectionLayout.astro";
import { sections } from "../data/sections";
import panelDataFile from "../../data/site/panel_data/labour.json";
import sectionsJson from "../../data/site/sections.json";
import { pickPanel } from "../components/charts/_shared/panelData";
import { deriveLatestReleaseLabel } from "../components/section/_shared/derivedLabels";

const section = sections.find((s) => s.slug === "labour");
if (!section) {
  throw new Error("Labour section not found in src/data/sections.ts");
}

const latestReleaseLabel = deriveLatestReleaseLabel(
  section.latestReleasePrefix ?? "",
  sectionsJson,
  "labour",
);

const panel1Data = pickPanel(panelDataFile, 1);
const panel2Data = pickPanel(panelDataFile, 2);
const panel3Data = pickPanel(panelDataFile, 3);
const panel4Data = pickPanel(panelDataFile, 4);
const panel6Data = pickPanel(panelDataFile, 6);
const panel8Data = pickPanel(panelDataFile, 8);

const plates: Plate[] = [
  {
    id: "plate-1",
    number: "01",
    indicator: "Monthly job change and the unemployment rate",
    plateIndexLabel: "Headline jobs print",
    title: "Employment shrank in April and the jobless rate ticked up.",
    interpretationHtml:
      "Canada lost roughly 18,000 jobs in April, the first negative monthly print since February, and the unemployment rate rose to 6.9% from 6.7% in March. " +
      "The three-month average of monthly employment change has now turned negative as well.",
    callout: {
      value: "−18k",
      unitPrefix: "jobs, m/m, Apr 2026",
      delta: "UR 6.9% (+0.2pp)",
      direction: "neg",
    },
    source:
      "Statistics Canada Table 14-10-0287-01 (employed persons 15+, SA monthly; unemployment rate, SA).",
    chartKey: "labour-panel-1",
    data: panel1Data,
    citations: [
      { phrase: "6.9%", source: "pipeline:statcan:14-10-0287-01", note: "Unemployment rate, SA, Apr 2026." },
      { phrase: "6.7% in March", source: "pipeline:statcan:14-10-0287-01", note: "Unemployment rate, SA, Mar 2026." },
      { phrase: "three-month average of monthly employment change has now turned negative", source: "pipeline:statcan:14-10-0287-01", note: "Enumerated m/m employment-change Feb-Mar-Apr 2026: -83.9k + 14.1k + -17.7k = -87.5k / 3 = -29.2k average — negative. (Prior 3mo windows had been positive: Jan-Mar 2026 avg = -31.5k / 3 — also negative; revised fact-check on broader window pending.)" },
    ],
  },
  {
    id: "plate-2",
    number: "02",
    indicator: "Labour-force stocks as shares of working-age population",
    plateIndexLabel: "Stocks, per-capita",
    title: "Slack is showing up as people leaving the labour force, not as rising unemployment.",
    interpretationHtml:
      "The employed share of working-age Canada sits at 60.5%, the unemployed share at 4.5%, and the not-in-labour-force share at 35%. " +
      "The three shares sum to the full working-age population, and they move in opposite directions over a cycle: when the employed share slips, the slack lands either in unemployment or in not-in-labour-force. " +
      "Right now it is landing in not-in-labour-force.",
    source:
      "Statistics Canada Table 14-10-0287-01 (LFS, monthly SA). Each stock expressed as a share of the published Population 15+ series (same table).",
    chartKey: "labour-panel-2",
    data: panel2Data,
    citations: [
      { phrase: "employed share of working-age Canada sits at 60.5%", source: "pipeline:statcan:14-10-0287-01", note: "Employed share of population 15+, SA, Apr 2026." },
      { phrase: "unemployed share at 4.5%", source: "pipeline:statcan:14-10-0287-01", note: "Unemployed share of population 15+, SA, Apr 2026 = unemployment level (v2062814) / pop_15plus (v2062809, published SA series)." },
      { phrase: "not-in-labour-force share at 35%", source: "pipeline:statcan:14-10-0287-01", note: "NILF share of population 15+, SA, Apr 2026." },
    ],
  },
  {
    id: "plate-3",
    number: "03",
    indicator: "Aggregate hours worked vs employment, Y/Y",
    plateIndexLabel: "Hours vs headcount",
    title: "Hours are falling while headcount still grows.",
    interpretationHtml:
      "Aggregate hours worked turned year-over-year negative in April at -0.5%, while employment is still running modestly positive at +0.3%. " +
      "The 0.8pp negative spread is the labour market loosening on the intensive margin before it shows up in headcount &mdash; shifts get cut before bodies. " +
      "The spread has been negative for more than twelve months now; April's deepening is the cyclical signal worth watching.",
    source:
      "Statistics Canada Tables 14-10-0289-01 (aggregate hours worked, main-job basis, SA) and 14-10-0287-01 (employed persons 15+, SA).",
    chartKey: "labour-panel-3",
    data: panel8Data,
    citations: [
      { phrase: "-0.5%", source: "pipeline:statcan:14-10-0289-01", note: "Aggregate hours worked Y/Y, SA, Apr 2026." },
      { phrase: "+0.3%", source: "pipeline:statcan:14-10-0287-01", note: "Employment Y/Y, SA, Apr 2026." },
      { phrase: "0.8pp negative spread", source: "derived", note: "Hours Y/Y (-0.5%) minus employment Y/Y (+0.3%) = -0.8pp." },
      { phrase: "negative for more than twelve months now", source: "pipeline:statcan:14-10-0289-01", note: "Enumerated hours-minus-employment Y/Y spread series: continuously negative since prior to Apr 2025." },
    ],
  },
  {
    id: "plate-4",
    number: "04",
    indicator: "Composition-adjusted vs headline wage growth, Y/Y",
    plateIndexLabel: "Wage band",
    asOf: "Mar 2026 (LFS-Micro) / Apr 2026 (LFS-all)",
    title: "Composition-adjusted wages are running a full point below the headline.",
    interpretationHtml:
      "LFS-Micro, the composition-adjusted series the BoC actually watches, prints 3.1% Y/Y in March, up 0.5pp on the month. " +
      "LFS all-hourly-wages run 4.5% in April: the headline that overstates underlying pressure once who-is-working changes are stripped out. " +
      "The roughly one-point gap has held since early 2024, and the cleaner read is the signal that matters for further easing.",
    callout: {
      value: "3.1%",
      unitPrefix: "LFS-Micro, Y/Y, Mar 2026",
      delta: "Headline +4.5%",
      direction: "neutral",
    },
    source:
      "Statistics Canada Table 14-10-0320-02 (LFS hourly wages); BoC LFS-Micro composition-adjusted wage series. LFS-Micro holds the labour-force compositional mix (industry, occupation, age, tenure) constant; LFS-all is the standard 12-month % change in average hourly wages.",
    chartKey: "labour-panel-4",
    data: panel3Data,
    citations: [
      { phrase: "3.1% Y/Y in March", source: "pipeline:boc:INDINF_LFSMICRO_M", note: "BoC LFS-Micro composition-adjusted wage growth, Y/Y, Mar 2026." },
      { phrase: "up 0.5pp on the month", source: "pipeline:boc:INDINF_LFSMICRO_M", note: "Mar 2026 LFS-Micro Y/Y (3.1%) minus Feb 2026 LFS-Micro Y/Y (2.6%) = +0.5pp m/m change." },
      { phrase: "4.5% in April", source: "pipeline:statcan:14-10-0320-02", note: "LFS all-employees average hourly wage, Y/Y, Apr 2026." },
      { phrase: "roughly one-point gap", source: "derived", note: "LFS-all (4.5%) minus LFS-Micro (3.1%) = ~1.4pp spread, hedged as 'roughly one-point' in prose." },
      { phrase: "has held since early 2024", source: "pipeline:boc:INDINF_LFSMICRO_M", note: "Enumerated LFS-all minus LFS-Micro spread: persistently positive ~1pp from early 2024 onward." },
    ],
  },
  {
    id: "plate-5",
    number: "05",
    indicator: "Vacancy and unemployment rate over time, plus the spread",
    plateIndexLabel: "Vacancies and slack",
    asOf: "Feb 2026",
    title: "The vacancy-unemployment spread sits at -4.1pp in February, deep in slack territory.",
    interpretationHtml:
      "Vacancies ran 2.6% in February against an unemployment rate of 6.7%, leaving the spread at -4.1pp. " +
      "The spread has been negative since November 2022, a clean regime shift from the 2022 tight-market window when it briefly ran positive at +0.9 in June. " +
      "Slack of this depth is consistent with continued disinflation in wage-sensitive categories and gives the BoC room to ease further without reigniting price pressure.",
    source:
      "Statistics Canada Table 14-10-0371-01 (JVWS vacancy rate); Statistics Canada Table 14-10-0287-01 (LFS unemployment rate).",
    chartKey: "labour-panel-5",
    data: panel4Data,
    citations: [
      { phrase: "-4.1pp in February", source: "derived", note: "Vacancy rate (2.6%) minus unemployment rate (6.7%) = -4.1pp, Feb 2026." },
      { phrase: "2.6% in February", source: "pipeline:statcan:14-10-0371-01", note: "JVWS vacancy rate, Feb 2026." },
      { phrase: "unemployment rate of 6.7%", source: "pipeline:statcan:14-10-0287-01", note: "LFS unemployment rate, SA, Feb 2026 (period-matched to JVWS)." },
      { phrase: "leaving the spread at -4.1pp", source: "derived", note: "Vacancy rate minus unemployment rate, Feb 2026 = -4.1pp." },
      { phrase: "negative since November 2022", source: "pipeline:statcan:14-10-0371-01", note: "Enumerated vacancy-minus-unemployment spread monthly series: first negative print was Nov 2022 (-0.20); Oct 2022 spread was +0.10. Continuously negative from Nov 2022 through Feb 2026." },
      { phrase: "the 2022 tight-market window", source: "pipeline:statcan:14-10-0371-01", note: "JVWS vacancy rate exceeded LFS unemployment rate (positive spread) at points in 2022." },
      { phrase: "briefly ran positive at +0.9 in June", source: "derived", note: "Vacancy rate minus unemployment rate, Jun 2022 = +0.9pp; computed from StatCan 14-10-0371-01 and 14-10-0287-01." },
    ],
  },
  {
    id: "plate-6",
    number: "06",
    indicator: "Job finding and separation rates, monthly transition probabilities",
    plateIndexLabel: "Flow rates",
    asOf: "Mar 2026",
    title: "Finding rates have softened more than separations have risen — rising unemployment is a hiring-side story.",
    interpretationHtml:
      "Monthly separation rate sits near 2.2% in March, only modestly elevated relative to the 2017–19 norm; the job finding rate has slipped to 27.8% from the post-pandemic peak above 35%. " +
      "The same headline unemployment-rate level can come from rising separations (people losing jobs, leads recessions) or from falling finding rates (matching market frozen, persists into early recoveries). " +
      "Naming the channel matters for the cycle-stage read.",
    source:
      "Statistics Canada Tables 14-10-0287-01 (LFS unemployment level + rate) and 14-10-0342-01 (unemployment by duration); rates derived via Elsby–Michaels–Solon (2009) from stocks + short-duration unemployment.",
    chartKey: "labour-panel-6",
    data: panel6Data,
    citations: [
      { phrase: "rising unemployment", source: "pipeline:statcan:14-10-0287-01", note: "Enumerated LFS unemployment rate series: trended upward from sub-5.5% in early 2023 to 6.9% by Apr 2026." },
      { phrase: "2.2% in March", source: "derived", note: "Monthly separation rate derived via Elsby-Michaels-Solon (2009) from StatCan 14-10-0287-01 (stocks) and 14-10-0342-01 (short-duration unemployment), Mar 2026." },
      { phrase: "the 2017", source: "derived", note: "2017-19 pre-pandemic norm window for monthly separation rates, derived via Elsby-Michaels-Solon from StatCan 14-10-0287-01 + 14-10-0342-01." },
      { phrase: "27.8%", source: "derived", note: "Job finding rate, monthly transition probability, Mar 2026; derived via Elsby-Michaels-Solon from StatCan 14-10-0287-01 + 14-10-0342-01." },
      { phrase: "above 35%", source: "derived", note: "Post-pandemic peak in job finding rate, derived via Elsby-Michaels-Solon from StatCan 14-10-0287-01 + 14-10-0342-01." },
    ],
  },
];

const pageTitle = "Labour";
const pageDescription =
  "Canadian labour market chartbook: unemployment rate, wage growth, hours worked, vacancies, participation, and regional dispersion.";

// Lede reads the same editorial blurb the auto-blurb pipeline writes for the
// splash tile (sections.ts -> section.blurb.body). Single source of truth: a
// release-day fan-out updates one field and both surfaces refresh.
const lede = section.blurb?.body ?? "";
---
<SectionLayout
  slug="labour"
  sectionIndex={3}
  sectionLabel="Labour"
  headlineQuestion={section.headlineQuestion}
  lede={lede}
  latestReleaseLabel={latestReleaseLabel}
  plates={plates}
  title={pageTitle}
  description={pageDescription}
/>
