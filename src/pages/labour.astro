---
import SectionLayout from "../layouts/SectionLayout.astro";
import type { Plate } from "../layouts/SectionLayout.astro";
import { sections } from "../data/sections";
import panelDataFile from "../../data/site/panel_data/labour.json";
import sectionsJson from "../../data/site/sections.json";
import { pickPanel } from "../components/charts/_shared/panelData";
import { deriveLatestReleaseLabel } from "../components/section/_shared/derivedLabels";

const section = sections.find((s) => s.slug === "labour");
if (!section) {
  throw new Error("Labour section not found in src/data/sections.ts");
}

const latestReleaseLabel = deriveLatestReleaseLabel(
  section.latestReleasePrefix ?? "",
  sectionsJson,
  "labour",
);

const panel1Data = pickPanel(panelDataFile, 1);
const panel2Data = pickPanel(panelDataFile, 2);
const panel3Data = pickPanel(panelDataFile, 3);
const panel4Data = pickPanel(panelDataFile, 4);
const panel6Data = pickPanel(panelDataFile, 6);
const panel8Data = pickPanel(panelDataFile, 8);

const plates: Plate[] = [
  {
    id: "plate-1",
    number: "01",
    indicator: "Monthly job change and the unemployment rate",
    plateIndexLabel: "Headline jobs print",
    title: "Hiring rebounded across most of the economy in May.",
    interpretationHtml:
      "The May surge was broad, not a one-industry fluke: most sectors added jobs, and the gains landed in full-time work rather than part-time. " +
      "Breadth that wide is what separates a real turn from statistical noise. " +
      "It lifts employment to its highest level this calendar year, though still about 25,000 short of December's peak.",
    callout: {
      value: "+88k",
      unitPrefix: "jobs, m/m, May 2026",
      delta: "UR 6.6% (−0.3pp)",
      direction: "pos",
    },
    source:
      "Statistics Canada Table 14-10-0287-01 (employed persons 15+, SA monthly; unemployment rate, SA).",
    chartKey: "labour-panel-1",
    data: panel1Data,
    citations: [
      { phrase: "most sectors added jobs", source: "card:statcan_daily_lfs_2026-05", note: "11 of 16 industry groupings rose in May 2026 (StatCan Table 14-10-0355-01, reported in the lfs-2026-06-05 commentary); The Daily names construction +27k, info/culture/rec +19k, transport +19k, accommodation +17k up and wholesale/retail −35k down." },
      { phrase: "gains landed in full-time work rather than part-time", source: "card:statcan_daily_lfs_2026-05", note: "The Daily, June 5 2026: full-time +154,000, part-time −66,000 in May." },
      { phrase: "highest level this calendar year, though still about 25,000 short of December's peak", source: "derived", note: "May 2026 employment 21.1215M exceeds every other 2026 month but sits ~24.5k below the Dec 2025 peak (21.146M). Per the published correction notice: not an all-time high." },
    ],
  },
  {
    id: "plate-2",
    number: "02",
    indicator: "Labour-force stocks as shares of working-age population",
    plateIndexLabel: "Stocks, per-capita",
    title: "The employed share rose in May, pausing the slide into non-participation.",
    interpretationHtml:
      "The employed share of the working-age population climbed to 60.7% in May as the unemployed share fell to 4.3%. " +
      "For much of this cycle, a fast-growing population had been landing outside the labour force rather than in jobs; that absorption paused this month. " +
      "Participation held at 65.0%, so the gain came from filling the existing labour force, not from people stepping away.",
    source:
      "Statistics Canada Table 14-10-0287-01 (LFS, monthly SA). Each stock expressed as a share of the published Population 15+ series (same table).",
    chartKey: "labour-panel-2",
    data: panel2Data,
    citations: [
      { phrase: "employed share of the working-age population climbed to 60.7%", source: "pipeline:statcan:14-10-0287-01", note: "Employment rate (employed share of population 15+), SA, May 2026: 60.7%, up from 60.5% in April." },
      { phrase: "unemployed share fell to 4.3%", source: "pipeline:statcan:14-10-0287-01", note: "Unemployed share of population 15+, SA, May 2026 = unemployment level (1.4824M) / pop_15plus (34.77M) = 4.26%." },
      { phrase: "Participation held at 65.0%", source: "pipeline:statcan:14-10-0287-01", note: "LFS participation rate, SA, May 2026: 65.0%, unchanged from April." },
    ],
  },
  {
    id: "plate-3",
    number: "03",
    indicator: "Aggregate hours worked vs employment, Y/Y",
    plateIndexLabel: "Hours vs headcount",
    title: "Hours are recovering, but still trail the headcount rebound.",
    interpretationHtml:
      "Hours are recovering, yet they trail the jobs count: aggregate hours are up just 0.3% Y/Y against 0.7% for employment. " +
      "The gap means firms added bodies faster than they added work for them to do. " +
      "Until hours catch up, the recovery in headcount overstates how much demand for labour has actually firmed.",
    source:
      "Statistics Canada Tables 14-10-0289-01 (aggregate hours worked, main-job basis, SA) and 14-10-0287-01 (employed persons 15+, SA).",
    chartKey: "labour-panel-3",
    data: panel8Data,
    citations: [
      { phrase: "up just 0.3% Y/Y", source: "pipeline:statcan:14-10-0289-01", note: "Aggregate hours worked Y/Y, SA, May 2026: 680550.5 / 678533.0 = +0.30%; first positive print after the negative run through April (-0.51%)." },
      { phrase: "0.7% for employment", source: "pipeline:statcan:14-10-0287-01", note: "Employment Y/Y, SA, May 2026: 21.1215M / 20.9744M = +0.70%." },
      { phrase: "firms added bodies faster than they added work", source: "derived", note: "Hours Y/Y (+0.3%) minus employment Y/Y (+0.7%) = -0.4pp; hours growth trails headcount growth." },
    ],
  },
  {
    id: "plate-4",
    number: "04",
    indicator: "Composition-adjusted vs headline wage growth, Y/Y",
    plateIndexLabel: "Wage band",
    asOf: "Mar 2026 (LFS-Micro) / May 2026 (LFS-all)",
    title: "Wage growth cooled sharply in May, but the cleaner read isn't in yet.",
    interpretationHtml:
      "Headline wage growth fell to 3.0% Y/Y in May, down from 4.5% in April. " +
      "But the headline mixes raw pay gains with shifts in who is working. " +
      "The composition-adjusted measure, LFS-Micro, last read 3.1% in March and has no May figure yet. " +
      "Whether the cooling is genuine or just a change in the workforce awaits the next reading.",
    callout: {
      value: "3.0%",
      unitPrefix: "LFS-all, Y/Y, May 2026",
      delta: "Apr +4.5%",
      direction: "neutral",
    },
    source:
      "Statistics Canada Table 14-10-0320-02 (LFS hourly wages); BoC LFS-Micro composition-adjusted wage series. LFS-Micro holds the labour-force compositional mix (industry, occupation, age, tenure) constant; LFS-all is the standard 12-month % change in average hourly wages.",
    chartKey: "labour-panel-4",
    data: panel3Data,
    citations: [
      { phrase: "fell to 3.0% Y/Y in May", source: "pipeline:statcan:14-10-0320-02", note: "LFS all-employees average hourly wage, Y/Y, May 2026: 37.24 / 36.14 = +3.04%. Wage level fell m/m (37.77 to 37.24), so the deceleration is genuine, not a base effect." },
      { phrase: "down from 4.5% in April", source: "pipeline:statcan:14-10-0320-02", note: "LFS all-employees average hourly wage, Y/Y, Apr 2026: 37.77 / 36.13 = +4.54%." },
      { phrase: "last read 3.1% in March and has no May figure yet", source: "pipeline:boc:INDINF_LFSMICRO_M", note: "BoC LFS-Micro composition-adjusted wage growth, Y/Y; series terminates at Mar 2026 (3.1%). No Apr/May vintage published as of Jun 5, 2026." },
    ],
  },
  {
    id: "plate-5",
    number: "05",
    indicator: "Vacancy and unemployment rate over time, plus the spread",
    plateIndexLabel: "Vacancies and slack",
    asOf: "Mar 2026",
    title: "A deep-slack regime in the stock of jobs has held for over three years.",
    interpretationHtml:
      "The vacancy rate sat at 2.8% in March against a 6.7% unemployment rate that month, leaving vacancies 3.9 percentage points short of the people looking for work. " +
      "That spread has been negative without a break since November 2022 &mdash; there are fewer open jobs than jobseekers, and have been for over three years. " +
      "This is the honest tension with May's hiring pop: flows can turn in a single month, but the standing pool of slack in the job market is still deep.",
    source:
      "Statistics Canada Table 14-10-0371-01 (JVWS vacancy rate); Statistics Canada Table 14-10-0287-01 (LFS unemployment rate).",
    chartKey: "labour-panel-5",
    data: panel4Data,
    citations: [
      { phrase: "2.8% in March", source: "pipeline:statcan:14-10-0371-01", note: "JVWS vacancy rate, Mar 2026." },
      { phrase: "6.7% unemployment rate that month", source: "pipeline:statcan:14-10-0287-01", note: "LFS unemployment rate, SA, Mar 2026 (period-matched to JVWS)." },
      { phrase: "3.9 percentage points short", source: "derived", note: "Vacancy rate (2.8%) minus unemployment rate (6.7%) = -3.9pp, Mar 2026." },
      { phrase: "negative without a break since November 2022", source: "pipeline:statcan:14-10-0371-01", note: "Enumerated vacancy-minus-unemployment spread monthly series: first negative print Nov 2022 (-0.20); Oct 2022 was +0.10. Continuously negative Nov 2022 through Mar 2026 (3.3 years)." },
      { phrase: "May's hiring pop", source: "pipeline:statcan:14-10-0287-01", note: "LFS employment change, SA, May 2026: +87.8k m/m." },
    ],
  },
  {
    id: "plate-6",
    number: "06",
    indicator: "Job finding and separation rates, monthly transition probabilities",
    plateIndexLabel: "Flow rates",
    asOf: "Apr 2026",
    title: "Layoffs never spiked — the weak spot has been a slow hiring rate.",
    interpretationHtml:
      "This was never a layoff problem; the weak spot was always slow hiring&mdash;and that side is now turning. " +
      "Separations held at 2.0% in April, near their pre-pandemic norm, as they have all cycle: no spike, ever. " +
      "The finding rate, meanwhile, jumped to 32.4% from 27.8% in March&mdash;the hiring channel thawing before May's +87.8k blowout confirmed it.",
    source:
      "Statistics Canada Tables 14-10-0287-01 (LFS unemployment level + rate) and 14-10-0342-01 (unemployment by duration); rates derived via Elsby–Michaels–Solon (2009) from stocks + short-duration unemployment.",
    chartKey: "labour-panel-6",
    data: panel6Data,
    citations: [
      { phrase: "Separations held at 2.0% in April", source: "derived", note: "Monthly separation rate via Elsby-Michaels-Solon (2009) from StatCan 14-10-0287-01 + 14-10-0342-01, Apr 2026 = 2.01%. 2017-19 norm: mean 2.33%, range 2.13-2.53%." },
      { phrase: "as they have all cycle: no spike, ever", source: "derived", note: "Enumerated separation-rate series 2023-2026: cycle max 2.35% (Mar 2025) is below the 2017-19 max (2.53%). COVID months (3.68-3.94%, Apr-May 2020) excluded as known distortion." },
      { phrase: "jumped to 32.4% from 27.8% in March", source: "derived", note: "Job finding rate via Elsby-Michaels-Solon: Apr 2026 = 32.43%, Mar 2026 = 27.84%." },
      { phrase: "May's +87.8k blowout", source: "pipeline:statcan:14-10-0287-01", note: "LFS employment change, SA, May 2026: +87.8k m/m." },
    ],
  },
];

const pageTitle = "Labour";
const pageDescription =
  "Canadian labour market chartbook: unemployment rate, wage growth, hours worked, vacancies, participation, and regional dispersion.";

// Lede reads the same editorial blurb the auto-blurb pipeline writes for the
// splash tile (sections.ts -> section.blurb.body). Single source of truth: a
// release-day fan-out updates one field and both surfaces refresh.
const lede = section.blurb?.body ?? "";
---
<SectionLayout
  slug="labour"
  sectionIndex={3}
  sectionLabel="Labour"
  headlineQuestion={section.headlineQuestion}
  lede={lede}
  latestReleaseLabel={latestReleaseLabel}
  plates={plates}
  title={pageTitle}
  description={pageDescription}
/>
