---
/*
 * Labour - basics-layer section page (placeholder).
 *
 * Six panels per editorial canon section 4.3:
 *   1. LFS headline
 *   2. Per-capita panel
 *   3. Wage band
 *   4. Vacancies and slack
 *   5. Population and immigration
 *   6. Regional dispersion
 *
 * Why this file is sparse:
 *   Navigation-skeleton placeholder. Writer + style-editor own panel
 *   titles, decks, callouts, and source citations. Backend pipeline owns
 *   vintage stamps and numeric values. Chart-builder hydrates chart slots.
 *   Frontend reserves panel order, eyebrows, anchors, and the page shell.
 *
 * Mirrors src/pages/gdp.astro structure; see that file for the worked
 * example with finished placeholder copy.
 */

import SectionLayout from "../layouts/SectionLayout.astro";
import type { Panel } from "../layouts/SectionLayout.astro";
import { sections } from "../data/sections";

const section = sections.find((s) => s.slug === "labour");
if (!section) {
  throw new Error("Labour section not found in src/data/sections.ts");
}

const pageAsOf = {
  label: "Placeholder release",
  releaseDate: "TBD",
};

const placeholderText = "Placeholder. Writer to populate.";
const placeholderMethodology = "Placeholder. Methodology to be documented by editorial.";
const placeholderSource = "Source citation TBD.";
const placeholderVintage = { releaseDate: "TBD" };

const panels: Panel[] = [
  {
    id: "panel-1",
    eyebrow: "LFS headline",
    title: placeholderText,
    deck: placeholderText,
    vintage: placeholderVintage,
    editorialStatus: placeholderText,
    source: placeholderSource,
    methodology: { body: placeholderMethodology },
  },
  {
    id: "panel-2",
    eyebrow: "Per-capita panel",
    title: placeholderText,
    deck: placeholderText,
    vintage: placeholderVintage,
    editorialStatus: placeholderText,
    source: placeholderSource,
    methodology: { body: placeholderMethodology },
  },
  {
    id: "panel-3",
    eyebrow: "Wage band",
    title: placeholderText,
    deck: placeholderText,
    vintage: placeholderVintage,
    editorialStatus: placeholderText,
    source: placeholderSource,
    methodology: { body: placeholderMethodology },
  },
  {
    id: "panel-4",
    eyebrow: "Vacancies and slack",
    title: placeholderText,
    deck: placeholderText,
    vintage: placeholderVintage,
    editorialStatus: placeholderText,
    source: placeholderSource,
    methodology: { body: placeholderMethodology },
  },
  {
    id: "panel-5",
    eyebrow: "Population and immigration",
    title: placeholderText,
    deck: placeholderText,
    vintage: placeholderVintage,
    editorialStatus: placeholderText,
    source: placeholderSource,
    methodology: { body: placeholderMethodology },
  },
  {
    id: "panel-6",
    eyebrow: "Regional dispersion",
    title: placeholderText,
    deck: placeholderText,
    vintage: placeholderVintage,
    editorialStatus: placeholderText,
    source: placeholderSource,
    methodology: { body: placeholderMethodology },
  },
];

const pageTitle = "Labour";
const pageDescription = `${section.headlineQuestion} The macro-research-department Labour section: LFS headline, per-capita output, wages, vacancies, population, and regional dispersion.`;
---
<SectionLayout
  slug="labour"
  sectionIndex={3}
  sectionName="Labour"
  sectionLabel={section.label}
  accentVar={section.accentVar}
  headlineQuestion={section.headlineQuestion}
  pageAsOf={pageAsOf}
  panels={panels}
  title={pageTitle}
  description={pageDescription}
/>
