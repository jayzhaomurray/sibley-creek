---
import SectionLayout from "../layouts/SectionLayout.astro";
import type { Plate } from "../layouts/SectionLayout.astro";
import { sections } from "../data/sections";
import panelDataFile from "../../data/site/panel_data/labour.json";
import sectionsJson from "../../data/site/sections.json";
import { pickPanel } from "../components/charts/_shared/panelData";
import { deriveLatestReleaseLabel } from "../components/section/_shared/derivedLabels";

const section = sections.find((s) => s.slug === "labour");
if (!section) {
  throw new Error("Labour section not found in src/data/sections.ts");
}

const latestReleaseLabel = deriveLatestReleaseLabel(
  section.latestReleasePrefix ?? "",
  sectionsJson,
  "labour",
);

const panel1Data = pickPanel(panelDataFile, 1);
const panel2Data = pickPanel(panelDataFile, 2);
const panel3Data = pickPanel(panelDataFile, 3);
const panel4Data = pickPanel(panelDataFile, 4);
const panel5Data = pickPanel(panelDataFile, 5);
const panel6Data = pickPanel(panelDataFile, 6);
const panel7Data = pickPanel(panelDataFile, 7);

const plates: Plate[] = [
  {
    id: "plate-1",
    number: "01",
    indicator: "Unemployment, employment, participation",
    plateIndexLabel: "LFS headline",
    title: "The headline unemployment rate is steady; the employment rate is doing the softening underneath.",
    interpretationHtml:
      "The unemployment rate ticked up to 6.9% in April from 6.7% in March, matching the cycle level of a year earlier. " +
      "The employment rate fell to 60.5% &mdash; a third consecutive monthly decline and 0.3pp below April 2025 &mdash; while participation edged back to 65.0%. " +
      "Each rate sits on its own y-axis so the recent action reads; the headline is flat year-on-year while the employment rate does the work underneath.",
    callout: {
      value: "6.9%",
      unitPrefix: "unemployment rate",
      delta: "+0.2pp vs Mar",
      direction: "neg",
    },
    source: "Statistics Canada Table 14-10-0287-01. Dashed reference lines mark each rate's 2010–2019 pre-pandemic average, computed in the chart wrapper.",
    chartKey: "labour-panel-1",
    data: panel1Data,
  },
  {
    id: "plate-2",
    number: "02",
    indicator: "Wage growth, Y/Y, four measures",
    plateIndexLabel: "Wage band",
    asOf: "Mar 2026 (LFS-Micro, CPI) / Apr 2026 (LFS-all) / Feb 2026 (SEPH)",
    title: "Composition-adjusted wage growth runs below headline measures and clears services-ex-shelter inflation.",
    interpretationHtml:
      "LFS-all hourly wages run 4.5% Y/Y in April; SEPH average weekly earnings sit at 3.4% in February; the Bank's composition-adjusted LFS-Micro series prints 3.1% in March. " +
      "The gap between the headline and the composition-adjusted read is the story &mdash; the front-line LFS print overstates the underlying pressure once who-is-working composition is stripped out. " +
      "Services CPI ex-shelter at 3.6% in March is the real-wage anchor; only LFS-all clears it comfortably, while LFS-Micro sits just below.",
    callout: {
      value: "3.1%",
      unitPrefix: "LFS-Micro, Y/Y, Mar 2026",
    },
    source:
      "Statistics Canada Tables 14-10-0064-01 (LFS hourly wages), 14-10-0220-01 (SEPH); BoC LFS-Micro composition-adjusted wage series; Statistics Canada CPI sub-aggregates (services ex-shelter Y/Y derived in pipeline/processed).",
    chartKey: "labour-panel-3",
    data: panel3Data,
  },
  {
    id: "plate-3a",
    number: "03a",
    indicator: "Vacancy and unemployment rate over time, plus the spread",
    plateIndexLabel: "Vacancies and slack",
    asOf: "Feb 2026",
    title: "Vacancies and slack as lines and a spread — the cyclical signal without the trajectory plane.",
    interpretationHtml:
      "Left panel shows vacancy rate and unemployment rate as two lines on a shared percent axis; right panel shows the spread (vacancy minus unemployment) as monthly bars. " +
      "The bar geometry collapses the Beveridge curve's path into a single signed quantity &mdash; positive when vacancies exceed unemployment (tight), negative when unemployment exceeds vacancies (slack).",
    source:
      "Statistics Canada Table 14-10-0432-01 (JVWS vacancy rate); Statistics Canada Table 14-10-0287-01 (LFS unemployment rate).",
    chartKey: "labour-panel-4-levels",
    data: panel4Data,
  },
  {
    id: "plate-3b",
    number: "03b",
    indicator: "Beveridge curve, vacancy rate vs unemployment rate",
    plateIndexLabel: "Beveridge",
    asOf: "Feb 2026",
    title: "Labour demand has not just normalized but is drifting through pre-pandemic norms.",
    interpretationHtml:
      "The chart places monthly vacancy and unemployment readings on a single plane, with the time-path connecting them. " +
      "The cycle has run from pandemic loose territory (May 2020 trough, hollow dots are imputed where the JVWS was paused), through 2022 peak tightness at the upper-right, back down through pre-pandemic norms (Sep 2019) and into the lower-right quadrant of the post-pandemic loosening. " +
      "Vacancy rate at 2.6% against an unemployment rate of 6.7% in February puts Canada decisively past the 2018-19 equilibrium.",
    source:
      "Statistics Canada Table 14-10-0432-01 (JVWS); Statistics Canada Table 14-10-0287-01 (LFS unemployment rate); Indeed Hiring Lab Canada aggregate postings (used to impute Apr-Sep 2020 vacancy rate via OLS).",
    chartKey: "labour-panel-4",
    data: panel4Data,
  },
  {
    id: "plate-3c",
    number: "03c",
    indicator: "Job finding and separation rates, monthly transition probabilities",
    plateIndexLabel: "Flow rates",
    asOf: "Mar 2026",
    title: "Finding rates have softened more than separations have risen — the post-2023 UR drift is a hiring-side story.",
    interpretationHtml:
      "Monthly separation rate sits near 2.2% in March, only modestly elevated relative to the 2017–19 norm; the job finding rate has slipped to 27.8% from the post-pandemic peak above 35%. " +
      "The same headline unemployment-rate level can come from rising separations (people losing jobs, leads recessions) or from falling finding rates (matching market frozen, persists into early recoveries). " +
      "Naming the channel matters for the cycle-stage read.",
    source:
      "Statistics Canada Tables 14-10-0287-01 (LFS unemployment level + rate) and 14-10-0342-01 (unemployment by duration); rates derived via Elsby–Michaels–Solon (2009) from stocks + short-duration unemployment.",
    chartKey: "labour-panel-flow-rates",
  },
  {
    id: "plate-5",
    number: "04",
    indicator: "PR landings and net NPR vs IRCC plan",
    plateIndexLabel: "Supply trajectory",
    asOf: "Q4 2025; current IRCC levels plan",
    title: "The population denominator is rolling over as the IRCC plan pivot works through.",
    interpretationHtml:
      "Net non-permanent-resident flows printed -171,000 in Q4 2025, the fifth consecutive negative quarter since the October 2024 plan pivot. " +
      "PR landings of 83,000 in Q4 keep permanent inflows tracking within plan range. The supply trajectory now implied by the IRCC plan is materially flatter than 2023-24 realized.",
    source: "IRCC Levels Plan; Statistics Canada Table 17-10-0008-01.",
    chartKey: "labour-panel-5",
    data: panel5Data,
  },
  {
    id: "plate-6",
    number: "05",
    indicator: "Spread of provincial unemployment rates vs the national rate",
    plateIndexLabel: "Regional",
    title: "Each big province has its own gap to the national rate.",
    interpretationHtml:
      "Each panel plots the signed gap between the provincial unemployment rate and the national rate, monthly. " +
      "Positive bars mean the province is running above the national rate (more slack); negative bars mean it is running below (tighter labour market). " +
      "Ontario has sat above the line through the past year; Alberta has flipped sides recently; British Columbia ran below Canada for most of the cycle before converging; Quebec has stayed steadily below the national rate.",
    source: "Statistics Canada Table 14-10-0287-01 (LFS by province).",
    chartKey: "labour-panel-6",
    data: panel6Data,
  },
  {
    id: "plate-7",
    number: "06",
    indicator: "EI claimants per 1,000 labour-force-ex-NPRs",
    plateIndexLabel: "EI beneficiaries",
    asOf: "Feb 2026",
    title: "The leading EI signal has rolled over even as the LFS unemployment rate climbed back up.",
    interpretationHtml:
      "EI regular claimants per 1,000 labour-force-ex-NPRs eased to 25.5 in February from 26.9 at the November 2025 peak &mdash; three consecutive monthly declines. " +
      "Deflating by a labour-force aggregate that excludes non-permanent residents strips out the immigration-cycle confound: the ratio sits modestly below the pre-covid median (~29 per 1k) and well clear of the GFC peak near 45. " +
      "EI is a leading cyclical indicator and typically inflects before LFS unemployment; here, the caseload turned down two months before April's unemployment rate climbed back to 6.9%. Watch whether the roll-over holds as the LFS re-tightens.",
    callout: {
      value: "25.5",
      unitPrefix: "per 1k LF ex-NPRs",
      delta: "-0.6 vs Jan",
      direction: "pos",
    },
    source:
      "Statistics Canada Table 14-10-0011-01 (EI regular beneficiaries); labour-force-ex-NPR denominator derived from LFS (Table 14-10-0287-01) and Statistics Canada NPR estimates (Table 17-10-0040-01), per the methodology documented at /methodology.",
    chartKey: "labour-panel-7",
    data: panel7Data,
  },
];

const pageTitle = "Labour";
const pageDescription =
  "LFS headline, wage band, vacancies and slack, IRCC supply, regional dispersion, EI beneficiaries.";

// Lede reads the same editorial blurb the auto-blurb pipeline writes for the
// splash tile (sections.ts -> section.blurb.body). Single source of truth: a
// release-day fan-out updates one field and both surfaces refresh.
const lede = section.blurb?.body ?? "";
---
<SectionLayout
  slug="labour"
  sectionIndex={3}
  sectionLabel="Labour"
  headlineQuestion={section.headlineQuestion}
  lede={lede}
  latestReleaseLabel={latestReleaseLabel}
  plates={plates}
  title={pageTitle}
  description={pageDescription}
/>
