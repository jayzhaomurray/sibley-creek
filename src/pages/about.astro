---
/*
 * /about/ - institutional About page.
 *
 * 2026-05-23 rewrite: positions Sibley Creek as a research + advisory
 * firm (not a solo publication), surfaces the team (Jay + Thompson +
 * Khoi), names the method, links to /advisory/. Joe Grimbly is kept
 * off the public team list per the staff-roster memory note — he has
 * a full-time job elsewhere and the public credit would be delicate.
 *
 * Visual register: Vignelli (per design/design-system.md). One sans (Manrope)
 * for everything; H1 in display-lg 600; body in body-lg 400; institutional
 * kicker in micro-caps 600 above the title band. Team list renders as
 * styled paragraphs (no bullet markers) — bold name + em-dash + role
 * does the visual structuring.
 *
 * The page is reachable from the footer (VignelliColophon's secondary nav)
 * and NOT from the masthead - the masthead remains the 7 sections + Research.
 */

import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/sections";

const pageTitle = "About";
const pageDesc =
  "Sibley Creek is an independent Canadian macroeconomic research and " +
  "advisory firm. Team, method, name, and how to get in touch.";
---
<BaseLayout title={pageTitle} description={pageDesc} pageClass="static-page">
  <article class="static" aria-labelledby="static-h">
    <header class="static__header">
      <h1 id="static-h" class="static__h">About</h1>
    </header>

    <div class="static__body markdown-body">
      <figure class="static__figure">
        <img
          class="static__figure-img"
          src="/about/sleeping-giant.jpg"
          alt="The Sleeping Giant landform on the Sibley Peninsula in Lake Superior. Three flat-topped diabase mesas separated by erosion notches; the silhouette reads as a reclining figure."
          width="1440"
          height="810"
          loading="lazy"
          decoding="async"
        />
        <figcaption class="static__figcaption">
          <span class="static__figcaption-eyebrow">
            The Sleeping Giant, Sibley Peninsula, Lake Superior
          </span>
          <span class="static__figcaption-credit">
            Photo by D.&nbsp;Gordon&nbsp;E.&nbsp;Robertson, CC&nbsp;BY-SA&nbsp;3.0.
          </span>
        </figcaption>
      </figure>

      <p>
        Sibley Creek is an independent Canadian macroeconomic research
        and advisory firm.
      </p>

      <p>
        We publish a live read of the Canadian economy — same-day
        commentary on every major print, paired with deeper research as
        questions warrant.
      </p>

      <p>
        We also work with select institutional clients on retainer and
        project engagements. See <a href="/advisory/">Hire us</a> for who
        we work with and how.
      </p>

      <p>
        Our method pairs disciplined data analysis with ground-truth
        reporting. We work from primary sources — Statistics Canada, the
        Bank of Canada, the Department of Finance — and talk to the
        people closest to the story.
      </p>

      <h2>Team</h2>
      <ul>
        <li>
          <strong>Jay Zhao-Murray</strong> — Chief Economist. Jay was
          previously the Canada economics data editor at Bloomberg in
          Ottawa and, before that, a foreign exchange analyst at Monex
          Canada. He started his career at the Bank of Canada and studied
          economics at Western University.
        </li>
        <li>
          <strong>Thompson Richards</strong> — Economist. Thompson holds
          a master's in economics and data science from Carleton
          University.
        </li>
        <li>
          <strong>Khoi Pham</strong> — Research Analyst. Khoi has
          interned at TD and Irving Oil, and is in the final year of a
          BBA in finance and economics at the University of New Brunswick.
        </li>
      </ul>

      <h2>The name</h2>
      <p>
        The name comes from a small stream in Sleeping Giant Provincial
        Park, on the north shore of Lake Superior. The brand mark uses
        the Giant: three flat-topped mesas separated by two erosion
        notches, reclining on his back.
      </p>

    </div>
  </article>

  <style>
    /* ============================================================
     * /about/ + /methodology/ - shared "static page" surface.
     *
     * Modeled on the /research/<slug>/ deep-dive page, but trimmed:
     *   - No section kicker (this is institutional, not editorial).
     *   - No deck or published-date stamp.
     *   - No "Back to research" foot link.
     * The body markdown-body rules mirror the deep-dive rules so the
     * typographic register matches across the site.
     * ============================================================ */

    .static {
      width: 100%;
      /* Reading register: narrow centered column, generous side padding.
       * Matches /work-with-us/ and /contact/ for editorial / prose pages. */
      max-width: 720px;
      margin: 0 auto;
      padding: 32px 24px 64px;
    }

    /* ---- Header (boutique register, matches /work-with-us/) ---- */
    .static__header {
      border-bottom: 1px solid var(--ink);
      padding-bottom: 24px;
      margin-bottom: 32px;
    }
    .static__kicker {
      margin: 0 0 12px;
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 13px;
      line-height: 1;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--ink);
      opacity: 0.7;
    }
    .static__h {
      margin: 0;
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 42px;
      line-height: 1.1;
      color: var(--ink);
    }

    /* ---- Body (matches /work-with-us/ prose register exactly) ---- */
    .static__body {
      /* No top margin: header already has margin-bottom: 32px. */
    }

    .markdown-body h2 {
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 14px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--ink);
      margin: 40px 0 16px;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--ink);
    }
    .markdown-body h2:first-child {
      margin-top: 0;
    }

    .markdown-body p {
      font-family: var(--font-sans);
      font-weight: 400;
      font-size: 18px;
      line-height: 1.55;
      color: var(--ink);
      margin: 0 0 16px;
    }
    .markdown-body p:last-child {
      margin-bottom: 0;
    }

    .markdown-body strong,
    .markdown-body b {
      font-weight: 600;
      color: var(--ink);
    }

    .markdown-body em,
    .markdown-body i {
      font-style: normal;
      font-weight: 200;
    }

    .markdown-body a {
      color: var(--ink);
      text-decoration-color: var(--ink);
    }
    .markdown-body a:hover {
      color: var(--accent);
      text-decoration-color: var(--accent);
    }

    /* Team list — no bullet markers; bold name + em-dash + role does the
     * visual structuring. Each item reads as a styled paragraph. */
    .markdown-body ul {
      list-style: none;
      padding: 0;
      margin: 0 0 16px;
    }
    .markdown-body li {
      font-family: var(--font-sans);
      font-weight: 400;
      font-size: 18px;
      line-height: 1.55;
      color: var(--ink);
      margin: 0 0 16px;
      padding: 0;
    }
    .markdown-body li:last-child {
      margin-bottom: 0;
    }

    /* ----------------------------------------------------------
     * /about/ photographic figure - the Sleeping Giant
     *
     * Visual register matches the chart canon: one hairline pure-
     * ink frame at the plot boundary; no drop shadow, no rounded
     * corners, no inner padding, no card pillow. The image sits
     * directly on paper, framed exactly the way a chart's plot
     * area is framed. Aspect is locked to 16:9 (the Tier-3 chart
     * aspect) so the figure feels native to the visual system.
     *
     * Caption sits below the frame, NOT inside it. Eyebrow uses
     * the same micro-caps treatment as the static page kicker
     * (Manrope 600, 10px, letter-spacing 0.22em, uppercase). The
     * credit line is the only italic in the static body and is
     * deliberately small - the eye reads the eyebrow first and
     * only needs the photographer attribution if it is hunting
     * for it. CC BY-SA 3.0 requires the credit; the visual hierarchy
     * respects the license without letting it dominate.
     * ---------------------------------------------------------- */

    .static__figure {
      /* Top: 0, the header's 32px margin-bottom carries the gap.
       * Bottom: 40px, matches the .wwu__intro margin rhythm. */
      margin: 0 0 40px;
      padding: 0;
    }

    .static__figure-img {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
      object-fit: cover;
      object-position: center 40%;
      border: 1px solid var(--ink);
      border-radius: 0;
      box-shadow: none;
      background: var(--paper);
    }

    .static__figcaption {
      margin-top: 10px;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .static__figcaption-eyebrow {
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 10px;
      line-height: 1.4;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--ink);
    }

    .static__figcaption-credit {
      font-family: var(--font-mono);
      font-style: italic;
      font-weight: 400;
      font-size: 11px;
      line-height: 1.4;
      letter-spacing: 0;
      color: var(--ink);
    }
  </style>
</BaseLayout>
