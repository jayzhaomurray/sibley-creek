---
import SectionLayout from "../layouts/SectionLayout.astro";
import type { Plate } from "../layouts/SectionLayout.astro";
import { sections } from "../data/sections";
import panelDataFile from "../../data/site/panel_data/monetary.json";
import sectionsJson from "../../data/site/sections.json";
import { pickPanel } from "../components/charts/_shared/panelData";
import { deriveLatestReleaseLabel } from "../components/section/_shared/derivedLabels";

const section = sections.find((s) => s.slug === "monetary");
if (!section) {
  throw new Error("Monetary section not found in src/data/sections.ts");
}

// Monetary uses an override for the page-level "Latest release" stamp because
// the primary event is the rate decision (not one of the pipeline's
// monthly prints). When the override is set, compose the stamp directly;
// otherwise fall through to the standard derivation.
const latestReleaseLabel = section.latestReleaseDateOverride
  ? `${section.latestReleasePrefix ?? ""}, ${section.latestReleaseDateOverride}`
  : deriveLatestReleaseLabel(
      section.latestReleasePrefix ?? "",
      sectionsJson,
      "monetary",
    );

const panel1Data = pickPanel(panelDataFile, 1);
const panel2Data = pickPanel(panelDataFile, 2);
const panel4Data = pickPanel(panelDataFile, 4);
const panel5Data = pickPanel(panelDataFile, 5);

const plates: Plate[] = [
  {
    id: "plate-1",
    number: "01",
    indicator: "Overnight rate",
    plateIndexLabel: "Overnight rate",
    asOf: "Jul 15, 2026 (rate decision)",
    title: "Six holds in, and the Bank now calls the rate appropriate.",
    interpretationHtml:
      "The Bank held the overnight rate at 2.25% on July 15, the sixth consecutive hold since the 25 bps cut on October 29, 2025 — and retired June's “dilemma” framing, calling the rate “appropriate to sustain the economic recovery and bring inflation back to the 2% target.” " +
      "From the floor of the neutral range, the Bank still flags the same two risks — the Middle East war and US trade policy — but on the trade side, more businesses report finding ways to navigate the uncertainty.",
    callout: {
      value: "2.25%",
      unit: "BoC overnight rate target",
      delta: "Sixth consecutive hold, Jul 15 decision",
      direction: "neutral",
    },
    source: "Bank of Canada rate decision and Monetary Policy Report, latest vintage.",
    chartKey: "policy-panel-1",
    data: panel1Data,
    citations: [
      { phrase: "2.25% on July 15", source: "pipeline:boc:V39079", note: "BoC overnight target rate, July 15 2026 FAD decision, via Valet V39079." },
      { phrase: "sixth consecutive hold", source: "card:boc_fad_holds_post_oct_2025_cut", expected_count: 6, note: "Enumerated FAD holds since Oct 29, 2025 cut: Dec 10, Jan 28, Mar 18, Apr 29, Jun 10, Jul 15. Card carries authoritative list; build fails if length drifts from expected_count." },
      { phrase: "Six holds in", source: "card:boc_fad_holds_post_oct_2025_cut", expected_count: 6, note: "Title restates the enumerated hold count from the card." },
      { phrase: "appropriate to sustain the economic recovery", source: "derived", note: "Verbatim, BoC July 15 2026 rate decision press release: 'Governing Council judges the current policy rate remains appropriate to sustain the economic recovery and bring inflation back to the 2% target.' June's 'dilemma for monetary policy' framing (verbatim in Governor Macklem's June 10, 2026 press-conference opening statement, https://www.bankofcanada.ca/2026/06/opening-statement-2026-06-10/ — NOT in the June press release) does not appear in either the July press release or the July opening statement; verified by fact-check 2026-07-15. FLAG: migrate to a source card for the July 15 statement when it lands in the registry." },
      { phrase: "the Middle East war and US trade policy", source: "derived", note: "BoC July 15 2026 press release: 'There are still important risks and uncertainties related to the war in the Middle East and US trade policy.'" },
      { phrase: "finding ways to navigate", source: "derived", note: "Verbatim, BoC July 15 2026 press release: 'Although the Canada-US-Mexico Agreement is now subject to annual reviews, more businesses report they are finding ways to navigate through the uncertainty.'" },
      { phrase: "25 bps cut on October 29, 2025", source: "pipeline:boc:V39079", note: "BoC overnight target stepped from 2.50% to 2.25% at the Oct 29, 2025 FAD (daily series V39079 shows the step effective 2025-10-30); held at 2.25% through 2026-07-14 per Valet, re-verified 2026-07-15." },
      { phrase: "floor of the neutral range", source: "card:boc_mpr_neutral_range", note: "BoC stated nominal neutral range 2.25-3.25%; the 2.25% setting sits at the floor." },
    ],
  },
  {
    id: "plate-2",
    number: "02",
    indicator: "BoC and Fed policy paths over time",
    plateIndexLabel: "Policy divergence",
    asOf: "Jun 2026",
    title: "The BoC-Fed policy gap is narrowing from a generational depth.",
    interpretationHtml:
      "The BoC-Fed gap stands at -150 bps, narrowest since February 2025 and 25 bps off the -175 trough sustained from March through November 2025, when the BoC out-cut a Fed already a full point into its own easing. " +
      "One December Fed cut has done the closing work; the BoC has held since October.",
    source:
      "Bank of Canada Valet (overnight rate target, monthly); FRED DFF (fed funds effective, daily resampled to monthly last). " +
      "Canada-US 2y spread derived in chart, percentage points.",
    chartKey: "policy-panel-7",
    data: panel1Data,
    citations: [
      { phrase: "-150 bps", source: "derived", note: "BoC 2.25% - Fed upper bound 3.75% = -1.50 pp = -150 bps. Inputs: data/raw/overnight_rate_target.csv (BoC monthly) and data/raw/fed_funds.csv (Fed daily, upper bound 3.75% as of latest vintage; no FOMC move since the Dec 11, 2025 cut — confirm against backend's June refresh)." },
      { phrase: "narrowest since February 2025", source: "derived", note: "Feb 2025: BoC 3.00% - Fed 4.50% = -150 bps (last reading at or narrower than -150). Mar-Nov 2025 spread was -175 sustained; gap returned to -150 at Dec 2025 with Fed Dec 11 cut to 3.75%." },
      { phrase: "25 bps off the -175 trough", source: "derived", note: "Current spread -150 bps minus sustained 2025 trough -175 bps = 25 bps of narrowing. Sustained trough Mar-Nov 2025: BoC 2.75-2.25 minus Fed 4.50-4.00. Deepest sustained negative spread since 1996-97 (which reached -251)." },
      { phrase: "March through November 2025", source: "derived", note: "BoC monthly overnight x Fed monthly upper bound: spread held at -175 bps from end-Mar 2025 (BoC cut to 2.75) through end-Nov 2025 (before Fed Dec 11 cut)." },
      { phrase: "Fed already a full point into its own easing", source: "derived", note: "Fed cut 5.50 to 4.50 across three meetings: Sep 18 2024 (-50 bps), Nov 7 2024 (-25), Dec 18 2024 (-25). Total: 100 bps = a full percentage point, completed before the 2025 BoC cycle's deepest spreads." },
      { phrase: "One December Fed cut has done the closing work", source: "derived", note: "Fed cut from 4.00 to 3.75 on Dec 11 2025 with BoC unchanged at 2.25, narrowing the spread from -175 to -150. Only Fed cut between BoC's Oct 29 cut and the present." },
      { phrase: "BoC has held since October", source: "card:boc_fad_holds_post_oct_2025_cut", expected_count: 6, note: "Enumerated FAD holds since Oct 29, 2025 cut to 2.25%: Dec 10, Jan 28, Mar 18, Apr 29, Jun 10, Jul 15." },
    ],
  },
  {
    id: "plate-3",
    number: "03",
    indicator: "2y GoC vs overnight",
    plateIndexLabel: "Market path",
    title: "The market still isn't pricing a near-term cut.",
    interpretationHtml:
      "The 2-year Government of Canada yield closed at 2.88% on July 13, up 6 bps on the latest close, and holds roughly 60 bps above the 2.25% overnight target. " +
      "That gap leaves the market priced for the Bank to stay put — the implied path edges higher into late 2026, not lower — even as the Bank's own triggers point both ways.",
    source: "BoC Valet (rates); MPR market-implied curve, latest vintage.",
    chartKey: "policy-panel-2",
    data: panel2Data,
    citations: [
      { phrase: "2.88% on July 13", source: "pipeline:boc:yield_2yr", note: "GoC 2y benchmark yield, daily close July 13 2026, via BoC Valet." },
      { phrase: "up 6 bps", source: "pipeline:boc:yield_2yr", note: "GoC 2y benchmark yield rose from 2.82% to 2.88% on the latest close." },
      { phrase: "the implied path edges higher into late 2026", source: "derived", note: "CORRA-futures implied policy path on the June 10 2026 decision slopes up: Sep-26 ~2.36%, Dec-26 ~2.57% vs spot CORRA ~2.26% — the market-implied mean path prices a modest net tightening into late 2026, not cuts. The day's move nudged pricing ~2 bps lower at the margin. Source: MX three-month CORRA futures strip." },
      { phrase: "2.25% overnight target", source: "pipeline:boc:V39079", note: "BoC overnight target rate, current setting via Valet V39079." },
      { phrase: "roughly 60 bps", source: "derived", note: "2.88% (GoC 2y) - 2.25% (overnight) = 0.63 pp = 63 bps, rounded to roughly 60." },
    ],
  },
  {
    id: "plate-4",
    number: "04",
    indicator: "BoC asset composition",
    plateIndexLabel: "Asset composition",
    title: "Government bonds anchor the post-QT balance sheet.",
    interpretationHtml:
      "The asset side has settled into a shape defined by what's left of the pandemic-era bond-purchase programme. " +
      "Government of Canada bonds account for $146.0 billion of $220.0 billion in total assets — about 66% — easing lower as the portfolio matures while the total holds steady. " +
      "Quantitative tightening is complete; repos run in a roughly $15 to 40 billion range as the operating margin of the floor system.",
    callout: {
      value: "66%",
      unit: "GoC bonds, share of BoC assets",
      delta: "$146.0 bn of $220.0 bn total",
      direction: "neutral",
    },
    source:
      "Bank of Canada weekly statement (assets and liabilities; formerly Schedule B2).",
    chartKey: "policy-panel-4",
    data: panel4Data,
    citations: [
      { phrase: "$146.0 billion of $220.0 billion in total assets", source: "pipeline:boc:boc_goc_bonds", note: "BoC weekly statement: GoC bonds = $146.0bn; total assets = $220.0bn; latest June 3, 2026 vintage (GoC bonds stepped down ~$9bn with the June 1 maturity)." },
      { phrase: "about 66%", source: "derived", note: "146.0 / 220.0 = 66.4%, rounds to 66%." },
      { phrase: "Quantitative tightening is complete", source: "card:boc_qt_end_2025_01", note: "BoC's January 2025 statement that quantitative tightening was complete." },
      { phrase: "roughly $15 to 40 billion range", source: "pipeline:boc:boc_repos", note: "BoC repos over the past ~18 months: roughly $15bn-$40bn (near $0 in early 2025, max ~$40bn, latest ~$35bn), per weekly statement series." },
    ],
  },
  {
    id: "plate-5",
    number: "05",
    indicator: "BoC liability composition",
    plateIndexLabel: "Liability composition",
    title: "The overnight rate is now the only active policy lever.",
    interpretationHtml:
      "Banknotes carry $123.9 billion of $220.0 billion in total liabilities — about 56% — drifting up only $30 billion over six years as a passive function of currency demand. " +
      "Settlement balances sit at $64.3 billion, inside the $50 to 70 billion operating range and a small fraction of the near-$400 billion peak in early 2021. " +
      "Reverse repos are at zero — none of it is doing policy work.",
    callout: {
      value: "$64.3 bn",
      unit: "Settlement balances",
      delta: "Inside Jan-2025 $50-70 bn range",
      direction: "neutral",
    },
    source:
      "Bank of Canada weekly statement (assets and liabilities; formerly Schedule B2).",
    chartKey: "policy-panel-5",
    data: panel5Data,
    citations: [
      { phrase: "Banknotes carry $123.9 billion of $220.0 billion in total liabilities", source: "pipeline:boc:boc_banknotes", note: "BoC weekly statement: banknotes = $123.9bn; total liabilities = $220.0bn; June 3, 2026 vintage." },
      { phrase: "about 56%", source: "derived", note: "123.9 / 220.0 = 56.3%, rounds to 56%." },
      { phrase: "drifting up only $30 billion over six years", source: "pipeline:boc:boc_banknotes", note: "Banknotes ~$92bn pre-pandemic to $123.9bn now, a ~$32bn drift over six years per BoC weekly statement." },
      { phrase: "$64.3 billion", source: "pipeline:boc:boc_settlement_balances", note: "Settlement balances, latest June 3, 2026 weekly print, $64.3bn." },
      { phrase: "$50 to 70 billion operating range", source: "card:boc_floor_system_operating_range" },
      { phrase: "near-$400 billion peak in early 2021", source: "pipeline:boc:boc_settlement_balances", note: "Settlement balances peak $394.13bn on 2021-03-03 per BoC weekly statement series." },
      { phrase: "Reverse repos are at zero", source: "pipeline:boc:boc_reverse_repos", note: "BoC reverse repos = $0 across recent weekly statements." },
    ],
  },
];

const pageTitle = "Monetary Policy";
const pageDescription =
  "Canadian monetary policy chartbook: Bank of Canada overnight rate, rate path, Canada-US policy spread, asset composition, and balance sheet.";

// Lede reads the same editorial blurb the auto-blurb pipeline writes for the
// splash tile (sections.ts -> section.blurb.body). Single source of truth: a
// release-day fan-out updates one field and both surfaces refresh.
const lede = section.blurb?.body ?? "";
---
<SectionLayout
  slug="monetary"
  sectionIndex={4}
  sectionLabel="Monetary"
  headlineQuestion={section.headlineQuestion}
  lede={lede}
  latestReleaseLabel={latestReleaseLabel}
  plates={plates}
  title={pageTitle}
  description={pageDescription}
/>
