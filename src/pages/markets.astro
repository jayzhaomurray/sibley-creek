---
/*
 * Markets - Vignelli chartbook page.
 *
 * Six plates per editorial canon section 4.6:
 *   01 CAD (USDCAD, CEER, percentile classifier)
 *   02 GoC curve (2y / 5y / 10y / 30y; spread to UST)
 *   03 Credit spreads (US IG / HY OAS; Canadian blind-spot caveat)
 *   04 Energy prices (WTI, Brent, WCS, AECO)
 *   05 Bank stability (PCL, CET1 vs DSB, uninsured residential)
 *   06 Financial conditions index
 *
 * All six plates wire through chartKey to canon-compliant Vignelli
 * Tier-3 chart components in src/components/charts/markets/.
 */

import SectionLayout from "../layouts/SectionLayout.astro";
import type { Plate } from "../layouts/SectionLayout.astro";
import { sections } from "../data/sections";
import panelDataFile from "../../data/site/panel_data/markets.json";
import { pickPanel } from "../components/charts/_shared/panelData";

const section = sections.find((s) => s.slug === "markets");
if (!section) {
  throw new Error("Markets section not found in src/data/sections.ts");
}

const panel1Data = pickPanel(panelDataFile, 1);
const panel2Data = pickPanel(panelDataFile, 2);
const panel3Data = pickPanel(panelDataFile, 3);
const panel4Data = pickPanel(panelDataFile, 4);
const panel5Data = pickPanel(panelDataFile, 5);
const panel6Data = pickPanel(panelDataFile, 6);

const plates: Plate[] = [
  {
    id: "plate-1",
    number: "01",
    chartKey: "markets-panel-1",
    indicator: "USDCAD and the BoC effective rate (CEER)",
    plateIndexLabel: "CAD",
    asOf: "TK",
    title: "USDCAD at TK, near the TK percentile of the post-1990 distribution.",
    interpretationHtml:
      "USDCAD is at <strong>TK</strong> on the week. " +
      "On the post-1990 distribution, the current level sits near the TK percentile - weakened, but not at the historical stress lines (P95, P99). " +
      "The full oil-and-rate-differential fair-value model defers to v1.5 given documented coefficient instability post-2016.",
    callout: {
      value: "TK",
      unit: "USDCAD spot, TK",
      delta: "TK w/w",
      direction: "neutral",
    },
    source:
      "BoC Valet FXUSDCAD; BoC CEER; post-1990 distribution constructed from BoC daily history.",
    data: panel1Data,
  },
  {
    id: "plate-2",
    number: "02",
    chartKey: "markets-panel-2",
    indicator: "GoC curve: 2y / 5y / 10y / 30y",
    plateIndexLabel: "GoC curve",
    asOf: "TK",
    title: "GoC 10y at TK, spread to UST 10y still negative.",
    interpretationHtml:
      "The GoC 10-year is at <strong>TK</strong>; the spread to the US 10-year remains negative on the order of TK, consistent with the divergent policy paths. " +
      "Term premium at the 10y has bounced from the 2024 lows but remains compressed. " +
      "We cite the Bank's published Canadian term-premium series directly; own ACM-style decomposition defers.",
    source:
      "BoC Valet (GoC curve); FRED DGS10 (US 10y); BoC Financial Stability Indicators (term premium).",
    data: panel2Data,
  },
  {
    id: "plate-3",
    number: "03",
    chartKey: "markets-panel-3",
    indicator: "Credit spreads: US IG / HY OAS",
    plateIndexLabel: "Credit spreads",
    asOf: "TK",
    title: "US IG and HY spreads compressed near cycle tights; Canadian-spread caveat preserved.",
    interpretation:
      "US investment-grade and high-yield OAS sit at the tighter end of their post-2018 range - the risk-appetite proxy is in benign territory. " +
      "Canadian senior-unsecured-vs-GoC and Canadian IG / HY proxies require FSR scraping or own construction and defer to v1.5. " +
      "v1 ships with the US comparator and an explicit Canadian-spread blind-spot caveat.",
    source: "FRED BAMLC0A0CM (IG OAS), BAMLH0A0HYM2 (HY OAS).",
    data: panel3Data,
  },
  {
    id: "plate-4",
    number: "04",
    chartKey: "markets-panel-4",
    indicator: "Energy prices: WTI, Brent, WCS, AECO",
    plateIndexLabel: "Energy",
    asOf: "TK (daily) / TK (WCS monthly)",
    title: "WTI at TK; WCS differential at typical monthly cadence.",
    interpretationHtml:
      "WTI is at <strong>TK</strong> on the week, at <strong>TK</strong>; Brent has moved by a similar magnitude. " +
      "WCS is shown at monthly cadence with the caveat against daily-comparison differential preserved. " +
      "AECO gas is reported on a weekly bid-week summary where the cadence is available; otherwise defers.",
    source: "EIA WTI / Brent; CER WCS monthly; AECO bid-week from NRCan.",
    data: panel4Data,
  },
  {
    id: "plate-5",
    number: "05",
    chartKey: "markets-panel-5",
    indicator: "Bank stability: PCL, CET1 vs DSB, uninsured residential",
    plateIndexLabel: "Bank stability",
    asOf: "TK (earnings) / TK (OSFI)",
    title: "CET1 ratios remain above the DSB buffer at TK; PCL builds modestly elevated.",
    interpretationHtml:
      "Big-Six provisions for credit losses (PCL) builds remain modestly elevated relative to pre-2023 baselines but have not accelerated this quarter. " +
      "CET1 ratios across the Big-Six cluster above the OSFI Domestic Stability Buffer at <strong>TK</strong>. " +
      "Uninsured residential exposure from OSFI Bank Financial Data is shown on a semi-annual scrape.",
    source:
      "Big-Six earnings releases (latest quarter); OSFI DSB and Bank Financial Data M4.",
    data: panel5Data,
  },
  {
    id: "plate-6",
    number: "06",
    chartKey: "markets-panel-6",
    indicator: "Financial conditions index",
    plateIndexLabel: "FCI",
    asOf: "TK",
    title: "Financial conditions sit near the long-run easy end of the distribution.",
    interpretation:
      "If the Bank's published FCI is available via Valet (key to be probed) we anchor on it; if not, v1 ships with the Chicago Fed NFCI as a citable US comparator " +
      "plus prose-level Canadian commentary. The signal across either anchor: conditions remain on the easier side of the long-run distribution. " +
      "Own Canadian FCI composite construction defers to v1.5.",
    source: "Bank of Canada FSI page; Chicago Fed NFCI (US comparator).",
    data: panel6Data,
  },
];

const pageTitle = "Markets";
const pageDescription =
  "Markets chartbook: CAD, GoC curve, credit spreads, energy prices, bank stability, and the financial conditions index. " +
  "Sources: BoC, FRED, OSFI, EIA, CER.";

const lede =
  "External winds and the financial-system thermometer: the loonie, the GoC curve, " +
  "credit spreads, energy prices, bank-stability metrics, and the financial conditions index.";
---
<SectionLayout
  slug="markets"
  sectionIndex={5}
  sectionLabel="Markets"
  headlineQuestion={section.headlineQuestion}
  lede={lede}
  latestReleaseLabel="Daily close, May 8, 2026"
  plates={plates}
  title={pageTitle}
  description={pageDescription}
/>
