---
/*
 * Markets - basics-layer section page (placeholder).
 *
 * Six panels per editorial canon section 4.6:
 *   1. CAD
 *   2. GoC curve
 *   3. Credit spreads
 *   4. Energy prices
 *   5. Bank stability
 *   6. Financial conditions index
 *
 * Why this file is sparse:
 *   Navigation-skeleton placeholder. Writer + style-editor own panel
 *   titles, decks, callouts, and source citations. Backend pipeline owns
 *   vintage stamps and numeric values. Chart-builder hydrates chart slots.
 *   Frontend reserves panel order, eyebrows, anchors, and the page shell.
 *
 * Mirrors src/pages/gdp.astro structure; see that file for the worked
 * example with finished placeholder copy.
 */

import SectionLayout from "../layouts/SectionLayout.astro";
import type { Panel } from "../layouts/SectionLayout.astro";
import { sections } from "../data/sections";

const section = sections.find((s) => s.slug === "markets");
if (!section) {
  throw new Error("Markets section not found in src/data/sections.ts");
}

const pageAsOf = {
  label: "Placeholder release",
  releaseDate: "TBD",
};

const placeholderText = "Placeholder. Writer to populate.";
const placeholderMethodology = "Placeholder. Methodology to be documented by editorial.";
const placeholderSource = "Source citation TBD.";
const placeholderVintage = { releaseDate: "TBD" };

const panels: Panel[] = [
  {
    id: "panel-1",
    eyebrow: "CAD",
    title: placeholderText,
    deck: placeholderText,
    vintage: placeholderVintage,
    editorialStatus: placeholderText,
    source: placeholderSource,
    methodology: { body: placeholderMethodology },
  },
  {
    id: "panel-2",
    eyebrow: "GoC curve",
    title: placeholderText,
    deck: placeholderText,
    vintage: placeholderVintage,
    editorialStatus: placeholderText,
    source: placeholderSource,
    methodology: { body: placeholderMethodology },
  },
  {
    id: "panel-3",
    eyebrow: "Credit spreads",
    title: placeholderText,
    deck: placeholderText,
    vintage: placeholderVintage,
    editorialStatus: placeholderText,
    source: placeholderSource,
    methodology: { body: placeholderMethodology },
  },
  {
    id: "panel-4",
    eyebrow: "Energy prices",
    title: placeholderText,
    deck: placeholderText,
    vintage: placeholderVintage,
    editorialStatus: placeholderText,
    source: placeholderSource,
    methodology: { body: placeholderMethodology },
  },
  {
    id: "panel-5",
    eyebrow: "Bank stability",
    title: placeholderText,
    deck: placeholderText,
    vintage: placeholderVintage,
    editorialStatus: placeholderText,
    source: placeholderSource,
    methodology: { body: placeholderMethodology },
  },
  {
    id: "panel-6",
    eyebrow: "Financial conditions index",
    title: placeholderText,
    deck: placeholderText,
    vintage: placeholderVintage,
    editorialStatus: placeholderText,
    source: placeholderSource,
    methodology: { body: placeholderMethodology },
  },
];

const pageTitle = "Markets";
const pageDescription = `${section.headlineQuestion} The macro-research-department Markets section: CAD, GoC curve, credit spreads, energy prices, bank stability, and financial conditions.`;
---
<SectionLayout
  slug="markets"
  sectionIndex={6}
  sectionName="Markets"
  sectionLabel={section.label}
  accentVar={section.accentVar}
  headlineQuestion={section.headlineQuestion}
  pageAsOf={pageAsOf}
  panels={panels}
  title={pageTitle}
  description={pageDescription}
/>
