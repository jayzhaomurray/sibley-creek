---
import SectionLayout from "../layouts/SectionLayout.astro";
import type { Plate } from "../layouts/SectionLayout.astro";
import { sections } from "../data/sections";
import panelDataFile from "../../data/site/panel_data/markets.json";
import sectionsJson from "../../data/site/sections.json";
import { pickPanel } from "../components/charts/_shared/panelData";
import { deriveLatestReleaseLabel } from "../components/section/_shared/derivedLabels";

const section = sections.find((s) => s.slug === "markets");
if (!section) {
  throw new Error("Markets section not found in src/data/sections.ts");
}

const latestReleaseLabel = deriveLatestReleaseLabel(
  section.latestReleasePrefix ?? "",
  sectionsJson,
  "markets",
);

const panel1Data = pickPanel(panelDataFile, 1);
const panel2Data = pickPanel(panelDataFile, 2);
const panel3Data = pickPanel(panelDataFile, 3);
const panel4Data = pickPanel(panelDataFile, 4);
const panel5Data = pickPanel(panelDataFile, 5);
const panel6Data = pickPanel(panelDataFile, 6);
const panel7Data = pickPanel(panelDataFile, 7);
const panel8Data = pickPanel(panelDataFile, 8);

const plates: Plate[] = [
  {
    id: "plate-1",
    number: "01",
    chartKey: "markets-panel-1",
    indicator: "USDCAD spot",
    plateIndexLabel: "CAD",
    title: "The loonie has settled into a range well below last fall's stress reach.",
    interpretationHtml:
      "USDCAD closed the week at 1.3686, weaker by about a cent from 1.3576 on May 1 as the early-May CAD rally reversed. " +
      "The pair has spent the past month inside a 1.36 to 1.38 band, well below the 1.42 stress reach of late 2025. " +
      "The BoC effective exchange rate (CEER) overlay is not yet wired in the data pipeline.",
    callout: {
      value: "1.3686",
      unitPrefix: "USDCAD spot",
      delta: "+0.0110 w/w",
      direction: "neutral",
    },
    source:
      "Bank of Canada Valet (FXUSDCAD).",
    data: panel1Data,
    citations: [
      { phrase: "1.42 stress reach of late 2025", source: "pipeline:boc:fxusdcad", note: "USDCAD daily high reached ~1.42 in late 2025; year token covered here." },
    ],
  },
  {
    id: "plate-2",
    number: "02",
    chartKey: "markets-panel-2",
    indicator: "S&P/TSX Composite",
    plateIndexLabel: "Equities",
    title: "The TSX is holding above 34,000.",
    interpretationHtml:
      "The S&amp;P/TSX Composite closed at 33,994.87 on May 12, off slightly from 34,077.76 on May 8 and 34,138.90 in early March. " +
      "The index has spent the past two months in a narrow band around the 34,000 line.",
    callout: {
      value: "33,995",
      unitPrefix: "TSX Composite, May 12",
      delta: "-83 d/d",
      direction: "neutral",
    },
    source: "Yahoo Finance (^GSPTSE) via Sibley Creek pipeline.",
    data: panel2Data,
    citations: [
      { phrase: "33,994.87 on May 12", source: "pipeline:yahoo:tsx_composite", note: "S&P/TSX Composite daily close, May 12, 2026, via Yahoo Finance ^GSPTSE." },
      { phrase: "34,077.76 on May 8", source: "pipeline:yahoo:tsx_composite", note: "S&P/TSX Composite daily close, May 8, 2026." },
      { phrase: "34,138.90 in early March", source: "pipeline:yahoo:tsx_composite", note: "S&P/TSX Composite daily close, early March 2026 (March 1 reading)." },
    ],
  },
  {
    id: "plate-3",
    number: "03",
    chartKey: "markets-panel-3",
    indicator: "GoC yield curve",
    plateIndexLabel: "GoC curve",
    title: "The front end has repriced on firmer inflation while the long end stayed anchored.",
    interpretationHtml:
      "The GoC 10y sits at 3.53%, with the 2y at 2.94%, the 5y at 3.18%, and the 30y at 3.90%. " +
      "The 2s10s spread of 59 bps marks the steepest reading in months, driven by a 12 bps lift at the 2y over the past two weeks as front-end repricing absorbed firmer near-term inflation prints. " +
      "The long end held steady through the same window, consistent with anchored term premium.",
    callout: {
      value: "3.53%",
      unitPrefix: "GoC 10y",
      delta: "+0.07pp w/w",
      direction: "neutral",
    },
    source:
      "Bank of Canada Valet (BD.CDN.2YR / 5YR / 10YR / LONG.DQ.YLD).",
    data: panel3Data,
    citations: [
      { phrase: "GoC 10y sits at 3.53%", source: "pipeline:boc:yield_10yr", note: "GoC 10y benchmark yield, latest daily close." },
      { phrase: "2y at 2.94%", source: "pipeline:boc:yield_2yr", note: "GoC 2y benchmark yield, latest daily close." },
      { phrase: "5y at 3.18%", source: "pipeline:boc:yield_5yr", note: "GoC 5y benchmark yield, latest daily close." },
      { phrase: "30y at 3.90%", source: "pipeline:boc:yield_30yr", note: "GoC long (~30y) benchmark yield, latest daily close." },
      { phrase: "2s10s spread of 59 bps", source: "derived", note: "10y (3.53%) - 2y (2.94%) = 59 bps." },
      { phrase: "12 bps lift at the 2y over the past two weeks", source: "pipeline:boc:yield_2yr", note: "Change in GoC 2y yield over the trailing ~2-week window." },
    ],
  },
  {
    id: "plate-4",
    number: "04",
    chartKey: "markets-panel-4",
    indicator: "Canada 2y minus US 2y",
    plateIndexLabel: "GoC-UST 2y spread",
    title: "The cross-border spread is deep but no longer the binding constraint on the BoC.",
    interpretationHtml:
      "GoC 2y at 2.94% against UST 2y at 3.92% leaves the Canada-US 2y spread at minus 98 bps. " +
      "On daily data since 2001, that reading sits at the 5th percentile of the distribution -- deep, but roughly 70 bps off the all-time minus 170 bps trough reached on February 3, 2025. " +
      "USDCAD has stayed inside a 1.36 to 1.39 range through the spring, which is why the FX channel is not currently the binding constraint on the Bank's hold.",
    callout: {
      value: "-98 bps",
      unit: "Canada 2y minus US 2y",
      delta: "5th percentile, post-2001",
      direction: "neutral",
    },
    source: "BoC Valet (Canada 2y); FRED DGS2 (US 2y); distribution constructed.",
    data: panel4Data,
    citations: [
      { phrase: "GoC 2y at 2.94%", source: "pipeline:boc:yield_2yr", note: "GoC 2y benchmark yield, latest daily close, via BoC Valet." },
      { phrase: "UST 2y at 3.92%", source: "pipeline:fred:DGS2", note: "US 2y Treasury constant-maturity yield, latest daily close, FRED DGS2." },
      { phrase: "minus 98 bps", source: "derived", note: "2.94% (GoC 2y) - 3.92% (UST 2y) = -0.98 pp = -98 bps." },
      { phrase: "daily data since 2001", source: "pipeline:fred:DGS2", note: "FRED DGS2 history begins June 1976; Canada 2y daily history via BoC Valet covers post-2001 window used for the distribution." },
      { phrase: "5th percentile of the distribution", source: "derived", note: "Verified 2026-05-13 against raw CSVs (data/raw/yield_2yr.csv + data/raw/us_2yr.csv): 6,219 daily observations since 2001-01-02; -98 bps sits at the 5.07th percentile. Median spread over the period = +11 bps. 5th-percentile threshold = -98 bps exactly." },
      { phrase: "70 bps off the all-time minus 170 bps trough reached on February 3, 2025", source: "derived", note: "Distribution minimum reached -170 bps on Feb 3, 2025; current -98 bps is ~72 bps off that floor. Source: pipeline yield_2yr and FRED DGS2." },
      { phrase: "1.36 to 1.39 range", source: "pipeline:boc:fxusdcad", note: "USDCAD daily close range across spring 2026 per BoC Valet FXUSDCAD; series traded 1.357-1.395 across March-May 2026, May 8 close 1.369." },
    ],
  },
  {
    id: "plate-5",
    number: "05",
    chartKey: "markets-panel-5",
    indicator: "Canadian corporate credit spreads",
    plateIndexLabel: "Credit spreads",
    asOf: "May 7, 2026",
    title: "Canadian investment-grade and high-yield spread series pending, with GoC 10y shown as the rate benchmark.",
    interpretationHtml:
      "Canadian investment-grade and high-yield option-adjusted spread series are not yet wired; the GoC 10y benchmark anchors the chart at 3.53%. " +
      "Spread data is the read that anchors this plate and will be added once the corporate-index feed is in place.",
    source: "Bank of Canada Valet (BD.CDN.10YR.DQ.YLD).",
    data: panel5Data,
    citations: [
      { phrase: "GoC 10y benchmark anchors the chart at 3.53%", source: "pipeline:boc:yield_10yr", note: "GoC 10y benchmark yield, latest daily close." },
    ],
  },
  {
    id: "plate-6",
    number: "06",
    chartKey: "markets-panel-6",
    indicator: "WTI, Brent, and WCS oil prices",
    plateIndexLabel: "Energy",
    asOf: "May 4, 2026 (WTI, Brent); March 2026 (WCS)",
    title: "Crude has broken higher and the Canadian heavy differential has compressed sharply.",
    interpretationHtml:
      "WTI closed at US$109.76 on May 4, up nearly US$10 from US$99.89 a week earlier, with Brent at US$104.21 (May 1) sitting roughly five dollars below WTI. " +
      "WCS averaged US$75.85 in March, well above the US$50 range that held through late 2025 and a sharply narrower differential to WTI than the typical post-2018 discount. " +
      "AECO gas is not in the current data feed.",
    callout: {
      value: "US$109.76",
      unitPrefix: "WTI spot",
      delta: "+US$9.87 w/w",
      direction: "neutral",
    },
    source:
      "FRED (DCOILWTICO, DCOILBRENTEU); Government of Alberta Economic Dashboard (WCS monthly).",
    data: panel6Data,
    citations: [
      { phrase: "WTI closed at US$109.76 on May 4", source: "pipeline:fred:DCOILWTICO", note: "WTI spot, May 4, 2026 daily close." },
      { phrase: "up nearly US$10", source: "derived", note: "$109.76 - $99.89 = $9.87, rounds to ~$10." },
      { phrase: "from US$99.89 a week earlier", source: "pipeline:fred:DCOILWTICO", note: "WTI spot, ~one week before May 4, 2026." },
      { phrase: "Brent at US$104.21 (May 1)", source: "pipeline:fred:DCOILBRENTEU", note: "Brent spot, May 1, 2026 daily close per FRED DCOILBRENTEU." },
      { phrase: "WCS averaged US$75.85 in March", source: "pipeline:gov_ab:wcs", note: "Western Canadian Select monthly average, March 2026, Government of Alberta Economic Dashboard." },
      { phrase: "US$50 range that held through late 2025", source: "pipeline:gov_ab:wcs", note: "WCS monthly averages held in the ~US$50 range through late 2025; year token covered here." },
      { phrase: "typical post-2018 discount", source: "pipeline:gov_ab:wcs", note: "Historical WCS-WTI differential context; post-2018 anchor reflects the structural widening era following the Alberta production curtailment regime." },
    ],
  },
  {
    id: "plate-7",
    number: "07",
    chartKey: "markets-panel-7",
    indicator: "BoC settlement balances",
    plateIndexLabel: "Bank stability",
    asOf: "May 6, 2026",
    title: "Big-Six PCL and common-equity tier-1 ratio series pending, with settlement balances at $63.9 billion.",
    interpretationHtml:
      "Bank-level provisions for credit losses and common-equity tier-1 ratios from the latest earnings round are not yet wired; settlement balances at the Bank of Canada anchor the chart at $63.9 billion on May 6, inside the $60 to $80 billion band that has held since late 2025. " +
      "PCL builds and CET1 versus the OSFI Domestic Stability Buffer are the reads that anchor this plate and will be added once the bank-disclosure feed is in place.",
    callout: {
      value: "$63.9 billion",
      unit: "Settlement balances, May 6",
      delta: "-$7.6 billion w/w",
      direction: "neutral",
    },
    source: "Bank of Canada Valet (V36636).",
    data: panel7Data,
    citations: [
      { phrase: "settlement balances at the Bank of Canada anchor the chart at $63.9 billion on May 6", source: "pipeline:boc:boc_settlement_balances", note: "BoC settlement balances (Valet V36636), daily, May 6, 2026." },
      { phrase: "$60 to $80 billion band that has held since late 2025", source: "pipeline:boc:boc_settlement_balances", note: "BoC settlement balances daily series has held in a ~$60-80 bn band since late 2025; year token covered here." },
    ],
  },
  {
    id: "plate-8",
    number: "08",
    chartKey: "markets-panel-8",
    indicator: "Financial conditions",
    plateIndexLabel: "FCI",
    asOf: "May 7, 2026",
    title: "Standardized financial conditions series pending, with GoC 10y and USDCAD shown as rate and FX inputs.",
    interpretationHtml:
      "A standardized financial conditions index for Canada is not yet wired; the GoC 10y at 3.53% and USDCAD at 1.3686 are shown as the rate and FX components that any composite would draw on. " +
      "A financial conditions composite is the read that anchors this plate and will be added once the index feed is in place.",
    source:
      "Bank of Canada Valet (BD.CDN.10YR.DQ.YLD, FXUSDCAD).",
    data: panel8Data,
    citations: [
      { phrase: "GoC 10y at 3.53%", source: "pipeline:boc:yield_10yr", note: "GoC 10y benchmark yield, latest daily close." },
      { phrase: "USDCAD at 1.3686", source: "pipeline:boc:fxusdcad", note: "USDCAD spot, latest daily close." },
    ],
  },
];

const pageTitle = "Markets";
const pageDescription =
  "Markets chartbook: CAD, GoC curve, credit spreads, energy prices, bank stability, and the financial conditions index. " +
  "Sources: BoC, FRED, OSFI, EIA, CER.";

// Lede reads the same editorial blurb the auto-blurb pipeline writes for the
// splash tile (sections.ts -> section.blurb.body). Single source of truth: a
// release-day fan-out updates one field and both surfaces refresh.
const lede = section.blurb?.body ?? "";
---
<SectionLayout
  slug="markets"
  sectionIndex={7}
  sectionLabel="Markets"
  headlineQuestion={section.headlineQuestion}
  lede={lede}
  latestReleaseLabel={latestReleaseLabel}
  plates={plates}
  title={pageTitle}
  description={pageDescription}
/>
