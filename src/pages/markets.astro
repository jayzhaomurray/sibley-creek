---
import SectionLayout from "../layouts/SectionLayout.astro";
import type { Plate } from "../layouts/SectionLayout.astro";
import { sections } from "../data/sections";
import panelDataFile from "../../data/site/panel_data/markets.json";
import sectionsJson from "../../data/site/sections.json";
import { pickPanel } from "../components/charts/_shared/panelData";
import { deriveLatestReleaseLabel } from "../components/section/_shared/derivedLabels";

const section = sections.find((s) => s.slug === "markets");
if (!section) {
  throw new Error("Markets section not found in src/data/sections.ts");
}

const latestReleaseLabel = deriveLatestReleaseLabel(
  section.latestReleasePrefix ?? "",
  sectionsJson,
  "markets",
);

const panel1Data = pickPanel(panelDataFile, 1);
const panel2Data = pickPanel(panelDataFile, 2);
const panel3Data = pickPanel(panelDataFile, 3);
const panel6Data = pickPanel(panelDataFile, 6);

const plates: Plate[] = [
  {
    id: "plate-1",
    number: "01",
    chartKey: "markets-panel-6",
    indicator: "WTI oil price",
    plateIndexLabel: "Energy",
    asOf: "May 13, 2026 (WTI); March 2026 (WCS)",
    title: "Oil prices are still over $100 per barrel, even with the ceasefire.",
    interpretationHtml:
      "WTI closed at US$101.12 on May 13, off a US$109.76 peak on May 4. WCS averaged US$75.85 in March. " +
      "Crude has stayed above US$100 since the war in Iran pushed prices up earlier this spring, and the ceasefire has unwound part of the move but not all of it.",
    callout: {
      value: "US$101.12",
      unitPrefix: "WTI spot",
      delta: "May 13 close",
      direction: "neutral",
    },
    source:
      "FRED (DCOILWTICO); Government of Alberta Economic Dashboard (WCS monthly).",
    data: panel6Data,
    citations: [
      { phrase: "WTI closed at US$101.12 on May 13", source: "pipeline:fred:DCOILWTICO", note: "WTI spot, May 13, 2026 daily close." },
      { phrase: "off a US$109.76 peak on May 4", source: "pipeline:fred:DCOILWTICO", note: "WTI spot, May 4, 2026 daily close — the early-May high." },
      { phrase: "WCS averaged US$75.85 in March", source: "pipeline:gov_ab:wcs", note: "Western Canadian Select monthly average, March 2026, Government of Alberta Economic Dashboard." },
      { phrase: "Crude has stayed above US$100", source: "pipeline:fred:DCOILWTICO", note: "WTI daily closes have remained above US$100 since the late-April / early-May spike (May 4 peak: $109.76; May 13: $101.12)." },
      { phrase: "the war in Iran pushed prices up earlier this spring", source: "derived", note: "Iran-related Middle East conflict drove WTI and Brent higher through April-May 2026. Geopolitical context referenced in BoC April 2026 MPR (conditional on Middle East outcome) and CSCE Q1 2026 supplement (Middle East war survey window March 26 - April 2, 2026)." },
      { phrase: "the ceasefire has unwound part of the move but not all of it", source: "derived", note: "WTI fell from May 4 peak of $109.76 to $101.12 by May 13 — a partial retracement but still well above the pre-spike $90s range." },
    ],
  },
  {
    id: "plate-2",
    number: "02",
    chartKey: "markets-panel-1",
    indicator: "USDCAD spot",
    plateIndexLabel: "CAD",
    title: "The loonie has settled into a range well below last fall's stress reach.",
    interpretationHtml:
      "USDCAD closed the week at 1.3686, weaker by about a cent from 1.3576 on May 1. " +
      "The pair has spent the past month inside a 1.36 to 1.38 band, well below the 1.42 stress reach of late 2025.",
    callout: {
      value: "1.3686",
      unitPrefix: "USDCAD spot",
      delta: "+0.0110 w/w",
      direction: "neutral",
    },
    source:
      "Bank of Canada Valet (FXUSDCAD).",
    data: panel1Data,
    citations: [
      { phrase: "1.42 stress reach of late 2025", source: "pipeline:boc:fxusdcad", note: "USDCAD daily high reached ~1.42 in late 2025; year token covered here." },
    ],
  },
  {
    id: "plate-3",
    number: "03",
    chartKey: "markets-panel-2",
    indicator: "S&P/TSX Composite",
    plateIndexLabel: "Equities",
    title: "The TSX is holding above 34,000.",
    interpretationHtml:
      "The S&amp;P/TSX Composite closed at 33,994.87 on May 12, off slightly from 34,077.76 on May 8 and 34,138.90 in early March. " +
      "The index has spent the past two months in a narrow band around the 34,000 line.",
    callout: {
      value: "33,995",
      unitPrefix: "TSX Composite, May 12",
      delta: "-83 d/d",
      direction: "neutral",
    },
    source: "Yahoo Finance (^GSPTSE) via Sibley Creek pipeline.",
    data: panel2Data,
    citations: [
      { phrase: "33,994.87 on May 12", source: "pipeline:yahoo:tsx_composite", note: "S&P/TSX Composite daily close, May 12, 2026, via Yahoo Finance ^GSPTSE." },
      { phrase: "34,077.76 on May 8", source: "pipeline:yahoo:tsx_composite", note: "S&P/TSX Composite daily close, May 8, 2026." },
      { phrase: "34,138.90 in early March", source: "pipeline:yahoo:tsx_composite", note: "S&P/TSX Composite daily close, early March 2026 (March 1 reading)." },
    ],
  },
  {
    id: "plate-4",
    number: "04",
    chartKey: "markets-panel-3",
    indicator: "GoC yield curve",
    plateIndexLabel: "GoC curve",
    title: "The curve has steepened from the front end.",
    interpretationHtml:
      "The GoC 10y sits at 3.53%, with the 2y at 2.94%, the 5y at 3.18%, and the 30y at 3.90%. " +
      "The 2s10s spread of 59 bps marks the steepest reading in months, with the 2y up roughly 10 bps over the past two weeks while the long end held steady.",
    callout: {
      value: "3.53%",
      unitPrefix: "GoC 10y",
      delta: "+0.07pp w/w",
      direction: "neutral",
    },
    source:
      "Bank of Canada Valet (BD.CDN.2YR / 5YR / 10YR / LONG.DQ.YLD).",
    data: panel3Data,
    citations: [
      { phrase: "GoC 10y sits at 3.53%", source: "pipeline:boc:yield_10yr", note: "GoC 10y benchmark yield, latest daily close." },
      { phrase: "2y at 2.94%", source: "pipeline:boc:yield_2yr", note: "GoC 2y benchmark yield, latest daily close." },
      { phrase: "5y at 3.18%", source: "pipeline:boc:yield_5yr", note: "GoC 5y benchmark yield, latest daily close." },
      { phrase: "30y at 3.90%", source: "pipeline:boc:yield_30yr", note: "GoC long (~30y) benchmark yield, latest daily close." },
      { phrase: "2s10s spread of 59 bps", source: "derived", note: "10y (3.53%) - 2y (2.94%) = 59 bps." },
      { phrase: "the 2y up roughly 10 bps over the past two weeks", source: "pipeline:boc:yield_2yr", note: "Change in GoC 2y yield over the trailing ~2-week window; ~10 bps lift." },
    ],
  },
];

const pageTitle = "Markets";
const pageDescription =
  "Markets chartbook: CAD, GoC curve, credit spreads, energy prices, bank stability, and the financial conditions index. " +
  "Sources: BoC, FRED, OSFI, EIA, CER.";

// Lede reads the same editorial blurb the auto-blurb pipeline writes for the
// splash tile (sections.ts -> section.blurb.body). Single source of truth: a
// release-day fan-out updates one field and both surfaces refresh.
const lede = section.blurb?.body ?? "";
---
<SectionLayout
  slug="markets"
  sectionIndex={7}
  sectionLabel="Markets"
  headlineQuestion={section.headlineQuestion}
  lede={lede}
  latestReleaseLabel={latestReleaseLabel}
  plates={plates}
  title={pageTitle}
  description={pageDescription}
/>
