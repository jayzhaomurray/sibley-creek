---
import SectionLayout from "../layouts/SectionLayout.astro";
import type { Plate } from "../layouts/SectionLayout.astro";
import { sections } from "../data/sections";
import panelDataFile from "../../data/site/panel_data/markets.json";
import sectionsJson from "../../data/site/sections.json";
import { pickPanel, type PanelData } from "../components/charts/_shared/panelData";
import { deriveLatestReleaseLabel, formatAsOf } from "../components/section/_shared/derivedLabels";
import { renderSectionProse } from "../lib/prose";

// Mechanical prose: every reader-facing sentence on this page is rendered
// at build time from editorial/prose_templates/markets.yaml against live
// panel data (src/lib/prose). No hand-authored copy below. A template or
// render fault throws here and fails the build — a broken template must
// never ship as stale or empty text.
const prose = renderSectionProse("markets");

// The renderer emits literal text (raw "&", real en-dashes). Downstream,
// ChartbookUnit injects `interpretationHtml` via set:html WITHOUT escaping
// (it treats the field as author-supplied HTML), so escape HTML-significant
// characters at this boundary: "S&P/TSX" -> "S&amp;P/TSX". Titles, callout
// fields, and the lede render as text nodes (escaped by the framework or
// the component) and must NOT be double-escaped here.
function escapeProseHtml(s: string): string {
  return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
}

const section = sections.find((s) => s.slug === "markets");
if (!section) {
  throw new Error("Markets section not found in src/data/sections.ts");
}

const defaultLatestReleaseLabel = deriveLatestReleaseLabel(
  section.latestReleasePrefix ?? "",
  sectionsJson,
  "markets",
);

const panel1Data = pickPanel(panelDataFile, 1);
const panel2Data = pickPanel(panelDataFile, 2);
const panel3Data = pickPanel(panelDataFile, 3);
const panel6Data = pickPanel(panelDataFile, 6);

function latestDisplayedDailyDate(panels: Array<PanelData | null>): string | null {
  const picks: Array<{ iso: string; frequency: string }> = [];
  for (const panel of panels) {
    for (const series of [panel?.primary, panel?.secondary, panel?.tertiary]) {
      if (!series?.asOfISO) continue;
      const frequency = (series.frequency ?? "").toLowerCase();
      if (frequency !== "daily" && frequency !== "weekly") continue;
      picks.push({ iso: series.asOfISO, frequency });
    }
  }
  if (picks.length === 0) return null;
  const latest = picks.reduce((best, item) => item.iso > best.iso ? item : best);
  return formatAsOf(latest.iso, latest.frequency);
}

const latestDisplayedDate = latestDisplayedDailyDate([
  panel6Data,
  panel1Data,
  panel2Data,
  panel3Data,
]);

const latestReleaseLabel = latestDisplayedDate
  ? `${section.latestReleasePrefix ?? "Daily close"}, ${latestDisplayedDate}`
  : defaultLatestReleaseLabel;

// Citations are SLOT-BOUND (writing-style.md §4.1e): one entry per
// panel-data slot the plate draws on. Mechanically-rendered prose cannot
// contain an unverified figure — every number is slot-interpolated by the
// renderer — so the citation binds the slot itself and auto-tracks the
// live value through every refresh. No phrase-bound or `derived` entries.
const plates: Plate[] = [
  {
    id: "plate-1",
    number: "01",
    chartKey: "markets-panel-6",
    indicator: "WTI oil price",
    plateIndexLabel: "Energy",
    title: prose.surfaces["plate-energy-title"].text,
    interpretationHtml: escapeProseHtml(prose.surfaces["plate-energy-prose"].text),
    callout: {
      value: prose.surfaces["plate-energy-callout-value"].text,
      unitPrefix: prose.surfaces["plate-energy-callout-prefix"].text,
      delta: prose.surfaces["plate-energy-callout-delta"].text,
      direction: "neutral",
    },
    source:
      "Yahoo Finance (CL=F) via Sibley Creek pipeline.",
    data: panel6Data,
    citations: [
      { slot: "wti", at: "latest", value_format: "{0.00}", context: "", source: "pipeline:yahoo:wti", note: "WTI front-month (CL=F) daily close, latest observation. All WTI figures in this plate render from this series." },
      { slot: "wti", at: "T-5", value_format: "{0.00}", context: "", source: "pipeline:yahoo:wti", note: "WTI front-month close five trading days back — the one-week comparator in the plate prose." },
    ],
  },
  {
    id: "plate-2",
    number: "02",
    chartKey: "markets-panel-1",
    indicator: "USDCAD spot",
    plateIndexLabel: "CAD",
    title: prose.surfaces["plate-fx-title"].text,
    interpretationHtml: escapeProseHtml(prose.surfaces["plate-fx-prose"].text),
    callout: {
      value: prose.surfaces["plate-fx-callout-value"].text,
      unitPrefix: prose.surfaces["plate-fx-callout-prefix"].text,
      delta: prose.surfaces["plate-fx-callout-delta"].text,
      direction: "neutral",
    },
    source:
      "Bank of Canada Valet (FXUSDCAD).",
    data: panel1Data,
    citations: [
      { slot: "fxusdcad", at: "latest", value_format: "{0.0000}", context: "", source: "pipeline:boc:fxusdcad", note: "USDCAD daily close (BoC Valet FXUSDCAD), latest observation. All USDCAD figures in this plate render from this series." },
      { slot: "fxusdcad", at: "T-21", value_format: "{0.0000}", context: "", source: "pipeline:boc:fxusdcad", note: "USDCAD close 21 trading days back — the one-month comparator in the plate prose." },
    ],
  },
  {
    id: "plate-3",
    number: "03",
    chartKey: "markets-panel-2",
    indicator: "S&P/TSX Composite",
    plateIndexLabel: "Equities",
    title: prose.surfaces["plate-tsx-title"].text,
    interpretationHtml: escapeProseHtml(prose.surfaces["plate-tsx-prose"].text),
    callout: {
      value: prose.surfaces["plate-tsx-callout-value"].text,
      unitPrefix: prose.surfaces["plate-tsx-callout-prefix"].text,
      delta: prose.surfaces["plate-tsx-callout-delta"].text,
      direction: "neutral",
    },
    source: "Yahoo Finance (^GSPTSE) via Sibley Creek pipeline.",
    data: panel2Data,
    citations: [
      { slot: "tsx_composite", at: "latest", value_format: "{0.00,}", context: "", source: "pipeline:yahoo:tsx_composite", note: "S&P/TSX Composite daily close (Yahoo ^GSPTSE), latest observation. All TSX figures in this plate render from this series." },
      { slot: "tsx_composite", at: "T-5", value_format: "{0.00,}", context: "", source: "pipeline:yahoo:tsx_composite", note: "S&P/TSX Composite close five trading days back — the one-week comparator in the plate prose." },
    ],
  },
  {
    id: "plate-4",
    number: "04",
    chartKey: "markets-panel-3",
    indicator: "GoC yield curve",
    plateIndexLabel: "GoC curve",
    title: prose.surfaces["plate-curve-title"].text,
    interpretationHtml: escapeProseHtml(prose.surfaces["plate-curve-prose"].text),
    callout: {
      value: prose.surfaces["plate-curve-callout-value"].text,
      unitPrefix: prose.surfaces["plate-curve-callout-prefix"].text,
      delta: prose.surfaces["plate-curve-callout-delta"].text,
      direction: "neutral",
    },
    source:
      "Bank of Canada Valet (BD.CDN.2YR / 5YR / 10YR).",
    data: panel3Data,
    citations: [
      { slot: "yield_2yr", at: "latest", value_format: "{0.00}%", context: "", source: "pipeline:boc:yield_2yr", note: "GoC 2y benchmark yield, latest daily close." },
      { slot: "yield_5yr", at: "latest", value_format: "{0.00}%", context: "", source: "pipeline:boc:yield_5yr", note: "GoC 5y benchmark yield, latest daily close." },
      { slot: "yield_10yr", at: "latest", value_format: "{0.00}%", context: "", source: "pipeline:boc:yield_10yr", note: "GoC 10y benchmark yield, latest daily close." },
    ],
  },
];

const pageTitle = "Markets";
const pageDescription =
  "Canadian financial markets chartbook: USDCAD, Government of Canada yield curve, TSX, and WTI crude oil.";

// Page lede: rendered surface from the same template/render pass as the
// plates. sections.ts derives its markets blurb.body and tileLine from the
// identical render, so every markets surface shares one source of truth.
const lede = prose.surfaces["lede"].text;
---
<SectionLayout
  slug="markets"
  sectionIndex={7}
  sectionLabel="Markets"
  headlineQuestion={section.headlineQuestion}
  lede={lede}
  latestReleaseLabel={latestReleaseLabel}
  plates={plates}
  title={pageTitle}
  description={pageDescription}
/>
