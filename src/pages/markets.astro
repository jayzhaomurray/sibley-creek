---
import SectionLayout from "../layouts/SectionLayout.astro";
import type { Plate } from "../layouts/SectionLayout.astro";
import { sections } from "../data/sections";
import panelDataFile from "../../data/site/panel_data/markets.json";
import sectionsJson from "../../data/site/sections.json";
import { pickPanel, type PanelData } from "../components/charts/_shared/panelData";
import { deriveLatestReleaseLabel, formatAsOf } from "../components/section/_shared/derivedLabels";

const section = sections.find((s) => s.slug === "markets");
if (!section) {
  throw new Error("Markets section not found in src/data/sections.ts");
}

const defaultLatestReleaseLabel = deriveLatestReleaseLabel(
  section.latestReleasePrefix ?? "",
  sectionsJson,
  "markets",
);

const panel1Data = pickPanel(panelDataFile, 1);
const panel2Data = pickPanel(panelDataFile, 2);
const panel3Data = pickPanel(panelDataFile, 3);
const panel6Data = pickPanel(panelDataFile, 6);

function latestDisplayedDailyDate(panels: Array<PanelData | null>): string | null {
  const picks: Array<{ iso: string; frequency: string }> = [];
  for (const panel of panels) {
    for (const series of [panel?.primary, panel?.secondary, panel?.tertiary]) {
      if (!series?.asOfISO) continue;
      const frequency = (series.frequency ?? "").toLowerCase();
      if (frequency !== "daily" && frequency !== "weekly") continue;
      picks.push({ iso: series.asOfISO, frequency });
    }
  }
  if (picks.length === 0) return null;
  const latest = picks.reduce((best, item) => item.iso > best.iso ? item : best);
  return formatAsOf(latest.iso, latest.frequency);
}

const latestDisplayedDate = latestDisplayedDailyDate([
  panel6Data,
  panel1Data,
  panel2Data,
  panel3Data,
]);

const latestReleaseLabel = latestDisplayedDate
  ? `${section.latestReleasePrefix ?? "Daily close"}, ${latestDisplayedDate}`
  : defaultLatestReleaseLabel;

const plates: Plate[] = [
  {
    id: "plate-1",
    number: "01",
    chartKey: "markets-panel-6",
    indicator: "WTI oil price",
    plateIndexLabel: "Energy",
    title: "Oil prices are still over $100 per barrel, even with the ceasefire.",
    interpretationHtml:
      "WTI closed at US$101.12 on May 13, off a US$109.76 peak on May 4. " +
      "Crude has stayed above US$100 since the war in Iran pushed prices up earlier this spring, and the ceasefire has unwound part of the move but not all of it.",
    callout: {
      value: "US$101.12",
      unitPrefix: "WTI spot",
      delta: "May 13 close",
      direction: "neutral",
    },
    source:
      "Yahoo Finance (CL=F) via Sibley Creek pipeline.",
    data: panel6Data,
    citations: [
      { phrase: "WTI closed at US$101.12 on May 13", source: "pipeline:yahoo:wti", note: "WTI spot, May 13, 2026 daily close." },
      { phrase: "off a US$109.76 peak on May 4", source: "pipeline:yahoo:wti", note: "WTI spot, May 4, 2026 daily close — the early-May high." },
      { phrase: "Crude has stayed above US$100", source: "pipeline:yahoo:wti", note: "WTI daily closes have remained above US$100 since the late-April / early-May spike (May 4 peak: $109.76; May 13: $101.12)." },
      { phrase: "the war in Iran pushed prices up earlier this spring", source: "derived", note: "Iran-related Middle East conflict drove WTI higher through April-May 2026. Geopolitical context referenced in BoC April 2026 MPR (conditional on Middle East outcome) and CSCE Q1 2026 supplement (Middle East war survey window March 26 - April 2, 2026)." },
      { phrase: "the ceasefire has unwound part of the move but not all of it", source: "derived", note: "WTI fell from May 4 peak of $109.76 to $101.12 by May 13 — a partial retracement but still well above the pre-spike $90s range." },
    ],
  },
  {
    id: "plate-2",
    number: "02",
    chartKey: "markets-panel-1",
    indicator: "USDCAD spot",
    plateIndexLabel: "CAD",
    title: "The loonie has settled into a range well below last fall's stress reach.",
    interpretationHtml:
      "USDCAD closed the week at 1.3686, weaker by about a cent from 1.3576 on May 1. " +
      "The pair has spent the past month inside a 1.36 to 1.38 band, well below the 1.42 stress reach of late 2025.",
    callout: {
      value: "1.3686",
      unitPrefix: "USDCAD spot",
      delta: "+0.0110 w/w",
      direction: "neutral",
    },
    source:
      "Bank of Canada Valet (FXUSDCAD).",
    data: panel1Data,
    citations: [
      { phrase: "1.42 stress reach of late 2025", source: "pipeline:boc:fxusdcad", note: "USDCAD daily high reached ~1.42 in late 2025; year token covered here." },
    ],
  },
  {
    id: "plate-3",
    number: "03",
    chartKey: "markets-panel-2",
    indicator: "S&P/TSX Composite",
    plateIndexLabel: "Equities",
    title: "The TSX is holding above 34,000.",
    interpretationHtml:
      "The S&amp;P/TSX Composite closed at 33,994.87 on May 12, off slightly from 34,077.76 on May 8 and 34,138.90 in early March. " +
      "The index has spent the past two months in a narrow band around the 34,000 line.",
    callout: {
      value: "33,995",
      unitPrefix: "TSX Composite, May 12",
      delta: "-83 d/d",
      direction: "neutral",
    },
    source: "Yahoo Finance (^GSPTSE) via Sibley Creek pipeline.",
    data: panel2Data,
    citations: [
      { phrase: "33,994.87 on May 12", source: "pipeline:yahoo:tsx_composite", note: "S&P/TSX Composite daily close, May 12, 2026, via Yahoo Finance ^GSPTSE." },
      { phrase: "34,077.76 on May 8", source: "pipeline:yahoo:tsx_composite", note: "S&P/TSX Composite daily close, May 8, 2026." },
      { phrase: "34,138.90 in early March", source: "pipeline:yahoo:tsx_composite", note: "S&P/TSX Composite daily close, early March 2026 (March 1 reading)." },
    ],
  },
  {
    id: "plate-4",
    number: "04",
    chartKey: "markets-panel-3",
    indicator: "GoC yield curve",
    plateIndexLabel: "GoC curve",
    title: "The yield curve has shifted up across the board.",
    interpretationHtml:
      "The GoC 10y sits at 3.54%, with the 2y at 2.93%, the 5y at 3.19%, and the 30y at 3.90%. " +
      "Yields are higher across the curve over the past month — the 2y is up about 14 bps and the 10y about 8 — and the 2s10s spread sits at 61 bps.",
    callout: {
      value: "3.54%",
      unitPrefix: "GoC 10y",
      delta: "+8 bps over past month",
      direction: "neutral",
    },
    source:
      "Bank of Canada Valet (BD.CDN.2YR / 5YR / 10YR / LONG.DQ.YLD).",
    data: panel3Data,
    citations: [
      { phrase: "GoC 10y sits at 3.54%", source: "pipeline:boc:yield_10yr", note: "GoC 10y benchmark yield, latest daily close (May 11, 2026)." },
      { phrase: "2y at 2.93%", source: "pipeline:boc:yield_2yr", note: "GoC 2y benchmark yield, latest daily close (May 11, 2026)." },
      { phrase: "5y at 3.19%", source: "pipeline:boc:yield_5yr", note: "GoC 5y benchmark yield, latest daily close (May 11, 2026)." },
      { phrase: "30y at 3.90%", source: "pipeline:boc:yield_30yr", note: "GoC long (~30y) benchmark yield, latest daily close." },
      { phrase: "the 2y is up about 14 bps", source: "derived", note: "GoC 2y: Apr 13 = 2.79%, May 11 = 2.93%, Δ = +14 bps. Source: BoC Valet yield_2yr." },
      { phrase: "the 10y about 8", source: "derived", note: "GoC 10y: Apr 13 = 3.46%, May 11 = 3.54%, Δ = +8 bps. Source: BoC Valet yield_10yr." },
      { phrase: "2s10s spread sits at 61 bps", source: "derived", note: "10y (3.54%) - 2y (2.93%) = 61 bps, May 11, 2026. Spread was 67 bps on Apr 13; modestly narrower over the month (mild bear flattening) but essentially stable in the low 60s." },
    ],
  },
];

const pageTitle = "Markets";
const pageDescription =
  "Canadian financial markets chartbook: USDCAD, Government of Canada yield curve, credit spreads, TSX, and WTI crude oil.";

// Lede reads the same editorial blurb the auto-blurb pipeline writes for the
// splash tile (sections.ts -> section.blurb.body). Single source of truth: a
// release-day fan-out updates one field and both surfaces refresh.
const lede = section.blurb?.body ?? "";
---
<SectionLayout
  slug="markets"
  sectionIndex={7}
  sectionLabel="Markets"
  headlineQuestion={section.headlineQuestion}
  lede={lede}
  latestReleaseLabel={latestReleaseLabel}
  plates={plates}
  title={pageTitle}
  description={pageDescription}
/>
