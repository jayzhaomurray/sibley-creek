---
/*
 * BaseLayout - the page shell for macro-research-department.
 *
 * Owns:
 *   - <html lang="en-CA"> root and meta defaults
 *   - Font loading + critical CSS injection (tokens, fonts, base)
 *   - Skip-link + landmark structure (header / main / footer)
 *   - Page header: Vignelli masthead (wordmark + primary nav, optional rail)
 *   - Page footer: Vignelli colophon (rules, stamps, secondary nav)
 *   - SEO basics: <title>, description, canonical, Open Graph, Twitter card
 *
 * Slots:
 *   default      - page content (rendered inside <main id="main">)
 *   head         - optional extra <head> additions for a given page
 *
 * Props:
 *   title        - page title shown in the tab + as og:title. Required.
 *   description  - meta description / og:description. Required.
 *   canonical    - optional canonical URL override (defaults to current path).
 *   ogImage      - optional og/twitter image URL (absolute or root-relative).
 *   pageClass    - optional class added to <body> for page-scoped styling.
 *   showMastheadRail - when true, the masthead renders the "Series / As of /
 *                      Edition" institutional rail. Homepage only; section
 *                      pages keep the masthead compact.
 *
 * SEO copy ownership lives here; defaults edited as the brand crystallizes.
 *
 * 2026-05-11 - Vignelli canonicalization:
 *   Header is now VignelliMasthead. Footer is now VignelliColophon. Theme
 *   color is paper-white. Body background and color come from tokens.css.
 */

import "../styles/tokens.css";
import "../styles/fonts.css";
import "../styles/base.css";

import { site } from "../data/sections";
import { withBase } from "../lib/urls";
import VignelliMasthead from "../components/home/VignelliMasthead.astro";
import VignelliColophon from "../components/home/VignelliColophon.astro";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  pageClass?: string;
  showMastheadRail?: boolean;
}

/*
 * Site-level JSON-LD: Organization + Person.
 *
 * Rendered once in every page's <head> via the inline script block below.
 * Entities are declared with @graph so crawlers see both in a single block
 * and can resolve the cross-references (Organization.founder -> Person,
 * Person.worksFor -> Organization).
 *
 * Source of authority for Jay's credentials: /about page prose + staff
 * roster (memory: project_staff_roster_2026_05.md). LinkedIn handle
 * https://www.linkedin.com/in/jayzhaomurray (user-confirmed 2026-05-21).
 * X/Twitter handle deliberately omitted — user has minimal X presence
 * and prefers LinkedIn as the primary social signal.
 *
 * @type NewsMediaOrganization is the most specific applicable schema.org
 * type for a data-driven editorial publication (more specific than
 * Organization; recognized by Google's structured-data parser and
 * ChatGPT/Perplexity crawlers for entity resolution).
 */
const orgPerson = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "NewsMediaOrganization",
      "@id": `${site.url}/#organization`,
      "name": site.name,
      "url": site.url,
      "description": "Independent Canadian macroeconomic research and advisory. Daily chartbook tracking output, inflation, labour, housing, monetary policy, markets, and trade.",
      "foundingDate": "2026-05",
      "knowsAbout": [
        "Canadian macroeconomics",
        "monetary policy",
        "economic research",
        "Canadian labour markets",
        "Bank of Canada",
        "Canadian housing market",
        "Canadian trade"
      ],
      "areaServed": {
        "@type": "Country",
        "name": "Canada"
      },
      "founder": {
        "@id": `${site.url}/#jay-zhao-murray`
      }
    },
    {
      "@type": "Person",
      "@id": `${site.url}/#jay-zhao-murray`,
      "name": "Jay Zhao-Murray",
      "jobTitle": "Founder / Chief Economist",
      "url": `${site.url}/about/`,
      "worksFor": {
        "@id": `${site.url}/#organization`
      },
      "alumniOf": [
        {
          "@type": "CollegeOrUniversity",
          "name": "Western University",
          "url": "https://www.uwo.ca"
        }
      ],
      "knowsAbout": [
        "Canadian macroeconomics",
        "monetary policy",
        "foreign exchange",
        "Bank of Canada",
        "Canadian economic data"
      ],
      "sameAs": [
        "https://www.linkedin.com/in/jayzhaomurray"
      ]
    }
  ]
});

const {
  title,
  description,
  canonical,
  ogImage,
  pageClass,
  showMastheadRail = false,
} = Astro.props;

// Build a fully-qualified URL for canonical / og:url. Astro.site can be
// undefined during early dev; fall back to a relative path.
const pathname = Astro.url.pathname;
const canonicalHref = canonical
  ?? (Astro.site ? new URL(pathname, Astro.site).toString() : pathname);

const ogImageHref = ogImage
  ?? (Astro.site ? new URL(withBase("/og-default.png"), Astro.site).toString() : withBase("/og-default.png"));

// Tab title format: "Page title | Publication" (e.g. "GDP | Sibley Creek").
// Homepage passes the publication name as title and we collapse the
// duplication so the tab reads "Sibley Creek" rather than "Sibley Creek |
// Sibley Creek".
const tabTitle = title === site.name ? site.name : `${title} | ${site.name}`;
---
<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{tabTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalHref} />

    {/* Theme color matches paper-white for browser chrome continuity. */}
    <meta name="theme-color" content="#FFFFFF" />

    {/* Open Graph / social sharing. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:image" content={ogImageHref} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageHref} />

    {/* Favicon - Sleeping Giant cropped silhouette (head mesa + throat
        notch + chin start, red dot at chin terminus). SVG-only; all modern
        browsers honor SVG favicons. No .ico fallback shipped because the
        previous .ico was the Astro default and serving the wrong mark is
        worse than no fallback. */}
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />

    {/* Webfont performance: preconnect to amortize TLS / DNS before the
        first @import resolves. Crossorigin is required for fonts subdomain. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    {/* Site-level structured data: Organization + Person for entity resolution
        by LLM crawlers and Google's knowledge graph. See orgPerson declaration
        in frontmatter for source-of-authority notes. */}
    <script type="application/ld+json" set:html={orgPerson} />

    <slot name="head" />
  </head>
  <body class:list={[pageClass]}>
    <a class="skip-link" href="#main">Skip to main content</a>

    <div class="site-shell">
      <VignelliMasthead showRail={showMastheadRail} />

      <main id="main" class="site-main">
        <slot />
      </main>

      <VignelliColophon />
    </div>

    {/*
      FormSubmit AJAX handler. Any form with `data-formsubmit-ajax` is
      submitted via fetch instead of a full page POST — keeps the user
      on the page, replaces the form with an inline confirmation, and
      uses FormSubmit's AJAX endpoint which only requires one global
      activation (not per-page). See src/pages/{index,subscribe,contact}
      for the wired forms. Pointed at jayzhaomurray@outlook.com (via
      hash a3077ccc...) — swap to jay@sibleycreek.ca via the FormSubmit
      dashboard once that mailbox exists (task #22).
    */}
    <script is:inline>
      (function () {
        const forms = document.querySelectorAll('form[data-formsubmit-ajax]');
        forms.forEach((form) => {
          form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = form.querySelector('[type="submit"]');
            const btnText = btn ? btn.textContent : '';
            if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }
            try {
              const resp = await fetch(form.action, {
                method: 'POST',
                body: new FormData(form),
                headers: { Accept: 'application/json' },
              });
              if (resp.ok) {
                const msg = form.getAttribute('data-success-msg') ||
                  'Subscribed. Thanks — first issue lands when it lands.';
                const p = document.createElement('p');
                p.className = 'formsubmit-success';
                p.setAttribute('role', 'status');
                p.textContent = msg;
                form.replaceWith(p);
              } else {
                throw new Error('http ' + resp.status);
              }
            } catch (err) {
              if (btn) { btn.disabled = false; btn.textContent = btnText; }
              const existing = form.querySelector('.formsubmit-error');
              if (existing) existing.remove();
              const p = document.createElement('p');
              p.className = 'formsubmit-error';
              p.setAttribute('role', 'alert');
              p.textContent = 'Something went wrong. Try again, or email Jay directly.';
              form.appendChild(p);
            }
          });
        });
      })();
    </script>

    <style>
      /* Site-shell wraps masthead + main + colophon in a single page
       * container so the Vignelli hairline rules align edge-to-edge across
       * all three. Width caps at --col-page (1240px); gutter is wider on
       * desktop per Vignelli register. */
      .site-shell {
        width: 100%;
        max-width: var(--col-page);
        margin: 0 auto;
        padding: 0 var(--gutter-mobile);
      }
      @media (min-width: 1100px) {
        .site-shell {
          padding-inline: var(--gutter-desktop);
        }
      }

      .site-main {
        padding-block: 0;
      }

      /* FormSubmit AJAX success / error feedback. Inherits page register. */
      .formsubmit-success {
        margin: 0;
        padding: 14px 16px;
        border: 1px solid var(--ink);
        background: var(--paper, #fff);
        font-family: var(--font-sans);
        font-size: 16px;
        line-height: 1.45;
        color: var(--ink);
      }
      .formsubmit-error {
        margin: 12px 0 0;
        padding: 10px 12px;
        border: 1px solid var(--accent, #D7263D);
        background: var(--paper, #fff);
        font-family: var(--font-sans);
        font-size: 14px;
        line-height: 1.4;
        color: var(--accent, #D7263D);
      }
    </style>
  </body>
</html>
