---
/*
 * BaseLayout - the page shell for macro-research-department.
 *
 * Owns:
 *   - <html lang="en-CA"> root and meta defaults
 *   - Font loading + critical CSS injection (tokens, fonts, base)
 *   - Skip-link + landmark structure (header / main / footer)
 *   - Page header: Vignelli masthead (wordmark + primary nav, optional rail)
 *   - Page footer: Vignelli colophon (rules, stamps, secondary nav)
 *   - SEO basics: <title>, description, canonical, Open Graph, Twitter card
 *
 * Slots:
 *   default      - page content (rendered inside <main id="main">)
 *   head         - optional extra <head> additions for a given page
 *
 * Props:
 *   title        - page title shown in the tab + as og:title. Required.
 *   description  - meta description / og:description. Required.
 *   canonical    - optional canonical URL override (defaults to current path).
 *   ogImage      - optional og/twitter image URL (absolute or root-relative).
 *   pageClass    - optional class added to <body> for page-scoped styling.
 *   showMastheadRail - when true, the masthead renders the "Series / As of /
 *                      Edition" institutional rail. Homepage only; section
 *                      pages keep the masthead compact.
 *
 * SEO copy ownership lives here; defaults edited as the brand crystallizes.
 *
 * 2026-05-11 - Vignelli canonicalization:
 *   Header is now VignelliMasthead. Footer is now VignelliColophon. Theme
 *   color is paper-white. Body background and color come from tokens.css.
 */

import "../styles/tokens.css";
import "../styles/fonts.css";
import "../styles/base.css";

import { site } from "../data/sections";
import VignelliMasthead from "../components/home/VignelliMasthead.astro";
import VignelliColophon from "../components/home/VignelliColophon.astro";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  pageClass?: string;
  showMastheadRail?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage,
  pageClass,
  showMastheadRail = false,
} = Astro.props;

// Build a fully-qualified URL for canonical / og:url. Astro.site can be
// undefined during early dev; fall back to a relative path.
const pathname = Astro.url.pathname;
const canonicalHref = canonical
  ?? (Astro.site ? new URL(pathname, Astro.site).toString() : pathname);

const ogImageHref = ogImage
  ?? (Astro.site ? new URL("/og-default.png", Astro.site).toString() : "/og-default.png");

// Tab title format: "Page title | Publication" (e.g. "GDP | Sibley Creek").
// Homepage passes the publication name as title and we collapse the
// duplication so the tab reads "Sibley Creek" rather than "Sibley Creek |
// Sibley Creek".
const tabTitle = title === site.name ? site.name : `${title} | ${site.name}`;
---
<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{tabTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalHref} />

    {/* Theme color matches paper-white for browser chrome continuity. */}
    <meta name="theme-color" content="#FFFFFF" />

    {/* Open Graph / social sharing. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:image" content={ogImageHref} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageHref} />

    {/* Favicon. */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />

    {/* Webfont performance: preconnect to amortize TLS / DNS before the
        first @import resolves. Crossorigin is required for fonts subdomain. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <slot name="head" />
  </head>
  <body class:list={[pageClass]}>
    <a class="skip-link" href="#main">Skip to main content</a>

    <div class="site-shell">
      <VignelliMasthead showRail={showMastheadRail} />

      <main id="main" class="site-main">
        <slot />
      </main>

      <VignelliColophon />
    </div>

    <style>
      /* Site-shell wraps masthead + main + colophon in a single page
       * container so the Vignelli hairline rules align edge-to-edge across
       * all three. Width caps at --col-page (1240px); gutter is wider on
       * desktop per Vignelli register. */
      .site-shell {
        width: 100%;
        max-width: var(--col-page);
        margin: 0 auto;
        padding: 0 var(--gutter-mobile);
      }
      @media (min-width: 1100px) {
        .site-shell {
          padding-inline: var(--gutter-desktop);
        }
      }

      .site-main {
        padding-block: 0;
      }
    </style>
  </body>
</html>
