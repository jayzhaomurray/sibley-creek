---
/*
 * SectionLayout - Vignelli chartbook layout for topic pages.
 *
 * Rewritten 2026-05-11. The prior 2-column panel-card grid is gone. The
 * new layout is a sequential scrolling chartbook:
 *
 *   1. Page header (kicker, headline question, lede, latest-release stamp,
 *      plate index) - rendered by SectionPageHeader.
 *   2. A vertical stack of ChartbookUnit components, one per plate.
 *      Each unit pairs a real chart on the left with a 2-4 sentence
 *      interpretation paragraph on the right (vertical stack on mobile).
 *   3. A hairline rule between consecutive units carries the boundary.
 *
 * The interpretation paragraph is the primary value-add; the chart
 * by itself does not speak. v1 accepts placeholder text for the
 * interpretation - backend / editorial workflow fills it via release-day
 * auto-draft + human rewrite.
 *
 * Charts:
 *   - GDP / Inflation / Labour have 6 chart components each; this layout
 *     dispatches on `plate.chartKey` to the right chart component.
 *   - Housing / Policy / Markets / Trade have no chart components yet;
 *     plates from those sections set `chartKey: undefined` and a
 *     dashed-border placeholder reserves the chart space.
 *
 * Props:
 *   - slug                Section slug (gdp, inflation, ...) - data attr.
 *   - sectionIndex        1..7, displayed in the kicker.
 *   - sectionLabel        Display label (eg "GDP", "Inflation"). Right of
 *                          the kicker, all-caps via CSS.
 *   - headlineQuestion    The EDR-canonical headline question (h1).
 *   - lede                2-3 sentence lede paragraph for the page header.
 *                          Placeholder text accepted in v1.
 *   - latestReleaseLabel  Label string for the page-level "Latest release"
 *                          stamp.
 *   - plates              Array of Plate objects (see below). Renders in
 *                          order.
 *   - title / description / canonical / ogImage  SEO passthroughs.
 */

import BaseLayout from "./BaseLayout.astro";
import { site } from "../data/sections";
import SectionPageHeader from "../components/section/SectionPageHeader.astro";
import ChartbookUnit from "../components/section/ChartbookUnit.astro";
import type { PanelData } from "../components/charts/_shared/panelData";
import { derivePlateAsOf } from "../components/section/_shared/derivedLabels";

// Per-section chart components. The same dispatch pattern as the prior
// SectionLayout - the chart-builder owns chart internals; we embed.
import Panel1HeadlineGDP from "../components/charts/gdp/Panel1HeadlineGDPV3.astro";
import Panel3IndustryComposite from "../components/charts/gdp/Panel3IndustryComposite.astro";
import Panel3Contributions from "../components/charts/gdp/Panel3ContributionsV2.astro";
import Panel4PerCapita from "../components/charts/gdp/PanelTotalVsPerCapita.astro";
import Panel5OutputGap from "../components/charts/gdp/Panel5OutputGapV2.astro";

import PanelHeadlineCPITrio from "../components/charts/inflation/PanelHeadlineCPITrio.astro";
import Panel2CoreTrio from "../components/charts/inflation/Panel2CoreTrio.astro";
import Panel3Breadth from "../components/charts/inflation/Panel3Breadth.astro";
import Panel4SubAggregates from "../components/charts/inflation/Panel4SubAggregatesV2.astro";
import Panel5Expectations from "../components/charts/inflation/Panel5ExpectationsV2.astro";
import Panel6PassThrough from "../components/charts/inflation/Panel6PassThrough.astro";

import Panel1LFSHeadline from "../components/charts/labour/Panel1LFSHeadline.astro";
import Panel1HeadlinePrint from "../components/charts/labour/Panel1HeadlinePrint.astro";
import Panel2PerCapita from "../components/charts/labour/Panel2PerCapita.astro";
import Panel2LabourStocksPerCapita from "../components/charts/labour/Panel2LabourStocksPerCapita.astro";
import Panel3WageBand from "../components/charts/labour/Panel3WageBand.astro";
import Panel3WageBandV2 from "../components/charts/labour/Panel3WageBandV2.astro";
import Panel3WageBandV3 from "../components/charts/labour/Panel3WageBandV3.astro";
import Panel4BeveridgeCompanion from "../components/charts/labour/Panel4BeveridgeCompanion.astro";
import Panel6RegionalDumbbell from "../components/charts/labour/Panel6RegionalDumbbell.astro";
import Panel8LabourFlowRates from "../components/charts/labour/Panel8LabourFlowRates.astro";
import Panel8HoursVsHeadcount from "../components/charts/labour/Panel8HoursVsHeadcount.astro";

import MarketsPanel1CAD from "../components/charts/markets/Panel1CAD.astro";
import MarketsPanel2Equities from "../components/charts/markets/Panel2Equities.astro";
import MarketsPanel2GoCCurve from "../components/charts/markets/Panel2GoCCurveV2.astro";
import MarketsPanel4Energy from "../components/charts/markets/Panel4Energy.astro";

import TradePanel3PartnerShares from "../components/charts/trade/Panel3PartnerSharesV2.astro";
import TradePanelSectorPivot from "../components/charts/trade/PanelSectorPivot.astro";
import TradePanelGoldExports from "../components/charts/trade/PanelGoldExports.astro";
import TradePanelReorientationScatter from "../components/charts/trade/PanelTradeReorientationScatter.astro";

import HousingPanel1Prices from "../components/charts/housing/Panel1Prices.astro";
import HousingPanel2Activity from "../components/charts/housing/Panel2Activity.astro";
import HousingPanel3SalesComposite from "../components/charts/housing/Panel3SalesComposite.astro";
import HousingPanel6FinancialStress from "../components/charts/housing/Panel6FinancialStress.astro";
import HousingPanel7Affordability from "../components/charts/housing/Panel7Affordability.astro";

import PolicyPanel1OvernightRate from "../components/charts/policy/Panel1OvernightRate.astro";
import PolicyPanel2MarketPath from "../components/charts/policy/Panel2MarketPath.astro";
import PolicyPanel4AssetCompositionSmallMults from "../components/charts/policy/Panel4AssetCompositionSmallMults.astro";
import PolicyPanel5LiabilityCompositionSmallMults from "../components/charts/policy/Panel5LiabilityCompositionSmallMults.astro";
import PolicyPanel6FederalTrajectorySplit from "../components/charts/policy/Panel6FederalTrajectorySplit.astro";
import PolicyPanel7PolicyRateDivergence from "../components/charts/policy/Panel7PolicyRateDivergence.astro";
import MarketsPanel3CanadaUS2ySpread from "../components/charts/markets/Panel3CanadaUS2ySpread.astro";

/*
 * chartRegistry — single source of truth mapping plate.chartKey to the
 * Astro chart component. Adding a new live chart is one import above plus
 * one line below; the JSX render is data-driven.
 *
 * Unused-import note: Panel1LFSHeadline, Panel2PerCapita, Panel3WageBand,
 * Panel3WageBandV2, Panel6RegionalDumbbell are kept imported (vestigial
 * alternates retained for the alternatives page or for quick swap-back).
 * They are not registered here because they are not the live-section
 * bindings. The registry holds ONLY the live mappings the section pages
 * dispatch through.
 */
export type ChartKey = "gdp-panel-1" | "gdp-panel-2" | "gdp-panel-3" | "gdp-panel-4" | "gdp-panel-5" | "inflation-panel-0" | "inflation-panel-1" | "inflation-panel-2" | "inflation-panel-3" | "inflation-panel-4" | "inflation-panel-5" | "inflation-panel-6" | "labour-panel-1" | "labour-panel-2" | "labour-panel-3" | "labour-panel-4" | "labour-panel-5" | "labour-panel-6" | "housing-panel-1" | "housing-panel-2" | "housing-panel-3" | "housing-panel-6" | "housing-panel-7" | "policy-panel-1" | "policy-panel-2" | "policy-panel-4" | "policy-panel-5" | "policy-panel-6" | "policy-panel-7" | "markets-panel-1" | "markets-panel-2" | "markets-panel-3" | "markets-panel-4" | "markets-panel-6" | "trade-panel-3" | "trade-panel-sector-pivot" | "trade-panel-gold" | "trade-panel-reorientation-scatter";

const chartRegistry: Record<ChartKey, any> = {
  "gdp-panel-1": Panel1HeadlineGDP,
  "gdp-panel-2": Panel3IndustryComposite,
  "gdp-panel-3": Panel3Contributions,
  "gdp-panel-4": Panel4PerCapita,
  "gdp-panel-5": Panel5OutputGap,
  // inflation-panel-0 has no live binding; reserved.
  "inflation-panel-0": null,
  "inflation-panel-1": PanelHeadlineCPITrio,
  "inflation-panel-2": Panel2CoreTrio,
  "inflation-panel-3": Panel3Breadth,
  "inflation-panel-4": Panel4SubAggregates,
  "inflation-panel-5": Panel5Expectations,
  "inflation-panel-6": Panel6PassThrough,
  "labour-panel-1": Panel1HeadlinePrint,
  "labour-panel-2": Panel2LabourStocksPerCapita,
  "labour-panel-3": Panel8HoursVsHeadcount,
  "labour-panel-4": Panel3WageBandV3,
  "labour-panel-5": Panel4BeveridgeCompanion,
  "labour-panel-6": Panel8LabourFlowRates,
  "housing-panel-1": HousingPanel1Prices,
  "housing-panel-2": HousingPanel2Activity,
  "housing-panel-3": HousingPanel3SalesComposite,
  "housing-panel-6": HousingPanel6FinancialStress,
  "housing-panel-7": HousingPanel7Affordability,
  "policy-panel-1": PolicyPanel1OvernightRate,
  "policy-panel-2": PolicyPanel2MarketPath,
  "policy-panel-4": PolicyPanel4AssetCompositionSmallMults,
  "policy-panel-5": PolicyPanel5LiabilityCompositionSmallMults,
  "policy-panel-6": PolicyPanel6FederalTrajectorySplit,
  "policy-panel-7": PolicyPanel7PolicyRateDivergence,
  "markets-panel-1": MarketsPanel1CAD,
  "markets-panel-2": MarketsPanel2Equities,
  "markets-panel-3": MarketsPanel2GoCCurve,
  "markets-panel-4": MarketsPanel3CanadaUS2ySpread,
  "markets-panel-6": MarketsPanel4Energy,
  "trade-panel-3": TradePanel3PartnerShares,
  "trade-panel-sector-pivot": TradePanelSectorPivot,
  "trade-panel-gold": TradePanelGoldExports,
  "trade-panel-reorientation-scatter": TradePanelReorientationScatter,
};

export interface PlateCallout {
  /** Big number value, eg "+0.2%". */
  value: string;
  /**
   * Unit / period qualifier, eg "month-over-month, March 2026".
   *
   * Hand-set unit text — overrides `unitPrefix + derivedDate`. Use this
   * when the editorial frame for the callout is hard-coupled to a phrase
   * the pipeline can't produce (e.g. "Canada 2y minus US 2y", "vs 2% BoC
   * target", "% of potential, 2025Q4"). When omitted, the layout
   * composes `unitPrefix + ", " + derivedDate` from the plate's
   * panel_data.
   */
  unit?: string;
  /**
   * Editorial prefix for the unit string when the date should auto-derive.
   * Combined with the plate's panel_data latest observation as
   * `"{unitPrefix}, {derivedDate}"`. Ignored if `unit` is set.
   *
   * Examples: "month-over-month", "Y/Y", "USDCAD spot", "share >3% Y/Y",
   * "settlement balances".
   */
  unitPrefix?: string;
  /** Pre-formatted delta vs prior, eg "+0.1 pp vs Feb". */
  delta?: string;
  /** Direction glyph selector. Never colors the number. */
  direction?: "pos" | "neg" | "neutral";
}

export interface Plate {
  /** Anchor id (eg "plate-1") - matched by plate-index links. */
  id: string;
  /** Display number for the plate index, eg "01". */
  number: string;
  /** Indicator label, eg "Headline real GDP, month-over-month". */
  indicator: string;
  /** Short label for the plate-index nav chip. */
  plateIndexLabel: string;
  /**
   * As-of stamp body, eg "Mar 2026; released May 1, 2026".
   *
   * Optional — when omitted, SectionLayout derives the stamp from the
   * plate's `data` via derivePlateAsOf(). Set explicitly when the plate
   * carries editorial context inside the date stamp (e.g.
   * "April 29, 2026 (rate decision)", "Pending wiring") OR when the
   * plate has no `data` to derive from.
   */
  asOf?: string;
  /** Declarative headline title sentence. */
  title: string;
  /** Interpretation paragraph (plain text). Placeholder OK. */
  interpretation?: string;
  /** Optional HTML override for interpretation with <strong> emphasis. */
  interpretationHtml?: string;
  /** Optional callout strip. */
  callout?: PlateCallout;
  /** Source citation. */
  source: string;
  /** Optional chart-builder dispatch key. Omitted -> placeholder. */
  chartKey?: ChartKey;
  /**
   * Source citations for claims in `title` and `interpretationHtml`.
   * Used by `scripts/source_audit.mjs` to render the per-page audit view
   * showing which numeric/dated/attributed claims are tagged to a source
   * card or pipeline series, and which are unsourced.
   *
   * Each citation names the verbatim phrase as it appears in the prose
   * and the source identifier:
   *   - `card:<id>` references an entry in editorial/source_cards/registry.yaml
   *   - `pipeline:<table-or-series>` references an auto-refreshed data feed
   *   - `derived` marks an arithmetic derivation from other tagged claims
   *
   * NOT used at runtime — the live site renders interpretationHtml as-is.
   * The audit generator finds the phrases in the rendered text.
   */
  citations?: ClaimCitation[];
  /**
   * Real panel data from the pipeline's
   * data/site/panel_data/<section>.json, keyed by `panel-N`. When
   * provided, the dispatched Panel*.astro renders the live chart;
   * when null/undefined, the panel renders the "DATA NOT YET WIRED"
   * empty state. There is no synthetic fallback.
   */
  data?: PanelData | null;
}

export interface ClaimCitation {
  /** Verbatim substring of the prose to tag. First-occurrence match. */
  phrase?: string;
  /** Source identifier: card:<id> / pipeline:<key> / derived / other:<note>. */
  source: string;
  /** Optional explanatory note rendered in the audit view. */
  note?: string;
  /** Slot-bound (writing-style.md §4.1e): citation auto-resolves from
   * panel_data.json at build time via source_audit.mjs. Citation may omit
   * `phrase:` when slot is set; effective phrase composed as
   * `${formatted_value} ${context}` with {month}/{year} substitution. */
  slot?: string;
  /** Slot observation selector: "latest" (default), "T-N" (N steps back),
   * or "YYYY-MM" / "YYYY-MM-DD" for explicit observation. */
  at?: string;
  /** Format spec for the slot value: "{0.1}%", "{int}%", "{0.1}-point", etc.
   * For date returns from prior_above/prior_below: "{quarter}", "{month_year}". */
  value_format?: string;
  /** Trailing words after the formatted value. Supports {month}/{year}/
   * {quarter}/{month_year}/{month_abbr} substitution from the slot's
   * observation date. */
  context?: string;
  /** Compute DSL (writing-style.md §4.1f Pattern B): arithmetic over slot
   * values, or a named primitive (count_consecutive_at_latest, prior_below,
   * etc.). Result formatted via value_format + context. */
  compute?: string;
  /** Enumeration-card validation (writing-style.md §4.1f Pattern A): the
   * cited card must have `enumeration:` of exactly this length. Build fails
   * on mismatch. Catches ordinal drift on "Nth consecutive" claims. */
  expected_count?: number;
}

interface Props {
  slug: string;
  sectionIndex: number;
  sectionLabel: string;
  headlineQuestion: string;
  lede: string;
  /**
   * Latest-release stamp body. Pass `null` (or a string of "TK", or a
   * string whose tail is "TK") to render the placeholder gray
   * "[ NOT WIRED ]" treatment in the page header right rail.
   */
  latestReleaseLabel: string | null;
  plates: Plate[];
  /** SEO passthroughs. */
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
}

const {
  slug,
  sectionIndex,
  sectionLabel,
  headlineQuestion,
  lede,
  latestReleaseLabel,
  plates,
  title,
  description,
  canonical,
  ogImage,
} = Astro.props;

// Build the plate-index entries consumed by SectionPageHeader.
const plateIndex = plates.map((p) => ({
  number: p.number,
  anchor: p.id,
  label: p.plateIndexLabel,
}));
---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  pageClass={`section-page section-page--${slug}`}
>
  <article class="section-chartbook" data-section={slug}>
    <SectionPageHeader
      publication={site.name}
      sectionIndex={sectionIndex}
      sectionLabel={sectionLabel}
      headlineQuestion={headlineQuestion}
      lede={lede}
      latestReleaseLabel={latestReleaseLabel}
      plates={plateIndex}
    />

    <div class="chartbook-stack">
      {plates.map((plate) => {
        const hasChart = Boolean(plate.chartKey);
        // Auto-derived asOf falls through when the plate doesn't hand-set
        // one. The helper returns null when no panel_data is available
        // (data-pending plates), in which case we drop the stamp entirely
        // — ChartbookUnit accepts an empty string for the right-rail
        // dateline and renders it muted. Editorial overrides (the hand-
        // set `plate.asOf`) win over derivation.
        const derivedAsOf =
          plate.asOf !== undefined
            ? plate.asOf
            : (derivePlateAsOf(plate.data) ?? "");
        // Callout-unit composition: if `unit` is hand-set, use it as-is.
        // Else if `unitPrefix` is set, append the derived date so the
        // callout refreshes alongside the chart.
        let composedCallout = plate.callout;
        if (composedCallout) {
          const hasUnit = typeof composedCallout.unit === "string"
            && composedCallout.unit.length > 0;
          if (!hasUnit && composedCallout.unitPrefix) {
            const calloutDate = derivePlateAsOf(plate.data);
            const composedUnit = calloutDate
              ? `${composedCallout.unitPrefix}, ${calloutDate}`
              : composedCallout.unitPrefix;
            composedCallout = { ...composedCallout, unit: composedUnit };
          }
        }
        return (
          <ChartbookUnit
            plateNumber={plate.number}
            indicator={plate.indicator}
            anchorId={plate.id}
            asOf={derivedAsOf}
            title={plate.title}
            interpretation={plate.interpretation}
            interpretationHtml={plate.interpretationHtml}
            callout={composedCallout}
            source={plate.source}
            hasChart={hasChart}
          >
            {hasChart && (() => {
              // Look the component up in the registry. Render the
              // resolved Astro component dynamically; pass `data` so
              // every Panel*.astro receives the plate's pipeline data
              // (components that don't read it ignore it harmlessly).
              const ChartComponent = plate.chartKey
                ? chartRegistry[plate.chartKey]
                : null;
              if (!ChartComponent) return null;
              return (
                <Fragment slot="chart">
                  <ChartComponent data={plate.data} />
                </Fragment>
              );
            })()}
          </ChartbookUnit>
        );
      })}
    </div>
  </article>

  <style>
    .section-chartbook {
      width: 100%;
    }
    /* The chartbook-stack class is referenced by the ChartbookUnit
     * stylesheet to drop the bottom rule on the last unit. */
    .chartbook-stack {
      margin: 0;
      padding: 0;
    }
  </style>
</BaseLayout>
