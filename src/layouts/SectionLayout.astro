---
/*
 * SectionLayout - Vignelli chartbook layout for topic pages.
 *
 * Rewritten 2026-05-11. The prior 2-column panel-card grid is gone. The
 * new layout is a sequential scrolling chartbook:
 *
 *   1. Page header (kicker, headline question, lede, latest-release stamp,
 *      plate index) - rendered by SectionPageHeader.
 *   2. A vertical stack of ChartbookUnit components, one per plate.
 *      Each unit pairs a real chart on the left with a 2-4 sentence
 *      interpretation paragraph on the right (vertical stack on mobile).
 *   3. A hairline rule between consecutive units carries the boundary.
 *
 * The interpretation paragraph is the load-bearing value-add; the chart
 * by itself does not speak. v1 accepts placeholder text for the
 * interpretation - backend / editorial workflow fills it via release-day
 * auto-draft + human rewrite.
 *
 * Charts:
 *   - GDP / Inflation / Labour have 6 chart components each; this layout
 *     dispatches on `plate.chartKey` to the right chart component.
 *   - Housing / Policy / Markets / Trade have no chart components yet;
 *     plates from those sections set `chartKey: undefined` and a
 *     dashed-border placeholder reserves the chart space.
 *
 * Props:
 *   - slug                Section slug (gdp, inflation, ...) - data attr.
 *   - sectionIndex        1..7, displayed in the kicker.
 *   - sectionLabel        Display label (eg "GDP", "Inflation"). Right of
 *                          the kicker, all-caps via CSS.
 *   - headlineQuestion    The EDR-canonical headline question (h1).
 *   - lede                2-3 sentence lede paragraph for the page header.
 *                          Placeholder text accepted in v1.
 *   - latestReleaseLabel  Label string for the page-level "Latest release"
 *                          stamp.
 *   - plates              Array of Plate objects (see below). Renders in
 *                          order.
 *   - title / description / canonical / ogImage  SEO passthroughs.
 */

import BaseLayout from "./BaseLayout.astro";
import { site } from "../data/sections";
import SectionPageHeader from "../components/section/SectionPageHeader.astro";
import ChartbookUnit from "../components/section/ChartbookUnit.astro";

// Per-section chart components. The same dispatch pattern as the prior
// SectionLayout - the chart-builder owns chart internals; we embed.
import Panel1HeadlineGDP from "../components/charts/gdp/Panel1HeadlineGDP.astro";
import Panel2IndustryVsExpenditure from "../components/charts/gdp/Panel2IndustryVsExpenditure.astro";
import Panel3Contributions from "../components/charts/gdp/Panel3Contributions.astro";
import Panel4PerCapita from "../components/charts/gdp/Panel4PerCapita.astro";
import Panel5OutputGap from "../components/charts/gdp/Panel5OutputGap.astro";
import Panel6RecessionState from "../components/charts/gdp/Panel6RecessionState.astro";

import Panel1HeadlineCPI from "../components/charts/inflation/Panel1HeadlineCPI.astro";
import Panel2CoreTrio from "../components/charts/inflation/Panel2CoreTrio.astro";
import Panel3Breadth from "../components/charts/inflation/Panel3Breadth.astro";
import Panel4SubAggregates from "../components/charts/inflation/Panel4SubAggregates.astro";
import Panel5Expectations from "../components/charts/inflation/Panel5Expectations.astro";
import Panel6PassThrough from "../components/charts/inflation/Panel6PassThrough.astro";

import Panel1LFSHeadline from "../components/charts/labour/Panel1LFSHeadline.astro";
import Panel2PerCapita from "../components/charts/labour/Panel2PerCapita.astro";
import Panel3WageBand from "../components/charts/labour/Panel3WageBand.astro";
import Panel4VacanciesSlack from "../components/charts/labour/Panel4VacanciesSlack.astro";
import Panel5IRCCSupplyTrajectory from "../components/charts/labour/Panel5IRCCSupplyTrajectory.astro";
import Panel6RegionalDumbbell from "../components/charts/labour/Panel6RegionalDumbbell.astro";

export type ChartKey = "gdp-panel-1" | "gdp-panel-2" | "gdp-panel-3" | "gdp-panel-4" | "gdp-panel-5" | "gdp-panel-6" | "inflation-panel-1" | "inflation-panel-2" | "inflation-panel-3" | "inflation-panel-4" | "inflation-panel-5" | "inflation-panel-6" | "labour-panel-1" | "labour-panel-2" | "labour-panel-3" | "labour-panel-4" | "labour-panel-5" | "labour-panel-6";

export interface PlateCallout {
  /** Big number value, eg "+0.2%". */
  value: string;
  /** Unit / period qualifier, eg "month-over-month, March 2026". */
  unit?: string;
  /** Pre-formatted delta vs prior, eg "+0.1 pp vs Feb". */
  delta?: string;
  /** Direction glyph selector. Never colors the number. */
  direction?: "pos" | "neg" | "neutral";
}

export interface Plate {
  /** Anchor id (eg "plate-1") - matched by plate-index links. */
  id: string;
  /** Display number for the plate index, eg "01". */
  number: string;
  /** Indicator label, eg "Headline real GDP, month-over-month". */
  indicator: string;
  /** Short label for the plate-index nav chip. */
  plateIndexLabel: string;
  /** As-of stamp body, eg "Mar 2026; released May 1, 2026". */
  asOf: string;
  /** Declarative headline title sentence. */
  title: string;
  /** Interpretation paragraph (plain text). Placeholder OK. */
  interpretation?: string;
  /** Optional HTML override for interpretation with <strong> emphasis. */
  interpretationHtml?: string;
  /** Optional callout strip. */
  callout?: PlateCallout;
  /** Source citation. */
  source: string;
  /** Optional chart-builder dispatch key. Omitted -> placeholder. */
  chartKey?: ChartKey;
}

interface Props {
  slug: string;
  sectionIndex: number;
  sectionLabel: string;
  headlineQuestion: string;
  lede: string;
  latestReleaseLabel: string;
  plates: Plate[];
  /** SEO passthroughs. */
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
}

const {
  slug,
  sectionIndex,
  sectionLabel,
  headlineQuestion,
  lede,
  latestReleaseLabel,
  plates,
  title,
  description,
  canonical,
  ogImage,
} = Astro.props;

// Build the plate-index entries consumed by SectionPageHeader.
const plateIndex = plates.map((p) => ({
  number: p.number,
  anchor: p.id,
  label: p.plateIndexLabel,
}));
---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  pageClass={`section-page section-page--${slug}`}
>
  <article class="section-chartbook" data-section={slug}>
    <SectionPageHeader
      publication={site.name}
      sectionIndex={sectionIndex}
      sectionLabel={sectionLabel}
      headlineQuestion={headlineQuestion}
      lede={lede}
      latestReleaseLabel={latestReleaseLabel}
      plates={plateIndex}
    />

    <div class="chartbook-stack">
      {plates.map((plate) => {
        const hasChart = Boolean(plate.chartKey);
        return (
          <ChartbookUnit
            plateNumber={plate.number}
            indicator={plate.indicator}
            anchorId={plate.id}
            asOf={plate.asOf}
            title={plate.title}
            interpretation={plate.interpretation}
            interpretationHtml={plate.interpretationHtml}
            callout={plate.callout}
            source={plate.source}
            hasChart={hasChart}
          >
            {hasChart && (
              <Fragment slot="chart">
                {plate.chartKey === "gdp-panel-1" && <Panel1HeadlineGDP />}
                {plate.chartKey === "gdp-panel-2" && <Panel2IndustryVsExpenditure />}
                {plate.chartKey === "gdp-panel-3" && <Panel3Contributions />}
                {plate.chartKey === "gdp-panel-4" && <Panel4PerCapita />}
                {plate.chartKey === "gdp-panel-5" && <Panel5OutputGap />}
                {plate.chartKey === "gdp-panel-6" && <Panel6RecessionState />}
                {plate.chartKey === "inflation-panel-1" && <Panel1HeadlineCPI />}
                {plate.chartKey === "inflation-panel-2" && <Panel2CoreTrio />}
                {plate.chartKey === "inflation-panel-3" && <Panel3Breadth />}
                {plate.chartKey === "inflation-panel-4" && <Panel4SubAggregates />}
                {plate.chartKey === "inflation-panel-5" && <Panel5Expectations />}
                {plate.chartKey === "inflation-panel-6" && <Panel6PassThrough />}
                {plate.chartKey === "labour-panel-1" && <Panel1LFSHeadline />}
                {plate.chartKey === "labour-panel-2" && <Panel2PerCapita />}
                {plate.chartKey === "labour-panel-3" && <Panel3WageBand />}
                {plate.chartKey === "labour-panel-4" && <Panel4VacanciesSlack />}
                {plate.chartKey === "labour-panel-5" && <Panel5IRCCSupplyTrajectory />}
                {plate.chartKey === "labour-panel-6" && <Panel6RegionalDumbbell />}
              </Fragment>
            )}
          </ChartbookUnit>
        );
      })}
    </div>
  </article>

  <style>
    .section-chartbook {
      width: 100%;
    }
    /* The chartbook-stack class is referenced by the ChartbookUnit
     * stylesheet to drop the bottom rule on the last unit. */
    .chartbook-stack {
      margin: 0;
      padding: 0;
    }
  </style>
</BaseLayout>
